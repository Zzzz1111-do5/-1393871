      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">TankMods</string>
          <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——坦克改装（用户 11-19：给坦克实现爆反和主动拦截系统，可以改坦克，像给飞机选导弹那样选装）
--   每型坦克三个改装位：爆反（标配——原模型上本来就有，99A 炮塔正面补贴了一片；不能拆）、主动防御（不装 / 硬杀伤拦截系统）、
--   车顶武器（原装机枪 / 艾布拉姆斯可换 GAU-8 加特林炮塔附件）。
--   出车时客户端的改装界面（Garage.lua）把选的发给服务器（Depots padSpawn → Armor），服务器装好、模型属性 Mods 写上（"aps=hk;roof=gau8"），
--   大家的客户端按它画发射器、雷达板、加特林；车速、武器表按改装改一份型号数据（applyDef：服务器的 e.def、自己开的 st.d 都用它）
--   爆反块的位置在 EraMeta.lua（tools/models/eralayout.py 量的），这里按模型键查
local RS = game:GetService("ReplicatedStorage")
local TM = {}

-- 选项：slot 哪个位，n / reload / gap 主动防御的弹数、每多少秒补一发、两次拦截最少隔几秒，spd 车速倍数（加装的重量），weapon 加的武器
TM.OPT = {
  era = { slot = "era", fixed = true },
  none = { slot = "aps" },
  hk = { slot = "aps", n = 4, reload = 30, gap = 0.65, spd = 0.97 },   -- 硬杀伤：两侧各一个发射器（各两发）、四角雷达板
  stock = { slot = "roof" },
  gau8 = { slot = "roof", weapon = "gau8", spd = 0.95 },   -- 车顶的 GAU-8 加特林炮塔附件（Daniel Skomorovsky 设计的虚构加装件）
}
TM.SLOTS = { "era", "aps", "roof" }
-- 每型能选的（第一个是默认）
TM.FOR = {
  ztz99a = { era = { "era" }, aps = { "none", "hk" }, roof = { "stock" } },
  ztz96 = { era = { "era" }, aps = { "none", "hk" }, roof = { "stock" } },
  m1a2 = { era = { "era" }, aps = { "none", "hk" }, roof = { "stock", "gau8" } },
  m1a1 = { era = { "era" }, aps = { "none", "hk" }, roof = { "stock", "gau8" } },
}
-- 爆反型号：k 挨破甲类（火箭弹、导弹）时剩几成伤害，ke 挨穿甲弹时剩几成（重型爆反对穿甲弹也有用）
TM.ERA = {
  fy4 = { k = 0.22, ke = 0.75, name = "fy4" },
  fy2 = { k = 0.3, ke = 1, name = "fy2" },
  arat = { k = 0.35, ke = 1, name = "arat" },
}

function TM.has(id) return TM.FOR[id] ~= nil end

-- 选的改装（表）整理成合法的：没选的、不合法的用默认
function TM.clean(id, m)
  local F = TM.FOR[id]
  if not F then return nil end
  local out = {}
  for _, slot in ipairs(TM.SLOTS) do
    local list = F[slot] or {}
    local want = type(m) == "table" and m[slot] or nil
    out[slot] = (want and table.find(list, want)) and want or list[1]
  end
  return out
end

function TM.encode(m)
  if not m then return "" end
  local parts = {}
  for _, slot in ipairs(TM.SLOTS) do
    if m[slot] then table.insert(parts, slot .. "=" .. m[slot]) end
  end
  return table.concat(parts, ";")
end

function TM.decode(s)
  local m = {}
  if type(s) ~= "string" then return m end
  for k, v in string.gmatch(s, "(%w+)=(%w+)") do m[k] = v end
  return m
end

-- 型号数据按改装改一份（不改原表）：车速、加速、武器表；没有改装的型号原样返回
function TM.applyDef(d, m)
  if not d or not TM.FOR[d.id] then return d end
  if type(m) == "string" then m = TM.decode(m) end
  m = TM.clean(d.id, m)
  local k, weapons = 1, table.clone(d.weapons)
  for _, slot in ipairs(TM.SLOTS) do
    local o = TM.OPT[m[slot]]
    if o then
      k *= o.spd or 1
      if o.weapon then table.insert(weapons, o.weapon) end
    end
  end
  local c = table.clone(d)
  c.speed, c.accel = d.speed * k, (d.accel or 10) * k
  c.weapons = weapons
  c.mods = m
  c.base = d   -- 原型号（别处要原值的时候用）
  return c
end

---------------------------------------------------------------- 爆反块（EraMeta）

local EM, IM = nil, nil
local function meta()
  if EM == nil then
    local ok, r = pcall(function() return require(RS:WaitForChild("EraMeta", 3)) end)
    EM = ok and type(r) == "table" and r or false
    local ok2, r2 = pcall(function() return require(RS:WaitForChild("ImportedMeta", 3)) end)
    IM = ok2 and type(r2) == "table" and r2 or false
  end
  return EM, IM
end
-- 型号的爆反布局：{ kind, tur, b = { … }, aps, own }；没有的 nil
function TM.eraOf(id)
  local em, im = meta()
  if not em or not im or not im.alias then return nil end
  local key = im.alias[id]
  return key and em[key] or nil, key
end

-- 一块的四个量：中心、法线、宽方向（Vector3），宽、高、厚
function TM.block(b)
  local c = Vector3.new(b[2], b[3], b[4])
  local n = Vector3.new(b[5], b[6], b[7])
  local u = Vector3.new(b[8], b[9], b[10])
  return c, n, u, b[11], b[12], b[13]
end

-- 一块在车的坐标里（炮塔上的按炮塔转角 yaw 度转过去）：返回 CFrame（X 宽、Y 高、Z 朝外——LookVector 朝里），宽、高、厚
--   base：车底的 CFrame；炮塔转轴 tur（EraMeta 的，和 ImportedMeta 的 tur 一样）
function TM.blockCF(L, b, base, yaw)
  local c, n, u, w, h, t = TM.block(b)
  local v = n:Cross(u).Unit
  local local_ = CFrame.fromMatrix(c + n * (t / 2), u, v, n)
  if b[1] == "t" then
    local tur = Vector3.new(L.tur[1], L.tur[2], L.tur[3])
    local_ = CFrame.new(tur) * CFrame.Angles(0, -math.rad(yaw or 0), 0) * CFrame.new(-tur) * local_
  end
  return base * local_, w, h, t
end

-- 车顶加特林（GAU-8 附件）：转轴在炮塔顶左侧（装填手那边）、比顶面高 0.95 格，炮口在转轴前 KIT_MUZ 格；跟着炮俯仰
TM.KIT_MUZ = 6.2
function TM.kitPivot(L)
  local tur = Vector3.new(L.tur[1], L.tur[2], L.tur[3])
  local l = L.aps and L.aps.l and L.aps.l[1]
  local roof = l and (l[2] + 0.55) or (L.tb[5] - 1)
  return Vector3.new(tur.X - 1.9, roof + 0.95, tur.Z + 0.6)
end
-- 加特林的炮口（世界 CFrame，LookVector 朝外）：base 车底，yaw 炮塔转角、pitch 炮的俯仰（度）
function TM.kitMuzzle(L, base, yaw, pitch)
  local tur = Vector3.new(L.tur[1], L.tur[2], L.tur[3])
  local kp = TM.kitPivot(L)
  return base * CFrame.new(tur) * CFrame.Angles(0, -math.rad(yaw or 0), 0) * CFrame.new(kp - tur) * CFrame.Angles(math.rad(pitch or 0), 0, 0)
    * CFrame.new(0, 0, -TM.KIT_MUZ)
end

-- 这一区的块是不是原模型自带的（平时不另画）
function TM.own(L, b)
  if not L or not L.own then return false end
  return table.find(L.own, b[17]) ~= nil
end

return TM
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">VehDefs</string>
          <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——地面载具的型号数据（服务器、客户端共用）：尺寸、速度、炮塔、武器、车轮 / 负重轮、烟幕弹发射筒、瞄准镜
--   单位：格（1 米约 2.8 格，和 Roblox 的人一样比例）。车的坐标系：原点在车底中心（着地），X 右、Y 上、−Z 朝前
--   服务器的命中盒是 W × H × L 的方块，中心在原点上 H/2；客户端按 arch（tracked 履带 / wheeled 轮式）和各项参数拼零件模型
--   炮塔：pivot 是转轴（相对车底），trav 每秒转几度，elev 俯仰范围（度）；炮：gun.pivot 是耳轴（相对炮塔转轴），len 长、cal 粗
--   烟幕弹：smoke.banks 每组一个发射架（相对炮塔转轴的位置、朝向角 yaw 度——0 朝前、正数往右），n 管，各管在架上扇形张开、仰 35°
local VehDefs = {}
local V = Vector3.new

-- 武器（载具用）：kind shell 有弹道的炮弹（打到就炸）、gun 机枪（直射判定）、arty 曲射（准星下的地面）、
--   rate 两发间隔（秒）、mag 一个弹匣 / 弹舱、reload 换弹、reserve 备弹（不算弹匣里的）；speed 弹速（格 / 秒）、drop 下坠（重力倍数）
VehDefs.W = {
  gun125 = { kind = "shell", dmg = 640, speed = 1500, drop = 0.12, splash = 6, rate = 6.5, mag = 1, reload = 0, reserve = 30, range = 3000,
    vs = { inf = 0.7, light = 1.3, armor = 1, air = 0.8, ship = 0.7, fort = 1.2 }, fx = "tank", cal = 0.42 },
  gun120 = { kind = "shell", dmg = 640, speed = 1550, drop = 0.12, splash = 6, rate = 6.0, mag = 1, reload = 0, reserve = 30, range = 3000,
    vs = { inf = 0.7, light = 1.3, armor = 1, air = 0.8, ship = 0.7, fort = 1.2 }, fx = "tank", cal = 0.42 },
  gun105 = { kind = "shell", dmg = 480, speed = 1400, drop = 0.14, splash = 6, rate = 5.0, mag = 1, reload = 0, reserve = 36, range = 2600,
    vs = { inf = 0.8, light = 1.3, armor = 0.9, air = 0.8, ship = 0.6, fort = 1.1 }, fx = "tank", cal = 0.36 },
  ac30 = { kind = "shell", dmg = 60, speed = 1150, drop = 0.2, splash = 4, rate = 0.19, mag = 50, reload = 4.5, reserve = 400, range = 2000,
    vs = { inf = 1, light = 1, armor = 0.22, air = 1.4, ship = 0.35, fort = 0.6 }, fx = "ac", cal = 0.2 },
  ac35 = { kind = "shell", dmg = 46, speed = 1300, drop = 0.15, splash = 5, rate = 0.07, mag = 120, reload = 5, reserve = 600, range = 2400,
    vs = { inf = 0.8, light = 0.8, armor = 0.1, air = 2.4, ship = 0.25, fort = 0.35 }, fx = "ac", cal = 0.2 },
  vulcan = { kind = "shell", dmg = 26, speed = 1200, drop = 0.2, splash = 2.5, rate = 0.035, mag = 300, reload = 6, reserve = 1200, range = 1600,
    vs = { inf = 1, light = 0.6, armor = 0.05, air = 2.0, ship = 0.15, fort = 0.25 }, fx = "ac", cal = 0.14 },
  -- 车顶 GAU-8 加特林附件（坦克改装，TankMods.OPT.gau8）：30 毫米，一秒二十发，2048 发
  gau8 = { kind = "shell", dmg = 52, speed = 1250, drop = 0.18, splash = 3.5, rate = 0.05, mag = 512, reload = 6, reserve = 1536, range = 2200,
    vs = { inf = 1, light = 1.1, armor = 0.32, air = 1.6, ship = 0.4, fort = 0.9 }, fx = "ac", cal = 0.22 },
  coax = { kind = "gun", dmg = 24, rate = 0.08, mag = 200, reload = 5, reserve = 2000, range = 900, spread = 0.45,
    vs = { inf = 1, light = 0.15, armor = 0, air = 0.1, ship = 0, fort = 0.04 }, fx = "lmg" },
  hmg = { kind = "gun", dmg = 40, rate = 0.11, mag = 100, reload = 5, reserve = 900, range = 1200, spread = 0.5,
    vs = { inf = 1, light = 0.5, armor = 0.04, air = 0.4, ship = 0.05, fort = 0.12 }, fx = "lmg" },
  how155 = { kind = "arty", dmg = 340, splash = 26, rate = 7, mag = 1, reload = 0, reserve = 40, minR = 300, maxR = 3600, flight = 6,
    vs = { inf = 1, light = 1, armor = 0.6, air = 0, ship = 0.5, fort = 1.2 } },
  mlrs = { kind = "arty", dmg = 180, splash = 22, rate = 0.45, mag = 12, reload = 25, reserve = 24, minR = 500, maxR = 4000, flight = 7, scatter = 40,
    vs = { inf = 1, light = 1, armor = 0.45, air = 0, ship = 0.4, fort = 1 } },
}
-- 烟幕弹：每次齐射一组，落点约 30 格外，烟团半径 ~20 格、持续 30 秒
VehDefs.SMOKE = { range = 32, r = 20, life = 30, salvos = 2, reload = 12 }
-- 726 气垫艇：攻方不会游的车在登陆平台旁站在艇上生成，开车的人连艇一起开（服务器 Armor、客户端 Drive 共用）：
--   y 艇身中心高、deck 车底的高度、speed 水上最快（格 / 秒）、size 艇身、hp
VehDefs.LCAC = { y = 2.2, deck = 3.0, speed = 75, size = Vector3.new(28, 6, 48), hp = 1800 }   -- 75 格 / 秒：从登陆平台到海滩四十来秒

local D = {}
VehDefs.D = D

-- 履带车的公共部分（负重轮、履带）；轮式车的车轴
local function tracked(t)
  t.arch = "tracked"
  t.wheels = nil
  return t
end
local function wheeled(t)
  t.arch = "wheeled"
  return t
end

---------------------------------------------------------------- 坦克

D.ztz99a = tracked({ cat = "tank", L = 22, W = 10.2, H = 7.4, hullH = 4.2, clear = 1.3, speed = 34, accel = 10, turn = 36,
  rw = { n = 6, r = 1.15, x = 4.0, z0 = -7.6, z1 = 7.2 }, era = true, skirt = true,
  turret = { pivot = V(0, 4.2, 0.6), size = V(7.4, 2.3, 8.2), style = "wedge", trav = 42, elev = { -6, 18 }, bustle = 2.2 },
  gun = { pivot = V(0, 0.9, -3.4), len = 14.5, cal = 0.46, brake = false, fume = true }, coax = V(1.1, 0.9, -3.6),
  sight = V(-1.9, 2.1, -2.6), cupola = V(1.7, 2.3, 0.6),   -- 车顶车长舱口一挺手动的 12.7 毫米重机枪（用户 11-21 晚：照真车加回，元数据 rws.mk = "manual"）
  smoke = { banks = { { at = V(3.3, 1.5, -1.6), yaw = 40 }, { at = V(-3.3, 1.5, -1.6), yaw = -40 } }, n = 4 },
  weapons = { "gun125", "coax" } })
D.ztz96 = tracked({ cat = "tank", L = 20.5, W = 9.8, H = 7.0, hullH = 4.0, clear = 1.3, speed = 33, accel = 9, turn = 36,
  rw = { n = 6, r = 1.1, x = 3.85, z0 = -7.0, z1 = 6.7 }, era = true, skirt = true,
  turret = { pivot = V(0, 4.0, 0.4), size = V(6.8, 2.2, 7.0), style = "round", trav = 38, elev = { -6, 16 }, bustle = 1.2 },
  gun = { pivot = V(0, 0.9, -3.0), len = 14, cal = 0.45, fume = true }, coax = V(1.0, 0.9, -3.2),
  sight = V(-1.7, 2.0, -2.2), cupola = V(1.6, 2.2, 0.4),
  smoke = { banks = { { at = V(3.1, 1.4, -1.2), yaw = 40 }, { at = V(-3.1, 1.4, -1.2), yaw = -40 } }, n = 4 },
  weapons = { "gun125", "coax" } })
D.m1a2 = tracked({ cat = "tank", L = 23, W = 10.2, H = 7.6, hullH = 4.2, clear = 1.4, speed = 35, accel = 10, turn = 35,
  rw = { n = 7, r = 1.05, x = 4.0, z0 = -7.8, z1 = 7.6 }, era = false, skirt = true, tusk = false,
  turret = { pivot = V(0, 4.2, 0.9), size = V(7.8, 2.4, 9.4), style = "abrams", trav = 42, elev = { -9, 20 }, bustle = 3.0 },
  gun = { pivot = V(0, 0.95, -4.0), len = 14, cal = 0.44 }, coax = V(1.2, 0.95, -4.1),
  sight = V(-2.0, 2.2, -2.8), cupola = V(1.8, 2.4, 0.8), citv = V(-1.4, 2.6, -0.4),
  smoke = { banks = { { at = V(3.5, 1.6, -2.4), yaw = 35 }, { at = V(-3.5, 1.6, -2.4), yaw = -35 } }, n = 6 },
  weapons = { "gun120", "coax" } })
D.m1a1 = tracked({ cat = "tank", L = 22.5, W = 10.2, H = 7.4, hullH = 4.2, clear = 1.4, speed = 35, accel = 10, turn = 35,
  rw = { n = 7, r = 1.05, x = 4.0, z0 = -7.6, z1 = 7.4 }, era = false, skirt = true,
  turret = { pivot = V(0, 4.2, 0.9), size = V(7.6, 2.3, 9.0), style = "abrams", trav = 40, elev = { -9, 20 }, bustle = 2.6 },
  gun = { pivot = V(0, 0.95, -3.9), len = 14, cal = 0.44 }, coax = V(1.2, 0.95, -4.0),
  sight = V(-2.0, 2.1, -2.7), cupola = V(1.8, 2.3, 0.8),
  smoke = { banks = { { at = V(3.4, 1.5, -2.3), yaw = 35 }, { at = V(-3.4, 1.5, -2.3), yaw = -35 } }, n = 6 },
  weapons = { "gun120", "coax" } })
D.m10 = tracked({ cat = "tank", L = 22, W = 9.6, H = 7.4, hullH = 4.3, clear = 1.4, speed = 37, accel = 11, turn = 40,
  rw = { n = 6, r = 1.05, x = 3.8, z0 = -7.2, z1 = 7.0 }, skirt = true,
  turret = { pivot = V(0, 4.3, 0.6), size = V(7.0, 2.3, 7.6), style = "wedge", trav = 40, elev = { -8, 20 }, bustle = 2.0 },
  gun = { pivot = V(0, 0.9, -3.4), len = 12, cal = 0.38, brake = true, fume = true }, coax = V(1.1, 0.9, -3.5),
  sight = V(-1.8, 2.1, -2.4), cupola = V(1.7, 2.3, 0.6),
  smoke = { banks = { { at = V(3.2, 1.5, -1.8), yaw = 35 }, { at = V(-3.2, 1.5, -1.8), yaw = -35 } }, n = 4 },
  weapons = { "gun105", "coax" } })

---------------------------------------------------------------- 装甲车（履带）

D.zbd05 = tracked({ cat = "apc", L = 26, W = 9.6, H = 7.0, hullH = 4.6, clear = 1.2, speed = 40, accel = 11, turn = 40, amphib = true, boat = true,
  rw = { n = 7, r = 0.95, x = 3.8, z0 = -9.2, z1 = 9.4 }, skirt = false,
  turret = { pivot = V(0, 4.6, -1.6), size = V(4.6, 1.6, 4.8), style = "ifv", trav = 60, elev = { -8, 50 } },
  gun = { pivot = V(0, 0.6, -2.2), len = 7.5, cal = 0.24, brake = true }, coax = V(0.8, 0.6, -2.3),
  sight = V(-1.4, 1.5, -1.8),
  smoke = { banks = { { at = V(2.2, 0.9, -1.6), yaw = 30 }, { at = V(-2.2, 0.9, -1.6), yaw = -30 } }, n = 4 },
  weapons = { "ac30", "coax" }, seats = 6 })
