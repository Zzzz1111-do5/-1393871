  fus = { len = 55, w = 6.4, h = 4.6, y = 0 }, nose = 10, canopy = { z = -15.5, len = 9.5, w = 3.0, h = 2.4, y = 2.4 },
  intake = "dsi", intakeZ = -8, intakeW = 2.4,
