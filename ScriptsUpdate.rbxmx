  alias = { a10c = "a10_v3", ah64e = "ah64_v2", b2 = "b2_v3", ch47 = "ch47", f22 = "f22a", f35 = "f35_v3", gj11 = "x47b_v3~", gj2 = "mq9_v3~", h6k = "h6k_v3", j15t = "j15t", j16 = "j16_v3", j20 = "j20_v4", j35 = "j31_v3", j50 = "j50_v3", mq9 = "mq9_v3", uh60 = "uh60", z10 = "z10w_v2", z20 = "uh60~" },
  old = { ah64e = { "ah64" }, z10 = { "z10w" }, a10c = { "a10_v2", "a10" }, b2 = { "b2_v2", "b2" }, f22 = { "f22_v3", "f22_v2", "f22" }, f35 = { "f35_v2", "f35" }, gj11 = { "x47b_v2~", "x47b~" }, gj2 = { "mq9_v2~", "mq9~" }, h6k = { "h6k_v2", "h6k" }, j15t = { "j15_v3", "j15_v2", "j15" }, j16 = { "j16_v2", "j16" }, j20 = { "j20_v3", "j20_v2", "j20" }, j35 = { "j31_v2", "j31" }, j50 = { "j50_v2", "j50" }, mq9 = { "mq9_v2", "mq9" } },
  m = {
