  quonset = { credit = "铁皮营房：Military Style Building (with animations)，作者 TampaJoey（https://sketchfab.com/3d-models/military-style-building-with-animations-1671685e1dd94b6e9216ead632f08f6e），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 54.574, h = 16.765, name = "铁皮营房", o = { 493.808, 0, 0 }, parts = { Body_1 = { c = { -0.013, 3.752, -16.216 }, s = { 3.454, 5.959, 0.391 } }, Body_10 = { c = { -0.05, 5.065, -19.518 }, s = { 21.602, 3.825, 0.959 } }, Body_11 = { c = { -0.067, 4.959, -19.646 }, s = { 21.636, 4.695, 0.02 } }, Body_12 = { c = { -0.067, 4.959, -19.64 }, s = { 21.636, 4.695, 0.158 } }, Body_2 = { c = { -0.028, 4.964, -18.806 }, s = { 15.921, 4.822, 0.505 } }, Body_3 = { c = { 0, 5.889, 23.955 }, s = { 21.737, 10.54, 0.615 } }, Body_4 = { c = { 0.006, 5.417, 24.432 }, s = { 9.776, 9.305, 0.171 } }, Body_5 = { c = { -0.001, 8.577, 3.083 }, s = { 32.604, 16.376, 46.338 } }, Body_6 = { c = { 0, 7.723, 2.997 }, s = { 31.7, 15.049, 45.882 } }, Body_7 = { c = { 0.033, 5.037, -17.954 }, s = { 9.149, 9.903, 4.84 } }, Body_8 = { c = { 0.022, 6.006, 3.164 }, s = { 12.312, 1.478, 47.094 } }, Body_9 = { c = { 0, 0.378, 0 }, s = { 32.909, 0.756, 54.574 } } }, w = 32.909 },
  firestation = { credit = "消防站：Fire Station No. 1，作者 CommonSpence（https://sketchfab.com/3d-models/fire-station-no-1-87edf04deb28434993274d9f05070865），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 66.107, h = 29.591, name = "消防站", o = { 574.036, 0, 0 }, parts = { Body_1 = { c = { 0, 14.796, 0 }, s = { 87.545, 29.591, 66.107 } } }, w = 87.545 },
  wh3 = { credit = "库房：Pack - Realistic - 3 Warehouse，作者 Islide（https://sketchfab.com/3d-models/pack-realistic-3-warehouse-320c272513a94c0482dbb3c4e79d61f5），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 29.028, h = 12.2, name = "库房", o = { 703.88, 0, 0 }, parts = { Body_1 = { c = { -19.044, 2.813, -1.465 }, s = { 92.698, 5.625, 24.727 } }, Body_2 = { c = { 0, 9.844, -0 }, s = { 131.253, 4.712, 28.43 } }, Body_3 = { c = { 0, 6.153, 0 }, s = { 131.253, 11.133, 28.126 } }, Body_4 = { c = { 0, 0.293, 0 }, s = { 131.487, 0.586, 28.36 } }, Body_5 = { c = { 0, 6.1, 0 }, s = { 132.144, 12.2, 29.028 } }, Body_6 = { c = { -2.744, 3.809, -6.26 }, s = { 125.297, 2.725, 15.136 } } }, w = 132.144 },
  sawtooth = { credit = "厂房：Warehouse Building，作者 OmegaRedZA（https://sketchfab.com/3d-models/warehouse-building-0c37b0f92cb54e07a1e1c6c3df9f8439），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 63.237, h = 18.57, name = "厂房", o = { 812.884, 0, 0 }, parts = { Body_1 = { c = { -0.012, 14.686, 0 }, s = { 45.839, 7.768, 63.237 } }, Body_2 = { c = { 0.147, 5.624, -0.402 }, s = { 45.569, 11.249, 62.287 } }, Body_3 = { c = { 12.288, 5.624, -31.365 }, s = { 21.231, 11.249, 0.288 } }, Body_4 = { c = { 0.013, 5.768, 30.671 }, s = { 45.085, 11.249, 0.288 } }, Body_5 = { c = { 22.748, 5.768, -0.464 }, s = { 0.288, 11.249, 21.217 } }, Body_6 = { c = { 0.032, 14.615, -0.302 }, s = { 45.584, 7.641, 62.565 } }, Body_7 = { c = { 0.032, 0.453, -0.424 }, s = { 44.937, 0.302, 62.273 } } }, w = 45.863 },
