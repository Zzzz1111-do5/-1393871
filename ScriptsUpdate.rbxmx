    l.Parent, l.Size, l.Position, l.AnchorPoint = it[2], UDim2.new(1, -8, 1, 0), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5)
    l.TextSize, l.TextXAlignment, l.Visible = 30, Enum.TextXAlignment.Center, true
