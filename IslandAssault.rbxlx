add("vw.ac35", "35 毫米高炮", "35 mm AA gun")
add("vw.vulcan", "20 毫米加特林", "20 mm Gatling")
add("vw.coax", "并列机枪", "Coaxial MG")
add("vw.hmg", "12.7 毫米机枪", "12.7 mm HMG")
add("vw.how155", "155 毫米榴弹炮", "155 mm howitzer")
