  rotor = { hub = V(0, 5.6, -1), r = 18.2, blades = 5, rpm = 290, dir = 1, chord = 1.4 }, tail = { hub = V(-1.3, 3.6, 19.5), r = 3.1, blades = 4, rpm = 1400, axis = "x" },
