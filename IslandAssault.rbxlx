---------------------------------------------------------------- 补默认值

for id, d in pairs(D) do
  d.id = id
  d.air = true
  if d.kind == "jet" then
    d.vMax = d.vAB or d.vMil
    d.vRot = d.stall * 1.08   -- 抬头离地的速度
    d.landMax = d.stall * 1.45   -- 着陆最快多少（再快就是撞地）
    d.seats = d.seats or 1
  else
    d.vMax = d.vMax or 90
  end
  d.gunAmmo = d.gunAmmo or 0
  d.flares = d.flares or 0
  d.hitbox = (d.kind == "heli") and V(math.max(d.W, 8), d.H * 0.8, d.L * 0.8) or V(d.W * 0.7, d.H * 0.75, d.L * 0.9)
  for i, s in ipairs(d.st or {}) do s.i = i end
end

-- 攻方舰队的甲板（和 World.fleet 拼的一样大：甲板面高 top）：飞机能停在上面、从上面起飞
AirDefs.DECKS = { carrier = { L = 620, W = 120, top = 30.5 }, lhd = { L = 480, W = 94, top = 26.5 }, lst = { L = 300, W = 60, top = 18.5 } }
-- (x, z) 处能落地的面多高：地形（海上是海面 0）、甲板
function AirDefs.ground(Map, x, z)
  local g = Map.ground(x, z)
  for _, s in ipairs(Map.FLEET or {}) do
    local K = AirDefs.DECKS[s.kind]
    if K and math.abs(x - s.x) < K.W / 2 and math.abs(z - s.z) < K.L / 2 then g = math.max(g, K.top) end
  end
  return g
end
-- 在不在甲板上
function AirDefs.onDeck(Map, x, z)
  for _, s in ipairs(Map.FLEET or {}) do
    local K = AirDefs.DECKS[s.kind]
    if K and math.abs(x - s.x) < K.W / 2 and math.abs(z - s.z) < K.L / 2 then return s.kind end
  end
  return nil
end

function AirDefs.get(id) return D[id] end
function AirDefs.isAir(id) return D[id] ~= nil end

-- 一个挂点挂某种武器能挂几枚
function AirDefs.count(s, wid)
  local w = AirDefs.W[wid]
  if not w then return 0 end
  if w.kind == "rkt" then return w.tubes end
  return (s.n and s.n[wid]) or 1
end
-- 按挂点名字展开预设（左右成对的挂点同名）
function AirDefs.presetLoad(d, key)
  local p
  for _, x in ipairs(d.presets or {}) do if x.key == key then p = x end end
  p = p or (d.presets and d.presets[1])
  local out = {}
  for i, s in ipairs(d.st or {}) do
    local w = p and p.map[s.name]
    out[i] = (w and table.find(s.opts, w)) and w or false
  end
  return out
end
-- 检查客户端发来的挂载：每个挂点只能挂它能挂的；不对的换成空
function AirDefs.cleanLoad(d, load)
  local out = {}
  for i, s in ipairs(d.st or {}) do
    local w = (type(load) == "table") and load[i] or nil
    out[i] = (type(w) == "string" and table.find(s.opts, w)) and w or false
  end
  return out
end
-- 挂载里有哪几种武器（按出现顺序；1 号武器位是航炮）
function AirDefs.groups(d, load)
  local out, seen = {}, {}
  if d.gun then table.insert(out, d.gun) seen[d.gun] = true end
  for _, s in ipairs(d.st or {}) do
    local w = load[s.i]
    if w and not seen[w] then table.insert(out, w) seen[w] = true end
  end
  return out
end

return AirDefs
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="3">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source"><![CDATA[-- 暗剑：登岛战——数值（服务器、客户端共用）
-- 文字都在 Lang.lua（中英双语），这里只放编号和数
local Config = {}

Config.Version = "1.0-alpha"
Config.SaveKey = "IslandAssault_v1"   -- DataStore 名字（改了就是新存档）
Config.Tick = 0.1                     -- 推演步长（秒）：占领、AI、炮弹、导弹

---------------------------------------------------------------- 回合

-- 准备 → 战斗（攻方每拿下一个据点加时间）→ 结算 → 重新随机分队
Config.Round = {
  prep = 30,            -- 准备（选兵种、等人）
  battle = 20 * 60,     -- 战斗时长
  perCapture = 180,     -- 攻方每拿下一个据点加多少秒
  overtime = 90,        -- 时间到时有据点正在被占：最多加时多久
  results = 20,         -- 结算画面
}
Config.RespawnDelay = 6   -- 阵亡后几秒回到部署界面
Config.MinPlayersToStart = 1

-- 占领：圈里数双方的人（步兵、地面载具；飞机、舰艇不算；机器人也算）
Config.Capture = {
  r = 70,          -- 据点半径（和 Map.POINT_R 一样）
  slow = 45,       -- 攻方多 1 人：几秒占完
  fast = 15,       -- 攻方多 3 人以上：几秒占完
  decay = 90,      -- 守方人不少于攻方：进度从满退到零要几秒
}

Config.Teams = {
  atk = { color = Color3.fromRGB(220, 70, 55), brick = "Bright red" },
  def = { color = Color3.fromRGB(60, 120, 230), brick = "Bright blue" },
}

---------------------------------------------------------------- 步兵兵种（10 种，无限复活）

-- hp 血量、speed 走路速度；weapons 带的武器（按顺序进背包：1、2、3…）
Config.Roles = {
  { id = "rifle", hp = 100, speed = 16, weapons = { "rifle", "pistol", "grenade" } },
  { id = "mg", hp = 115, speed = 14.5, weapons = { "lmg", "pistol" } },
  { id = "sniper", hp = 90, speed = 16, weapons = { "sniper", "pistol" } },
  { id = "at", hp = 100, speed = 15, weapons = { "carbine", "rpg" } },
  { id = "aa", hp = 100, speed = 15, weapons = { "carbine", "manpads" } },
  { id = "medic", hp = 100, speed = 16.5, weapons = { "smg", "medkit" } },
  { id = "engineer", hp = 105, speed = 15.5, weapons = { "carbine", "repair", "breach" } },
  { id = "mortar", hp = 100, speed = 15, weapons = { "carbine", "mortar" } },
  { id = "spec", hp = 110, speed = 18, weapons = { "smgsd", "c4", "grenade" } },
  { id = "spotter", hp = 95, speed = 16, weapons = { "carbine", "binoc" } },
}
Config.RoleById = {}
for _, r in ipairs(Config.Roles) do Config.RoleById[r.id] = r end

---------------------------------------------------------------- 武器

-- 目标类别：inf 步兵、light 轻型车、armor 装甲、air 飞机直升机、ship 舰艇、fort 工事
-- kind：gun 直射（服务器射线判定）；proj 有弹道的弹（speed 弹速、splash 溅射、drop 是否下坠）；throw 投掷（fuse 引信秒数）；
--   lock 锁定导弹（打 air，lockTime 锁定要几秒）；mortar 曲射（点地图上 / 准星下的地面，minR maxR 射程）；
--   heal 治疗（r 范围、amt 每次、cd 冷却）；repair 修车、修工事（每秒 rate）；place 放置（炸药包）；breach 破障器材；spot 望远镜标记敌人、呼叫炮击
--   （雷区、铁丝网、炮都是地图自带的，玩家不能自己布雷、架炮）
-- dmg 每发、rate 几秒一发、mag 弹匣、reserve 备弹（不算弹匣里的；没写就是无限）、reload 换弹秒数、range 射程、spread 散布（度）；
-- vs 对各类目标的伤害倍数
local G_VS = { inf = 1, light = 0.15, armor = 0, air = 0.1, ship = 0, fort = 0.04 }
Config.Weapons = {
  rifle = { kind = "gun", dmg = 26, rate = 0.11, mag = 30, reload = 2.2, range = 650, spread = 0.55, auto = true, vs = G_VS, head = 1.6 },
  carbine = { kind = "gun", dmg = 23, rate = 0.1, mag = 30, reload = 2.0, range = 480, spread = 0.75, auto = true, vs = G_VS, head = 1.6 },
  lmg = { kind = "gun", dmg = 24, rate = 0.075, mag = 100, reload = 4.6, range = 700, spread = 1.15, auto = true, vs = { inf = 1, light = 0.3, armor = 0.02, air = 0.15, ship = 0, fort = 0.05 }, head = 1.5 },
  sniper = { kind = "gun", dmg = 96, rate = 1.35, mag = 5, reload = 3.0, range = 1500, spread = 0.03, vs = { inf = 1, light = 0.25, armor = 0, air = 0.1, ship = 0, fort = 0.05 }, head = 2.2, scope = 5 },
  smg = { kind = "gun", dmg = 19, rate = 0.07, mag = 32, reload = 1.8, range = 280, spread = 1.4, auto = true, vs = G_VS, head = 1.5 },
  smgsd = { kind = "gun", dmg = 21, rate = 0.075, mag = 30, reload = 1.8, range = 320, spread = 1.1, auto = true, vs = G_VS, head = 1.6, quiet = true },
  pistol = { kind = "gun", dmg = 28, rate = 0.22, mag = 12, reload = 1.4, range = 220, spread = 0.9, vs = G_VS, head = 1.6 },
  rpg = { kind = "proj", dmg = 110, rate = 0.5, mag = 1, reserve = 3, reload = 3.4, range = 700, spread = 0.4, speed = 230, splash = 11, drop = true,
    vs = { inf = 1, light = 5, armor = 5.5, air = 3, ship = 2.5, fort = 4 } },
  manpads = { kind = "lock", dmg = 120, rate = 0.5, mag = 1, reserve = 1, reload = 3.5, range = 1400, speed = 320, splash = 9, lockTime = 1.6,
    vs = { inf = 0.3, light = 0.5, armor = 0.3, air = 6, ship = 0.5, fort = 0.2 } },
  grenade = { kind = "throw", dmg = 115, rate = 1.0, mag = 1, reserve = 1, reload = 0.8, range = 90, fuse = 2.8, splash = 14, speed = 70,
    vs = { inf = 1, light = 0.8, armor = 0.15, air = 0, ship = 0.1, fort = 0.6 } },
  mortar = { kind = "mortar", dmg = 95, rate = 1.6, mag = 1, reserve = 11, reload = 2.6, minR = 90, maxR = 950, splash = 17, flight = 5,
    vs = { inf = 1, light = 0.8, armor = 0.3, air = 0, ship = 0.25, fort = 0.8 } },
  medkit = { kind = "heal", amt = 35, r = 14, cd = 6, mag = 1, rate = 0.5, reload = 0 },
  repair = { kind = "repair", rate = 90, range = 16, mag = 1, reload = 0 },
  breach = { kind = "breach", range = 6, detect = 34, time = 1.6, mag = 1, reload = 0 },   -- 破障器材：探雷（detect 格以内）、排雷 / 剪铁丝网（离得 range 格以内按住 time 秒）
  c4 = { kind = "place", dmg = 260, splash = 13, mag = 1, reserve = 1, reload = 0.6, rate = 0.8, trigger = "remote",
    vs = { inf = 1, light = 4, armor = 5, air = 0, ship = 2, fort = 5 } },
  binoc = { kind = "spot", range = 1600, spotTime = 12, cd = 4, strikeCd = 75, strike = { n = 8, r = 26, dmg = 120, splash = 20, flight = 6,
    vs = { inf = 1, light = 1, armor = 0.45, air = 0, ship = 0.3, fort = 1 } }, mag = 1, reload = 0 },
}

---------------------------------------------------------------- 载具（按名额；每队每种同时在场有上限，按队伍人数算）

-- cat 类别：tank 坦克、apc 装甲车、aa 防空、arty 火炮、heli 直升机、jet 固定翼、ship 舰艇
-- 每类按队给几个型号（Lang 里有名字）；hp、speed（格 / 秒）、tgt 中弹按什么类别算伤害
Config.VehicleCats = {
  tank = { tgt = "armor", hp = 1600, speed = 34, perN = 8, min = 1, max = 4, cd = 60 },
  apc = { tgt = "light", hp = 800, speed = 46, perN = 6, min = 1, max = 5, cd = 45, seats = 5 },
  aa = { tgt = "light", hp = 700, speed = 36, perN = 12, min = 1, max = 2, cd = 60 },
  arty = { tgt = "light", hp = 650, speed = 30, perN = 14, min = 0, max = 2, cd = 70 },
  heli = { tgt = "air", hp = 900, speed = 85, perN = 12, min = 1, max = 3, cd = 75, seats = 4 },
  jet = { tgt = "air", hp = 700, speed = 260, perN = 12, min = 1, max = 3, cd = 90 },
  ship = { tgt = "ship", hp = 3000, speed = 45, perN = 16, min = 0, max = 2, cd = 120 },
}
Config.VehicleOrder = { "tank", "apc", "aa", "arty", "heli", "jet", "ship" }
-- 型号：每队每类可选的型号（编号对应 Lang 里的名字和模型名）；mod 按型号微调（hp 倍数、速度倍数、主炮伤害倍数）
Config.Vehicles = {
  atk = {
    tank = { "ztq15", "ztz96", "ztz99a" },
    apc = { "ztd05", "zbd05", "zsl92b", "ptl02" },
    aa = { "pgz07", "pgl625", "ld2000" },
    arty = { "plz07" },
    heli = { "z10", "z20" },
    jet = { "j15t", "j35", "j20", "j16", "j50", "h6k", "gj11", "gj2" },
    ship = { "t055", "t054a", "t022" },
  },
  def = {
    tank = { "m10", "m1a1", "m1a2" },
    apc = { "m1117", "hmmwv", "jltv", "m2a3", "stryker", "m1150" },
    aa = { "m163", "mshorad", "cram", "patriot" },
    arty = { "m109a7", "m270" },   -- M777 是地图自带的炮位（Forts），走过去就能用
    heli = { "ah64e", "uh60", "ch47" },
    jet = { "a10c", "f35", "f22", "mq9", "b2" },
    ship = { "ddg125", "cg47", "lcs2", "pbr" },
  },
}
Config.VehicleMod = {
  ztq15 = { hp = 0.75, speed = 1.15, gun = 0.8 }, m10 = { hp = 0.8, speed = 1.1, gun = 0.85 },
  ztz96 = { hp = 0.9 }, m1a1 = { hp = 0.95 }, ztz99a = { hp = 1.1, gun = 1.1 }, m1a2 = { hp = 1.1, gun = 1.1 },
  zbd05 = { amphib = true }, ztd05 = { amphib = true, gun = 1.6 }, hmmwv = { hp = 0.5, speed = 1.25 }, jltv = { hp = 0.65, speed = 1.2 },
  m1150 = { hp = 1.4, speed = 0.8 }, m270 = { rocket = true }, patriot = { sam = true }, cram = { ciws = true },
  z20 = { transport = true }, uh60 = { transport = true }, ch47 = { transport = true, hp = 1.3 },
  h6k = { bomber = true, hp = 1.6, speed = 0.75 }, b2 = { bomber = true, hp = 1.5, speed = 0.8 }, a10c = { hp = 1.4, speed = 0.7 },
  gj11 = { drone = true, hp = 0.6 }, gj2 = { drone = true, hp = 0.6 }, mq9 = { drone = true, hp = 0.6, speed = 0.55 },
  t022 = { hp = 0.4, speed = 1.3 }, pbr = { hp = 0.25, speed = 1.4 }, lcs2 = { hp = 0.6, speed = 1.3 },
}
-- 这一队这一类最多同时在场几辆（按队伍人数，真人 + 机器人）
function Config.VehicleCap(cat, teamN)
  local c = Config.VehicleCats[cat]
  return math.clamp(math.floor(teamN / c.perN) + c.min, c.min, c.max)
end

---------------------------------------------------------------- 机器人

Config.Bots = {
  minPerTeam = 18,       -- 每队保底人数：真人不够用 AI 补
  maxTotal = 40,         -- 全服最多几个机器人
  hp = 100, speed = 14,  -- 步兵机器人：血量、走路速度（格 / 秒）
  weapon = "rifle",      -- 用哪种枪的伤害、射程
  sight = 520,           -- 看多远
  reaction = 0.8,        -- 发现新目标后多久开第一枪（秒，随机 ±40%）
  fireGap = 0.36,        -- 两枪之间（秒）
  spread = 0.8, spreadPer = 0.004,   -- 散布：基础几度 + 每格距离多几度（100 格约 1.2°、300 格约 2°）
}

---------------------------------------------------------------- 得分、经验、军衔

Config.Score = { kill = 100, botKill = 60, assist = 40, capture = 300, captureAssist = 120, heal = 10, repair = 10, spot = 15, win = 500, lose = 150, vehicleKill = 200,
  fortKill = 250, defuse = 30, wireCut = 15 }
Config.Ranks = { 0, 500, 1500, 3500, 7000, 12000, 20000, 32000, 50000, 75000, 110000, 160000, 230000, 330000, 480000 }   -- 累计经验门槛（Lang 里有军衔名）
function Config.RankOf(xp)
  local i = 1
  for k, v in ipairs(Config.Ranks) do
    if xp >= v then i = k end
  end
  return i
end

return Config
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">FortDefs</string>
        <ProtectedString name="Source"><![CDATA[-- 暗剑：登岛战——守方工事的型号与摆放（服务器、客户端共用）：地图自带，每局开局时系统摆好，玩家不用（也不能）自己部署
--   工事：机枪碉堡（12.7 毫米机枪，从射孔里打，左右各 60°）、岸防炮（127 毫米舰炮改的岸炮，打登陆艇、舰艇，也打滩上的车）、
--     高炮（双联 35 毫米，近炸引信，只打飞机）、M777 榴弹炮阵地（155 毫米，山脊后面，曲射）；
--     没人操作时 AI 打，自己队的玩家走过去按 E 就能接手操作（F 离开）；能被打掉（伤害类别 fort：步枪几乎打不动，要火箭筒、炸药包、坦克炮、炮击、炸弹）；
--     据点被攻方拿下后，挨着这个据点的工事归攻方
--   障碍：钢刺猬（滩头水线一带，挡车）、铁丝网（滩后，人走进去慢、车压过去就压坏、炸一下就炸断、工兵能剪开）、
--     雷区（滩后两侧，有警示牌；只炸攻方，炮弹落在附近会被引爆，工兵能探出来、排掉）
--   单位：格（1 米约 2.8 格）。工事的坐标系同车辆：原点在底面中心（着地），X 右、Y 上、−Z 朝前（射孔、炮口的默认朝向）
--   摆放按 Map 算，每局一样：服务器开局时照 FortDefs.layout(Map) 建；客户端只按实体属性画样子
local FortDefs = {}
local V = Vector3.new

-- 武器：kind gun 直射（射线判定）、shell 有弹道的炮弹、flak 高炮弹（近炸引信）
--   rate 两发间隔、burst 一个点射几发、pause 点射之间歇多久；range 射程；spread 散布（度）、spreadPer 每格距离多几度
FortDefs.W = {
  hmg = { kind = "gun", dmg = 34, rate = 0.12, burst = { 5, 9 }, pause = { 1.0, 1.8 }, range = 820, spread = 1.2, spreadPer = 0.0035,
    vs = { inf = 1, light = 0.5, armor = 0.04, air = 0.4, ship = 0.05, fort = 0.12 }, fx = "lmg", head = 1 },
  naval127 = { kind = "shell", dmg = 520, speed = 950, gscale = 0.5, splash = 15, rate = 8, range = 3300, minR = 160,
    vs = { inf = 1, light = 1.4, armor = 0.9, air = 0, ship = 1.4, fort = 1 }, fx = "tank" },
  flak35 = { kind = "flak", dmg = 70, speed = 1150, gscale = 0.15, splash = 11, rate = 0.25, range = 2300, fuse = 9, spread = 1.1,
    vs = { inf = 0.6, light = 0.4, armor = 0.05, air = 2.2, ship = 0.1, fort = 0.2 }, fx = "ac" },
  how155 = { kind = "arty", dmg = 340, splash = 26, rate = 8, minR = 300, maxR = 3800, flight = 6, scatter = 14,
    vs = { inf = 1, light = 1, armor = 0.6, air = 0, ship = 0.5, fort = 1.2 } },
}
for id, w in pairs(FortDefs.W) do w.id = id end
-- 玩家操作时：弹匣（打空了换弹）；AI 打不用换弹
FortDefs.MAG = { hmg = { mag = 100, reload = 5 }, flak35 = { mag = 40, reload = 6 } }

-- 型号：size 命中盒（也挡人）；turret.pivot 转轴（相对底面中心）、trav 每秒转几度、arc 能转到正前方左右各几度（180 = 一圈）、elev 俯仰范围；
--   gun.pivot 耳轴（相对转轴）、len 炮管长；sight 看多远；targets 打哪些目标（inf 步兵、veh 地面车辆、boat 艇和舰、air 飞机）
FortDefs.D = {
  bunker = { hp = 1400, size = V(16, 7.2, 14), weapon = "hmg", sight = 820,
    turret = { pivot = V(0, 4.6, -5.2), trav = 70, arc = 60, elev = { -14, 18 } }, gun = { pivot = V(0, 0, 0), len = 4.4 },
    targets = { inf = true, veh = true } },
  coastal = { hp = 2600, size = V(20, 9, 20), weapon = "naval127", sight = 3300,
    turret = { pivot = V(0, 4.6, 0.6), trav = 18, arc = 150, elev = { -6, 40 } }, gun = { pivot = V(0, 1.6, -4.4), len = 20 },
    targets = { boat = true, veh = true } },
  aaa = { hp = 900, size = V(14, 6, 14), weapon = "flak35", sight = 2300,
    turret = { pivot = V(0, 2.4, 0), trav = 85, arc = 180, elev = { -4, 85 } }, gun = { pivot = V(0, 1.4, -0.6), len = 7.6 },
    targets = { air = true } },
  howitzer = { hp = 1000, size = V(12, 5, 22), weapon = "how155", sight = 3800,
    turret = { pivot = V(0, 3.0, 1.0), trav = 20, arc = 25, elev = { 0, 70 } }, gun = { pivot = V(0, 0.3, 0), len = 14.5 },
    targets = { arty = true } },
}
-- 玩家走到哪儿能接手（相对底面中心）：碉堡后门、炮塔后面、炮架旁边、大架尾巴
FortDefs.MAN = { bunker = V(0, 3, 8.2), coastal = V(0, 2, 11), aaa = V(5.5, 1.5, 3), howitzer = V(3.5, 1.5, 9) }
for id, d in pairs(FortDefs.D) do d.id = id end

function FortDefs.get(id) return FortDefs.D[id] end

-- 炮塔、炮口的世界坐标：base 是底面中心的 CFrame（−Z 朝前）；ty 方位（度，正数往右）、gp 俯仰（度，正数往上）
function FortDefs.turretCF(d, base, ty)
  return base * CFrame.new(d.turret.pivot) * CFrame.Angles(0, -math.rad(ty or 0), 0)
end
function FortDefs.gunCF(d, base, ty, gp)
  return FortDefs.turretCF(d, base, ty) * CFrame.new(d.gun.pivot) * CFrame.Angles(math.rad(gp or 0), 0, 0)
end
function FortDefs.muzzle(d, base, ty, gp)
  return FortDefs.gunCF(d, base, ty, gp) * CFrame.new(0, 0, -d.gun.len)
end

-- 障碍
FortDefs.WIRE = { len = 16, slow = 0.35, r = 4.5 }          -- 一段铁丝网多长、人在里面走路速度乘多少、离铁丝网多近算在里面
FortDefs.MINE = {
  ap = { dmg = 150, splash = 9, vs = { inf = 1, light = 0.5, armor = 0.1, air = 0, ship = 0, fort = 0 }, trig = 3.2 },     -- 防步兵雷
  at = { dmg = 300, splash = 10, vs = { inf = 0.8, light = 3.5, armor = 3.2, air = 0, ship = 0, fort = 0 }, trig = 6.5 },   -- 防坦克雷（只有车压上去才炸）
  chain = 11,   -- 爆炸离雷多近会把它引爆（炮火准备能开出通路）
}

---------------------------------------------------------------- 摆放

-- (x, z) 附近找一块放工事的平地：陆地、四角高差小；返回 x, z（找不到就原地）
local function siteNear(Map, x, z, r, size)
  local best, bx, bz = 1e9, x, z
  local hx, hz = size.X * 0.5, size.Z * 0.5
  for i = 0, 30 do
    local a, rr = i * 2.39996, r * math.sqrt(i / 30)
    local px, pz = x + math.cos(a) * rr, z + math.sin(a) * rr
    local h0 = Map.height(px, pz)
    if h0 > 1.5 then
      local lo, hi = h0, h0
      for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
        local h = Map.height(px + o[1] * hx, pz + o[2] * hz)
        if h < lo then lo = h end
        if h > hi then hi = h end
      end
      local s = (hi - lo) + rr * 0.015 + ((lo < 1) and 50 or 0)
      if s < best then best, bx, bz = s, px, pz end
    end
  end
  return bx, bz
end
FortDefs.siteNear = siteNear

-- 朝向：从 (x, z) 看向 (tx, tz) 的 CFrame（原点在地面上）
local function faceCF(Map, x, z, tx, tz)
  local y = Map.ground(x, z)
  local p = V(x, y, z)
  local look = V(tx - x, 0, tz - z)
  if look.Magnitude < 0.1 then look = V(0, 0, 1) end
  return CFrame.lookAt(p, p + look.Unit)
end

-- 全部工事：{ id, kind（bunker / coastal / aaa）, cf（底面中心，−Z 朝前）, pt（附近的据点：据点被攻方拿下后这处工事就废了）, tag（位置名） }
function FortDefs.layout(Map)
  local out = {}
  local n = 0
  local function add(kind, x, z, tx, tz, pt, tag, r)
    local d = FortDefs.D[kind]
    local sx, sz = siteNear(Map, x, z, r or 26, d.size)
    n += 1
    table.insert(out, { id = "f" .. n, kind = kind, cf = faceCF(Map, sx, sz, tx, tz), pt = pt, tag = tag })
  end
  -- 南岸四处海滩：每处两座机枪碉堡，在滩后高处、离岸约 100 格，射孔斜对着滩中间（交叉火力）
  for _, b in ipairs(Map.BEACHES) do
    if not b.north then
      local w = b.x1 - b.x0
      for _, f in ipairs({ 0.12, 0.88 }) do
        local x = b.x0 + w * f
        local zc = Map.coastS(x) or b.z
        add("bunker", x, zc - 105, b.cx, b.z + 40, nil, b.id)
      end
    else   -- 东北侧翼滩：一座，朝北
      local x = b.cx + 30
      local zc = Map.coastN(x) or b.z
      add("bunker", x, zc + 95, b.cx, b.z - 40, nil, b.id)
    end
  end
  -- 港湾：湾口两侧各一座，对着湾里
  local BAY = Map.BAY
  for s = -1, 1, 2 do
    local x = BAY.x + s * (BAY.w + 55)
    local zc = Map.coastS(x) or Map.PORT.z
    add("bunker", x, zc - 45, BAY.x, (Map.coastS(BAY.x) or Map.PORT.z) + 160, "C", "port")
  end
  -- 据点
  local P = {}
  for _, p in ipairs(Map.POINTS) do P[p.id] = p end
  add("bunker", P.A.x - 75, P.A.z + 95, P.A.x - 40, P.A.z + 400, "A", "outpost")
  add("bunker", P.A.x + 75, P.A.z + 95, P.A.x + 40, P.A.z + 400, "A", "outpost")
  add("bunker", P.B.x - 90, P.B.z + 120, P.B.x - 120, P.B.z + 500, "B", "lighthouse")
  add("bunker", P.B.x + 60, P.B.z + 125, P.B.x + 80, P.B.z + 500, "B", "lighthouse")
  add("bunker", P.D.x, P.D.z + 150, P.D.x, P.D.z + 600, "D", "airfield")
  add("bunker", P.E.x - 70, P.E.z + 70, P.E.x - 120, P.E.z + 500, "E", "command")
  add("bunker", P.E.x + 70, P.E.z + 70, P.E.x + 120, P.E.z + 500, "E", "command")
  -- 岸防炮：东西两个岬角的崖顶、西礁岛炮台、灯塔岛西南角；炮口朝南（舰队、登陆艇来的方向）
  for _, cx in ipairs({ -1110, 1200 }) do
    local zc = Map.coastS(cx) or -700
    add("coastal", cx, zc - 48, cx * 0.6, zc + 1200, nil, "cape", 20)
  end
  local WR = Map.WESTREEF
  add("coastal", WR.x + 40, WR.z + 60, WR.x + 900, WR.z + 1000, nil, "westreef", 18)
  local LH = Map.LIGHTHOUSE
  add("coastal", LH.x - 130, LH.z + 110, LH.x - 900, LH.z + 1100, "B", "lighthouse", 20)
  -- 高炮：机场两座、指挥所、港口、两座小岛据点、后方营地
  local A = Map.AIRFIELD
  add("aaa", A.x - 190, A.z - 95, A.x - 190, A.z + 400, "D", "airfield")
  add("aaa", A.x + 190, A.z - 95, A.x + 190, A.z + 400, "D", "airfield")
  add("aaa", P.E.x + 55, P.E.z - 45, P.E.x, P.E.z + 400, "E", "command")
  add("aaa", P.C.x + 95, P.C.z - 55, P.C.x, P.C.z + 400, "C", "port")
  add("aaa", P.A.x + 55, P.A.z - 40, P.A.x, P.A.z + 400, "A", "outpost")
  add("aaa", P.B.x - 60, P.B.z - 55, P.B.x, P.B.z + 400, "B", "lighthouse")
  add("aaa", Map.CAMP.x - 95, Map.CAMP.z + 15, Map.CAMP.x, Map.CAMP.z + 400, nil, "camp")
  -- M777 榴弹炮阵地：指挥所东北、山脊背面（从海上看不见），两门炮口朝南，够得着南岸各处海滩
  local C = Map.COMMAND
  add("howitzer", C.x + 150, C.z - 70, C.x + 150, C.z + 1000, "E", "battery", 30)
  add("howitzer", C.x + 185, C.z - 62, C.x + 185, C.z + 1000, "E", "battery", 30)
  return out
end

-- 滩头的通道：中间一条清空的（登陆艇、气垫艇冲滩的地方），两侧各一个钢刺猬缺口；缺口后面不埋雷（雷区在滩的两翼）
--   （钢刺猬间隔 12 格、两排错开 6 格：缺口在离滩中间 22～42 格之间，两排都空出来的地方中心约在 ±33）
FortDefs.LANE = { half = 15, gap0 = 22, gap1 = 42, gapC = 33 }
function FortDefs.lanes(b)
  if not b.x0 then return { b.cx } end
  local g = FortDefs.LANE.gapC
  return { b.cx, b.cx - g, b.cx + g }
end

-- 滩头障碍：钢刺猬（水线一带两排，留出通道和缺口）、铁丝网（两道、隔段留缺口）、雷区（滩的两翼各一片）；用固定种子，每局一样
function FortDefs.obstacles(Map)
  local rng = Random.new(20240611)
  local L = FortDefs.LANE
  local hog, wire, mines, signs = {}, {}, {}, {}
  for bi, b in ipairs(Map.BEACHES) do
    local coast = b.north and Map.coastN or Map.coastS
    local inland = b.north and 1 or -1   -- 往岛里是 +Z（北岸）还是 −Z（南岸）
    -- 钢刺猬：两排，前排在水线外 6 格（浅水里），后排在滩上 7 格、错开半格
    for x = b.x0 + 6, b.x1 - 6, 12 do
      for row = 0, 1 do
        local xx = x + row * 6
        local rel = math.abs(xx - b.cx)
        if rel >= L.half and not (rel > L.gap0 and rel < L.gap1) and xx <= b.x1 - 4 then
          local zc = coast(xx)
          if zc then table.insert(hog, { x = xx, z = zc - inland * ((row == 0) and 6 or -7), rot = rng:NextNumber(0, math.pi) }) end
        end
      end
    end
    -- 铁丝网：离岸 45 格、72 格两道，各隔段留缺口
    for line = 0, 1 do
      local d = (line == 0) and 45 or 72
      local i = 0
      local x = b.x0 + (line == 0 and 0 or 8)
      while x + FortDefs.WIRE.len <= b.x1 + 10 do
        i += 1
        if i % 3 ~= ((line == 0) and 2 or 0) then
          local xa, xb = x, x + FortDefs.WIRE.len
          local za, zb = coast(xa), coast(xb)
          if za and zb then
            table.insert(wire, { a = V(xa, 0, za + inland * d), b = V(xb, 0, zb + inland * d), beach = b.id })
          end
        end
        x += FortDefs.WIRE.len
      end
    end
    -- 雷区：滩的两翼（离岸 48～88 格），四角立警示牌
    for _, side in ipairs({ -1, 1 }) do
      local cx = (side < 0) and (b.x0 + 22) or (b.x1 - 22)
      local zc = coast(cx)
      if zc then
        local cz = zc + inland * 68
        local field = { w = 32, d = 40 }
        for _ = 1, 8 do
          local x = cx + rng:NextNumber(-field.w / 2, field.w / 2)
          local z = cz + rng:NextNumber(-field.d / 2, field.d / 2)
          if Map.isLand(x, z) then table.insert(mines, { x = x, z = z, at = rng:NextNumber() < 0.35, field = bi * 2 + (side > 0 and 1 or 0) }) end
        end
        for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
          table.insert(signs, { x = cx + c[1] * (field.w / 2 + 3), z = cz + c[2] * (field.d / 2 + 3), face = -inland })
        end
      end
    end
  end
  return { hog = hog, wire = wire, mines = mines, signs = signs }
end

return FortDefs
]]></ProtectedString>
      </Properties>
    </Item>
