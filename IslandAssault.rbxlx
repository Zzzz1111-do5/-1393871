    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source"><![CDATA[-- 暗剑：登岛战——数值（服务器、客户端共用）
-- 文字都在 Lang.lua（中英双语），这里只放编号和数
local Config = {}

Config.Version = "1.0-alpha"
Config.SaveKey = "IslandAssault_v1"   -- DataStore 名字（改了就是新存档）
Config.Tick = 0.1                     -- 推演步长（秒）：占领、AI、炮弹、导弹

---------------------------------------------------------------- 回合

-- 准备 → 战斗（攻方每拿下一个据点加时间）→ 结算 → 重新随机分队
Config.Round = {
  prep = 30,            -- 准备（选兵种、等人）
  battle = 20 * 60,     -- 战斗时长
  perCapture = 180,     -- 攻方每拿下一个据点加多少秒
  overtime = 90,        -- 时间到时有据点正在被占：最多加时多久
  results = 20,         -- 结算画面
}
Config.RespawnDelay = 6   -- 阵亡后几秒回到部署界面
Config.MinPlayersToStart = 1

-- 占领：圈里数双方的人（步兵、地面载具；飞机、舰艇不算；机器人也算）
Config.Capture = {
  r = 70,          -- 据点半径（和 Map.POINT_R 一样）
  slow = 45,       -- 攻方多 1 人：几秒占完
  fast = 15,       -- 攻方多 3 人以上：几秒占完
  decay = 90,      -- 守方人不少于攻方：进度从满退到零要几秒
}

Config.Teams = {
  atk = { color = Color3.fromRGB(220, 70, 55), brick = "Bright red" },
  def = { color = Color3.fromRGB(60, 120, 230), brick = "Bright blue" },
}

---------------------------------------------------------------- 步兵兵种（10 种，无限复活）

-- hp 血量、speed 走路速度；weapons 带的武器（按顺序进背包：1、2、3…）
Config.Roles = {
  { id = "rifle", hp = 100, speed = 16, weapons = { "rifle", "pistol", "grenade" } },
  { id = "mg", hp = 115, speed = 14.5, weapons = { "lmg", "pistol" } },
  { id = "sniper", hp = 90, speed = 16, weapons = { "sniper", "pistol" } },
  { id = "at", hp = 100, speed = 15, weapons = { "carbine", "rpg" } },
  { id = "aa", hp = 100, speed = 15, weapons = { "carbine", "manpads" } },
  { id = "medic", hp = 100, speed = 16.5, weapons = { "smg", "medkit" } },
  { id = "engineer", hp = 105, speed = 15.5, weapons = { "carbine", "repair", "mine" } },
  { id = "mortar", hp = 100, speed = 15, weapons = { "carbine", "mortar" } },
  { id = "spec", hp = 110, speed = 18, weapons = { "smgsd", "c4", "grenade" } },
  { id = "spotter", hp = 95, speed = 16, weapons = { "carbine", "binoc" } },
}
Config.RoleById = {}
for _, r in ipairs(Config.Roles) do Config.RoleById[r.id] = r end

---------------------------------------------------------------- 武器

-- 目标类别：inf 步兵、light 轻型车、armor 装甲、air 飞机直升机、ship 舰艇、fort 工事
-- kind：gun 直射（服务器射线判定）；proj 有弹道的弹（speed 弹速、splash 溅射、drop 是否下坠）；throw 投掷（fuse 引信秒数）；
--   lock 锁定导弹（打 air，lockTime 锁定要几秒）；mortar 曲射（点地图上 / 准星下的地面，minR maxR 射程）；
--   heal 治疗（r 范围、amt 每次、cd 冷却）；repair 修车（每秒 rate）；place 放置（c4、地雷）；spot 望远镜标记敌人、呼叫炮击
-- dmg 每发、rate 几秒一发、mag 弹匣、reserve 备弹（不算弹匣里的；没写就是无限）、reload 换弹秒数、range 射程、spread 散布（度）；
-- vs 对各类目标的伤害倍数
local G_VS = { inf = 1, light = 0.15, armor = 0, air = 0.1, ship = 0, fort = 0.04 }
Config.Weapons = {
  rifle = { kind = "gun", dmg = 26, rate = 0.11, mag = 30, reload = 2.2, range = 650, spread = 0.55, auto = true, vs = G_VS, head = 1.6 },
  carbine = { kind = "gun", dmg = 23, rate = 0.1, mag = 30, reload = 2.0, range = 480, spread = 0.75, auto = true, vs = G_VS, head = 1.6 },
  lmg = { kind = "gun", dmg = 24, rate = 0.075, mag = 100, reload = 4.6, range = 700, spread = 1.15, auto = true, vs = { inf = 1, light = 0.3, armor = 0.02, air = 0.15, ship = 0, fort = 0.05 }, head = 1.5 },
  sniper = { kind = "gun", dmg = 96, rate = 1.35, mag = 5, reload = 3.0, range = 1500, spread = 0.03, vs = { inf = 1, light = 0.25, armor = 0, air = 0.1, ship = 0, fort = 0.05 }, head = 2.2, scope = 5 },
  smg = { kind = "gun", dmg = 19, rate = 0.07, mag = 32, reload = 1.8, range = 280, spread = 1.4, auto = true, vs = G_VS, head = 1.5 },
  smgsd = { kind = "gun", dmg = 21, rate = 0.075, mag = 30, reload = 1.8, range = 320, spread = 1.1, auto = true, vs = G_VS, head = 1.6, quiet = true },
  pistol = { kind = "gun", dmg = 28, rate = 0.22, mag = 12, reload = 1.4, range = 220, spread = 0.9, vs = G_VS, head = 1.6 },
  rpg = { kind = "proj", dmg = 110, rate = 0.5, mag = 1, reserve = 3, reload = 3.4, range = 700, spread = 0.4, speed = 230, splash = 11, drop = true,
    vs = { inf = 1, light = 5, armor = 5.5, air = 3, ship = 2.5, fort = 4 } },
  manpads = { kind = "lock", dmg = 120, rate = 0.5, mag = 1, reserve = 1, reload = 3.5, range = 1400, speed = 320, splash = 9, lockTime = 1.6,
    vs = { inf = 0.3, light = 0.5, armor = 0.3, air = 6, ship = 0.5, fort = 0.2 } },
  grenade = { kind = "throw", dmg = 115, rate = 1.0, mag = 1, reserve = 1, reload = 0.8, range = 90, fuse = 2.8, splash = 14, speed = 70,
    vs = { inf = 1, light = 0.8, armor = 0.15, air = 0, ship = 0.1, fort = 0.6 } },
  mortar = { kind = "mortar", dmg = 95, rate = 1.6, mag = 1, reserve = 11, reload = 2.6, minR = 90, maxR = 950, splash = 17, flight = 5,
    vs = { inf = 1, light = 0.8, armor = 0.3, air = 0, ship = 0.25, fort = 0.8 } },
  medkit = { kind = "heal", amt = 35, r = 14, cd = 6, mag = 1, rate = 0.5, reload = 0 },
  repair = { kind = "repair", rate = 90, range = 16, mag = 1, reload = 0 },
  mine = { kind = "place", dmg = 260, splash = 9, mag = 1, reserve = 1, reload = 0.6, rate = 0.8, trigger = "vehicle",
    vs = { inf = 0.6, light = 4, armor = 4.5, air = 0, ship = 0, fort = 0 } },
  c4 = { kind = "place", dmg = 260, splash = 13, mag = 1, reserve = 1, reload = 0.6, rate = 0.8, trigger = "remote",
    vs = { inf = 1, light = 4, armor = 5, air = 0, ship = 2, fort = 5 } },
  binoc = { kind = "spot", range = 1600, spotTime = 12, cd = 4, strikeCd = 75, strike = { n = 8, r = 26, dmg = 120, splash = 20, flight = 6,
    vs = { inf = 1, light = 1, armor = 0.45, air = 0, ship = 0.3, fort = 1 } }, mag = 1, reload = 0 },
}

---------------------------------------------------------------- 载具（按名额；每队每种同时在场有上限，按队伍人数算）

-- cat 类别：tank 坦克、apc 装甲车、aa 防空、arty 火炮、heli 直升机、jet 固定翼、ship 舰艇
-- 每类按队给几个型号（Lang 里有名字）；hp、speed（格 / 秒）、tgt 中弹按什么类别算伤害
Config.VehicleCats = {
  tank = { tgt = "armor", hp = 1600, speed = 34, perN = 8, min = 1, max = 4, cd = 60 },
  apc = { tgt = "light", hp = 800, speed = 46, perN = 6, min = 1, max = 5, cd = 45, seats = 5 },
  aa = { tgt = "light", hp = 700, speed = 36, perN = 12, min = 1, max = 2, cd = 60 },
  arty = { tgt = "light", hp = 650, speed = 30, perN = 14, min = 0, max = 2, cd = 70 },
  heli = { tgt = "air", hp = 900, speed = 85, perN = 12, min = 1, max = 3, cd = 75, seats = 4 },
  jet = { tgt = "air", hp = 700, speed = 260, perN = 12, min = 1, max = 3, cd = 90 },
  ship = { tgt = "ship", hp = 3000, speed = 45, perN = 16, min = 0, max = 2, cd = 120 },
}
Config.VehicleOrder = { "tank", "apc", "aa", "arty", "heli", "jet", "ship" }
-- 型号：每队每类可选的型号（编号对应 Lang 里的名字和模型名）；mod 按型号微调（hp 倍数、速度倍数、主炮伤害倍数）
Config.Vehicles = {
  atk = {
    tank = { "ztq15", "ztz96", "ztz99a" },
    apc = { "ztd05", "zbd05", "zsl92b", "ptl02" },
    aa = { "pgz07", "pgl625", "ld2000" },
    arty = { "plz07" },
    heli = { "z10", "z20" },
    jet = { "j15t", "j35", "j20", "j16", "j50", "h6k", "gj11", "gj2" },
    ship = { "t055", "t054a", "t022" },
  },
  def = {
    tank = { "m10", "m1a1", "m1a2" },
    apc = { "m1117", "hmmwv", "jltv", "m2a3", "stryker", "m1150" },
    aa = { "m163", "mshorad", "cram", "patriot" },
    arty = { "m109a7", "m270", "m777" },
    heli = { "ah64e", "uh60", "ch47" },
    jet = { "a10c", "f35", "f22", "mq9", "b2" },
    ship = { "ddg125", "cg47", "lcs2", "pbr" },
  },
}
Config.VehicleMod = {
  ztq15 = { hp = 0.75, speed = 1.15, gun = 0.8 }, m10 = { hp = 0.8, speed = 1.1, gun = 0.85 },
  ztz96 = { hp = 0.9 }, m1a1 = { hp = 0.95 }, ztz99a = { hp = 1.1, gun = 1.1 }, m1a2 = { hp = 1.1, gun = 1.1 },
  zbd05 = { amphib = true }, ztd05 = { amphib = true, gun = 1.6 }, hmmwv = { hp = 0.5, speed = 1.25 }, jltv = { hp = 0.65, speed = 1.2 },
  m1150 = { hp = 1.4, speed = 0.8 }, m270 = { rocket = true }, patriot = { sam = true }, cram = { ciws = true },
  z20 = { transport = true }, uh60 = { transport = true }, ch47 = { transport = true, hp = 1.3 },
  h6k = { bomber = true, hp = 1.6, speed = 0.75 }, b2 = { bomber = true, hp = 1.5, speed = 0.8 }, a10c = { hp = 1.4, speed = 0.7 },
  gj11 = { drone = true, hp = 0.6 }, gj2 = { drone = true, hp = 0.6 }, mq9 = { drone = true, hp = 0.6, speed = 0.55 },
  t022 = { hp = 0.4, speed = 1.3 }, pbr = { hp = 0.25, speed = 1.4 }, lcs2 = { hp = 0.6, speed = 1.3 },
}
-- 这一队这一类最多同时在场几辆（按队伍人数，真人 + 机器人）
function Config.VehicleCap(cat, teamN)
  local c = Config.VehicleCats[cat]
  return math.clamp(math.floor(teamN / c.perN) + c.min, c.min, c.max)
end

---------------------------------------------------------------- 机器人

Config.Bots = {
  minPerTeam = 18,       -- 每队保底人数：真人不够用 AI 补
  maxTotal = 40,         -- 全服最多几个机器人
  hp = 100, speed = 14,  -- 步兵机器人：血量、走路速度（格 / 秒）
  weapon = "rifle",      -- 用哪种枪的伤害、射程
  sight = 520,           -- 看多远
  reaction = 0.8,        -- 发现新目标后多久开第一枪（秒，随机 ±40%）
  fireGap = 0.36,        -- 两枪之间（秒）
  spread = 0.8, spreadPer = 0.004,   -- 散布：基础几度 + 每格距离多几度（100 格约 1.2°、300 格约 2°）
}

---------------------------------------------------------------- 得分、经验、军衔

Config.Score = { kill = 100, botKill = 60, assist = 40, capture = 300, captureAssist = 120, heal = 10, repair = 10, spot = 15, win = 500, lose = 150, vehicleKill = 200 }
Config.Ranks = { 0, 500, 1500, 3500, 7000, 12000, 20000, 32000, 50000, 75000, 110000, 160000, 230000, 330000, 480000 }   -- 累计经验门槛（Lang 里有军衔名）
function Config.RankOf(xp)
  local i = 1
  for k, v in ipairs(Config.Ranks) do
    if xp >= v then i = k end
  end
  return i
end

return Config
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">Lang</string>
        <ProtectedString name="Source"><![CDATA[-- 暗剑：登岛战——中英文字。服务器给客户端发的是文字编号和参数，各人按自己的语言显示
--   客户端按 LocalizationService.RobloxLocaleId 判断：zh 开头用中文，其余英文；设置里能手动切
--   Lang.t(lang, key, ...)：{1} {2} … 换成参数；参数是表 { k = "编号", … } 时先翻译它（服务器发「据点 A」「步枪兵」这种）
local Lang = {}

local ZH, EN = {}, {}
Lang.zh, Lang.en = ZH, EN

local function add(key, zh, en)
  ZH[key] = zh
  EN[key] = en
end

---------------------------------------------------------------- 名字

add("game.title", "暗剑：登岛战", "Darksword: Island Assault")
add("team.atk", "进攻方", "Attackers")
add("team.def", "防守方", "Defenders")
add("team.atk.short", "攻", "ATK")
add("team.def.short", "守", "DEF")

add("role.rifle", "步枪兵", "Rifleman")
add("role.mg", "机枪手", "Machine Gunner")
add("role.sniper", "狙击手", "Sniper")
add("role.at", "反坦克兵", "Anti-Tank")
add("role.aa", "防空兵", "Anti-Air")
add("role.medic", "医疗兵", "Medic")
add("role.engineer", "工兵", "Engineer")
add("role.mortar", "迫击炮手", "Mortarman")
add("role.spec", "特种兵", "Special Forces")
add("role.spotter", "观察员", "Spotter")
add("role.rifle.desc", "步枪 + 手枪 + 手雷，什么都能打", "Rifle, pistol and a grenade. Good at everything")
add("role.mg.desc", "百发弹链的机枪，压制冲上来的人", "100-round machine gun to pin down attackers")
add("role.sniper.desc", "远距离一枪一个，爆头双倍", "One shot from far away. Headshots deal double")
add("role.at.desc", "火箭筒打坦克、装甲车、碉堡", "Rocket launcher against tanks, APCs and bunkers")
add("role.aa.desc", "单兵防空导弹，锁定直升机、飞机", "Shoulder SAM that locks onto helicopters and jets")
add("role.medic.desc", "冲锋枪 + 急救包，给身边的队友回血", "SMG and a medkit that heals nearby teammates")
add("role.engineer.desc", "修车、埋反坦克地雷", "Repairs vehicles and lays anti-tank mines")
add("role.mortar.desc", "迫击炮：点准星下的地面，炮弹几秒后落下", "Mortar: shells land where you aim a few seconds later")
add("role.spec.desc", "跑得快的消音冲锋枪 + 炸药包", "Fast, suppressed SMG and C4 charges")
add("role.spotter.desc", "望远镜标记敌人，呼叫炮火覆盖", "Binoculars to mark enemies and call artillery")

add("weapon.rifle", "步枪", "Rifle")
add("weapon.carbine", "卡宾枪", "Carbine")
add("weapon.lmg", "机枪", "LMG")
add("weapon.sniper", "狙击枪", "Sniper Rifle")
add("weapon.smg", "冲锋枪", "SMG")
add("weapon.smgsd", "消音冲锋枪", "Suppressed SMG")
add("weapon.pistol", "手枪", "Pistol")
add("weapon.rpg", "火箭筒", "Rocket Launcher")
add("weapon.manpads", "防空导弹", "MANPADS")
add("weapon.grenade", "手雷", "Grenade")
add("weapon.mortar", "迫击炮", "Mortar")
add("weapon.medkit", "急救包", "Medkit")
add("weapon.repair", "扳手", "Repair Tool")
add("weapon.mine", "反坦克地雷", "AT Mine")
add("weapon.c4", "炸药包", "C4")
add("weapon.binoc", "望远镜", "Binoculars")

add("point.A", "A 前哨岛", "A Outpost Isle")
add("point.B", "B 灯塔岛", "B Lighthouse Isle")
add("point.C", "C 港口镇", "C Harbor Town")
add("point.D", "D 机场", "D Airfield")
add("point.E", "E 指挥所", "E Command Post")
add("beach.red", "红滩", "Red Beach")
add("beach.white", "白滩", "White Beach")
add("beach.blue", "蓝滩", "Blue Beach")
add("beach.gold", "金滩", "Gold Beach")
add("beach.flank", "东北滩（侧翼）", "NE Beach (flank)")
add("beach.outpost", "前哨岛南岸", "Outpost Isle (south)")
add("beach.lighthouse", "灯塔岛南岸", "Lighthouse Isle (south)")
add("beach.port", "港湾（直冲港口）", "Harbor (port assault)")
add("spawn.camp", "后方营地", "Rear Camp")
add("spawn.fleet", "舰队（两栖攻击舰）", "Fleet (assault ship)")
add("spawn.para", "伞降", "Paradrop")

add("vcat.tank", "坦克", "Tanks")
add("vcat.apc", "装甲车", "APCs")
add("vcat.aa", "防空", "Anti-Air")
add("vcat.arty", "火炮", "Artillery")
add("vcat.heli", "直升机", "Helicopters")
add("vcat.jet", "固定翼", "Jets")
add("vcat.ship", "舰艇", "Ships")
local VEH = {
  ztq15 = { "ZTQ-15 轻型坦克", "ZTQ-15 Light Tank" }, ztz96 = { "ZTZ-96 主战坦克", "ZTZ-96 MBT" }, ztz99a = { "ZTZ-99A 主战坦克", "ZTZ-99A MBT" },
  m10 = { "M10 布克", "M10 Booker" }, m1a1 = { "M1A1 艾布拉姆斯", "M1A1 Abrams" }, m1a2 = { "M1A2 SEPv3", "M1A2 SEPv3" },
  ztd05 = { "ZTD-05 两栖突击车", "ZTD-05 Amphibious Assault Gun" }, zbd05 = { "ZBD-05 两栖步战车", "ZBD-05 Amphibious IFV" },
  zsl92b = { "ZSL-92B 轮式步战车", "ZSL-92B Wheeled IFV" }, ptl02 = { "PTL-02 突击炮", "PTL-02 Assault Gun" },
  m1117 = { "M1117 装甲警卫车", "M1117 Guardian" }, hmmwv = { "悍马", "Humvee" }, jltv = { "JLTV 联合轻型战术车", "JLTV" },
  m2a3 = { "M2A3 布雷德利", "M2A3 Bradley" }, stryker = { "斯特赖克", "Stryker" }, m1150 = { "M1150 突击破障车", "M1150 ABV" },
  pgz07 = { "PGZ-07 自行高炮", "PGZ-07 SPAAG" }, pgl625 = { "PGL-625 弹炮结合防空车", "PGL-625 Gun-Missile AA" }, ld2000 = { "LD-2000 近防炮", "LD-2000 CIWS" },
  m163 = { "M163 火神高炮", "M163 VADS" }, mshorad = { "M-SHORAD", "M-SHORAD" }, cram = { "C-RAM 陆基密集阵", "C-RAM" }, patriot = { "爱国者", "Patriot" },
  plz07 = { "PLZ-07 自行榴弹炮", "PLZ-07 SPH" }, m109a7 = { "M109A7 帕拉丁", "M109A7 Paladin" }, m270 = { "M270 火箭炮", "M270 MLRS" }, m777 = { "M777 榴弹炮", "M777 Howitzer" },
  z10 = { "直-10 武装直升机", "Z-10 Attack Helicopter" }, z20 = { "直-20 运输直升机", "Z-20 Transport Helicopter" },
  ah64e = { "AH-64E 阿帕奇", "AH-64E Apache" }, uh60 = { "UH-60 黑鹰", "UH-60 Black Hawk" }, ch47 = { "CH-47 支奴干", "CH-47 Chinook" },
  j15t = { "歼-15T", "J-15T" }, j35 = { "歼-35", "J-35" }, j20 = { "歼-20", "J-20" }, j16 = { "歼-16", "J-16" }, j50 = { "歼-50", "J-50" },
  h6k = { "轰-6K", "H-6K" }, gj11 = { "攻击-11", "GJ-11" }, gj2 = { "攻击-2", "GJ-2" },
  a10c = { "A-10C 雷电", "A-10C Thunderbolt" }, f35 = { "F-35", "F-35" }, f22 = { "F-22 猛禽", "F-22 Raptor" }, mq9 = { "MQ-9 死神", "MQ-9 Reaper" }, b2 = { "B-2 幽灵", "B-2 Spirit" },
  t055 = { "055 型驱逐舰", "Type 055 Destroyer" }, t054a = { "054A 型护卫舰", "Type 054A Frigate" }, t022 = { "022 型导弹艇", "Type 022 Missile Boat" },
  ddg125 = { "DDG-125 驱逐舰", "DDG-125 Destroyer" }, cg47 = { "CG-47 巡洋舰", "CG-47 Cruiser" }, lcs2 = { "LCS-2 濒海战斗舰", "LCS-2 Littoral Combat Ship" }, pbr = { "PBR 巡逻艇", "PBR Patrol Boat" },
  lcm = { "登陆艇", "Landing Craft" }, lcac = { "726 型气垫艇", "Type 726 LCAC" },
}
for k, v in pairs(VEH) do add("veh." .. k, v[1], v[2]) end

local RANKS = {
  { "列兵", "Private" }, { "上等兵", "Private First Class" }, { "下士", "Corporal" }, { "中士", "Sergeant" }, { "上士", "Staff Sergeant" },
  { "少尉", "Second Lieutenant" }, { "中尉", "First Lieutenant" }, { "上尉", "Captain" }, { "少校", "Major" }, { "中校", "Lieutenant Colonel" },
  { "上校", "Colonel" }, { "大校", "Senior Colonel" }, { "少将", "Major General" }, { "中将", "Lieutenant General" }, { "上将", "General" },
}
for i, v in ipairs(RANKS) do add("rank." .. i, v[1], v[2]) end

---------------------------------------------------------------- 界面

add("ui.deploy", "部署", "Deploy")
add("ui.chooseRole", "选择兵种", "Choose your role")
add("ui.chooseSpawn", "选择出生点", "Choose a spawn point")
add("ui.deployBtn", "出击", "DEPLOY")
add("ui.waitRespawn", "{1} 秒后可以重新部署", "Redeploy in {1}s")
add("ui.prep", "准备阶段：{1} 秒后开战", "Get ready: battle starts in {1}s")
add("ui.youAre", "你在{1}", "You are on the {1}")
add("ui.goalAtk", "拿下全部 5 个据点（每拿下一个，时间 +3 分钟）", "Capture all 5 points (each capture adds 3 minutes)")
add("ui.goalDef", "守住任何一个据点直到时间结束", "Hold at least one point until time runs out")
add("ui.timeLeft", "剩余", "Time")
add("ui.overtime", "加时", "Overtime")
add("ui.capturing", "正在占领 {1}", "Capturing {1}")
