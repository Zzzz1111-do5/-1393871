add("ui.speed", "{1} 公里/时", "{1} km/h")
add("ui.range", "{1} 米", "{1} m")
add("sight.day", "昼光", "DAY")
add("sight.nv", "夜视", "NV")
add("sight.whot", "热成像 · 白热", "THERMAL · WHT")
