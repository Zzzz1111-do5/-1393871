+print("④e 歼-36（用户给的模型，换掉歼-50）：起落架、舱门、主 / 侧弹舱、开裂式方向舵、座舱盖都能动，并排两个飞行员；鹰击-21 先掉、再爬高、最后扎下来")
+do
+	local dj = AD.get("j36")
+	check(dj ~= nil and AD.get("j50") == nil, "型号表里有歼-36、没有歼-50 了")
+	local MJ = AM.build(dj, "atk", AD.presetLoad(dj))
+	local gN, meshes, pilots = 0, 0, {}
+	for _, it in ipairs(MJ.items) do
+		if it.tag == "gear" then gN += 1 end
+		if it.p:IsA("MeshPart") and string.sub(it.p.Name, 1, 7) == "A_j36__" then meshes += 1 end
+		if it.tag == "pilot" and it.seat then pilots[it.seat] = true end
+	end
+	check(MJ.imported == "j36" and gN == 0 and meshes == count(IA.m.j36.parts), string.format("原模型 %d 块全用上（元数据 %d 块），不用零件拼的起落架（%d）", meshes, count(IA.m.j36.parts), gN))
+	check(pilots[1] and pilots[2], "并排两个座位都有飞行员")
+	local function grp(pat)
+		local lo, sum, n = math.huge, V3.new(0, 0, 0), 0
+		for _, it in ipairs(MJ.items) do
+			if it.p:IsA("MeshPart") and string.find(it.p.Name, "__" .. pat) then
+				local cf, h = rel(it.p), it.p.Size / 2
+				for _, sx in ipairs({ -1, 1 }) do for _, sy in ipairs({ -1, 1 }) do for _, sz in ipairs({ -1, 1 }) do
+					lo = math.min(lo, (cf * V3.new(sx * h.X, sy * h.Y, sz * h.Z)).Y)
+				end end end
+				sum += cf.Position
+				n += 1
+			end
+		end
+		return lo, n > 0 and sum / n or nil
+	end
+	pose(MJ, { gear = 1 })
+	local loM = math.min((grp("GearBL_")), (grp("GearBR_")))
+	local loN = (grp("GearN_"))
+	local _, dOpen = grp("GDoorL_")
+	check(math.abs(loM - (-dj.gearH)) < 0.6 and math.abs(loN - (-dj.gearH)) < 0.8, string.format("放下起落架：主轮最低 %.2f、前轮最低 %.2f 格，地面 %.2f", loM, loN, -dj.gearH))
+	pose(MJ, { gear = 0 })
+	local loM0 = math.min((grp("GearBL_")), (grp("GearBR_")))
+	local _, dShut = grp("GDoorL_")
+	local _, nShut = grp("GDoorNL_")
+	check(loM0 > loM + 2, string.format("收起落架：串列双轮小车收上去了（最低点 %.2f → %.2f）", loM, loM0))
