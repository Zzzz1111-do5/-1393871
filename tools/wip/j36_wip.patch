index 0000000..c564bc2
--- /dev/null
+++ b/tools/models/j36_prep.py
@@ -0,0 +1,315 @@
+# 歼-36（用户给的「J36, J-36, J 36, v2 Chengdu Aircraft Corporation」，positivevubez4eva，CC-BY-4.0）→ 烘焙用的 GLB + 活动部件表
+#   python3 -I tools/models/j36_prep.py <原 GLB> <输出目录>
+#     → <输出目录>/j36.glb：每个活动部件一个节点（G_<部件名>），烘焙配置按节点名分部件（打印出来）；只留机体材质（Skin）和座舱盖玻璃（Glass）
+#       tools/models/kf/j36.json：活动部件表（网页版烘焙后的坐标，同 air_kf.py），air2glb.py 读
+#   原模型没有动画，起落架、舱门是一个个连通块（座椅、仪表板、螺栓都是单独的块），这里按位置挑：
+#     去掉：贴花文字（字体图集材质：Roboto / DSEG14 / Jefferies / LiberationSans）、看不见的碰撞块（DoNothing）、弹舱里自带的弹（游戏按实际挂载另画）
+#     前起落架（双轮）往后收进机头下的舱，两扇侧门随后合上；主起落架（串列双轮小车，同苏-34）支柱往前上方收、小车保持水平，外侧大舱门最后合上；
+#     放起落架反过来：先开门、再放支柱（操纵量 gear 0 收起～1 放下，前 18% 是舱门、20% 以后是支柱）
+#     主弹舱两扇门（外侧边铰链）、侧弹舱门（外侧边铰链）往下翻；座舱盖后端铰链往上掀
+#   原模型坐标：x 左右（x > 0 是左边）、y 上、z 前（机头 +z），单位米
+import json, os, struct, sys
+import numpy as np
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import air_kf as KF   # noqa: E402  读写 GLB、四元数
+import air_anim as A   # noqa: E402  probe_sign
+
+KEY = 'j36'
+LEN = 22.98   # 原模型长（米），烘焙按这个缩放（等于不缩）
+SKIN, GLASS = 'PartMaterialClone', 'PartTransparentZWriteClone'
+K = 24
+
+
+def components(F, n):
+    """按边连通分块（向量化的取最小标号 + 指针跳跃）"""
+    a = np.concatenate([F[:, 0], F[:, 1], F[:, 2]])
+    b = np.concatenate([F[:, 1], F[:, 2], F[:, 0]])
+    lab = np.arange(n)
+    while True:
+        m = np.minimum(lab[a], lab[b])
+        old = lab.copy()
+        np.minimum.at(lab, a, m)
+        np.minimum.at(lab, b, m)
+        while True:
+            nl = lab[lab]
+            if np.array_equal(nl, lab):
+                break
+            lab = nl
+        if np.array_equal(lab, old):
+            break
+    return lab
+
+
+def smooth(e0, e1, x):
+    t = np.clip((x - e0) / (e1 - e0), 0, 1)
+    return t * t * (3 - 2 * t)
+
+
+def rotm(axis, th):
+    k = np.asarray(axis, float)
+    k = k / np.linalg.norm(k)
+    Kx = np.array([[0, -k[2], k[1]], [k[2], 0, -k[0]], [-k[1], k[0], 0]])
+    return np.eye(3) + np.sin(th) * Kx + (1 - np.cos(th)) * Kx @ Kx
+
+
+def main(src, outdir):
+    J, BIN = KF.read_glb(src)
+    g = KF.G(J, BIN)
+    P, N, T, M = [], [], [], []
+    base = 0
+    for i, nd in enumerate(J['nodes']):
+        if 'mesh' not in nd:
+            continue
+        W = g.world(i)
+        for pr in J['meshes'][nd['mesh']]['primitives']:
+            mat = J['materials'][pr.get('material', 0)]['name']
+            if mat not in (SKIN, GLASS):   # 贴花文字、看不见的碰撞块
+                continue
+            p = g.acc(pr['attributes']['POSITION'])
+            n = g.acc(pr['attributes']['NORMAL']) if 'NORMAL' in pr['attributes'] else np.zeros_like(p)
+            t = g.acc(pr['indices']).astype(np.int64).reshape(-1, 3) if 'indices' in pr else np.arange(len(p)).reshape(-1, 3)
+            P.append(p @ W[:3, :3].T + W[:3, 3])
+            N.append(n @ np.linalg.inv(W[:3, :3]))
+            T.append(t + base)
+            M += ['Glass' if mat == GLASS else 'Skin'] * len(t)
+            base += len(p)
+    P, N, T, M = np.concatenate(P), np.concatenate(N), np.concatenate(T), np.array(M)
+    q = np.round(P * 2000).astype(np.int64)   # 0.5 毫米焊接
+    _, vid = np.unique(q, axis=0, return_inverse=True)
+    vid = vid.ravel()
+    C = components(vid[T], vid.max() + 1)[vid[T[:, 0]]]
+    ids, inv = np.unique(C, return_inverse=True)
+    nC = len(ids)
+    # 每块的包围盒、三角形数、是不是玻璃
+    lo = np.full((nC, 3), 1e9)
+    hi = np.full((nC, 3), -1e9)
+    V = P[T]   # (n, 3, 3)
+    np.minimum.at(lo, inv, V.min(1))
+    np.maximum.at(hi, inv, V.max(1))
+    cnt = np.bincount(inv, minlength=nC)
+    glass = np.zeros(nC, bool)
+    glass[inv[M == 'Glass']] = True
+    cen, ext = (lo + hi) / 2, hi - lo
+    ax = np.abs(cen[:, 0])
+    grp = np.array(['Body'] * nC, dtype=object)
+    side = np.where(cen[:, 0] > 0, 'L', 'R')
+
+    # —— 去掉弹舱里自带的弹（细长、在舱门以上、舱顶以下）和挂在弹上的小零件 ——
+    inbay = (ax < 2.15) & (lo[:, 1] > 4.26) & (hi[:, 1] < 4.76) & (cen[:, 2] > -3.6) & (cen[:, 2] < 4.4)
+    missile = inbay & (ext[:, 2] > 2.0) & (ext[:, 0] < 0.5)
+    small = inbay & (cnt <= 300) & (ext[:, 2] < 1.0)
+    grp[missile | small] = 'Drop'
+    # —— 起落架 ——
+    nose = (ax < 0.35) & (cen[:, 2] > 5.3) & (cen[:, 2] < 6.8) & (lo[:, 1] < 4.0)
+    grp[nose] = 'GearN'
+    mainG = (ax > 2.05) & (ax < 2.95) & (cen[:, 2] > -4.0) & (cen[:, 2] < -1.8) & (lo[:, 1] < 4.0)
+    bogie = mainG & (hi[:, 1] <= 3.62)
+    grp[mainG & ~bogie] = 'Gear'
+    grp[bogie] = 'GearB'
+    ndoor = (ax > 0.38) & (ax < 0.47) & (lo[:, 1] < 3.8) & (hi[:, 1] < 4.2) & (ext[:, 2] > 1.5)
+    grp[ndoor] = 'GDoorN'
+    mdoor = (ax > 2.95) & (ax < 3.95) & (cen[:, 2] > -3.6) & (cen[:, 2] < 0.3) & (lo[:, 1] < 4.3) & (ext[:, 2] > 2.5)
+    grp[mdoor] = 'GDoor'
+    # —— 弹舱门：机腹最底下那一层薄板 ——
+    flat = (lo[:, 1] >= 4.14) & (hi[:, 1] <= 4.27) & (ext[:, 2] > 2.5)
+    bayM = flat & (hi[:, 0] <= 1.2) & (lo[:, 0] >= -1.2) & (cen[:, 2] > -3.5) & (cen[:, 2] < 4.2)
+    bayS = flat & (ax > 1.1) & (ax < 2.1) & (ext[:, 0] < 1.0) & (cen[:, 2] > -3.5) & (cen[:, 2] < 2.0)
+    grp[bayM] = 'BayM'
+    grp[bayS] = 'BayS'
+    # —— 座舱盖：玻璃 + 顶上那根框 ——
+    canopy = glass | ((ax < 0.4) & (lo[:, 1] > 6.25) & (cen[:, 2] > 5.0) & (cen[:, 2] < 7.2) & (ext[:, 2] > 1.2))
+    grp[canopy] = 'Canopy'
+
+    # 每个三角形的部件名（左右分开；横跨中线的主弹舱门按三角形中心分）
+    tg = grp[inv].astype(object)
+    sd = side[inv]
+    tc = V.mean(1)
+    for base_ in ('Gear', 'GearB', 'GDoorN', 'GDoor', 'BayS'):
+        m = tg == base_
+        tg[m] = np.char.add(base_, sd[m]).astype(object)
+    m = tg == 'BayM'
+    tg[m] = np.where(tc[m, 0] > 0, 'BayML', 'BayMR')
+    keep = tg != 'Drop'
+    print('去掉弹舱里的弹 %d 块（%d 个三角形）' % ((grp == 'Drop').sum(), (~keep).sum()))
+    for nm in sorted(set(tg[keep])):
+        print('  %-8s %6d 个三角形' % (nm, (tg == nm).sum()))
+
+    # —— 烘焙的缩放、原点（同 v3gbake.js：x 前 = 原 z、y 左 = 原 x、z 上 = 原 y；长度方向缩到 LEN、前后左右居中、最低点为 0）——
+    Ax = np.array([[0, 0, 1.0], [1.0, 0, 0], [0, 1.0, 0]])
+    Pk = P[np.unique(T[keep].ravel())] @ Ax.T
+    blo, bhi = Pk.min(0), Pk.max(0)
+    s = LEN / (bhi[0] - blo[0])
+    o = np.array([(blo[0] + bhi[0]) / 2, (blo[1] + bhi[1]) / 2, blo[2]])
+
+    def web(p):
+        return (np.asarray(p, float) @ Ax.T - o) * s
+
+    def vpts(name):
+        return P[np.unique(T[tg == name].ravel())]
+
+    # —— 挪开不同部件之间离得太近的顶点（烘焙按 0.1 毫米焊接，并成一块就分不开了）——
+    vt = np.full(len(P), '', dtype=object)
+    for nm in set(tg[keep]):
+        vt[np.unique(T[tg == nm].ravel())] = nm
+    cellk = np.floor(P / 2e-4).astype(np.int64)
+    order = np.lexsort(cellk.T)
+    moved = 0
+    groups_c = {nm: vpts(nm).mean(0) for nm in set(tg[keep])}
+    ck = cellk[order]
+    same = np.all(ck[1:] == ck[:-1], axis=1)
+    for j in np.where(same)[0]:
+        a, b = order[j], order[j + 1]
+        if vt[a] != vt[b] and vt[a] and vt[b]:
+            for v in (a, b):
+                if vt[v] != 'Body':
+                    dv = groups_c[vt[v]] - P[v]
+                    P[v] += dv / (np.linalg.norm(dv) or 1) * 1.5e-3
+                    moved += 1
+    print('挪开了 %d 个和别的部件挨着的顶点' % moved)
+
+    # —— 写烘焙用的 GLB：每个部件一个节点 ——
+    out = {'asset': {'version': '2.0', 'generator': 'RobloxTotalBattlefield j36_prep.py'}, 'scene': 0, 'scenes': [{'nodes': [0]}],
+           'nodes': [{'name': 'J36', 'children': []}], 'meshes': [], 'accessors': [], 'bufferViews': [], 'buffers': [],
+           'materials': [{'name': 'Skin', 'pbrMetallicRoughness': {'baseColorFactor': [0.072, 0.077, 0.085, 1], 'metallicFactor': 0.15, 'roughnessFactor': 0.6}, 'doubleSided': True},
+                         {'name': 'Glass', 'pbrMetallicRoughness': {'baseColorFactor': [0.05, 0.06, 0.07, 0.35], 'metallicFactor': 0.2, 'roughnessFactor': 0.1},
+                          'alphaMode': 'BLEND', 'doubleSided': True}]}
+    blob = bytearray()
+
+    def view(data, target=None):
+        while len(blob) % 4:
+            blob.append(0)
+        o_ = len(blob)
+        blob.extend(data)
+        bv = {'buffer': 0, 'byteOffset': o_, 'byteLength': len(data)}
+        if target:
+            bv['target'] = target
+        out['bufferViews'].append(bv)
+        return len(out['bufferViews']) - 1
+
+    def acc(arr, typ, ctype=5126, minmax=False, target=34962):
+        a = {'bufferView': view(np.ascontiguousarray(arr).tobytes(), target), 'componentType': ctype, 'count': len(arr), 'type': typ}
+        if minmax:
+            a['min'] = [float(v) for v in arr.min(0)]
+            a['max'] = [float(v) for v in arr.max(0)]
+        out['accessors'].append(a)
+        return len(out['accessors']) - 1
+
+    names = sorted(set(tg[keep]))
+    for nm in names:
+        prims = []
+        for mi, mat in enumerate(('Skin', 'Glass')):
+            sel = (tg == nm) & (M == mat)
+            if not sel.any():
+                continue
+            u, iv = np.unique(T[sel].ravel(), return_inverse=True)
+            nn = N[u] / np.maximum(np.linalg.norm(N[u], axis=1, keepdims=True), 1e-9)
+            prims.append({'attributes': {'POSITION': acc(P[u].astype(np.float32), 'VEC3', minmax=True), 'NORMAL': acc(nn.astype(np.float32), 'VEC3')},
+                          'indices': acc(iv.astype(np.uint32), 'SCALAR', 5125, target=34963), 'material': mi})
+        out['meshes'].append({'name': 'G_' + nm, 'primitives': prims})
+        out['nodes'].append({'name': 'G_' + nm, 'mesh': len(out['meshes']) - 1})
+        out['nodes'][0]['children'].append(len(out['nodes']) - 1)
+    out['buffers'].append({'byteLength': len(blob)})
+    js = json.dumps(out, separators=(',', ':')).encode()
+    while len(js) % 4:
+        js += b' '
+    while len(blob) % 4:
+        blob.append(0)
+    os.makedirs(outdir, exist_ok=True)
+    glb = os.path.join(outdir, KEY + '.glb')
