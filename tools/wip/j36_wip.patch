+    # 主弹舱门：外侧边铰链往下翻 100°；侧弹舱门同样
+    for nm, k, A_ in (('BayML', 'bay', 1.75), ('BayMR', 'bay', 1.75), ('BaySL', 'bayS', 1.75), ('BaySR', 'bayS', 1.75)):
