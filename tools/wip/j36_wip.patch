+        f.write(struct.pack('<III', 0x46546C67, 2, 12 + 8 + len(js) + 8 + len(blob)))
+        f.write(struct.pack('<II', len(js), 0x4E4F534A) + js)
+        f.write(struct.pack('<II', len(blob), 0x004E4942) + bytes(blob))
+
+    # —— 活动部件 ——
+    surf = {}
+    us = np.linspace(0, 1, K)
+    door_k = smooth(0.0, 0.18, us)    # 舱门：放起落架时先开（0～18%），收的时候最后关
+    gear_k = smooth(0.2, 1.0, us)     # 支柱：20% 以后才动
+
+    def kf(nm, pivot, motions, ch='gear'):
+        """motions：每个 u 的 (R 原模型坐标的转动, d 支点挪动)"""
+        keys = []
+        for R, d in motions:
+            dw = s * (Ax @ d)
+            qw = KF.mat_q(Ax @ R @ Ax.T)
+            keys.append([round(float(v), 4) for v in list(dw) + list(qw)])
+        for j in range(1, len(keys)):
+            if np.dot(keys[j][3:], keys[j - 1][3:]) < 0:
+                keys[j][3:] = [-v for v in keys[j][3:]]
+        surf[nm] = {'k': 'kf', 'ch': ch, 'p': [round(float(v), 4) for v in web(pivot)], 'key': keys}
+
+    # 前起落架：支柱顶的横轴往后收 95°（轮子往后上方进机头下的舱）
+    Pn = vpts('GearN')
+    pn = np.array([0.0, Pn[:, 1].max() - 0.05, Pn[Pn[:, 1] > Pn[:, 1].max() - 0.25][:, 2].mean()])
+    kf('GearN', pn, [(rotm([1, 0, 0], np.radians(95) * (1 - gk)), np.zeros(3)) for gk in gear_k])
+    # 前起落架侧门：上沿的纵轴往里合 90°
+    for sd_ in ('L', 'R'):
+        Q = vpts('GDoorN' + sd_)
+        sg = 1 if sd_ == 'L' else -1
+        hp = np.array([Q[:, 0].mean(), Q[:, 1].max(), (Q[:, 2].min() + Q[:, 2].max()) / 2])
+        kf('GDoorN' + sd_, hp, [(rotm([0, 0, 1], -sg * np.radians(90) * (1 - dk)), np.zeros(3)) for dk in door_k])
+    # 主起落架：支柱顶的轴（横轴往里偏 8°，轮子往前上方、稍往里收）转 −90°；小车跟着平移、保持水平；外侧大舱门最后合上
+    for sd_ in ('L', 'R'):
+        sg = 1 if sd_ == 'L' else -1
+        Qs, Qb = vpts('Gear' + sd_), vpts('GearB' + sd_)
+        top = Qs[:, 1].max()
+        crown = Qs[Qs[:, 1] > top - 0.2]
+        pm = np.array([crown[:, 0].mean(), top - 0.03, crown[:, 2].mean()])
+        axis = rotm([0, 1, 0], -sg * np.radians(8)) @ np.array([1.0, 0, 0])
+        pb = np.array([pm[0], (Qb[:, 1].min() + Qb[:, 1].max()) / 2, (Qb[:, 2].min() + Qb[:, 2].max()) / 2])
+        mot_s, mot_b = [], []
+        for gk in gear_k:
+            R = rotm(axis, -np.radians(90) * (1 - gk))
