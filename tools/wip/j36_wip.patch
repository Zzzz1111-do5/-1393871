+        kf('GearB' + sd_, pb, mot_b)
+        # 外侧大舱门：铰链在上沿（贴着机翼下表面），下沿往里转到机身侧面最低处
+        Q = vpts('GDoor' + sd_)
+        hp = np.array([Q[Q[:, 1] > Q[:, 1].max() - 0.08][:, 0].mean(), Q[:, 1].max(), (Q[:, 2].min() + Q[:, 2].max()) / 2])
+        bot = Q[np.argmin(Q[:, 1])]
+        want = np.array([sg * 2.25, 4.22])
+        a0 = np.arctan2(bot[1] - hp[1], bot[0] - hp[0])
+        a1 = np.arctan2(want[1] - hp[1], want[0] - hp[0])
+        da = np.arctan2(np.sin(a1 - a0), np.cos(a1 - a0))
+        kf('GDoor' + sd_, hp, [(rotm([0, 0, 1], da * (1 - dk)), np.zeros(3)) for dk in door_k])
+        print('主起落架%s：支点 %s，小车支点 %s，舱门合上转 %.0f°' % (sd_, pm.round(2), pb.round(2), np.degrees(da)))
+
+    def hinge(nm, a, b, k, probe, want, A_):
+        aw, bw = web(a), web(b)
+        e = {'k': k, 's': 0 if k == 'canopy' else (-1 if (a[0] + b[0]) > 0 else 1), 'a': [round(float(v), 4) for v in aw], 'b': [round(float(v), 4) for v in bw],
+             'sg': A.probe_sign(aw, bw, web(probe), want), 'A': A_}
+        surf[nm] = e
