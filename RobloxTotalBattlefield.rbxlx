        <ProtectedString name="Source"><![CDATA[-- 自动生成（tools/fps/fps_bake.py），别手改：第一人称 M4 的网格和贴图，从「M4 - FPS Weapon Animations Pack (v.1)」（BarcodeGames，CC-BY-4.0）转来
--   客户端用 EditableMesh / EditableImage 生成 MeshPart（FPSView）：nodes[名字] = { piece 跟哪条动画轨道, c 包围盒中心（在骨骼坐标里，格）, n 顶点数, t 三角形数,
--     mat 用哪张贴图, pos 顶点（float32 xyz，已减去中心）, nrm 法线（int8 xyz ÷127）, uv（uint16 ÷65535，V 朝下）, idx 三角形（uint16，逆时针是正面）}，都是小端 base64
--   tex[名字] = { w, h, rgb（每像素 3 字节，从上往下一行行）}
return {
  nodes = {
    FPS_M4_Bolt = { piece = "bolt", c = { 0, 0, -0.0447 }, n = 53, t = 46, mat = "M4",
      pos = "",
      nrm = "ggsAiRrchBsAiRoljTUAkTTfkTQihQTfgfoAjx3OhgQhjx0znE8AkTQijw7Ijw45hgQh2HkAz3UA2HkAiNcAhBsAhBsAgfoAsGMAlbwAkMUAlbwAkT8AhBsBgfoAmd1BAAB/AAB/AAB/wWIyhBsBlhdDkcIAlbwArs1TAAB/AAB/AAB/2HkAzXQA32VGwWIy32VGkT8Brs1TlhdDmd1B",
      uv = "PTI4NPg3TjI9MrkymixOMj0yDDGbNzEx9SwxMZs3iTM9Mpo2qjaTNPUsiTPiLZM0PTJsLvUsMTGqNkQw4i1EMPUsiTNHGmwu4i1EMD0ybC5HGpM0mixOMkcaTjL1LIkzRxpEMD0ymjbiLZM0RxqaNvUsMTH4N04ymzeJM6w+kzRaOt43SDtvO9A3eDmsPkQw+DdOMqw+TjKqNpM0PTKaNqw+mjYgOfQ+NTxPP043iDw9MmwuqjZEMEo89TcjPpA4rD5sLps3MTHrPXE+Ij9cOgo/qTw=",
      idx = "" },
    FPS_M4_BoltCatch = { piece = "catch", c = { 0.0008, 0.0167, 0 }, n = 60, t = 38, mat = "M4",
      pos = "",
      nrm = "AACBAACBAACBAACBAACBAACBAACBAACBALCdALCdALCdALCdAH8AAH8AAH8AAH8AfvQAfwEAfvQAfwEAf/0Aet4Af/0Aet4AAAB/AAB/AAB/AAB/AAB/AAB/AAB/AAB/fwAAfwAAfwAAfwAAfwAAfwAAfwAAfwAAAFNgAFNgAFNgAFNgALBjALBjALBjALBjAFOgAFOgAFOgAFOgAACBAACBAACBAACBAAB/AAB/AAB/AAB/",
      uv = "",
      idx = "" },
    FPS_M4_Mag1 = { piece = "mag1", c = { 0, 0, 0 }, n = 460, t = 676, mat = "M4",
      pos = "",
      nrm = "",
      uv = "",
      idx = "" },
    FPS_M4_Mag2 = { piece = "mag2", c = { 0, 0, 0 }, n = 460, t = 676, mat = "M4",
      pos = "",
      nrm = "",
      uv = "",
      idx = "" },
    FPS_M4_Main = { piece = "gun", c = { 0, -0.0756, 0.2278 }, n = 9510, t = 8106, mat = "M4",
      pos = "",
      nrm = "",
      uv = "",
