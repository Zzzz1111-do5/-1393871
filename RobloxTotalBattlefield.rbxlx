    ["drv.xray"] = "RÖNTGEN",
    ["drv.xrayInside"] = "Röntgenblick geht nicht aus dem Innenraum: wechsle zuerst nach außen",
    ["eco.attLock"] = "Lv. {1} oder {2} Münzen",
    ["eco.boughtAtt"] = "{1} freigeschaltet (-{2} Münzen)",
    ["eco.boughtVeh"] = "{1} freigeschaltet (-{2} Münzen)",
    ["eco.coins"] = "{1} Münzen",
    ["eco.confirm"] = "Erneut klicken, um {2} für {1} Münzen freizuschalten",
    ["eco.lockVeh"] = "{1} Münzen zum Freischalten",
    ["eco.needVeh"] = "Noch nicht freigeschaltet ({1} Münzen)",
    ["eco.notLoaded"] = "Dein Profil wird noch geladen",
    ["eco.poor"] = "Nicht genug Münzen (es fehlen {1})",
    ["eco.pve"] = "Missionsbelohnung +{1} Münzen",
    ["eco.round"] = "+{1} Münzen in dieser Runde",
    ["eo.hint"] = "[P] Behälter verlassen · Maus schwenken · Rad Zoom\n[Z] weit / eng · [V] weiß-heiß / schwarz-heiß / TV\n[R] nächstes Ziel · Klick auslösen / feuern · Autopilot hält Horizontalflug",
    ["eo.range"] = "ENTF",
    ["eo.sayArea"] = "Schwenken zum Suchen, Rad zum Zoomen.",
    ["eo.sayHold"] = "Waffe ab. Halte den Behälter auf dem Ziel.",
    ["eo.sayPoint"] = "Ziel verfolgt. Klicken zum Auslösen.",
    ["eo.title"] = "EO-BEHÄLTER",
    ["faction.atk.desc"] = "Kämpft euch vom Meer aus vor: Stürmt Außenposten A, landet auf der Hauptinsel, nehmt Hafen C und Flugplatz D und erobert dann Kommando E. Einmal an Land, spawnt ihr an der Angriffsposition vor jedem Ziel. Jeder Tod kostet eine Verstärkung; gehen sie aus, habt ihr verloren.",
    ["faction.atk.desc@city"] = "Rollt aus der südlichen Hauptbasis (Fahrzeugpark, Hubschrauberlandeplätze und Piste liegen darin): nehmt Stahlwerk A, dann Park B, Zentralplatz C und den Bahnhof D und schließlich den Fernsehturm E im Norden. Enge Straßen und Gebäude versperren die Sicht: Achtet auf Ecken und Lücken. Bäume fallen beim Rammen; Granaten bringen Gebäude zum Einsturz.",
    ["faction.atk.desc@sands"] = "Stoßt von der vorgeschobenen Basis und dem Feldflugplatz nach Norden vor: Durchbrecht den Grenzwall und nehmt Posten A, dann Ölfeld B, Stadt C und Fliegerhorst D und schließlich Kommando E auf dem Kamm. Spawnt an der Angriffsposition vor jedem Ziel. Jeder Tod kostet eine Verstärkung; gehen sie aus, habt ihr verloren.",
    ["faction.atk.desc@snow"] = "Rollt aus der südlichen Hauptbasis (Fahrzeugpark, Hubschrauberlandeplätze und Piste liegen darin): nehmt Sägewerk A, dann die Radarstation B am Westhang, das Dorf C am Fluss, das Wasserkraftwerk D am Eissee und schließlich den Pass E im Norden. Das Tal steckt voller Grate und Rinnen: Kämpft in Hull-down-Stellung hinter den Kämmen — auf dem Eis gibt es keine Deckung.",
    ["faction.atk.role"] = "ANGRIFF  ·  AMPHIBISCHE LANDUNG",
    ["faction.atk.role@city"] = "ANGRIFF  ·  VON SÜDEN IN DIE STADT",
    ["faction.atk.role@sands"] = "ANGRIFF  ·  PANZERANGRIFF",
    ["faction.atk.role@snow"] = "ANGRIFF  ·  DAS TAL HINAUF",
    ["faction.def.desc"] = "Haltet die Linie, Sektor für Sektor: Verteidigt die aktuellen Ziele, bis den Angreifern Verstärkung oder Zeit ausgeht. Ist ein Ziel umkämpft, spawnt ihr am Sammelpunkt dahinter.",
    ["faction.def.desc@snow"] = "Haltet das Tal Punkt für Punkt: Sägewerk A, Radarstation B, Dorf C, Wasserkraftwerk D und den Pass E. Kämpft von den Höhen (das Radarplateau, die Schultern des Passes); in den Dorfruinen lässt sich ein Panzer verstecken.",
    ["faction.def.role"] = "VERTEIDIGUNG  ·  INSELVERTEIDIGUNG",
    ["faction.def.role@city"] = "VERTEIDIGUNG  ·  DIE STADT HALTEN",
    ["faction.def.role@sands"] = "VERTEIDIGUNG  ·  TIEFENVERTEIDIGUNG",
    ["faction.def.role@snow"] = "VERTEIDIGUNG  ·  DEN PASS HALTEN",
