    ["eco.boughtVeh"] = "{1} desbloqueado (-{2} monedas)",
    ["eco.coins"] = "{1} monedas",
    ["eco.confirm"] = "Haz clic otra vez para desbloquear {2} por {1} monedas",
    ["eco.lockVeh"] = "{1} monedas para desbloquear",
    ["eco.needVeh"] = "Aún no desbloqueado ({1} monedas)",
    ["eco.notLoaded"] = "Tu perfil aún se está cargando",
    ["eco.poor"] = "No tienes suficientes monedas (faltan {1})",
    ["eco.pve"] = "Recompensa de misión +{1} monedas",
    ["eco.round"] = "+{1} monedas esta ronda",
    ["eo.hint"] = "[P] salir del contenedor · ratón girar · rueda zoom\n[Z] amplio / estrecho · [V] blanco caliente / negro caliente / TV\n[R] siguiente objetivo · clic soltar / disparar · el piloto automático mantiene el vuelo nivelado",
    ["eo.range"] = "DIST",
    ["eo.sayArea"] = "Mueve para buscar, rueda para hacer zoom.",
    ["eo.sayHold"] = "Arma fuera. Mantén el contenedor en el objetivo.",
    ["eo.sayPoint"] = "Objetivo seguido. Haz clic para soltar.",
    ["eo.title"] = "CONTENEDOR EO",
    ["faction.atk.desc"] = "Ábrete paso desde el mar: asalta el puesto avanzado A, desembarca en la isla principal para tomar el puerto C y el aeródromo D, y luego captura el mando E. Ya en tierra, reaparece en la posición de asalto frente a cada objetivo. Cada muerte cuesta un refuerzo; si se acaban, pierdes.",
    ["faction.atk.desc@city"] = "Sal de la base principal del sur (parque de vehículos, helipuertos y pista dentro): toma la acería A, luego el parque B, la plaza central C y la estación D, y por último la torre de televisión E al norte. Calles estrechas y edificios tapan la vista: vigila esquinas y huecos. Los árboles caen al embestirlos; los proyectiles derrumban edificios.",
    ["faction.atk.desc@sands"] = "Avanza al norte desde la base avanzada y la pista: rompe la berma fronteriza y toma el puesto A, luego el campo petrolífero B, el pueblo C y la base aérea D, y por último el mando E en la cresta. Reaparece en la posición de asalto frente a cada objetivo. Cada muerte cuesta un refuerzo; si se acaban, pierdes.",
    ["faction.atk.desc@snow"] = "Sal de la base principal del sur (parque de vehículos, helipuertos y pista dentro): toma el aserradero A, luego la estación de radar B en la ladera oeste, el pueblo C junto al río, la central D junto al lago helado y por último el paso E al norte. El valle está lleno de crestas y barrancos: combate con el casco oculto tras las crestas; en el hielo no hay cobertura.",
    ["faction.atk.role"] = "ATAQUE  ·  ASALTO ANFIBIO",
    ["faction.atk.role@city"] = "ATAQUE  ·  ENTRA DESDE EL SUR",
    ["faction.atk.role@sands"] = "ATAQUE  ·  ASALTO ACORAZADO",
    ["faction.atk.role@snow"] = "ATAQUE  ·  SUBE POR EL VALLE",
    ["faction.def.desc"] = "Mantén la línea, sector a sector: defiende los objetivos actuales hasta que los atacantes se queden sin refuerzos o sin tiempo. Reaparece en el punto de reunión detrás de un objetivo en disputa.",
    ["faction.def.desc@snow"] = "Defiende el valle punto a punto: aserradero A, estación de radar B, pueblo C, central D y paso E. Combate desde las alturas (la meseta del radar, los hombros del paso); las ruinas del pueblo pueden esconder un tanque.",
    ["faction.def.role"] = "DEFENSA  ·  DEFENSA DE LA ISLA",
    ["faction.def.role@city"] = "DEFENSA  ·  DEFIENDE LA CIUDAD",
    ["faction.def.role@sands"] = "DEFENSA  ·  DEFENSA EN PROFUNDIDAD",
    ["faction.def.role@snow"] = "DEFENSA  ·  DEFIENDE EL PASO",
    ["faction.full"] = "EQUIPO LLENO",
    ["faction.join"] = "UNIRSE",
