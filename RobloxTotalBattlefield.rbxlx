    ["fort.bunker"] = "Пулемётный дот",
    ["fort.coastal"] = "Береговое орудие",
    ["fort.howitzer"] = "Гаубица M777",
    ["fort.mine"] = "Мина",
    ["fort.strike"] = "Артиллерия",
    ["fw.flak35"] = "Спаренная 35-мм зенитка",
    ["fw.hmg"] = "Пулемёт 12,7 мм",
    ["fw.how155"] = "Гаубица 155 мм",
    ["fw.naval127"] = "Орудие 127 мм",
    ["game.title"] = "Штурм острова",
    ["gar.back"] = "НАЗАД",
    ["gar.cells"] = "ДЗ: {1} плиток",
    ["gar.d.arat"] = "ARAT-1 из американского TUSK: плитки ДЗ M19 по 65 фунтов (около 29,5 кг, армия США, 2020), против РПГ; слабо действует на тандемные ракеты, на БОПС — никак.",
    ["gar.d.arat2"] = "TUSK II: второй слой ARAT-2 (M32, изогнутые как черепица) поверх M19 против тандемных боеголовок — ракеты до 50%, РПГ до 25%. Ставится и поверх штатных M19. Масса M32 не опубликована; принято ~22 кг на плитку (оценка).",
    ["gar.d.belly"] = "Сплошной лист днища: противотанковые мины и заряды под корпусом наносят половину урона (оценка). Около 1,3 т (оценка).",
    ["gar.d.ep"] = "Нажимайте на ячейки корпуса, чтобы ставить или снимать ДЗ: ничего на крыше, ничего поверх прицелов, перископов, фар, дымовых гранатомётов и люков, ничего там, где проходит башня или опущенная пушка. Штатные плитки не снимаются.",
    ["gar.d.era"] = "Ракета или ПТУР, попав в блок, подрывает его, и бо́льшая часть урона останавливается; тяжёлая ДЗ ослабляет и кинетические снаряды. Сработавшие блоки исчезают.",
    ["gar.d.eraZones"] = "Выберите, где ставить ДЗ (карточки слева или круги на танке): лоб башни, борта башни, верхний лобовой лист, бортовые экраны. Ракета, попавшая в защищённый участок, подрывает блок и теряет бо́льшую часть урона; открытые места получают полный удар. Каждый пустой участок делает танк чуть легче и быстрее.",
    ["gar.d.fy2"] = "ДЗ 2-го поколения: очень эффективна против моноблочных кумулятивных (РПГ) — попадание в плитку даёт 30% урона; тандемные ракеты пробивают её лидирующим зарядом; против БОПС бесполезна. Около 22 кг на плитку (оценка).",
    ["gar.d.fy4"] = "Тяжёлая ДЗ (класса «Контакт-5»: толстые плиты отклоняют и ломают длинные сердечники): кумулятивные — до ~22%, тандемные ракеты — ~60%, БОПС теряют ~20% (официально для «Контакт-5»: ~20% бронепробития). Около 45 кг на плитку (оценка).",
    ["gar.d.gau8"] = "30-мм «Гатлинг» с двумя барабанами (2048 патронов) на крыше башни; клавиша 3. Отлично против пехоты, лёгкой брони, укреплений и низколетящих самолётов. Скорость −5%.",
    ["gar.d.gl5"] = "NORINCO GL5: четыре пусковых модуля и четыре РЛС миллиметрового диапазона по углам башни; 360° по азимуту, но только 20° по углу места (от атак сверху не защищает); сопровождает с дальности более 100 м и поражает угрозу примерно в 10 м. По одному заряду на модуль; в игре один восстанавливается каждые 45 с.",
    ["gar.d.hk"] = "Пусковые на бортах башни уничтожают летящие ракеты примерно в 10 м от машины. 4 заряда, один восстанавливается каждые 30 с; не останавливает танковые снаряды и крутые атаки сверху. Скорость −3%.",
    ["gar.d.jd3"] = "JD-3 на 99A: лазерное предупреждение + лазерное противодействие (подавление целеуказателя) + автодым. Открытых данных мало; в игре предупреждает, ставит дым и примерно с вероятностью 45% сразу срывает захват ракеты (оценка). Около 120 кг (оценка).",
    ["gar.d.lws"] = "Приёмники лазерного облучения: сразу предупреждают и дают направление, как только на вас наводят ракету или бомбу с лазерным наведением, и автоматически отстреливают дымовой залп — дым скрывает пятно лазера и ракета теряет цель. Около 60 кг (оценка).",
    ["gar.d.mcs"] = "Многоспектральная маскировка (класса Saab Barracuda MCS): закрывает видимый, ближний ИК, тепловой и радиолокационный диапазоны; боты и техника врага замечают вас на 70% обычной дальности (оценка). Только борта и корма — не крыша и не оптика. Около 300 кг (оценка).",
    ["gar.d.none"] = "Без КАЗ: легче и чуть быстрее.",
    ["gar.d.plow"] = "Минный трал Pearson на всю ширину: 3600 кг, проделывает проход шириной 4,2 м и глубиной 175–300 мм на 1–15 км/ч, подъём 11 с. Нажмите J на ходу, чтобы опустить или поднять: мины на проходе впереди отваливаются в стороны без подрыва.",
    ["gar.d.shtora"] = "«Штора-1» на T-90A: по ИК-прожектору ОТШУ-1-7 с каждой стороны пушки (та самая пара красных фар) плюс датчики лазерного облучения. Облучение лазером запускает автодым; ПТУР с командным наведением (TOW, HOT, «Атака»…) примерно в половине случаев уводятся с ~850 м.",
    ["gar.d.slat"] = "Плоские стальные полосы примерно в полуметре от кормы, задних бортов (моторный отсек) и ниши башни: примерно у половины попавших моноблочных РПГ сминается взрыватель и они не срабатывают (Википедия: около 50%); против ракет и снарядов бесполезны. Около 650 кг (оценка).",
    ["gar.d.stock"] = "Штатный зенитный пулемёт танка.",
    ["gar.d.trophy"] = "Rafael Trophy (ставился на M1A2 SEPv2 армии США и M1A1 морской пехоты): две поворотные пусковые, четыре панели РЛС EL/M-2133 для обзора 360°, не менее 1,5 с между выстрелами одной пусковой. Добавляет около 5000 фунтов (2,3 т); испытания в США выявили разбалансировку башни и медленный поворот (здесь −10%). Число зарядов на пусковую не раскрыто; принято 4.",
