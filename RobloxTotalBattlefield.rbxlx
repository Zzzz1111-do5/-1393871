    ["pve.allClear"] = "Toutes les missions réussies",
    ["pve.b1"] = "Une section ennemie renforcée tient le poste frontière, sans blindés. Franchissez le talus et le fossé antichar et prenez l'objectif A.",
    ["pve.b10"] = "Infanterie d'élite ennemie sans véhicules ; terrain découvert et nombreux tireurs d'élite. Prenez les trois premiers objectifs de la mer de sable.",
    ["pve.b11"] = "Une ligne de défense frontalière avec M1A2, Bradley et engins de déminage M1150. Les T-90M et BMP-3 couvrent l'infanterie sur trois objectifs.",
    ["pve.b12"] = "Exploitez la percée : chars et VCI ennemis contre-attaquent ensemble. Prenez les objectifs de quatre étapes d'affilée.",
    ["pve.b13"] = "Bataille de chars de nuit dans la mer de sable : cinq M1A2/M1A1 contre nos quatre T-90M, Type 99A et Type 96. Utilisez la thermique et tirez les premiers. Prenez les objectifs de quatre étapes.",
    ["pve.b14"] = "Assaut général : 30 ennemis et 4 blindés résistent. Prenez les cinq objectifs.",
    ["pve.b15"] = "La dernière réserve blindée ennemie : M1A2, M1A1 et Bradley. Percez les cinq étapes de la mer de sable.",
    ["pve.b16"] = "Tout ce qui reste à l'ennemi : 36 soldats et 5 blindés. Percez les cinq étapes de la mer de sable et prenez le poste de commandement de la crête.",
    ["pve.b2"] = "Deux sections ennemies avec des nids de mitrailleuses tiennent le poste frontière et le champ pétrolier. Prenez les deux objectifs.",
    ["pve.b3"] = "Une compagnie mécanisée avec Bradley, Stryker et JLTV tient la ligne jusqu'à la ville. Prenez trois objectifs à la faveur de la nuit ; emportez des armes antichars.",
    ["pve.b4"] = "Combat de rencontre dans la mer de sable, quelques chars et VCI de chaque côté. Percez le talus frontalier et prenez le champ pétrolier : deux objectifs.",
    ["pve.b5"] = "Des chars M1A1 et des Bradley défendent en profondeur. Prenez quatre objectifs d'affilée et ouvrez une brèche.",
    ["pve.b6"] = "Duel de chars : une compagnie de M1A1/M1A2 contre nos T-90M et Type 99A. Prenez trois objectifs d'affilée dans la mer de sable.",
    ["pve.b7"] = "Le gros des forces ennemies se replie sur la crête, cinq objectifs en défense étagée. Percez les cinq étapes.",
    ["pve.b8"] = "Groupement ennemi lourd de M1A2, M1A1 et Bradley ; nos T-90M, Type 99A et BMP-3 attaquent ensemble. Percez les cinq étapes de la mer de sable.",
    ["pve.b9"] = "Front de la mer de sable : une compagnie motorisée avec Bradley, Stryker et quelques M1A1. Notre bataillon de BMP-3 perce deux lignes de talus.",
    ["pve.botTeam"] = "PvE : tous les joueurs sont dans le camp attaquant",
