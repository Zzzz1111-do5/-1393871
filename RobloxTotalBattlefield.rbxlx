---------------------------------------------------------------- 翻译

function Lang.pick(localeId)
  if type(localeId) == "string" and string.sub(string.lower(localeId), 1, 2) == "zh" then return "zh" end
  return "en"
end

local function tr(lang, key)
  local T = (lang == "zh") and ZH or EN
  return T[key] or ZH[key] or EN[key] or tostring(key)
end

function Lang.t(lang, key, ...)
  local s = tr(lang, key)
  local args = table.pack(...)
  if args.n == 0 then return s end
  return (string.gsub(s, "{(%d)}", function(i)
    local v = args[tonumber(i)]
    if type(v) == "table" and v.k then return tr(lang, v.k) end
    return tostring(v)
  end))
end

-- 军衔名（第几级）
function Lang.rank(lang, i) return tr(lang, "rank." .. i) end

return Lang
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="8">
      <Properties>
        <string name="Name">Map</string>
        <ProtectedString name="Source"><![CDATA[-- 全面大战场地图（ReplicatedStorage.Map）：纯数学，服务器、客户端算出来一样（地形、小地图、出生点、据点都用它）
--   坐标：X 东西（东为正），Z 南北（北是 −Z），海平面 Y = 0；地形范围 ±4096 格，再往外是一块平面当远海
--   主岛「棕榈岛」照网页版《暗剑》js/isle.js 的虚构热带岛：南岸宽而平缓（四处海滩）、东西两个岬角、西南向南开口的 U 形港湾（湾底港口镇）、
--   中央山脊（偏东一个山口）、西北主峰、东部沿海平原上的机场；网页版只有岛的南半边，这里补出北岸，改成四面环海的完整岛，尺寸按 0.5 缩
--   另有前哨岛（据点 A）、灯塔岛（据点 B）、西礁岛（岸防炮台，没有据点）、攻方机场岛；攻方舰队在南边 Z 2000～2400
local Map = {}
local exp, abs, sin, cos, sqrt, max, min, floor = math.exp, math.abs, math.sin, math.cos, math.sqrt, math.max, math.min, math.floor
local noise = math.noise

local function clamp(v, a, b) return v < a and a or (v > b and b or v) end
local function smooth(a, b, v) local t = clamp((v - a) / (b - a), 0, 1) return t * t * (3 - 2 * t) end
local function lerp(a, b, t) return a + (b - a) * t end
Map.clamp, Map.smooth, Map.lerp = clamp, smooth, lerp

Map.R = 4096           -- 地形范围 ±R
Map.SEA_DEPTH = 12     -- 远海水深（格）
Map.MAXH = 290         -- 高度系数 1 对应多少格（主峰约 250）
Map.RES = 4            -- 地形体素边长

---------------------------------------------------------------- 主岛

local MI = { x = 0, z = -1500, hs = 1500, S = 800, N = 760 }   -- 中心、东西半宽、南岸 / 北岸离中线最远多少
Map.MAIN = MI
local PH = { 0.7, 2.1, 4.0, 1.3, 5.2, 3.3, 0.4, 2.8, 4.6, 1.9, 3.7, 5.9 }   -- 起伏的相位（网页版按种子随机，这里定死：每局一样）
local BAY = { x = -495, w = 120, d = 320 }   -- 港湾：中心、半宽、伸进岛里多深
local CAPES = { { x = -1110, ext = 150, w = 105 }, { x = 1200, ext = 130, w = 95 } }   -- 南岸东西两个岬角：伸出多远、半宽
Map.BAY = BAY

local function southRaw(x)
  local u = (x - MI.x) / MI.hs
  if abs(u) >= 1 then return nil end
  local f = (1 - abs(u) ^ 3.5) ^ 0.45   -- 南岸正面宽而平缓（能登陆的岸段长），东西两头陡收
  local c = MI.S * f + f * (35 * sin(x / 155 + PH[1]) + 14 * sin(x / 48 + PH[2]) + 6 * sin(x / 21 + PH[3]))
  for _, k in ipairs(CAPES) do c += k.ext * f * exp(-((x - k.x) / k.w) ^ 2) end
  local q = (x - BAY.x) / BAY.w
  c -= BAY.d * exp(-((q * q) ^ 1.6))   -- U 形湾：湾底平、湾口不收窄
  return MI.z + c
end
local function northRaw(x)
  local u = (x - MI.x) / MI.hs
  if abs(u) >= 1 then return nil end
  local g = (1 - abs(u) ^ 3) ^ 0.5
  local c = MI.N * g + g * (30 * sin(x / 140 + PH[4]) + 16 * sin(x / 53 + PH[5]) + 7 * sin(x / 19 + PH[6]))
  return MI.z - c
end

-- 岸线先算好存表（每 2 格一个），查的时候线性插值
local CX0, CSTEP = -MI.hs, 2
local CN = floor(2 * MI.hs / CSTEP)
local cS, cN = table.create(CN + 1), table.create(CN + 1)
for i = 0, CN do
  local x = CX0 + i * CSTEP
  cS[i + 1] = southRaw(x) or MI.z
  cN[i + 1] = northRaw(x) or MI.z
end
local function coastLookup(t, x)
  local f = (x - CX0) / CSTEP
  if f <= 0 or f >= CN then return nil end
  local i = floor(f)
  local a = f - i
  return t[i + 1] * (1 - a) + t[i + 2] * a
end
function Map.coastS(x) return coastLookup(cS, x) end   -- 主岛南岸线在 x 处的 z（岛外返回 nil）
function Map.coastN(x) return coastLookup(cN, x) end   -- 北岸线

---------------------------------------------------------------- 海滩、据点、营地

-- 南岸四处海滩（避开港湾、岬角）；东北岸一处侧翼海滩
Map.BEACHES = {
  { id = "red", x0 = -980, x1 = -820, color = Color3.fromRGB(215, 70, 60) },
  { id = "white", x0 = -200, x1 = -40, color = Color3.fromRGB(235, 235, 235) },
  { id = "blue", x0 = 250, x1 = 410, color = Color3.fromRGB(70, 130, 230) },
  { id = "gold", x0 = 690, x1 = 850, color = Color3.fromRGB(235, 190, 60) },
  { id = "flank", x0 = 820, x1 = 960, north = true, color = Color3.fromRGB(150, 110, 220) },
}
for _, b in ipairs(Map.BEACHES) do
  b.cx = (b.x0 + b.x1) / 2
  b.z = (b.north and Map.coastN or Map.coastS)(b.cx)
  b.dir = b.north and -1 or 1   -- 朝海的方向（Z）：南岸的海在南（+Z），北岸的海在北
end
local function beachAt(x, north)
  for _, b in ipairs(Map.BEACHES) do
    if (b.north == true) == (north == true) and x >= b.x0 - 25 and x <= b.x1 + 25 then return b end
  end
  return nil
end
Map.beachAt = beachAt

local function ridgeZ(x) return MI.z - 230 + 65 * sin(x / 260 + PH[7]) + 30 * sin(x / 85 + PH[8]) end
Map.ridgeZ = ridgeZ
local HILLS = {
  { x = -420, z = MI.z - 450, r = 300, h = 0.95 },   -- 西北主峰
  { x = -760, z = MI.z - 90, r = 250, h = 0.5 },
  { x = 470, z = MI.z - 200, r = 270, h = 0.5 },
  { x = 1060, z = MI.z - 330, r = 190, h = 0.4 },
}

-- 机场（守方，东部沿海平原，跑道东西向）、指挥所（山脊北面）、后方营地（北岸，不能占）、港口镇（湾底）
local afX = 780
Map.AIRFIELD = { x = afX, z = (Map.coastS(afX) or 0) - 470, len = 560, wid = 44, rot = 0 }
local AFP = { x = afX, z = Map.AIRFIELD.z - 40 }   -- 机场一带是一片低平的沿海平原（mainNatural 里压低）
Map.COMMAND = { x = 260, z = ridgeZ(260) - 230 }
Map.CAMP = { x = 140, z = (Map.coastN(140) or 0) + 120 }
Map.PORT = { x = BAY.x, z = (Map.coastS(BAY.x) or 0) - 70 }

---------------------------------------------------------------- 小岛

local ISLES = {
  { id = "outpost", x = 150, z = 500, a = 230, b = 170, h = 34, ph = 1.1 },   -- 前哨岛：离攻方舰队最近
  { id = "lighthouse", x = 2500, z = -300, a = 300, b = 230, h = 62, ph = 2.7 },   -- 灯塔岛（东）
  { id = "westreef", x = -2500, z = -200, a = 270, b = 220, h = 46, ph = 4.2 },   -- 西礁岛：岸防炮台
  { id = "afield", x = 0, z = 3200, a = 620, b = 230, h = 6, ph = 0.3, flat = true },   -- 攻方机场岛：平的
}
Map.ISLES = ISLES
for _, I in ipairs(ISLES) do Map[string.upper(I.id)] = I end

local function isleRad(I, th)   -- 椭圆半径按方位起伏
  local c, s = cos(th), sin(th)
  local r = I.a * I.b / sqrt((I.b * c) ^ 2 + (I.a * s) ^ 2)
  return r * (1 + 0.07 * sin(3 * th + I.ph) + 0.04 * sin(5 * th + 2 * I.ph) + 0.02 * sin(9 * th + 3 * I.ph))
end
Map.isleRad = isleRad
-- 离这个小岛的岸多远（正 = 岛上，负 = 海里）
local function isleD(I, x, z)
  local dx, dz = x - I.x, z - I.z
  local rho = sqrt(dx * dx + dz * dz)
  if rho > I.a * 1.3 + 400 then return -1e9, 1, rho end
  local R = isleRad(I, math.atan2(dz, dx))
  return R - rho, R, rho
end

-- 5 个据点：A 前哨岛、B 灯塔岛、C 港口镇、D 机场、E 指挥所（开局都归守方）
Map.POINTS = {
  { id = "A", x = 150, z = 500, isle = "outpost" },
  { id = "B", x = 2480, z = -320, isle = "lighthouse" },
  { id = "C", x = Map.PORT.x, z = Map.PORT.z },
  { id = "D", x = Map.AIRFIELD.x, z = Map.AIRFIELD.z - 80 },   -- 机场北面的停机坪、塔台一带
  { id = "E", x = Map.COMMAND.x, z = Map.COMMAND.z },
}
Map.POINT_R = 70   -- 据点半径

-- 登陆点：主岛的 5 处海滩 + 前哨岛、灯塔岛的南岸（登陆艇从南边冲上去）；攻方选「抢滩」出生、机器人坐艇都按它
Map.LANDINGS = {}
for _, b in ipairs(Map.BEACHES) do table.insert(Map.LANDINGS, b) end
for _, id in ipairs({ "outpost", "lighthouse" }) do
  local I = Map[string.upper(id)]
  table.insert(Map.LANDINGS, { id = id, cx = I.x, z = I.z + isleRad(I, math.pi / 2), dir = 1, isle = id, color = Color3.fromRGB(240, 240, 200) })
end
-- 港湾里：从湾口一直冲到湾底的港口码头
table.insert(Map.LANDINGS, { id = "port", cx = BAY.x, z = Map.coastS(BAY.x), dir = 1, color = Color3.fromRGB(200, 200, 210) })
function Map.landingOf(id)
  for _, b in ipairs(Map.LANDINGS) do if b.id == id then return b end end
  return nil
end
-- 这一点在哪块陆地上：小岛编号，或者 "main"（主岛；海里也算主岛）
function Map.landOf(x, z)
  for _, I in ipairs(ISLES) do
    if (isleD(I, x, z)) > -80 then return I.id end
  end
  return "main"
end
for _, p in ipairs(Map.POINTS) do p.land = p.isle or "main" end

-- 攻方舰队（固定平台，打不掉）、机场岛跑道
Map.FLEET = {
  { kind = "carrier", x = -420, z = 2250, rot = 0 },   -- 航母（福建舰）
  { kind = "lhd", x = 330, z = 2150, rot = 0 },   -- 两栖攻击舰（075）
  { kind = "lst", x = -1000, z = 2050, rot = 0 },   -- 登陆舰（072A）
  { kind = "lst", x = 950, z = 2050, rot = 0 },
}
Map.AFIELD2 = { x = 0, z = 3200, len = 900, wid = 50, rot = 0 }
-- 登陆平台：舰队前面一块浮在海上的大平台（攻方地面载具的生成点在两侧水面：车站在气垫艇上，自己开去哪个海滩都行，冲上岸艇自己回去）
Map.BARGE = { x = -40, z = 1800, W = 120, L = 360, top = 3.5 }

---------------------------------------------------------------- 压平的场地

-- 据点、机场、营地、港口：在自然高度上压平一块（圆：r 以内完全压平，r2 以外不变；矩形：hx × hz 以内压平，往外 m 格过渡）；只压陆地，不把海抬起来
local FLAT = {}
local function addFlat(x, z, r, r2, y) table.insert(FLAT, { x = x, z = z, r = r, r2 = r2, y = y }) end
local function addRect(x, z, hx, hz, m, y) table.insert(FLAT, { x = x, z = z, hx = hx, hz = hz, m = m, y = y, rect = true }) end
Map.FLAT = FLAT

---------------------------------------------------------------- 高度

local function mainNatural(x, z)
  local zs, zn = Map.coastS(x), Map.coastN(x)
  if not zs then return nil, -1e9 end
  local dS, dN = zs - z, z - zn
  local d = min(dS, dN)   -- 离岸（南北方向量；岛东西两头偏小一点，没关系）
  if d <= 0 then return nil, d, dS, dN end
  local u = (x - MI.x) / MI.hs
  local e = 0.06 + min(0.18, d / 1500)
  e += 0.3 * exp(-((z - ridgeZ(x)) ^ 2) / 22500) * smooth(0, 0.5, 1 - abs(u)) * (1 - 0.75 * exp(-((x - 180) / 110) ^ 2))   -- 中央山脊，偏东一个山口
  for _, h in ipairs(HILLS) do e += h.h * exp(-((x - h.x) ^ 2 + (z - h.z) ^ 2) / (2 * h.r * h.r)) end
  local bS = beachAt(x, false)
  local headland = not bS and not (abs(x - BAY.x) < BAY.w + 60) and (abs(x - CAPES[1].x) < CAPES[1].w * 1.2 or abs(x - CAPES[2].x) < CAPES[2].w * 1.2)
  if headland then e += 0.14 * exp(-((dS - 35) ^ 2) / 2250) end   -- 岬角：岸边陡起的崖顶
  e += noise(x / 300, z / 300, 1.37) * 0.16 + noise(x / 110, z / 110, 7.1) * 0.06   -- 起伏
  e *= lerp(0.4, 1, smooth(20, 325, d))   -- 沿海平原
  do   -- 东部沿海平原（机场）：一大片低平地（往一个平的高度抹），往外慢慢抬起来
    local qx, qz = max(0, abs(x - AFP.x) - 330), max(0, abs(z - AFP.z) - 160)
    e = lerp(0.075, e, smooth(40, 520, sqrt(qx * qx + qz * qz)))
  end
  if bS and dS < 160 then e *= lerp(0.35, 1, smooth(15, 120, dS)) end   -- 海滩后方平缓
  local bN = beachAt(x, true)
  if bN and dN < 160 then e *= lerp(0.35, 1, smooth(15, 120, dN)) end
  e = clamp(1 - exp(-1.35 * max(0, e)), 0, 1)   -- 软压缩：高处越来越缓，不会削成平顶台地
  local y = e * Map.MAXH
  local edge = ((bS and dS < dN) or (bN and dN <= dS)) and 70 or (headland and dS < dN and 18 or 45)
  return y * smooth(0, edge, d) + 0.6, d, dS, dN
end

local function isleNatural(I, x, z)
  local d, R, rho = isleD(I, x, z)
  if d <= 0 then return nil, d end
  local y
  if I.flat then
    y = I.h * smooth(0, 60, d)
  else
    local k = clamp(rho / R, 0, 1)
    y = I.h * (1 - k * k) ^ 0.8 + (noise(x / 90, z / 90, I.ph * 3) * 0.5) * I.h * 0.25 * smooth(0, 80, d)
    y *= smooth(0, 40, d)
  end
  return max(y, 0) + 0.6, d
end

-- 自然高度（压平之前）；海里返回负数（海底）
local function natural(x, z)
  local y, d, dS, dN = mainNatural(x, z)
  if y then return y, d end
  local off, k = 1e9, 0.16
  if d and d > -1e8 then   -- 主岛南北两岸外：海滩外是缓坡浅滩
    off = -d
    local b = (dS and dN and dS < dN) and beachAt(x, false) or beachAt(x, true)
    if b and ((b.north and dN and dN < 0) or (not b.north and dS and dS < 0)) then k = 0.06 end
  end
  for _, I in ipairs(ISLES) do
    local yi, di = isleNatural(I, x, z)
    if yi then return yi, di end
    if -di < off then off, k = -di, 0.12 end
  end
  -- 岸线外头几格从陆地边上的 +0.6 平滑降到 −1.2（原来在岸线上直接断开 1.8 格：车开到水线就是一道坎）；海滩的缓些
  local lip = 1.8 * smooth(0, (k < 0.1) and 10 or 6, off)
  return -min(Map.SEA_DEPTH, lip - 0.6 + off * k), -off
end

function Map.height(x, z)
  local y, d = natural(x, z)
  if y <= 0.3 then return y, d end
  for _, F in ipairs(FLAT) do
    local dx, dz = x - F.x, z - F.z
    local w = 0
    if F.rect then
      local qx, qz = max(0, abs(dx) - F.hx), max(0, abs(dz) - F.hz)
      if qx < F.m and qz < F.m then w = 1 - smooth(0, F.m, sqrt(qx * qx + qz * qz)) end
    else
      local q = dx * dx + dz * dz
      if q < F.r2 * F.r2 then w = 1 - smooth(F.r, F.r2, sqrt(q)) end
    end
    if w > 0 then y = lerp(y, max(F.y, 0.8), w * smooth(0, 25, d)) end   -- 岸边那一点不压（不改岸线）
  end
  return y, d
end
-- 地面（站人、放车）：海上是海面
function Map.ground(x, z)
  local y = Map.height(x, z)
  return max(y, 0)
end
function Map.isLand(x, z) return (Map.height(x, z)) > 0.3 end
function Map.slope(x, z)
  local e = 4
  local a, b = Map.height(x + e, z), Map.height(x - e, z)
  local c, d = Map.height(x, z + e), Map.height(x, z - e)
  return sqrt(((a - b) / (2 * e)) ^ 2 + ((c - d) / (2 * e)) ^ 2)
end

-- 压平的场地：高度取这一圈自然高度的平均（一半挖一半填，四周不会是一圈陡壁；不低于 3 格）
local function avgNatural(x, z, r)
  local sum, n = natural(x, z), 1
  for k = 0, 11 do
    local a = k * math.pi / 6
    for _, rr in ipairs({ r * 0.5, r }) do
      local y = natural(x + cos(a) * rr, z + sin(a) * rr)
      if y > 0 then sum += y; n += 1 end
    end
  end
  return sum / n
end
local function flatHere(x, z, r, r2, yMin)
  addFlat(x, z, r, r2, max(yMin or 3, avgNatural(x, z, r)))
end
for _, p in ipairs(Map.POINTS) do flatHere(p.x, p.z, 55, 110) end
do local A = Map.AIRFIELD addRect(A.x, A.z - 40, A.len / 2 + 50, 120, 170, max(4, avgNatural(A.x, A.z - 40, 200))) end   -- 跑道 + 北面停机坪
do local C = Map.CAMP addRect(C.x, C.z + 15, 200, 85, 120, max(3, avgNatural(C.x, C.z, 70))) end   -- 营地：帐篷、营房，南面一排车场、北面直升机停机坪（Depots.lua）
flatHere(Map.PORT.x, Map.PORT.z, 80, 190)
addRect(Map.AFIELD2.x, Map.AFIELD2.z, Map.AFIELD2.len / 2 + 20, 70, 60, 6)
for _, p in ipairs(Map.POINTS) do p.y = Map.ground(p.x, p.z) end
for _, k in ipairs({ "AIRFIELD", "COMMAND", "CAMP", "PORT", "AFIELD2" }) do Map[k].y = Map.ground(Map[k].x, Map[k].z) end

---------------------------------------------------------------- 材质

function Map.material(x, z, y, slope)
  if y <= 0.4 then
    return (y > -3.5) and Enum.Material.Sand or Enum.Material.Sand
  end
  local zs, zn = Map.coastS(x), Map.coastN(x)
  local nearBeach = y < 8 and zs and ((beachAt(x, false) and zs - z > -10 and zs - z < 90) or (beachAt(x, true) and z - zn > -10 and z - zn < 90))
  if nearBeach or y < 2.2 then return Enum.Material.Sand end
  if slope > 1.15 then return (y > 120) and Enum.Material.Slate or Enum.Material.Rock end
  if y > 232 then return Enum.Material.Rock end
  if slope > 0.75 then return Enum.Material.Ground end
  local n = noise(x / 85, z / 85, 11.3)
  if y < 9 and n > 0.15 then return Enum.Material.Ground end
  return (n > -0.1) and Enum.Material.LeafyGrass or Enum.Material.Grass
end

---------------------------------------------------------------- 有陆地的范围（开服生成地形只写这些块）

-- 返回 { x0, z0, x1, z1 } 若干个：主岛、各小岛，外扩一圈浅滩
function Map.landBoxes()
  local pad = 120
  local boxes = { { MI.x - MI.hs - pad, MI.z - MI.N - 140 - pad, MI.x + MI.hs + pad, MI.z + MI.S + 200 + pad } }
  for _, I in ipairs(ISLES) do
    local r = max(I.a, I.b) * 1.15 + pad
    table.insert(boxes, { I.x - r, I.z - r, I.x + r, I.z + r })
  end
  return boxes
end

-- 两点之间的直线有没有被地形挡住（AI 视线用；每 step 格取一点）
function Map.lineClear(a, b, step)
  step = step or 12
  local d = b - a
  local L = d.Magnitude
  local n = max(1, floor(L / step))
  for i = 1, n - 1 do
    local p = a + d * (i / n)
    if Map.height(p.X, p.Z) > p.Y then return false end
  end
  return true
end

return Map
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="9">
      <Properties>
        <string name="Name">ShipDefs</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——舰艇的型号数据（服务器、客户端共用）：尺寸、速度、转向、血量、武器（主炮、副炮 / 机枪、反舰 / 对陆导弹、防空导弹、近防炮）、样子
--   尺寸按真船的 0.6 倍（1 米 = 1.68 格；地图上固定的航母、两栖攻击舰平台也是缩过的，舰艇照真比例会比岛还大）
--   坐标：原点在船的正中、水线上（Y = 0 是水面），X 右、Y 上、−Z 朝船头；服务器的命中盒是 W × H × L 的方块，底在水线下 draft 格
--   炮：pos 炮塔转轴、trav 每秒转几度、arc 能转到正前方 / 正后方左右各几度（aft 为真：正后方的炮）、elev 俯仰、len 炮管长
local ShipDefs = {}
local V = Vector3.new

-- 武器：kind shell 炮弹（有弹道）、gun 机枪（射线）、missile 反舰 / 对陆导弹（玩家锁定发射）；sam 防空导弹、ciws 近防炮（都自动）
ShipDefs.W = {
  g130 = { kind = "shell", dmg = 620, speed = 1000, gscale = 0.45, splash = 17, rate = 2.2, range = 4200,
    vs = { inf = 1, light = 1.4, armor = 0.9, air = 0.3, ship = 1.3, fort = 1.2 }, fx = "tank" },
  g127 = { kind = "shell", dmg = 580, speed = 950, gscale = 0.45, splash = 16, rate = 2.4, range = 4000,
    vs = { inf = 1, light = 1.4, armor = 0.9, air = 0.3, ship = 1.3, fort = 1.2 }, fx = "tank" },
  g76 = { kind = "shell", dmg = 280, speed = 1000, gscale = 0.45, splash = 11, rate = 0.9, range = 3500,
    vs = { inf = 1, light = 1.3, armor = 0.6, air = 0.6, ship = 1.2, fort = 1 }, fx = "tank" },
  g57 = { kind = "shell", dmg = 170, speed = 1050, gscale = 0.45, splash = 9, rate = 0.45, range = 3200,
    vs = { inf = 1, light = 1.2, armor = 0.45, air = 0.8, ship = 1.1, fort = 0.8 }, fx = "ac" },
  g30 = { kind = "gun", dmg = 36, rate = 0.07, range = 1900, spread = 0.35,   -- 30 毫米加特林：射速高，按射线算（每发一个飞行中的弹太费）
    vs = { inf = 1, light = 0.9, armor = 0.15, air = 2, ship = 0.4, fort = 0.35 }, fx = "ac" },
  m2x2 = { kind = "gun", dmg = 40, rate = 0.07, range = 1000, spread = 0.6,
    vs = { inf = 1, light = 0.5, armor = 0.04, air = 0.4, ship = 0.12, fort = 0.1 }, fx = "lmg" },
  asm = { kind = "missile", dmg = 1500, splash = 20, speed = 320, range = 5400, turn = 40, cruise = 22,
    vs = { inf = 1, light = 2, armor = 1.4, air = 0, ship = 1.5, fort = 1.5 } },
  sam = { kind = "sam", dmg = 260, splash = 14, speed = 520, range = 3400, rate = 4,
    vs = { inf = 0, light = 0, armor = 0, air = 4, ship = 0, fort = 0 } },
  ciws = { kind = "ciws", range = 950, dmg = 26, rate = 0.1, kill = 0.55,   -- kill：一座近防炮拦一发来袭导弹 / 炸弹能打掉的概率（两座都拦，漏过来约两成）
    vs = { inf = 0.5, light = 0.3, armor = 0, air = 2, ship = 0, fort = 0 } },
}
for id, w in pairs(ShipDefs.W) do w.id = id end

local GREY_PLA, GREY_USN, DARK = Color3.fromRGB(128, 134, 138), Color3.fromRGB(108, 116, 122), Color3.fromRGB(52, 56, 60)

local D = {}
ShipDefs.D = D

-- look：客户端拼样子用（ShipView.lua）——sup 上层建筑 { 前 z, 后 z, 宽, 高, 底在多高 }（第一块是主上层建筑、第二块是舰桥）、mast 桅杆底（mastH 高、mastW 宽）、
--   funnel 烟囱 { 位置, 尺寸, … }、panel 相控阵雷达（桅杆四面）、vls 垂发 { 前 z, 后 z }、heli 直升机甲板 { 前 z, 后 z }、canisters 斜置的导弹发射箱、
--   num 舷号、hulls 双体 / 三体、open 小艇（没有上层建筑）、stealth 隐身外形（上层建筑、炮塔斜面）
D.t055 = { cat = "ship", L = 302, W = 34, H = 52, draft = 9, deck = 11, speed = 40, accel = 3.5, turn = 5, hp = 4800,
  guns = { { w = "g130", pos = V(0, 12, -104), trav = 40, arc = 150, elev = { -5, 60 }, len = 14, size = V(9, 6, 13), stealth = true } },
  missiles = { w = "asm", n = 8, pos = V(0, 12, -82), name = "yj18" }, sam = { n = 16, pos = V(0, 12, 33) },
  ciws = { V(0, 38.5, -58), V(0, 24.5, 70) },
  look = { color = GREY_PLA, sup = { { -70, 20, 24, 16, 11 }, { -64, -14, 20, 10, 27 }, { 46, 84, 22, 12, 11 } }, mast = V(0, 37, -40), mastH = 16, mastW = 14,
    funnel = { V(0, 30, 2), V(12, 9, 14) }, panel = true, vls = { { -92, -72 }, { 24, 42 } }, heli = { 100, 148 }, num = "101", stealth = true } }
D.t054a = { cat = "ship", L = 225, W = 27, H = 42, draft = 7, deck = 9, speed = 40, accel = 4, turn = 6, hp = 3000,
  guns = { { w = "g76", pos = V(0, 9, -78), trav = 55, arc = 150, elev = { -10, 80 }, len = 7, size = V(6, 4, 8), stealth = true } },
  missiles = { w = "asm", n = 8, pos = V(0, 23, -8), name = "yj83" }, sam = { n = 8, pos = V(0, 10, -62) },
  ciws = { V(-6, 24, 22), V(6, 24, 22) },
  look = { color = GREY_PLA, sup = { { -52, 30, 18, 13, 9 }, { -48, -16, 15, 8, 22 }, { 34, 66, 16, 10, 9 } }, mast = V(0, 30, -32), mastH = 13, mastW = 9,
    funnel = { V(0, 25, 6), V(10, 8, 14) }, vls = { { -68, -56 } }, heli = { 70, 108 }, num = "532", canisters = { z = -8, y = 22, n = 4 }, stealth = true } }
D.t022 = { cat = "ship", L = 72, W = 20, H = 16, draft = 3, deck = 4, speed = 58, accel = 10, turn = 14, hp = 1200,
  guns = { { w = "g30", pos = V(0, 10, -15), trav = 120, arc = 160, elev = { -10, 85 }, len = 3, size = V(3, 2.2, 3), gatling = true } },
  missiles = { w = "asm", n = 8, pos = V(0, 7, 24), name = "yj83" },
  look = { color = Color3.fromRGB(96, 118, 116), hulls = 2, sup = { { -20, 12, 14, 6, 4 } }, mast = V(0, 10, -6), mastH = 6, mastW = 4, num = "2208",
    canisters = { z = 26, y = 4, n = 4 }, stealth = true } }
D.ddg125 = { cat = "ship", L = 260, W = 34, H = 50, draft = 9, deck = 10, speed = 40, accel = 3.5, turn = 5, hp = 4200,
  guns = { { w = "g127", pos = V(0, 11, -96), trav = 30, arc = 150, elev = { -5, 65 }, len = 13, size = V(8, 5, 12), stealth = true } },
  missiles = { w = "asm", n = 8, pos = V(0, 11, -75), name = "tlam" }, sam = { n = 16, pos = V(0, 11, 85) },
  ciws = { V(0, 26.5, -60), V(0, 22.5, 70) },
  look = { color = GREY_USN, sup = { { -62, 30, 24, 15, 10 }, { -58, -18, 20, 9, 25 }, { 40, 76, 20, 11, 10 } }, mast = V(0, 34, -36), mastH = 15, mastW = 6,
    funnel = { V(0, 28, 0), V(11, 8, 16), V(0, 25, 50), V(11, 8, 14) }, panel = true, vls = { { -86, -64 }, { 78, 92 } }, heli = { 96, 128 }, num = "125" } }
D.cg47 = { cat = "ship", L = 290, W = 28, H = 54, draft = 9, deck = 10, speed = 38, accel = 3.2, turn = 4.5, hp = 4500,
  guns = { { w = "g127", pos = V(0, 11, -110), trav = 30, arc = 150, elev = { -5, 65 }, len = 13, size = V(8, 5, 12) },
    { w = "g127", pos = V(0, 11, 118), trav = 30, arc = 150, elev = { -5, 65 }, len = 13, size = V(8, 5, 12), aft = true } },
  missiles = { w = "asm", n = 10, pos = V(0, 11, 76), name = "harpoon" }, sam = { n = 20, pos = V(0, 11, 93) },
  ciws = { V(10, 27.5, -20), V(-10, 27.5, 50) },
  look = { color = GREY_USN, sup = { { -70, 70, 22, 16, 10 }, { -66, -20, 18, 12, 26 }, { 16, 64, 18, 10, 26 } }, mast = V(0, 38, -42), mastH = 16, mastW = 6,
    funnel = { V(0, 29.5, -6), V(10, 7, 14), V(0, 39.5, 30), V(10, 7, 12) }, panel = true, vls = { { -98, -82 }, { 84, 102 } }, num = "52",
    canisters = { z = 77, y = 10, n = 4 } } }
D.lcs2 = { cat = "ship", L = 213, W = 53, H = 40, draft = 6, deck = 9, speed = 55, accel = 7, turn = 8, hp = 1800,
  guns = { { w = "g57", pos = V(0, 9, -62), trav = 60, arc = 150, elev = { -10, 77 }, len = 8, size = V(5, 4, 7), stealth = true } },
  missiles = { w = "asm", n = 8, pos = V(0, 10, -52), name = "nsm" }, ciws = { V(0, 24.5, 10) },
  look = { color = Color3.fromRGB(122, 128, 132), hulls = 3, sup = { { -48, 30, 30, 14, 9 }, { -42, -6, 24, 9, 23 } }, mast = V(0, 32, -20), mastH = 10, mastW = 5,
    heli = { 40, 104 }, num = "2", canisters = { z = -52, y = 9, n = 4 }, stealth = true } }
D.pbr = { cat = "ship", L = 16, W = 6, H = 6, draft = 1, deck = 1.6, speed = 50, accel = 12, turn = 28, hp = 750,
  guns = { { w = "m2x2", pos = V(0, 2.4, -5.2), trav = 140, arc = 150, elev = { -15, 50 }, len = 3.2, size = V(1.6, 1.2, 1.4), twin = true } },
  look = { color = Color3.fromRGB(78, 94, 72), open = true, num = "" } }

for id, d in pairs(D) do
  d.id = id
  d.size = V(d.W, d.H, d.L)
end

function ShipDefs.get(id) return D[id] end

-- 炮塔、炮口的世界坐标：cf 是船（水线中心）的 CFrame；ty 方位（度，相对正前方，正数往右；船尾的炮相对正后方）、gp 俯仰
function ShipDefs.turretCF(d, cf, gi, ty)
  local g = d.guns[gi]
  local base = cf * CFrame.new(g.pos)
  if g.aft then base = base * CFrame.Angles(0, math.pi, 0) end
  return base * CFrame.Angles(0, -math.rad(ty or 0), 0)
end
function ShipDefs.gunCF(d, cf, gi, ty, gp)
  local g = d.guns[gi]
  return ShipDefs.turretCF(d, cf, gi, ty) * CFrame.new(0, g.size.Y * 0.35, -g.size.Z * 0.35) * CFrame.Angles(math.rad(gp or 0), 0, 0)
end
function ShipDefs.muzzle(d, cf, gi, ty, gp)
  return ShipDefs.gunCF(d, cf, gi, ty, gp) * CFrame.new(0, 0, -d.guns[gi].len)
end

-- 车钟：几档（−2 全速后退 … 5 全速前进），对应额定航速的几成
ShipDefs.ORDERS = { [-2] = -0.5, [-1] = -0.25, [0] = 0, [1] = 0.2, [2] = 0.4, [3] = 0.6, [4] = 0.8, [5] = 1 }

return ShipDefs
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="10">
      <Properties>
        <string name="Name">VehDefs</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——地面载具的型号数据（服务器、客户端共用）：尺寸、速度、炮塔、武器、车轮 / 负重轮、烟幕弹发射筒、瞄准镜
--   单位：格（1 米约 2.8 格，和 Roblox 的人一样比例）。车的坐标系：原点在车底中心（着地），X 右、Y 上、−Z 朝前
--   服务器的命中盒是 W × H × L 的方块，中心在原点上 H/2；客户端按 arch（tracked 履带 / wheeled 轮式）和各项参数拼零件模型
--   炮塔：pivot 是转轴（相对车底），trav 每秒转几度，elev 俯仰范围（度）；炮：gun.pivot 是耳轴（相对炮塔转轴），len 长、cal 粗
--   烟幕弹：smoke.banks 每组一个发射架（相对炮塔转轴的位置、朝向角 yaw 度——0 朝前、正数往右），n 管，各管在架上扇形张开、仰 35°
local VehDefs = {}
local V = Vector3.new

-- 武器（载具用）：kind shell 有弹道的炮弹（打到就炸）、gun 机枪（直射判定）、arty 曲射（准星下的地面）、
--   rate 两发间隔（秒）、mag 一个弹匣 / 弹舱、reload 换弹、reserve 备弹（不算弹匣里的）；speed 弹速（格 / 秒）、drop 下坠（重力倍数）
VehDefs.W = {
  gun125 = { kind = "shell", dmg = 640, speed = 1500, drop = 0.12, splash = 6, rate = 6.5, mag = 1, reload = 0, reserve = 30, range = 3000,
    vs = { inf = 0.7, light = 1.3, armor = 1, air = 0.8, ship = 0.7, fort = 1.2 }, fx = "tank", cal = 0.42 },
  gun120 = { kind = "shell", dmg = 640, speed = 1550, drop = 0.12, splash = 6, rate = 6.0, mag = 1, reload = 0, reserve = 30, range = 3000,
    vs = { inf = 0.7, light = 1.3, armor = 1, air = 0.8, ship = 0.7, fort = 1.2 }, fx = "tank", cal = 0.42 },
  gun105 = { kind = "shell", dmg = 480, speed = 1400, drop = 0.14, splash = 6, rate = 5.0, mag = 1, reload = 0, reserve = 36, range = 2600,
    vs = { inf = 0.8, light = 1.3, armor = 0.9, air = 0.8, ship = 0.6, fort = 1.1 }, fx = "tank", cal = 0.36 },
  ac30 = { kind = "shell", dmg = 60, speed = 1150, drop = 0.2, splash = 4, rate = 0.19, mag = 50, reload = 4.5, reserve = 400, range = 2000,
    vs = { inf = 1, light = 1, armor = 0.22, air = 1.4, ship = 0.35, fort = 0.6 }, fx = "ac", cal = 0.2 },
  ac35 = { kind = "shell", dmg = 46, speed = 1300, drop = 0.15, splash = 5, rate = 0.07, mag = 120, reload = 5, reserve = 600, range = 2400,
    vs = { inf = 0.8, light = 0.8, armor = 0.1, air = 2.4, ship = 0.25, fort = 0.35 }, fx = "ac", cal = 0.2 },
  vulcan = { kind = "shell", dmg = 26, speed = 1200, drop = 0.2, splash = 2.5, rate = 0.035, mag = 300, reload = 6, reserve = 1200, range = 1600,
    vs = { inf = 1, light = 0.6, armor = 0.05, air = 2.0, ship = 0.15, fort = 0.25 }, fx = "ac", cal = 0.14 },
  coax = { kind = "gun", dmg = 24, rate = 0.08, mag = 200, reload = 5, reserve = 2000, range = 900, spread = 0.45,
    vs = { inf = 1, light = 0.15, armor = 0, air = 0.1, ship = 0, fort = 0.04 }, fx = "lmg" },
  hmg = { kind = "gun", dmg = 40, rate = 0.11, mag = 100, reload = 5, reserve = 900, range = 1200, spread = 0.5,
    vs = { inf = 1, light = 0.5, armor = 0.04, air = 0.4, ship = 0.05, fort = 0.12 }, fx = "lmg" },
  how155 = { kind = "arty", dmg = 340, splash = 26, rate = 7, mag = 1, reload = 0, reserve = 40, minR = 300, maxR = 3600, flight = 6,
    vs = { inf = 1, light = 1, armor = 0.6, air = 0, ship = 0.5, fort = 1.2 } },
  mlrs = { kind = "arty", dmg = 180, splash = 22, rate = 0.45, mag = 12, reload = 25, reserve = 24, minR = 500, maxR = 4000, flight = 7, scatter = 40,
    vs = { inf = 1, light = 1, armor = 0.45, air = 0, ship = 0.4, fort = 1 } },
}
-- 烟幕弹：每次齐射一组，落点约 30 格外，烟团半径 ~20 格、持续 30 秒
VehDefs.SMOKE = { range = 32, r = 20, life = 30, salvos = 2, reload = 12 }
-- 726 气垫艇：攻方不会游的车在登陆平台旁站在艇上生成，开车的人连艇一起开（服务器 Armor、客户端 Drive 共用）：
--   y 艇身中心高、deck 车底的高度、speed 水上最快（格 / 秒）、size 艇身、hp
VehDefs.LCAC = { y = 2.2, deck = 3.0, speed = 75, size = Vector3.new(28, 6, 48), hp = 1800 }   -- 75 格 / 秒：从登陆平台到海滩四十来秒

local D = {}
VehDefs.D = D

-- 履带车的公共部分（负重轮、履带）；轮式车的车轴
local function tracked(t)
  t.arch = "tracked"
  t.wheels = nil
  return t
end
local function wheeled(t)
  t.arch = "wheeled"
  return t
end

