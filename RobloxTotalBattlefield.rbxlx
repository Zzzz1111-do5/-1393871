add("gm.item.tac_light", "M952V 战术手电", "M952V Weapon Light")
add("gm.item.tac_peq", "PEQ-15 激光指示器", "PEQ-15 Aiming Laser")
add("gm.desc.fh_a2", "枪身原装的 A2 消焰器", "The rifle's stock A2 flash hider")
add("gm.desc.muz_none", "原装枪口", "Stock muzzle")
add("gm.desc.muz_comp", "往上喷气压住枪口：连射上跳明显变小", "Vents gas upward: much less muzzle climb")
add("gm.desc.muz_brake", "侧面多孔泄气：左右飘得少，后坐也小一点", "Side ports: less horizontal drift and kick")
add("gm.desc.sup_socom", "开枪不上敌人雷达、没有枪口焰；枪口变重，开镜稍慢", "Off enemy radar, no muzzle flash; heavier, slower to aim")
add("gm.desc.sup_wrap", "裹着隔热布的消音器：左右更稳，射程稍近", "Heat-wrapped suppressor: steadier sideways, shorter range")
add("gm.desc.sup_sr8", "长消音器：射程最远、后坐最小，但又长又重", "Long suppressor: best range and recoil, but long and heavy")
add("gm.desc.iron", "照门和准星：开镜最快，没有放大", "Front and rear sights: fastest to aim, no zoom")
add("gm.desc.opt_romeo", "小巧的反射式红点：几乎不拖慢开镜", "Tiny reflex dot: barely slows aiming")
add("gm.desc.opt_rds", "T1 红点：视野清楚，红点醒目", "T1 red dot: clear view, bright dot")
add("gm.desc.opt_holo", "全息圈 + 中心点：近战最快对准，腰射也稳一点", "Holo ring and dot: fastest close-range target pickup")
add("gm.desc.acog", "3.5 倍光学镜：中距离一枪一个准", "3.5x prism scope for mid-range")
add("gm.desc.opt_acog6", "6 倍光学镜：远距离点射，开镜最慢", "6x scope for long range; slowest to aim")
add("gm.desc.grip_none", "不装握把", "No foregrip")
add("gm.desc.grip_rvg", "垂直握把：压住上跳，据枪更稳", "Vertical grip: tames climb, steadier aim")
add("gm.desc.grip_afg", "斜握把：端枪更灵活，开镜更快", "Angled grip: quicker handling and aiming")
add("gm.desc.mag_std", "标准 30 发", "Standard 30 rounds")
add("gm.desc.mag_pmag20", "20 发短弹匣：轻、换弹快", "20 rounds: light, fast reload")
add("gm.desc.mag_hex30", "30 发，换弹快一点", "30 rounds, slightly faster reload")
add("gm.desc.mag_pmag40", "40 发：多打 10 发，换弹稍慢", "40 rounds: 10 more, slower reload")
add("gm.desc.mag_drum", "60 发弹鼓：火力压制，但又重又慢", "60-round drum: suppressing fire, heavy and slow")
add("gm.desc.tac_none", "不装", "None")
add("gm.desc.tac_light", "战术手电：照亮前面，夜里好用；腰射稍稳", "Weapon light: lights the way at night; steadier hip-fire")
add("gm.desc.tac_peq", "可见激光：腰射准很多，但别人也看得见那道光", "Visible laser: far better hip-fire, but enemies see the beam")

---------------------------------------------------------------- 城市图「钢城」（MapCity.lua，地图 id city，用户 11-26「做一个两边带机场的城市地图吧」）：据点、阶段、出生点（键后面加 @city）
add("faction.sub@city", "钢城 · 城市装甲战", "STEEL CITY · URBAN ARMOR")
add("faction.atk.role@city", "进攻  ·  从南边打进城", "ATTACK  ·  PUSH IN FROM THE SOUTH")
add("faction.def.role@city", "防守  ·  守住城区", "DEFEND  ·  HOLD THE CITY")
add("faction.atk.desc@city", "从南边的主基地出发（车场、直升机坪、跑道都在基地里）：先拿下钢厂 A，再打公园 B、中央广场 C、火车站 D，最后攻下北边的电视塔 E。街道窄、楼挡视线，注意转角和楼缝；树撞得倒，炮弹打得塌楼。",
  "Roll out of the southern main base (motor pool, helipads and runway are all inside): take Steel Works A, then the Park B, Central Square C and the Rail Station D, and finally the TV Tower E in the north. Narrow streets and buildings block sight: watch corners and gaps. Trees fall when rammed; shells can bring buildings down.")
add("point.A@city", "A 钢厂", "A Steel Works")
add("point.B@city", "B 公园", "B Park")
add("point.C@city", "C 中央广场", "C Central Square")
add("point.D@city", "D 火车站", "D Rail Station")
add("point.E@city", "E 电视塔", "E TV Tower")
add("spawn.redbase@city", "攻方主基地（营区、车场、直升机）", "Main Base (camp, motor pool, helos)")
add("spawn.af2@city", "攻方主基地机场（固定翼）", "Main Base Airfield (jets)")
add("spawn.camp@city", "守方主基地（营区、车场、直升机）", "Main Base (camp, motor pool, helos)")
add("operation.day@city", "钢城突击", "STEEL CITY ASSAULT")
add("stage.factory@city", "拿下钢厂", "TAKE THE STEEL WORKS")
add("stage.factory.atk@city", "冲进南边的厂区，拿下钢厂 A", "Break into the works yard and take A")
add("stage.factory.def@city", "守住钢厂 A，别让敌人进城", "Hold the Steel Works A, keep them out of the city")
add("stage.factory.short@city", "钢厂", "WORKS")
add("stage.park@city", "夺取公园", "TAKE THE PARK")
add("stage.park.atk@city", "穿过树林，拿下公园 B（树撞得倒）", "Push through the trees and take Park B (trees fall when rammed)")
add("stage.park.def@city", "守住公园 B", "Hold Park B")
add("stage.park.short@city", "公园", "PARK")
add("stage.square@city", "攻占中央广场", "TAKE THE SQUARE")
add("stage.square.atk@city", "打到城中心，拿下中央广场 C", "Fight to the center and take Central Square C")
add("stage.square.def@city", "守住中央广场 C，巷战拖住敌人", "Hold Central Square C street by street")
add("stage.square.short@city", "广场", "SQUARE")
add("stage.station@city", "夺取火车站", "TAKE THE STATION")
add("stage.station.atk@city", "拿下火车站 D（货车厢后面能藏车）", "Take the Rail Station D (wagons give cover)")
add("stage.station.def@city", "守住火车站 D", "Hold the Rail Station D")
add("stage.station.short@city", "车站", "STATION")
add("stage.tower@city", "攻下电视塔", "TAKE THE TV TOWER")
add("stage.tower.atk@city", "最后一个：拿下北边的电视塔 E，结束战斗", "Last one: take the TV Tower E in the north to win")
add("stage.tower.def@city", "最后一道防线：死守电视塔 E", "Last line: hold the TV Tower E at all costs")
add("stage.tower.short@city", "电视塔", "TOWER")

---------------------------------------------------------------- 雪山（MapSnow.lua，地图 id snow；用户 11-26 晚「我要求你做一个雪山地图 一定要做到极高质量」）
add("map.snow.name", "雪山", "SNOW PEAKS")
add("map.snow.mode", "高山突破", "ALPINE BREAKTHROUGH")
add("map.snow.desc", "一条冰封的高山河谷（约 7 × 18 公里），两头主基地带跑道，谷外的雪峰望不到头：山梁、冲沟、岩石包，打过仗的山村、锯木厂、山坡上的雷达站、冰湖边的水电站、北边的山口 · 树撞得倒，房子炸得塌",
  "A frozen alpine valley (about 7 × 18 km) with a runway at each main base and snow peaks as far as the eye can see: ridges, gullies and rock outcrops, a war-torn village, a sawmill, a hillside radar station, a hydro plant by the ice lake and the mountain pass · trees fall, houses collapse")
add("faction.sub@snow", "雪山 · 高山装甲战", "SNOW PEAKS · ALPINE ARMOR")
add("faction.atk.role@snow", "进攻  ·  从南边打进河谷", "ATTACK  ·  PUSH UP THE VALLEY")
add("faction.def.role@snow", "防守  ·  守住山口", "DEFEND  ·  HOLD THE PASS")
add("faction.atk.desc@snow", "从南边的主基地出发（车场、直升机坪、跑道都在基地里）：先拿下锯木厂 A，再打西坡上的雷达站 B、河边的山村 C、冰湖边的水电站 D，最后攻下北边的山口检查站 E。谷里到处是山梁和冲沟：车体藏在梁后面打，冰面上没有掩护。",
  "Roll out of the southern main base (motor pool, helipads and runway are all inside): take the Sawmill A, then the Radar Station B on the west slope, the Village C by the river, the Hydro Plant D by the ice lake, and finally the Mountain Pass E in the north. The valley is full of ridges and gullies: fight hull-down behind the crests — there is no cover on the ice.")
add("faction.def.desc@snow", "守住河谷：锯木厂 A、雷达站 B、山村 C、水电站 D、山口 E 一个一个守。占着高处（雷达站的台地、山口两边的山肩）往下打，山村的废墟里能藏车。",
  "Hold the valley point by point: Sawmill A, Radar Station B, Village C, Hydro Plant D and the Pass E. Fight from the high ground (the radar plateau, the shoulders of the pass); the village ruins can hide a tank.")
add("point.A@snow", "A 锯木厂", "A Sawmill")
add("point.B@snow", "B 雷达站", "B Radar Station")
add("point.C@snow", "C 山村", "C Village")
add("point.D@snow", "D 水电站", "D Hydro Plant")
add("point.E@snow", "E 山口", "E Mountain Pass")
add("spawn.redbase@snow", "攻方主基地（营区、车场、直升机）", "Main Base (camp, motor pool, helos)")
add("spawn.af2@snow", "攻方主基地机场（固定翼）", "Main Base Airfield (jets)")
add("spawn.camp@snow", "守方主基地（营区、车场、直升机）", "Main Base (camp, motor pool, helos)")
add("operation.day@snow", "雪山突破", "SNOW PEAKS BREAKTHROUGH")
add("stage.sawmill@snow", "拿下锯木厂", "TAKE THE SAWMILL")
add("stage.sawmill.atk@snow", "冲进南边的锯木厂，拿下 A（原木堆后面能藏步兵）", "Storm the sawmill in the south and take A (log piles give cover)")
add("stage.sawmill.def@snow", "守住锯木厂 A，别让敌人进谷", "Hold the Sawmill A, keep them out of the valley")
add("stage.sawmill.short@snow", "锯木厂", "SAWMILL")
add("stage.radar@snow", "夺取雷达站", "TAKE THE RADAR")
add("stage.radar.atk@snow", "爬上西坡的台地，拿下雷达站 B", "Climb the west plateau and take the Radar Station B")
add("stage.radar.def@snow", "守住雷达站 B：台地上看得远，压住谷底", "Hold the Radar Station B: the plateau overlooks the valley floor")
add("stage.radar.short@snow", "雷达站", "RADAR")
add("stage.village@snow", "攻占山村", "TAKE THE VILLAGE")
add("stage.village.atk@snow", "过石桥打进山村，拿下 C（废墟后面小心伏击）", "Cross the stone bridge and take the Village C (watch for ambushes in the ruins)")
add("stage.village.def@snow", "守住山村 C，废墟里打巷战", "Hold the Village C among the ruins")
add("stage.village.short@snow", "山村", "VILLAGE")
add("stage.hydro@snow", "夺取水电站", "TAKE THE HYDRO PLANT")
add("stage.hydro.atk@snow", "绕过冰湖，拿下水电站 D（冰面上没有掩护）", "Skirt the ice lake and take the Hydro Plant D (no cover on the ice)")
add("stage.hydro.def@snow", "守住水电站 D", "Hold the Hydro Plant D")
add("stage.hydro.short@snow", "水电站", "HYDRO")
add("stage.pass@snow", "攻下山口", "TAKE THE PASS")
add("stage.pass.atk@snow", "最后一个：拿下北边的山口检查站 E，结束战斗", "Last one: take the Mountain Pass E in the north to win")
add("stage.pass.def@snow", "最后一道防线：死守山口 E（两边山肩居高临下）", "Last line: hold the Pass E — the shoulders on both sides look down on the road")
add("stage.pass.short@snow", "山口", "PASS")

---------------------------------------------------------------- 沙漠图「沙海」（MapSands.lua，地图 id sands）：据点、阶段、出生点、阵营说明换成沙漠的说法（键后面加 @sands）
add("faction.sub@sands", "海湾风暴 · 沙漠装甲突击", "SEA OF SAND · ARMORED ASSAULT")   -- 英文别叫 DESERT STORM：另一张沙漠图叫这个
add("faction.atk.role@sands", "进攻  ·  装甲突击", "ATTACK  ·  ARMORED ASSAULT")
add("faction.def.role@sands", "防守  ·  纵深防御", "DEFEND  ·  DEFENSE IN DEPTH")
add("faction.atk.desc@sands", "从南边的前进基地、前进机场北上：越过边境沙墙拿下哨所 A，再打油田 B、镇子 C、空军基地 D，最后攻下岩岭上的指挥部 E。每个阶段都能在目标前面的攻击出发阵地出生。每阵亡一人兵力少 1，兵力打光就输。",
  "Push north from the forward base and airstrip: breach the border berm and take Outpost A, then the Oilfield B, Town C and Airbase D, and finally Command E on the ridge. Spawn at the assault position in front of each objective. Every death costs one reinforcement; run out and you lose.")
add("point.A@sands", "A 边境哨所", "A Border Post")
add("point.B@sands", "B 油田", "B Oilfield")
add("point.C@sands", "C 镇子", "C Town")
add("point.D@sands", "D 空军基地", "D Airbase")
add("point.E@sands", "E 岭上指挥部", "E Ridge Command")
add("spawn.redbase@sands", "攻方主基地（营区、车场、直升机）", "Main Base (camp, motor pool, helos)")
add("spawn.af2@sands", "攻方主基地机场（固定翼）", "Main Base Airfield (jets)")
add("spawn.camp@sands", "守方主基地（营区、车场、直升机）", "Main Base (camp, motor pool, helos)")
add("spawn.af3", "守方主基地机场（固定翼）", "Main Base Airfield (jets)")
add("spawn.afield@sands", "空军基地（战斗机）", "Airbase (jets)")
add("hud.tip.3@sands", "地图上的载具生成点按 E 生成坦克、装甲车、直升机和飞机，走过去按 E 上车。", "Press E at a vehicle pad to spawn tanks, APCs, helicopters and jets; walk up and press E to get in.")
add("operation.opening@sands", "夜间突击", "NIGHT ASSAULT")
-- 用户 11-25 昼夜更替：开场名字按钟点（Operation.lua）
add("operation.dawn", "拂晓突击", "DAWN ASSAULT")
add("operation.day", "沙海突击", "DESERT ASSAULT")
add("operation.dusk", "黄昏突击", "DUSK ASSAULT")
add("operation.night", "夜间突击", "NIGHT ASSAULT")
add("stage.border@sands", "突破边境", "BREACH THE BORDER")
add("stage.border.atk@sands", "越过沙墙和反坦克壕，拿下边境哨所 A", "Cross the berm and the tank ditch, take Border Post A")
add("stage.border.def@sands", "守住边境哨所 A，把敌人挡在沙墙外", "Hold Border Post A and stop them at the berm")
add("stage.border.short@sands", "边境", "BORDER")
add("stage.oil@sands", "夺取油田", "TAKE THE OILFIELD")
add("stage.oil.atk@sands", "拿下油田 B（油井在烧，小心烟里的敌人）", "Take Oilfield B (wells burning: watch the smoke)")
add("stage.oil.def@sands", "守住油田 B", "Hold Oilfield B")
add("stage.oil.short@sands", "油田", "OILFIELD")
add("stage.town@sands", "攻入镇子", "TAKE THE TOWN")
add("stage.town.atk@sands", "打进镇子，拿下据点 C", "Fight into the town and take C")
add("stage.town.def@sands", "守住镇子 C，巷战拖住敌人", "Hold Town C street by street")
add("stage.town.short@sands", "镇子", "TOWN")
add("stage.airfield.atk@sands", "拿下空军基地 D", "Take Airbase D")
add("stage.airfield.def@sands", "守住空军基地 D", "Hold Airbase D")
add("stage.hq.atk@sands", "翻上岩岭，攻下指挥部 E，结束战斗", "Climb the ridge and take Command E to win")
