add("coach.mode.lcac", "开气垫艇", "Hovercraft")
add("coach.mode.jet", "开飞机", "Jets")
add("coach.mode.heli", "开直升机", "Helicopters")
add("coach.mode.uav", "遥控无人机", "Drones")
add("coach.mode.ship", "开船", "Ships")
add("coach.mode.fort", "操作炮位", "Gun positions")
add("coach.mode.arty", "操作火炮", "Artillery")
