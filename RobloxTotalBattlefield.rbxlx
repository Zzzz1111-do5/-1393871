    ["drv.hintLine"] = "Shift Visier verlassen · R Entfernung · PgUp / PgDn Visier-Entfernung · Q / 1-5 Granate · Z / Rad Zoom · C Fernglas · LMT feuern · Leertaste MG",
    ["drv.hintOptic"] = "[V] Optik: {1}",
