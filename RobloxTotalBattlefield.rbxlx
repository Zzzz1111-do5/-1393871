-- 起步车（用户 11-26：「不要一开始就给人解锁那么多坦克 就每个系从只给一辆最基础的坦克开始」）：每系每棵树只白送一辆，
--   按规则现算、不逐项写死（上面行里的 free = true 不再看）——以后加了更老的车，白送的自动换成它：
--   各列打头（没有前置）的车里，最低一级、年份最老的那一辆（再一样按战斗等级低的、列表里靠前的）；
--   地面树只在坦克那几列（主战、第二条线、轻型）里挑，一辆坦克都没有才看步战车、防空车；
--   轻型那一列里的侦察车（scout：BRDM-2、87 式侦察警戒车）不算坦克，不挑它；
--   直升机树、固定翼哪一列都行（11-26 纯运输直升机删了：起步的是最老、级别最低的那架——米-8MT、UH-1N、AH-1S、直-8、虎式）
--   11-28 用户「送就只送1级载具 飞机要拿金币买」：只有地面树的起步车白送（还得是一级），飞机、直升机树的不送了
local STARTER_COLS = { ground = { [1] = true, [2] = true, [3] = true } }
--   11-28「送就只送1级载具」：先找一级的坦克；没有一级坦克就找一级的步战车、防空车（俄系：T-72 乌拉尔是二级，白送一级的 BMP-1）；
--   整棵树连一辆一级车都没有（日系：最老的是二级的 74 式）才照旧送最老的那辆坦克——不然这个系一辆车都开不了
local function pickStarter(list, br)
  local pref = STARTER_COLS[br]
  local function best(ok)
    local b, bi
    for i, it in ipairs(list) do
      if it.prev == nil and ok(it) then
        local better = not b
        if b then
          if it.rank ~= b.rank then better = it.rank < b.rank
          elseif (it.year or 0) ~= (b.year or 0) then better = (it.year or 0) < (b.year or 0)
          elseif it.br ~= b.br then better = it.br < b.br
          else better = i < bi end
        end
        if better then b, bi = it, i end
      end
    end
    return b
  end
  if not pref then return best(function() return true end) end
  --   11-28：引进的车（nostart：T-34-85 这类比本国起步车更老的外国车）不当起步车——不然一加进来白送的就换了，已有存档里那辆白送车没了
  return best(function(it) return it.rank == 1 and pref[it.col] and not it.scout and not it.nostart end)
    or best(function(it) return it.rank == 1 and not it.scout and not it.nostart end)
    or best(function(it) return pref[it.col] and not it.scout and not it.nostart end)
    or best(function() return true end)
end
TT.pickStarter = pickStarter   -- 测试用：拿一份假的车单验证规则
TT.START = {}   -- [系][树] = 起步车的 key（这棵树空着就没有）

-- 展开：每项变成表，记前置（同一列的上一项）、研究点、价格
TT.byKey = {}
TT.list = {}   -- [系][树] = { 项, ... }（按列、按顺序）
for _, nat in ipairs(TT.NATIONS) do
  TT.START[nat] = {}
  TT.list[nat] = {}
  for _, br in ipairs(TT.BRANCHES) do
    local out, lastInCol = {}, {}
    for _, row in ipairs(LIST[nat][br]) do
      local it = { key = row[1], name = row[2], en = row[3], year = row[4], rank = row[5], col = row[6], br = row[7],
        veh = row.veh, base = row.base, model = row.model, scout = row.scout, nostart = row.nostart, nat = nat, branch = br }
      it.play = it.veh or it.base   -- 出车开哪一型
      it.stand = it.veh == nil      -- 暂用别的型号（模型和性能都借）
      -- model：性能是这一型自己的（VehDefs 里有它的炮、弹、装甲、机动），只是还没有它自己的模型，借同族那一型的真模型
      --   （用户 11-25「需要模型自己找」：T-80B 借 T-80U、豹 2A4 借 2A6、M60A1 借 M60A3 的模型；ImportedMeta 的 alias 把它指到那个模型）
      local prev = lastInCol[it.col]
      if prev and prev.rank > it.rank then prev = nil end   -- 写错顺序（上面比下面级别高）就不连
      it.prev = prev and prev.key or nil
      lastInCol[it.col] = it
      local R = TT.RANKS[it.rank]
      it.rp, it.cost = R.rp, R.cost
      it.free = false   -- 白送的只有起步车（下面按规则挑）
      table.insert(out, it)
      TT.byKey[it.key] = it
    end
    -- 只白送地面树的一级车（用户 11-28「送就只送1级载具 飞机要拿金币买」）：飞机、直升机树没有起步车，要拿金币买
    local st = (br == "ground") and pickStarter(out, br) or nil
    if st then
      st.free = true
      TT.START[nat][br] = st.key
    end
    TT.list[nat][br] = out
  end
end

-- 型号 → 科技树里第一个用它自己性能的项（沙盒、电脑车没有 TreeKey：观瞄 WtOptics 按它查年代、国家）
TT.byVeh = {}
for _, nat in ipairs(TT.NATIONS) do
  for _, br in ipairs(TT.BRANCHES) do
    for _, it in ipairs(TT.list[nat][br]) do
      if it.veh and TT.byVeh[it.veh] == nil then TT.byVeh[it.veh] = it end
    end
  end
end
-- 老的 m1a1（老模式、老 AI 名单还在开）11-27 起不是哪一项的 veh 了（科技树的 M1A1 开 m1a1base）：沙盒、电脑车按型号找年代、国家时照旧认 us_m1a1
--   （同一年、同一国：观瞄、火控代跟原来一样）
TT.byVeh.m1a1 = TT.byVeh.m1a1 or TT.byKey.us_m1a1

function TT.get(key) return TT.byKey[key] end
-- 这一系这棵树的起步车（白送的那一辆；树空着返回 nil）
function TT.starter(nat, br)
  local k = TT.START[nat] and TT.START[nat][br]
  return k and TT.byKey[k] or nil
end
-- 战斗等级的写法（10.0 → "10.0"）
function TT.brText(v) return string.format("%.1f", v or 0) end
-- 阵容的战斗等级：里面最高的那辆
function TT.lineupBr(keys)
  local m = 0
  for _, k in ipairs(keys or {}) do
    local it = TT.byKey[k]
    if it and it.br > m then m = it.br end
  end
  return m
end
-- 存档（每人）：res[key] = true 研究完、own[key] = true 买下、rp[key] = 攒了多少、cur[系 .. ":" .. 树] = 正在研究的 key
--   能不能研究这一辆：没研究完、前置研究完了、这一级开了（上一级研究完 RANK_NEED 辆）
function TT.rankOpen(save, nat, branch, rank)
  if rank <= 1 then return true end
  local B = TT.BRANCH[branch]
  local need = ((B and B.need) or TT.RANK_NEED)[rank - 1] or 2
  local n, cnt = 0, 0
  for _, it in ipairs(TT.list[nat][branch]) do
    if it.rank == rank - 1 then
      cnt += 1
      if (save.res or {})[it.key] or it.free then n += 1 end
    end
  end
  -- 上一级这棵树一辆都没有（直升机树车少，比如德国直接从五级的虎式开始）：再往上一级看，不把整棵树锁死；
  --   上一级只有一辆、要研究两辆的，研究完那一辆就算
  if cnt == 0 then return TT.rankOpen(save, nat, branch, rank - 1) end
  return n >= math.min(need, cnt)
end
-- 解锁这一级还差什么（界面上写，规则同 rankOpen）：返回 上一级研究完几辆、要几辆、看的是哪一级（上一级这棵树没车就再往上看）
function TT.rankNeed(save, nat, branch, rank)
  local B = TT.BRANCH[branch]
  for r = rank - 1, 1, -1 do
    local need = ((B and B.need) or TT.RANK_NEED)[r] or 2
    local n, cnt = 0, 0
    for _, it in ipairs(TT.list[nat][branch]) do
      if it.rank == r then
        cnt += 1
        if (save.res or {})[it.key] or it.free then n += 1 end
      end
    end
    if cnt > 0 then return n, math.min(need, cnt), r end
  end
  return 0, 0, 1
end
function TT.researched(save, key)
  local it = TT.byKey[key]
  return it ~= nil and (it.free or (save.res or {})[key] == true)
end
function TT.owned(save, key)
  local it = TT.byKey[key]
  return it ~= nil and (it.free or (save.own or {})[key] == true)
end
function TT.canResearch(save, key)
  local it = TT.byKey[key]
  if not it or TT.researched(save, key) then return false, "done" end
  if it.prev and not TT.researched(save, it.prev) then return false, "prev" end
  if not TT.rankOpen(save, it.nat, it.branch, it.rank) then return false, "rank" end
  return true
end

-- 真车的标准涂装（用户 11-25「很多车涂装纯米黄你给他改回原本颜色」）：还没有原模型、用零件拼的暂用车按这个上色，
--   不再按阵营一律刷沙色 / 林地绿。base 车体主色、dark 深色（迷彩深色块、阴影处）、light 浅色（迷彩浅色块、边角）；sRGB 0–255
--   解放军：早年 PLA 绿，2005 年以后的数码林地按绿褐近似；苏俄：4BO 绿，2010 年后偏卡其；
--   联邦国防军：1984 年以前 RAL 6014 黄橄榄，以后北约三色（RAL 6031 青铜绿 + 9021 焦油黑 + 8027 皮革棕）；
--   美军：1975 年以前 FS 34087 橄榄绿，1976–1990 MERDC / 北约林地三色，1991 年以后 CARC 686 沙色；陆上自卫队：橄榄绿 + 褐色两色
local PAINT = {
  cn = { { 2004, { 72, 86, 56 }, { 52, 62, 40 }, { 98, 108, 74 } }, { 9999, { 86, 96, 64 }, { 60, 58, 42 }, { 122, 120, 88 } } },
  ru = { { 2009, { 74, 88, 52 }, { 50, 60, 36 }, { 96, 108, 70 } }, { 9999, { 90, 92, 62 }, { 56, 58, 40 }, { 120, 118, 84 } } },
  de = { { 1983, { 92, 88, 62 }, { 64, 60, 42 }, { 118, 112, 82 } }, { 9999, { 64, 74, 58 }, { 36, 36, 34 }, { 82, 66, 50 } } },
  us = { { 1975, { 80, 84, 56 }, { 54, 58, 40 }, { 104, 104, 74 } }, { 1990, { 62, 72, 52 }, { 38, 38, 34 }, { 86, 72, 52 } },
    { 9999, { 176, 158, 116 }, { 128, 114, 84 }, { 198, 184, 146 } } },
  jp = { { 9999, { 82, 86, 60 }, { 80, 62, 46 }, { 106, 108, 80 } } },
}
function TT.paint(it)
  local list = it and PAINT[it.nat]
  if not list then return nil end
  for _, p in ipairs(list) do
    if (it.year or 0) <= p[1] then return { base = p[2], dark = p[3], light = p[4] } end
  end
  return nil
end

return TT
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="132">
      <Properties>
        <string name="Name">Theme</string>
        <ProtectedString name="Source"><![CDATA[-- 全游戏统一外观（用户 11-25：「整个游戏风格极其割裂……四不像」，定下来统一成我们自己的一套写实军事风格，不照搬别的游戏的样子）。
--   规范写在 docs/style.md；所有界面的颜色、字体、字号、面板从这里取，新界面也一样（不要再在模块里自己定一套白、灰、绿、红）。
--   原则：底子是黑白灰（深色半透明面板、白字），颜色只用来表示意思——绿 = 自己人 / 完好 / 可以，红 = 敌人 / 危险 / 坏了，
--   琥珀 = 注意 / 进行中 / 受伤 / 金币；车上、飞机上的瞄准和飞行符号统一一种亮绿（Theme.C.HUD）。不用蓝色（用户 11-21：蓝色全部改成绿色）。
local Theme = {}
local RGB = Color3.fromRGB

Theme.C = {
  -- 底色、面板
  BG = RGB(8, 10, 12),        -- 整屏的底（机库、科技树、结算页）
  PANEL = RGB(14, 17, 20),    -- 面板、卡片
  RAISE = RGB(32, 36, 40),    -- 次要按钮、悬停
  LINE = RGB(255, 255, 255),  -- 细线、描边（配 Theme.A.line / lineHi 的透明度）
  INK = RGB(0, 0, 0),         -- 字的描边
  -- 字
  TEXT = RGB(236, 238, 236),  -- 正文、数字
  MUTE = RGB(160, 166, 164),  -- 次要说明、标签
  FAINT = RGB(104, 110, 110), -- 不能点的、没解锁的
  -- 意思
  GOOD = RGB(110, 214, 124),  -- 自己人、完好、已拥有、能打穿
  BAD = RGB(236, 74, 60),     -- 敌人、危险、坏了、打不穿
  WARN = RGB(240, 182, 72),   -- 注意、受伤、进行中、金币
  NEUTRAL = RGB(200, 204, 204), -- 中立据点
  HUD = RGB(128, 255, 152),   -- 车上 / 飞机上的瞄准与飞行符号（亮绿：天空、沙地上都看得清）
}
Theme.C.FRIEND = Theme.C.GOOD
Theme.C.FOE = Theme.C.BAD

-- 透明度
Theme.A = {
  panel = 0.18,   -- 面板底
  bar = 0.35,     -- 屏幕边上的信息条（比面板淡，不挡战场）
  line = 0.82,    -- 普通细线
  lineHi = 0.45,  -- 选中、悬停的细线
  stroke = 0.45,  -- 战场上的字的描边
}

-- 字体（用户 11-25「字体不清晰」）：正文、强调、标题换成 Roblox 自己的 Builder Sans（小字号下比 Gotham 清楚）；11-27「我觉得字体可以细一点」整体细一档，
--   中文不再自动加粗；
--   数字和仪表 RobotoMono；卡片上的短标签、型号用窄体 RobotoCondensed（同类游戏的军事界面感）
Theme.F = {
  body = Enum.Font.BuilderSans,
  bold = Enum.Font.BuilderSansMedium,
  title = Enum.Font.BuilderSansBold,
  mono = Enum.Font.RobotoMono,
  cond = Enum.Font.RobotoCondensed,
}

-- 字号（11-25 整体大一档：12 / 13 / 15 / 17 / 21 / 29 / 42）
Theme.S = { tiny = 12, small = 13, body = 15, sub = 17, title = 21, big = 29, huge = 42 }
-- 科技树等级的底色（用户 11-25「载具科技树不同等级的载具背景颜色要有区别」）：一级一个色，压暗、偏军用色，不用蓝；
--   科技树每一级的横条、车卡车图底板、机库阵容卡、详情大图都按它（Theme.rankGrad）
Theme.RANK = {
  Color3.fromRGB(86, 104, 80),    -- I   灰绿
  Color3.fromRGB(108, 106, 62),   -- II  橄榄
  Color3.fromRGB(124, 104, 70),   -- III 沙褐
  Color3.fromRGB(128, 86, 58),    -- IV  铜褐
  Color3.fromRGB(122, 64, 62),    -- V   砖红
  Color3.fromRGB(102, 70, 98),    -- VI  紫褐
  Color3.fromRGB(132, 112, 52),   -- VII 暗金
}
function Theme.rankColor(r) return Theme.RANK[math.clamp(math.floor(r or 1), 1, #Theme.RANK)] end
Theme.R = 2   -- 圆角（像素）：方正、硬朗

-- 自己这一边 / 对面：一律按看的人算（不按攻守方的固定颜色）
function Theme.side(side, mine)
  if side == nil or side == "" then return Theme.C.NEUTRAL end
  if mine == nil or mine == "" then
    local ok, pl = pcall(function() return game:GetService("Players").LocalPlayer end)
    mine = ok and pl and pl:GetAttribute("Side") or nil
  end
  return (side == mine) and Theme.C.FRIEND or Theme.C.FOE
end

-- 状态比例（1 完好 → 0 坏了）：绿 → 琥珀 → 红
function Theme.state(k)
  if k >= 0.66 then return Theme.C.GOOD end
  if k >= 0.33 then return Theme.C.WARN end
  return Theme.C.BAD
end

---------------------------------------------------------------- 小工具（新界面直接用；老界面只换颜色字体时用不到）
function Theme.stroke(o, strong, col)
  local s = o:FindFirstChildOfClass("UIStroke") or Instance.new("UIStroke")
  s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
  s.Color = col or Theme.C.LINE
  s.Transparency = strong and Theme.A.lineHi or Theme.A.line
  s.Thickness = 1
  s.Parent = o
  return s
end

function Theme.corner(o, r)
  local c = o:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
  c.CornerRadius = UDim.new(0, r or Theme.R)
  c.Parent = o
  return c
end

-- 面板：深色半透明底 + 一圈细线
function Theme.panel(parent, size, pos, anchor)
  local f = Instance.new("Frame")
  f.Size, f.Position, f.AnchorPoint = size, pos or UDim2.new(), anchor or Vector2.new(0, 0)
  f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = Theme.C.PANEL, Theme.A.panel, 0
  Theme.corner(f)
  Theme.stroke(f)
  f.Parent = parent
  return f
end

-- 字：kind = "body" | "bold" | "title" | "mono"
function Theme.label(parent, text, size, kind, col)
  local l = Instance.new("TextLabel")
  l.BackgroundTransparency = 1
  l.Text = text
  l.Font = Theme.F[kind or "body"] or Theme.F.body
  l.TextSize = size or Theme.S.body
  l.TextColor3 = col or Theme.C.TEXT
  l.TextXAlignment = Enum.TextXAlignment.Left
  l.Size = UDim2.new(1, 0, 0, (size or Theme.S.body) + 4)
  l.Parent = parent
  return l
end

-- 按钮：primary（白底黑字，一屏最多一个：出击、开始）/ 默认（灰底白字）
function Theme.button(parent, text, size, pos, primary)
  local b = Instance.new("TextButton")
  b.AutoButtonColor = true
  b.Size, b.Position = size, pos or UDim2.new()
  b.BackgroundColor3 = primary and Theme.C.TEXT or Theme.C.RAISE
  b.BackgroundTransparency = primary and 0 or 0.1
  b.BorderSizePixel = 0
  b.Text = text
  b.Font = Theme.F.bold
  b.TextSize = Theme.S.body
  b.TextColor3 = primary and Theme.C.BG or Theme.C.TEXT
  Theme.corner(b)
  if not primary then Theme.stroke(b) end
  b.Parent = parent
  return b
end

-- 竖着的渐变（上 → 下）：面板、卡片的车图底板（用户 11-25「没有设计感」：纯色细线太平，加一点层次）
-- 车图底板按等级上色：上面是这一级的颜色（亮一点）、往下压到近黑
function Theme.rankGrad(o, r)
  local c = Theme.rankColor(r)
  return Theme.grad(o, c:Lerp(Color3.new(1, 1, 1), 0.12), c:Lerp(Color3.new(0, 0, 0), 0.82))
end
function Theme.grad(o, top, bottom, rot)
  local g = o:FindFirstChildOfClass("UIGradient") or Instance.new("UIGradient")
  g.Color = ColorSequence.new(top, bottom)
  g.Rotation = rot or 90
  g.Parent = o
  return g
end
-- 选中的发光描边（琥珀）：外面再套一圈淡的
function Theme.glow(o, col)
  local s = Theme.stroke(o, true, col or Theme.C.WARN)
  s.Thickness, s.Transparency = 2, 0
  return s
end

-- 选中 / 没选中（页签、分段按钮）：选中白底黑字，没选中灰底白字
function Theme.setSelected(b, on)
  b.BackgroundColor3 = on and Theme.C.TEXT or Theme.C.RAISE
  b.BackgroundTransparency = on and 0 or 0.1
  if b:IsA("TextButton") or b:IsA("TextLabel") then
    b.TextColor3 = on and Theme.C.BG or Theme.C.TEXT
  end
end
-- 次级选中（整备的预设、内油、我的方案……）：白底只给页签和主按钮（一屏白底最多两块），次级的选中不填白——
--   选中：RAISE 底（透明 0.1）+ 1 像素白描边 + 贴底 2 像素白线、字白；没选中：透明底 + 1 像素细线（A.line）、字灰。琥珀留给「正在改的挂点」和预览
--   字在按钮自己身上（Text 不空）或者子零件 Label 上，两种都认
function Theme.setPicked(b, on)
  on = on == true
  b.BackgroundColor3 = Theme.C.RAISE
  b.BackgroundTransparency = on and 0.1 or 1
  local s = Theme.stroke(b)
  s.Color = on and Theme.C.TEXT or Theme.C.LINE
  s.Transparency = on and 0.1 or Theme.A.line
  local u = b:FindFirstChild("PickLine")
  if not u then
    u = Instance.new("Frame")
    u.Name = "PickLine"
    u.BorderSizePixel = 0
    u.BackgroundColor3 = Theme.C.TEXT
    u.BackgroundTransparency = 0
    u.Size = UDim2.new(1, 0, 0, 2)
    u.Position = UDim2.new(0, 0, 1, -2)
    u.Parent = b
  end
  u.Visible = on
  local col = on and Theme.C.TEXT or Theme.C.MUTE
  if (b:IsA("TextButton") or b:IsA("TextLabel")) and b.Text ~= "" then b.TextColor3 = col end
  local l = b:FindFirstChild("Label")
  if l and l:IsA("TextLabel") then l.TextColor3 = col end
  b:SetAttribute("Picked", on)
end

---------------------------------------------------------------- 动效（docs/style.md「动效」；用户 11-27「做的很粗糙 我需要非常艺术经验的效果」）
-- 时长（秒）：短、克制——按钮反馈 0.12，界面变化不超过 0.3，大的换场（镜头）0.55；退场比进场短
Theme.T = {
  hover = 0.12,    -- 悬停、描边变亮、选中（琥珀细描边 + 底边 2 像素；不抬起，同战斗里的弹药栏）
  num = 0.22,      -- 数字滚动、条长变化
  ui = 0.22,       -- 界面里一小块展开、收起、换内容
  panel = 0.28,    -- 进场：面板从旁边滑进来 + 淡入
  out = 0.18,      -- 退场（比进场短）
  cam = 0.55,      -- 镜头换位（进整备、点挂点、换页签）
  mount = 0.22,    -- 装上一枚弹（从挂架下滑上去，带一点回弹）
  done = 0.6,      -- 一项研究完：描边琥珀变绿
  stagger = 0.025, -- 列表每一项比上一项晚这么多出来
  cell = 0.015,    -- 弹药架一格一格填满 / 清空
}
Theme.STAGGER_MAX = 8   -- 错开最多算到第 8 项（后面的和第 8 项一起出来：长列表不拖）
-- 缓动：进场、数字、选中都是先快后慢（Out）；镜头两头慢（InOut）；装弹带一点回弹（Back）。界面上不用先慢后快（In）
Theme.EASE = {
  out = { "Quart", "Out" },
  hover = { "Quad", "Out" },
  cam = { "Quart", "InOut" },
  back = { "Back", "Out" },
}
-- 第 i 项（1 起）的错开延迟
function Theme.stagger(i)
  return math.clamp((i or 1) - 1, 0, Theme.STAGGER_MAX - 1) * Theme.T.stagger
end
-- 缓动曲线本身（0～1 → 0～1，给自己逐帧插值的地方用：镜头、3D 里的东西）：同上面 EASE 的名字
function Theme.ease(k, x)
  x = math.clamp(x, 0, 1)
  if k == "cam" then   -- Quart 两头慢
    if x < 0.5 then return 8 * x ^ 4 end
    return 1 - (-2 * x + 2) ^ 4 / 2
  elseif k == "back" then   -- Back 先快后慢、冲过一点再回来
    local c1 = 1.70158
    return 1 + (c1 + 1) * (x - 1) ^ 3 + c1 * (x - 1) ^ 2
  elseif k == "hover" then   -- Quad 先快后慢
    return 1 - (1 - x) ^ 2
  end
  return 1 - (1 - x) ^ 4   -- Quart 先快后慢
end
-- 补间：Theme.tween(界面零件, { 属性 = 终值 }, 时长（秒数或 Theme.T 的键，默认 ui）, 缓动（Theme.EASE 的键，默认 out）, 延迟秒数)
--   TweenService 包在 pcall 里：零件已经删了、属性名写错、在不支持的环境里，都直接把属性设成终值（界面停在对的样子，不报错）；返回 Tween 或 nil
local TS = nil
function Theme.tween(o, props, t, ease, delay)
  if typeof(o) ~= "Instance" or type(props) ~= "table" then return nil end
  local dur = (type(t) == "number") and t or Theme.T[t or "ui"] or Theme.T.ui
  local e = Theme.EASE[ease or "out"] or Theme.EASE.out
  local ok, tw = pcall(function()
    TS = TS or game:GetService("TweenService")
    local info = TweenInfo.new(math.max(0, dur), Enum.EasingStyle[e[1]], Enum.EasingDirection[e[2]], 0, false, math.max(0, delay or 0))
    local x = TS:Create(o, info, props)
    x:Play()
    return x
  end)
  if ok then return tw end
  for k, v in pairs(props) do pcall(function() o[k] = v end) end
  return nil
end

return Theme
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="133">
      <Properties>
        <string name="Name">TrackLoops</string>
        <ProtectedString name="Source"><![CDATA[-- 履带轮廓（tools/models/trackfit.py 从原模型量的，别手改）：客户端 Tracks.lua 照它套一圈会转的履带板
--   TL[模型键] = { xi 履带内边, xo 外边（|x|，左右对称）, top 上面一段的高度, z0 / z1 上面一段画到哪（前、后）,
--     pts = { z1, y1, z2, y2, … } 下面一段：车头那头 → 贴地 → 车尾那头的折线（格，原点车底中心，−Z 朝前）,
--     原模型履带是单独的块的（大多数）：trk = { 块名… } 游戏里套上履带板时把它们藏起来（不然看着是两副履带）；
--     loop = { z, y, … } 这些块侧视的外轮廓（逆时针一整圈，从最前面那一点开始）、lowL 下面一半多长、bxi / bxo 履带块的内外边 }
