      rh = { 0.223, -0.481, -0.241, -0.4152, -0.4089, 0.6041, 0.5436 },
      lua = { -0.711, -0.832, -0.459, -0.3751, -0.2786, -0.5667, 0.6786 },
      lfa = { -0.179, -0.585, -0.763, -0.3913, -0.126, -0.2299, 0.8821 },
