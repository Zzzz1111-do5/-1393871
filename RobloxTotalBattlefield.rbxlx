    <Item class="ModuleScript" referent="124">
      <Properties>
        <string name="Name">SnowPeaks</string>
        <ProtectedString name="Source"><![CDATA[-- 雪山地图谷外的山脉：摆法（tools/snow/ranges.py 生成，别手改）——谷边一道、外面三道，一座挨一座连成山脉
--   inst 每座 { 模型键, x, z, 转角（度，从上往下看顺时针）, 横向放大 k, 上下挪 y（格）, 外圈（不投影子）, 竖向放大 ky }；
--   模型的块在 ReplicatedStorage.Imported.Peaks.<键>（导入 models/snow/<键>.glb），高度图在同一个文件夹下的 <键> 模块（MapSnow 按需 require）；
--   far 是山外雪原（客户端那圈远处平地）的高度
return {
  far = 11.5,
  size = {
    icy = { 7803.2, 1279.4, 7802.5 },
    rockscan = { 1461.8, 412.1, 1902.2 },
    wmsnow = { 7952.3, 1858.3, 7956.4 },
  },
