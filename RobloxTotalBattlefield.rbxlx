    label = { "分划照明", "RETICLE ILLUMINATION" }, pos = { "白天（亮红）", "夜间（暗红）" }, posEn = { "DAY", "NIGHT" } },
  { id = "BIT", c = V(1.566, 5.576, -2.665), dia = 0.020, style = "push", on = "bit",
    label = { "火控自检", "FCS BIT" } },
}

---------------------------------------------------------------- 艾布拉姆斯（A1 / SEPv2）

return function(Defs, Hp)
  local procM1A2 = Defs.m1a2
  Defs.m1a2proc = procM1A2

  -- 一个能转、能按的东西（盖在原模型的件上）：cf 是件的正面（−Z 朝人），样子按 style；spec 给 Interior 的可动部件（B:mov）
  local function control(b, g, cf, K, zh)
    b.ctlN = (b.ctlN or 0) + 1
    local gn = "ctl" .. b.ctlN
    b:group(gn, g, cf)
    local d = K.dia
    local kind, hit
    if K.style == "round" or K.style == "big" then   -- 旋钮：黑色圆柱 + 白色指示线（大的带一圈裙边）
      if K.style == "big" then b:cylZ(gn, 0.006, d * 1.18, CF(0, 0, -0.003), RGB(34, 34, 36), MAT.Metal) end
      b:cylZ(gn, 0.012, d, CF(0, 0, -0.008), C.black, MAT.SmoothPlastic)
      b:box(gn, V(0.0025, d * 0.42, 0.002), CF(0, d * 0.22, -0.0145), C.white)
      kind, hit = "knob", { size = V(d * 1.5, d * 1.5, 0.03), cf = CF(0, 0, -0.01) }
    elseif K.style == "bar" then   -- 选择开关：一根带白线的指针形旋钮
      b:cylZ(gn, 0.006, d * 0.85, CF(0, 0, -0.003), RGB(34, 34, 36), MAT.Metal)
      b:box(gn, V(d * 0.30, d * 1.10, 0.012), CF(0, 0, -0.010), C.black, MAT.SmoothPlastic)
      b:box(gn, V(0.002, d * 0.48, 0.002), CF(0, d * 0.26, -0.0165), C.white)
      kind, hit = "knob", { size = V(d * 1.4, d * 1.4, 0.03), cf = CF(0, 0, -0.01) }
    elseif K.style == "toggle" then   -- 拨动开关：拨杆上下两档
      b:box(gn, V(0.012, 0.012, 0.006), CF(0, 0, -0.003), C.steel, MAT.Metal)
      b:group(gn .. "l", gn, CF(0, 0, -0.006))
      b:tube(gn .. "l", V(0, 0, 0), V(0, 0.010, -0.018), 0.005, C.lgray, MAT.Metal)
      kind, hit = "hinge", { size = V(0.026, 0.034, 0.034), cf = CF(0, 0.002, -0.01) }
    else   -- 按钮：按下去、弹回来
      b:cylZ(gn, 0.006, d * 1.25, CF(0, 0, -0.003), RGB(34, 34, 36), MAT.Metal)
      b:cylZ(gn, 0.008, d, CF(0, 0, -0.008), (K.id == "BSGT" or K.id == "BIT") and RGB(40, 40, 40) or RGB(150, 40, 34), MAT.SmoothPlastic)
      kind, hit = "push", { size = V(d * 1.6, d * 1.6, 0.03), cf = CF(0, 0, -0.008) }
    end
    local mv = b:mov((kind == "hinge") and (gn .. "l") or gn, {
      kind = kind, axis = (kind == "hinge") and V(1, 0, 0) or V(0, 0, 1), step = K.step or 45, n = K.n or 2,
      a0 = 0, a1 = -55, d = 0.004, t = (kind == "push") and 0.08 or 0.12, snd = (kind == "push") and "button" or ((kind == "hinge") and "toggle" or "knob"),
      hit = (kind == "hinge") and { size = hit.size, cf = CF(0, 0.002, -0.004) } or hit,
      label = K.label, on = K.on, sync = K.sync, state = K.state or 0, posNames = zh and K.pos or (K.posEn or K.pos), id = K.id,
    })
    -- 小标签（白底黑字，贴在旋钮下面）
    local tw = math.max(0.03, d * 1.6)
    b:placard(g, tw, 0.008, cf * CF(0, -d * 0.75 - 0.006, -0.0005), zh and K.label[1] or K.label[2], { bg = RGB(222, 222, 214), fg = RGB(20, 20, 20), ppm = 2200 })
    return mv
  end

  -- 炮长目镜、车长延伸目镜的镜片（凸透镜 + 增透膜，B:lens）；目镜朝 +Z（对着坐在后面的人）
  --   炮长目镜：原模型目镜圈正中一个半径 2.6 厘米、深 6 毫米的孔（目镜圈后端面在 PT.gps 前 0.084 格），镜片直径 5 厘米、放在孔底，
  --   凸面正好和端面齐平（原来直径 6 厘米、离端面还有 5 毫米：比孔大、整个凸在外面像个盖子）
  local GPS_LENS = V(0, 0, -0.10)
  local function lenses(b, T, P)
    b:lens(T, CF(P(PT.gps + GPS_LENS)), 0.050, { face = 1, k = 0.26 })
    b:lens(T, CF(P(PT.gpse + V(0, 0, -0.06))), 0.055, { face = 1 })
  end

  -- 一套「供体坐标（格）→ 内饰坐标（米）」的摆法：X(p) 位置，rot 转向（供体里的方向转到内饰里），k 尺寸的倍数
  --   （M1A1 / M1A2 原样 1:1；布雷德利炮塔又小又矮，挪到对应的乘员位上、缩小、有的转个方向）
  local function placer(X, rot, k)
    rot = rot or CF()
    local function cfAt(p, n, up)
      local q = X(p)
      local nn = rot:VectorToWorldSpace(n or V(0, 0, 1))
      local uu = rot:VectorToWorldSpace(up or V(0, 1, 0))
      return CFrame.lookAt(q, q + nn, uu)
    end
    return { X = X, rot = rot, k = k or 1, cf = cfAt }
  end
  -- 目镜旁边面板上的旋钮、拨杆（面板朝 +Z：对着炮长）
  local function knobsBuild(b, T, Pl, list, zh)
    for _, K in ipairs(list) do
      local K2 = K
      if Pl.k ~= 1 then K2 = setmetatable({ dia = K.dia * Pl.k }, { __index = K }) end
      control(b, T, Pl.cf(K.c), K2, zh)
    end
  end
  -- 双握把上的拇指按钮：左手激光回波首 / 末、右手激光测距（gx(p)：供体的点 → 握把组里的位置，米）
  local function palmButtons(b, gx)
    for i, K in ipairs({ { at = PT.palmL, id = "PALML", on = "lrfToggle", label = { "激光回波首 / 末", "LRF FIRST/LAST" } },
      { at = PT.palmR, id = "PALMR", on = "lase", label = { "激光测距", "LASE" } } }) do
      local p = gx(K.at + V(0, 0, 0.03))
      b:group("palm" .. i, "gch", CFrame.lookAt(p, p + V(0, 0, 1)))
      b:cylZ("palm" .. i, 0.008, 0.016, CF(0, 0, -0.004), (i == 2) and RGB(180, 36, 30) or C.black, MAT.SmoothPlastic)
      b:mov("palm" .. i, { kind = "push", axis = V(0, 0, 1), d = 0.004, t = 0.08, snd = "button", hit = { size = V(0.03, 0.03, 0.03), cf = CF(0, 0, -0.006) },
        label = K.label, on = K.on, id = K.id })
    end
  end
  -- 车长两块屏 + 键（原模型的机壳上）：上屏热像（M1A2 SEPv2 的 CITV、布雷德利的 CIV）、下屏战术显示器（蓝军跟踪 / 指挥通信 / 本车状态）；
  --   键排在两屏之间（管上屏：符号、指示、白热 / 黑热、宽 / 窄视场、手动 / 自动扫描、随炮 / 看主瞄准镜）、上屏右边（亮度、扫描扇区左右边、收回）、
  --   下屏右边（本车状态、指挥通信、4 × 4 字母数字键盘）、左下方向键、下屏下边 8 个横杠键（地图、导航、坐标、放大、缩小、叠加、亮度）
  local function cduBuild(b, T, Pl, tag)
    local k = Pl.k
    local function onScr(x, y) return Pl.cf(V(x, y, PT.housingZ + 0.006)) end
    local function scrCF(c) return Pl.cf(V(c.X, c.Y, PT.housingZ - 0.012)) end   -- 显示面在机壳正面后面一点（原模型的屏凹在里面）
    local sUp = b:screen(T, 0.74 / S * k, 0.55 / S * k, scrCF(PT.scrUp), "citv",
      { noBack = true, propShell = true, bezel = 0.006, keys = {}, pickM = 0.12, lightK = 0.3, lightColor = RGB(110, 230, 130), ppm = 1500 })
    local dash = {}
    for i, nm in ipairs({ "MAP", "NAV", "POS", "ZOOM+", "ZOOM-", "OVLY", "BRT+", "BRT-" }) do dash[i] = { nm, (i - 0.5) / 8 } end
    local sLow = b:screen(T, 0.74 / S * k, 0.53 / S * k, scrCF(PT.scrLow), "cid",
      { noBack = true, propShell = true, bezel = 0.006, keys = {}, pickM = 0.16, paper = true, lightK = 0.3, lightColor = RGB(220, 226, 232), ppm = 1500, dash = dash })
    local ROW = { "SYM", "DESIG", "WHT", "BLK", "WFOV", "NFOV", "MAN", "AUTO", "GUN LOS", "GPS LOS" }
    local LED = RGB(70, 255, 110)
    for i, nm in ipairs(ROW) do
      local x = 1.845 + (i - 1) * 0.0775
      b:keyCap(T, sUp, onScr(x, 6.04), 0.066 / S * k, 0.085 / S * k, nm, (i >= 9) and "dark" or "blue", { side = "row", idx = i })
      b:led(T, onScr(x - 0.024, 5.99) * CF(0, 0, -0.005), LED, 0.004, "key", { s = sUp, k = nm })
    end
    for i, nm in ipairs({ "BRT+", "BRT-", "SCAN L", "SCAN R", "STOW" }) do
      b:keyCap(T, sUp, onScr(2.73, 6.72 - (i - 1) * 0.115), 0.20 / S * k, 0.085 / S * k, nm, "blue", { side = "left", idx = i })
    end
    for i, kk in ipairs({ "_PWR", "_SCAN", "_DES" }) do b:led(T, onScr(2.90 + (i - 1) * 0.07, 6.82) * CF(0, 0, -0.004), LED, 0.005, "key", { s = sUp, k = kk }) end
    for i, nm in ipairs({ "VEH SYS", "C3" }) do b:keyCap(T, sLow, onScr(2.69, 5.86 - (i - 1) * 0.115), 0.15 / S * k, 0.085 / S * k, nm, "orange", { side = "left", idx = i }) end
    b:led(T, onScr(2.61, 5.745) * CF(0, 0, -0.004), LED, 0.004, "key", { s = sLow, k = "_MSG" })
    local PAD4 = { { "1", "ABC" }, { "2", "DEF" }, { "3", "GHI" }, { "CLR" }, { "4", "JKL" }, { "5", "MNO" }, { "6", "PQR" }, { "LTR" },
      { "7", "STU" }, { "8", "VWX" }, { "9", "YZ" }, { "NEXT", nil, ">" }, { "." }, { "0" }, { "-" }, { "ENT" } }
    for i, q in ipairs(PAD4) do
      local ci, ri = (i - 1) % 4, math.floor((i - 1) / 4)
      b:keyCap(T, sLow, onScr(2.83 + ci * 0.115, 5.88 - ri * 0.11), 0.098 / S * k, 0.090 / S * k, q[1], "pad", { sub = q[2], text = q[3], side = "pad", idx = i })
    end
    for _, q in ipairs({ { "UP", 0, 0, 1 }, { "DOWN", 180, 0, -1 }, { "LEFT", 270, -1, 0 }, { "RIGHT", 90, 1, 0 } }) do
      b:keyCap(T, sLow, onScr(2.70 + q[3] * 0.075, 5.36 + q[4] * 0.075), 0.07 / S * k, 0.07 / S * k, q[1], "arrow", { dir = q[2], side = "arrow" })
    end
    for i, nm in ipairs({ "MAP", "NAV", "POS", "ZOOM+", "ZOOM-", "OVLY", "BRT+", "BRT-" }) do
      b:keyCap(T, sLow, onScr(1.86 + (i - 1) * 0.0957, 5.255), 0.08 / S * k, 0.06 / S * k, nm, "dash", { side = "bot", idx = i })
    end
    b:led(T, onScr(3.20, 5.25) * CF(0, 0, -0.004), LED, 0.004, "key", { s = sLow, k = "_PWR" })
    b:placard(T, 0.12 * k, 0.014 * k, onScr(2.20, 6.86), tag or "CITV", { bg = RGB(44, 48, 66), fg = C.white })
    return sUp, sLow
  end
  -- 车长操纵握把顶上的两个按钮：指示（猎-歼，炮塔转到热像仪看的方向）、热像仪激光测距并报告敌情（敌人标到全队的地图上）
  local function cchButtons(b, T, Pl)
    for i, K in ipairs({ { at = PT.cchB1, id = "CDES", on = "designate", label = { "指示（猎-歼）", "DESIGNATE" } },
      { at = PT.cchB2, id = "CLASE", on = "citvLase", label = { "车长热像仪激光测距 + 敌情报告", "CITV LASE / SPOT" } } }) do
      b:group("cbtn" .. i, T, Pl.cf(K.at + V(0, 0.02, 0), V(0, 1, 0), V(0, 0, -1)))
      b:cylZ("cbtn" .. i, 0.008, 0.015, CF(0, 0, -0.004), (i == 1) and RGB(190, 40, 32) or C.black, MAT.SmoothPlastic)
      b:mov("cbtn" .. i, { kind = "push", axis = V(0, 0, 1), d = 0.004, t = 0.08, snd = "button", hit = { size = V(0.03, 0.03, 0.03), cf = CF(0, 0, -0.006) },
        label = K.label, on = K.on, id = K.id })
    end
  end

  local function abrams(b, ctx, variant)
    local D = donor("m1a1i")
    if not D or not D.split then return nil end   -- 没导入拆好的新块：照旧零件拼
    local T, G = "turret", "gun"
    local sep = variant == "sep2"
    -- 挖了内腔的原车（用户 11-24：「你的 m1a2 是在车内挖的建模吗」「如果是的话抬头是看得见八边形天窗的」）：重新导入 carve.py 挖过的 m1a2dc.glb 以后
    --   ctx.cav 有值——炮塔、车体的内壁就是原车自己的里面（抬头是 M1A2 那口八边形的指挥塔），M1A1 的炮塔壳不要了，别的件照摆
    local cav = ctx.cav
    local zh = false
    local gpM = (ctx.gpiv or Vector3.zero) / S   -- 炮耳轴（炮塔坐标，米）
    local function P(p) return (p - D.tur) / S end   -- 供体的格 → 炮塔坐标的米（座圈中心对座圈中心，真实尺寸 1:1）
    local function inT(p) return P(p) end
    local function inG(p) return P(p) - gpM end
    local hubM = P(PT.hub)
    -- 原模型的块
    for _, name in ipairs({ "Int_Shell", "Int_Loader", "Int_GpsEye", "Int_GPanel", "Int_GHousing", "Int_GSeat", "Int_Ccp", "Int_Gpse", "Int_Cdu", "Int_Cch", "Int_CBox", "Int_CSeat" }) do
      if not (cav and name == "Int_Shell") then put(b, D, name, T, inT) end   -- 挖了内腔不要 M1A1 的炮塔壳
    end
    b:group("gch", T, CF(hubM))
    put(b, D, "Int_Gch", "gch", function(c) return P(c) - hubM end)
    put(b, D, "Int_Gun", G, inG)
    b:group("recoil", G, CF())
    put(b, D, "Int_Breech", "recoil", inG)
    lenses(b, T, P)

    -- 炮长右手边的计算机：显示窗（A1 计算机控制面板 CCP / SEPv2 炮长控制显示面板 GCDP）、3 × 4 键盘、两排软键
    local W = PT.ccpW
    local function onCcp(du, dv, dw) return P(PT.ccp + PT.ccpU * du + PT.ccpV * dv + W * (dw or 0)) end
    local function ccpCF(p) return CFrame.lookAt(p, p + W, PT.ccpV) end
    local page = sep and "gcdp2" or "ccp"
    local sc = b:screen(T, 0.56 / S, 0.42 / S, ccpCF(onCcp(0, 0.011, 0.016)), page,   -- 贴在原模型显示窗的框前面（框正面在 +0.011 格）
      { noBack = true, propShell = true, bezel = 0.006, keys = {}, pickM = 0.20, lightK = 0.25, lightColor = sep and RGB(110, 230, 130) or RGB(255, 110, 50), ppm = 1700 })
    local PAD = { { "1" }, { "2" }, { "3" }, { "4" }, { "5" }, { "6" }, { "7" }, { "8" }, { "9" }, { "CLR" }, { "0" }, { "ENT" } }
    local padC = PT.pad + W * 0.024
    for i, q in ipairs(PAD) do
      local ci, ri = (i - 1) % 3, math.floor((i - 1) / 3)
      local p = P(padC + PT.ccpU * ((ci - 1) * 0.105) + PT.ccpV * (0.135 - ri * 0.09))
      b:keyCap(T, sc, ccpCF(p), 0.085 / S, 0.068 / S, "CCP " .. q[1], "pad", { text = q[1], side = "pad", idx = i })
    end
    local rowA = sep and { "MAIN", "AMMO", "RANGE", "ADJUST", "LRF" } or { "SABOT", "HEAT", "MPAT", "CAN", "DATA" }
    local rowB = sep and { "WHT/BLK", "3X/10X", "FCS", "BSGT", "MRS" } or { "TEST", "MRS", "BSGT", "FCS", "LRF" }
    local rowC = sep and { "BIT", "RESET" } or { "AMMO", "DAY/TIS" }
    for i, nm in ipairs(rowA) do b:keyCap(T, sc, ccpCF(onCcp((i - 3) * 0.15, -0.29, 0.03)), 0.125 / S, 0.075 / S, nm, sep and "dark" or "orange", { side = "a", idx = i }) end
    for i, nm in ipairs(rowB) do b:keyCap(T, sc, ccpCF(onCcp((i - 3) * 0.15, -0.42, 0.03)), 0.125 / S, 0.075 / S, nm, sep and "dark" or "orange", { side = "b", idx = i }) end
    for i, nm in ipairs(rowC) do b:keyCap(T, sc, ccpCF(onCcp(0.50 + (i - 1) * 0.16, -0.355, 0.03)), 0.135 / S, 0.08 / S, nm, sep and "blue" or "orange", { side = "c", idx = i }) end
    b:placard(T, 0.10, 0.012, ccpCF(onCcp(-0.25, 0.27, 0.03)), sep and "GCDP" or "COMPUTER CONTROL PANEL", { bg = C.black, fg = C.white })

    -- 目镜两边的旋钮、拨杆（每一个都真起作用，见 KNOBS）；目镜下面的小绿灯：热像通道开着
    local Pl = placer(P, CF(), 1)
    knobsBuild(b, T, Pl, KNOBS, zh)
    b:led(T, CF(P(V(2.680, 4.746, -2.633))), RGB(90, 255, 120), 0.009, "tis")
    -- 双握把上的拇指按钮：左手激光回波首 / 末、右手激光测距（握把真车上：掌压开关、右手拇指激光按钮、食指扳机）
    palmButtons(b, function(q) return P(q) - hubM end)

    -- 车长那两块屏
    if sep then
      -- SEPv2：上屏独立热像仪 CITV、下屏战术显示器（蓝军跟踪 / 指挥通信 / 本车状态）——就做在 M1A1 原内饰自己的那台机壳上
      --   （用户 11-24：「m1a1 那个模型不是自带内饰，你直接给原内饰的显示屏加上功能就行了啊」）：屏幕贴在原来两块屏的位置，键盖在原来的键上
      cduBuild(b, T, Pl, "CITV")
      cchButtons(b, T, Pl)
    else
      -- A1：原模型这两块屏的版面（FLIR、PWR、CITV、SGF、CEU、FCEU、CCHA 七格）是车长的状态显示器
      b:screen(T, 0.74 / S, 0.55 / S, Pl.cf(V(PT.scrUp.X, PT.scrUp.Y, PT.housingZ - 0.012)), "m1stat", { noBack = true, propShell = true, bezel = 0.006, lightK = 0.25, lightColor = RGB(120, 150, 220), ppm = 1500 })
      b:screen(T, 0.74 / S, 0.53 / S, Pl.cf(V(PT.scrLow.X, PT.scrLow.Y, PT.housingZ - 0.012)), "m1stat", { noBack = true, propShell = true, bezel = 0.006, lightK = 0.25, lightColor = RGB(120, 150, 220), ppm = 1500 })
    end

    -- 灯：炮塔两盏顶灯、开炮时从观察镜透进来的火光、挨打时的红色告警
    b:light(T, CF(P(V(-1.40, 6.70, 0.40))), "dome", RGB(255, 244, 228), 3.4, 1.1)
    b:light(T, CF(P(V(1.60, 6.60, -1.30))), "dome", RGB(255, 244, 228), 3.0, 1.0)
    b:light(T, CF(P(V(1.30, 6.90, 0.50))), "flash", RGB(255, 196, 120), 4.0, 0)
    b:light(T, CF(P(V(0.40, 5.60, -1.40))), "warn", RGB(255, 40, 30), 3.0, 0)

    -- 乘员位（坦克锁在炮长位：Interior 按 lock 锁；车长的主观瞄挪到炮长位的 T）
    local gEye = P(V(1.653, 5.330, -1.720))
    local cEye = P(V(1.352, 6.150, cav and 0.750 or 0.300))   -- 挖了内腔：往后挪到指挥塔底下（抬头就是八边形的井）
    if cav and sep then
      -- 车长指挥塔：原模型自带一圈八块观察镜（用户 11-24：「我记得 m1a2 模型自带八边形镜子啊，你只需要把那个镜子的玻璃做透明然后抬头能看见就行了」）——
      --   carve.json 的 glass 把它们拆成透明的 Glass 块、后面的内壁挖开；关着的舱盖、镜子靠里那层挪进 Inside（坐进车里藏起来）。这里只补一盏小灯
      b:light(T, CF(0.50, 0.90, 0.80), "dome", RGB(255, 244, 228), 0.9, 0.5)
    end
    local lEye = P(V(-1.720, 6.200, 0.400))
    local gas = PT.gasEnd
    local stations = {
      gunner = { g = T, eye = gEye, look = V(0.05, -0.22, -1), yaw = 125, up = 50, down = 62, crew = "gunner", sight = true, scope = P(PT.gps),
        optics = { primary = { kind = "gps" },
          alt = { kind = "gas", name = "GAS  M920  8X", g = G, pos = inG(gas + V(0, 0, 0.05)), dir = "gun", fovs = { 8.5 }, ret = "gas", look = "day", shape = "circle", useSight = true } } },
      commander = { g = T, eye = cEye, look = V(0.05, -0.30, -1), yaw = 160, up = 70, down = 70, crew = "commander", scope = P(PT.gpse),
        optics = sep and { primary = { kind = "citv", name = "CITV  2ND GEN FLIR", g = T, pos = V(-0.45, 1.05, -0.75), dir = "citv", fovs = { 23.3, 11.7, 5.4, 2.8, 1.4 },
          ret = "citv", look = "whot", shape = "rect" }, alt = { kind = "gps" } } or { primary = { kind = "gps" } } },
      loader = { g = T, eye = lEye, look = V(0.45, -0.20, -1), yaw = 170, up = 70, down = 75, crew = "loader",
        optics = { primary = { kind = "lscope", name = "LOADER'S PERISCOPE", g = T, pos = V(-0.62, 0.92, -0.12), dir = "free360", fovs = { 38 }, ret = "none", look = "day", shape = "slot" } } },
    }
    -- 驾驶员位（用户 11-24：「为什么给我默认炮长位控不了，我要能开别的位置」）：挖了内腔的 A2 才有——车体内腔就是驾驶舱
    --   （挖出来的驾驶舱很矮：顶在座圈下 0.31～0.45 米、地板 0.91～1.06 米、两边墙 ±0.66 米，驾驶员半躺）；M1A1 原模型只做了炮塔里面，A1 没有驾驶员位
    local order = { "gunner", "commander", "loader" }
    local driverCrew = nil
    if cav then
      local H = "hull"
      local eyeD = V(0, -0.46, -1.85)
      -- 驾驶员小人（E 11-24）：半躺在座椅上，两手握 T 形操纵把两头，脚踩刹车踏板那一片
      driverCrew = { dress = "tank_us", g = H, eye = eyeD, lean = 34, yaw = 0, look = V(0, 0.1, -1),
        hands = { l = { "tbar", V(-0.25, 0, 0) }, r = { "tbar", V(0.25, 0, 0) } },
        feet = { l = { H, V(-0.12, -0.88, -2.92) }, r = { H, V(0.10, -0.88, -2.90) } } }
      local function lookAt(p, at) return CFrame.lookAt(p, at) end
      -- 三具潜望镜（前面一具正对，两边各斜 32°）、正前方驾驶员视觉增强器 DVE 的显示器
      for i = -1, 1 do
        local a = rad(i * 32)
        local q = V(math.sin(a) * 0.22, -0.40, -2.05 - math.cos(a) * 0.05)
        b:periscope(H, lookAt(q, q + V(math.sin(a), 0, -math.cos(a))), 0.17, 0.07, 0.08, { model = true })
      end
      b:screen(H, 0.16, 0.12, lookAt(V(0, -0.50, -2.16), eyeD), "dve", { lightColor = RGB(200, 200, 200), lightK = 0.25 })
      -- 半躺的座椅、T 形操纵把（两端拧把油门、中间换挡，跟着转向转）、刹车踏板
      b:seat(H, CF(0, -0.86, -2.22) * ANG(rad(6), 0, 0), { w = 0.44, d = 0.40, back = 0.55, recline = 40, head = true, col = RGB(52, 50, 44) })
      b:group("tbar", H, CF(0, -0.60, -2.62))
      b:tube("tbar", V(-0.24, 0, 0), V(0.24, 0, 0), 0.035, C.dark, MAT.Metal)
      b:cyl("tbar", 0.11, 0.05, CF(-0.25, 0, 0), C.rubber, MAT.Fabric)
      b:cyl("tbar", 0.11, 0.05, CF(0.25, 0, 0), C.rubber, MAT.Fabric)
      b:box("tbar", V(0.10, 0.06, 0.08), CF(0, 0.02, 0), C.black)
      b:box("tbar", V(0.03, 0.08, 0.03), CF(0.04, 0.07, 0), RGB(200, 40, 30))   -- 换挡杆
      b:tube(H, V(0, -0.60, -2.62), V(0, -0.90, -2.80), 0.06, C.gray, MAT.Metal)
      b:box(H, V(0.18, 0.04, 0.12), CF(0.10, -0.90, -2.85) * ANG(rad(-25), 0, 0), C.dark, MAT.DiamondPlate)
      -- 驾驶员综合显示器 DID（左前）：主菜单、状态、告警、导航、维护；起动、熄火、战术怠速、灯检、确认告警
      b:screen(H, 0.18, 0.135, lookAt(V(-0.36, -0.58, -2.36), eyeD), "did",
        { keys = { top = { "MAIN MENU", "STATUS", "W/C/A", "NAV", "MAINT" }, bottom = { "PUSH TO START", "SHUT OFF", "TAC IDLE", "LAMP TEST", "ALARM ACK" } }, lightK = 0.3 })
      -- 灭火瓶（哈龙，驾驶员后面两瓶）、顶灯
      b:extinguisher(H, CF(-0.40, -0.78, -1.30), 0.45, 0.14)
      b:extinguisher(H, CF(0.40, -0.78, -1.30), 0.45, 0.14)
      b:light(H, CF(0, -0.42, -1.55), "dome", RGB(255, 240, 220), 2.4, 0.9)
      stations.driver = { g = H, eye = eyeD, look = V(0, 0.10, -1), yaw = 110, up = 30, down = 55, crew = "driver",
        optics = { primary = { kind = "dve", name = "DVE  AN/VAS-5", g = H, pos = V(0, 0.06, -2.25), dir = "hull", fovs = { 40 }, ret = "dve", look = "bhot", shape = "rect" },
          alt = { kind = "rear", name = "RVSS  REAR", g = H, pos = V(1.25, 0.10, 3.45), dir = "rear", fovs = { 52 }, ret = "rear", look = "whot", shape = "rect" } } }
      order = { "driver", "gunner", "commander", "loader" }
    end
    -- 坐在车里时外模型里伸进乘员舱的块不画（Interior 的 extHide）：炮塔壳的框（炮塔坐标，格）往里收 0.3 格
    local sh = D.parts.Int_Shell.p
    local box = { c = v3(sh.c) - D.tur, s = v3(sh.s) - V(0.6, 0.6, 0.6) }
    return {
      gunK = 0.305,   -- M256 后坐行程
      loader = "m256",
      modelInt = true, carved = true, crewBox = box,
      stations = stations,
      order = order,
      lock = "gunner",   -- 一进车默认炮长位，F2 驾驶员（挖了内腔才有）、F3 炮长、F4 车长、F5 装填手
      -- 乘员小人（E 11-24；用户：「坦克要有精细的 roblox 人物有不同的动画来负责干不同的活 玩家第一人称就是负责扮演炮手视角」）：
      --   位置按上面各乘员位的眼位、原模型的座椅 / 握把量的（供体格 → 炮塔米：P）；炮塔地板约 −1.12 米、车长脚踏约 −0.42 米。
      --   玩家坐哪个位置那个小人不画（Interior.lua stepCrew）；装填手的装填动作（Interior.lua，M256）按他自己的眼位平移
      crew = {
        gunner = { dress = "tank_us", g = "turret", eye = gEye + V(0, -0.02, 0.02), lean = -24, yaw = 0, look = V(0, -0.12, -1),
          hands = { l = { "gch", V(-0.14, 0.12, 0) }, r = { "gch", V(0.14, 0.12, 0) } },
          feet = { l = { "turret", V(gEye.X - 0.12, -0.98, gEye.Z - 0.55) }, r = { "turret", V(gEye.X + 0.10, -0.98, gEye.Z - 0.52) } } },
        commander = { dress = "tank_us", g = "turret", eye = cEye, lean = -10, yaw = 0, look = V(0, -0.30, -1),
          hands = { l = { "turret", cEye + V(-0.12, -0.42, -0.42) }, r = { "turret", P(PT.cch) + V(0, 0.08, 0) } },
          feet = { l = { "turret", V(cEye.X - 0.12, -0.42, cEye.Z - 0.25) }, r = { "turret", V(cEye.X + 0.10, -0.42, cEye.Z - 0.25) } } },
        loader = { dress = "tank_us", g = "turret", eye = lEye, lean = -6, yaw = -28, look = V(0.5, -0.25, -1), stand = true,
          hands = { l = { "turret", lEye + V(0.38, -0.48, -0.40) }, r = nil },
          feet = { l = { "turret", V(lEye.X - 0.14, -1.12, lEye.Z + 0.05) }, r = { "turret", V(lEye.X + 0.14, -1.12, lEye.Z + 0.10) } } },
        driver = driverCrew,
      },
      abrams = variant,
    }
  end

  ---------------------------------------------------------------- 布雷德利（M2A3）：借炮长 / 车长位那几件
  -- 炮塔又小又矮（座圈上面只有半米多净高）、炮长在左、车长在右、中间是 25 毫米炮的炮尾——M1A1 的件挪到对应的乘员位上、缩小，目镜旁的面板转过来贴在左边炮塔壁上；
  --   旋钮按布雷德利的功能分（炮长的综合瞄准具 IBAS 控制：视野、极性、视场、增益、电平、分划 / 符号亮度；射速 高速 / 低速 / 单发、武器选择 25 毫米炮 / 并列机枪、
  --   武器总开关、稳定器、分划照明）；车长两块屏是独立热像观察仪 CIV + 战术显示器（同 SEPv2 那套键），握把上指示、CIV 激光测距 + 敌情报告
  local function byId(id) for _, K in ipairs(KNOBS) do if K.id == id then return K end end end
  local IFV_PANEL = { byId("RETICLE"), byId("SYMB"), byId("GAIN"), byId("LEVEL"), byId("POL"), byId("FOV"), byId("VIS"),
    { id = "ROF", c = V(2.252, 5.507, -2.639), dia = 0.040, style = "bar", n = 3, step = 45, on = "rof", sync = "rof",
      label = { "射速选择", "RATE SELECT" }, pos = { "高速（每分 200 发）", "低速（每分 100 发）", "单发" }, posEn = { "HI 200", "LO 100", "SS" } },
    { id = "WPN", c = V(2.254, 5.244, -2.612), dia = 0.034, style = "round", n = 2, step = 60, on = "weapon", sync = "wpn",
      label = { "武器选择", "WEAPON SELECT" }, pos = { "25 毫米炮", "并列机枪" }, posEn = { "25MM", "COAX" } } }
  local IFV_EYE = { byId("STAB"), byId("RETN"),
    { id = "ARMG", c = V(1.622, 4.392, -2.639), dia = 0.040, style = "bar", n = 2, step = 60, on = "armGun", sync = "armg",
      label = { "武器总开关", "ARM / SAFE" }, pos = { "待发", "保险" }, posEn = { "ARM", "SAFE" } } }
  -- geo：InteriorAFV 步战车炮塔的尺寸和乘员位（米）：gs 炮长在哪边（−1 左）、gx、gEye、cxp、cEye、TH 炮塔净高、tw 炮塔半宽；
  --   返回 { gScope 炮长目镜, cScope 车长目镜 }（乘员位用），没导入拆好的 m1a1i 返回 nil（照旧零件拼）
  function Defs.donorIfv(b, ctx, geo)
    local D = donor("m1a1i")
    if not D or not D.split then return nil end
    local T = "turret"
    local gs = geo.gs or -1
    local function mapper(from, to, rot, k)
      rot = rot or CF()
      return function(p) return to + rot:VectorToWorldSpace((p - from) / S * k) end
    end
    local function putM(name, g, X, rot, k, base)
      local it = D.parts[name]
      if not it then return end
      b:mesh(g, it.src, v3(it.p.s) * k / S, CF(X(v3(it.p.c)) - (base or Vector3.zero)) * (rot or CF()))
    end
    -- 炮长：目镜对着炮长的眼睛（缩到 0.75：顶上那块高面板不顶出炮塔）
    local kG = 0.75
    local gScope = V(geo.gx, geo.TH - 0.23, geo.gEye.Z - 0.14)
    local XG = mapper(PT.gps, gScope, CF(), kG)
    putM("Int_GpsEye", T, XG, CF(), kG)
    putM("Int_GSeat", T, mapper(V(1.46, 2.64, -1.49), V(geo.gx, geo.gEye.Y - 0.80, geo.gEye.Z + 0.10), CF(), 0.8), CF(), 0.8)
    local hub = XG(PT.hub)
    b:group("gch", T, CF(hub))
    putM("Int_Gch", "gch", XG, CF(), kG, hub)
    b:lens(T, CF(XG(PT.gps + GPS_LENS)), 0.050 * kG, { face = 1, k = 0.26 })
    knobsBuild(b, T, placer(XG, CF(), kG), IFV_EYE, false)
    palmButtons(b, function(q) return XG(q) - hub end)
    -- 目镜旁的控制面板：转 90° 贴在炮长外侧的炮塔壁上，面朝炮长
    local rotP = ANG(0, (gs < 0) and PI / 2 or -PI / 2, 0)
    local panC = v3(D.parts.Int_GPanel.p.c)
    local XP = mapper(panC, V(gs * (geo.tw - 0.10), math.min(0.20, geo.TH - 0.30), geo.gEye.Z - 0.12), rotP, kG)
    putM("Int_GPanel", T, XP, rotP, kG)
    knobsBuild(b, T, placer(XP, rotP, kG), IFV_PANEL, false)
    b:led(T, CF(XP(V(2.680, 4.746, -2.633))), RGB(90, 255, 120), 0.007, "tis")
    -- 炮长的综合瞄准具显示器（用户 11-24 发来的 M3 车内截图：目镜右下一块四周一圈方键的显示器，绿色热像、括号分划）：
    --   夹在目镜和炮尾护栏之间（护栏已经收窄到 25 毫米炮的宽度），正对炮长的眼睛；上下两排键是屏幕自带的，左右各三个方键
    local eyeG = gScope + V(0, 0.06, 0.26)
    local dp = V(gScope.X - gs * 0.16, gScope.Y - 0.068, gScope.Z - 0.11)   -- 左边离目镜块、右边离护栏都留几毫米
    local dcf = CFrame.lookAt(dp, eyeG)
    local IW, IH, IB = 0.13, 0.10, 0.018
    local ibas = b:screen(T, IW, IH, dcf, "ibas", { keys = { top = { "FOV", "POL", "GAIN", "LVL", "SYM" }, bottom = { "TIS", "LRF", "F/L", "RET", "TEST" } },
      bezel = IB, lightK = 0.25, lightColor = RGB(110, 230, 130) })
    for i, nm in ipairs({ "ROF", "WPN", "ARM" }) do   -- 人看过去的左边是屏幕的 +X
      b:keyCap(T, ibas, dcf * CF(IW / 2 + IB * 0.6, 0.03 - (i - 1) * 0.03, -0.004), 0.014, 0.014, nm, "dark", { side = "left", idx = i })
    end
    for i, nm in ipairs({ "BSGT", "STAB", "BRT" }) do
      b:keyCap(T, ibas, dcf * CF(-(IW / 2 + IB * 0.6), 0.03 - (i - 1) * 0.03, -0.004), 0.014, 0.014, nm, "dark", { side = "right", idx = i })
    end
    -- 车长：延伸目镜（看炮长综合瞄准具的画面）
    --   人（连目镜、座椅）往炮那边挪 6 厘米：右前方给两块屏的机壳腾地方，不然机壳贴着炮塔壁也躲不开目镜的护额垫
    local kC = 0.8
    local cx = geo.cxp + gs * 0.06
    local cScope = V(cx, geo.TH - 0.20, geo.cEye.Z - 0.14)
    local XC = mapper(PT.gpse, cScope, CF(), kC)
    putM("Int_Gpse", T, XC, CF(), kC)
    b:lens(T, CF(XC(PT.gpse + V(0, 0, -0.06))), 0.055 * kC, { face = 1 })
    -- 延伸目镜两边（用户 11-24 的 M3 截图）：右边一个圆表盘，左边一块小面板——两个红灯（电源、热像），两个旋钮（视野选择、极性，跟炮长那边同步）
    local gpE = XC(PT.gpse)
    local dialC = gpE + V(0.115, -0.025, -0.06)
    b:cylZ(T, 0.03, 0.078, CF(dialC), RGB(30, 32, 34), MAT.Metal)
    b:cylZ(T, 0.004, 0.062, CF(dialC + V(0, 0, 0.016)), RGB(10, 12, 12), MAT.Glass)
    b:box(T, V(0.003, 0.026, 0.002), CF(dialC + V(0, 0.005, 0.019)) * ANG(0, 0, rad(-35)), RGB(232, 232, 226))
    local pc = gpE + V(-0.125, -0.03, -0.06)
    b:box(T, V(0.07, 0.09, 0.022), CF(pc), RGB(34, 36, 36), MAT.SmoothPlastic)
    b:led(T, CF(pc + V(-0.016, 0.03, 0.012)), RGB(255, 40, 30), 0.008)
    b:led(T, CF(pc + V(0.016, 0.03, 0.012)), RGB(255, 40, 30), 0.008, "tis")
    for i, K in ipairs({
      { id = "CVIS", dia = 0.024, style = "round", n = 2, step = 60, on = "thermalSet", sync = "vis", label = { "延伸目镜：视野选择", "SIGHT EXT  DAY / TIS" }, pos = { "昼光", "热像" }, posEn = { "DAY", "TIS" } },
      { id = "CPOL", dia = 0.024, style = "bar", n = 2, step = 60, on = "polaritySet", sync = "pol", label = { "延伸目镜：极性", "SIGHT EXT  POLARITY" }, pos = { "白热", "黑热" }, posEn = { "WHT", "BLK" } } }) do
      local kp = pc + V((i == 1) and -0.016 or 0.016, -0.012, 0.011)
      control(b, T, CFrame.lookAt(kp, kp + V(0, 0, 1)), K, false)
    end
    -- 两块屏的机壳：车长右前方（看过去偏右 52°）、比眼睛略低，转过来对着车长——
    --   延伸目镜就在眼前（护额垫左右各挡 ~23°），机壳放在它正后面会把上面那块 CIV 屏挡掉；屏的左边要在 ~30° 以外；外边贴着炮塔壁（壁内面 tw − 0.02）
    local cE = cScope + V(0, 0.05, 0.24)   -- 车长位的眼睛（InteriorAFV 的 stations.commander.eye）
    local kD = 0.52
    local aD, rD = rad(52), 0.34
    local lim = geo.tw - 0.19
    local dc = V(math.clamp(cE.X - gs * rD * math.sin(aD), -lim, lim), cE.Y - 0.05, cE.Z - rD * math.cos(aD))
    local rotD = ANG(0, math.atan2(cE.X - dc.X, cE.Z - dc.Z), 0)
    local XD = mapper(v3(D.parts.Int_Cdu.p.c), dc, rotD, kD)
    putM("Int_Cdu", T, XD, rotD, kD)
    cduBuild(b, T, placer(XD, rotD, kD), "CIV")
    -- 车长操纵握把（右手边，机壳底下）、座椅
    local kH = 0.72
    local XH = mapper(PT.cch, V(-gs * (geo.tw - 0.20), geo.cEye.Y - 0.48, geo.cEye.Z + 0.02), CF(), kH)
    putM("Int_Cch", T, XH, CF(), kH)
    cchButtons(b, T, placer(XH, CF(), kH))
    putM("Int_CSeat", T, mapper(V(1.46, 4.03, 1.05), V(cx, geo.cEye.Y - 0.78, geo.cEye.Z + 0.12), CF(), 0.8), CF(), 0.8)
    return { gScope = gScope, cScope = cScope }
  end

  Defs.m1a1 = function(b, ctx) return abrams(b, ctx, "a1") or procM1A2(b, ctx) end
  Defs.m1a2 = function(b, ctx) return abrams(b, ctx, "sep2") or procM1A2(b, ctx) end
  Defs.donor, Defs.donorPut, Defs.donorPT, Defs.donorControl, Defs.donorKnobs = donor, put, PT, control, KNOBS
end
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="231">
          <Properties>
            <string name="Name">InteriorCav</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——从原车模型挖出来的内腔（tools/models/carve.py 写的 ReplicatedStorage.CavityMeta）给内饰代码查：
--   用户 11-23：「改成在原车内部雕刻出来内饰」「这样各种载具的从外面可以看得见的窗户跟内部的内饰就能对得上了」
--   Cav.get(模型键, 座圈中心 piv（格）) → 查询对象，坐标是内饰用的米（相对座圈中心，X 右、Y 上、−Z 朝前），跟 InteriorDefs 一样：
--     q:floor(x, z) / q:roof(x, z)    这一点正下方的内腔地板、正上方的内腔顶（米；这一列没有内腔返回 nil）
--     q:space(名字)                   只查某一个空间（"Hull" 车体 / "Tur" 炮塔 / "Cab" 驾驶室……）
--     q:walls(z, y)                   这个前后位置、这个高度上内腔左右两边的墙（x 最小、最大，米）
--     q.win                           窗户：{ c 中心, n 朝外, up, w 宽, h 高 }（米、相对座圈中心）
--     q.anchors                       carve.json 里点的乘员位（眼位、座椅……，米）
--     q.ring                          座圈半径（米）
local RS = game:GetService("ReplicatedStorage")
local S = 2.8

local Cav = {}
local META = nil
local function meta()
  if META == nil then
    local m = RS:FindFirstChild("CavityMeta")
    local ok, r = pcall(function() return m and require(m) end)
    META = (ok and type(r) == "table") and r or false
  end
  return META or nil
end

local B64 = {}
do
  local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
  for i = 1, 64 do B64[string.byte(chars, i)] = i - 1 end
end
local function unb64(s)
  local out, n = table.create(#s * 3 // 4), 0
  for i = 1, #s, 4 do
    local a, b, c, d = string.byte(s, i, i + 3)
    local x = B64[a] * 262144 + B64[b] * 4096 + (B64[c] or 0) * 64 + (B64[d] or 0)
    out[n + 1] = x // 65536 % 256
    out[n + 2] = x // 256 % 256
    out[n + 3] = x % 256
    n += 3
  end
  local pad = (string.sub(s, -2) == "==") and 2 or ((string.sub(s, -1) == "=") and 1 or 0)
  return out, n - pad
end

-- 一张高度表解成两张数组（格；没有内腔 = nil）
local function decode(hm)
  local lo, nlo = unb64(hm.lo)
  local hi = unb64(hm.hi)
  local n = hm.nx * hm.nz
  local L, H = table.create(n), table.create(n)
  local span = hm.y1 - hm.y0
  for i = 0, math.min(n, nlo // 2) - 1 do
    local a = lo[i * 2 + 1] + lo[i * 2 + 2] * 256
    local b = hi[i * 2 + 1] + hi[i * 2 + 2] * 256
    if a ~= 65535 then
      L[i + 1] = hm.y0 + span * a / 65534
      H[i + 1] = hm.y0 + span * b / 65534
    end
  end
  return { x0 = hm.x0, z0 = hm.z0, d = hm.d, nx = hm.nx, nz = hm.nz, L = L, H = H }
end

local cache = {}
local Q = {}
Q.__index = Q

-- 格坐标里查一列（最近的那列）
local function col(t, X, Z)
  local i = math.floor((X - t.x0) / t.d + 0.5)
  local k = math.floor((Z - t.z0) / t.d + 0.5)
  if i < 0 or k < 0 or i >= t.nx or k >= t.nz then return nil, nil end
  local j = i * t.nz + k + 1
  return t.L[j], t.H[j]
end

function Q:_cols(x, z)
  local X, Z = self.piv.X + x * S, self.piv.Z + z * S
  local bl, bh = nil, nil
  for _, t in ipairs(self.list) do
    local l, h = col(t, X, Z)
    if l then
      bl = bl and math.min(bl, l) or l
      bh = bh and math.max(bh, h) or h
    end
  end
  return bl, bh
end
function Q:floor(x, z)
  local l = self:_cols(x, z)
  return l and (l - self.piv.Y) / S or nil
end
function Q:roof(x, z)
  local _, h = self:_cols(x, z)
  return h and (h - self.piv.Y) / S or nil
end
-- 这个前后位置、这个高度上的内腔左右边（米）：按列扫
function Q:walls(z, y)
  local Y = self.piv.Y + y * S
  local Z = self.piv.Z + z * S
  local xmin, xmax = nil, nil
  for _, t in ipairs(self.list) do
    for i = 0, t.nx - 1 do
      local X = t.x0 + i * t.d
      local l, h = col(t, X, Z)
      if l and l <= Y and h >= Y then
        local xm = (X - self.piv.X) / S
        xmin = xmin and math.min(xmin, xm) or xm
        xmax = xmax and math.max(xmax, xm) or xm
      end
    end
  end
  return xmin, xmax
end
function Q:space(name)
  local t = self.byName[name]
  if not t then return nil end
  return setmetatable({ piv = self.piv, list = { t }, byName = self.byName, win = self.win, anchors = self.anchors, ring = self.ring }, Q)
end

function Cav.get(mkey, piv)
  local M = meta()
  local e = M and M[mkey]
  if not e then return nil end
  local c = cache[mkey]
  if not c then
    c = { byName = {}, list = {} }
    for name, sp in pairs(e.spaces or {}) do
      local t = decode(sp.hm)
      t.g = sp.g
      c.byName[name] = t
      table.insert(c.list, t)
    end
    cache[mkey] = c
  end
  local V = Vector3.new
  local function m(p) return (V(p[1], p[2], p[3]) - piv) / S end
  local win = {}
  for _, w in ipairs(e.win or {}) do
    table.insert(win, { c = m(w.c), n = V(w.n[1], w.n[2], w.n[3]), up = V(w.up[1], w.up[2], w.up[3]), w = w.w / S, h = w.h / S })
  end
  local anchors = {}
  for k, p in pairs(e.anchors or {}) do anchors[k] = m(p) end
  local ring = nil   -- 座圈半径（米；挖的时候座圈开口的半径）
  for _, sp in pairs(e.spaces or {}) do if sp.ring then ring = math.max(ring or 0, sp.ring / S) end end
  return setmetatable({ piv = piv, list = c.list, byName = c.byName, win = win, anchors = anchors, ring = ring }, Q)
end

return Cav
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="232">
          <Properties>
            <string name="Name">InteriorDefs</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——各型载具的内饰（真实布局、真实尺寸，米）。InteriorKit 拼零件，Interior.lua 让它动起来
--   坐标：原点在炮塔座圈中心、座圈平面上；X 右、Y 上、−Z 朝前（同 VehDefs）。组：hull 车体（不随炮塔转）、turret 炮塔、gun 炮耳轴（随炮俯仰）
--   每型返回 { stations 乘员位（镜头）, crew 乘员（姿势）, gunK 炮的后坐（米）, anim 动画用的子组名, lights / screens 由 Kit 记 }
--   资料：公开的照片、视频、剖视图与手册插图（M1A2：TM 9-2350-288 系列插图、美军开放日照片；99A：央视节目和阅兵车内镜头）；
--     看不到的地方按同类车的通常做法补（标了「推测」）
local Kit = require(script.Parent:WaitForChild("InteriorKit"))
local V, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
-- 平显原模型的元数据（tools/weapons/hud.mjs 生成：每块的中心、大小，组合玻璃多大）
local HUDM = nil
do
  local ok, r = pcall(function() return require(game:GetService("ReplicatedStorage"):WaitForChild("HudMeta", 3)) end)
  if ok and type(r) == "table" then HUDM = r end
end
-- M1A2 SEPv2 车长显示单元的版面（tools/weapons/gen_cdus.mjs 生成：机壳网格和这里现做的键、屏幕用同一张表）
local CDUS = require(game:GetService("ReplicatedStorage"):WaitForChild("CdusLayout"))
local RGB = Color3.fromRGB
local MAT = Enum.Material
local C = Kit.C
local rad = math.rad
local PI = math.pi

local Defs = {}

-- 一圈环（按 n 段直板拼，y 平面上、半径 r，宽 w、厚 t）：座圈、观察镜座、炮塔篮栏杆
local function ring(b, g, cx, cy, cz, r, n, w, t, col, mat, a0, a1)
  a0, a1 = a0 or 0, a1 or 2 * PI
  local seg = (a1 - a0) / n
  local len = 2 * r * math.sin(seg / 2) * 1.04
  for i = 0, n - 1 do
    local a = a0 + (i + 0.5) * seg
    b:box(g, V(len, t, w), CF(cx + math.sin(a) * r, cy, cz + math.cos(a) * r) * ANG(0, a, 0), col, mat)
  end
end
Defs.ring = ring

-- 一圈竖着的环（x 平面上，绕 X 轴）：用在舱盖手轮
local function hring(b, g, cf, r, n, t, col, mat)
  local seg = 2 * PI / n
  local len = 2 * r * math.sin(seg / 2) * 1.05
  for i = 0, n - 1 do
    local a = (i + 0.5) * seg
    b:box(g, V(len, t, t), cf * CF(math.cos(a) * r, math.sin(a) * r, 0) * ANG(0, 0, a + PI / 2), col, mat)
  end
end

-- 一圈环（组自己的 XY 平面上，绕 Z 轴）：方向盘的轮缘——Interior.lua 让 swheel 组绕自己的 Z 轴转
local function zring(b, g, r, n, t, col, mat)
  local seg = 2 * PI / n
  local len = 2 * r * math.sin(seg / 2) * 1.05
  for i = 0, n - 1 do
    local a = (i + 0.5) * seg
    b:box(g, V(len, t, t), CF(math.sin(a) * r, math.cos(a) * r, 0) * ANG(0, 0, -a), col, mat)
  end
end

-- 120 毫米 / 125 毫米炮弹（米，弹底朝 +Z 的话 dir = 1）：可燃药筒 + 金属底缘 + 底火；长弹（脱壳穿甲弹）多一截弹芯
local function round120(b, g, cf, opt)
  opt = opt or {}
  -- 真模型：M829A1 整发（Jeyhun1985，CC-BY）——弹底在原点、弹头朝 +Z，这里弹底朝 +Z，转半圈；弹架里的用减面版
  if opt.prop ~= false then
    local list = b:prop(g, opt.lo and "ip_m829lo" or "ip_m829", cf * ANG(0, PI, 0), (opt.len or 0.98) / 0.93)
    if list then return list end
  end
  local L = opt.len or 0.98
  local caseL = L * 0.68
  local base = b:cylZ(g, 0.045, 0.152, cf * CF(0, 0, -0.022), RGB(150, 128, 82), MAT.Metal)   -- 金属底缘（钢 / 黄铜色）
  b:cylZ(g, 0.004, 0.03, cf * CF(0, 0, 0.001), RGB(176, 150, 92), MAT.Metal)                 -- 底火
  local case = b:cylZ(g, caseL, 0.13, cf * CF(0, 0, -0.045 - caseL / 2), opt.caseCol or RGB(176, 160, 118), MAT.SmoothPlastic)   -- 可燃药筒
  local tip
  if opt.sabot ~= false then
    tip = b:cylZ(g, L - caseL - 0.045, 0.11, cf * CF(0, 0, -0.045 - caseL - (L - caseL - 0.045) / 2), opt.tipCol or RGB(42, 42, 40), MAT.Metal)
  end
  return { base, case, tip }
end
Defs.round120 = round120

---------------------------------------------------------------- M1A2 SEPv2（艾布拉姆斯）
-- 美国陆军 M1A2 SEPv2（用户 11-23：「我这个 M1A2 是 SEPv2」）：四人车组。驾驶员在车体前部中间，扣上舱盖时半躺（三具潜望镜 + 驾驶员视觉增强器 DVE）；
--   炮塔里炮长在右前（主瞄准镜 GPS 的目镜和护额垫、"凯迪拉克" 双握把 GCH、炮长控制显示面板 GCDP、辅助瞄准镜 GAS），
--   车长在右后高位（八边形、八具观察镜的指挥塔、独立热像仪 CITV 的显示器、指挥综合显示器 CID / 联合作战指挥平台 JBC-P、车长操纵握把 CCH、
--   主瞄准镜延伸目镜 GPSE、CROWS-LP 遥控武器站的屏幕和握把），装填手在左（折叠座椅、装填手潜望镜、电台、膝动开门开关）；
--   炮塔尾舱用装甲滑门隔开，左右各 18 发待发弹（弹底朝乘员舱），M256 120 毫米炮立楔式炮闩、后坐 0.305 米，右边并列 M240 机枪
local WHITE = RGB(226, 226, 218)   -- 艾布拉姆斯车内是白漆
local WHITE2 = RGB(206, 206, 198)
local FLOOR = RGB(56, 58, 56)
local OD = RGB(84, 90, 66)
local GBOX = RGB(64, 68, 62)

-- 真模型显示器的版面（用户 11-22 发来 M1A2 车长位照片：「图片里摇杆、计算机、屏幕……识别到了就去 Sketchfab 找类似的」「差不多的可以自己改一下」）：
--   器材坐标（格，+Z 正面、人看过去 +X 在右手边，tools/weapons/optics.json 的 ip_* 件），量的是带贴图的正视图；
--   c 玻璃中心、w / h 玻璃宽高、kz 键帽正面、keys.top / keys.bottom：屏幕的两组键各盖在哪几个原模型的实体键上（{ x, y, 宽, 高 [, 键帽正面 z] }）
local PSCR = {
  -- 带边键的显示控制单元（左右各 5 个边键，下面整块键盘）：车长热像仪显示器、炮长控制显示面板——照片里车长面前那块左边一排背光键的显示器
  ip_cdu = { c = { 0, 0, 0 }, w = 0.232, h = 0.336, kz = 0.004, keys = {
    top = { { -0.164, 0.0763, 0.044, 0.024 }, { -0.164, 0.0356, 0.044, 0.024 }, { -0.164, -0.0052, 0.044, 0.024 }, { -0.164, -0.048, 0.044, 0.024 }, { -0.164, -0.0874, 0.044, 0.024 } },
    bottom = { { 0.163, 0.0763, 0.044, 0.024 }, { 0.163, 0.0356, 0.044, 0.024 }, { 0.163, -0.0052, 0.044, 0.024 }, { 0.163, -0.048, 0.044, 0.024 }, { 0.163, -0.0874, 0.044, 0.024 } } } },
  -- 加固战术显示终端（沙色，左边 Menu / Mode / Lock / Enter / Rec 五个键，右边 Fire / Comm / Back 三个键和两个旋钮）：现在没用上（留着给别的车）
  ip_tab = { c = { -0.001, -0.048, 0.042 }, w = 0.484, h = 0.342, kz = 0.063, keys = {
    top = { { -0.338, -0.124, 0.034, 0.024 }, { -0.291, -0.124, 0.034, 0.024 }, { -0.338, -0.161, 0.034, 0.024 }, { -0.291, -0.161, 0.034, 0.024 }, { -0.291, -0.197, 0.034, 0.024 } },
    bottom = { { 0.286, -0.045, 0.034, 0.024 }, { 0.286, -0.080, 0.034, 0.024 }, { 0.286, -0.118, 0.034, 0.024 }, { 0.2875, -0.180, 0.03, 0.03, 0.095 }, { 0.341, -0.180, 0.03, 0.03, 0.095 } } } },
  -- 带侧键的显示器（两边各一条按键板）：车长的 CROWS 遥控武器站显示器
  ip_mon = { c = { 0, 0.0425, 0.079 }, w = 0.25, h = 0.222, kz = 0.070, keys = {   -- 显像管玻璃是鼓的（中间 0.067、四周的框到 0.077）：显示面贴在最外面
    top = { { -0.1886, 0.152, 0.030, 0.034 }, { -0.1886, 0.102, 0.036, 0.022 }, { -0.1886, 0.076, 0.036, 0.022 }, { -0.1886, 0.0105, 0.036, 0.022 }, { -0.1886, -0.0164, 0.036, 0.022 } },
    bottom = { { 0.188, 0.140, 0.036, 0.022 }, { 0.188, 0.114, 0.036, 0.022 }, { 0.188, 0.088, 0.036, 0.022 }, { 0.188, 0.0616, 0.036, 0.022 }, { 0.188, -0.012, 0.030, 0.034, 0.082 } } } },
}
-- 屏幕：有真模型就用真模型外壳（B:propScreen），还没生成好就照旧画普通屏幕（Interior 等模型好了会重建一次）
local function scr(b, g, key, k, w, h, cf, page, opt)
  local s = b.propScreen and b:propScreen(g, key, cf, k, page, PSCR[key], opt)
  return s or b:screen(g, w, h, cf, page, opt)
end
Defs.PSCR, Defs.scr = PSCR, scr

-- 钢铁猛兽 M1A2 SEP 车长显示单元（用户 11-23 截图「严格按照这个图」、11-24 又发来同一套截图）：机壳网格 ip_cdus + 版面表 CdusLayout 现做的屏幕、键、灯；
--   uCF 是机壳正面中心（−Z 对着车长）；零件拼的 M1A2 和原模型版的 A2（InteriorAbrams）都用它
local function sbCdu(b, T, uCF)
  local LY = CDUS
    local function uAt(x, y, z) return uCF * CF(-x, y, -(z or 0)) end   -- 版面坐标（米，X 人看过去向右、Z 朝人）→ 炮塔里
    if not b:prop(T, "ip_cdus", uCF * ANG(0, PI, 0), 1) then   -- 网格还没生成好：先拼个方壳子、四条框（Interior 等它好了重建一次）
      local U0 = LY.unit
      b:box(T, V(U0.w, U0.h, U0.d), uAt(0, 0, -U0.d / 2), RGB(44, 48, 66))
      for _, Q in ipairs({ LY.up, LY.low }) do
        local fw, fh = (Q.ow - Q.gw) / 2, (Q.oh - Q.gh) / 2
        b:box(T, V(Q.ow, fh, 0.012), uAt(Q.cx, Q.cy + Q.oh / 2 - fh / 2, 0.006), RGB(170, 172, 180), MAT.Metal)
        b:box(T, V(Q.ow, fh, 0.012), uAt(Q.cx, Q.cy - Q.oh / 2 + fh / 2, 0.006), RGB(170, 172, 180), MAT.Metal)
        b:box(T, V(fw, Q.gh, 0.012), uAt(Q.cx - Q.ow / 2 + fw / 2, Q.cy, 0.006), RGB(170, 172, 180), MAT.Metal)
        b:box(T, V(fw, Q.gh, 0.012), uAt(Q.cx + Q.ow / 2 - fw / 2, Q.cy, 0.006), RGB(170, 172, 180), MAT.Metal)
        b:box(T, V(Q.gw, Q.gh, 0.0035), uAt(Q.cx, Q.cy, 0.00175), RGB(7, 8, 10))
      end
    end
    -- 两块屏的显示面：贴在黑玻璃前面 1.5 毫米，比玻璃小一圈（圆角那里不露出方角）
    local zF = LY.zGlass + 0.0015
    local sUp = b:screen(T, LY.up.gw - 0.008, LY.up.gh - 0.008, uAt(LY.up.cx, LY.up.cy, zF), "citv",
      { noBack = true, propShell = true, bezel = 0.006, keys = {}, pickM = 0.07, lightK = 0.3, lightColor = RGB(110, 230, 130) })
    local DASH = { "MAP", "NAV", "POS", "ZOOM+", "ZOOM-", "OVLY", "BRT+", "BRT-" }   -- 下屏下边 8 个橙色横杠键（功能名写在屏幕下沿）
    local lw = LY.low.gw - 0.008
    local dash = {}
    for i, nm in ipairs(DASH) do dash[i] = { nm, (LY.bot.x0 + (i - 1) * LY.bot.dx - (LY.low.cx - lw / 2)) / lw } end
    local sLow = b:screen(T, lw, LY.low.gh - 0.008, uAt(LY.low.cx, LY.low.cy, zF), "cid",
      { noBack = true, propShell = true, bezel = 0.006, keys = {}, pickM = 0.16, paper = true, dash = dash, lightK = 0.3, lightColor = RGB(220, 226, 232) })
    -- 键：键帽正面在键槽上面 4 毫米（键槽顶 1.5 毫米）
    local KZ = 0.0055
    local LED = RGB(70, 255, 110)
    local UPL = { "BRT+", "BRT-", "SCAN L", "SCAN R", "STOW" }   -- 上屏左边一列
    for i, q in ipairs(LY.upL) do b:keyCap(T, sUp, uAt(q[1], q[2], KZ), LY.upLw, LY.upLh, UPL[i], "blue", { side = "left", idx = i }) end
    local ROW = { "SYM", "DESIG", "WHT", "BLK", "WFOV", "NFOV", "MAN", "AUTO", "GUN LOS", "GPS LOS" }   -- 两屏之间一排（管上屏）：单、单、双、双、双、双（最右一对深色）
    for i, q in ipairs(LY.row) do
      b:keyCap(T, sUp, uAt(q[1], LY.rowY, KZ), q[2], LY.rowH, ROW[i], (i >= 9) and "dark" or "blue", { side = "row", idx = i })
      b:led(T, uAt(q[1] - q[2] / 2 + 0.0045, LY.rowY - LY.rowH / 2 + 0.0045, KZ + 0.0008), LED, 0.004, "key", { s = sUp, k = ROW[i] })   -- 键左下角的绿灯：选中的亮
    end
    for i, q in ipairs(LY.leds) do b:led(T, uAt(q[1], q[2], 0.0035), LED, 0.005, "key", { s = sUp, k = ({ "_PWR", "_SCAN", "_DES" })[i] }) end   -- 灯条：电源、自动扫描、指示
    local LOWL = { "VEH SYS", "C3" }   -- 下屏左边：本车状态、消息
    for i, q in ipairs(LY.lowL) do b:keyCap(T, sLow, uAt(q[1], q[2], KZ), LY.lowLw, LY.lowLh, LOWL[i], "orange", { side = "left", idx = i }) end
    b:led(T, uAt(LY.lowL[2][1] - 0.008, LY.lowL[2][2] - 0.011, KZ + 0.0008), LED, 0.004, "key", { s = sLow, k = "_MSG" })
    local A = LY.arrows   -- 左下四个方向键：挪地图
    for _, q in ipairs({ { "UP", 0, 0, 1 }, { "DOWN", 180, 0, -1 }, { "LEFT", 270, -1, 0 }, { "RIGHT", 90, 1, 0 } }) do
      b:keyCap(T, sLow, uAt(A.cx + q[3] * A.d, A.cy + q[4] * A.d, KZ), A.s, A.s, q[1], "arrow", { dir = q[2], side = "arrow" })
    end
    for i, nm in ipairs(DASH) do b:keyCap(T, sLow, uAt(LY.bot.x0 + (i - 1) * LY.bot.dx, LY.bot.y, KZ), LY.bot.w, LY.bot.h, nm, "dash", { side = "bot", idx = i }) end
    -- 字母数字键盘（截图：ABC 1、DEF 2、GHI 3、CLR / JKL 4、MNO 5、PQR 6、LTR / STU 7、VWX 8、YZ 9、▶ / •、0、—、ENT）
    local PAD = { { "1", "ABC" }, { "2", "DEF" }, { "3", "GHI" }, { "CLR" }, { "4", "JKL" }, { "5", "MNO" }, { "6", "PQR" }, { "LTR" },
      { "7", "STU" }, { "8", "VWX" }, { "9", "YZ" }, { "NEXT", nil, ">" }, { "." }, { "0" }, { "-" }, { "ENT" } }
    local KP = LY.pad
    for i, q in ipairs(PAD) do
      local cI, rI = (i - 1) % 4, math.floor((i - 1) / 4)
      b:keyCap(T, sLow, uAt(KP.x0 + cI * KP.dx, KP.y0 + rI * KP.dy, KZ), KP.w, KP.h, q[1], "pad", { sub = q[2], text = q[3], side = "pad", idx = i })
    end
    b:led(T, uAt(LY.ledLow[1], LY.ledLow[2], 0.002), LED, 0.004, "key", { s = sLow, k = "_PWR" })
  return sUp, sLow
end
Defs.sbCdu = sbCdu

function Defs.m1a2(b, ctx)
  local T, H, G = "turret", "hull", "gun"
  local function bx(g, sx, sy, sz, x, y, z, col, mat, rx, ry, rz)
    return b:box(g, V(sx, sy, sz), CF(x, y, z) * ANG(rad(rx or 0), rad(ry or 0), rad(rz or 0)), col, mat)
  end
  local function look(p, at) return CFrame.lookAt(p, at) end
  -- 真模型的拨动开关面板（带护盖的拨杆，ip_sw）：cf 的 −Z 对着人（同 b:panel），没生成好就照旧拼面板
  local function swPanel(g, cf, k, w, h, rows, cols, col, opt)
    if b:prop(g, "ip_sw", cf * ANG(0, PI, 0), k) then return end
    b:panel(g, w, h, cf, rows, cols, col, opt)
  end
  -- 真模型的车内顶灯（防爆灯罩，ip_lamp）：贴在顶上、灯罩朝下（p 是安装面的点）；没生成好就照旧一个小灯盒
  local function domeLamp(g, p, k)
    k = k or 0.9
    if not b:prop(g, "ip_lamp", CF(p) * ANG(rad(90), 0, 0), k) then b:box(g, V(0.14, 0.04, 0.10), CF(p - V(0, 0.02, 0)), C.dark, MAT.Metal) end
    b:led(g, CF(p - V(0, 0.035 * k, 0)), RGB(255, 236, 210), 0.05, "domeLamp")
  end

  ---------------- 车体（不随炮塔转）
  local FY = -1.05   -- 车底地板（座圈平面下 1.05 米）
  bx(H, 1.94, 0.04, 4.40, 0, FY - 0.02, -1.0, FLOOR, MAT.DiamondPlate)                         -- 地板
  for _, s in ipairs({ -1, 1 }) do
    bx(H, 0.04, 0.52, 4.40, s * 0.99, FY + 0.26, -1.0, WHITE2)                                   -- 履带上方的内侧板（侧裙里面是负重轮）
    bx(H, 0.70, 0.04, 2.30, s * 1.33, -0.55, -0.02, WHITE2)                                      -- 侧凸台的平台
    bx(H, 0.04, 0.55, 2.30, s * 1.66, -0.28, -0.02, WHITE2)                                      -- 侧凸台外壁
    -- 侧凸台上的东西（隔着炮塔篮的栏杆看得见）：左边油箱、右边蓄电池和三防装置（推测）
    if s < 0 then
      bx(H, 0.58, 0.46, 1.10, -1.33, -0.30, -0.55, OD)
      bx(H, 0.58, 0.40, 0.90, -1.33, -0.33, 0.62, OD)
      b:placard(H, 0.20, 0.07, CF(-1.03, -0.22, -0.55) * ANG(0, -PI / 2, 0), "FUEL", { bg = RGB(230, 210, 60) })
    else
      for i = 0, 2 do bx(H, 0.34, 0.30, 0.36, 1.30, -0.38, -0.80 + i * 0.42, GBOX) end
      bx(H, 0.56, 0.44, 0.70, 1.33, -0.31, 0.75, RGB(150, 150, 140))
      b:placard(H, 0.18, 0.07, CF(1.03, -0.20, 0.75) * ANG(0, PI / 2, 0), "NBC", { bg = RGB(230, 210, 60) })
    end
  end
  -- 发动机舱隔板（后面是 AGT1500 燃气轮机）
  bx(H, 3.34, 1.05, 0.05, 0, FY + 0.525, 1.18, WHITE2)
  for i = -2, 2 do bx(H, 0.42, 0.05, 0.02, i * 0.5, -0.45, 1.155, C.dark) end   -- 隔板上的通风格栅
  bx(H, 0.70, 0.40, 0.22, 0.55, -0.78, 1.05, RGB(140, 140, 132))                       -- 车体网络盒（推测）
  bx(H, 0.40, 0.30, 0.20, -0.62, -0.83, 1.06, OD)
  b:cable(H, { V(0.55, -0.58, 1.05), V(0.3, -0.4, 1.12), V(-0.4, -0.4, 1.12), V(-0.62, -0.68, 1.08) }, 0.03)
  -- 车顶（座圈外面那一圈，从炮塔篮里抬头偶尔看得见）
  for i = 0, 15 do
    local a = (i + 0.5) * PI / 8
    bx(H, 0.50, 0.04, 0.64, math.sin(a) * 1.36, -0.02, math.cos(a) * 1.36, WHITE2, nil, 0, math.deg(a) + 90, 0)
  end
  -- 座圈（齿圈）
  ring(b, H, 0, -0.05, 0, 1.09, 32, 0.06, 0.08, C.steel, MAT.Metal)
  ring(b, H, 0, -0.10, 0, 1.06, 32, 0.03, 0.03, C.dark, MAT.Metal)

  -- 驾驶舱：两边是前油箱（驾驶员夹在中间），前面是首上装甲的内壁
  local DZ = -1.85   -- 驾驶员头的位置（舱盖下）
  for _, s in ipairs({ -1, 1 }) do
    bx(H, 0.50, 1.00, 2.00, s * 0.75, FY + 0.50, -2.15, OD)                     -- 前油箱
    bx(H, 0.02, 0.80, 1.60, s * 0.495, FY + 0.50, -2.15, RGB(96, 102, 76))
  end
  bx(H, 1.00, 0.05, 1.20, 0, -0.38, -2.75, WHITE2, nil, -32, 0, 0)               -- 首上装甲内壁（斜）
  bx(H, 1.00, 0.70, 0.05, 0, FY + 0.35, -3.22, WHITE2)                           -- 前壁
  bx(H, 1.00, 0.04, 0.28, 0, -0.04, -2.06, WHITE2)                               -- 驾驶舱顶（舱盖前面，挂潜望镜）
  bx(H, 1.00, 0.04, 0.12, 0, -0.04, -1.27, WHITE2)
  for _, s in ipairs({ -1, 1 }) do bx(H, 0.22, 0.04, 0.62, s * 0.39, -0.04, -1.62, WHITE2) end
  -- 舱盖（从里面看：圆盖 + 手柄 + 锁定杆），可抬起转开
  b:group("dhatch", H, CF(0, -0.02, -1.62))
  b:cylY("dhatch", 0.05, 0.58, CF(0, -0.03, 0), WHITE, MAT.SmoothPlastic)
  b:grab("dhatch", V(-0.12, -0.06, 0.05), V(0.12, -0.06, 0.05), V(0, -0.06, 0), 0.02, C.black)
  bx("dhatch", 0.30, 0.03, 0.04, 0.10, -0.07, -0.12, C.red)
  -- 三具潜望镜（前面一具正对，两边各斜 30°）+ 中间下面挂着驾驶员视觉增强器 DVE 的显示器
  local eyeD = V(0, -0.24, DZ)
  for i = -1, 1 do
    local a = rad(i * 32)
    local p = V(math.sin(a) * 0.22, -0.13, DZ - 0.18 - math.cos(a) * 0.06)
    b:periscope(H, look(p, p + V(math.sin(a), 0, -math.cos(a))), 0.17, 0.09, 0.10, { model = true })
  end
  local dve = b:screen(H, 0.16, 0.12, look(V(0, -0.36, DZ - 0.30), eyeD), "dve", { lightColor = RGB(200, 200, 200), lightK = 0.25 })
  bx(H, 0.20, 0.04, 0.10, 0, -0.27, DZ - 0.32, C.black)
  -- 驾驶员座椅（扣盖驾驶：靠背放倒）
  b:seat(H, CF(0, FY + 0.22, -2.28) * ANG(rad(6), 0, 0), { w = 0.44, d = 0.40, back = 0.60, recline = 34, head = true, col = RGB(52, 50, 44) })
  bx(H, 0.30, 0.20, 0.30, 0, FY + 0.10, -2.28, C.gray, MAT.Metal)
  -- T 形操纵把（摩托车式把手：两端拧把油门，中间换挡）、转向柱
  b:group("tbar", H, CF(0, FY + 0.48, -2.72))
  b:tube("tbar", V(-0.26, 0, 0), V(0.26, 0, 0), 0.035, C.dark, MAT.Metal)
  b:cyl("tbar", 0.11, 0.05, CF(-0.27, 0, 0), C.rubber, MAT.Fabric)
  b:cyl("tbar", 0.11, 0.05, CF(0.27, 0, 0), C.rubber, MAT.Fabric)
  bx("tbar", 0.10, 0.06, 0.08, 0, 0.02, 0, C.black)
  bx("tbar", 0.03, 0.08, 0.03, 0.04, 0.07, 0, RGB(200, 40, 30))                 -- 换挡杆
  b:tube(H, V(0, FY + 0.48, -2.72), V(0, FY + 0.05, -2.95), 0.06, C.gray, MAT.Metal)
  bx(H, 0.18, 0.04, 0.12, 0.10, FY + 0.06, -2.95, C.dark, MAT.DiamondPlate, -25, 0, 0)   -- 刹车踏板
  bx(H, 0.14, 0.04, 0.12, -0.12, FY + 0.06, -2.98, C.dark, MAT.DiamondPlate, -25, 0, 0)  -- 搁脚板
  -- 驾驶员综合显示器 DID（左前）+ 主开关面板（左）+ 右边的辅助面板
  b:screen(H, 0.20, 0.15, look(V(-0.33, -0.48, -2.42), eyeD), "did", { keys = { top = { "MAIN MENU", "STATUS", "W/C/A", "NAV", "MAINT" }, bottom = { "PUSH TO START", "SHUT OFF", "TAC IDLE", "LAMP TEST", "ALARM ACK" } }, lightK = 0.3 })
  swPanel(H, look(V(-0.44, -0.66, -2.10), V(0, -0.6, -2.0)), 1.7, 0.16, 0.30, 4, 2, RGB(70, 72, 70), { guard = true })   -- 主开关面板（带护盖的拨杆）
  swPanel(H, look(V(0.44, -0.62, -2.15), V(0, -0.6, -2.05)), 1.4, 0.14, 0.22, 3, 2, RGB(70, 72, 70))
  b:placard(H, 0.10, 0.03, look(V(-0.44, -0.48, -2.10), V(0, -0.48, -2.0)) * CF(0, 0, -0.002), "MASTER", { bg = C.black, fg = C.white })
  -- 灭火瓶（哈龙，驾驶员后面两瓶）
  b:extinguisher(H, CF(-0.36, FY + 0.25, -1.30), 0.48, 0.15)
  b:extinguisher(H, CF(0.36, FY + 0.25, -1.30), 0.48, 0.15)
  b:placard(H, 0.12, 0.05, CF(-0.36, FY + 0.40, -1.22) * ANG(0, PI, 0), "HALON", { bg = C.red, fg = C.white })
  b:light(H, CF(0, -0.10, -1.40), "dome", RGB(255, 240, 220), 2.8, 0.9)
  domeLamp(H, V(0.39, -0.062, -1.48), 0.8)   -- 驾驶舱顶灯（舱盖右边的顶板上）

  ---------------- 炮塔（随炮塔转）
  local RY = 0.80   -- 炮塔顶内表面（座圈平面上 0.8 米）
  -- 炮塔篮：地板、中间的导电滑环、四周栏杆（前面留出去驾驶舱的口子）
  b:cylY(T, 0.03, 1.96, CF(0, FY + 0.06, 0), FLOOR, MAT.DiamondPlate)
  b:cylY(T, 0.22, 0.30, CF(0, FY + 0.18, 0.05), C.dark, MAT.Metal)
  b:cylY(T, 0.06, 0.40, CF(0, FY + 0.32, 0.05), C.steel, MAT.Metal)
  for i = 0, 11 do
    local a = (i + 0.5) * PI / 6
    if not (a > PI * 0.80 and a < PI * 1.20) then   -- 正前方（−Z）留口子
      b:tube(T, V(math.sin(a) * 0.98, FY + 0.06, math.cos(a) * 0.98), V(math.sin(a) * 0.98, -0.36, math.cos(a) * 0.98), 0.03, C.lgray, MAT.Metal)
    end
  end
  ring(b, T, 0, -0.36, 0, 0.98, 12, 0.03, 0.03, C.lgray, MAT.Metal, -PI * 0.80, PI * 0.80)
  ring(b, T, 0, -0.72, 0, 0.98, 12, 0.03, 0.03, C.lgray, MAT.Metal, -PI * 0.80, PI * 0.80)
  -- 炮塔底板（座圈外面到炮塔壁那一圈）
  for i = 0, 15 do
    local a = (i + 0.5) * PI / 8
    bx(T, 0.52, 0.03, 0.60, math.sin(a) * 1.30, 0.0, math.cos(a) * 1.30, WHITE2, nil, 0, math.deg(a) + 90, 0)
  end
  -- 炮塔壁（从里面看：白漆钢板，前角切斜）、前面炮的凹槽、尾舱隔板
  for _, s in ipairs({ -1, 1 }) do
    bx(T, 0.05, RY, 1.86, s * 1.26, RY / 2, 0.17, WHITE)                                      -- 侧壁
    local p0, p1 = V(s * 1.26, 0, -0.76), V(s * 0.46, 0, -1.26)
    local mid = (p0 + p1) / 2
    local len = (p1 - p0).Magnitude
    b:box(T, V(len, RY, 0.05), CF(mid.X, RY / 2, mid.Z) * ANG(0, math.atan2(-(p1.Z - p0.Z), p1.X - p0.X), 0), WHITE)   -- 斜的前角
    bx(T, 0.05, RY, 0.36, s * 0.44, RY / 2, -1.43, WHITE2)                                    -- 炮槽两侧
  end
  bx(T, 0.92, RY, 0.05, 0, RY / 2, -1.62, WHITE2)                                            -- 炮槽前壁（炮从这里穿出去）
  -- 炮塔顶：几块板，留出车长指挥塔、装填手舱盖、炮长主瞄准镜的口子
  -- 车长指挥塔中心（用户 11-23：「把那个八边形观察舱全部往前移」）：原来在 z 0.34，车长眼睛（z 0.02）后面 32 厘米，抬头看到的是天花板、
  --   观察窗都在头顶后面；挪到车长头顶正上方（z −0.02）——抬头 40° 左右前面三块观察窗正好在眼前（同截图）。炮塔顶的开口、座板跟着挪
  local CZ = -0.02
  bx(T, 2.56, 0.05, 0.62, 0, RY + 0.025, 0.86, WHITE)                                        -- 后段
  bx(T, 0.46, 0.05, 0.60, -0.05, RY + 0.025, 0.28, WHITE)                                    -- 中段（两个舱口之间）
  bx(T, 0.34, 0.05, 0.60, 1.11, RY + 0.025, 0.28, WHITE)
  bx(T, 0.34, 0.05, 0.60, -1.11, RY + 0.025, 0.28, WHITE)
  -- 中前段（z −0.52 ～ −0.02）：指挥塔开口（x 0.18 ～ 0.94、z CZ − 0.30 ～ CZ + 0.30）那一块让出来
  bx(T, 1.46, 0.05, 0.50, -0.55, RY + 0.025, -0.27, WHITE)
  bx(T, 0.34, 0.05, 0.50, 1.11, RY + 0.025, -0.27, WHITE)
  bx(T, 0.76, 0.05, 0.20, 0.56, RY + 0.025, -0.42, WHITE)                                    -- 开口前面一条
  bx(T, 0.76, 0.05, 0.30, 0.56, RY + 0.025, 0.43, WHITE)                                     -- 开口后面（原来的开口挪走了，补上）
  bx(T, 1.70, 0.05, 0.78, -0.43, RY + 0.025, -0.91, WHITE)                                   -- 前段（左）
  bx(T, 0.86, 0.05, 0.78, 0.85, RY + 0.025, -0.91, WHITE)                                    -- 前段（右，主瞄准镜从这里穿上去）
  ring(b, T, 0.56, RY + 0.035, CZ, 0.50, 16, 0.24, 0.03, WHITE2)                             -- 指挥塔、装填手舱口四周的座板（盖住方口子的四个角；指挥塔这圈让开八边形的壁）
  ring(b, T, -0.62, RY + 0.035, 0.28, 0.42, 16, 0.22, 0.03, WHITE2)
  bx(T, 0.92, 0.05, 0.38, 0, RY + 0.025, -1.43, WHITE)                                       -- 炮槽顶
  -- 加强筋、螺栓排（车内到处是）；中间那根让开指挥塔的开口（不横在头顶上）
  for _, z in ipairs({ -0.55, 0.55 }) do bx(T, 2.5, 0.04, 0.05, 0, RY - 0.02, z, WHITE2) end
  bx(T, 1.43, 0.04, 0.05, -0.535, RY - 0.02, 0.0, WHITE2)
  bx(T, 0.31, 0.04, 0.05, 1.095, RY - 0.02, 0.0, WHITE2)
  for i = 0, 9 do b:ball(T, 0.018, CF(-1.235, 0.72, -0.6 + i * 0.2), C.lgray, MAT.Metal) b:ball(T, 0.018, CF(1.235, 0.72, -0.6 + i * 0.2), C.lgray, MAT.Metal) end

  -- 尾舱隔板 + 两扇装甲滑门（左：装填手的待发弹 18 发，右：18 发）
  local BZ = 1.10
  bx(T, 2.50, 0.10, 0.06, 0, 0.04, BZ, WHITE2)
  bx(T, 2.50, 0.08, 0.06, 0, RY - 0.04, BZ, WHITE2)
  bx(T, 0.20, RY, 0.06, 0, RY / 2, BZ, WHITE2)
  bx(T, 0.20, RY, 0.06, -1.15, RY / 2, BZ, WHITE2)
  bx(T, 0.20, RY, 0.06, 1.15, RY / 2, BZ, WHITE2)
  local racks = {}
  for side, s in pairs({ L = -1, R = 1 }) do
    local cx = s * 0.55
    -- 门（子组，开的时候往外侧滑）
    local gname = "door" .. side
    b:group(gname, T, CF(cx, RY / 2 + 0.02, BZ - 0.035))
    b:box(gname, V(0.90, 0.64, 0.05), CF(), RGB(196, 198, 190), MAT.Metal)
    b:box(gname, V(0.86, 0.04, 0.02), CF(0, 0.22, -0.03), RGB(170, 172, 164), MAT.Metal)
    b:box(gname, V(0.86, 0.04, 0.02), CF(0, -0.22, -0.03), RGB(170, 172, 164), MAT.Metal)
    b:grab(gname, V(-s * 0.30, 0.10, -0.03), V(-s * 0.30, -0.10, -0.03), V(0, 0, -0.05), 0.022, C.black)
    b:placard(gname, 0.30, 0.08, CF(0, 0.10, -0.028), "AMMO DOOR", { bg = RGB(230, 200, 40) })
    b:placard(gname, 0.42, 0.06, CF(0, -0.04, -0.028), "KEEP CLOSED EXCEPT WHEN LOADING", { bg = RGB(230, 200, 40) })
    -- 弹架：3 排 × 6 列，弹底朝前（朝乘员舱）
    racks[side] = {}
    bx(T, 0.92, 0.66, 0.02, cx, RY / 2 + 0.02, BZ + 0.06, C.dark, MAT.Metal)   -- 弹架面板（门开了才看得见）
    for r = 0, 2 do
      for c = 0, 5 do
        local p = V(cx - 0.375 + c * 0.15, 0.18 + r * 0.21, BZ + 0.07)
        local rd = round120(b, T, CF(p) * ANG(0, PI, 0), { len = 0.98, lo = true, caseCol = (r == 0 and c < 2) and RGB(150, 150, 140) or RGB(176, 160, 118) })
        table.insert(racks[side], rd)
      end
    end
  end
  b:name("racks", racks)
  -- 装填手的膝动开门开关（地板上靠左门）
  b:group("knee", T, CF(-0.58, FY + 0.40, 0.92))
  b:box("knee", V(0.18, 0.05, 0.10), CF(), RGB(200, 170, 40), MAT.Metal)
  bx(T, 0.08, 0.34, 0.06, -0.58, FY + 0.22, 0.96, C.gray, MAT.Metal)

  ---------------- 主炮：M256 120 毫米滑膛炮（炮耳轴原点；recoil 子组后坐，blk 炮闩下落）
  b:box(G, V(0.40, 0.36, 0.86), CF(0, 0, -0.12), RGB(98, 102, 96), MAT.Metal)                -- 摇架
  for _, s in ipairs({ -1, 1 }) do
    b:cylZ(G, 0.72, 0.085, CF(s * 0.14, 0.22, -0.05), C.steel, MAT.Metal)                       -- 驻退复进机
    b:cylZ(G, 0.10, 0.11, CF(s * 0.14, 0.22, 0.30), C.dark, MAT.Metal)
  end
  b:cylZ(G, 0.14, 0.16, CF(0.22, -0.12, -0.10), C.dark, MAT.Metal)                              -- 高低机连接（推测）
  b:group("recoil", G, CF())
  b:cylZ("recoil", 0.85, 0.26, CF(0, 0, -0.18), RGB(70, 74, 72), MAT.Metal)                     -- 炮管尾段（隔热套里面那截）
  b:box("recoil", V(0.52, 0.48, 0.60), CF(0, -0.02, 0.62), RGB(64, 66, 64), MAT.Metal)         -- 炮尾环
  b:box("recoil", V(0.54, 0.06, 0.62), CF(0, 0.24, 0.62), RGB(78, 80, 78), MAT.Metal)
  b:cylZ("recoil", 0.04, 0.20, CF(0, 0.02, 0.935), RGB(90, 92, 90), MAT.Metal)                  -- 药室口
  b:box("recoil", V(0.08, 0.30, 0.10), CF(-0.31, -0.05, 0.70), C.dark, MAT.Metal)              -- 开闩把手座（装填手一侧）
  b:group("blk", "recoil", CF(0, -0.02, 0.62))
  b:box("blk", V(0.30, 0.34, 0.30), CF(0, 0, 0), RGB(120, 122, 118), MAT.Metal)                 -- 立楔式炮闩（开闩时下落）
  b:box("blk", V(0.20, 0.06, 0.02), CF(0, 0.05, 0.155), RGB(40, 40, 40), MAT.Metal)
  b:group("brk", "recoil", CF(-0.33, 0.05, 0.70))
  b:tube("brk", V(0, 0, 0), V(-0.06, -0.28, 0.10), 0.03, C.dark, MAT.Metal)                     -- 开闩手柄
  b:ball("brk", 0.05, CF(-0.06, -0.28, 0.10), C.black)
  -- 防危板 / 后坐防护栏（跟着炮俯仰，不跟着后坐）：两侧挡板、后横杆、底下的药筒底盘收集袋
  for _, s in ipairs({ -1, 1 }) do
    b:box(G, V(0.04, 0.56, 0.86), CF(s * 0.40, -0.06, 0.88), RGB(96, 100, 86), MAT.Metal)
    b:box(G, V(0.05, 0.08, 0.86), CF(s * 0.40, 0.24, 0.88), WHITE, MAT.SmoothPlastic)   -- 顶边（原来整条黄色，用户 11-23 的车长位截图里这片是白的）
  end
  b:tube(G, V(-0.40, 0.18, 1.30), V(0.40, 0.18, 1.30), 0.04, C.lgray, MAT.Metal)
  b:tube(G, V(-0.40, -0.30, 1.30), V(0.40, -0.30, 1.30), 0.04, C.lgray, MAT.Metal)
  b:box(G, V(0.70, 0.12, 0.50), CF(0, -0.40, 1.02), RGB(86, 84, 66), MAT.Fabric)                -- 底盘收集袋
  b:placard(G, 0.34, 0.07, CF(-0.425, -0.02, 0.88) * ANG(0, PI / 2, 0), "DANGER  RECOIL AREA", { bg = RGB(230, 196, 40) })
  b:placard(G, 0.34, 0.07, CF(0.425, -0.02, 0.88) * ANG(0, -PI / 2, 0), "DANGER  RECOIL AREA", { bg = RGB(230, 196, 40) })
  -- 装填手的保险（防护栏左边的 ARM / SAFE 拨杆）
  b:group("arm", G, CF(-0.43, 0.14, 0.62))
  b:box("arm", V(0.03, 0.14, 0.04), CF(0, 0.06, 0), C.red, MAT.SmoothPlastic)
  b:placard(G, 0.10, 0.04, CF(-0.425, 0.04, 0.62) * ANG(0, PI / 2, 0), "ARM  SAFE", { bg = C.black, fg = C.white })
  -- 并列 M240 机枪（炮右边，跟着炮俯仰）+ 供弹槽 + 弹箱
  b:box(G, V(0.10, 0.13, 0.78), CF(0.33, 0.02, -0.02), RGB(40, 42, 42), MAT.Metal)
  b:box(G, V(0.14, 0.06, 0.20), CF(0.33, 0.10, 0.10), RGB(50, 52, 52), MAT.Metal)
  b:box(G, V(0.08, 0.10, 0.12), CF(0.33, -0.06, 0.28), RGB(30, 30, 30), MAT.Metal)
  b:cable(G, { V(0.40, 0.08, 0.10), V(0.55, 0.02, 0.20), V(0.62, -0.30, 0.32) }, 0.07, RGB(70, 72, 60))   -- 供弹槽
  b:box(T, V(0.30, 0.30, 0.42), CF(0.70, -0.50, -0.95), OD, MAT.SmoothPlastic)                  -- 并列机枪弹箱
  b:placard(T, 0.18, 0.06, CF(0.70, -0.42, -0.735) * ANG(0, PI, 0), "7.62MM  COAX", { bg = OD, fg = C.white })

  ---------------- 炮长位（右前）
  local gEye = V(0.52, 0.30, -0.76)
  -- 主瞄准镜 GPS：吊在炮塔顶上的镜体、双目目镜和黑色护额垫
  bx(T, 0.30, 0.46, 0.42, 0.62, 0.56, -1.02, RGB(52, 54, 56))
  bx(T, 0.24, 0.20, 0.14, 0.55, 0.36, -0.92, RGB(40, 42, 44))
  for _, s in ipairs({ -1, 1 }) do b:cylZ(T, 0.06, 0.05, CF(0.55 + s * 0.035, 0.33, -0.845), C.rubber, MAT.Fabric) end
  b:box(T, V(0.26, 0.06, 0.08), CF(0.55, 0.43, -0.86), C.rubber, MAT.Fabric)                     -- 护额垫
  -- 目镜镜片：暗的、映一点天光（原来两颗发绿光的霓虹小球「热像是绿的」，用户 11-22：现实中不带绿光）
  for _, s in ipairs({ -1, 1 }) do b:lens(T, CF(0.55 + s * 0.035, 0.33, -0.814), 0.034) end
  b:placard(T, 0.12, 0.04, CF(0.62, 0.56, -0.805) * ANG(0, PI, 0), "GPS", { bg = C.black, fg = C.white })
  -- 炮长控制显示面板 GCDP（右边斜着对炮长）
  -- 真模型：带左右各 5 个边键和整块键盘的显示控制单元（ip_cdu，键帽上印着这块面板的键）；没生成好就照旧画屏幕 + 面板
  local gcdpCF = look(V(0.88, 0.23, -0.86), gEye + V(0, -0.1, 0.1))
  local gcdp = scr(b, T, "ip_cdu", 1.25, 0.20, 0.15, gcdpCF, "gcdp", { keys = { top = { "MAIN", "AMMO", "RANGE", "ADJUST", "LRF" }, bottom = { "WHT/BLK", "3X/10X", "FCS", "BSGT", "MRS" } }, lightK = 0.28 })
  if gcdp and gcdp.opt and gcdp.opt.propShell then
    swPanel(T, look(V(0.95, -0.08, -0.74), gEye + V(0, -0.3, 0.1)) * ANG(0, 0, PI / 2), 1.3, 0.22, 0.12, 2, 5, RGB(66, 68, 66), { kinds = { "b", "b", "b", "l", "t" } })
  else
    b:panel(T, 0.22, 0.12, look(V(0.92, 0.00, -0.78), gEye + V(0, -0.3, 0.1)), 2, 5, RGB(66, 68, 66), { kinds = { "b", "b", "b", "l", "t" } })
  end
  -- "凯迪拉克" 双握把 GCH（底座立柱 + 左右两个握把；握把跟着炮塔转、炮俯仰的速度转动）
  b:tube(T, V(0.55, FY + 0.06, -0.70), V(0.55, -0.15, -0.72), 0.06, C.gray, MAT.Metal)
  bx(T, 0.30, 0.09, 0.12, 0.55, -0.10, -0.74, RGB(54, 56, 58))
  b:group("gch", T, CF(0.55, -0.08, -0.74))
  -- 真模型：飞机驾驶盘的两只羊角握把和中间的毂（ip_yoke，去掉了下面的长杆），装在握把底座上——两边握把朝上、按钮在拇指下，最像艾布拉姆斯的双握把
  if not b:prop("gch", "ip_yoke", CF(0, 0.075, 0), 0.9) then
    for _, s in ipairs({ -1, 1 }) do
      b:box("gch", V(0.05, 0.14, 0.05), CF(s * 0.14, 0.08, 0.0) * ANG(rad(-20), 0, 0), C.black, MAT.SmoothPlastic)
      b:box("gch", V(0.055, 0.03, 0.06), CF(s * 0.14, 0.16, -0.01), RGB(40, 40, 40), MAT.SmoothPlastic)
      b:button("gch", CF(s * 0.14, 0.155, -0.04) * ANG(rad(-70), 0, 0), C.red, 0.012)             -- 激光测距按钮
    end
  end
  -- 辅助瞄准镜 GAS（装在炮的摇架上，跟着炮俯仰）
  b:cylZ(G, 0.55, 0.07, CF(0.24, 0.12, 0.10), RGB(46, 48, 50), MAT.Metal)
  b:cylZ(G, 0.06, 0.06, CF(0.24, 0.12, 0.40), C.rubber, MAT.Fabric)
  -- 手动方向机、高低机（手轮）
  for _, p in ipairs({ V(0.30, -0.12, -0.92), V(0.82, -0.18, -0.62) }) do
    b:cylZ(T, 0.03, 0.16, CF(p) * ANG(rad(20), 0, 0), C.dark, MAT.Metal)
    b:tube(T, p, p + V(0.05, -0.05, 0.06), 0.022, C.black)
  end
  b:seat(T, CF(0.55, -0.40, -0.40), { w = 0.36, d = 0.32, back = 0.36, recline = 4, post = 0.55, col = RGB(52, 50, 44) })
  bx(T, 0.18, 0.04, 0.24, 0.55, FY + 0.12, -0.80, C.dark, MAT.DiamondPlate, -20, 0, 0)          -- 搁脚
  bx(T, 0.20, 0.18, 0.05, 0.55, -0.10, -0.98, RGB(52, 50, 44), MAT.Fabric)                       -- 护胸垫

  ---------------- 车长位（右后，坐得高）
  local cEye = V(0.56, 0.60, 0.02)
  -- 指挥塔（用户 11-23：「坐的那个位置往上看就是 8 边形观瞄舱」）：M1A2 SEP 的车长指挥塔是八边形的，一圈八具观察镜（360° 都看得见）——
  --   从车长位往上看：八块白漆内壁围成八边形，每块壁上一具观察镜（深色框、玻璃）、下面一条黑橡胶防撞垫，上下各一圈八边形的边框，顶上是圆舱盖的内面
  local CUP = V(0.56, RY, CZ)                   -- 指挥塔中心（炮塔顶开口；CZ 见上面炮塔顶：挪到车长头顶正上方）
  local AP, WT, HB, HT = 0.30, 0.04, -0.05, 0.20   -- 内壁到中心的距离（边心距）、壁厚、壁的下沿 / 上沿（相对炮塔顶）
  local fw = 2 * (AP + WT / 2) * math.tan(PI / 8) * 1.04   -- 每块壁板宽（壁厚中线处；稍微搭接，角上不露缝）
  for i = 0, 7 do
    local a = rad(i * 45)
    local d = V(math.sin(a), 0, -math.cos(a))   -- 这块壁朝外的方向（第一块朝正前）
    local function at(r, y) local q = CUP + d * r + V(0, y, 0) return CFrame.lookAt(q, q + d) end
    b:box(T, V(fw, HT - HB, WT), at(AP + WT / 2, (HB + HT) / 2), WHITE, MAT.SmoothPlastic)              -- 内壁
    b:box(T, V(fw * 0.97, 0.025, 0.035), at(AP - 0.012, HB + 0.0125), WHITE2, MAT.Metal)                 -- 下边一圈边框
    b:box(T, V(fw * 0.97, 0.025, 0.035), at(AP - 0.012, HT - 0.0125), WHITE2, MAT.Metal)                 -- 上边一圈边框
    -- 观察镜（用户 11-23 又发来车长位插图：每块壁上一大块浅蓝玻璃、细黑框，八块连成一圈，玻璃上两道斜的反光）
    local vb = at(AP - 0.004, 0.10)
    local gw, gh = fw * 0.80, 0.095
    local gl = b:box(T, V(gw, gh, 0.006), vb, RGB(166, 220, 236), MAT.Glass)
    gl.Transparency, gl.CastShadow = 0.12, false
    for _, e in ipairs({ { 0, gh / 2 + 0.003, gw + 0.012, 0.006 }, { 0, -gh / 2 - 0.003, gw + 0.012, 0.006 }, { gw / 2 + 0.003, 0, 0.006, gh }, { -gw / 2 - 0.003, 0, 0.006, gh } }) do
      b:box(T, V(e[3], e[4], 0.012), vb * CF(e[1], e[2], 0), C.black)                                  -- 细黑框
    end
    local sg = Kit.gui(gl, Enum.NormalId.Back, 900)   -- 朝里那面（Back：at() 的 −Z 朝外）
    for _, q in ipairs({ { 0.36, 0.09 }, { 0.50, 0.04 } }) do   -- 两道斜的反光（插图那样）
      local f = Instance.new("Frame")
      f.AnchorPoint = Vector2.new(0.5, 0.5)
      f.Position, f.Size = UDim2.fromScale(q[1], 0.5), UDim2.fromScale(q[2], 1.8)
      f.Rotation = 35
      f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = RGB(255, 255, 255), 0.35, 0
      f.Parent = sg
    end
    b:box(T, V(0.15, 0.022, 0.028), at(AP - 0.016, 0.026), C.rubber, MAT.Fabric)                          -- 防撞垫
    b:box(T, V(fw * 1.12, 0.03, 0.06), at(AP + WT + 0.025, 0.03), WHITE2, MAT.Metal)                      -- 外面一圈座板（壁和炮塔顶开口之间不露缝）
  end
  b:light(T, CF(CUP.X, RY + 0.10, CUP.Z), "dome", RGB(255, 244, 228), 0.9, 0.5)                    -- 指挥塔里面也照得到（往上看不是一团黑）
  b:group("chatch", T, CF(CUP.X, RY + HT + 0.02, CUP.Z))
  b:cylY("chatch", 0.04, 0.70, CF(), WHITE, MAT.SmoothPlastic)                                         -- 圆舱盖（盖住八边形口）
  b:cylY("chatch", 0.02, 0.50, CF(0, -0.03, 0), WHITE2, MAT.Metal)                                     -- 舱盖内面的加强圈
  b:grab("chatch", V(-0.12, -0.04, 0.10), V(0.12, -0.04, 0.10), V(0, -0.05, 0), 0.02, C.black)
  -- 独立热像仪显示器（CITV）、指挥综合显示器（CID / JBC-P）、CROWS 遥控武器站屏幕和握把、车长操纵握把 CCH、主瞄准镜延伸目镜 GPSE
  -- 车长显示单元（用户 11-23 发来钢铁猛兽 M1A2 SEP 车长位截图：「严格按照这个图，上面是一块 CITV」「两个屏幕中间的横排按钮是对应上面的屏幕的」）：
  --   一整台深蓝灰机壳：上屏独立热像仪 CITV，左边一列 5 个、两屏之间一排 10 个蓝色背光键都管上屏（选中的键角上绿灯亮），上屏右边一条三个绿灯；
  --   下屏指挥地图（白底、红色道路），左边 VEH SYS、C3 两个键，左下四个方向键，下边 8 个橙色横杠键，右边 4 × 4 橙色字母数字键盘；三根把手
  --   机壳、银色倒角屏框是本项目照截图做的网格（ip_cdus，tools/weapons/gen_cdus.mjs——Sketchfab 上搜不到能下载的 CITV / 车长显示器模型），
  --   键、屏幕、指示灯按同一张版面表（ReplicatedStorage.CdusLayout）现做
  -- 机壳正面中心（−Z 对着车长）：在主瞄准镜延伸目镜右边，从车长眼睛看过去不被护眼罩挡（截图里也是挨着）；
  --   用户 11-23 再对截图：原来在 (0.88, 0.42, −0.46)，离眼睛 0.6 米、偏右 34°、上屏比眼睛低，显得又小又远——挪近、抬高、往中间靠
  local uCF = look(V(0.80, 0.44, -0.40), cEye)
  sbCdu(b, T, uCF)
  -- 显示单元下面：CROWS 遥控武器站的显示控制单元（真模型是带边键和键盘的显示控制单元 ip_cdu），挪到右下、不挡大显示单元
  scr(b, T, "ip_cdu", 0.95, 0.17, 0.13, look(V(0.92, -0.04, -0.30), cEye + V(0, 0.25, 0)), "crows", { keys = { top = { "ARM", "SAFE", "THERM" }, bottom = { "ZOOM", "LASE", "SLAVE" } }, lightK = 0.25 })
  -- 车长操纵握把（插图右下：白色机箱上一根黑色、带红色扳机和按钮的握杆）：
  --   真模型：A-6E 的 AN/ASQ-155 弹道计算机的白色铸壳机箱（ip_asq2，去掉了原来那根杆，顶上留着键盘和杆座）+ 杆座上装 B-8 握杆（ip_stick）
  local asqAt = V(1.00, -0.24, -0.22)
  local asqCF = CF(asqAt) * ANG(0, rad(-55), 0)   -- 有键盘、杆座的那面（+Z）朝着车长
  local KA = 0.6
  b:group("cch", T, asqCF * CF(0.03 * KA / 2.8, 1.12 * KA / 2.8, 0.26 * KA / 2.8))   -- 杆座（器材坐标 0.03, 1.12, 0.26 格）
  if b:prop(T, "ip_asq2", asqCF, KA) then
    bx(T, 0.20, 0.03, 0.28, asqAt.X, asqAt.Y - 0.015, asqAt.Z, C.gray, MAT.Metal, 0, -55, 0)            -- 托架
    b:tube(T, asqAt + V(0, -0.03, 0), V(asqAt.X, FY + 0.06, asqAt.Z), 0.04, C.gray, MAT.Metal)
    if not b:prop("cch", "ip_stick", CF(), 0.75) then
      b:box("cch", V(0.05, 0.13, 0.05), CF(0, 0.07, 0) * ANG(rad(-15), 0, 0), C.black)
    end
  else
    b:box("cch", V(0.05, 0.13, 0.05), CF(0, 0.07, 0) * ANG(rad(-15), 0, 0), C.black)
    b:button("cch", CF(0, 0.14, -0.03) * ANG(rad(-70), 0, 0), C.yellow, 0.012)
    b:tube(T, V(0.78, -0.30, -0.12), V(0.78, 0.10, -0.12), 0.04, C.gray, MAT.Metal)
  end
  -- 主瞄准镜延伸目镜 GPSE（截图左边）：目镜筒、暗的镜片（用户 11-22：现实中不带绿光——原来是一颗发绿光的霓虹球），
  --   外面一圈宽的黑橡胶护眼罩（上边、两边包着眼眶，两边往脸这边弯，下边空出目镜），
  --   右下一个红色 T 形手柄
  -- 延伸目镜的横向位置：用户 11-23 的截图里在视线中间偏左一点（原来 x 0.56 正对眼睛），显示单元挨在它右边
  local GX = 0.47
  b:cylZ(T, 0.10, 0.07, CF(GX, 0.52, -0.42), RGB(42, 44, 46), MAT.Metal)                        -- GPSE 目镜
  b:cylZ(T, 0.03, 0.074, CF(GX, 0.52, -0.36), C.rubber, MAT.Fabric)
  b:lens(T, CF(GX, 0.52, -0.346), 0.05)
  b:tube(T, V(GX, 0.52, -0.47), V(0.60, 0.56, -0.82), 0.06, RGB(52, 54, 56), MAT.Metal)
  do
    -- 护眼罩：一圈圆角方形的粗橡胶管（宽 16 厘米、高 10 厘米），下边中间断开让出目镜，两头往里弯；两边往脸这边弯
    local gp = V(GX, 0.52, -0.345)
    local ring = {}
    for i = 0, 20 do
      local t = math.rad(-112 + i * (224 / 20))   -- 从左下（-112°）绕上面到右下（112°），0° 在正上方
      local sx, sy = math.sin(t), math.cos(t)
      local x = 0.080 * math.sign(sx) * math.abs(sx) ^ 0.6   -- 圆角方形（超椭圆）
      local y = 0.050 * math.sign(sy) * math.abs(sy) ^ 0.6 + 0.008
      table.insert(ring, gp + V(x, y, 0.010 + x * x * 2.4))
    end
    table.insert(ring, 1, gp + V(-0.030, -0.046, 0.012))   -- 下边两头往目镜那边收
    table.insert(ring, gp + V(0.030, -0.046, 0.012))
    b:cable(T, ring, 0.030, C.rubber, MAT.Fabric)
    b:tube(T, V(GX + 0.07, 0.405, -0.46), V(GX + 0.085, 0.43, -0.40), 0.012, C.gray, MAT.Metal)        -- 红色 T 形手柄
    b:tube(T, V(GX + 0.065, 0.44, -0.395), V(GX + 0.11, 0.425, -0.40), 0.016, RGB(190, 32, 30))
  end
  b:seat(T, CF(0.58, -0.08, 0.30), { w = 0.38, d = 0.34, back = 0.34, recline = 6, post = 0.80, col = RGB(52, 50, 44) })
  bx(T, 0.36, 0.04, 0.30, 0.58, -0.52, 0.02, C.dark, MAT.DiamondPlate)                            -- 车长搁脚台
  b:radio(T, 0.22, 0.12, 0.18, look(V(1.20, 0.30, 0.45), V(0, 0.3, 0.45)), RGB(60, 64, 56))      -- 车长车内通话盒（推测）

  ---------------- 装填手位（左）
  local lEye = V(-0.60, 0.56, 0.10)
  ring(b, T, -0.62, RY + 0.02, 0.28, 0.32, 16, 0.06, 0.06, WHITE2, MAT.Metal)
  b:group("lhatch", T, CF(-0.62, RY + 0.10, 0.28))
  b:cylY("lhatch", 0.05, 0.56, CF(), WHITE, MAT.SmoothPlastic)
  b:grab("lhatch", V(-0.11, -0.03, 0.10), V(0.11, -0.03, 0.10), V(0, -0.05, 0), 0.02, C.black)
  -- 装填手潜望镜（能转）
  b:group("lscope", T, CF(-0.62, RY - 0.05, -0.12))
  b:periscope("lscope", CF(0, 0, 0) * ANG(0, 0, 0), 0.18, 0.09, 0.12, { model = true })
  b:grab("lscope", V(-0.10, -0.06, 0.06), V(0.10, -0.06, 0.06), V(0, -0.06, 0), 0.016, C.black)
  -- 装填手面板（主炮状态：READY / ARMED，炮塔动力）、电台架、灭火器、折叠座椅
  b:panel(T, 0.26, 0.20, look(V(-1.21, 0.36, -0.22), V(0, 0.36, -0.22)), 3, 4, RGB(66, 68, 66), { ledRole = "ready" })
  b:placard(T, 0.20, 0.04, look(V(-1.215, 0.48, -0.22), V(0, 0.48, -0.22)), "LOADER'S PANEL", { bg = C.black, fg = C.white })
  swPanel(T, look(V(-1.215, 0.34, 0.0), V(0, 0.34, 0.0)), 1.2, 0.10, 0.16, 3, 2, RGB(66, 68, 66), { guard = true })   -- 弹药门 / 炮塔动力开关（带护盖的拨杆）
  b:radio(T, 0.36, 0.16, 0.30, look(V(-1.21, 0.30, 0.62), V(0, 0.30, 0.62)), RGB(70, 76, 58), "ip_radio")      -- SINCGARS 电台 ×2
  b:radio(T, 0.36, 0.16, 0.30, look(V(-1.21, 0.48, 0.62), V(0, 0.48, 0.62)), RGB(70, 76, 58), "ip_radio")
  b:harness(T, { V(-1.05, 0.62, 0.62), V(-0.95, 0.74, 0.40), V(-0.20, 0.74, 0.35), V(0.40, 0.74, 0.05) }, 3, 0.022)
  b:extinguisher(T, CF(-1.18, 0.12, 0.05), 0.36, 0.12)
  b:seat(T, CF(-1.12, 0.10, 0.40) * ANG(0, PI / 2, 0) * ANG(rad(-80), 0, 0), { w = 0.34, d = 0.30, back = 0, col = RGB(52, 50, 44) })   -- 折起来的座椅
  -- 机枪弹箱：真模型是 12.7 毫米 M2A1 铁皮弹箱（ip_can，30.5 × 15.5 厘米、带提手和扣盖），两排两层；没生成好就照旧两个方箱
  local canN = 0
  for _, y in ipairs({ -0.83, -0.61 }) do
    for _, z in ipairs({ -0.79, -0.61 }) do
      if b:prop(T, "ip_can", CF(-0.95, y, z), 1) then canN += 1 end
    end
  end
  if canN == 0 then
    b:box(T, V(0.30, 0.22, 0.44), CF(-0.95, -0.48, -0.70), OD)
    b:box(T, V(0.30, 0.22, 0.44), CF(-0.95, -0.72, -0.70), OD)
  end
  -- 炮塔里的电缆
  b:harness(T, { V(0.10, RY - 0.06, -1.10), V(0.40, RY - 0.06, -0.60), V(0.95, RY - 0.06, -0.40), V(1.10, 0.40, -0.30) }, 4, 0.02)
  b:harness(T, { V(0, FY + 0.30, 0.05), V(0.30, -0.40, 0.20), V(0.95, -0.10, 0.40), V(1.10, 0.25, 0.40) }, 3, 0.025)
  b:harness(T, { V(-0.95, -0.20, 0.95), V(-1.15, 0.05, 0.70), V(-1.18, 0.20, 0.40) }, 3, 0.02)
  -- 灯：炮塔两盏顶灯（白 / 夜里红或蓝绿）、开炮时从观察镜透进来的火光、挨打时的红色告警
  b:light(T, CF(-0.25, RY - 0.06, 0.55), "dome", RGB(255, 244, 228), 3.4, 1.1)
  b:light(T, CF(1.00, RY - 0.06, -0.30), "dome", RGB(255, 244, 228), 3.2, 1.0)   -- 原来在 x 0.70（现在是指挥塔开口），挪到开口右边；没有灯具，只留照明
  b:light(T, CF(CUP.X, RY - 0.05, CUP.Z), "flash", RGB(255, 196, 120), 4.0, 0)
  b:light(T, CF(-0.30, 0.40, -0.50), "warn", RGB(255, 40, 30), 3.0, 0)
  -- 顶灯灯具：真模型是带铁丝护罩的防爆顶灯（ip_lamp）；车长前上方那盏去掉（用户 11-23：「把那个天花板上的灯去掉」——车长抬头看观察窗时正挡在前面）
  domeLamp(T, V(-0.25, RY, 0.55))

  return {
    gunK = 0.305,   -- M256 后坐行程
    loader = "m256",
    stations = {
      -- optics：Shift 主镜、G 备用镜、T 第三个；kind = "gps" 是炮长主瞄准镜（Drive.lua 的瞄准镜）
      driver = { g = H, eye = eyeD, look = V(0, 0.15, -1), yaw = 110, up = 35, down = 55, crew = "driver",
        optics = { primary = { kind = "dve", name = "DVE  AN/VAS-5", g = H, pos = V(0, 0.06, -2.25), dir = "hull", fovs = { 40 }, ret = "dve", look = "bhot", shape = "rect" },
          alt = { kind = "rear", name = "RVSS  REAR", g = H, pos = V(1.25, 0.10, 3.45), dir = "rear", fovs = { 52 }, ret = "rear", look = "whot", shape = "rect" } } },
      gunner = { g = T, eye = gEye + V(0.02, 0.06, 0.16), look = V(0, -0.18, -1), yaw = 120, up = 45, down = 60, crew = "gunner", sight = true, scope = V(0.55, 0.33, -0.80),
        optics = { primary = { kind = "gps" },
          alt = { kind = "gas", name = "GAS  M920  8X", g = G, pos = V(0.24, 0.12, 0.40), dir = "gun", fovs = { 8.5 }, ret = "gas", look = "day", shape = "circle", useSight = true } } },
      commander = { g = T, eye = cEye, look = V(-0.05, -0.30, -1), yaw = 160, up = 70, down = 70, crew = "commander", scope = V(0.47, 0.52, -0.40),
        optics = { primary = { kind = "citv", name = "CITV", g = T, pos = V(-0.45, 1.05, -0.75), dir = "citv", fovs = { 22, 7 }, ret = "citv", look = "whot", shape = "rect" },
          alt = { kind = "gps" },
          third = { kind = "crows", name = "CROWS-LP  M2", g = T, pos = V(0.62, 1.40, 0.20), dir = "free", fovs = { 30, 9 }, ret = "crows", look = "day", shape = "rect",
            rws = true, eye = V(-0.75, 0.30, 0.10) } } },   -- 摄像头在 M2 托架左边（格，相对机枪耳轴），跟着武器站转、俯仰
      loader = { g = T, eye = lEye, look = V(0.45, -0.20, -1), yaw = 170, up = 70, down = 75, crew = "loader",
        optics = { primary = { kind = "lscope", name = "LOADER'S PERISCOPE", g = T, pos = V(-0.62, 0.92, -0.12), dir = "free360", fovs = { 38 }, ret = "none", look = "day", shape = "slot" } } },
    },
    order = { "driver", "gunner", "commander", "loader" },
    lock = "gunner",   -- 坦克一进车默认炮长位（11-23 原来锁死在炮长位；用户 11-24：「我要能开别的位置」——F2～F5 照常换，Interior.lua）
    crew = {
      driver = { dress = "tank_us", g = H, eye = eyeD, lean = 34, yaw = 0, look = V(0, 0.1, -1),
        hands = { l = { "tbar", V(-0.27, 0.0, 0) }, r = { "tbar", V(0.27, 0.0, 0) } },
        feet = { l = { H, V(-0.12, FY + 0.10, -2.92) }, r = { H, V(0.10, FY + 0.10, -2.90) } } },
      gunner = { dress = "tank_us", g = T, eye = gEye + V(0, -0.02, 0.02), lean = -24, yaw = 0, look = V(0, -0.12, -1),
        hands = { l = { "gch", V(-0.14, 0.12, 0.0) }, r = { "gch", V(0.14, 0.12, 0.0) } },
        feet = { l = { T, V(0.45, FY + 0.16, -0.82) }, r = { T, V(0.66, FY + 0.16, -0.80) } } },
      commander = { dress = "tank_us", g = T, eye = cEye, lean = -10, yaw = 0, look = V(0, -0.35, -1),
        hands = { l = { T, V(0.70, 0.30, -0.32) }, r = { "cch", V(0, 0.10, 0) } },
        feet = { l = { T, V(0.50, -0.48, -0.02) }, r = { T, V(0.68, -0.48, -0.02) } } },
      loader = { dress = "tank_us", g = T, eye = lEye, lean = -6, yaw = -28, look = V(0.5, -0.25, -1), stand = true,
        hands = { l = { G, V(-0.40, 0.24, 0.70) }, r = nil },
        feet = { l = { T, V(-0.72, FY + 0.16, 0.12) }, r = { T, V(-0.44, FY + 0.16, 0.18) } } },
    },
  }
end

---------------------------------------------------------------- ZTZ-99A（99A 式主战坦克）
-- 解放军 99A：三人车组（自动装弹机代替装填手）。驾驶员在车体前部中间（方向盘、数字仪表、三具潜望镜），
--   炮塔里炮长在左（主瞄准镜目镜、火控计算机面板、操纵台、炮长显示器）、车长在右（周视瞄准镜目镜和显示器、综合显示终端、超越操纵手柄）；
--   ZPT-98A 125 毫米滑膛炮立楔式炮闩在中间，右边并列机枪；炮塔篮下面是转盘式自动装弹机：22 个弹盒径向排一圈，
--   下层弹丸、上层药筒（分装式）。装弹：转盘转到选的弹种 → 炮尾后面的提弹机把弹盒提到炮尾 → 链式推弹机先推弹丸、再推药筒 → 关闩；
--   打完的药筒底盘从炮塔顶后部的抛壳窗抛出去。车里漆白绿色，标牌是中文（布局照 T-72 / 96 系一脉相承的做法和公开镜头，细节有推测）
local CNW = RGB(214, 224, 210)    -- 车内漆：浅绿白
local CNW2 = RGB(190, 202, 186)
local CNG = RGB(72, 84, 70)

function Defs.ztz99a(b, ctx)
  local T, H, G = "turret", "hull", "gun"
  local function bx(g, sx, sy, sz, x, y, z, col, mat, rx, ry, rz)
    return b:box(g, V(sx, sy, sz), CF(x, y, z) * ANG(rad(rx or 0), rad(ry or 0), rad(rz or 0)), col, mat)
  end
  local function look(p, at) return CFrame.lookAt(p, at) end
  -- 真模型件（用户 11-23：「很粗糙 你从 sketchfeb 找模型去替代不要自己建模 然后用 blender」）：Sketchfab 原模型经 Blender 截取、摆正、
  --   缩到真实尺寸（tools/weapons/blprep.py → optics.mjs 的 ip_ 件）；没导入、没生成好时 prop 返回 nil，照旧用零件拼的
  local function prop(g, key, cf, k) return b:prop(g, key, cf, k) ~= nil end
  -- 座椅：真模型（卡车驾驶座，坐垫顶面中心为原点、乘员朝 −Z）往后仰 tilt 度；没有就拼的
  local function seat(g, cf, k, tilt, opt)
    if prop(g, "ip_dseat", cf * ANG(rad(tilt or 0), 0, 0), k) then
      if opt.post then b:cylY(g, opt.post, 0.05, cf * CF(0, -0.14 * (k or 1) - opt.post / 2, 0.02), C.gray, MAT.Metal) end   -- 立柱（挂在炮塔篮上）
      return
    end
    b:seat(g, cf, opt)
  end
  -- 开关面板：真模型（带护盖的拨杆，ip_sw）；同 M1A2
  local function swPanel(g, cf, k, w, h, rows, cols, col, opt)
    if prop(g, "ip_sw", cf * ANG(0, PI, 0), k) then return end
    b:panel(g, w, h, cf, rows, cols, col, opt)
  end
  -- 车内顶灯：真模型（防爆灯罩，ip_lamp）贴在顶上；同 M1A2
  local function domeLamp(g, p, k)
    k = k or 0.9
    if not prop(g, "ip_lamp", CF(p) * ANG(rad(90), 0, 0), k) then b:box(g, V(0.14, 0.04, 0.10), CF(p - V(0, 0.02, 0)), C.dark, MAT.Metal) end
    b:led(g, CF(p - V(0, 0.035 * k, 0)), RGB(255, 236, 210), 0.05, "domeLamp")
  end
  local FY = -1.05
  local RY = 0.78
  -- 挖了内腔的原车（tools/models/carve.py，重新导入过 veh/ztz99a2.glb；用户 11-23「在原载具上挖出来」）：墙、顶、地板就是从原车挖出来的内壁，
  --   跟车外一比一——这里不再摆车体、炮塔的壳板；地板 / 顶按内腔量，舱盖、驾驶员舱盖、抛壳窗挪到原车外面看得见的那个位置
  --   （原车炮塔顶：炮长舱盖在座圈中心左 0.48、后 0.16 米，车长舱盖右 0.63、后 0.23 米，抛壳窗左 0.43、后 0.94 米；驾驶员舱盖在前 1.81 米）
  local cav = ctx.cav
  local carved = cav ~= nil
  local hullQ = cav and (cav:space("Hull") or cav)
  local turQ = cav and (cav:space("Tur") or cav)
  local function hullFloor(x, z, d) return (hullQ and hullQ:floor(x, z)) or d end
  local function turRoof(x, z, d) return (turQ and turQ:roof(x, z)) or d end
  if carved then
    FY = hullFloor(0, -0.30, FY)
    RY = turRoof(0, 0.20, RY)
  end
  local HATCH = carved and { g = V(-0.48, 0, 0.16), c = V(0.63, 0, 0.23), stub = V(-0.43, 0, 0.94), dz = -1.81 }
    or { g = V(-0.58, 0, 0.40), c = V(0.58, 0, 0.40), stub = V(0, 0, 0.95), dz = -1.58 }
  -- 一块地方（x0～x1、z0～z1 里九个点）内腔最高的地板、最低的顶：挖了内腔的，箱子按它截，不戳出内腔（戳出去的会从车外露出来）
  local function span(q, x0, x1, z0, z1)
    local lo, hi = nil, nil
    if q then
      for _, x in ipairs({ x0, (x0 + x1) / 2, x1 }) do
        for _, z in ipairs({ z0, (z0 + z1) / 2, z1 }) do
          local f, r = q:floor(x, z), q:roof(x, z)
          if f then lo = lo and math.max(lo, f) or f end
          if r then hi = hi and math.min(hi, r) or r end
        end
      end
    end
    return lo, hi
  end
  -- 炮塔里挂在顶上的东西（瞄准镜镜体、线束、顶灯）贴着这一点的顶：挖了内腔的按内腔量，没挖的照旧 RY
  local function roofT(x, z) return carved and turRoof(x, z, RY) or RY end
  -- 96 式（同 T-72 一系）驾驶员用两根转向操纵杆，99A 起才换成方向盘（新浪军事 2017-02-10「中国 99A 坦克驾驶竟用上方向盘」）
  local is96 = ctx.def and ctx.def.id == "ztz96"

  ---------------- 车体（真车布局：驾驶员在车体前部正中、两边是油箱弹架，中间炮塔底下是转盘式自动装弹机，后面隔板外是动力舱——
  --   转向机构在动力舱的综合传动里，驾驶员的方向盘 / 操纵杆只是远程操纵它，人不坐在它上面）
  if not carved then
    bx(H, 1.90, 0.04, 4.20, 0, FY - 0.02, -1.0, FLOOR, MAT.DiamondPlate)
  else   -- 挖出来的地板是平涂的：走人的那一条铺花纹钢板
    bx(H, 1.30, 0.02, 3.40, 0, FY + 0.01, -0.90, FLOOR, MAT.DiamondPlate)
  end
  for _, s in ipairs({ -1, 1 }) do
    if not carved then
      bx(H, 0.04, 0.50, 4.20, s * 0.97, FY + 0.25, -1.0, CNW2)
      bx(H, 0.62, 0.04, 2.30, s * 1.28, -0.55, -0.02, CNW2)
      bx(H, 0.04, 0.55, 2.30, s * 1.58, -0.28, -0.02, CNW2)
    end
    -- 侧凸台上（履带上面那块）：油箱、蓄电池、电台（推测）——挖了内腔的：这台车履带上面的车体里只有几厘米的空（地板到顶），放不下就不摆
    for _, it in ipairs({ { 0.52, 0.44, 1.00, -0.55, CNG }, { 0.50, 0.38, 0.80, 0.62, (s < 0) and RGB(60, 64, 60) or CNG } }) do
      local w, h, l, zc, col = it[1], it[2], it[3], it[4], it[5]
      local f, fits = -0.53, true
      if carved then
        local lo, hi = span(hullQ, s * (1.30 - w / 2), s * (1.30 + w / 2), zc - l / 2, zc + l / 2)
        fits = lo ~= nil and hi ~= nil and hi - lo > h + 0.02
        f = lo or f
      end
      if fits then bx(H, w, h, l, s * 1.30, f + h / 2, zc, col) end
    end
  end
  if not carved then
    b:placard(H, 0.20, 0.07, CF(-1.03, -0.22, -0.55) * ANG(0, -PI / 2, 0), "燃油箱", { bg = RGB(230, 210, 60) })
    b:placard(H, 0.20, 0.07, CF(1.03, -0.22, -0.55) * ANG(0, PI / 2, 0), "燃油箱", { bg = RGB(230, 210, 60) })
  else   -- 挖了内腔的：牌子贴在驾驶员两边的油箱弹架上
    b:placard(H, 0.20, 0.07, CF(-0.478, FY + 0.40, -2.55) * ANG(0, -PI / 2, 0), "燃油箱", { bg = RGB(230, 210, 60) })
    b:placard(H, 0.20, 0.07, CF(0.478, FY + 0.40, -2.55) * ANG(0, PI / 2, 0), "燃油箱", { bg = RGB(230, 210, 60) })
  end
  -- 动力舱隔板：挖了内腔的就是内腔的后壁（量出来在哪），隔板上的百叶条贴在那上面
  local FZ = 1.20
  if carved then
    for z = 1.0, 2.2, 0.04 do if hullFloor(0, z, nil) then FZ = z end end
  else
    bx(H, 3.20, 1.05, 0.05, 0, FY + 0.525, 1.20, CNW2)                 -- 动力舱隔板
  end
  for i = -2, 2 do bx(H, 0.40, 0.05, 0.02, i * 0.48, -0.45, FZ - 0.025, C.dark) end
  if not carved then
    for i = 0, 15 do
      local a = (i + 0.5) * PI / 8
      bx(H, 0.50, 0.04, 0.64, math.sin(a) * 1.36, -0.02, math.cos(a) * 1.36, CNW2, nil, 0, math.deg(a) + 90, 0)
    end
  end
  ring(b, H, 0, -0.05, 0, 1.10, 32, 0.06, 0.08, C.steel, MAT.Metal)
  if carved then   -- 座圈这一圈车体内腔的顶、炮塔内腔的底挖开了（carve.py 的 ring），中间那一截车顶装甲的厚度用座圈钢圈封上，不然隔着缝看得见车外
    ring(b, H, 0, -0.06, 0, 1.13, 40, 0.05, 0.38, RGB(150, 156, 146), MAT.Metal)
  end
  -- 驾驶舱：驾驶员在车体前部正中，两边是油箱弹架（夹着驾驶员），前面是首上装甲；扣上舱盖时半躺着开，头顶就是舱盖
  local DZ = -1.80
  -- 挖了内腔的：99A 车体矮，驾驶员这儿的顶只比地板高 0.75 米——原来写死的眼位（顶下 0.01 米）卡进了顶板（驾驶员视角正中一条黑带），
  --   改成眼睛在顶下 0.1 米、座椅放低、靠背更斜
  local dRoof = carved and hullQ and hullQ:roof(0, DZ) or nil
  local eyeD = dRoof and V(0, math.min(-0.24, dRoof - 0.10), DZ + 0.02) or V(0, -0.24, DZ)
  for _, s in ipairs({ -1, 1 }) do
    if carved then   -- 顺着首上装甲往前变矮：切成五段，每段截到那一段的顶
      for k = 0, 4 do
        local z0 = -3.10 + k * 0.38
        local lo, hi = span(hullQ, s * 0.50, s * 0.94, z0, z0 + 0.38)
        local f = lo or FY
        local h = (hi or -0.25) - f - 0.012
        if h > 0.12 then
          bx(H, 0.50, h, 0.38, s * 0.74, f + h / 2, z0 + 0.19, CNG)
          bx(H, 0.02, math.max(0.05, h - 0.18), 0.34, s * 0.49, f + h / 2, z0 + 0.19, RGB(96, 110, 92))
        end
      end
    else
      bx(H, 0.50, 1.00, 1.90, s * 0.74, FY + 0.50, -2.15, CNG)
      bx(H, 0.02, 0.80, 1.50, s * 0.49, FY + 0.50, -2.15, RGB(96, 110, 92))
    end
  end
  if not carved then
    bx(H, 0.98, 0.05, 1.20, 0, -0.38, -2.72, CNW2, nil, -32, 0, 0)
    bx(H, 0.98, 0.70, 0.05, 0, FY + 0.35, -3.18, CNW2)
    bx(H, 0.98, 0.04, 0.28, 0, -0.04, -2.02, CNW2)
    bx(H, 0.98, 0.04, 0.12, 0, -0.04, -1.24, CNW2)
    for _, s in ipairs({ -1, 1 }) do bx(H, 0.22, 0.04, 0.62, s * 0.38, -0.04, -1.58, CNW2) end
  end
  -- 驾驶员舱盖：挖了内腔的在原车舱盖底下（盖板嵌在内腔的顶里，不往下凸：驾驶员抬头不会一下顶进盖板）
  local dhY = carved and ((hullQ and hullQ:roof(0, HATCH.dz)) or 0) + 0.02 or -0.02
  b:group("dhatch", H, CF(0, dhY, HATCH.dz))
  b:cylY("dhatch", 0.05, 0.56, CF(0, -0.03, 0), CNW, MAT.SmoothPlastic)
  b:grab("dhatch", V(-0.12, -0.06, 0.05), V(0.12, -0.06, 0.05), V(0, -0.06, 0), 0.02, C.black)
  -- 三具观察潜望镜（舱盖前面：正前一具、两边各斜 32°）——挖了内腔的：观察窗上沿顶着内腔的顶
  local pY = dRoof and ((hullQ:roof(0, DZ - 0.24) or dRoof) - 0.08) or -0.13
  for i = -1, 1 do
    local a = rad(i * 32)
    local p = V(math.sin(a) * 0.22, pY, DZ - 0.18 - math.cos(a) * 0.06)
    b:periscope(H, look(p, p + V(math.sin(a), 0, -math.cos(a))), 0.16, 0.09, 0.10, { model = true })
  end
  -- 驾驶员座椅：真模型（卡车驾驶座，Blender 去掉了气囊底座）整个往后仰——扣上舱盖时半躺着开，头靠在头枕上
  seat(H, CF(0, FY + (dRoof and 0.12 or 0.20), -2.24) * ANG(rad(6), 0, 0), 0.9, dRoof and 24 or 20,
    { w = 0.44, d = 0.40, back = 0.58, recline = dRoof and 40 or 32, head = true, col = RGB(46, 50, 44) })
  local hands
  if is96 then
    -- 96 式：两根转向操纵杆（拉左杆往左转、拉右杆往右转）+ 离合器踏板，换挡杆在右手边（同 T-72）
    for _, s in ipairs({ -1, 1 }) do
      local nm = (s < 0) and "lvL" or "lvR"
      b:group(nm, H, CF(s * 0.24, FY + 0.06, -2.62))
      if not prop(nm, "ip_lever", CF() * ANG(rad(17), 0, 0), 1.0) then   -- 真模型（长柄 + 防尘套 + 圆头），往驾驶员那边斜 17°
        b:tube(nm, V(0, 0.04, 0), V(0, 0.50, 0.14), 0.035, C.gray, MAT.Metal)
        b:cylY(nm, 0.13, 0.045, CF(0, 0.56, 0.16), C.rubber, MAT.Fabric)
        bx(H, 0.10, 0.06, 0.10, s * 0.24, FY + 0.06, -2.62, C.dark, MAT.Metal)
      end
    end
    hands = { l = { "lvL", V(0, 0.48, 0.15) }, r = { "lvR", V(0, 0.48, 0.15) } }
  else
    -- 方向盘（99A 起：方向盘操纵、手自动一体的液力机械综合传动）——盘面对着转向柱，跟着转向转（Interior.lua 让 swheel 绕自己的 Z 轴转）
    local wy = FY + 0.50
    if dRoof then wy = math.min(wy, (hullQ:roof(0, -2.66) or wy) - 0.17) end   -- 挖了内腔的：轮缘不顶出首上装甲的内壁
    local wc, base = V(0, wy, -2.66), V(0, FY + 0.05, -2.95)
    b:group("swheel", H, look(wc, wc + (base - wc).Unit))   -- 组的 −Z 顺着转向柱往下：盘面跟转向柱垂直
    if prop("swheel", "ip_swheel", CF(), 0.9) then   -- 真模型（三辐卡车方向盘，直径 0.36 米）：盘面朝 +Z 对着驾驶员，自带的转向柱护罩朝 −Z
      b:tube(H, wc + (base - wc).Unit * 0.26, base, 0.06, C.gray, MAT.Metal)
    else
      zring(b, "swheel", 0.17, 16, 0.03, C.black, MAT.SmoothPlastic)
      b:box("swheel", V(0.34, 0.025, 0.025), CF(), C.black)
      b:box("swheel", V(0.025, 0.17, 0.025), CF(0, -0.085, 0), C.black)
      b:cyl("swheel", 0.05, 0.08, CF(0, 0, 0.02) * ANG(0, PI / 2, 0), C.dark, MAT.Metal)
      b:tube(H, wc, base, 0.06, C.gray, MAT.Metal)
    end
    hands = { l = { "swheel", V(-0.17, 0, 0) }, r = { "swheel", V(0.17, 0, 0) } }
  end
  -- 踏板：真模型（左黑胶刹车、右银色油门，踏板面对着驾驶员，踏板臂往前伸进首上装甲底下）
  if not prop(H, "ip_pedals", CF(0.04, FY + 0.02, -2.86), 0.85) then
    bx(H, 0.16, 0.04, 0.12, 0.12, FY + 0.06, -2.95, C.dark, MAT.DiamondPlate, -25, 0, 0)   -- 油门
    bx(H, 0.16, 0.04, 0.12, is96 and 0.0 or -0.10, FY + 0.06, -2.97, C.dark, MAT.DiamondPlate, -25, 0, 0)  -- 制动
    if is96 then bx(H, 0.12, 0.04, 0.12, -0.12, FY + 0.06, -2.98, C.dark, MAT.DiamondPlate, -25, 0, 0) end  -- 离合器
  end
  -- 挡位手柄（右手边）：真模型同操纵杆，缩到 0.28 米
  if not prop(H, "ip_lever", CF(0.30, FY + 0.02, -2.40) * ANG(rad(-12), 0, 0), 0.56) then
    bx(H, 0.05, 0.16, 0.05, 0.30, FY + 0.30, -2.40, C.dark, MAT.Metal, -20, 0, 0)
    b:ball(H, 0.05, CF(0.30, FY + 0.40, -2.43), C.red)
  end
  -- 仪表在方向盘左上方（摆在正中会挡住方向盘；挖了内腔的车顶矮，贴着顶）
  local dX, dZ = -0.28, -2.40
  local dY = dRoof and math.min(-0.42, (hullQ:roof(dX, dZ) or -0.42) - 0.10) or -0.42
  local dcf = look(V(dX, dY, dZ), eyeD)
  if not (is96 and prop(H, "ip_gauges", dcf * ANG(0, PI, 0), 1.0)) then   -- 96 式：指针式仪表三块（真模型，表盘对着驾驶员）
    -- 99A：驾驶员数字仪表（真模型显示单元的外壳，屏幕照旧是游戏里的页面）
    scr(b, H, "ip_cdu", 1.5, 0.22, 0.14, dcf, "drvcn", { keys = { top = { "主菜单", "状态", "故障", "导航", "维护" }, bottom = { "起动", "熄火", "怠速", "灯检", "消音" } }, lightK = 0.3 })
  end
  swPanel(H, look(V(-0.44, -0.64, -2.08), V(0, -0.6, -2.0)), 1.7, 0.16, 0.28, 4, 2, RGB(60, 66, 60), { guard = true })   -- 主开关面板（带护盖的拨杆）
  b:placard(H, 0.10, 0.03, look(V(-0.44, -0.48, -2.08), V(0, -0.48, -2.0)) * CF(0, 0, -0.002), "电源", { bg = C.black, fg = C.white })
  b:extinguisher(H, CF(-0.34, FY + 0.25, -1.30), 0.46, 0.14)
  b:extinguisher(H, CF(0.34, FY + 0.25, -1.30), 0.46, 0.14)
  b:placard(H, 0.12, 0.05, CF(0.34, FY + 0.40, -1.22) * ANG(0, PI, 0), "灭火瓶", { bg = C.red, fg = C.white })
  b:light(H, CF(0, dRoof and ((hullQ:roof(0, -1.40) or -0.10) - 0.04) or -0.10, -1.40), "dome", RGB(255, 240, 220), 2.8, 0.9)

  ---------------- 转盘式自动装弹机（跟着炮塔转，自己还能转）：车体底板上，22 个弹盒（下层弹丸、上层药筒），同 T-72 的 AZ 系列
  --   挖了内腔的：这台车两条履带之间的车体内宽只有 1.88 米，转盘半径收到 0.93 米以内（弹丸、药筒不缩，弹盒往里收）
  local CR = carved and 0.57 or 0.66
  b:group("carousel", T, CF(0, FY + 0.03, 0))
  bx("carousel", 0.05, 0.05, 0.05, 0, 0, 0, C.dark)
  b:cylY("carousel", 0.03, carved and 1.86 or 2.10, CF(0, 0.0, 0), RGB(60, 64, 60), MAT.Metal)        -- 转盘底盘
  b:cylY("carousel", 0.30, 0.50, CF(0, 0.15, 0), C.dark, MAT.Metal)               -- 中间的轴、电机
  local cassettes = {}
  for i = 0, 21 do
    local a = (i + 0.5) / 22 * 2 * PI
    local cf = ANG(0, a, 0) * CF(0, 0, 0)
    local rr = CR
    -- 弹盒：径向摆，弹底朝中间
    local tray = cf * CF(0, 0.07, -rr)
    local parts = {}
    table.insert(parts, b:box("carousel", V(0.15, 0.025, 0.70), tray, RGB(84, 90, 82), MAT.Metal))
    local kind = (i % 11 < 5) and "ap" or ((i % 11 < 8) and "heat" or ((i % 11 < 10) and "he" or "gl"))
    local tip = (kind == "ap") and RGB(40, 40, 40) or ((kind == "heat") and RGB(70, 80, 60) or ((kind == "he") and RGB(80, 86, 64) or RGB(60, 70, 80)))
    -- 下层弹丸、上层药筒：真模型（125 毫米杀爆弹 / 发射药筒 dichevk、3BK18 破甲弹 VladIG_CG，CC-BY；弹底在原点、弹头朝 +Z → 转半圈，弹底朝转盘中间）
    local pk = (kind == "heat") and "ip_r125" or ((kind == "he") and "ip_he125" or nil)
    local proj = pk and b:prop("carousel", pk, tray * CF(0, 0.07, 0.27) * ANG(0, PI, 0), 0.58 / 0.71)
    if proj then for _, p in ipairs(proj) do table.insert(parts, p) end
    else table.insert(parts, b:cylZ("carousel", 0.58, 0.125, tray * CF(0, 0.07, -0.02), tip, MAT.Metal)) end                -- 下层：弹丸
    local chg = b:prop("carousel", "ip_chg125", tray * CF(0, 0.20, 0.29) * ANG(0, PI, 0), 0.52 / 0.43)
    if chg then for _, p in ipairs(chg) do table.insert(parts, p) end
    else
      table.insert(parts, b:cylZ("carousel", 0.52, 0.125, tray * CF(0, 0.20, 0.01), RGB(170, 156, 112), MAT.SmoothPlastic)) -- 上层：药筒
      table.insert(parts, b:cylZ("carousel", 0.03, 0.13, tray * CF(0, 0.20, 0.28), RGB(150, 128, 82), MAT.Metal))          -- 药筒底盘
    end
    cassettes[i + 1] = { parts = parts, a = a, kind = kind }
  end
  b:name("cassettes", cassettes)
  -- 炮塔篮地板（盖在转盘上面，中间有口子：从里面能看见弹盒）
  local PR = carved and 0.68 or 0.80   -- 挖了内腔的：盖板、栏杆也收进车体内宽里（跟着炮塔转，转到侧面不戳进车体侧壁）
  for i = 0, 11 do
    local a = (i + 0.5) * PI / 6
    if i % 3 ~= 1 then bx(T, 0.52, 0.03, carved and 0.48 or 0.56, math.sin(a) * PR, FY + 0.38, math.cos(a) * PR, FLOOR, MAT.DiamondPlate, 0, math.deg(a) + 90, 0) end
  end
  ring(b, T, 0, -0.38, 0, carved and 0.90 or 1.02, 12, 0.03, 0.03, C.lgray, MAT.Metal, -PI * 0.80, PI * 0.80)
  -- 提弹机（炮尾后面）：竖着的导轨、提弹架（子组 lift），链式推弹机
  bx(T, 0.06, 1.10, 0.06, -0.20, -0.45, 0.95, C.steel, MAT.Metal)
  bx(T, 0.06, 1.10, 0.06, 0.20, -0.45, 0.95, C.steel, MAT.Metal)
  b:group("lift", T, CF(0, FY + 0.20, 0.80))
  b:box("lift", V(0.42, 0.04, 0.70), CF(), RGB(110, 114, 106), MAT.Metal)
  b:box("lift", V(0.04, 0.30, 0.70), CF(-0.19, 0.15, 0), RGB(110, 114, 106), MAT.Metal)
  b:box("lift", V(0.04, 0.30, 0.70), CF(0.19, 0.15, 0), RGB(110, 114, 106), MAT.Metal)
  bx(T, 0.20, 0.16, 0.40, 0, 0.40, 1.18, C.dark, MAT.Metal)            -- 推弹机电机和链盒
  b:group("rammer", T, CF(0, 0.24, 1.10))
  b:box("rammer", V(0.08, 0.08, 0.50), CF(), RGB(60, 60, 58), MAT.Metal)
  b:cylZ("rammer", 0.04, 0.12, CF(0, 0, -0.26), C.steel, MAT.Metal)

  ---------------- 炮塔壳（挖了内腔的：壁、顶就是原车炮塔挖出来的内壁，这里只摆舱盖、抛壳窗）
  if not carved then
    for i = 0, 15 do
      local a = (i + 0.5) * PI / 8
      bx(T, 0.52, 0.03, 0.60, math.sin(a) * 1.30, 0.0, math.cos(a) * 1.30, CNW2, nil, 0, math.deg(a) + 90, 0)
    end
    for _, s in ipairs({ -1, 1 }) do
      bx(T, 0.05, RY, 1.70, s * 1.20, RY / 2, 0.25, CNW)
      local p0, p1 = V(s * 1.20, 0, -0.60), V(s * 0.46, 0, -1.18)
      local mid = (p0 + p1) / 2
      b:box(T, V((p1 - p0).Magnitude, RY, 0.05), CF(mid.X, RY / 2, mid.Z) * ANG(0, math.atan2(-(p1.Z - p0.Z), p1.X - p0.X), 0), CNW)
      bx(T, 0.05, RY, 0.36, s * 0.44, RY / 2, -1.36, CNW2)
    end
    bx(T, 0.92, RY, 0.05, 0, RY / 2, -1.55, CNW2)
    bx(T, 2.44, RY, 0.05, 0, RY / 2, 1.10, CNW2)                          -- 炮塔后壁
    -- 顶：车长舱口（右）、炮长舱口（左），后部的抛壳窗（子组 stubport）
    bx(T, 2.44, 0.05, 0.40, 0, RY + 0.025, 0.90, CNW)
    bx(T, 0.40, 0.05, 0.60, 0, RY + 0.025, 0.40, CNW)
    bx(T, 0.30, 0.05, 0.60, 1.07, RY + 0.025, 0.40, CNW)
    bx(T, 0.30, 0.05, 0.60, -1.07, RY + 0.025, 0.40, CNW)
    bx(T, 2.44, 0.05, 0.50, 0, RY + 0.025, -0.15, CNW)
    bx(T, 2.44, 0.05, 0.80, 0, RY + 0.025, -0.80, CNW)
    bx(T, 0.92, 0.05, 0.38, 0, RY + 0.025, -1.37, CNW)
    for _, z in ipairs({ -0.45, 0.10, 0.65 }) do bx(T, 2.4, 0.04, 0.05, 0, RY - 0.02, z, CNW2) end
  end
  for _, s in ipairs({ -1, 1 }) do
    local hn = (s > 0) and "chatch" or "ghatch"
    local hp = (s > 0) and HATCH.c or HATCH.g
    local hy = carved and turRoof(hp.X, hp.Z, RY) or RY   -- 挖了内腔的：舱盖贴着这一点的炮塔顶
    if not carved then ring(b, T, hp.X, hy + 0.035, hp.Z, (s > 0) and 0.44 or 0.42, 16, (s > 0) and 0.24 or 0.22, 0.03, CNW2) end
    ring(b, T, hp.X, hy + 0.02, hp.Z, 0.33, 16, 0.06, 0.06, CNW2, MAT.Metal)
    b:group(hn, T, CF(hp.X, hy + 0.10, hp.Z))
    b:cylY(hn, 0.05, 0.58, CF(), CNW, MAT.SmoothPlastic)
    b:grab(hn, V(-0.11, -0.03, 0.10), V(0.11, -0.03, 0.10), V(0, -0.05, 0), 0.02, C.black)
  end
  local sy = carved and turRoof(HATCH.stub.X, HATCH.stub.Z, RY) or RY
  b:group("stubport", T, CF(HATCH.stub.X, sy + 0.03, HATCH.stub.Z))
  b:box("stubport", V(0.26, 0.03, 0.22), CF(), RGB(170, 176, 166), MAT.Metal)

  ---------------- 主炮：ZPT-98A 125 毫米
  b:box(G, V(0.40, 0.36, 0.80), CF(0, 0, -0.10), RGB(100, 106, 98), MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do b:cylZ(G, 0.66, 0.085, CF(s * 0.15, 0.21, -0.02), C.steel, MAT.Metal) end
  b:group("recoil", G, CF())
  b:cylZ("recoil", 0.80, 0.26, CF(0, 0, -0.16), RGB(70, 76, 72), MAT.Metal)
  b:box("recoil", V(0.50, 0.46, 0.56), CF(0, -0.02, 0.58), RGB(66, 70, 66), MAT.Metal)
  b:cylZ("recoil", 0.04, 0.21, CF(0, 0.0, 0.875), RGB(90, 94, 90), MAT.Metal)
  b:group("blk", "recoil", CF(0, -0.02, 0.58))
  b:box("blk", V(0.30, 0.34, 0.28), CF(), RGB(122, 126, 120), MAT.Metal)
  for _, s in ipairs({ -1, 1 }) do
    b:box(G, V(0.04, 0.50, 0.78), CF(s * 0.38, -0.06, 0.82), RGB(96, 104, 90), MAT.Metal)
    b:box(G, V(0.05, 0.07, 0.78), CF(s * 0.38, 0.21, 0.82), RGB(230, 196, 40), MAT.SmoothPlastic)
  end
  b:placard(G, 0.30, 0.07, CF(-0.405, -0.02, 0.82) * ANG(0, PI / 2, 0), "后坐危险区", { bg = RGB(230, 196, 40) })
  b:placard(G, 0.30, 0.07, CF(0.405, -0.02, 0.82) * ANG(0, -PI / 2, 0), "后坐危险区", { bg = RGB(230, 196, 40) })
  b:box(G, V(0.10, 0.13, 0.74), CF(0.32, 0.02, -0.02), RGB(40, 42, 42), MAT.Metal)        -- 并列机枪
  b:box(T, V(0.28, 0.26, 0.40), CF(0.70, -0.50, -0.92), CNG)
  b:placard(T, 0.18, 0.06, CF(0.70, -0.42, -0.715) * ANG(0, PI, 0), "并列机枪弹", { bg = CNG, fg = C.white })

  ---------------- 炮长位（左）
  local gEye = V(-0.52, 0.30, -0.70)
  -- 主瞄准镜镜体：从目镜上沿一直到炮塔顶（镜头在顶上，镜体穿顶）——挖了内腔的截到这一块的顶（原来按 0.78 的顶画，戳出了挖出来的炮塔顶）
  local gTop = carved and math.min(0.78, (select(2, span(turQ, -0.77, -0.47, -0.88, -0.76))) or 0.78) - 0.005 or 0.78
  bx(T, 0.30, gTop - 0.34, 0.40, -0.62, (gTop + 0.34) / 2, -0.96, RGB(46, 50, 48))
  bx(T, 0.22, 0.18, 0.14, -0.55, 0.36, -0.86, RGB(36, 38, 40))
  b:cylZ(T, 0.07, 0.06, CF(-0.55, 0.33, -0.78), C.rubber, MAT.Fabric)
  b:box(T, V(0.24, 0.06, 0.08), CF(-0.55, 0.43, -0.80), C.rubber, MAT.Fabric)
  b:lens(T, CF(-0.55, 0.33, -0.744), 0.042)   -- 暗的镜片（不发绿光）
  b:placard(T, 0.14, 0.04, CF(-0.62, math.max(0.47, (gTop + 0.34) / 2 + 0.06), -0.755) * ANG(0, PI, 0), "主瞄准镜", { bg = C.black, fg = C.white })
  scr(b, T, "ip_cdu", 1.6, 0.20, 0.15, look(V(-0.86, 0.22, -0.80), gEye + V(0, -0.1, 0.1)), "fcscn", { keys = { top = { "主菜单", "弹种", "测距", "校炮", "激光" }, bottom = { "极性", "倍率", "火控", "自检", "复位" } }, lightK = 0.28 })   -- 火控计算机面板
  -- 炮长显示器（热像）：原来在 (-0.30, 0.52)，跑到了炮闩左边那块防护板（x = -0.38，顶到 0.55 以上）里边，炮长隔着防护板看不见
  --   （用户 11-22：屏幕会被挡住）——挪到炮长这边、主瞄准镜目镜下面（tools/mock/interior_occ.lua 查：眼睛到屏幕中间没有东西）
  --   挖了内腔的：炮塔前壁在 z ≈ −0.88（真车前装甲厚），z = −0.92 那块埋进了前壁——往后挪到壁前面
  b:screen(T, 0.18, 0.13, look(V(-0.50, 0.10, carved and -0.80 or -0.92), gEye), "gunsight", { lightK = 0.25 })
  b:tube(T, V(-0.55, FY + 0.40, -0.66), V(-0.55, -0.15, -0.68), 0.06, C.gray, MAT.Metal)
  bx(T, 0.30, 0.09, 0.12, -0.55, -0.10, -0.70, RGB(46, 48, 50))
  b:group("gch", T, CF(-0.55, -0.08, -0.70))
  for _, s in ipairs({ -1, 1 }) do   -- 两个握把：真模型（战斗机驾驶杆握把，扳机朝前），没有就拼的
    if not prop("gch", "ip_grip", CF(s * 0.14, 0.02, 0) * ANG(rad(-14), 0, 0), 1.0) then
      b:box("gch", V(0.05, 0.14, 0.05), CF(s * 0.14, 0.08, 0) * ANG(rad(-20), 0, 0), C.black)
      b:button("gch", CF(s * 0.14, 0.155, -0.04) * ANG(rad(-70), 0, 0), C.red, 0.012)
    end
  end
  seat(T, CF(-0.55, -0.40, -0.36), 0.72, 6, { w = 0.36, d = 0.32, back = 0.36, recline = 4, post = 0.25, col = RGB(46, 50, 44) })
  bx(T, 0.20, 0.18, 0.05, -0.55, -0.10, -0.92, RGB(46, 50, 44), MAT.Fabric)

  ---------------- 车长位（右）
  local cEye = V(0.56, 0.52, -0.10)
  local cTop = carved and math.min(0.81, (select(2, span(turQ, 0.47, 0.77, -0.67, -0.33))) or 0.81) - 0.005 or 0.81
  bx(T, 0.30, cTop - 0.43, 0.34, 0.62, (cTop + 0.43) / 2, -0.50, RGB(46, 50, 48))   -- 周视瞄准镜下部（穿顶）
  b:cylZ(T, 0.07, 0.06, CF(0.56, 0.52, -0.30), C.rubber, MAT.Fabric)
  b:lens(T, CF(0.56, 0.52, -0.264), 0.042)   -- 暗的镜片（不发绿光）
  scr(b, T, "ip_cdu", 1.9, 0.26, 0.19, look(V(0.82, 0.30, -0.42), cEye), "cnmap", { keys = { top = { "地图", "消息", "态势", "导航", "坐标" }, bottom = { "放大", "缩小", "标绘", "亮+", "亮-" } }, lightColor = RGB(150, 190, 230), lightK = 0.35 })   -- 综合显示终端
  -- 周视镜热像：原来 x = 0.36，在炮闩右边防护板（x = 0.38）里边，车长隔着防护板看（用户 11-22：屏幕会被挡住）——挪到车长这边
  scr(b, T, "ip_cdu", 1.4, 0.18, 0.13, look(V(0.50, 0.28, -0.46), cEye), "citvcn", { keys = { top = { "白热", "黑热", "宽视场", "窄视场" }, bottom = { "手动", "扫描", "随炮", "指示" } }, lightK = 0.25 })
  b:group("cch", T, CF(0.86, 0.02, -0.18))
  if not prop("cch", "ip_grip", CF(0, 0.0, 0) * ANG(rad(-12), 0, 0), 1.0) then b:box("cch", V(0.05, 0.13, 0.05), CF(0, 0.07, 0) * ANG(rad(-15), 0, 0), C.black) end
  b:tube(T, V(0.86, -0.40, -0.18), V(0.86, 0.0, -0.18), 0.04, C.gray, MAT.Metal)
  -- 车长右手边的面板、电台挂在炮塔右壁上，灭火瓶在左后——挖了内腔的：贴着量出来的侧壁、坐在量出来的炮塔地板上
  --   （原来 x = ±1.12～1.15，在挖出来的侧装甲里边；电台底下低过炮塔地板）
  local function wallX(s, z, y, d)
    if not carved then return d end
    local xl, xr = turQ:walls(z, y)
    local xm = (s > 0) and xr or (xl and -xl)
    return xm and math.min(d, xm - 0.02) or d
  end
  local pX = wallX(1, 0.10, 0.36, 1.15)
  swPanel(T, look(V(pX, 0.36, 0.10), V(0, 0.36, 0.10)), 1.2, 0.24, 0.18, 3, 4, RGB(60, 66, 60))
  local rX = carved and wallX(1, 0.55, 0.30, 1.29) - 0.14 or 1.15
  local rY = carved and ((turQ:floor(rX, 0.55) or 0.10) + 0.085) or 0.18
  b:radio(T, 0.34, 0.15, 0.28, look(V(rX, rY, 0.55), V(0, rY, 0.55)), RGB(64, 72, 60), "ip_radio2")
  seat(T, CF(0.58, -0.16, 0.30), 0.72, 8, { w = 0.38, d = 0.34, back = 0.34, recline = 6, post = 0.30, col = RGB(46, 50, 44) })
  local eX = carved and -(wallX(-1, 0.50, 0.30, 1.20) - 0.08) or -1.12
  b:extinguisher(T, CF(eX, carved and ((turQ:floor(eX, 0.50) or 0.0) + 0.19) or 0.10, 0.50), 0.36, 0.12)
  local function hr(x, z) return roofT(x, z) - 0.06 end   -- 线束、顶灯贴着那一点的顶
  local hz = carved and -0.80 or -1.05   -- 挖了内腔的：炮塔前壁在 −0.88，线束从壁前面起
  b:harness(T, { V(0.10, hr(0.10, hz), hz), V(0.40, hr(0.40, -0.55), -0.55), V(0.95, hr(0.95, -0.35), -0.35), V(1.10, 0.40, -0.25) }, 4, 0.02)
  b:harness(T, { V(-0.10, hr(-0.10, hz), hz), V(-0.40, hr(-0.40, -0.55), -0.55), V(-0.95, hr(-0.95, -0.35), -0.35), V(-1.10, 0.40, -0.25) }, 3, 0.02)
  b:light(T, CF(0, hr(0, 0.40), 0.40), "dome", RGB(255, 244, 228), 3.4, 1.1)
  b:light(T, CF(-0.60, hr(-0.60, -0.30), -0.30), "dome", RGB(255, 244, 228), 3.0, 0.9)
  b:light(T, CF(0.58, hr(0.58, 0.40) + 0.01, 0.40), "flash", RGB(255, 196, 120), 4.0, 0)
  b:light(T, CF(0.30, 0.40, -0.40), "warn", RGB(255, 40, 30), 3.0, 0)
  for _, p in ipairs({ V(0, roofT(0, 0.40) - 0.02, 0.40), V(-0.60, roofT(-0.60, -0.30) - 0.02, -0.30) }) do
    domeLamp(T, p + V(0, 0.02, 0), 0.9)
  end

  return {
    gunK = 0.30,   -- 125 毫米炮后坐行程约 300 毫米
    loader = "carousel",
    stations = {
      driver = { g = H, eye = eyeD, look = V(0, 0.15, -1), yaw = 110, up = 35, down = 55, crew = "driver",
        optics = { primary = { kind = "nv", name = "驾驶员微光夜视仪", g = H, pos = V(0, 0.06, -2.2), dir = "hull", fovs = { 42 }, ret = "none", look = "nv", shape = "rect" } } },
      gunner = { g = T, eye = gEye + V(-0.02, 0.06, 0.16), look = V(0, -0.18, -1), yaw = 120, up = 45, down = 60, crew = "gunner", sight = true, scope = V(-0.55, 0.33, -0.76),
        optics = { primary = { kind = "gps" },
          alt = { kind = "gas", name = "备用瞄准镜  8倍", g = G, pos = V(-0.24, 0.12, 0.40), dir = "gun", fovs = { 8 }, ret = "gascn", look = "day", shape = "circle", useSight = true } } },
      commander = { g = T, eye = cEye, look = V(0, -0.25, -1), yaw = 160, up = 70, down = 70, crew = "commander", scope = V(0.56, 0.52, -0.28),
        optics = { primary = { kind = "pano", name = "车长周视瞄准镜", g = T, pos = V(0.62, 1.15, -0.50), dir = "citv", fovs = { 20, 6 }, ret = "pano", look = "whot", shape = "circle" },
          alt = { kind = "gps" } } },
    },
    order = { "driver", "gunner", "commander" },
    lock = "gunner",   -- 坦克一进车默认炮长位（11-23 原来锁死在炮长位；用户 11-24：「我要能开别的位置」——F2～F5 照常换，Interior.lua）
    carved = carved,   -- 挖了内腔的那套：坐在车里外壳照样画（从里面看不见外壳的背面），显示内壁
    crew = {
      driver = { dress = "tank_cn", g = H, eye = eyeD, lean = dRoof and 40 or 32, yaw = 0, look = V(0, 0.1, -1),
        hands = hands,
        feet = { l = { H, V(-0.10, FY + 0.10, -2.92) }, r = { H, V(0.12, FY + 0.10, -2.90) } } },
      gunner = { dress = "tank_cn", g = T, eye = gEye + V(0, -0.02, 0.02), lean = -24, yaw = 0, look = V(0, -0.12, -1),
        hands = { l = { "gch", V(-0.14, 0.12, 0.0) }, r = { "gch", V(0.14, 0.12, 0.0) } },
        feet = { l = { T, V(-0.66, FY + 0.46, -0.78) }, r = { T, V(-0.44, FY + 0.46, -0.76) } } },
      commander = { dress = "tank_cn", g = T, eye = cEye, lean = -14, yaw = 0, look = V(0, -0.30, -1),
        hands = { l = { T, V(0.70, 0.22, -0.40) }, r = { "cch", V(0, 0.10, 0) } },
        feet = { l = { T, V(0.48, FY + 0.46, -0.10) }, r = { T, V(0.68, FY + 0.46, -0.10) } } },
    },
  }
end

---------------------------------------------------------------- 战斗机座舱（对标 DCS）：按机型的布局参数拼，原点在飞行员眼位，−Z 朝前
-- 共用：座舱浴盆（地板、两侧壁、后隔框）、两侧操纵台（开关面板朝上）、主仪表板、遮光罩、平显（组合玻璃 + 投影仪）、座舱盖框和玻璃
--   （玻璃有划痕、能反光，Interior.lua 再加迎着日月光时的眩光）、弹射座椅（头靠 / 降落伞箱、坐垫、救生包、弹射拉环、肩带）、
--   驾驶杆（中央杆 / 侧杆，跟着杆量动）、油门（跟着油门走）、脚蹬（跟着方向舵）、起落架手柄（跟着起落架收放，三个绿灯）、
--   主告警 / 注意灯、备份仪表（姿态、高度、空速）
--   L = { disp = "j20" / "f35" / "f22" / "j16" / "j15t" / "a10" / "pano", hud = true / false, hudW / hudH = 平显组合玻璃宽高,
--         hudFrame = "tall"（两根立柱 + 顶梁）/ "box"（厚圆角黑框）/ "wide"（歼-20：两根粗立柱往外斜）, hoop = { z, th, mirrors, struts, compass } 座舱盖前面那道拱框,
--         goldGlass = 座舱盖镀金（隐身机）, stick = "center" / "side",
--         seats = 1 / 2, cn = 中文标签, frame = 风挡有框, minScreens = 这一型真有几块屏（测试按它查，默认 5）, noRadar = 没有雷达（A-10C） }
-- 各型的屏幕块数、尺寸、摆法照网上查到的资料（docs/cockpit_research.md，出处写在里面；查不到的歼-35 用 pano 整块大屏）
local PIT = RGB(46, 50, 54)      -- 座舱漆：深灰
local PIT2 = RGB(36, 39, 42)
local GLARE = RGB(24, 25, 27)

function Defs.jet(b, ctx, L)
  local H = "hull"
  local function bx(sx, sy, sz, x, y, z, col, mat, rx, ry, rz)
    return b:box(H, V(sx, sy, sz), CF(x, y, z) * ANG(rad(rx or 0), rad(ry or 0), rad(rz or 0)), col, mat)
  end
  -- 眼睛往前挪 6 厘米（用户 11-22：第一人称开飞机离电子屏不够近）：屏、平显照旧摆在原来的地方（对着这个眼位转）
  local eye = V(0, -0.01, -0.06)
  local function look(p, at) return CFrame.lookAt(p, at or eye) end
  local cn = L.cn
  -- 浴盆
  bx(0.84, 0.03, 2.0, 0, -1.06, -0.35, PIT2, MAT.DiamondPlate)
  for _, s in ipairs({ -1, 1 }) do
    bx(0.03, 0.78, 2.0, s * 0.44, -0.67, -0.35, PIT)
    bx(0.04, 0.05, 1.7, s * 0.45, -0.29, -0.25, PIT2, MAT.Metal)                 -- 座舱盖导轨（舱沿）
    -- 两侧操纵台：台面上一块块开关面板（朝上偏向飞行员）
    bx(0.17, 0.10, 0.86, s * 0.345, -0.62, -0.04, PIT)
    for i = 0, 3 do
      local z = -0.38 + i * 0.21
      b:panel(H, 0.15, 0.17, CFrame.lookAt(V(s * 0.345, -0.565, z), V(s * 0.345 - s * 0.05, 0.4, z + 0.12)), 3, 3, RGB(54, 58, 62), { guard = (i == 1) })
    end
  end
  bx(0.86, 1.3, 0.04, 0, -0.42, 0.66, PIT2)                                      -- 后隔框
  bx(0.86, 0.04, 0.6, 0, -0.30, 0.94, PIT2, nil, -18, 0, 0)                     -- 座舱盖后面的整流罩里面
  -- 脚蹬（跟着方向舵前后）
  for _, s in ipairs({ -1, 1 }) do
    local gname = (s < 0) and "pedL" or "pedR"
    b:group(gname, H, CF(s * 0.13, -0.96, -1.05))
    b:box(gname, V(0.10, 0.20, 0.03), CF() * ANG(rad(-20), 0, 0), RGB(40, 42, 44), MAT.Metal)
    b:box(gname, V(0.10, 0.03, 0.10), CF(0, -0.10, 0.04), RGB(60, 62, 64), MAT.DiamondPlate)
  end
  -- 主仪表板 + 遮光罩
  local disp = L.disp or "pano"
  -- 平显下面有正前方控制板（UFC / ICP）的机型（用户 11-21 给的歼-20、歼-16、歼-15T 第一人称参考图，F-22 真机照片）：
  --   遮光罩中间让开控制板那么宽，平显投影仪改浅（原来往后伸到离眼 0.55 米，挡住控制板上半截），主显示器往下挪
  local UFCW = ({ j20 = 0.21, j16 = 0.20, j15t = 0.21, f22 = 0.17, f16 = 0.17, f15c = 0.17 })[disp]
  b:box(H, V(0.80, 0.46, 0.06), look(V(0, -0.46, -0.77), V(0, -0.1, 0.3)), PIT)
  bx(0.78, 0.05, 0.16, 0, -0.205, -0.78, GLARE, MAT.Fabric, 4, 0, 0)   -- 遮光罩：前沿离眼 0.70 米（原来 0.60，挡住下面小屏的上沿）
  -- 贴着仪表板面摆（显示器和面板同一个斜度，往外凸 m 米；原来朝着眼睛摆，往下挪了以后上半截埋进面板里）
  local PN, PU = V(0, 0.319, 0.948), V(0, 0.948, -0.319)   -- 面板法线（朝人）、面板的上
  local function flush(x, y, m)
    local p = V(x, y, -0.7416 - (y + 0.4504) * 0.3365) + PN * (m or 0.012)
    return CFrame.lookAt(p, p + PN, PU)
  end
  -- 上控制台（平显下面往人这边凸出来的一块，参考图里控制板、小圆表、备份姿态都装在它上面）：cons(x, y) 是它面上的一点（x 人看来往右）
  local CONSW = ({ j20 = 0.56, j16 = 0.56, j15t = 0.42, f22 = 0.56, pano = 0.56, a10 = 0.20, f16 = 0.42, f15c = 0.42 })[disp]
  local CONS = CONSW and CFrame.lookAt(V(0, -0.30, -0.7575), eye)
  if CONS then b:box(H, V(CONSW, 0.12, 0.085), CONS, PIT) end
  local function cons(x, y) return CONS * CF(-x, (y + 0.30) / 0.929, -0.0435) end
  bx(0.78, 0.30, 0.04, 0, -0.74, -0.95, PIT2, nil, 30, 0, 0)                   -- 膝下的面板（伸向脚蹬）
  -- 主告警、注意灯（遮光罩上，挨打 / 失速时闪）
  b:led(H, CF(-0.30, -0.17, -0.72), RGB(255, 40, 30), 0.022, "mwarn")
  b:led(H, CF(0.30, -0.17, -0.72), RGB(255, 180, 30), 0.022, "mcaut")
  b:placard(H, 0.07, 0.016, look(V(-0.30, -0.205, -0.697)), cn and "主告警" or "MASTER WARN", { bg = C.black, fg = RGB(255, 80, 70) })
  b:placard(H, 0.07, 0.016, look(V(0.30, -0.205, -0.697)), cn and "主注意" or "MASTER CAUT", { bg = C.black, fg = RGB(255, 190, 60) })
  -- 显示器
  local K = cn and { top = { "姿态", "雷达", "态势", "武器", "发动机" }, bottom = { "油量", "检查", "目标", "通信", "菜单" } }
    or { top = { "PFD", "RDR", "SA", "SMS", "ENG" }, bottom = { "FUEL", "CHK", "TGT", "COM", "MENU" } }
  -- 按机型照资料和参考图摆（docs/cockpit_research.md）；standby = 主显示器下面一排三个小圆表（备份姿态、空速、高度），有独立备份显示器的机型不要
  local standby = true
  -- 一排带字的键（平显下面的综合控制面板 ICP、正前方控制器 UFC）：rows = { { "COM1", … }, … }
  local function keypad(cf, w, rows)
    local base = b:box(H, V(w, 0.016 + #rows * 0.019, 0.03), cf * CF(0, 0, 0.016), RGB(30, 32, 34), MAT.Metal)
    base.CastShadow = false
    for r, row in ipairs(rows) do
      local n = #row
      for i, t in ipairs(row) do
        local kx = w / 2 - (i - 0.5) * w / n   -- 同屏幕边的键：第一个在人看来最左边
        b:placard(H, w / n * 0.82, 0.015, cf * CF(kx, (#rows + 1) / 2 * 0.019 - r * 0.019, -0.002), t, { bg = RGB(52, 55, 58), fg = RGB(225, 228, 222) })
      end
    end
  end
  local KC, KF = RGB(52, 55, 58), RGB(225, 228, 222)
  -- 正前方控制板（UFC / ICP）：底座 + 一块小液晶 + 四周的键；o = { sw, sh 小屏宽高, sy 小屏中心比底座中心高多少, page,
  --   top 上排键, left / right 两侧的键（人看来的左右）, cols 每侧几列, pad 小屏下面几排数字键, knobs 最下面几个旋钮 }
  local function ufcBox(cf, w, h, o)
    local base = b:box(H, V(w, h, 0.035), cf * CF(0, 0, 0.0175), RGB(30, 32, 34), MAT.SmoothPlastic)
    base.CastShadow = false
    local sw, sh, sy = o.sw, o.sh, o.sy or 0
    b:screen(H, sw, sh, cf * CF(0, sy, -0.0015), o.page or "ufcc", { lightK = 0.18, bezel = 0.004, depth = 0.004, ppm = 1800 })
    local function key(x, y, kw, kh, t) b:placard(H, kw, kh, cf * CF(x, y, -0.002), t, { bg = KC, fg = KF }) end
    local top = o.top or {}
    for i, t in ipairs(top) do key(sw / 2 - (i - 0.5) * sw / #top, sy + sh / 2 + 0.012, sw / #top * 0.8, 0.013, t) end
    local cols = o.cols or 1
    for _, side in ipairs({ 1, -1 }) do   -- 局部 +X 是人看来的左边
      local list = (side == 1) and (o.left or {}) or (o.right or {})
      local per = math.max(1, math.ceil(#list / cols))
      for i, t in ipairs(list) do
        local col, row = math.floor((i - 1) / per), (i - 1) % per
        key(side * (sw / 2 + 0.013 + col * 0.021), sy + sh / 2 - (row + 0.5) * sh / per, 0.017, math.min(0.012, sh / per * 0.82), t)
      end
    end
    for r, row in ipairs(o.pad or {}) do
      for i, t in ipairs(row) do key(sw / 2 - (i - 0.5) * sw / #row, sy - sh / 2 - 0.012 - (r - 1) * 0.016, sw / #row * 0.78, 0.013, t) end
    end
    local nk = o.knobs or 0
    for i = 1, nk do b:knob(H, cf * CF(w / 2 - (i - 0.5) * w / nk, -h / 2 + 0.013, 0), 0.015) end
  end
  if disp == "j20" then
    -- 歼-20（用户 11-21 给的真机座舱照片 + 资料：24 × 9 英寸触摸大屏、广角全息平显）：底下横贯一整块大屏，黑框很厚、上下一排螺钉
    --   （左窗上面一排小表 + 圆形雷达 + 目标表，中间飞机俯视挂弹，右半地图）；平显下面正中一块触摸屏控制板（蓝紫底 4 × 4 触摸键，
    --   装在厚黑框里，框两边几个小键）；控制板右边一块方形小屏（下面一排 4 个键），左边一块小开关板（大旋钮、小旋钮、方按钮、拨动开关）
    local KT = { top = { "态势", "雷达", "武器", "发动机", "油量" }, bottom = { "姿态", "通信", "导航", "检查", "菜单" } }
    local mcf = flush(0, -0.525)
    b:screen(H, 0.61, 0.23, mcf, "j20_main", { keys = KT, touch = true, touchH = 0.07, bezel = 0.024, frame = RGB(18, 18, 20), lightK = 0.5, lightColor = RGB(140, 180, 220) })
    for i = 0, 7 do
      for _, sy in ipairs({ -1, 1 }) do b:cylZ(H, 0.006, 0.009, mcf * CF(-0.29 + i * 0.58 / 7, sy * 0.127, -0.003), RGB(70, 72, 74), MAT.Metal) end
    end
    local ucf = cons(0, -0.305)   -- 控制板：厚黑框 + 触摸屏 + 框两边各三个小键（局部 +X 是人看来的左边）
    b:box(H, V(0.19, 0.135, 0.03), ucf * CF(0, 0, -0.015), RGB(20, 20, 22), MAT.SmoothPlastic)
    b:screen(H, 0.16, 0.105, ucf * CF(0, 0, -0.031), "ufct", { lightK = 0.25, bezel = 0.002, depth = 0.002, ppm = 1800, lightColor = RGB(150, 140, 230) })
    for _, sx in ipairs({ -1, 1 }) do
      for i = 0, 2 do b:button(H, ucf * CF(sx * 0.0875, 0.03 - i * 0.03, -0.031), RGB(44, 46, 48), 0.009) end
    end
    b:box(H, V(0.085, 0.10, 0.02), cons(0.175, -0.30) * CF(0, 0, -0.01), RGB(20, 20, 22), MAT.SmoothPlastic)   -- 右边方形小屏 + 4 个键
    b:screen(H, 0.062, 0.062, cons(0.175, -0.29) * CF(0, 0, -0.021), "sfd", { lightK = 0.2, ppm = 2200, bezel = 0.003, depth = 0.003 })
    for i = 0, 3 do b:button(H, cons(0.175 + (i - 1.5) * 0.017, -0.337) * CF(0, 0, -0.021), RGB(44, 46, 48), 0.011) end
    local lcf = cons(-0.18, -0.30)   -- 左边小开关板
    b:box(H, V(0.13, 0.075, 0.015), lcf * CF(0, 0, -0.0075), RGB(26, 27, 29), MAT.SmoothPlastic)
    b:knob(H, lcf * CF(0.04, -0.008, -0.015), 0.034)
    b:knob(H, lcf * CF(0.005, -0.008, -0.015), 0.018)
    b:button(H, lcf * CF(-0.025, -0.008, -0.015), RGB(40, 42, 44), 0.02)
    b:toggle(H, lcf * CF(-0.05, -0.008, -0.015))
    standby = false
  elseif disp == "f35" then
    -- F-35（用户 11-21 给的真机照片 + 资料：20 × 8 英寸全景屏，两块 10 × 8 英寸拼成，触摸，没有边框键；没有平显）：全景屏在仪表板最上面，
    --   两边斜的外壳；备份飞行显示器在大屏下面正中的竖立台上（台上还有一排小开关、旋钮、一块 3 × 3 按钮）；大屏正上方三个圆灯；右边黄黑条纹应急手柄
    b:screen(H, 0.254, 0.203, flush(-0.128, -0.44), "f35l", { keys = { top = { "TSD", "RDR", "FLT", "DAS", "TFLIR" } }, touch = true, touchH = 0.09, bezel = 0.006, lightK = 0.4, lightColor = RGB(140, 180, 220) })
    b:screen(H, 0.254, 0.203, flush(0.128, -0.44), "f35r", { keys = { top = { "FUEL", "ENG", "SMS", "CNI", "ICAWS" } }, touch = true, touchH = 0.09, bezel = 0.006, lightK = 0.4, lightColor = RGB(140, 180, 220) })
    for _, s in ipairs({ -1, 1 }) do
      b:box(H, V(0.045, 0.21, 0.05), flush(s * 0.283, -0.44, 0.02) * ANG(0, rad(-s * 28), 0), RGB(36, 38, 40), MAT.SmoothPlastic)
    end
    b:box(H, V(0.13, 0.28, 0.08), flush(0, -0.69, 0.045), RGB(52, 56, 60), MAT.SmoothPlastic)   -- 竖立台（贴着面板下半截往人这边凸）
    b:panel(H, 0.12, 0.035, flush(0, -0.575, 0.087), 1, 6, RGB(40, 43, 46), { depth = 0.02, kinds = { "t" } })
    b:panel(H, 0.045, 0.06, flush(-0.036, -0.635, 0.087), 2, 1, RGB(40, 43, 46), { depth = 0.02, kinds = { "k", "l" } })
    b:screen(H, 0.058, 0.058, flush(0.03, -0.635, 0.09), "sfd", { lightK = 0.2, ppm = 2400, bezel = 0.006, depth = 0.02 })
    b:panel(H, 0.10, 0.075, flush(0, -0.725, 0.087), 3, 3, RGB(40, 43, 46), { depth = 0.02, kinds = { "b" }, labels = false })
    b:box(H, V(0.09, 0.028, 0.03), flush(0, -0.315, 0.015), RGB(30, 32, 34), MAT.SmoothPlastic)   -- 大屏正上方三个圆灯
    for i = -1, 1 do b:led(H, flush(i * 0.026, -0.315, 0.032), RGB(235, 235, 225), 0.016) end
    for i = 0, 5 do b:box(H, V(0.03, 0.012, 0.03), flush(0.36, -0.40 - i * 0.012, 0.015), (i % 2 == 0) and C.yellow or C.black, MAT.SmoothPlastic) end
    standby = false
  elseif disp == "f22" then
    -- F-22（用户 11-21 给的真机照片 + 资料）：平显下 ICP（上排功能键、左边数字键、右边一列摇臂开关），两边上前显示器（左告警文字、
    --   右边就是备份飞行显示，所以没有单独的机械备份表）；下面一排三块：中间 8 × 8 英寸主显示器、两边 6.25 英寸副显示器一样高；膝间第四块
    local K1 = { top = { "TSD", "RDR", "SMS", "ENG", "CHK" }, bottom = { "RNG", "FLT", "FUEL", "COM", "MENU" } }
    b:screen(H, 0.203, 0.203, flush(0, -0.52), "f22_tsd", { keys = K1, lightK = 0.4 })
    b:screen(H, 0.159, 0.159, flush(-0.265, -0.50, 0.016), "f22_sms", { keys = K, lightK = 0.3 })   -- 左
    b:screen(H, 0.159, 0.159, flush(0.265, -0.50, 0.016), "f22_eng", { keys = K, lightK = 0.3 })    -- 右
    b:box(H, V(0.24, 0.30, 0.09), flush(0, -0.80, 0.05), RGB(40, 42, 44), MAT.SmoothPlastic)              -- 两膝之间的竖立台
    b:screen(H, 0.159, 0.159, flush(0, -0.775, 0.097), "mfd_pfd", { keys = K, lightK = 0.25 })
    b:screen(H, 0.085, 0.07, cons(-0.165, -0.30), "icaws", { lightK = 0.2 })
    b:screen(H, 0.085, 0.07, cons(0.165, -0.30), "sfd", { lightK = 0.2, ppm = 2200 })
    -- ICP（真机照片：没有屏幕）：上排 5 个功能键，左边 4 × 3 数字键，右边一列 5 个摇臂开关（局部 +X 是人看来的左边）
    local ic = cons(0, -0.30)
    local ib = b:box(H, V(0.16, 0.12, 0.035), ic * CF(0, 0, 0.0175), RGB(30, 32, 34), MAT.SmoothPlastic)
    ib.CastShadow = false
    for i, t in ipairs({ "COM1", "COM2", "NAV", "STPT", "IFF" }) do b:placard(H, 0.027, 0.013, ic * CF(0.064 - (i - 1) * 0.032, 0.05, -0.002), t, { bg = KC, fg = KF }) end
    for r, row in ipairs({ { "1", "2", "3" }, { "4", "5", "6" }, { "7", "8", "9" }, { "ENT", "0", "CLR" } }) do
      for i, t in ipairs(row) do b:placard(H, 0.024, 0.017, ic * CF(0.068 - (i - 1) * 0.028, 0.026 - (r - 1) * 0.022, -0.002), t, { bg = KC, fg = KF }) end
    end
    for r = 0, 4 do b:box(H, V(0.05, 0.010, 0.012), ic * CF(-0.045, 0.03 - r * 0.018, -0.006), RGB(60, 62, 64), MAT.SmoothPlastic) end
    standby = false
  elseif disp == "j16" then
    -- 歼-16（用户 11-21 给的「J-16 座舱环视」第一人称参考图；资料：下方几块多功能显示器换成了一整块大屏）：横贯一整块大屏
    --   （飞行 / 雷达 / 态势 / 告警四个窗口，上下各一条触摸菜单）；平显下面一块方的控制屏；左上开关板、右上备份姿态；
    --   大屏右边一块圆的告警屏和一块航向表，左边一竖条告警灯
    b:screen(H, 0.50, 0.215, flush(0, -0.51), "j16_main", { keys = K, touch = true, touchH = 0.085, bezel = 0.014, lightK = 0.45, lightColor = RGB(140, 180, 220) })
    ufcBox(cons(0, -0.30), 0.19, 0.13, { sw = 0.155, sh = 0.11, sy = 0, page = "ufc" })
    b:panel(H, 0.14, 0.08, cons(-0.19, -0.30), 2, 4, RGB(40, 43, 46), { depth = 0.03 })
    b:screen(H, 0.065, 0.065, cons(0.18, -0.30), "sfd", { lightK = 0.2, ppm = 2200, bezel = 0.008 })
    b:screen(H, 0.065, 0.065, flush(0.325, -0.43), "rwr", { lightK = 0.15, ppm = 2200, bezel = 0.01 })
    b:screen(H, 0.07, 0.07, flush(0.325, -0.55), "hsi", { light = false, ppm = 2200, bezel = 0.01 })
    b:box(H, V(0.05, 0.17, 0.03), flush(-0.315, -0.50, 0.015), RGB(30, 32, 34), MAT.SmoothPlastic)   -- 告警灯竖条
    for i = 0, 5 do
      for j = 0, 1 do
        b:led(H, flush(-0.315 + (j - 0.5) * 0.02, -0.43 - i * 0.027, 0.033), (i < 2) and RGB(255, 70, 50) or RGB(255, 190, 60), 0.013)
      end
    end
    standby = false
  elseif disp == "j15t" then
    -- 歼-15T（用户 11-21 给的第一人称参考图；查到的资料说换了整块大屏，用户给的图是三块屏，照图做）：三块带边框键的多功能显示器
    --   （左飞行、中雷达、右发动机）；平显下正前方控制板（液晶、两侧各两列键、上排键、5 个旋钮），左右各一个小圆表；
    --   三块屏下面一排机械备份表；左边竖条开关板（红保险盖），右边告警灯格栅
    b:screen(H, 0.13, 0.13, flush(-0.21, -0.50), "mfd_pfd", { keys = K, lightK = 0.3 })
    b:screen(H, 0.13, 0.13, flush(0, -0.50), "mfd_rdr", { keys = K, lightK = 0.3 })
    b:screen(H, 0.13, 0.13, flush(0.21, -0.50), "mfd_eng", { keys = K, lightK = 0.3 })
    ufcBox(cons(0, -0.30), 0.20, 0.13, { sw = 0.10, sh = 0.055, sy = 0.012, cols = 2,
      top = { "通1", "通2", "导航", "敌我", "高度", "自驾" }, left = { "1", "2", "3", "4", "5", "6" }, right = { "7", "8", "9", "0", "清", "输" }, knobs = 5 })
    b:screen(H, 0.05, 0.05, cons(-0.16, -0.30), "adi", { light = false, ppm = 2400, bezel = 0.008 })
    b:screen(H, 0.05, 0.05, cons(0.16, -0.30), "gmeter", { light = false, ppm = 2400, bezel = 0.008 })
    b:panel(H, 0.06, 0.16, flush(-0.36, -0.58), 4, 2, RGB(40, 43, 46), { depth = 0.03, guard = true })
    b:box(H, V(0.06, 0.16, 0.03), flush(0.36, -0.50, 0.015), RGB(30, 32, 34), MAT.SmoothPlastic)   -- 右边告警灯格栅
    for i = 0, 7 do b:box(H, V(0.05, 0.006, 0.004), flush(0.36, -0.43 - i * 0.02, 0.032), RGB(70, 72, 70), MAT.SmoothPlastic) end
    standby = { flush(0.10, -0.635), flush(0.17, -0.635), flush(0.24, -0.635) }
  elseif disp == "a10" then   -- A-10C：两块 4.9 英寸 MFCD（左 TAD、右外挂）、中间一列机械表、右下发动机表、平显下 UFC、右侧 CDU
    local KA = { top = { "TAD", "TGP", "DSMS", "MSG", "STAT" }, bottom = { "CDU", "HUD", "SYS", "LOAD", "MENU" } }
    b:screen(H, 0.124, 0.124, flush(-0.245, -0.47), "mfd_tad", { keys = KA, lightK = 0.3 })
    b:screen(H, 0.124, 0.124, flush(0.245, -0.47), "mfd_dsms", { keys = KA, lightK = 0.3 })
    b:screen(H, 0.085, 0.085, flush(0, -0.425), "adi", { light = false, ppm = 2200 })
    b:screen(H, 0.085, 0.085, flush(0, -0.55), "hsi", { light = false, ppm = 2200 })
    b:screen(H, 0.045, 0.045, flush(-0.105, -0.41), "asi", { light = false, ppm = 2200 })
    b:screen(H, 0.045, 0.045, flush(0.105, -0.41), "alt", { light = false, ppm = 2200 })
    b:screen(H, 0.045, 0.045, flush(0.105, -0.52), "vvi", { light = false, ppm = 2200 })
    b:screen(H, 0.18, 0.09, flush(0.20, -0.635), "gauges", { lightK = 0.15, light = false })
    b:screen(H, 0.09, 0.075, look(V(0.32, -0.52, -0.56)), "cdu", { lightK = 0.15 })
    keypad(cons(0, -0.30), 0.16, { { "1", "2", "3", "FUNC", "HACK" }, { "4", "5", "6", "LTR", "MK" }, { "7", "8", "9", "0", "ENT" } })
    standby = false
  elseif disp == "f16" then
    -- F-16C Block 50（没导入原模型时零件拼的；导入了用原模型自带的座舱，见 Defs.modelPit）：两块 4 英寸多功能显示器（边上 20 个按键），
    --   平显下面正前方控制板 ICP（数字键）、右边一块绿色数据输入显示器 DED；中间一列：空速 / 高度两个小圆表、姿态仪、下面航向仪
    local KF = { top = { "FCR", "HSD", "SMS", "FUEL", "FLT" }, bottom = { "RNG", "COM", "CHK", "TGT", "MENU" } }
    b:screen(H, 0.102, 0.102, flush(-0.205, -0.50), "f16l", { keys = KF, lightK = 0.3, ppm = 1800 })
    b:screen(H, 0.102, 0.102, flush(0.205, -0.50), "f16r", { keys = KF, lightK = 0.3, ppm = 1800 })
    keypad(cons(-0.02, -0.30), 0.12, { { "COM1", "COM2", "IFF", "LIST" }, { "1", "2", "3", "A-A" }, { "4", "5", "6", "A-G" }, { "7", "8", "9", "0" } })
    b:screen(H, 0.075, 0.032, cons(0.12, -0.30), "ded", { lightK = 0.12, ppm = 2400, bezel = 0.006, depth = 0.01 })
    b:screen(H, 0.05, 0.05, flush(-0.075, -0.43), "asi", { light = false, ppm = 2400 })
    b:screen(H, 0.05, 0.05, flush(0.075, -0.43), "alt", { light = false, ppm = 2400 })
    b:screen(H, 0.075, 0.075, flush(0, -0.505), "adi", { light = false, ppm = 2400 })
    b:screen(H, 0.075, 0.075, flush(0, -0.62), "hsi", { light = false, ppm = 2400 })
    standby = false
  elseif disp == "f15c" then
    -- F-15C（MSIP）：左上雷达垂直态势显示器 VSD（单色绿，B 显示）、右上雷达告警 TEWS（圆屏）、平显下正前方控制板 UFC；
    --   中间机械表（姿态仪、航向仪，两边空速、高度、升降速度），左下彩色多功能显示器 MPCD（外挂管理），右下发动机表
    local KV = { top = { "RNG", "TWS", "VS", "PDS", "SRCH" } }
    b:screen(H, 0.125, 0.125, flush(-0.235, -0.44), "vsd", { keys = KV, lightK = 0.25, ppm = 1600 })
    b:screen(H, 0.10, 0.10, flush(0.235, -0.44), "rwr", { light = false, ppm = 1800, bezel = 0.014 })
    b:screen(H, 0.085, 0.085, flush(0, -0.45), "adi", { light = false, ppm = 2200 })
    b:screen(H, 0.085, 0.085, flush(0, -0.58), "hsi", { light = false, ppm = 2200 })
    b:screen(H, 0.05, 0.05, flush(-0.105, -0.42), "asi", { light = false, ppm = 2400 })
    b:screen(H, 0.05, 0.05, flush(0.105, -0.42), "alt", { light = false, ppm = 2400 })
    b:screen(H, 0.05, 0.05, flush(0.105, -0.52), "vvi", { light = false, ppm = 2400 })
    b:screen(H, 0.125, 0.125, flush(-0.235, -0.62), "mfd_sms", { keys = { top = { "SMS", "PFD", "SA", "ENG", "MENU" } }, lightK = 0.25, ppm = 1600 })
    b:screen(H, 0.16, 0.09, flush(0.235, -0.62), "gauges", { lightK = 0.15, light = false })
    ufcBox(cons(0, -0.30), 0.17, 0.12, { sw = 0.11, sh = 0.03, sy = 0.035, page = "ded",
      left = { "1", "2", "3", "4" }, right = { "5", "6", "7", "8" }, pad = { { "9", "0", "CLR", "ENT" } } })
    standby = false
  elseif disp == "f14" then
    -- F-14A 前座：平显下面一块方的垂直显示器 VDI（绿色 CRT 姿态）、下面水平态势显示器 HSD；两边空速 / 迎角、高度 / 升降速度，右下发动机表
    b:screen(H, 0.125, 0.125, flush(0, -0.45), "vdi", { lightK = 0.2, ppm = 1600, bezel = 0.012 })
    b:screen(H, 0.115, 0.115, flush(0, -0.60), "tsd", { keys = { top = { "RNG", "NAV", "TID", "ECM", "MENU" } }, lightK = 0.2, ppm = 1600 })
    b:screen(H, 0.05, 0.05, flush(-0.13, -0.43), "asi", { light = false, ppm = 2400 })
    b:screen(H, 0.05, 0.05, flush(0.13, -0.43), "alt", { light = false, ppm = 2400 })
    b:screen(H, 0.05, 0.05, flush(0.13, -0.53), "vvi", { light = false, ppm = 2400 })
    b:screen(H, 0.05, 0.05, flush(-0.13, -0.53), "gmeter", { light = false, ppm = 2400 })
    b:screen(H, 0.16, 0.09, flush(0.26, -0.58), "gauges", { lightK = 0.15, light = false })
    b:screen(H, 0.075, 0.075, flush(-0.26, -0.47), "rwr", { light = false, ppm = 2000, bezel = 0.01 })
    standby = false
  elseif disp == "j8" then
    -- 歼-8II（1980 年代的模拟座舱）：仪表板正中一块圆的雷达显示器，两边、下面一圈机械表（姿态、航向、空速、高度、升降速度、过载），
    --   右边两台发动机的转速 / 排温表；有平显
    b:screen(H, 0.12, 0.12, flush(0, -0.45), "rscope", { lightK = 0.2, ppm = 1600, bezel = 0.016 })
    b:screen(H, 0.08, 0.08, flush(-0.17, -0.46), "adi", { light = false, ppm = 2200 })
    b:screen(H, 0.08, 0.08, flush(0, -0.59), "hsi", { light = false, ppm = 2200 })
    b:screen(H, 0.055, 0.055, flush(-0.27, -0.43), "asi", { light = false, ppm = 2400 })
    b:screen(H, 0.055, 0.055, flush(0.17, -0.43), "alt", { light = false, ppm = 2400 })
    b:screen(H, 0.055, 0.055, flush(0.17, -0.52), "vvi", { light = false, ppm = 2400 })
    b:screen(H, 0.055, 0.055, flush(-0.17, -0.57), "gmeter", { light = false, ppm = 2400 })
    b:screen(H, 0.15, 0.085, flush(0.27, -0.57), "gauges", { lightK = 0.15, light = false })
    standby = false
  else   -- pano（歼-35）：整块触摸大屏（资料只到「大横屏」），两边上前显示器照旧
    b:screen(H, 0.50, 0.21, flush(0, -0.505), "pano", { keys = K, touch = true, touchH = 0.09, lightK = 0.45, lightColor = RGB(140, 180, 220) })
    b:screen(H, 0.10, 0.07, cons(-0.17, -0.30), "ufd", { lightK = 0.2 })
    b:screen(H, 0.10, 0.07, cons(0.17, -0.30), "ufd2", { lightK = 0.2 })
  end
  -- 备份仪表（姿态、高度、空速）：主显示器下面一排小圆表
  if standby then
    local sp = (type(standby) == "table") and standby or { flush(-0.08, -0.635), flush(0.0, -0.635), flush(0.08, -0.635) }
    b:screen(H, 0.065, 0.065, sp[1], "adi", { light = false, ppm = 2200 })
    b:screen(H, 0.055, 0.055, sp[2], "asi", { light = false, ppm = 2200 })
    b:screen(H, 0.055, 0.055, sp[3], "alt", { light = false, ppm = 2200 })
  end
  -- 平显：投影仪 + 组合玻璃（符号按眼睛的位置算，真像在无穷远：Interior 的 hud 页）；歼-20 是广角平显，组合玻璃宽一些
  if L.hud ~= false then
    local hw, hh = L.hudW or 0.17, L.hudH or 0.14
    local HC = RGB(30, 32, 34)
    local gy = -0.125 + hh / 2   -- 组合玻璃中心（下沿贴着投影仪上面）
    -- 平显原模型（用户 11-22：「把飞机驾驶舱的光学瞄准屏直接搬来用」「j15t 原模型自带内饰」）：歼-15T 原模型自带座舱里的那套——
    --   黑色弧形框、上下两层组合玻璃、底座（tools/weapons/hud.mjs 抠出来，models/optics/hud15.glb）。L.hudModel 的机型导入了就换上，
    --   按组合玻璃的宽高对上符号那块屏（符号屏照旧正对着人、在玻璃中间：符号不变形）；底座沉进仪表板太多就整个往上挪一点
    local hm = L.hudModel and HUDM and HUDM[L.hudModel]
    local hf = hm and Kit.imported(L.hudModel)
    if hm and hf then
      local k = math.clamp(math.max(hw * 1.1 / hm.glass.w, hh * 1.05 / hm.glass.h), 0.7, 1.2)
      local fr = hm.parts.Frame
      local low = gy + (fr.c[2] - fr.s[2] / 2) * k
      if low < -0.23 then gy += -0.23 - low end
      local hcf = CF(0, gy, -0.66)
      for name, p in pairs(hm.parts) do
        local src = hf:FindFirstChild("O_" .. L.hudModel .. "__" .. name)
        if src and src:IsA("BasePart") then
          local mp = b:mesh(H, src, V(p.s[1], p.s[2], p.s[3]) * k, hcf * CF(V(p.c[1], p.c[2], p.c[3]) * k))
          if name == "Glass" then   -- 组合玻璃：几乎透明、一点绿（原模型的玻璃是半透明的黑，在 Roblox 里太暗）
            mp.CastShadow = false
            mp.Transparency = 0.9
            mp.Color = RGB(150, 205, 165)
          end
          b.hudModel = (b.hudModel or 0) + 1
        end
      end
    end
    if b.hudModel then
      -- 原模型：零件拼的投影仪、框不要
    else
    if UFCW then bx(hw + 0.03, 0.08, 0.16, 0, -0.165, -0.70, HC, MAT.Metal)
    else bx(hw + 0.03, 0.08, 0.22, 0, -0.165, -0.66, HC, MAT.Metal) end
    if L.hudFrame == "box" then   -- 歼-15T 参考图：一圈厚圆角黑框，左边一个小摄像盒
      local t = 0.022
      for _, sx in ipairs({ -1, 1 }) do bx(t, hh + t, 0.03, sx * (hw / 2 + t / 2), gy + t / 2, -0.665, HC, MAT.SmoothPlastic) end
      bx(hw + t * 2, t, 0.03, 0, gy + hh / 2 + t / 2, -0.665, HC, MAT.SmoothPlastic)
      for _, sx in ipairs({ -1, 1 }) do bx(0.03, 0.03, 0.03, sx * (hw / 2 - 0.004), gy + hh / 2 - 0.004, -0.665, HC, MAT.SmoothPlastic, 0, 0, 45) end   -- 圆角
      bx(0.022, 0.07, 0.03, -(hw / 2 + 0.04), gy - 0.01, -0.665, RGB(26, 26, 28), MAT.SmoothPlastic)
    elseif L.hudFrame == "wide" then   -- 歼-20 真机照片：广角平显，两根粗立柱往外斜，上面没有顶梁
      for _, sx in ipairs({ -1, 1 }) do bx(0.022, hh + 0.05, 0.02, sx * (hw / 2 + 0.014), gy + 0.012, -0.672, HC, MAT.SmoothPlastic, 0, 0, -sx * 10) end
    elseif L.hudFrame == "tall" then   -- 歼-16 参考图，F-22 真机：两根立柱 + 顶梁
      for _, sx in ipairs({ -1, 1 }) do bx(0.014, hh + 0.03, 0.014, sx * (hw / 2 + 0.006), gy + 0.008, -0.67, HC, MAT.Metal) end
      bx(hw + 0.026, 0.012, 0.014, 0, gy + hh / 2 + 0.018, -0.67, HC, MAT.Metal)
    else
      for _, sx in ipairs({ -1, 1 }) do bx(0.012, 0.15, 0.012, sx * (hw / 2), -0.07, -0.67, HC, MAT.Metal) end
    end
    end
    local hs = b:screen(H, hw, hh, CFrame.lookAt(V(0, gy, -0.66), V(0, gy + 0.025, 0.2)), "hud", { light = false, glow = 2.2, ppm = 3000, bezel = 0.004, depth = 0.004, noBack = true })
    hs.part.Material = MAT.Glass   -- 组合玻璃：真透明、带一点绿（原来后面垫着一块不透明黑底板）
    hs.part.Transparency = 0.93   -- 参考图：组合玻璃几乎看不见，只看得见框、一点反光和绿色符号
    hs.part.Reflectance = 0.06
    hs.part.Color = RGB(150, 205, 165)
    hs.root.BackgroundTransparency = 1
    b:name("hud", hs)
  end
  -- 驾驶杆
  if L.stick == "side" then
    b:group("stick", H, CF(0.33, -0.56, -0.10))
    b:box("stick", V(0.045, 0.12, 0.05), CF(0, 0.07, 0) * ANG(rad(-12), 0, 0), C.black)
    b:box("stick", V(0.05, 0.03, 0.06), CF(0, 0.14, -0.01), RGB(40, 40, 40))
    b:button("stick", CF(0, 0.155, -0.035) * ANG(rad(-70), 0, 0), C.red, 0.012)
    bx(0.08, 0.04, 0.12, 0.33, -0.575, -0.08, PIT2, MAT.Metal)
    bx(0.07, 0.03, 0.16, 0.30, -0.53, 0.06, RGB(40, 42, 44), MAT.Fabric)        -- 手臂托
  else
    b:group("stick", H, CF(0, -0.98, -0.33))
    b:tube("stick", V(0, 0, 0), V(0, 0.34, -0.05), 0.03, C.dark, MAT.Metal)
    b:box("stick", V(0.05, 0.13, 0.055), CF(0, 0.40, -0.06) * ANG(rad(-10), 0, 0), C.black)
    b:box("stick", V(0.055, 0.03, 0.065), CF(0, 0.47, -0.07), RGB(40, 40, 40))
    b:button("stick", CF(0, 0.485, -0.10) * ANG(rad(-70), 0, 0), C.red, 0.012)
    b:box("stick", V(0.012, 0.035, 0.012), CF(0, 0.40, -0.095), RGB(60, 60, 60))   -- 扳机
    b:cylY(H, 0.06, 0.12, CF(0, -1.0, -0.33), RGB(30, 30, 30), MAT.Fabric)      -- 杆根的防尘罩
  end
  -- 油门（左侧操纵台上，跟着油门推）
  b:group("thr", H, CF(-0.33, -0.57, 0.02))
  b:box("thr", V(0.03, 0.10, 0.03), CF(0, 0.05, 0) * ANG(rad(-25), 0, 0), C.dark, MAT.Metal)
  b:box("thr", V(0.07, 0.05, 0.08), CF(0, 0.11, -0.03), C.black)
  b:button("thr", CF(-0.025, 0.13, -0.05) * ANG(0, 0, 0), C.dark, 0.01)
  bx(0.04, 0.012, 0.22, -0.33, -0.565, -0.02, RGB(20, 20, 20))                    -- 油门滑槽
  -- 起落架手柄（主仪表板左边，带轮子形状的头）+ 三个绿灯
  --   F-22 两边副显示器占满了仪表板左边，手柄挪到左边那块的左上角外面
  local gp = (disp == "f22") and V(-0.39, -0.40, -0.745) or V(-0.37, -0.43, -0.735)
  b:group("gearh", H, CF(gp))
  b:box("gearh", V(0.015, 0.10, 0.015), CF(0, 0.05, 0), C.lgray, MAT.Metal)
  b:cyl("gearh", 0.025, 0.05, CF(0, 0.11, 0), C.white)
  for i = -1, 1 do b:led(H, CF(gp + V(0.04 + i * 0.022, 0.09, -0.005)), RGB(80, 255, 110), 0.012, "gear") end
  b:placard(H, 0.06, 0.016, look(gp + V(0, 0.11, 0)), cn and "起落架" or "LDG GEAR", { bg = C.black, fg = C.white })
  -- 弹射座椅
  local SC = RGB(54, 58, 54)
  b:seat(H, CF(0, -0.80, 0.14), { w = 0.46, d = 0.44, back = 0.70, recline = 16, head = false, col = RGB(58, 62, 56), frame = RGB(44, 46, 48) })
  bx(0.36, 0.30, 0.16, 0, 0.06, 0.36, SC, nil, 16, 0, 0)                          -- 头靠 / 降落伞箱
  bx(0.40, 0.08, 0.14, 0, 0.24, 0.40, RGB(36, 38, 40), nil, 16, 0, 0)
  bx(0.48, 0.12, 0.44, 0, -0.90, 0.14, RGB(70, 72, 60))                            -- 救生包
  for _, s in ipairs({ -1, 1 }) do
    bx(0.04, 0.95, 0.06, s * 0.26, -0.42, 0.34, SC, MAT.Metal, 16, 0, 0)            -- 座椅导轨
    bx(0.03, 0.03, 0.30, s * 0.20, -0.25, 0.06, RGB(60, 70, 50), MAT.Fabric, -50, 0, 0)   -- 肩带
  end
  -- 弹射拉环（黄黑相间，坐垫前面两腿之间）
  for i = 0, 3 do bx(0.025, 0.025, 0.02, -0.04 + i * 0.027, -0.80, -0.11, (i % 2 == 0) and C.yellow or C.black) end
  b:placard(H, 0.10, 0.022, CF(0, -0.765, -0.10) * ANG(rad(-60), 0, 0), cn and "弹射" or "EJECT", { bg = C.yellow, fg = C.black })
  -- 座舱盖玻璃（有划痕；Interior 迎着日月光加眩光）。用户 11-21：原来八条平板拼的，看着是多边形；进游戏像塑料——
  --   改成截面半圆的管子（一圈 24 条窄条）+ 往前收成弹头形的风挡曲面（5 圈），看不出棱；
  --   Roblox 画质低时玻璃材质没有折射、按塑料受光，原来的浅灰蓝受光后发白发灰像塑料膜：颜色压暗、更透、加一点反光；
  --   隐身机的座舱盖镀了一层金（goldGlass），从里面看微微发暖
  local glass, panes = {}, {}
  local R0, cy0 = 0.52, -0.24
  local zf, zr, Lf = -0.80, 0.57, 0.30
  local GC = L.goldGlass and RGB(72, 62, 44) or RGB(54, 62, 68)
  local function pane(cf, w, l)
    local g = b:box(H, V(w, 0.006, l), cf, GC, MAT.Glass)
    g.Transparency, g.Reflectance, g.CastShadow = 0.9, 0.12, false
    table.insert(panes, g)
    return g
  end
  local NG = 24
  for i = 0, NG - 1 do   -- 管子：从左舱沿翻过头顶到右舱沿
    local a0, a1 = rad(-90 + i * 180 / NG), rad(-90 + (i + 1) * 180 / NG)
    local am = (a0 + a1) / 2
    local rc = R0 * math.cos((a1 - a0) / 2)
    local g = pane(CF(math.sin(am) * rc, cy0 + math.cos(am) * rc, (zf + zr) / 2) * ANG(0, 0, -am), 2 * R0 * math.sin((a1 - a0) / 2), zr - zf)   -- 正好拼上不重叠（重叠的地方透明度叠两层，看着是一道道细线）
    if (i - NG / 2) % 3 == 0 then table.insert(glass, 1 + ((i == NG / 2) and 0 or #glass), g) end   -- 带划痕的几条（正上方那条排第一）
  end
  -- 风挡：管子前端往前收成弹头形（t = 0 管口，1 尖）；每圈每条一块，四个角取在曲面上
  local function ring(t) return zf - Lf * math.sin(t * PI / 2), R0 * math.cos(t * PI / 2) ^ 0.6 end
  local function onRing(a, z, r) return V(math.sin(a) * r, cy0 + math.cos(a) * r, z) end
  local MG = 5
  for k = 0, MG - 1 do
    local z0, r0 = ring(k / MG)
    local z1, r1 = ring((k + 1) / MG)
    for i = 0, NG - 1 do
      local a0, a1 = rad(-90 + i * 180 / NG), rad(-90 + (i + 1) * 180 / NG)
      local A, B, C2, D = onRing(a0, z0, r0), onRing(a1, z0, r0), onRing(a0, z1, r1), onRing(a1, z1, r1)
      local xv = ((B - A) + (D - C2)) / 2
      local mv = (C2 + D) / 2 - (A + B) / 2
      local X = xv.Unit
      local Z = (mv - X * mv:Dot(X)).Unit
      local Y = Z:Cross(X)
      local w = math.max((B - A).Magnitude, (D - C2).Magnitude)
      local g = pane(CFrame.fromMatrix((A + B + C2 + D) / 4, X, Y, X:Cross(Y)), w, mv.Magnitude)
      if k == 1 and math.abs(i - NG / 2 + 0.5) < 3 then table.insert(glass, g) end   -- 正前方几块也带划痕（迎着太阳看得见）
    end
  end
  b:name("glass", glass)
  -- 光滑的座舱盖（用户 11-22：「飞机不要搞多边形的座舱盖，一反光看着太难受了，就要弧形」）：同一个曲面（半圆管子 + 弹头形风挡）
  --   一圈圈截面（z、半径）交给 Interior，用 EditableMesh 拼成一整块光滑的网格（法线按曲面算、两面都有，从里面也看得见）；
  --   拼成了上面这些平板就不画了（带划痕的几块只留划痕）。没开 Mesh API 拼不成：还用平板，反光调弱（棱上的反光不那么扎眼）
  local rows = {}
  for i = 0, 4 do table.insert(rows, { z = zr + (zf - zr) * i / 4, r = R0 }) end
  local MR = 12
  for k = 1, MR do
    local z, r = ring(k / MR)
    table.insert(rows, { z = z, r = math.max(r, 0.004) })
  end
  -- std：这一组数（R0、cy0、zf、zr、Lf）和导入用的光滑座舱盖网格（tools/weapons/gen_canopy.mjs → models/optics/ip_canopy.glb）一样，Interior 优先用导入的
  local canopy = { rows = rows, cy = cy0, cols = 48, color = GC, panes = panes, refl = 0.1, trans = L.goldGlass and 0.86 or 0.88,
    std = (R0 == 0.52 and cy0 == -0.24 and zf == -0.80 and zr == 0.57 and Lf == 0.30) }
  if L.hoop then
    local R1, cyh, th, z = 0.50, -0.24, L.hoop.th or 0.05, L.hoop.z or -0.80
    local n = 16
    for i = 0, n - 1 do
      local a0, a1 = rad(-96 + i * 192 / n), rad(-96 + (i + 1) * 192 / n)
      local am = (a0 + a1) / 2
      local len = 2 * R1 * math.sin((a1 - a0) / 2) * 1.08
      bx(len, th, 0.045, math.sin(am) * R1, cyh + math.cos(am) * R1, z, RGB(32, 34, 36), MAT.SmoothPlastic, 0, 0, -math.deg(am))
    end
    for _, ad in ipairs(L.hoop.mirrors or {}) do   -- 后视镜：挂在拱框里沿，镜面朝着人
      local a = rad(ad)
      local r = R1 - th / 2 - 0.03
      local pm = V(math.sin(a) * r, cyh + math.cos(a) * r, z + 0.03)
      b:tube(H, V(math.sin(a) * (R1 - th / 2), cyh + math.cos(a) * (R1 - th / 2), z), pm, 0.01, RGB(40, 42, 44), MAT.Metal)
      local m = b:box(H, V(0.11, 0.042, 0.008), CFrame.lookAt(pm, eye) * ANG(0, 0, a), RGB(200, 210, 215), MAT.Glass)
      m.Reflectance, m.CastShadow = 0.6, false
    end
    for _, sx in ipairs(L.hoop.struts and { -1, 1 } or {}) do   -- 两根斜撑：遮光罩两角斜着连到拱框
      local a = rad(sx * 44)
      b:tube(H, V(sx * 0.13, -0.18, -0.72), V(math.sin(a) * (R1 - th / 2), cyh + math.cos(a) * (R1 - th / 2), z), 0.016, RGB(36, 38, 40), MAT.Metal)
    end
    if L.hoop.compass then   -- 备用磁罗盘：吊在拱框右上
      local a = rad(36)
      local pc = V(math.sin(a) * (R1 - th / 2 - 0.06), cyh + math.cos(a) * (R1 - th / 2 - 0.06), z + 0.03)
      b:tube(H, V(math.sin(a) * (R1 - th / 2), cyh + math.cos(a) * (R1 - th / 2), z), pc, 0.012, RGB(40, 42, 44), MAT.Metal)
      b:cylZ(H, 0.04, 0.056, CF(pc + V(0, -0.035, 0)), RGB(34, 36, 38), MAT.SmoothPlastic)
      local face = b:cylZ(H, 0.004, 0.044, CF(pc + V(0, -0.035, 0.021)), RGB(225, 222, 200), MAT.SmoothPlastic)
      face.CastShadow = false
    end
  end
  if L.frame and not L.hoop then   -- 风挡框、后视镜
    for _, s in ipairs({ -1, 1 }) do bx(0.03, 0.55, 0.04, s * 0.30, 0.0, -0.92, RGB(40, 42, 44), MAT.Metal, -40, 0, s * 12) end
    bx(0.62, 0.03, 0.05, 0, 0.26, -0.80, RGB(40, 42, 44), MAT.Metal)
    for i = -1, 1 do
      local m = bx(0.10, 0.045, 0.01, i * 0.16, 0.22, -0.78, RGB(200, 210, 215), MAT.Glass, 10, 0, 0)
      m.Reflectance = 0.6
    end
  else
    bx(0.90, 0.04, 0.05, 0, 0.30, 0.48, RGB(40, 42, 44), MAT.Metal)               -- 后拱框
  end
  -- 座舱灯（夜间：仪表泛光照明，泛绿白）
  b:light(H, CF(0, -0.30, -0.55), "dome", RGB(200, 230, 255), 1.6, 0.25)
  b:light(H, CF(-0.36, -0.40, -0.10), "dome", RGB(200, 230, 255), 1.0, 0.18)
  b:light(H, CF(0.36, -0.40, -0.10), "dome", RGB(200, 230, 255), 1.0, 0.18)
  b:light(H, CF(0, -0.10, -0.50), "warn", RGB(255, 40, 30), 1.6, 0)
  local dress = cn and "pilot_cn" or "pilot_us"
  local crew = {
    pilot = { dress = dress, g = H, eye = eye, lean = 4, yaw = 0, look = V(0, -0.05, -1),
      hands = { r = { "stick", (L.stick == "side") and V(0, 0.10, 0.0) or V(0, 0.42, -0.06) }, l = { "thr", V(0, 0.12, -0.02) } },
      feet = { l = { "pedL", V(0, -0.04, 0.06) }, r = { "pedR", V(0, -0.04, 0.06) } } },
  }
  local stations = { pilot = { g = H, eye = eye, look = V(0, -0.02, -1), yaw = 150, up = 80, down = 60, crew = "pilot" } }
  local order = { "pilot" }
  if L.seats == 2 then   -- 后舱（武器系统官）：高一截、往后 1.15 米；同样的显示器
    local ry, rz = 0.22, 1.15
    bx(0.84, 0.03, 1.1, 0, -1.06 + ry, rz - 0.1, PIT2, MAT.DiamondPlate)
    for _, sx in ipairs({ -1, 1 }) do bx(0.03, 0.78, 1.1, sx * 0.44, -0.67 + ry, rz - 0.1, PIT) end
    if L.rio then   -- F-14 后座（RIO）：正中一块 9 英寸的圆形战术信息显示器 TID（俯视的空情），左上方雷达细节数据显示器 DDD
      b:screen(H, 0.23, 0.23, look(V(0, -0.42 + ry, rz - 0.72), V(0, ry, rz)), "tid", { lightK = 0.3, ppm = 1200, bezel = 0.02 })
      b:screen(H, 0.12, 0.12, look(V(-0.21, -0.25 + ry, rz - 0.74), V(0, ry, rz)), "vsd", { keys = { top = { "RNG", "PD", "PDS", "RWS", "TWS" } }, lightK = 0.2, ppm = 1600 })
    else
      b:screen(H, 0.15, 0.15, look(V(-0.17, -0.40 + ry, rz - 0.72), V(0, ry, rz)), "mfd_sa", { keys = K, lightK = 0.25 })
      b:screen(H, 0.15, 0.15, look(V(0.17, -0.40 + ry, rz - 0.72), V(0, ry, rz)), "mfd_sms", { keys = K, lightK = 0.25 })
    end
    b:seat(H, CF(0, -0.80 + ry, rz + 0.14), { w = 0.46, d = 0.44, back = 0.70, recline = 16, col = RGB(58, 62, 56), frame = RGB(44, 46, 48) })
    bx(0.36, 0.30, 0.16, 0, 0.06 + ry, rz + 0.36, SC, nil, 16, 0, 0)
    crew.wso = { dress = dress, g = H, eye = V(0, ry, rz), lean = 4, yaw = 0, look = V(0, -0.1, -1),
      hands = { l = { H, V(-0.12, -0.45 + ry, rz - 0.35) }, r = { H, V(0.12, -0.45 + ry, rz - 0.35) } },
      feet = { l = { H, V(-0.12, -0.98 + ry, rz - 0.75) }, r = { H, V(0.12, -0.98 + ry, rz - 0.75) } } }
    stations.wso = { g = H, eye = V(0, ry, rz), look = V(0, -0.05, -1), yaw = 150, up = 80, down = 60, crew = "wso" }
    table.insert(order, "wso")
  end
  return { air = true, stations = stations, order = order, crew = crew, cn = cn, glass = glass, canopy = canopy, minScreens = L.minScreens, noRadar = L.noRadar }
end

---------------------------------------------------------------- 原模型自带的座舱（用户 11-23：「你去找带内饰的然后给他们屏幕实现功能就行」）
-- 座舱就是原模型的那套（AirModels 里的 Pit 组：座舱视角里不藏，Interior.zoneParts），这里只在原模型的显示器、圆表、平显上贴我们的实时画面：
--   位置在 ImportedAir 元数据的 pitScr（tools/models/sf_air.py 按原模型量的：中心、朝人的法线、上方、宽高，模型坐标·格），眼位是元数据的 pit；
--   多功能显示器四周原模型的按键条上盖一排能按的键帽（印字、背光）；圆表的画面裁成圆的；原模型的平显（组合玻璃上画死了符号）藏起来，
--   换成会动的平显——透明组合玻璃 + 两根细立柱、顶梁
-- L = { pages 换掉元数据里写的页面, keys = { 屏幕名 = { top = {…}, bottom = {…} } }, keyGap 按键条在显示区外多远（米）, cn 中文 }
function Defs.modelPit(b, ctx, L)
  local H = "hull"
  local I = ctx.imp.info
  local e = I.pit[1]
  local eyeM = V(e[1], e[2], e[3])
  local SS = Kit.S
  local hasHud = false
  local function place(o, push)   -- 模型坐标（格）→ 眼位为原点的米；push 往人这边挪一点（贴在原模型的玻璃前面）
    local n = V(o.n[1], o.n[2], o.n[3]).Unit
    local u = V(o.u[1], o.u[2], o.u[3]).Unit
    local p = (V(o.c[1], o.c[2], o.c[3]) - eyeM) / SS + n * (push or 0.0025)
    return CFrame.lookAt(p, p + n, u), o.w / SS, o.h / SS
  end
  local names = {}
  for name in pairs(I.pitScr) do table.insert(names, name) end
  table.sort(names)   -- 每次建的顺序一样（测试、键位稳定）
  for _, name in ipairs(names) do
    local o = I.pitScr[name]
    local cf, w, h = place(o)
    local page = (L.pages and L.pages[name]) or o.page
    if page == "hud" then
      hasHud = true
      local hs = b:screen(H, w, h, cf, "hud", { light = false, glow = 2.2, ppm = 3000, bezel = 0.003, depth = 0.003, noBack = true })
      hs.part.Material = MAT.Glass
      hs.part.Transparency = 0.93
      hs.part.Reflectance = 0.06
      hs.part.Color = RGB(150, 205, 165)
      hs.root.BackgroundTransparency = 1
      b:name("hud", hs)
      for _, sx in ipairs({ -1, 1 }) do   -- 组合玻璃两边的细立柱、顶梁（原模型的平显块藏起来了）
        b:box(H, V(0.007, h + 0.012, 0.012), cf * CF(sx * (w / 2 + 0.0045), 0.004, 0.004), RGB(30, 32, 34), MAT.Metal)
      end
      b:box(H, V(w + 0.016, 0.008, 0.012), cf * CF(0, h / 2 + 0.008, 0.004), RGB(30, 32, 34), MAT.Metal)
    elseif o.round then   -- 圆表：画面裁成圆的、贴在原模型表盘上（表框是原模型的）
      local s2 = b:screen(H, w, h, cf, page, { light = false, ppm = 2400, bezel = 0.001, depth = 0.002, noBack = true })
      s2.part.Transparency = 1
      local cr = Instance.new("UICorner")
      cr.CornerRadius = UDim.new(0.5, 0)
      cr.Parent = s2.root
    else
      -- 多功能显示器：显示区上下原模型的按键条上各一排 5 个键帽。
      --   雕进原模型的（元数据有 d，tools/models/sf_air.py 的 carve：用户 11-24「我需要你在原模型上雕刻显示屏哈」）：o.c 已经在槽底，
      --   屏幕贴着槽底（只往外让 0.8 毫米），键帽摆回边框面上原来的按键那儿（屏幕平面往外 d）——玻璃比边框、按键低一截，像真的 MFD
      local carved = o.d ~= nil
      if carved then cf, w, h = place(o, 0.0008) end
      local lift = carved and (o.d / SS - 0.0008 + 0.0035) or 0.003   -- 键帽中心在屏幕平面前面多远（米）
      local ks = L.keys and L.keys[name]
      local gap = L.keyGap or 0.0045
      local kp
      if ks then
        kp = {}
        for _, side in ipairs({ "top", "bottom" }) do
          local list = ks[side] or {}
          kp[side] = {}
          for i = 1, #list do
            local x = w / 2 - (i - 0.5) * w / #list
            kp[side][i] = { x, ((side == "top") and 1 or -1) * (h / 2 + gap), w / #list * 0.82, 0.0068, -lift }
          end
        end
      end
      b:screen(H, w, h, cf, page, { keys = ks, keyPos = kp, noBack = true, bezel = 0.001, depth = 0.002, ppm = L.ppm or 2400,
        lightK = 0.18, lightRange = 0.5, keyCol = RGB(40, 42, 44), keyFg = RGB(220, 226, 214) })
    end
  end
  b:light(H, CF(0, -0.25, -0.45), "dome", RGB(200, 230, 255), 1.2, 0.2)
  b:light(H, CF(0, -0.10, -0.40), "warn", RGB(255, 40, 30), 1.4, 0)
  local stations = { pilot = { g = H, eye = V(0, 0, 0), look = V(0, -0.02, -1), yaw = 150, up = 80, down = 60, crew = "pilot" } }
  return { air = true, modelPit = true, stations = stations, order = { "pilot" }, crew = {}, cn = L.cn, glass = {}, minScreens = L.minScreens,
    noHud = not hasHud }
end
-- 导入了带座舱的原模型（元数据里有 pitScr 和眼位）就用原模型的座舱，没导入（零件拼的飞机）照旧拼
local function hasModelPit(ctx)
  local imp = ctx and ctx.imp
  local I = imp and imp.info
  return I and I.pitScr and I.pit and I.pit[1] and true or false
end
Defs.hasModelPit = hasModelPit

-- 各型照 docs/cockpit_research.md：minScreens 这一型真有几块屏（测试按它查）、noRadar 没有雷达（A-10C）
Defs.j20 = function(b, ctx) return Defs.jet(b, ctx, { hudModel = "hud15", disp = "j20", hud = true, hudW = 0.21, hudH = 0.16, hudFrame = "wide", stick = "center", cn = true, goldGlass = true, minScreens = 4,
  hoop = { z = -0.80, th = 0.05, mirrors = { 0, -52, 52 }, struts = true } }) end
