    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">CavityMeta</string>
        <ProtectedString name="Source"><![CDATA[-- 自动生成（tools/models/carve.py），别手改：从原车模型挖出来的内腔（用户 11-23「在原车内部雕刻出来内饰」），内饰代码按它摆东西
--   [模型键] = { spaces[空间名] = { g 部件组（Body 车体 / Turret 炮塔）, vol 体积（格³）, hm 高度表 }, win 窗户（玻璃块：c 中心、n 朝外的法线、up、w 宽、h 高） }
--   高度表：x0 / z0 第一列的位置、d 列距、nx × nz 列（x 外层、z 内层），每列内腔的地板 lo、顶 hi（16 位，y0..y1 线性，65535 = 这一列没有内腔），base64
--   坐标同 ImportedMeta：格，原点车底中心，X 右、Y 上、−Z 朝前
