    ["eco.round"] = "+{1} pièces cette manche",
    ["eo.hint"] = "[P] quitter la nacelle · souris orienter · molette zoom\n[Z] large / étroit · [V] blanc chaud / noir chaud / TV\n[R] cible suivante · clic larguer / tirer · le pilote automatique maintient le vol en palier",
    ["eo.range"] = "DIST",
    ["eo.sayArea"] = "Orientez pour chercher, molette pour zoomer.",
    ["eo.sayHold"] = "Arme larguée. Gardez la nacelle sur la cible.",
    ["eo.sayPoint"] = "Cible suivie. Cliquez pour larguer.",
    ["eo.title"] = "NACELLE EO",
    ["faction.atk.desc"] = "Frayez-vous un chemin depuis la mer : prenez l'avant-poste A, débarquez sur l'île principale pour prendre le port C et l'aérodrome D, puis emparez-vous du commandement E. Une fois à terre, réapparaissez à la position d'assaut devant chaque objectif. Chaque mort coûte un renfort ; à court de renforts, vous perdez.",
    ["faction.atk.desc@city"] = "Partez de la base principale au sud (parc de véhicules, héliports et piste à l'intérieur) : prenez l'aciérie A, puis le parc B, la place centrale C et la gare D, et enfin la tour de télévision E au nord. Rues étroites et bâtiments bouchent la vue : surveillez les angles et les trouées. Les arbres tombent quand on les percute ; les obus peuvent abattre les bâtiments.",
    ["faction.atk.desc@sands"] = "Remontez vers le nord depuis la base avancée et la piste : percez le talus frontalier et prenez le poste A, puis le champ pétrolier B, la ville C et la base aérienne D, et enfin le commandement E sur la crête. Réapparaissez à la position d'assaut devant chaque objectif. Chaque mort coûte un renfort ; à court de renforts, vous perdez.",
    ["faction.atk.desc@snow"] = "Partez de la base principale au sud (parc de véhicules, héliports et piste à l'intérieur) : prenez la scierie A, puis la station radar B sur le versant ouest, le village C au bord de la rivière, la centrale D près du lac gelé et enfin le col E au nord. La vallée regorge de crêtes et de ravines : combattez caisse masquée derrière les crêtes — aucun abri sur la glace.",
    ["faction.atk.role"] = "ATTAQUE  ·  ASSAUT AMPHIBIE",
    ["faction.atk.role@city"] = "ATTAQUE  ·  ENTREZ PAR LE SUD",
    ["faction.atk.role@sands"] = "ATTAQUE  ·  ASSAUT BLINDÉ",
    ["faction.atk.role@snow"] = "ATTAQUE  ·  REMONTEZ LA VALLÉE",
    ["faction.def.desc"] = "Tenez la ligne, secteur par secteur : défendez les objectifs actuels jusqu'à ce que les attaquants soient à court de renforts ou de temps. Réapparaissez au point de ralliement derrière un objectif contesté.",
    ["faction.def.desc@snow"] = "Tenez la vallée point par point : scierie A, station radar B, village C, centrale D et col E. Tirez depuis les hauteurs (le plateau du radar, les épaules du col) ; les ruines du village peuvent cacher un char.",
    ["faction.def.role"] = "DÉFENSE  ·  DÉFENSE DE L'ÎLE",
    ["faction.def.role@city"] = "DÉFENSE  ·  TENIR LA VILLE",
    ["faction.def.role@sands"] = "DÉFENSE  ·  DÉFENSE EN PROFONDEUR",
    ["faction.def.role@snow"] = "DÉFENSE  ·  TENIR LE COL",
    ["faction.full"] = "ÉQUIPE PLEINE",
