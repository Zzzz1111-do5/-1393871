    <Item class="ModuleScript" referent="26">
      <Properties>
        <string name="Name">ImportedShip</string>
        <ProtectedString name="Source"><![CDATA[-- 自动生成（tools/models/ship2glb.py、tools/models/sfship.py），别手改：舰艇模型（models/ship/<型号>.glb）的元数据
--   055、阿利·伯克、提康德罗加、054A、022 由 Sketchfab 原模型直接转换（sfship.py）；另外两艘是网页版的舰艇模型原样转的（ship2glb.py）
--   m[型号] = { len 长 / w 宽 / h 水线以上高 / draft 吃水（格，游戏里舰艇的比例：1 米 = 1.68 格）, parts[块名] = { g 部件（Hull / T1 / B1 / C1…）, c 中心, s 大小, col 没贴图的块的颜色 },
--     guns[第几座炮] = { g 炮塔部件, piv 炮塔转轴（在甲板上）, tip 炮口离转轴多远, n 三角形数, b 炮管部件（单独俯仰、后坐）, trn 炮管的耳轴 }
--       （没挑出来的是 false；ShipDefs 的炮位、耳轴、炮管长照这个改）,
--     ciws[第几座近防炮] = { g 部件（整座转向目标；没拆出来的是 false，游戏里拼一座零件的）, piv 转轴（底座中心）, top 最高, gy 炮管高, mz 炮口离转轴多远, ry 原模型里炮口朝哪（度，0 船头、正数往右） },
--     vls 垂发 { x0, x1, z0, z1, 甲板高 }（游戏里一格一格掀舱盖、导弹从格子里出来）, cans 斜置的导弹发射箱 { x, y, z, 朝向（度，0 船头、正数往右）, 仰角 },
--     top 最高点（桅顶）, stern 船尾甲板, side 舰桥一侧的航行灯 { x, y, z }, credit 署名 }
--   坐标：X 右、Y 上、−Z 船头，原点在水线、船长和船宽的中间（ShipView 的船体坐标）；导入后 MeshPart 叫 S_<型号>__<块名>
return {
  m = {
    cg47 = { ciws = { { g = "C1", gy = 32.032, mz = 2.778, n = 284, piv = { 7.406, 28.163, 43.639 }, ry = -103.8, top = 34.447 } }, credit = "提康德罗加级巡洋舰：Ticonderoga Missile Cruiser，作者 waelXcm（https://sketchfab.com/3d-models/ticonderoga-missile-cruiser-397bd2b7bcd946e4b508869f4ca1e1cf），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", draft = 17.3, guns = { { b = "B1", g = "T1", n = 780, piv = { 0, 13.012, -90.1 }, tip = 11.472, trn = { 0, 18.211, -91.649 } }, { b = "B2", g = "T2", n = 770, piv = { 0, 6.986, 120.2 }, tip = 11.783, trn = { 0, 11.731, 122.06 } } }, h = 78.718, len = 290, parts = { B1_1 = { c = { 0, 18.211, -96.611 }, g = "B1", s = { 0.673, 0.673, 9.923 } }, B2_1 = { c = { 0, 11.731, 127.022 }, g = "B2", s = { 0.673, 0.673, 9.923 } }, C1_1 = { c = { 7.346, 31.305, 43.639 }, g = "C1", s = { 5.436, 6.285, 5.515 } }, Hull_1 = { c = { 0, 11.541, 0 }, g = "Hull", s = { 31.007, 57.683, 290 } }, Hull_2 = { c = { 0, 43.357, -13.3 }, g = "Hull", s = { 28.898, 70.722, 244.558 } }, Hull_3 = { c = { -0.355, 42.315, -38.005 }, g = "Hull", s = { 23.971, 29.31, 13.281 } }, Hull_4 = { c = { 0, 12.495, 26.781 }, g = "Hull", s = { 32.535, 11.035, 234.756 } }, Hull_5 = { c = { 0, 16.617, 35.9 }, g = "Hull", s = { 32.535, 58.253, 184.642 } }, Hull_6 = { c = { 0, 28.709, 1.223 }, g = "Hull", s = { 12.031, 2.45, 1.424 } }, Hull_7 = { c = { -0.027, 21.062, 25.204 }, g = "Hull", s = { 24.771, 30.47, 235.235 } }, Hull_8 = { c = { 0, 12.655, 13.695 }, g = "Hull", s = { 12.775, 2.997, 185.637 } }, Hull_9 = { c = { 0.493, 16.064, 12.556 }, g = "Hull", s = { 20.731, 9.752, 14.119 } }, T1_1 = { c = { 0, 15.861, -90.283 }, g = "T1", s = { 5.483, 7.107, 8.358 } }, T2_1 = { c = { 0, 10.075, 120.694 }, g = "T2", s = { 5.483, 5.718, 8.358 } } }, side = { 14.562, 13.167, 5.31 }, stern = { 0, 13.143, 145 }, top = { 0.372, 78.718, 4.571 }, vls = { { -6, 6, -80, -63, 12.481 }, { -5, 5, 88, 101, 12.247 } }, w = 32.535 },
