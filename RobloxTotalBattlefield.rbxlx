        <string name="Name">VillageMeta</string>
        <ProtectedString name="Source"><![CDATA[-- 自动生成（tools/models/sfbld.py → tools/models/sfbld_meta.py），别手改：雪山合掌村的写实建筑（models/bld/village.glb，Sketchfab 上 CC-BY-4.0 的模型）的元数据
--   [键] = { name 中文名, w / h / d 宽、高、深（格，1 米 = 2.8 格）, o 在 GLB 里的原点, parts[块名] = { c 中心, s 大小 }, credit 署名, tris 三角形数 }；
--   坐标 X 右、Y 上、−Z 正面，原点在地面、占地中心；导入后 MeshPart 叫 B_<键>__<块名>（Imports.lua 收进 Imported.Bld，同 BuildingMeta）
return {
  gs_big = { credit = "合掌造农家（大）：Japanese house \"minka\"，作者 kolya5561（https://sketchfab.com/models/1b757cde000240cb84d571032946bfe6），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、只取模型里三座房子中的一座（House001）、按材质切块、贴图缩到 1024", d = 39.725, h = 42, name = "合掌造农家（大）", o = { 0, 0, 0 }, parts = { Body_1 = { c = { 0, 21, -0 }, s = { 59.899, 42, 39.725 } } }, tris = 2972, w = 59.899 },
  gs_mid = { credit = "合掌造农家（中）：Shirakawago Village Set House 1，作者 Lokomotto (THEOJANG)（https://sketchfab.com/models/f94da738aefc4674ab2062df5c01cd43），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、去掉屋檐上半透明的草束贴片、按材质切块、贴图缩到 1024", d = 35.502, h = 39.2, name = "合掌造农家（中）", o = { 119.899, 0, 0 }, parts = { Body_1 = { c = { 0, 20.321, -0 }, s = { 39.292, 37.757, 35.502 } }, Body_2 = { c = { -0.065, 6.112, -0 }, s = { 24.035, 12.224, 32.194 } }, Body_3 = { c = { -0.065, 17.773, -0.082 }, s = { 37.801, 35.546, 29.111 } } }, tris = 26626, w = 39.292 },
  gs_small = { credit = "合掌造小屋：Japanese house \"minka\"，作者 kolya5561（https://sketchfab.com/models/1b757cde000240cb84d571032946bfe6），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、只取模型里三座房子中的一座（House）、按材质切块、贴图缩到 1024", d = 22.511, h = 23.8, name = "合掌造小屋", o = { 326.074, 0, 0 }, parts = { Body_1 = { c = { 0, 11.9, -0 }, s = { 27.389, 23.8, 22.511 } } }, tris = 2636, w = 27.389 },
  gs_tall = { credit = "合掌造农家（三层）：Japanese house \"minka\"，作者 kolya5561（https://sketchfab.com/models/1b757cde000240cb84d571032946bfe6），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、只取模型里三座房子中的一座（House002）、按材质切块、贴图缩到 1024", d = 31.093, h = 43.4, name = "合掌造农家（三层）", o = { 219.191, 0, 0 }, parts = { Body_1 = { c = { 0, 21.7, -0 }, s = { 46.883, 43.4, 31.093 } } }, tris = 3808, w = 46.883 },
  jp_hokora = { credit = "小祠：Japanese Shrine，作者 Mateja Veljkovic（https://sketchfab.com/models/c74108c3e1c64c5c8dfd83e652a3af4a），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、按材质切块、贴图缩到 1024", d = 9.127, h = 10.64, name = "小祠", o = { 493.515, 0, 0 }, parts = { Body_1 = { c = { 0, 5.32, -0 }, s = { 10.093, 10.64, 9.127 } } }, tris = 5604, w = 10.093 },
  jp_shoro = { credit = "钟楼：Japanese Bell Tower，作者 AO-INTERACTIVE（https://sketchfab.com/models/e4094bc0739d4b41866b39914ec123e3），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、按材质切块、贴图缩到 1024", d = 18.807, h = 15.4, name = "钟楼", o = { 705.129, 0, 0 }, parts = { Body_1 = { c = { 0.039, 11.707, 4.254 }, s = { 17.926, 7.386, 9.27 } }, Body_2 = { c = { 0.104, 11.707, -4.551 }, s = { 17.926, 7.386, 9.102 } }, Body_3 = { c = { 0.176, 6.021, -2.662 }, s = { 6.286, 4.555, 7.602 } }, Body_4 = { c = { 0, 4.156, 0 }, s = { 10.426, 8.312, 10.238 } }, Body_5 = { c = { 0, 9.471, -0 }, s = { 18.807, 4.388, 18.807 } }, Body_6 = { c = { 0.028, 11.36, 0 }, s = { 13.319, 7.751, 13.319 } } }, tris = 53494, w = 18.807 },
  jp_shrine = { credit = "茅草顶神社本殿：Shinto shrine，作者 Venera Zappalà (Vera)（https://sketchfab.com/models/3b89ad3251bb4b82963c77f7746cad71），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、去掉自带的草地地面、按材质切块、贴图缩到 1024", d = 13.598, h = 12.6, name = "茅草顶神社本殿", o = { 413.463, 0, 0 }, parts = { Body_1 = { c = { 0.003, 5.536, -0.147 }, s = { 16.706, 9.317, 13.304 } }, Body_10 = { c = { 0.026, 6.644, 1.506 }, s = { 13.328, 6.661, 6.664 } }, Body_11 = { c = { 0.053, 8.163, 1.523 }, s = { 16.884, 5.01, 10.552 } }, Body_12 = { c = { -0.019, 4.975, -1.801 }, s = { 3.336, 2.663, 0.058 } }, Body_2 = { c = { 0.016, 9.702, 1.543 }, s = { 17.962, 5.796, 6.456 } }, Body_3 = { c = { 0.046, 4.754, 1.53 }, s = { 16.327, 9.508, 9.375 } }, Body_4 = { c = { 0.055, 8.17, 1.526 }, s = { 16.835, 4.981, 10.499 } }, Body_5 = { c = { 0, 7.337, 0.418 }, s = { 20.051, 8.073, 4.572 } }, Body_6 = { c = { 0.026, 2.3, -0.072 }, s = { 16.66, 2.07, 13.153 } }, Body_7 = { c = { -0.019, 4.759, -1.842 }, s = { 0.964, 0.261, 0.064 } }, Body_8 = { c = { 0.024, 11.123, 1.522 }, s = { 13.935, 0.441, 2.499 } }, Body_9 = { c = { 0.022, 2.142, -4.992 }, s = { 3.318, 2.388, 3.411 } } }, tris = 41052, w = 20.051 },
  jp_torii = { credit = "石鸟居：Torii gate at Kinosaki, Japan，作者 HoangHiepVu（https://sketchfab.com/models/3ed35b9d45014164a25484043aadd8d1），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、减面到 18000 个三角形、按材质切块、贴图缩到 1024", d = 8.556, h = 14.683, name = "石鸟居", o = { 563.607, 0, 0 }, parts = { Body_1 = { c = { 0.015, 7.253, -0 }, s = { 19.407, 14.683, 8.556 } } }, tris = 18000, w = 19.407 },
  jp_toro = { credit = "石灯笼：Japanese Stone Lantren，作者 adibnh（https://sketchfab.com/models/4fb985f5f88449f98b0a20f8d183f31f），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、减面到 8000 个三角形、按材质切块、贴图缩到 1024", d = 2.126, h = 5.04, name = "石灯笼", o = { 643.014, 0, 0 }, parts = { Body_1 = { c = { 0, 2.52, 0 }, s = { 2.115, 5.04, 2.126 } } }, tris = 8000, w = 2.115 },
}
]]></ProtectedString>
