    ["eco.pve"] = "Награда за миссию +{1} монет",
    ["eco.round"] = "+{1} монет за раунд",
    ["eo.hint"] = "[P] — выйти · мышь — поворот · колесо — зум\n[Z] — широкое / узкое поле · [V] — белый / чёрный горячий / ТВ\n[R] — следующая цель · щелчок — пуск / огонь · автопилот держит горизонт",
    ["eo.range"] = "ДАЛЬН",
    ["eo.sayArea"] = "Ведите мышью для поиска, колесо — зум.",
    ["eo.sayHold"] = "Оружие сброшено. Держите контейнер на цели.",
    ["eo.sayPoint"] = "Цель сопровождается. Щёлкните для пуска.",
    ["eo.title"] = "ОЭ КОНТЕЙНЕР",
    ["faction.atk.desc"] = "Пробивайтесь с моря: штурмуйте аванпост A, высадитесь на главный остров, захватите порт C и аэродром D, затем возьмите штаб E. После высадки можно возрождаться на исходной позиции перед каждой целью. Каждая смерть стоит одного подкрепления; закончатся — поражение.",
    ["faction.atk.desc@city"] = "Выезжайте с южной главной базы (автопарк, вертолётные площадки и полоса внутри): возьмите металлургический завод A, затем парк B, центральную площадь C и вокзал D, и наконец телебашню E на севере. Узкие улицы и здания закрывают обзор: следите за углами и проёмами. Деревья падают от тарана, снаряды обрушивают здания.",
    ["faction.atk.desc@sands"] = "Наступайте на север от передовой базы и полевого аэродрома: прорвите пограничный вал и возьмите пост A, затем нефтепромысел B, город C, авиабазу D и наконец штаб E на хребте. Возрождайтесь на исходной позиции перед каждой целью. Каждая смерть стоит одного подкрепления; закончатся — поражение.",
    ["faction.atk.desc@snow"] = "Выезжайте с южной главной базы (автопарк, вертолётные площадки и полоса внутри): возьмите лесопилку A, затем РЛС B на западном склоне, деревню C у реки, ГЭС D у ледяного озера и наконец перевал E на севере. В долине полно хребтов и оврагов: воюйте из-за гребней, укрыв корпус, — на льду укрытий нет.",
    ["faction.atk.role"] = "АТАКА  ·  МОРСКОЙ ДЕСАНТ",
    ["faction.atk.role@city"] = "АТАКА  ·  ВХОД В ГОРОД С ЮГА",
    ["faction.atk.role@sands"] = "АТАКА  ·  ТАНКОВЫЙ ШТУРМ",
    ["faction.atk.role@snow"] = "АТАКА  ·  ВВЕРХ ПО ДОЛИНЕ",
    ["faction.def.desc"] = "Держите оборону сектор за сектором: защищайте текущие цели, пока у атакующих не кончатся подкрепления или время. Если цель оспаривается, возрождайтесь на пункте сбора позади неё.",
    ["faction.def.desc@snow"] = "Держите долину точка за точкой: лесопилка A, РЛС B, деревня C, ГЭС D и перевал E. Бейте с высот (плато у РЛС, плечи перевала); в руинах деревни можно спрятать танк.",
    ["faction.def.role"] = "ОБОРОНА  ·  ЗАЩИТА ОСТРОВА",
    ["faction.def.role@city"] = "ОБОРОНА  ·  УДЕРЖАТЬ ГОРОД",
    ["faction.def.role@sands"] = "ОБОРОНА  ·  ЭШЕЛОНИРОВАННАЯ ОБОРОНА",
    ["faction.def.role@snow"] = "ОБОРОНА  ·  УДЕРЖАТЬ ПЕРЕВАЛ",
    ["faction.full"] = "КОМАНДА ЗАПОЛНЕНА",
