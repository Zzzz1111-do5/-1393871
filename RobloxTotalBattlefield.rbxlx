    ["coach.board"] = "Einsteigen / benutzen",
    ["coach.brake"] = "Bremse",
    ["coach.card.arty.1"] = "Zeig mit der Maus aufs Ziel; Entfernung und Reichweite werden angezeigt",
    ["coach.card.arty.2"] = "LMT feuert — Granaten brauchen einige Sekunden bis zum Einschlag",
    ["coach.card.arty.3"] = "RMT zum Heranzoomen, Leertaste zum Verlassen",
    ["coach.card.fort.1"] = "Maus zum Zielen, LMT zum Feuern",
    ["coach.card.fort.2"] = "RMT / V Visier, Rad zum Zoomen",
    ["coach.card.fort.3"] = "Leertaste zum Verlassen der Stellung",
    ["coach.card.heli.1"] = "Warte, bis der Rotor hochgelaufen ist (Drehzahl 100 % im HUD)",
    ["coach.card.heli.2"] = "W halten zum Steigen, S zum Sinken (wie in War Thunder); tiefer zielen senkt die Nase und fliegt voraus, höher zielen hebt sie und bremst; A / D seitwärts, Q / E drehen",
    ["coach.card.heli.3"] = "Es behält seinen Schwung: höher zielen zum Abfangen und Bremsen. LMT Bordkanone, F Raketen, Leertaste aussteigen",
    ["coach.card.jet.1"] = "Shift Schub erhöhen (voll = Nachbrenner); A / D auf der Piste lenken; im Leerlauf Strg halten zum Zurückrollen",
    ["coach.card.jet.2"] = "Bei {1} km/h S halten zum Abheben — das Fahrwerk fährt von selbst ein. W Nase runter, S Nase hoch, A / D rollen; in die Kurve legen und S ziehen",
    ["coach.card.jet.3"] = "LMT Bordkanone (feuert auf die Nasenmarke; hängt sich an Feindfahrzeuge innerhalb 6° und hält vor), F Rakete (1–6 Waffen, zuerst aufschalten), X Täuschkörper. Landen: G Fahrwerk, Strg weniger Schub, Nase auf die Piste, anhalten zum Aufmunitionieren und Reparieren",
    ["coach.card.lcac.1"] = "W / S Gas, A / D lenken: schärfer bei Tempo, das Heck bricht aus",
    ["coach.card.lcac.2"] = "Fahr auf einen Strand, und das Fahrzeug wird automatisch abgesetzt",
    ["coach.card.lcac.3"] = "Dann über den Bug abfahren; Leertaste aussteigen",
    ["coach.card.ship.1"] = "W / S stellt den Maschinentelegrafen stufenweise; A / D Ruder — große Schiffe drehen langsam",
    ["coach.card.ship.2"] = "Maus zielt, LMT feuert: 1 Geschütze, 2 Seezielflugkörper (R aufschalten)",
    ["coach.card.ship.3"] = "RMT / V Fernglas, N Nachtsicht, Leertaste von Bord",
    ["coach.card.uav.1"] = "Du steuerst die Drohne per Tablet und stehst dabei, wo du bist — bleib in Deckung",
    ["coach.card.uav.2"] = "Maus lenkt, W / S Tempo, A / D rollen",
    ["coach.card.uav.3"] = "RMT / V Kamera, Z Zoom, F Rakete, Leertaste Tablet wegstecken",
    ["coach.card.veh.1"] = "W / S fahren, A / D lenken (Kettenfahrzeuge drehen auf der Stelle)",
    ["coach.card.veh.2"] = "Die Maus richtet den Turm, LMT feuert, Zifferntasten wählen Granate / Waffe (siehe Munitionsleiste)",
    ["coach.card.veh.3"] = "Shift für das Richtschützenvisier (V: Nacht / Wärmebild), M Nebel, Leertaste aussteigen",
    ["coach.cardSub"] = "Drei Schritte · Enter zum Schließen",
