    ["coach.card.arty.1"] = "Наведите мышь на цель; показаны дистанция и дальность",
    ["coach.card.arty.2"] = "ЛКМ — выстрел; снаряды летят несколько секунд",
    ["coach.card.arty.3"] = "ПКМ — приблизить, Пробел — покинуть",
    ["coach.card.fort.1"] = "Мышь — прицел, ЛКМ — огонь",
    ["coach.card.fort.2"] = "ПКМ / V — прицел, колесо — кратность",
    ["coach.card.fort.3"] = "Пробел — покинуть позицию",
    ["coach.card.heli.1"] = "Дождитесь раскрутки винта (обороты 100% на ИЛС)",
    ["coach.card.heli.2"] = "Держите W для подъёма, S для снижения (как в War Thunder); целитесь ниже — нос вниз и полёт вперёд, выше — нос вверх и торможение; A / D — боком, Q / E — поворот",
    ["coach.card.heli.3"] = "Есть инерция: целитесь выше, чтобы задрать нос и затормозить. ЛКМ — пушка, F — НАР / ракеты, Пробел — выйти",
    ["coach.card.jet.1"] = "Shift — газ вперёд (максимум = форсаж); A / D — руление по полосе; на малом газе держите Ctrl, чтобы ехать назад",
    ["coach.card.jet.2"] = "На {1} км/ч держите S для отрыва — шасси уберётся само. W — нос вниз, S — нос вверх, A / D — крен; накрените и тяните S для поворота",
    ["coach.card.jet.3"] = "ЛКМ — пушка (стреляет по метке носа; цепляется к технике врага в пределах 6° и берёт упреждение), F — ракета (1–6 — подвески, сначала захват), X — ловушки. Посадка: G — шасси, Ctrl — газ меньше, нос на полосу, остановитесь для перевооружения и ремонта",
    ["coach.card.lcac.1"] = "W / S — газ, A / D — руль: на скорости резче, корму заносит",
    ["coach.card.lcac.2"] = "Выйдите на пляж — машина выгрузится автоматически",
    ["coach.card.lcac.3"] = "Затем съезжайте через нос; Пробел — выйти",
    ["coach.card.ship.1"] = "W / S — машинный телеграф по шагам; A / D — руль: большие корабли поворачивают медленно",
    ["coach.card.ship.2"] = "Мышь — прицел, ЛКМ — огонь: 1 — орудия, 2 — ПКР (R — захват)",
    ["coach.card.ship.3"] = "ПКМ / V — бинокль, N — ПНВ, Пробел — покинуть корабль",
    ["coach.card.uav.1"] = "Вы управляете дроном с планшета, стоя на месте — оставайтесь в укрытии",
    ["coach.card.uav.2"] = "Мышь — направление, W / S — скорость, A / D — крен",
    ["coach.card.uav.3"] = "ПКМ / V — камера, Z — зум, F — ракета, Пробел — убрать планшет",
    ["coach.card.veh.1"] = "W / S — движение, A / D — поворот (гусеничные машины разворачиваются на месте)",
    ["coach.card.veh.2"] = "Мышь наводит башню, ЛКМ — огонь, цифры выбирают снаряд / оружие (смотрите панель боеприпасов)",
    ["coach.card.veh.3"] = "Shift — прицел наводчика (V: ночь / тепловизор), M — дым, Пробел — выйти",
