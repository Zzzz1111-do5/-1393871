    ["eco.attLock"] = "Nv. {1} ou {2} moedas",
    ["eco.boughtAtt"] = "{1} desbloqueado (-{2} moedas)",
    ["eco.boughtVeh"] = "{1} desbloqueado (-{2} moedas)",
    ["eco.coins"] = "{1} moedas",
    ["eco.confirm"] = "Clique de novo para desbloquear {2} por {1} moedas",
    ["eco.lockVeh"] = "{1} moedas para desbloquear",
