---------------------------------------------------------------- 直升机、轰炸机座舱共用件
-- 平显（投影仪 + 组合玻璃，符号按眼睛的位置投：Interior 的 hud 页）；p 是组合玻璃中心，at 是眼睛
local function hudUnit(b, g, p, at)
  b:box(g, V(0.18, 0.07, 0.20), CF(p + V(0, -0.11, 0.01)), RGB(30, 32, 34), MAT.Metal)
  for _, sx in ipairs({ -1, 1 }) do b:box(g, V(0.012, 0.13, 0.012), CF(p + V(sx * 0.08, -0.02, -0.005)), RGB(30, 32, 34), MAT.Metal) end
  local hs = b:screen(g, 0.15, 0.12, CFrame.lookAt(p, at + V(0, 0.02, 0)), "hud", { light = false, glow = 2.2, ppm = 3000, bezel = 0.004, depth = 0.004, noBack = true })
  hs.part.Material = MAT.Glass   -- 组合玻璃：真透明（原来后面垫着一块不透明黑底板）
  hs.part.Transparency = 0.93
  hs.part.Reflectance = 0.06
  hs.part.Color = RGB(150, 205, 165)
  hs.root.BackgroundTransparency = 1
  b:name("hud", hs)
  return hs
end
-- 备份仪表（姿态、空速、高度三个小圆表）：c 是中间那个的位置，at 是眼睛
local function standby(b, g, c, at, dx)
  dx = dx or 0.075
  b:screen(g, 0.06, 0.06, CFrame.lookAt(c + V(-dx, 0, 0), at), "adi", { light = false, ppm = 2200 })
  b:screen(g, 0.05, 0.05, CFrame.lookAt(c, at), "asi", { light = false, ppm = 2200 })
  b:screen(g, 0.05, 0.05, CFrame.lookAt(c + V(dx, 0, 0), at), "alt", { light = false, ppm = 2200 })
end
-- 一块平板玻璃（座舱窗）：四个角 a b c d（顺着转一圈），玻璃按长方形近似；加进 glass 表（Interior 贴划痕）
local function pane(b, g, glass, ctr, w, h, rot, trans)
  local p = b:box(g, V(w, h, 0.008), CF(ctr) * rot, RGB(170, 190, 200), MAT.Glass)
  p.Transparency, p.Reflectance, p.CastShadow = trans or 0.9, 0.08, false
  table.insert(glass, p)
  return p
end
-- 窗框条：从 a 到 b 的一根方管
local function bar(b, g, a, c, t, col)
  local len = (c - a).Magnitude
  return b:box(g, V(t, t, len), CFrame.lookAt((a + c) / 2, c), col or RGB(40, 42, 44), MAT.Metal)
end
-- 一个面朝 n 的窗（中心 ctr、宽 w、高 h、up 是窗的「上」方向），带四边框条
local function window(b, g, glass, ctr, n, up, w, h, frame, trans)
  local r = up:Cross(n).Unit
  local u = n:Cross(r).Unit
  local rot = CFrame.fromMatrix(V(), r, u, n)
  pane(b, g, glass, ctr, w, h, rot, trans)
  if frame then
    local t = frame
    local c1, c2 = ctr + r * (w / 2) + u * (h / 2), ctr - r * (w / 2) + u * (h / 2)
    local c3, c4 = ctr - r * (w / 2) - u * (h / 2), ctr + r * (w / 2) - u * (h / 2)
    bar(b, g, c1, c2, t) bar(b, g, c2, c3, t) bar(b, g, c3, c4, t) bar(b, g, c4, c1, t)
  end
end
-- 一块雨刷（风挡下沿的转轴 + 刷臂 + 刷片）
local function wiper(b, g, base, len, ang, n)
  b:cyl(g, 0.03, 0.03, CF(base) * ANG(0, PI / 2, 0), RGB(30, 30, 30), MAT.Metal)
  local tip = base + (CFrame.Angles(0, 0, rad(ang)) * V(0, len, 0))
  local q = base:Lerp(tip, 0.5)
  b:box(g, V(0.012, len, 0.008), CFrame.lookAt(q, q + n) * ANG(0, 0, rad(-ang)), RGB(30, 30, 30), MAT.Metal)
end
-- 一套手柄类操纵件的组名（左右两座各一套：我这一座不带后缀，另一座带 2）
local function sfx(me) return me and "" or "2" end

---------------------------------------------------------------- 并排双座：通用直升机（黑鹰、直-20、支奴干）、轰炸机（轰-6K、B-2）
-- 原点在「我」的眼位；另一座在 x = 2·cx（cx 是座舱中线）。
--   L = { half 座位中心到中线（米）, me = "R"（美军直升机机长坐右座）/ "L"（轰炸机、我军直升机机长坐左座）, ctrl = "heli"（周期变距杆 + 总距杆）/ "yoke"（驾驶盘）/ "stick"（中央杆）,
--     disp = 显示器布局, hud = 机长前面有平显, cn = 中文, win = "heli"（大风挡 + 门窗 + 顶窗，chin 加下视窗）/ "bomber"（小窗、粗框）, thr = 油门杆数,
--     thrSide = 油门每座一组在各自左手边（B-2）, dress = 着装 }
-- 资料：UH-60M —— 四块 6×8 英寸多功能显示器横排、中间操纵台两台飞行管理计算机键盘、头顶操纵台上两根发动机功率控制杆和两个灭火 T 形手柄、
--   下视窗、雨刷、磁罗盘；CH-47F 通用航电座舱（CAAS）—— 五块多功能显示器；直-20 —— 四块大屏 + 中间一块；轰-6K —— 玻璃化座舱、驾驶盘、平显；
--   B-2 —— 两名机组并排、每人四块彩色多功能显示器、中央杆、四根油门各座一组在左手边、窗小框粗（docs/cockpit_research.md）
function Defs.side(b, ctx, L)
  local H = "hull"
  local hf = L.half or 0.52
  local sg = (L.me == "L") and 1 or -1   -- 中线在我的哪一边
  local cx, ox = sg * hf, 2 * sg * hf    -- 中线、另一座的 x
  local cn = L.cn
  local heli = L.ctrl == "heli"
  local W = 2 * hf + (heli and 0.95 or 1.05)   -- 座舱内宽
  local x0, x1 = cx - W / 2, cx + W / 2
  local FY = heli and -1.12 or -1.10           -- 地板
  local eye = V()
  local function bx(sx, sy, sz, x, y, z, col, mat, rx, ry, rz)
    return b:box(H, V(sx, sy, sz), CF(x, y, z) * ANG(rad(rx or 0), rad(ry or 0), rad(rz or 0)), col, mat)
  end
  local function look(p, at) return CFrame.lookAt(p, at or eye) end
  local glass = {}
  local P1, P2 = heli and RGB(52, 56, 58) or PIT, heli and RGB(40, 43, 45) or PIT2
  -- 地板、下半截侧壁（门的下半）、后隔框
  bx(W, 0.03, 2.2, cx, FY, -0.30, P2, MAT.DiamondPlate)
  for _, x in ipairs({ x0, x1 }) do bx(0.04, 0.62, 1.6, x, FY + 0.31, -0.25, P1) end
  bx(W, 1.5, 0.04, cx, FY + 0.75, 0.62, P2)
  -- 顶棚
  local RY = heli and 0.42 or 0.36
  bx(W, 0.03, 1.2, cx, RY, 0.02, P2)
  -- 主仪表板 + 遮光罩（横贯两座）
  local PZ = heli and -0.80 or -0.78
  b:box(H, V(W - 0.16, 0.46, 0.06), CF(cx, -0.47, PZ) * ANG(rad(-12), 0, 0), P1)
  -- 遮光罩：往后只伸到离眼 0.64 米（原来 0.58：下沿挡住下面三个备份仪表；用户 11-22：「飞机的电子屏会被挡住」）
  bx(W - 0.16, 0.05, 0.22, cx, -0.225, PZ + 0.03, GLARE, MAT.Fabric, 4, 0, 0)
  bx(W - 0.30, 0.30, 0.04, cx, -0.80, PZ - 0.10, P2, nil, 35, 0, 0)    -- 膝下面板
  -- 主告警 / 注意灯（遮光罩上两座各一对，字牌贴在遮光罩后沿：原来埋在遮光罩里面）、磁罗盘（风挡中间框上）
  for _, x in ipairs({ 0, ox }) do
    b:led(H, CF(x - 0.18, -0.19, PZ + 0.10), RGB(255, 40, 30), 0.022, "mwarn")
    b:led(H, CF(x + 0.18, -0.19, PZ + 0.10), RGB(255, 180, 30), 0.022, "mcaut")
    b:placard(H, 0.07, 0.016, look(V(x - 0.18, -0.233, PZ + 0.143), V(x, 0, 0)), cn and "主告警" or "MASTER WARN", { bg = C.black, fg = RGB(255, 80, 70) })
    b:placard(H, 0.07, 0.016, look(V(x + 0.18, -0.233, PZ + 0.143), V(x, 0, 0)), cn and "主注意" or "MASTER CAUT", { bg = C.black, fg = RGB(255, 190, 60) })
  end
  bx(0.07, 0.06, 0.07, cx, 0.26, PZ - 0.10, RGB(20, 20, 20))
  b:ball(H, 0.05, CF(cx, 0.26, PZ - 0.135), RGB(230, 225, 200), MAT.Glass)
  -- 显示器
  local K = cn and { top = { "姿态", "雷达", "态势", "武器", "发动机" }, bottom = { "油量", "检查", "目标", "通信", "菜单" } }
    or { top = { "PFD", "RDR", "SA", "SMS", "ENG" }, bottom = { "FUEL", "CHK", "TGT", "COM", "MENU" } }
  local function mfd(x, y, w, h, page, keys)
    local p = V(x, y, PZ + 0.035 + (y + 0.47) * math.tan(rad(12)) * -1)
    b:screen(H, w, h, CFrame.lookAt(p, V(cx, 0, 0.3)) , page, { keys = keys and K or nil, lightK = 0.3 })
  end
  local disp = L.disp
  if disp == "uh60m" then   -- 四块竖着的 6×8 英寸：我 PFD / ND，另一座 ND / PFD
    for i, page in ipairs({ "mfd_pfd", "mfd_sa", "mfd_sa", "mfd_pfd" }) do
      local x = cx + sg * (-0.60 + (i - 1) * 0.40) * -1
      mfd(x, -0.47, 0.15, 0.20, page, true)
    end
  elseif disp == "ch47f" then   -- 五块：两座各两块 + 中间发动机
    for i, page in ipairs({ "mfd_pfd", "mfd_sa", "mfd_eng", "mfd_sa", "mfd_pfd" }) do
      local x = cx - sg * (-0.68 + (i - 1) * 0.34)
      mfd(x, -0.47, 0.15, 0.20, page, i ~= 3)
    end
  elseif disp == "z20" then   -- 四块横着的大屏 + 中间一块小的
    for i, page in ipairs({ "mfd_pfd", "mfd_sa", "mfd_sa", "mfd_pfd" }) do
      local x = cx - sg * (-0.62 + (i - 1) * 0.36 + ((i > 2) and 0.16 or 0))
      mfd(x, -0.46, 0.20, 0.15, page, true)
    end
    mfd(cx, -0.50, 0.12, 0.10, "mfd_eng", false)
  elseif disp == "h6k" then   -- 六块（人民日报 2016）：每座三块（姿态 / 导航 / 武器），另一座的第三块是发动机
    for _, base in ipairs({ 0, ox }) do
      for j, page in ipairs({ "mfd_pfd", "mfd_sa", (base == 0) and "mfd_sms" or "mfd_eng" }) do
        mfd(base + (j - 2) * 0.17, -0.47, 0.15, 0.15, page, j ~= 3)
      end
    end
  else   -- b2：每人 2×2 四块
    for _, base in ipairs({ 0, ox }) do
      for j, page in ipairs({ "mfd_pfd", "mfd_sa", "mfd_sms", "mfd_eng" }) do
        local col, row = (j - 1) % 2, math.floor((j - 1) / 2)
        mfd(base + (col - 0.5) * 0.18, -0.38 - row * 0.18, 0.15, 0.15, page, row == 0)
      end
    end
  end
  standby(b, H, V(cx, -0.31, PZ + 0.07), eye)
  if L.hud then hudUnit(b, H, V(0, -0.07, PZ + 0.14), eye) end
  -- 中间操纵台（两座之间，从仪表板往后伸）：电台、飞行管理计算机键盘（小屏 + 键）、自动驾驶面板；油门杆（固定翼）
  local CW = heli and 0.30 or 0.36
  b:box(H, V(CW, 0.40, 0.95), CF(cx, FY + 0.20, PZ + 0.42), P1)
  b:box(H, V(CW, 0.04, 0.95), CF(cx, FY + 0.42, PZ + 0.42) * ANG(rad(8), 0, 0), P2)
  for i = 0, 2 do
    b:panel(H, CW - 0.04, 0.18, CFrame.lookAt(V(cx, FY + 0.445, PZ + 0.18 + i * 0.25), V(cx, FY + 1.4, PZ + 0.5 + i * 0.25)), 3, 4, RGB(54, 58, 62))
  end
  for _, s in ipairs({ -1, 1 }) do   -- 两台键盘（中间操纵台前端两边）
    local p = V(cx + s * 0.075, FY + 0.47, PZ + 0.10)
    b:screen(H, 0.10, 0.05, CFrame.lookAt(p, V(cx + s * 0.075, 0, 0.2)), "ufd", { lightK = 0.15 })
  end
  if not heli then   -- 油门杆（跟着油门推）：一般一组在中间操纵台；B-2 每座一组、在各自左手边（thrSide，另一座那组叫 thr2）
    local n = L.thr or 2
    local function quad(g, at, dx)
      b:group(g, H, at)
      for i = 1, n do
        local x = (i - (n + 1) / 2) * dx
        b:box(g, V(0.014, 0.12, 0.014), CF(x, 0.06, 0) * ANG(rad(-20), 0, 0), C.dark, MAT.Metal)
        b:box(g, V(dx * 0.8, 0.03, 0.035), CF(x, 0.12, -0.02), C.black)
      end
    end
    if L.thrSide then
      for _, mine in ipairs({ true, false }) do
        local x = (mine and 0 or ox) - 0.33
        bx(0.16, 0.10, 0.62, x, -0.66, -0.02, P1)                                  -- 左侧台
        bx(0.15, 0.012, 0.24, x, -0.605, -0.04, RGB(20, 20, 20))                   -- 油门槽
        quad(mine and "thr" or "thr2", CF(x, -0.60, -0.02), 0.034)
      end
    else
      quad("thr", CF(cx, FY + 0.47, PZ + 0.62), 0.05)
      bx(0.04 * n + 0.04, 0.012, 0.24, cx, FY + 0.455, PZ + 0.62, RGB(20, 20, 20))
    end
  end
  -- 头顶操纵台：开关面板朝下，直升机两根发动机功率控制杆、两个灭火 T 形手柄
  b:box(H, V(0.42, 0.10, 0.70), CF(cx, RY - 0.06, -0.20), P1)
  for i = 0, 2 do
    b:panel(H, 0.38, 0.20, CFrame.lookAt(V(cx, RY - 0.115, -0.45 + i * 0.22), V(cx, -0.6, -0.30 + i * 0.22)), 3, 4, RGB(54, 58, 62), { guard = i == 0 })
  end
  if heli then
    for _, s in ipairs({ -1, 1 }) do
      b:box(H, V(0.016, 0.10, 0.016), CF(cx + s * 0.05, RY - 0.17, -0.60) * ANG(rad(20), 0, 0), C.lgray, MAT.Metal)
      b:box(H, V(0.05, 0.02, 0.03), CF(cx + s * 0.05, RY - 0.22, -0.62), C.black)
      b:box(H, V(0.06, 0.018, 0.018), CF(cx + s * 0.13, RY - 0.13, -0.66), C.red)   -- 灭火 T 形手柄
      b:box(H, V(0.012, 0.04, 0.012), CF(cx + s * 0.13, RY - 0.10, -0.66), C.red)
    end
  end
  -- 两座：座椅、操纵件、脚蹬
  local dress = L.dress or (heli and (cn and "heli_cn" or "heli_us") or (cn and "pilot_cn" or "pilot_us"))
  local crew, stations, order = {}, {}, {}
  for _, mine in ipairs({ true, false }) do
    local x = mine and 0 or ox
    local q = sfx(mine)
    -- 座椅：直升机是防弹座椅（两侧装甲翼板）、轰炸机是弹射座椅
    b:seat(H, CF(x, -0.80, 0.16), { w = 0.48, d = 0.46, back = 0.72, recline = heli and 12 or 14, head = not heli, col = RGB(64, 66, 58), frame = RGB(44, 46, 48) })
    if heli then
      for _, s in ipairs({ -1, 1 }) do bx(0.03, 0.55, 0.40, x + s * 0.27, -0.52, 0.30, RGB(70, 72, 64), MAT.SmoothPlastic, 12, 0, 0) end
      bx(0.36, 0.20, 0.10, x, 0.02, 0.42, RGB(58, 60, 54), MAT.Fabric, 12, 0, 0)
    else
      bx(0.36, 0.28, 0.16, x, 0.06, 0.38, RGB(54, 58, 54), nil, 14, 0, 0)
      for i = 0, 3 do bx(0.025, 0.025, 0.02, x - 0.04 + i * 0.027, -0.80, -0.10, (i % 2 == 0) and C.yellow or C.black) end
    end
    for _, s in ipairs({ -1, 1 }) do bx(0.03, 0.03, 0.30, x + s * 0.20, -0.25, 0.08, RGB(60, 70, 50), MAT.Fabric, -50, 0, 0) end
    -- 脚蹬
    for _, s in ipairs({ -1, 1 }) do
      local gname = ((s < 0) and "pedL" or "pedR") .. q
      b:group(gname, H, CF(x + s * 0.15, FY + 0.16, -1.02))
      b:box(gname, V(0.10, 0.20, 0.03), CF() * ANG(rad(-20), 0, 0), RGB(40, 42, 44), MAT.Metal)
    end
    local hands
    if heli then
      -- 周期变距杆（两腿之间，从地板伸上来，握把上一排按钮）
      b:group("stick" .. q, H, CF(x, FY + 0.04, -0.36))
      b:tube("stick" .. q, V(0, 0, 0), V(0, 0.50, 0.04), 0.03, C.dark, MAT.Metal)
      b:box("stick" .. q, V(0.05, 0.14, 0.05), CF(0, 0.57, 0.05) * ANG(rad(-8), 0, 0), C.black)
      b:button("stick" .. q, CF(0, 0.645, 0.03) * ANG(rad(-70), 0, 0), C.red, 0.012)
      b:box("stick" .. q, V(0.012, 0.035, 0.012), CF(0, 0.57, 0.02), RGB(60, 60, 60))
      b:cylY(H, 0.06, 0.13, CF(x, FY + 0.03, -0.36), RGB(30, 30, 30), MAT.Fabric)
      -- 总距杆（座椅左边，后端铰链，前端握把上一盒开关；提总距时前端抬起）
      b:group("coll" .. q, H, CF(x - 0.30, -0.80, 0.18))
      b:tube("coll" .. q, V(0, 0, 0), V(0, 0.02, -0.46), 0.035, C.dark, MAT.Metal)
      b:box("coll" .. q, V(0.06, 0.07, 0.12), CF(0, 0.04, -0.50), C.black)
      b:button("coll" .. q, CF(0.0, 0.08, -0.52) * ANG(rad(-90), 0, 0), C.dark, 0.014)
      b:cyl("coll" .. q, 0.10, 0.045, CF(0, 0.02, -0.40) * ANG(0, PI / 2, 0), RGB(30, 30, 30), MAT.Fabric)   -- 油门旋转握把
      hands = { r = { "stick" .. q, V(0, 0.58, 0.05) }, l = { "coll" .. q, V(0, 0.05, -0.48) } }
    elseif L.ctrl == "yoke" then
      -- 驾驶盘：驾驶柱从地板伸上来（推拉俯仰），盘绕柱转（滚转）；羊角形两个握把
      b:group("stick" .. q, H, CF(x, FY + 0.02, -0.58))
      b:tube("stick" .. q, V(0, 0, 0), V(0, 0.56, 0.02), 0.06, C.dark, MAT.Metal)
      b:group("wheel" .. q, "stick" .. q, CF(0, 0.60, 0.03))
      b:box("wheel" .. q, V(0.32, 0.035, 0.04), CF(), C.black)
      for _, s in ipairs({ -1, 1 }) do
        b:box("wheel" .. q, V(0.035, 0.11, 0.04), CF(s * 0.16, 0.04, 0) * ANG(0, 0, rad(s * -12)), C.black)
        b:button("wheel" .. q, CF(s * 0.165, 0.10, -0.02), C.red, 0.01)
      end
      b:box("wheel" .. q, V(0.08, 0.05, 0.03), CF(0, 0, -0.025), RGB(60, 62, 64))
      hands = { r = { "wheel" .. q, V(0.16, 0.06, 0) }, l = { "wheel" .. q, V(-0.16, 0.06, 0) } }
    else
      b:group("stick" .. q, H, CF(x, FY + 0.06, -0.38))
      b:tube("stick" .. q, V(0, 0, 0), V(0, 0.36, -0.04), 0.03, C.dark, MAT.Metal)
      b:box("stick" .. q, V(0.05, 0.13, 0.055), CF(0, 0.42, -0.05) * ANG(rad(-10), 0, 0), C.black)
      b:button("stick" .. q, CF(0, 0.49, -0.08) * ANG(rad(-70), 0, 0), C.red, 0.012)
      hands = { r = { "stick" .. q, V(0, 0.42, -0.05) }, l = { H, V(x - 0.22, -0.55, 0.0) } }
    end
    if not heli and mine then hands.l = { "thr", V(0, 0.12, 0) } end
    if not heli and not mine and L.thrSide then hands.l = { "thr2", V(0, 0.12, 0) } end
    local key = mine and "pilot" or "copilot"
    crew[key] = { dress = dress, g = H, eye = V(x, 0, 0), lean = 2, yaw = 0, look = V(0, -0.05, -1), hands = hands,
      feet = { l = { "pedL" .. q, V(0, -0.04, 0.06) }, r = { "pedR" .. q, V(0, -0.04, 0.06) } } }
    stations[key] = { g = H, eye = V(x, 0, 0), look = V(0, -0.03, -1), yaw = 150, up = 70, down = 65, crew = key }
    table.insert(order, key)
  end
  -- 窗：直升机大风挡（每座一块 + 中柱）、门窗、顶窗、下视窗；轰炸机小风挡 + 侧窗，框粗
  local FR = heli and 0.035 or 0.06
  if L.win == "heli" then
    for _, x in ipairs({ 0, ox }) do
      window(b, H, glass, V(x, 0.07, PZ - 0.26), V(0, -0.45, 1).Unit, V(0, 1, 0.5).Unit, 0.78, 0.66, FR)
      if L.chin then window(b, H, glass, V(x, FY + 0.10, -1.20), V(0, 0.6, 1).Unit, V(0, 0.5, -1).Unit, 0.46, 0.36, FR) end
      window(b, H, glass, V(x, RY + 0.01, -0.32), V(0, -1, 0), V(0, 0, -1), 0.40, 0.36, FR, 0.86)   -- 顶窗（带一点茶色）
      wiper(b, H, V(x, -0.24, PZ - 0.06), 0.36, 18, V(0, 0.45, -1).Unit)
    end
    bar(b, H, V(cx, -0.24, PZ - 0.08), V(cx, RY, -0.52), 0.06)                           -- 中柱
    for _, x in ipairs({ x0, x1 }) do
      local sgn = (x > cx) and 1 or -1
      window(b, H, glass, V(x, -0.08, -0.20), V(-sgn, 0, 0), V(0, 1, 0), 0.95, 0.80, FR)   -- 门窗
      bar(b, H, V(x, -0.50, PZ - 0.10), V(x, RY, -0.55), 0.05)                              -- 风挡边柱
    end
  else   -- 轰炸机：每座一块正风挡 + 一块往外斜的侧风挡 + 上面一块眉窗，两边侧窗；框粗
    for _, x in ipairs({ 0, ox }) do
      local out = (x - cx > 0) and 1 or -1   -- 这一座在中线哪边（侧风挡往那边斜）
      window(b, H, glass, V(x - out * 0.05, 0.02, PZ - 0.22), V(0, -0.55, 1).Unit, V(0, 1, 0.55).Unit, 0.46, 0.40, FR)
      window(b, H, glass, V(x + out * 0.36, 0.02, PZ - 0.10), V(-out * 0.7, -0.4, 0.8).Unit, V(0, 1, 0.4).Unit, 0.30, 0.38, FR)
      window(b, H, glass, V(x - out * 0.05, RY - 0.02, PZ + 0.02), V(0, -1, 0.35).Unit, V(0, 0.3, -1).Unit, 0.40, 0.18, FR, 0.88)
    end
    for _, x in ipairs({ x0, x1 }) do
      local sgn = (x > cx) and 1 or -1
      window(b, H, glass, V(x, 0.02, -0.30), V(-sgn, 0, 0.2).Unit, V(0, 1, 0), 0.40, 0.32, FR)
      bx(0.04, 0.70, 1.2, x, 0.05, 0.20, P1)   -- 窗后面的侧壁
    end
    bar(b, H, V(cx, -0.22, PZ - 0.10), V(cx, RY, -0.60), 0.10)
    -- 起落架手柄 + 三个绿灯（中间仪表板，两个飞行员都够得着）
    local gx = cx - sg * 0.13
    b:group("gearh", H, CF(gx, -0.56, PZ + 0.02))
    b:box("gearh", V(0.015, 0.10, 0.015), CF(0, 0.05, 0), C.lgray, MAT.Metal)
    b:cyl("gearh", 0.025, 0.05, CF(0, 0.11, 0), C.white)
    for i = -1, 1 do b:led(H, CF(gx + i * 0.022, -0.47, PZ + 0.0), RGB(80, 255, 110), 0.012, "gear") end
    b:placard(H, 0.06, 0.016, look(V(gx, -0.45, PZ + 0.005)), cn and "起落架" or "LDG GEAR", { bg = C.black, fg = C.white })
  end
  -- 灯：夜视兼容的绿白泛光、告警红灯
  b:light(H, CF(cx, RY - 0.12, -0.40), "dome", RGB(190, 230, 210), 2.0, 0.28)
  b:light(H, CF(0, -0.30, PZ + 0.20), "dome", RGB(190, 230, 210), 1.2, 0.18)
  b:light(H, CF(ox, -0.30, PZ + 0.20), "dome", RGB(190, 230, 210), 1.2, 0.18)
  b:light(H, CF(cx, -0.10, PZ + 0.20), "warn", RGB(255, 40, 30), 1.6, 0)
  b:name("glass", glass)
  return { air = true, heli = heli, yoke = L.ctrl == "yoke", stations = stations, order = order, crew = crew, cn = cn, glass = glass,
    seat = L.seat, eyeShift = L.eyeShift }
end

---------------------------------------------------------------- 串列双座武装直升机（阿帕奇；原来还有直-10，11-27 删了）：我坐后座（飞行员，高一截），前座射手在前下方
--   L = { cn 中式座舱, hud = 后座有平显, ihadss = 头盔单目显示（阿帕奇：Interior 把平显画在眼前） }
-- 资料：AH-64D/E 后座 —— 两块 6.24 英寸多功能显示器、上前显示器（EUFD）、备份仪表、左边总距杆和两根发动机功率杆、右边通信面板；
--   座舱盖是平板玻璃（前后座中间一块透明防爆隔板），后座右边是门；前座（AH-64E）的目标截获显示器（TEDAC）带两个握把
function Defs.tandem(b, ctx, L)
  local H = "hull"
  local cn = L.cn
  local eye = V()
  local function bx(sx, sy, sz, x, y, z, col, mat, rx, ry, rz)
    return b:box(H, V(sx, sy, sz), CF(x, y, z) * ANG(rad(rx or 0), rad(ry or 0), rad(rz or 0)), col, mat)
  end
  local function look(p, at) return CFrame.lookAt(p, at or eye) end
  local glass = {}
  local P1, P2 = RGB(48, 52, 50), RGB(38, 41, 40)
  local FY = -1.10
  local FE = V(0, -0.45, -1.70)   -- 前座眼位（外模型两个飞行员差 1.7 米、低 0.43 米）
  -- 后座：浴盆、侧台
  bx(0.90, 0.03, 1.5, 0, FY, -0.20, P2, MAT.DiamondPlate)
  for _, s in ipairs({ -1, 1 }) do
    bx(0.03, 0.70, 1.5, s * 0.46, FY + 0.35, -0.20, P1)
    bx(0.16, 0.10, 0.80, s * 0.37, -0.64, -0.05, P1)
    for i = 0, 3 do
      b:panel(H, 0.14, 0.17, CFrame.lookAt(V(s * 0.37, -0.585, -0.38 + i * 0.20), V(s * 0.32, 0.4, -0.26 + i * 0.20)), 3, 3, RGB(54, 58, 62), { guard = i == 1 })
    end
  end
  bx(0.90, 1.4, 0.04, 0, -0.42, 0.55, P2)
  -- 仪表板（窄、高）、遮光罩
  --   用户 11-22：「飞机的电子屏会被挡住」——两块主显示器原来摆在仪表板正面后面 6 厘米（整块被仪表板盖住），上面一排小屏和备份仪表被遮光罩下沿、
  --   平显投影仪挡住。现在屏幕都贴在仪表板正面、跟面平行；遮光罩往前收到离眼 0.61 米；平显投影仪往前挪；主告警 / 注意灯挪到投影仪两边
  local PZ = -0.66
  local PC = CF(0, -0.44, PZ) * ANG(rad(-10), 0, 0)   -- 仪表板（上沿往前倒 10°）
  b:box(H, V(0.62, 0.42, 0.06), PC, P1)
  local function onPanel(x, y, lift) return PC * CF(x, y, 0.03 + (lift or 0.004)) * ANG(0, PI, 0) end   -- 仪表板正面上（板面坐标）、正面朝人
  bx(0.62, 0.05, 0.14, 0, -0.215, PZ - 0.02, GLARE, MAT.Fabric, 4, 0, 0)
  local K = cn and { top = { "姿态", "雷达", "态势", "武器", "发动机" }, bottom = { "油量", "检查", "目标", "通信", "菜单" } }
    or { top = { "PFD", "RDR", "SA", "SMS", "ENG" }, bottom = { "FUEL", "CHK", "TGT", "COM", "MENU" } }
  b:screen(H, 0.16, 0.16, onPanel(-0.135, -0.03), "mfd_sa", { keys = K, lightK = 0.3 })
  b:screen(H, 0.16, 0.16, onPanel(0.135, -0.03), cn and "mfd_pfd" or "mfd_rdr", { keys = K, lightK = 0.3 })
  b:screen(H, 0.12, 0.05, onPanel(-0.17, 0.15), "ufd2", { lightK = 0.15 })   -- 上前显示器（告警、油量、起落）
  standby(b, H, onPanel(0.19, 0.15, 0.012).Position, eye, 0.06)
  b:led(H, CF(-0.15, -0.19, PZ + 0.0), RGB(255, 40, 30), 0.02, "mwarn")
  b:led(H, CF(0.15, -0.19, PZ + 0.0), RGB(255, 180, 30), 0.02, "mcaut")
  b:placard(H, 0.07, 0.016, look(V(-0.15, -0.222, PZ + 0.053)), cn and "主告警" or "MSTR WARN", { bg = C.black, fg = RGB(255, 80, 70) })   -- 贴在遮光罩后沿
  b:placard(H, 0.07, 0.016, look(V(0.15, -0.222, PZ + 0.053)), cn and "主注意" or "MSTR CAUT", { bg = C.black, fg = RGB(255, 190, 60) })
  if L.hud then hudUnit(b, H, V(0, -0.09, PZ + 0.02), eye) end
  -- 座椅（防弹座椅，侧翼装甲板）
  b:seat(H, CF(0, -0.80, 0.14), { w = 0.46, d = 0.44, back = 0.70, recline = 12, col = RGB(66, 68, 60), frame = RGB(44, 46, 48) })
  for _, s in ipairs({ -1, 1 }) do bx(0.03, 0.55, 0.38, s * 0.26, -0.52, 0.28, RGB(70, 72, 64), nil, 12, 0, 0) end
  bx(0.34, 0.20, 0.10, 0, 0.02, 0.40, RGB(58, 60, 54), MAT.Fabric, 12, 0, 0)
  for _, s in ipairs({ -1, 1 }) do bx(0.03, 0.03, 0.30, s * 0.19, -0.25, 0.08, RGB(60, 70, 50), MAT.Fabric, -50, 0, 0) end
  -- 周期变距杆、总距杆、两根发动机功率杆、脚蹬
  b:group("stick", H, CF(0, FY + 0.04, -0.34))
  b:tube("stick", V(0, 0, 0), V(0, 0.50, 0.04), 0.03, C.dark, MAT.Metal)
  b:box("stick", V(0.05, 0.14, 0.05), CF(0, 0.57, 0.05) * ANG(rad(-8), 0, 0), C.black)
  b:button("stick", CF(0, 0.645, 0.03) * ANG(rad(-70), 0, 0), C.red, 0.012)
  b:box("stick", V(0.012, 0.035, 0.012), CF(0, 0.57, 0.02), RGB(60, 60, 60))
  b:group("coll", H, CF(-0.30, -0.80, 0.16))
  b:tube("coll", V(0, 0, 0), V(0, 0.02, -0.44), 0.035, C.dark, MAT.Metal)
  b:box("coll", V(0.06, 0.07, 0.12), CF(0, 0.04, -0.48), C.black)
  b:button("coll", CF(0, 0.08, -0.50) * ANG(rad(-90), 0, 0), C.dark, 0.014)
  for _, s in ipairs({ 0, 1 }) do   -- 发动机功率杆（左侧台前端）
    bx(0.012, 0.07, 0.012, -0.36 + s * 0.03, -0.56, -0.40, C.lgray, MAT.Metal, -20, 0, 0)
    bx(0.022, 0.02, 0.03, -0.36 + s * 0.03, -0.52, -0.42, C.black)
  end
  for _, s in ipairs({ -1, 1 }) do
    local gname = (s < 0) and "pedL" or "pedR"
    b:group(gname, H, CF(s * 0.14, FY + 0.16, -0.98))
    b:box(gname, V(0.10, 0.20, 0.03), CF() * ANG(rad(-20), 0, 0), RGB(40, 42, 44), MAT.Metal)
  end
  -- 前座（射手）：从后座越过仪表板、透过防爆隔板看得到——浴盆、两侧台、仪表板、目标截获显示器（TEDAC）和两个握把、侧杆、总距杆、座椅
  local fz = FE.Z
  local FF = FE.Y - 1.10   -- 前座地板
  window(b, H, glass, V(0, 0.06, -0.78), V(0, 0, 1), V(0, 1, 0), 0.82, 0.52, 0.03, 0.88)   -- 防爆隔板（透明，仪表板上沿到座舱盖顶）
  bx(0.84, 0.03, 1.5, 0, FF, fz - 0.30, P2, MAT.DiamondPlate)
  for _, s in ipairs({ -1, 1 }) do
    bx(0.03, 0.70, 1.5, s * 0.43, FF + 0.35, fz - 0.30, P1)
    bx(0.15, 0.10, 0.70, s * 0.35, FE.Y - 0.64, fz - 0.10, P1)
    for i = 0, 2 do
      b:panel(H, 0.13, 0.17, CFrame.lookAt(V(s * 0.35, FE.Y - 0.585, fz - 0.36 + i * 0.20), V(s * 0.30, FE.Y + 0.4, fz - 0.24 + i * 0.20)), 3, 3, RGB(54, 58, 62))
    end
  end
  bx(0.84, 0.60, 0.04, 0, FE.Y - 0.85, fz + 0.50, P2)   -- 前座后面的隔框（后座脚蹬前面）
  b:seat(H, CF(0, FE.Y - 0.80, fz + 0.14), { w = 0.44, d = 0.42, back = 0.66, recline = 12, col = RGB(66, 68, 60), frame = RGB(44, 46, 48) })
  bx(0.34, 0.20, 0.10, 0, FE.Y + 0.02, fz + 0.40, RGB(58, 60, 54), MAT.Fabric, 12, 0, 0)
  b:box(H, V(0.56, 0.36, 0.06), CF(0, FE.Y - 0.42, fz - 0.62) * ANG(rad(-14), 0, 0), P1)
  local tw, th = 0.20, 0.15
  if L.ihadss then tw, th = 0.127, 0.127 end   -- AH-64E 的 TEDAC：5 × 5 英寸液晶（docs/cockpit_research.md）
  b:box(H, V(tw + 0.10, th + 0.07, 0.16), CF(0, FE.Y - 0.16, fz - 0.52), RGB(34, 36, 36))      -- 目标截获显示器机箱
  b:screen(H, tw, th, look(V(0, FE.Y - 0.14, fz - 0.435), FE), "gunsight", { lightK = 0.25 })
  for _, s in ipairs({ -1, 1 }) do bx(0.05, 0.12, 0.06, s * 0.20, FE.Y - 0.30, fz - 0.42, C.black, nil, -20, 0, 0) end   -- 两个握把
  bx(0.04, 0.12, 0.05, 0.33, FE.Y - 0.56, fz - 0.10, C.black, nil, -12, 0, 0)                  -- 射手的侧杆（右侧台）
  bx(0.035, 0.035, 0.40, -0.30, FE.Y - 0.78, fz - 0.10, C.dark, MAT.Metal, 4, 0, 0)            -- 射手的总距杆（左边）
  for _, s in ipairs({ -1, 1 }) do bx(0.10, 0.20, 0.03, s * 0.13, FF + 0.16, fz - 0.95, RGB(40, 42, 44), MAT.Metal, -20, 0, 0) end
  -- 座舱盖：平板玻璃。后座：两侧（右边是门）、顶上、前面一块斜的（越过前座看出去）；前座：前风挡（带雨刷）、两侧
  window(b, H, glass, V(-0.47, -0.02, -0.20), V(1, 0, 0), V(0, 1, 0), 1.10, 0.62, 0.035)
  window(b, H, glass, V(0.47, -0.02, -0.20), V(-1, 0, 0), V(0, 1, 0), 1.10, 0.62, 0.035)
  window(b, H, glass, V(0, 0.34, -0.25), V(0, -1, 0), V(0, 0, -1), 0.80, 0.95, 0.035, 0.86)
  window(b, H, glass, V(0, 0.12, -0.86), V(0, -0.55, 1).Unit, V(0, 1, 0.55).Unit, 0.84, 0.48, 0.035)
  window(b, H, glass, V(0, FE.Y + 0.05, fz - 0.80), V(0, -0.5, 1).Unit, V(0, 1, 0.5).Unit, 0.72, 0.52, 0.04)
  wiper(b, H, V(0, FE.Y - 0.18, fz - 0.84), 0.40, 14, V(0, 0.5, -1).Unit)
  for _, s in ipairs({ -1, 1 }) do
    window(b, H, glass, V(s * 0.43, FE.Y + 0.02, fz - 0.15), V(-s, 0, 0.15).Unit, V(0, 1, 0), 0.95, 0.60, 0.035)
    bar(b, H, V(s * 0.45, -0.32, 0.34), V(s * 0.45, 0.34, 0.34), 0.05)
    bar(b, H, V(s * 0.45, 0.34, 0.34), V(s * 0.42, 0.34, -0.80), 0.05)
  end
  -- 灯
  b:light(H, CF(0, 0.20, -0.30), "dome", RGB(190, 230, 210), 1.6, 0.25)
  b:light(H, CF(0, -0.30, PZ + 0.18), "dome", RGB(190, 230, 210), 1.0, 0.16)
  b:light(H, CF(0, FE.Y + 0.20, fz - 0.20), "dome", RGB(190, 230, 210), 1.2, 0.16)
  b:light(H, CF(0, -0.10, PZ + 0.20), "warn", RGB(255, 40, 30), 1.4, 0)
  b:name("glass", glass)
  local dress = cn and "heli_cn" or "heli_us"
  local crew = {
    pilot = { dress = dress, g = H, eye = eye, lean = 2, yaw = 0, look = V(0, -0.05, -1),
      hands = { r = { "stick", V(0, 0.58, 0.05) }, l = { "coll", V(0, 0.05, -0.46) } },
      feet = { l = { "pedL", V(0, -0.04, 0.06) }, r = { "pedR", V(0, -0.04, 0.06) } } },
    gunner = { dress = dress, g = H, eye = FE, lean = 6, yaw = 0, look = V(0, -0.25, -1),
      hands = { l = { H, FE + V(-0.20, -0.26, -0.40) }, r = { H, FE + V(0.20, -0.26, -0.40) } },
      feet = { l = { H, FE + V(-0.12, -0.95, -0.80) }, r = { H, FE + V(0.12, -0.95, -0.80) } } },
  }
  local stations = {
    pilot = { g = H, eye = eye, look = V(0, -0.03, -1), yaw = 150, up = 70, down = 65, crew = "pilot" },
    gunner = { g = H, eye = FE, look = V(0, -0.10, -1), yaw = 150, up = 60, down = 60, crew = "gunner" },
  }
  return { air = true, heli = true, stations = stations, order = { "pilot", "gunner" }, crew = crew, cn = cn, glass = glass,
    seat = 2, ihadss = L.ihadss }
end

Defs.ah64e = function(b, ctx) return Defs.tandem(b, ctx, { ihadss = true }) end
Defs.uh60 = function(b, ctx) return Defs.side(b, ctx, { half = 0.50, me = "R", ctrl = "heli", disp = "uh60m", win = "heli", chin = true, seat = 2 }) end
Defs.ch47 = function(b, ctx) return Defs.side(b, ctx, { half = 0.60, me = "R", ctrl = "heli", disp = "ch47f", win = "heli", chin = true, seat = 2 }) end
Defs.z20 = function(b, ctx) return Defs.side(b, ctx, { half = 0.50, me = "L", ctrl = "heli", disp = "z20", win = "heli", chin = true, cn = true, seat = 1 }) end
Defs.h6k = function(b, ctx) return Defs.side(b, ctx, { half = 0.55, me = "L", ctrl = "yoke", disp = "h6k", win = "bomber", cn = true, hud = true, thr = 2, eyeShift = -0.55 }) end
Defs.b2 = function(b, ctx) return Defs.side(b, ctx, { half = 0.62, me = "L", ctrl = "stick", disp = "b2", win = "bomber", thr = 4, thrSide = true, eyeShift = -0.62 }) end

-- 步战车、装甲车、自行火炮、自行高炮、轮式车、卡车（InteriorAFV.lua）
require(script.Parent:WaitForChild("InteriorAFV"))(Defs, { window = window, pane = pane, bar = bar, wiper = wiper, standby = standby, hudUnit = hudUnit })
-- M1A1 原模型自带的炮塔内饰（拆成 15 块）：A1 原样、M1A2 SEPv2 整套借、布雷德利借炮长 / 车长位那几件（InteriorAbrams.lua）
require(script.Parent:WaitForChild("InteriorAbrams"))(Defs, { scr = scr, PSCR = PSCR })

return Defs
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="233">
          <Properties>
            <string name="Name">InteriorKit</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——载具内饰的零件库（Interior.lua、InteriorDefs.lua 用）
--   用户 11-21：所有载具一比一还原内饰和里面所有功能性的东西（屏幕等），对标 Steel Beasts，要拿去拍电影
--   · 坐标一律用真实的米（1 米 = 2.8 格，和 VehDefs 一样）；挂在「组」上：根组 hull（车体，原点在炮塔座圈中心、座圈平面上，不随炮塔转）、
--     turret（同一点，随炮塔转）、gun（炮耳轴，随炮俯仰）；子组 = 父组 × 支点 × 动画（舱门滑开、炮闩下落、转盘转、弹丸被抬起……每帧改 anim）
--   · Interior 每帧算好各组的世界姿态，零件一次 BulkMoveTo；零件都不碰撞、不挡射线
--   · 屏幕：一块黑边框 + 一块发光的显示面（SurfaceGui，不受光照、自己发光，前面再挂一个很弱的 SurfaceLight 把车里照出一点屏幕的颜色）
--   · 乘员：R15 小人（服务器做的模板 ReplicatedStorage.BotRig，没有就用零件拼一个关节名字一样的），关节按反向运动学摆：
--     骨盆放在座位上，手握在操纵杆 / 方向把 / 炮弹上，脚踩在踏板 / 地板上，头朝着看的方向
local RS = game:GetService("ReplicatedStorage")

local K = {}
local V, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local RGB = Color3.fromRGB
local MAT = Enum.Material
local CYL, BALL = Enum.PartType.Cylinder, Enum.PartType.Ball
local S = 2.8   -- 1 米多少格
local PI = math.pi
K.S = S
local function rad(d) return math.rad(d) end
K.rad = rad

-- 米 → 格：位置乘 2.8，转角不变
local function toS(cf) return CF(cf.Position * S) * cf.Rotation end
K.toS = toS

-- 常用颜色（各车自己的漆色在 InteriorDefs 里）
K.C = {
  black = RGB(24, 25, 27), dark = RGB(44, 46, 49), gray = RGB(92, 95, 98), lgray = RGB(150, 153, 156), steel = RGB(118, 121, 124),
  gun = RGB(58, 60, 62), od = RGB(78, 84, 60), rubber = RGB(20, 20, 21), brass = RGB(176, 140, 72), copper = RGB(160, 96, 60),
  red = RGB(178, 38, 34), yellow = RGB(222, 184, 40), white = RGB(226, 226, 220), glass = RGB(30, 44, 52), screen = RGB(6, 9, 8),
  cable = RGB(30, 30, 32), cableG = RGB(70, 78, 56), green = RGB(60, 180, 90), amber = RGB(255, 170, 40), fabric = RGB(58, 56, 50),
}

local B = {}
B.__index = B

function K.new(model)
  local b = setmetatable({ model = model, parts = {}, groups = {}, gorder = {}, screens = {}, lights = {}, leds = {}, named = {},
    anims = {}, crew = {}, stations = {}, small = 0, softkeys = {} }, B)
  b:group("hull")
  b:group("turret")
  b:group("gun")
  return b
end

-- 组：parent 为 nil 的是根组（Interior 每帧直接给世界姿态）；子组的世界姿态 = 父组 × pivot × anim
function B:group(name, parent, pivot)
  if self.groups[name] then return self.groups[name] end
  local g = { name = name, parent = parent and self.groups[parent] or nil, pivot = pivot and toS(pivot) or CF(), anim = CF(), parts = {} }
  self.groups[name] = g
  table.insert(self.gorder, g)
  return g
end
-- 改一个子组的动画姿态（米）
function B:setAnim(name, cf)
  local g = self.groups[name]
  if g then g.anim = toS(cf) end
end

---------------------------------------------------------------- 零件

local SMALL = 0.05   -- 比这小的零件不投影（几百颗螺栓、开关都投影的话，车里几盏灯的阴影图很费）
function B:add(gname, cls, size, cf, color, mat, shape)
  local p = Instance.new(cls)
  if shape then p.Shape = shape end
  p.Size = size * S
  p.Color = color or K.C.gray
  p.Material = mat or MAT.SmoothPlastic
  p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
  p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
  if math.max(size.X, size.Y, size.Z) < SMALL then p.CastShadow = false self.small += 1 end
  local off = toS(cf)
  p.CFrame = off
  p.Parent = self.model
  local g = self.groups[gname] or self.groups.hull
  table.insert(self.parts, { p, g, off })
  return p
end
function B:box(g, size, cf, col, mat) return self:add(g, "Part", size, cf, col, mat) end
-- 导入的原模型网格（MeshPart）：克隆一块摆进内饰；size、cf 是米（同 add）。导入时 Roblox 把每块网格绕它自己的中心转了半圈（ImportTurn）：摆的时候转回来
local TURN = require(RS:WaitForChild("ImportTurn")).TURN
function B:mesh(g, src, size, cf)
  local p = src:Clone()
  p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
  p.Size = size * S
  local off = toS(cf) * TURN
  p.CFrame = off
  p.Parent = self.model
  local gg = self.groups[g] or self.groups.hull
  table.insert(self.parts, { p, gg, off })
  return p
end
-- 真模型部件（用户 11-22：「不要自己建模，去 Sketchfab 找」「去模型网站找每一个部件的替代品」）：Sketchfab 上 CC-BY 的原模型
--   （tools/weapons/optics.json 的 ip_* 件：电台、灭火瓶、120 / 125 毫米弹、乘员头盔……，几何贴图原样，只减了面、换了单位方向），
--   Interior 设好 K.props（= Optics.lua 的 G.opticParts：导入的 GLB，没导入就开局后台现生成的网格）；拿不到返回 nil，调用的地方照旧用零件拼
--   件的坐标（器材坐标）：格、真实尺寸，+Z 朝前（弹头、电台面板）、+Y 朝上；cf 是米（同 add），k 缩放
K.props = nil
function B:prop(g, key, cf, k)
  local list = K.props and K.props(key)
  if not list then
    self.propMiss = self.propMiss or {}
    self.propMiss[key] = true   -- 还没生成好：Interior 等它好了重建一次内饰
    return nil
  end
  local gg = self.groups[g] or self.groups.hull
  local base = toS(cf)
  local out = {}
  for _, it in ipairs(list) do
    local p = it.part
    local off = base * it.cf
    if k and k ~= 1 then
      p.Size = p.Size * k
      off = base * CF(it.cf.Position * k) * it.cf.Rotation
    end
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
    p.CFrame = off
    p.Parent = self.model
    table.insert(self.parts, { p, gg, off })
    table.insert(out, p)
  end
  self.propN = (self.propN or 0) + 1
  return out
end
-- Imports.lua 收好的原模型（ReplicatedStorage.Imported.Optics.<键>）：块都复制到客户端了才用（文件夹上的 N 是服务器那边的块数）
function K.imported(key)
  local imp = RS:FindFirstChild("Imported")
  local opt = imp and imp:FindFirstChild("Optics")
  local f = opt and opt:FindFirstChild(key)
  if not f then return nil end
  local n = f:GetAttribute("N")
  if n and #f:GetChildren() < n then return nil end
  return f
end
function B:wedge(g, size, cf, col, mat) return self:add(g, "WedgePart", size, cf, col, mat) end
function B:cwedge(g, size, cf, col, mat) return self:add(g, "CornerWedgePart", size, cf, col, mat) end
-- 圆柱：轴沿 cf 的 X
function B:cyl(g, len, dia, cf, col, mat) return self:add(g, "Part", V(len, dia, dia), cf, col, mat, CYL) end
-- 竖着的圆柱（轴沿 Y）、前后的圆柱（轴沿 Z）
function B:cylY(g, len, dia, cf, col, mat) return self:cyl(g, len, dia, cf * ANG(0, 0, PI / 2), col, mat) end
function B:cylZ(g, len, dia, cf, col, mat) return self:cyl(g, len, dia, cf * ANG(0, PI / 2, 0), col, mat) end
function B:ball(g, dia, cf, col, mat) return self:add(g, "Part", V(dia, dia, dia), cf, col, mat, BALL) end
-- 从 a 到 b 的一根管子 / 杆子 / 电缆（米）
function B:tube(g, a, b, dia, col, mat)
  local d = b - a
  local L = d.Magnitude
  if L < 1e-3 then return nil end
  return self:cyl(g, L, dia, CFrame.lookAt((a + b) / 2, b) * ANG(0, PI / 2, 0), col, mat)
end
-- 一串点连成的电缆 / 液压管：拐弯处补一个球（不露出折角）
function B:cable(g, pts, dia, col, mat)
  for i = 1, #pts - 1 do
    self:tube(g, pts[i], pts[i + 1], dia, col or K.C.cable, mat or MAT.SmoothPlastic)
    if i > 1 then self:ball(g, dia, CF(pts[i]), col or K.C.cable, mat or MAT.SmoothPlastic) end
  end
end
-- 一束电缆：几根并排、颜色略有不同（车里到处是成束的线）
function B:harness(g, pts, n, dia, side)
  side = side or V(1, 0, 0)
  for i = 1, n do
    local o = side * ((i - (n + 1) / 2) * dia * 1.15)
    local q = {}
    for j, p in ipairs(pts) do q[j] = p + o end
    local c = (i % 3 == 0) and K.C.cableG or ((i % 3 == 1) and K.C.cable or K.C.dark)
    self:cable(g, q, dia, c)
  end
end

---------------------------------------------------------------- 字、屏幕、灯

-- 在零件某一面挂 SurfaceGui；ppm 每米多少像素
function K.gui(part, face, ppm, glow)
  local sg = Instance.new("SurfaceGui")
  sg.Face = face or Enum.NormalId.Front
  sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
  sg.PixelsPerStud = (ppm or 600) / S
  sg.LightInfluence = glow and 0 or 1
  if glow then pcall(function() sg.Brightness = glow end) end
  sg.ClipsDescendants = true
  sg.ResetOnSpawn = false
  sg.Parent = part
  return sg
end
-- 一块标牌 / 铭牌：贴在零件的一面上的字（米黄底黑字、黑底白字、黄底黑字的警告牌）
function B:placard(g, w, h, cf, text, opt)
  opt = opt or {}
  local p = self:box(g, V(w, h, 0.004), cf, opt.bg or RGB(214, 206, 170), MAT.SmoothPlastic)
  p.CastShadow = false
  local sg = K.gui(p, Enum.NormalId.Front, opt.ppm or 900)
  local l = Instance.new("TextLabel")
  l.Size = UDim2.fromScale(1, 1)
  l.BackgroundTransparency = 1
  l.Text = text
  l.TextColor3 = opt.fg or RGB(20, 20, 18)
  l.Font = opt.font or Enum.Font.BuilderSansMedium
  l.TextScaled = true
  l.TextWrapped = true
  l.Parent = sg
  return p
end
-- 屏幕：边框（黑色塑料 / 铝壳）+ 显示面；返回 { part, gui, w, h }，page 是 InteriorScreens 里的页面名
function B:screen(g, w, h, cf, page, opt)
  opt = opt or {}
  -- 触摸屏（F-35 的全景屏、歼-20 / 歼-35 的大屏，docs/cockpit_research.md）：没有边框上凸出来的键，菜单条就画在玻璃上，页面往里让出一条
  local touch = opt.touch == true and type(opt.keys) == "table"
  local bez = opt.bezel or (touch and 0.012) or ((type(opt.keys) == "table") and 0.036 or 0.02)
  local d = opt.depth or 0.05
  -- 屏幕后面的边框底板；平显组合玻璃（noBack）不要：原来平显也垫了一块不透明黑底板，游戏里是一块黑方块上画绿字、挡住正前方（用户 11-21：光学显示屏不够还原）
  if not opt.noBack then
    -- 机壳（用户 11-24：「边框过于粗糙」——原来是一整块方方正正的黑板子）：圆角的机壳（中间一块、上下两条、四个角的圆柱），
    --   玻璃四周凸起一圈边框（比机壳亮一点；屏幕上下有实体键时不凸，免得盖住印在边框上的键名）、贴着玻璃一道细亮边（倒角的反光）
    local col = opt.frame or RGB(38, 40, 44)
    local W2, H2 = w + bez * 2, h + bez * 2
    local r = math.max(0.002, math.min(bez * 0.8, W2 * 0.1, H2 * 0.1, 0.018))
    local zc = d / 2 + 0.002
    self:box(g, V(W2, H2 - 2 * r, d), cf * CF(0, 0, zc), col, MAT.SmoothPlastic)
    self:box(g, V(W2 - 2 * r, r, d), cf * CF(0, H2 / 2 - r / 2, zc), col, MAT.SmoothPlastic)
    self:box(g, V(W2 - 2 * r, r, d), cf * CF(0, -H2 / 2 + r / 2, zc), col, MAT.SmoothPlastic)
    for _, sx in ipairs({ -1, 1 }) do
      for _, sy in ipairs({ -1, 1 }) do
        self:cylZ(g, d, 2 * r, cf * CF(sx * (W2 / 2 - r), sy * (H2 / 2 - r), zc), col, MAT.SmoothPlastic)
      end
    end
    local keyed = type(opt.keys) == "table" and not touch
    if not keyed then
      local fw = math.min(bez * 0.55, 0.012)
      local FC = col:Lerp(RGB(255, 255, 255), 0.1)
      for _, e in ipairs({ { 0, h / 2 + fw / 2, w + fw * 2, fw }, { 0, -h / 2 - fw / 2, w + fw * 2, fw }, { w / 2 + fw / 2, 0, fw, h }, { -w / 2 - fw / 2, 0, fw, h } }) do
        local p = self:box(g, V(e[3], e[4], 0.006), cf * CF(e[1], e[2], -0.001), FC, MAT.SmoothPlastic)
        p.CastShadow = false
      end
    end
    local hw = 0.0016
    for _, e in ipairs({ { 0, h / 2 + hw / 2, w + hw * 2, hw }, { 0, -h / 2 - hw / 2, w + hw * 2, hw }, { w / 2 + hw / 2, 0, hw, h }, { -w / 2 - hw / 2, 0, hw, h } }) do
      local p = self:box(g, V(e[3], e[4], 0.0065), cf * CF(e[1], e[2], -0.0012), RGB(118, 122, 128), MAT.Metal)
      p.CastShadow = false
    end
  end
  -- 显示面（用户 11-21：坐在车里看内饰，坦克屏幕有一块地方反光、看不清）：原来是 Glass 材质 + 一点反射、字的亮度 1.6——
  --   Glass 在 Roblox 里另外一遍画，车内灯的高光会叠在字上面；亮度又超过夜里泛光（Bloom）的门槛 1.05，亮的地方晕成一片。
  --   真车的显示器有防眩光涂层：改成哑光、不反射，亮度 1.0（不泛光）；平显的组合玻璃照旧自己给材质和亮度
  local face = self:box(g, V(w, h, 0.004), cf, K.C.screen, MAT.SmoothPlastic)
  face.CastShadow = false
  face.Reflectance = 0
  -- 清晰度（用户 11-22：「载具内部显示屏像素太少，看不清字」）：页面照旧按每米 ppm 个「设计像素」排版（字号、位置都是这个单位），
  --   实际按 QK 倍的像素画（SurfaceGui 每米 ppm × QK 个像素），页面根上挂一个 UIScale（QK 倍）放大回来——字、线的大小不变，像素多了 QK² 倍
  --   用户 11-23 又说「目前所有载具显示屏清晰度太低」：QK 不再固定 2 倍，按这块屏的大小算——长边画到约 1100 个真像素（小屏、大屏一样清楚），
  --   最少 2 倍、最多 4 倍（原来一块 25 厘米的屏长边 700 像素，现在 1100）
  local QK = 1   -- 平显本来就是每米 3000，不用再加
  if page ~= "hud" then
    local long = math.max(w, h) * (opt.ppm or 1400)
    QK = math.clamp(1100 / math.max(long, 1), 2, 4)
  end
  local sg = K.gui(face, Enum.NormalId.Front, (opt.ppm or 1400) * QK, opt.glow or 1.0)
  local tabT = (touch and opt.keys.top and #opt.keys.top > 0) and (opt.touchH or 0.1) or 0      -- 上、下菜单条各占屏高几成
  local tabB = (touch and opt.keys.bottom and #opt.keys.bottom > 0) and (opt.touchH or 0.1) or 0
  local root = Instance.new("Frame")
  root.Name = "Page"
  root.Position = UDim2.fromScale(0, tabT)
  root.Size = UDim2.fromScale(1, 1 - tabT - tabB)
  root.BackgroundColor3 = RGB(0, 0, 0)
  root.BorderSizePixel = 0
  root.Parent = sg
  if QK ~= 1 then
    root.Size = UDim2.fromOffset(w * (opt.ppm or 1400), h * (opt.ppm or 1400) * (1 - tabT - tabB))   -- 设计像素
    pcall(function()
      local sc = Instance.new("UIScale")
      sc.Scale = QK
      sc.Parent = root
    end)
  end
  local s = { part = face, gui = sg, root = root, w = w, h = h, page = page, opt = opt, group = g, px = V(w, h * (1 - tabT - tabB), 0) * (opt.ppm or 1400) }
  if opt.light ~= false then   -- 屏幕把前面一小块照亮
    local L = Instance.new("SurfaceLight")
    L.Face = Enum.NormalId.Front
    L.Range = (opt.lightRange or 1.4) * S
    L.Brightness = opt.lightK or 0.35
    L.Angle = 80
    L.Shadows = false
    L.Color = opt.lightColor or RGB(140, 200, 160)
    L.Parent = face
    s.light = L
  end
  -- 按键：屏幕上下各一排（多功能显示器、指挥终端、驾驶员显示器都有），按键旁边边框上印着字；
  --   opt.keys = { top = { "MAP", … }, bottom = { … } }（真实的标签和功能见 InteriorScreens 的 KEYDESC），数字就是不带字的
  if touch then   -- 触摸屏：一格格薄片贴在玻璃前面（对准、按下同实体键：Interior 的 pickKey 按正面求交）
    for _, side in ipairs({ "top", "bottom" }) do
      local list = opt.keys[side] or {}
      local n = #list
      local th = h * ((side == "top") and tabT or tabB)
      for i, label in ipairs(list) do
        local x = w / 2 - (i - 0.5) * w / n
        local sy = (side == "top") and 1 or -1
        local key = self:box(g, V(w / n * 0.94, th * 0.84, 0.001), cf * CF(x, sy * (h / 2 - th / 2), -0.0026), RGB(16, 30, 26), MAT.SmoothPlastic)
        key.CastShadow = false
        local lg = K.gui(key, Enum.NormalId.Front, opt.ppm or 1400, 1.2)
        local t = Instance.new("TextLabel")
        t.Size = UDim2.fromScale(1, 0.86)
        t.Position = UDim2.fromScale(0, 0.07)
        t.BackgroundTransparency = 1
        t.Text = label
        t.TextColor3 = RGB(190, 236, 214)
        t.Font = Enum.Font.BuilderSansMedium
        t.TextScaled = true
        t.Parent = lg
        local st = Instance.new("UIStroke")   -- 触摸格的细边框（玻璃上画的，不是实体键）
        st.Color, st.Thickness, st.Transparency = RGB(90, 160, 140), 1, 0.3
        local bg = Instance.new("Frame")
        bg.Size, bg.BackgroundTransparency, bg.BorderSizePixel = UDim2.fromScale(1, 1), 1, 0
        st.Parent = bg
        bg.Parent = lg
        table.insert(self.softkeys, { part = key, label = label, screen = s, side = side, idx = i, col = key.Color, touch = true })
      end
    end
  elseif opt.keyPos and type(opt.keys) == "table" then
    -- 真模型外壳上原有的实体键（B:propScreen）：每个键一块和原键帽一样大的薄键帽盖在上面，印上这个键的字（背光，照片里车长显示器的键是蓝白色背光），
    --   对准、按下同普通键；keyPos[side][i] = { x, y, 宽, 高, z }（米，屏幕 cf 里）
    for _, side in ipairs({ "top", "bottom" }) do
      local list = opt.keys[side] or {}
      local pos = opt.keyPos[side] or {}
      for i, label in ipairs(list) do
        local p = pos[i]
        if p then
          local key = self:box(g, V(p[3], p[4], 0.003), cf * CF(p[1], p[2], p[5] or -0.004), opt.keyCol or RGB(34, 36, 38))
          key.CastShadow = false
          local lg = K.gui(key, Enum.NormalId.Front, 2600, 1.1)
          local t = Instance.new("TextLabel")
          t.Size = UDim2.fromScale(0.92, 0.8)
          t.Position = UDim2.fromScale(0.04, 0.1)
          t.BackgroundTransparency = 1
          t.Text = label
          t.TextColor3 = opt.keyFg or RGB(176, 214, 255)
          t.Font = Enum.Font.BuilderSansMedium
          t.TextScaled = true
          t.Parent = lg
          table.insert(self.softkeys, { part = key, label = label, screen = s, side = side, idx = i, col = key.Color })
        end
      end
    end
  elseif type(opt.keys) == "table" then
    for _, side in ipairs({ "top", "bottom" }) do
      local list = opt.keys[side] or {}
      local n = #list
      for i, label in ipairs(list) do
        local x = w / 2 - (i - 0.5) * w / n   -- 屏幕的 −Z 对着人，人的右手边是局部 −X：第一个键在人看来最左边
        local kw = math.min(0.030, w / n * 0.72)
        local sy = (side == "top") and 1 or -1
        local key = self:box(g, V(kw, 0.011, 0.010), cf * CF(x, sy * (h / 2 + bez * 0.72), -0.005), RGB(62, 64, 66))
        key.CastShadow = false
        local lb = self:box(g, V(kw * 1.25, bez * 0.40, 0.001), cf * CF(x, sy * (h / 2 + bez * 0.28), -0.0012), opt.frame or K.C.black)
        lb.CastShadow = false
        local lg = K.gui(lb, Enum.NormalId.Front, 2600, 1)
        local t = Instance.new("TextLabel")
        t.Size = UDim2.fromScale(1, 1)
        t.BackgroundTransparency = 1
        t.Text = label
        t.TextColor3 = RGB(226, 230, 222)
        t.Font = Enum.Font.BuilderSansMedium
        t.TextScaled = true
        t.Parent = lg
        table.insert(self.softkeys, { part = key, label = label, screen = s, side = side, idx = i, col = key.Color })
      end
    end
  elseif opt.keys then
    local n = opt.keys
    for i = 1, n do
      local x = -w / 2 + (i - 0.5) * w / n
      self:box(g, V(math.min(0.022, w / n * 0.6), 0.012, 0.012), cf * CF(x, -h / 2 - bez * 0.55, -0.004), RGB(70, 72, 74))
      self:box(g, V(math.min(0.022, w / n * 0.6), 0.012, 0.012), cf * CF(x, h / 2 + bez * 0.55, -0.004), RGB(70, 72, 74))
    end
  end
  table.insert(self.screens, s)
  return s
end
-- 真模型外壳的屏幕（用户 11-22 发来 M1A2 车长位照片：「图片里摇杆、计算机、屏幕……识别到了就去 Sketchfab 找类似的」）：
--   原模型（器材坐标：格，+Z 是正面）摆好，屏幕玻璃前面贴我们的动态显示面，原模型的实体键上盖一层能按的键帽（印这个键的字）；
--   P 是这件模型的版面（器材坐标，格）：c 玻璃中心 { x, y, z }、w / h 玻璃宽高、kz 键帽正面的 z、
--   keys = { top = { { x, y, 宽, 高 }, … }, bottom = … }（opt.keys 里 top、bottom 两组键各盖在哪几个实体键上）；k 缩放（真实尺寸的倍数）
--   cf 是屏幕中心（米，−Z 对着人，同 B:screen）；模型还没生成好返回 nil，调用的地方照旧画普通屏幕
function B:propScreen(g, key, cf, k, page, P, opt)
  k = k or 1
  local c = P.c
  local m = k / S   -- 器材坐标的格 → 米
  if not self:prop(g, key, cf * ANG(0, PI, 0) * CF(-c[1] * m, -c[2] * m, -c[3] * m), k) then return nil end
  local o = {}
  for a, v in pairs(opt or {}) do o[a] = v end
  o.noBack, o.bezel, o.propShell = true, 0.006, true
  local face = cf * CF(0, 0, -0.003)   -- 显示面贴在玻璃前面 3 毫米（不和原模型的玻璃抢深度）
  if P.keys and type(o.keys) == "table" then
    o.keyPos = {}
    for side, list in pairs(P.keys) do
      o.keyPos[side] = {}
      for i, q in ipairs(list) do
        -- 器材坐标（人看过去 +X 在右手边）→ 屏幕 cf（人的右手边是 −X）；键帽贴在原键帽正面前面 1.5 毫米
        o.keyPos[side][i] = { -(q[1] - c[1]) * m, (q[2] - c[2]) * m, q[3] * m, q[4] * m, -((q[5] or P.kz or c[3]) - c[3]) * m + 0.0015 }   -- q[5]：这个键自己的键帽 z（旋钮比按键高）
      end
    end
  end
  return self:screen(g, P.w * m, P.h * m, face, page, o)
end
-- 灯：一个看不见的小零件挂 PointLight / SpotLight；role 给 Interior 分组控制（dome 车内照明、flash 炮口火光透进来、warn 告警红灯……）
function B:light(g, cf, role, color, range, bright, spotAngle, face)
  local p = self:box(g, V(0.02, 0.02, 0.02), cf, color, MAT.SmoothPlastic)
  p.Transparency = 1
  local L
  if spotAngle then
    L = Instance.new("SpotLight")
    L.Angle = spotAngle
    L.Face = face or Enum.NormalId.Bottom
  else
    L = Instance.new("PointLight")
  end
  L.Color = color
  L.Range = range * S
  L.Brightness = bright
  L.Shadows = true
  L.Parent = p
  table.insert(self.lights, { L = L, role = role, color = color, bright = bright, part = p })
  return L
end
-- 指示灯（霓虹，会发光）：role 由 Interior 按状态点亮 / 熄灭 / 闪；ext 并进这一项（role = "key" 的：s 屏幕、k 键名——亮不亮问 s.ledOn(k)）
function B:led(g, cf, color, dia, role, ext)
  local p = self:add(g, "Part", V(dia or 0.008, dia or 0.008, dia or 0.008), cf, color, MAT.Neon, BALL)
  p.CastShadow = false
  local e = { p = p, role = role, on = color, off = color:Lerp(RGB(0, 0, 0), 0.82) }
  if ext then for a, v in pairs(ext) do e[a] = v end end
  table.insert(self.leds, e)
  return p
end
-- 一个能按的键（用户 11-23 发来钢铁猛兽 M1A2 车长显示单元截图：屏边蓝色背光键、橙色横杠键、橙色描边的字母数字键盘、橙色方向键）：
--   s 是它管的那块屏幕（按下去调 s.onKey(label)）；cf 键帽正面中心（−Z 对着人，米），w / h 宽高；style：
--   "blue" 蓝色背光键（淡蓝的字）、"dark" 深色键、"dash" 一道橙色横杠（功能名画在屏幕边上）、"pad" 键盘键（橙色描边，上面字母、下面数字）、
--   "arrow" 橙色箭头（opt.dir 0 上、90 右、180 下、270 左）、"orange" 橙色字的键；opt.text 印在键上的字（不给就用 label）、opt.sub 键盘键上面那行字母
local KEYCOL = { blue = RGB(36, 56, 128), dark = RGB(30, 32, 42), dash = RGB(42, 36, 34), pad = RGB(40, 34, 32), arrow = RGB(40, 34, 32), orange = RGB(60, 42, 32) }
local ORANGE = RGB(255, 138, 40)
function B:keyCap(g, s, cf, w, h, label, style, opt)
  opt = opt or {}
  local d = opt.d or 0.004
  local key = self:box(g, V(w, h, d), cf * CF(0, 0, d / 2), KEYCOL[style] or KEYCOL.dark, MAT.SmoothPlastic)
  key.CastShadow = false
  local lg = K.gui(key, Enum.NormalId.Front, opt.ppm or 2600, 1.1)
  local function txt(t, x, y, sw, sh, col, align)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position, l.Size = UDim2.fromScale(x, y), UDim2.fromScale(sw, sh)
    l.Text = t
    l.TextColor3 = col
    l.Font = Enum.Font.BuilderSansMedium
    l.TextScaled = true
    l.TextXAlignment = align or Enum.TextXAlignment.Center
    l.Parent = lg
    return l
  end
  local function bar(parent, x, y, sw, sh, col, rot)
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position, f.Size = UDim2.fromScale(x, y), UDim2.fromScale(sw, sh)
    f.BackgroundColor3 = col
    f.BorderSizePixel = 0
    f.Rotation = rot or 0
    f.Parent = parent
    return f
  end
  local function edge(col, th, tr)   -- 键帽一圈细边（背光键的透光边、键盘键的橙色描边）
    local f = Instance.new("Frame")
    f.Size, f.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    f.Parent = lg
    local st = Instance.new("UIStroke")
    st.Color, st.Thickness, st.Transparency = col, th, tr or 0
    st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    st.Parent = f
  end
  if style == "blue" or style == "dark" then
    edge(style == "blue" and RGB(90, 120, 210) or RGB(64, 68, 84), 2, 0.25)
    txt(opt.text or label, 0.06, 0.18, 0.88, 0.64, style == "blue" and RGB(170, 196, 255) or RGB(150, 156, 176))
  elseif style == "dash" then
    bar(lg, 0.5, 0.24, 0.72, 0.13, ORANGE)
  elseif style == "pad" then
    edge(ORANGE, 2.5, 0)
    if opt.sub then txt(opt.sub, 0.05, 0.06, 0.9, 0.34, ORANGE) end
    txt(opt.text or label, 0.08, opt.sub and 0.5 or 0.2, opt.sub and 0.5 or 0.84, opt.sub and 0.42 or 0.6, ORANGE, opt.sub and Enum.TextXAlignment.Left or nil)
  elseif style == "arrow" then
    local box = Instance.new("Frame")
    box.AnchorPoint = Vector2.new(0.5, 0.5)
    box.Position, box.Size, box.BackgroundTransparency = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.8, 0.8), 1
    box.Rotation = opt.dir or 0
    box.Parent = lg
    bar(box, 0.34, 0.5, 0.48, 0.14, ORANGE, -42)   -- 「^」的两笔
    bar(box, 0.66, 0.5, 0.48, 0.14, ORANGE, 42)
  else
    txt(opt.text or label, 0.06, 0.2, 0.88, 0.6, ORANGE)
  end
  table.insert(self.softkeys, { part = key, label = label, screen = s, side = opt.side or "key", idx = opt.idx or 0, col = key.Color })
  return key
end
function B:name(key, x) self.named[key] = x return x end

---------------------------------------------------------------- 可动部件（用户 11-22：「所有可动部件都要能动 我准心移动到哪点一下就能动」）

-- 子组 gname 就是能动的那个东西（舱盖、弹药门、手柄、拨动开关、旋钮、按钮……）：准心（屏幕中间的小点）对准它的点选盒、左键——
--   hinge 绕 axis（子组坐标里的轴）从 a0 转到 a1 度，两档；slide 沿 axis 移 d 米，两档；knob 每点一下绕 axis 转 step 度，n 档循环；
--   push 按下去 d 米、自己弹回来；fn(u) 自己给姿态（u 0~1，返回米的 CFrame：舱盖先抬起再转开这种）；custom 不动画，只调 on
--   hit = { size = V(米), cf = CF(子组坐标里，米) }（点选盒）；label = { 中文, 英文 }；t 动一次几秒；on 动完以后 Interior 做什么（动作名）；snd 声音
function B:mov(gname, spec)
  local g = self.groups[gname]
  if not g then return nil end
  spec.g, spec.name = g, gname
  spec.state = spec.state or 0
  spec.p = spec.state
  spec.t = spec.t or 0.35
  spec.axis = (spec.axis or V(1, 0, 0)).Unit
  self.movs = self.movs or {}
  table.insert(self.movs, spec)
  return spec
end
local function movName(self)
  self.movN = (self.movN or 0) + 1
  return "mv" .. self.movN
end

---------------------------------------------------------------- 常用件

-- 面板上的小件：cf 是面板表面上的一点，cf 的 −Z（LookVector）朝着看面板的人；东西往 −Z 凸出来，面板本体在 +Z 后面
-- 拨动开关（底座 + 拨杆，可带护盖）：拨杆是能点的（上下两档）
function B:toggle(g, cf, guard)
  self:box(g, V(0.012, 0.012, 0.008), cf * CF(0, 0, -0.004), K.C.steel, MAT.Metal)
  local gn = movName(self)
  self:group(gn, g, cf * CF(0, 0, -0.006))
  self:tube(gn, V(0, 0, 0), V(0, 0.008, -0.016), 0.004, K.C.lgray, MAT.Metal)
  self:mov(gn, { kind = "hinge", axis = V(1, 0, 0), a0 = 0, a1 = -62, t = 0.1, snd = "toggle",
    hit = { size = V(0.022, 0.03, 0.03), cf = CF(0, 0.002, -0.009) }, label = { "拨动开关", "Toggle switch" } })
  if guard then self:box(g, V(0.018, 0.026, 0.004), cf * CF(0, 0.004, -0.02) * ANG(rad(60), 0, 0), K.C.red, MAT.SmoothPlastic) end
end
-- 旋钮（带指示线）：能点，每点一下转一档（6 档）
function B:knob(g, cf, dia, col)
  dia = dia or 0.022
  local gn = movName(self)
  self:group(gn, g, cf)
  self:cylZ(gn, 0.014, dia, CF(0, 0, -0.007), col or K.C.black, MAT.SmoothPlastic)
  self:box(gn, V(0.002, dia * 0.45, 0.002), CF(0, dia * 0.22, -0.0145), K.C.white)
  self:mov(gn, { kind = "knob", axis = V(0, 0, 1), step = 40, n = 6, t = 0.12, snd = "knob",
    hit = { size = V(dia * 1.3, dia * 1.3, 0.026), cf = CF(0, 0, -0.008) }, label = { "旋钮", "Rotary knob" } })
end
-- 按钮：能点，按下去、弹回来
function B:button(g, cf, col, w)
  w = w or 0.014
  local gn = movName(self)
  self:group(gn, g, cf)
  self:box(gn, V(w, w, 0.008), CF(0, 0, -0.004), col or K.C.dark, MAT.SmoothPlastic)
  self:mov(gn, { kind = "push", axis = V(0, 0, 1), d = 0.004, t = 0.06, snd = "button",
    hit = { size = V(w * 1.4, w * 1.4, 0.022), cf = CF(0, 0, -0.006) }, label = { "按钮", "Push button" } })
end
-- 一块开关面板：底板 + 一格格的开关 / 旋钮 / 按钮 / 指示灯，标签条（rows × cols 格）；kinds 不给就按位置轮着放
function B:panel(g, w, h, cf, rows, cols, col, opt)
  opt = opt or {}
  local d = opt.depth or 0.04
  self:box(g, V(w, h, d), cf * CF(0, 0, d / 2), col or K.C.dark, MAT.SmoothPlastic)
  local kinds = opt.kinds or { "t", "k", "t", "b", "l", "t", "k", "b" }
  local n = 0
  for r = 1, rows do
    for c = 1, cols do
      n += 1
      local x = -w / 2 + (c - 0.5) * w / cols
      local y = h / 2 - (r - 0.5) * h / rows
      local k = kinds[(n - 1) % #kinds + 1]
      local q = cf * CF(x, y - h / rows * 0.12, 0)
      if k == "t" then self:toggle(g, q, opt.guard and (n % 5 == 0))
      elseif k == "k" then self:knob(g, q, math.min(w / cols, h / rows) * 0.42)
      elseif k == "b" then self:button(g, q, (n % 4 == 0) and K.C.red or K.C.black)
      elseif k == "l" then self:led(g, q * CF(0, 0, -0.004), (n % 3 == 0) and K.C.amber or K.C.green, 0.009, opt.ledRole)
      end
      if opt.labels ~= false then   -- 每格上面一条白色小字条（看不清写的什么，看着像）
        local lb = self:box(g, V(w / cols * 0.62, 0.006, 0.002), cf * CF(x, y + h / rows * 0.3, -0.001), RGB(200, 200, 190))
        lb.CastShadow = false
      end
    end
  end
end
-- 观察镜（潜望镜下半截）：钢壳 + 一块玻璃（玻璃是透的：外面的东西就从这里看得见）+ 上面的护额垫
--   opt.model：用真车潜望镜的扫描模型（ip_peri：Sketchfab 上 renalds_rs 的 FV105 Sultan 潜望镜，CC-BY，只取车里的下半截、减面重烘贴图，
--   tools/weapons/periscope.mjs；用户 11-22：「坦克第一人称驾驶舱那个潜望镜，你从 Sketchfab 自己找模型截取下来套用」）——
--   器材坐标原点在观察窗中心、+Z 朝看的人（同 cf 的 +Z），按观察窗宽（原件 23.7 厘米）缩放；没生成好照旧画零件拼的
function B:periscope(g, cf, w, h, d, opt)
  opt = opt or {}
  if opt.model and self:prop(g, "ip_peri", cf * CF(0, 0, -d / 2 + 0.012), w / 0.237) then
    if opt.pad ~= false then   -- 护额垫（黑橡胶）
      self:box(g, V(w + 0.02, 0.03, 0.03), cf * CF(0, h / 2 + 0.05, d / 2 - 0.01), K.C.rubber, MAT.Fabric)
    end
    return nil
  end
  local col = opt.col or K.C.dark
  self:box(g, V(w + 0.03, 0.02, d + 0.02), cf * CF(0, h / 2 + 0.01, 0), col, MAT.Metal)
  self:box(g, V(0.015, h, d), cf * CF(-w / 2 - 0.0075, 0, 0), col, MAT.Metal)
  self:box(g, V(0.015, h, d), cf * CF(w / 2 + 0.0075, 0, 0), col, MAT.Metal)
  self:box(g, V(w + 0.03, 0.015, d + 0.02), cf * CF(0, -h / 2 - 0.0075, 0), col, MAT.Metal)
  -- 玻璃：原来蓝绿色、只透 72%，夜里看着像一块发绿的板（用户 11-22：「现实中不带绿光」）——改成几乎无色、透 86%、一点点反光
  local gl = self:box(g, V(w, h, 0.006), cf * CF(0, 0, -d / 2 + 0.003), RGB(176, 184, 188), MAT.Glass)
  gl.Transparency = 0.86
  gl.Reflectance = 0.06
  gl.CastShadow = false
  if opt.pad ~= false then   -- 护额垫（黑橡胶）
    self:box(g, V(w + 0.02, 0.03, 0.03), cf * CF(0, h / 2 + 0.035, d / 2 - 0.01), K.C.rubber, MAT.Fabric)
  end
  return gl
end
-- 目镜的镜片（用户 11-24 指着 M1A1 车长延伸目镜：「这个圆圈里面是一个镜片 要有光学效果的凸透镜 反光和镀膜做出来」；
--   11-22：GPSE 目镜里是暗的、映着一点蓝，「现实中不带绿光」）：
--   · 凸透镜：压扁的椭球（SpecialMesh 球，前后厚 = 直径 × k），深色光学玻璃，Glass 材质（后面的东西有折射）+ 映环境
--   · 镀膜：外面再包一层薄薄的半透明椭球，增透膜的颜色（紫红，边上带一点绿）——真镜头斜着看泛紫光
--   · 反光：车里顶灯在凸面上的倒影——左上一块柔和的大高光、旁边一颗小而亮的；右下边缘一抹淡淡的镀膜反光（贴在椭球面上、按面的法线摆）
--   · 出瞳：正中一个很小很淡的亮点（瞄准镜里的光从这里出来；离远了看目镜就是这样一个小亮点）
--   cf 是镜片中心，凸面朝 cf 的 ±Z（opt.face = 1：看的人在 +Z 那边，高光、出瞳画在那面；−1 反过来）；返回镜片本体
local LENS_COAT = RGB(150, 70, 190)    -- 增透膜反光：紫红
local LENS_COAT2 = RGB(70, 190, 140)   -- 边缘那一抹：偏绿
function B:lens(g, cf, dia, opt)
  opt = opt or {}
  local k = opt.k or 0.28           -- 凸度：前后厚 / 直径
  local f = opt.face or 1
  local a, c = dia / 2, dia * k / 2   -- 椭球的半径、半厚（米）
  local function ell(sz, at, col, mat, tr, refl)
    local p = self:add(g, "Part", sz, at, col, mat)
    local m = Instance.new("SpecialMesh")
    m.MeshType = Enum.MeshType.Sphere
    m.Parent = p
    p.Transparency, p.Reflectance, p.CastShadow = tr or 0, refl or 0, false
    return p
  end
  local glass = ell(V(dia, dia, dia * k), cf, opt.col or RGB(10, 13, 22), MAT.Glass, 0.12, 0.30)
  ell(V(dia * 1.012, dia * 1.012, dia * k * 1.08), cf, opt.coat or LENS_COAT, MAT.SmoothPlastic, 0.86, 0.45)
  -- 椭球面上一点（u 右、v 上，−1 ~ 1，看的人看过去）和那里的法线：高光贴着面摆
  local function on(u, v, lift)
    local x, y = -f * u * a, v * a   -- 看的人在 +Z（f = 1）时，他的右手边是 +X；在 −Z 时反过来
    local zz = c * math.sqrt(math.max(0, 1 - u * u - v * v))
    local n = V(x / (a * a), y / (a * a), f * zz / (c * c)).Unit
    local p = V(x, y, f * zz) + n * (lift or 0.0004)
    return cf * CFrame.lookAt(p, p + n)
  end
  local function glint(u, v, w, h, col, tr, rot)
    local p = self:add(g, "Part", V(w, h, 0.0006), on(u, v) * ANG(0, 0, rad(rot or 0)), col, MAT.Neon)
    local m = Instance.new("SpecialMesh")
    m.MeshType = Enum.MeshType.Sphere
    m.Parent = p
    p.Transparency, p.CastShadow = tr, false
    return p
  end
  glint(-0.30, 0.32, dia * 0.26, dia * 0.16, RGB(235, 240, 255), 0.62, -35)   -- 顶灯的倒影：柔和的一大块
  glint(-0.40, 0.42, dia * 0.07, dia * 0.05, RGB(255, 255, 255), 0.12, -35)   -- 最亮的那一点
  glint(0.52, -0.48, dia * 0.20, dia * 0.06, LENS_COAT2, 0.70, 45)            -- 右下边缘：镀膜泛绿的一抹
  glint(0, 0, dia * 0.10, dia * 0.10, opt.pupil or RGB(190, 200, 205), 0.78)   -- 出瞳：正中很淡的小亮点
  return glass
end
-- 座椅：坐垫 + 靠背 + 钢架 + 调节手柄；cf 是坐垫上表面中心，−Z 朝前
function B:seat(g, cf, opt)
  opt = opt or {}
  local w, dp, bh = opt.w or 0.42, opt.d or 0.40, opt.back or 0.48
  local col = opt.col or K.C.fabric
  local fr = opt.frame or K.C.gray
  self:box(g, V(w, 0.07, dp), cf * CF(0, -0.035, 0), col, MAT.Fabric)
  self:box(g, V(w - 0.04, 0.03, dp - 0.04), cf * CF(0, -0.085, 0), fr, MAT.Metal)
  if bh > 0 then
    local rec = rad(opt.recline or 12)
    local bc = cf * CF(0, 0, dp / 2) * ANG(rec, 0, 0)
    self:box(g, V(w, bh, 0.07), bc * CF(0, bh / 2 + 0.02, 0.035), col, MAT.Fabric)
    self:box(g, V(w - 0.06, bh - 0.06, 0.02), bc * CF(0, bh / 2 + 0.02, 0.08), fr, MAT.Metal)
    if opt.head then self:box(g, V(w * 0.6, 0.16, 0.07), bc * CF(0, bh + 0.12, 0.035), col, MAT.Fabric) end
  end
  if opt.post then   -- 立柱（炮塔里的座椅多是一根立柱挂在炮塔篮上）
    local top = cf * CF(0, -0.1, 0)
    self:cylY(g, opt.post, 0.05, top * CF(0, -opt.post / 2, 0), fr, MAT.Metal)
    self:box(g, V(0.16, 0.012, 0.16), top * CF(0, -opt.post, 0), fr, MAT.Metal)
  end
  self:box(g, V(0.012, 0.012, 0.09), cf * CF(w / 2 + 0.006, -0.06, -dp / 2 + 0.06), K.C.black)   -- 调节手柄
end
-- 扶手 / 抓手（U 形钢管）
function B:grab(g, a, b, off, dia, col)
  dia = dia or 0.022
  col = col or K.C.lgray
  self:tube(g, a, a + off, dia, col, MAT.Metal)
  self:tube(g, a + off, b + off, dia, col, MAT.Metal)
  self:tube(g, b + off, b, dia, col, MAT.Metal)
end
-- 灭火瓶（红瓶 + 阀头 + 卡箍）
function B:extinguisher(g, cf, len, dia)
  len, dia = len or 0.42, dia or 0.13
  -- 真模型：二氧化碳手提灭火瓶（Sir Erdees，CC-BY），原点在瓶底，高 0.6 米；按这里要的瓶身长度缩放
  if self:prop(g, "ip_ext", cf * CF(0, -len / 2, 0), (len + dia * 0.6) / 0.6) then return end
  self:cylY(g, len, dia, cf, K.C.red, MAT.SmoothPlastic)
  self:ball(g, dia, cf * CF(0, len / 2, 0), K.C.red, MAT.SmoothPlastic)
  self:cylY(g, 0.06, 0.03, cf * CF(0, len / 2 + dia * 0.45, 0), K.C.steel, MAT.Metal)
  self:box(g, V(0.09, 0.012, 0.02), cf * CF(0.03, len / 2 + dia * 0.5, 0), K.C.black)
  for _, y in ipairs({ -len * 0.25, len * 0.25 }) do self:cylY(g, 0.02, dia + 0.01, cf * CF(0, y, 0), K.C.dark, MAT.Metal) end
end
-- 电台 / 电子盒（一个机箱 + 前面板上的旋钮、接头、指示灯、提手）
function B:radio(g, w, h, d, cf, col, prop)
  col = col or RGB(70, 76, 58)
  -- 真模型：面板朝 +Z，转半圈朝着看的人（cf 的 −Z）；按宽度缩放（ip_radio 宽 0.42 米、ip_radio2 宽 0.27 米），底面贴在 cf 下沿
  if prop then
    local W0 = (prop == "ip_radio") and 0.42 or 0.27
    local k = w / W0
    if self:prop(g, prop, cf * CF(0, -h / 2, d / 2) * ANG(0, PI, 0), k) then return end
  end
  self:box(g, V(w, h, d), cf * CF(0, 0, d / 2), col, MAT.SmoothPlastic)
  for i = 1, 3 do self:knob(g, cf * CF(-w / 2 + w * (i / 4), h * 0.18, 0), math.min(w, h) * 0.18, K.C.black) end
  for i = 1, 4 do self:cylZ(g, 0.02, 0.026, cf * CF(-w / 2 + w * (i / 5), -h * 0.25, -0.01), K.C.dark, MAT.Metal) end
  self:led(g, cf * CF(w * 0.4, h * 0.35, -0.004), K.C.green, 0.008, "radio")
  self:grab(g, (cf * CF(-w / 2 + 0.02, h / 2 - 0.02, 0)).Position, (cf * CF(-w / 2 + 0.02, -h / 2 + 0.02, 0)).Position, (cf.LookVector * 0.035), 0.012, K.C.black)
end

---------------------------------------------------------------- 乘员小人（R15 关节 + 反向运动学）

local JN = { "Root", "Waist", "Neck", "LeftShoulder", "LeftElbow", "LeftWrist", "RightShoulder", "RightElbow", "RightWrist",
  "LeftHip", "LeftKnee", "LeftAnkle", "RightHip", "RightKnee", "RightAnkle" }
local UPV = V(0, 1, 0)
local function clamp(x, a, b) return x < a and a or (x > b and b or x) end
K.clamp = clamp

local function quiet(p, anchored)
  p.Anchored = anchored == true
  p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
  p.Massless = true
end
local function mkPart(parent, size, color, mat, shape)
  local p = Instance.new("Part")
  if shape then p.Shape = shape end
  p.Size, p.Color = size, color
  p.Material = mat or MAT.SmoothPlastic
  p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
  quiet(p, false)
  p.Parent = parent
  return p
end
local function weld(p0, p1, c0)
  local w = Instance.new("Weld")
  w.Part0, w.Part1, w.C0 = p0, p1, c0
  w.Parent = p1
  return w
end
local function motor(name, p0, p1, c0, c1)
  local m = Instance.new("Motor6D")
  m.Name, m.Part0, m.Part1, m.C0, m.C1 = name, p0, p1, c0, c1 or CF()
  m.Parent = p1
  return m
end

-- 乘员的穿戴：tank_us 美军坦克兵（狼棕连体服、DH-132 车组头盔带耳罩和送话器）、tank_cn 解放军坦克兵（深绿连体服、黑色软坦克帽）、
--   pilot_us / pilot_cn 飞行员（飞行服、头盔护目镜、氧气面罩）、crew 普通车组（作训服、头盔）
local DRESS = {
  tank_us = { top = RGB(150, 132, 100), low = RGB(138, 120, 90), glove = RGB(96, 84, 64), boot = RGB(120, 96, 66), helm = RGB(158, 140, 104), kind = "cvc" },
  tank_cn = { top = RGB(58, 74, 52), low = RGB(50, 64, 46), glove = RGB(30, 30, 28), boot = RGB(26, 24, 22), helm = RGB(26, 26, 26), kind = "soft" },
  pilot_us = { top = RGB(112, 116, 90), low = RGB(106, 110, 86), glove = RGB(44, 40, 34), boot = RGB(30, 28, 26), helm = RGB(110, 112, 110), kind = "jet" },
  pilot_cn = { top = RGB(70, 82, 70), low = RGB(64, 76, 64), glove = RGB(30, 30, 28), boot = RGB(26, 24, 22), helm = RGB(232, 232, 228), kind = "jet" },
  heli_us = { top = RGB(112, 116, 90), low = RGB(106, 110, 86), glove = RGB(44, 40, 34), boot = RGB(30, 28, 26), helm = RGB(80, 84, 78), kind = "heli" },
  heli_cn = { top = RGB(70, 82, 70), low = RGB(64, 76, 64), glove = RGB(30, 30, 28), boot = RGB(26, 24, 22), helm = RGB(60, 70, 62), kind = "heli" },
  crew_us = { top = RGB(150, 132, 100), low = RGB(138, 120, 90), glove = RGB(40, 38, 34), boot = RGB(120, 96, 66), helm = RGB(146, 128, 96), kind = "ach" },
  crew_cn = { top = RGB(70, 86, 58), low = RGB(62, 76, 52), glove = RGB(30, 30, 28), boot = RGB(26, 24, 22), helm = RGB(80, 92, 64), kind = "ach" },
}
K.DRESS = DRESS
local SKIN = RGB(226, 186, 146)

-- 头上戴的（按 R15 头 1.2 格高算，k 缩放）
local function headgear(m, head, dress, k)
  local col = dress.helm
  local function P(size, cf, color, mat, shape, mesh)
    local p = mkPart(m, size * k, color or col, mat or MAT.SmoothPlastic, shape)
    if mesh then
      local sm = Instance.new("SpecialMesh")
      sm.MeshType = Enum.MeshType.Sphere
      sm.Parent = p
    end
    weld(head, p, CF(cf.Position * k) * cf.Rotation)
    p.Name = "Gear"
    return p
  end
  -- 真模型头盔（K.props 拿得到就用）：原点在头盔中心，真实尺寸；头 1.2 格高按 k 缩放，比例照真人的头
  local hp = (dress.kind == "cvc") and "ip_cvc" or ((dress.kind == "soft") and "ip_tsh" or nil)
  local list = hp and K.props and K.props(hp)
  if hp and not list then K.headMiss = true end
  if list then
    local hk = head.Size.Y / (0.23 * S)   -- 真人头高约 0.23 米：小人的头是真人比例时头盔不缩放（头盔模型本来就是真实尺寸）
    local base = CF(0, head.Size.Y * 0.18, head.Size.Z * 0.04) * ((hp == "ip_tsh") and ANG(0, PI, 0) or CF())
    for _, it in ipairs(list) do
      local p = it.part
      p.Size = p.Size * hk
      p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = false, false, false, false, false
      p.Massless = true
      p.Name = "Gear"
      p.CFrame = head.CFrame * base * CF(it.cf.Position * hk) * it.cf.Rotation
      weld(head, p, base * CF(it.cf.Position * hk) * it.cf.Rotation)
      p.Parent = m
    end
    return
  end
  if dress.kind == "cvc" then   -- 美军 DH-132：圆头壳、两侧大耳罩、左边伸出来的送话器
    P(V(1.46, 0.95, 1.52), CF(0, 0.38, 0.06), col, MAT.SmoothPlastic, nil, true)
    for _, s in ipairs({ -1, 1 }) do P(V(0.24, 0.62, 0.62), CF(s * 0.7, -0.02, 0.06) * ANG(0, 0, PI / 2), col:Lerp(RGB(0, 0, 0), 0.15), MAT.SmoothPlastic, CYL) end
    P(V(0.06, 0.06, 0.5), CF(-0.62, -0.32, -0.28) * ANG(0, rad(28), 0), RGB(28, 28, 28), MAT.SmoothPlastic)
    P(V(0.13, 0.13, 0.13), CF(-0.42, -0.36, -0.55), RGB(28, 28, 28), MAT.SmoothPlastic, BALL)
    P(V(1.12, 0.16, 0.1), CF(0, 0.5, -0.66), RGB(40, 40, 38), MAT.SmoothPlastic)   -- 护目镜（推在头盔上）
  elseif dress.kind == "soft" then   -- 解放军坦克帽：黑色软帽、三道加厚棱、耳罩、喉部送话器的带子
    P(V(1.36, 0.9, 1.44), CF(0, 0.34, 0.04), col, MAT.Fabric, nil, true)
    for i = -1, 1 do P(V(0.16, 0.85, 1.36), CF(i * 0.34, 0.36, 0.04), col:Lerp(RGB(255, 255, 255), 0.04), MAT.Fabric, nil, true) end
    for _, s in ipairs({ -1, 1 }) do P(V(0.18, 0.5, 0.5), CF(s * 0.66, -0.06, 0.06) * ANG(0, 0, PI / 2), col, MAT.Fabric, CYL) end
    P(V(1.1, 0.08, 0.08), CF(0, -0.62, 0.05), RGB(20, 20, 20), MAT.Fabric)
  elseif dress.kind == "jet" then   -- 飞行头盔 + 护目镜 + 氧气面罩和软管
    P(V(1.5, 1.15, 1.6), CF(0, 0.3, 0.05), col, MAT.SmoothPlastic, nil, true)
    P(V(1.3, 0.42, 0.2), CF(0, 0.05, -0.72) * ANG(rad(8), 0, 0), RGB(20, 22, 26), MAT.Glass).Transparency = 0.25
    P(V(0.46, 0.42, 0.34), CF(0, -0.38, -0.62), RGB(54, 58, 56), MAT.SmoothPlastic)
    P(V(0.12, 0.12, 0.7), CF(0.2, -0.62, -0.3) * ANG(rad(-40), rad(20), 0), RGB(40, 44, 42), MAT.SmoothPlastic, nil)
  elseif dress.kind == "heli" then   -- 直升机飞行员头盔（带单目头盔显示器 / 夜视仪支架）
    P(V(1.5, 1.1, 1.58), CF(0, 0.3, 0.05), col, MAT.SmoothPlastic, nil, true)
    P(V(0.26, 0.2, 0.36), CF(0.36, 0.22, -0.74), RGB(30, 30, 32), MAT.Metal)
    P(V(0.14, 0.14, 0.14), CF(0.38, 0.04, -0.88), RGB(60, 180, 90), MAT.Neon, BALL)
  else   -- 普通头盔
    P(V(1.42, 0.86, 1.5), CF(0, 0.42, 0.04), col, MAT.Fabric, nil, true)
    P(V(1.46, 0.14, 1.54), CF(0, 0.08, 0.04), col:Lerp(RGB(0, 0, 0), 0.25), MAT.Fabric)
  end
end

-- 零件拼的小人（没有 R15 模板时）：关节名字、层级照 R15
local function partRig(dress)
  local m = Instance.new("Model")
  m.Name = "Crew"
  local function P(name, size, color)
    local p = mkPart(m, size, color)
    p.Name = name
    return p
  end
  local hrp = P("HumanoidRootPart", V(2, 2, 1), dress.top)
  hrp.Transparency, hrp.Anchored = 1, true
  local lt = P("LowerTorso", V(1.9, 0.45, 0.95), dress.low)
  local ut = P("UpperTorso", V(2, 1.6, 1), dress.top)
  local head = P("Head", V(1.2, 1.2, 1.2), SKIN)
  local hm = Instance.new("SpecialMesh")
  hm.MeshType = Enum.MeshType.Head
  hm.Scale = V(1, 1, 1)
  hm.Parent = head
  motor("Root", hrp, lt, CF(0, -0.8, 0), CF())
  motor("Waist", lt, ut, CF(0, 0.2, 0), CF(0, -0.8, 0))
  motor("Neck", ut, head, CF(0, 0.8, 0), CF(0, -0.55, 0))
  for _, s in ipairs({ -1, 1 }) do
    local side = (s < 0) and "Left" or "Right"
    local ua = P(side .. "UpperArm", V(0.95, 1.2, 0.95), dress.top)
    local la = P(side .. "LowerArm", V(0.9, 1.1, 0.9), dress.top)
    local hd = P(side .. "Hand", V(0.85, 0.32, 0.85), dress.glove)
    motor(side .. "Shoulder", ut, ua, CF(s * 1.5, 0.6, 0), CF(0, 0.4, 0))
    motor(side .. "Elbow", ua, la, CF(0, -0.55, 0), CF(0, 0.5, 0))
    motor(side .. "Wrist", la, hd, CF(0, -0.45, 0), CF(0, 0.1, 0))
    local ul = P(side .. "UpperLeg", V(0.95, 1.2, 0.95), dress.low)
    local ll = P(side .. "LowerLeg", V(0.9, 1.1, 0.9), dress.low)
    local ft = P(side .. "Foot", V(0.9, 0.3, 1.2), dress.boot)
    motor(side .. "Hip", lt, ul, CF(s * 0.5, -0.2, 0), CF(0, 0.5, 0))
    motor(side .. "Knee", ul, ll, CF(0, -0.45, 0), CF(0, 0.45, 0))
    motor(side .. "Ankle", ll, ft, CF(0, -0.4, 0), CF(0, 0.05, 0.15))
  end
  return m, hrp, head
end
-- 真人比例的小人（车里、座舱里都用它）：R15 的方块小人四肢有 0.34 米粗、胳膊腿太短，坐进座舱够不着杆和脚蹬、低头满眼是方块；
--   这个按 1.78 米的成年男子量的（肩宽 0.40、上臂 0.29、前臂 0.26、大腿 0.43、小腿 0.42 米），四肢、躯干是椭球（像人体模型），关节名字和层级照 R15
local function slimRig(dress)
  local m = Instance.new("Model")
  m.Name = "Crew"
  local function P(name, size, color, round)
    local p = mkPart(m, size * S, color)
    p.Name = name
    if round then
      local sm = Instance.new("SpecialMesh")
      sm.MeshType = Enum.MeshType.Sphere
      sm.Parent = p
    end
    return p
  end
  local function M(name, p0, p1, c0, c1) return motor(name, p0, p1, CF(c0 * S), CF((c1 or V()) * S)) end
  local hrp = P("HumanoidRootPart", V(0.5, 0.5, 0.3), dress.top)
  hrp.Transparency, hrp.Anchored = 1, true
  local lt = P("LowerTorso", V(0.34, 0.18, 0.22), dress.low, true)
  local ut = P("UpperTorso", V(0.40, 0.52, 0.25), dress.top, true)
  local head = P("Head", V(0.19, 0.23, 0.21), SKIN)
  local hm = Instance.new("SpecialMesh")
  hm.MeshType = Enum.MeshType.Head
  hm.Parent = head
  P("Neck", V(0.11, 0.10, 0.11), SKIN, true).Name = "NeckSkin"
  M("Root", hrp, lt, V(0, -0.05, 0))
  M("Waist", lt, ut, V(0, 0.07, 0), V(0, -0.24, 0))
  M("Neck", ut, head, V(0, 0.27, 0), V(0, -0.115, 0))
  local nk = m:FindFirstChild("NeckSkin")
  weld(ut, nk, CF(0, 0.25 * S, 0))
  for _, sd in ipairs({ -1, 1 }) do
    local side = (sd < 0) and "Left" or "Right"
    local ua = P(side .. "UpperArm", V(0.105, 0.32, 0.105), dress.top, true)
    local la = P(side .. "LowerArm", V(0.09, 0.28, 0.09), dress.top, true)
    local hd = P(side .. "Hand", V(0.085, 0.11, 0.045), dress.glove)
    M(side .. "Shoulder", ut, ua, V(sd * 0.19, 0.19, 0), V(0, 0.14, 0))
    M(side .. "Elbow", ua, la, V(0, -0.15, 0), V(0, 0.125, 0))
    M(side .. "Wrist", la, hd, V(0, -0.13, 0), V(0, 0.05, 0))
    local ul = P(side .. "UpperLeg", V(0.15, 0.47, 0.15), dress.low, true)
    local ll = P(side .. "LowerLeg", V(0.11, 0.45, 0.11), dress.low, true)
    local ft = P(side .. "Foot", V(0.10, 0.09, 0.27), dress.boot)
    M(side .. "Hip", lt, ul, V(sd * 0.095, -0.05, 0), V(0, 0.215, 0))
    M(side .. "Knee", ul, ll, V(0, -0.215, 0), V(0, 0.205, 0))
    M(side .. "Ankle", ll, ft, V(0, -0.21, 0), V(0, 0.035, 0.08))
  end
  return m, hrp, head
end
-- R15 模板克隆
local function rigFromTemplate(dress)
  local tpl = RS:FindFirstChild("BotRig")
  if not tpl then return nil end
  local m = tpl:Clone()
  m.Name = "Crew"
  local hrp = m:FindFirstChild("HumanoidRootPart")
  local head = m:FindFirstChild("Head")
  local hum = m:FindFirstChildOfClass("Humanoid")
  if not hrp or not head or not hum then m:Destroy() return nil end
  for _, p in ipairs(m:GetDescendants()) do
    if p:IsA("BasePart") then
      quiet(p, p == hrp)
      local n = p.Name
      if n == "Head" then p.Color = SKIN
      elseif string.find(n, "Hand") then p.Color = dress.glove
      elseif string.find(n, "Foot") then p.Color = dress.boot
      elseif string.find(n, "Leg") or n == "LowerTorso" then p.Color = dress.low
      elseif string.find(n, "Arm") or n == "UpperTorso" then p.Color = dress.top end
      p.CastShadow = true
    elseif p:IsA("BodyColors") or p:IsA("Accessory") or p:IsA("Shirt") or p:IsA("Pants") then
      p:Destroy()
    end
  end
  hrp.Transparency = 1
  hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
  hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
  pcall(function() hum.EvaluateStateMachine = false end)
  local an = hum:FindFirstChildOfClass("Animator")
  if an then an:Destroy() end
  return m, hrp, head
end

-- 两节肢体的反向运动学（同 Soldier.lua）：P0 是父零件（躯干）的世界姿态，末端关节放到 W，肘 / 膝往 pole 那边弯
local function ik(Lb, P0, W, pole, leg, endRot)
  local A, Bj, C = Lb.a, Lb.b, Lb.c
  local la, lb = Lb.la, Lb.lb
  local Sp = P0 * A.c0.Position
  local d = W - Sp
  local L = d.Magnitude
  local du = (L > 1e-4) and d / L or V(0, -1, 0)
  L = clamp(L, math.abs(la - lb) + 0.02, (la + lb) * 0.999)
  local ca = clamp((la * la + L * L - lb * lb) / (2 * la * L), -1, 1)
  local sa = math.sqrt(math.max(0, 1 - ca * ca))
  local pp = pole - du * pole:Dot(du)
  if pp.Magnitude < 1e-4 then pp = (math.abs(du.Y) < 0.9) and UPV:Cross(du) or V(1, 0, 0) end
  pp = pp.Unit
  local E = Sp + du * (la * ca) + pp * (la * sa)
  local Wc = Sp + du * L
  local hx = leg and du:Cross(pp) or pp:Cross(du)
  local y1 = (Sp - E).Unit
  local x1 = hx - y1 * hx:Dot(y1)
  x1 = (x1.Magnitude > 1e-4) and x1.Unit or V(1, 0, 0)
  local r1 = CFrame.fromMatrix(Vector3.zero, x1, y1, x1:Cross(y1))
  local y2 = (E - Wc).Unit
  local x2 = x1 - y2 * x1:Dot(y2)
  x2 = (x2.Magnitude > 1e-4) and x2.Unit or x1
  local r2 = CFrame.fromMatrix(Vector3.zero, x2, y2, x2:Cross(y2))
  local r3 = endRot or r2
  return CF(Sp - r1:VectorToWorldSpace(A.c1.Position)) * r1, CF(E - r2:VectorToWorldSpace(Bj.c1.Position)) * r2,
    CF(Wc - r3:VectorToWorldSpace(C.c1.Position)) * r3
end
local function setJ(Jx, P0, P1) Jx.m.C0 = P0:Inverse() * P1 * Jx.c1 end

-- 做一个乘员：返回 { model, hrp, J, set(pose) }；dress 见上面的 DRESS
function K.crew(dressKey)
  local dress = DRESS[dressKey] or DRESS.crew_us
  -- 用户 11-24：「坦克要有精细的 roblox 人物」——有 R15 模板（ReplicatedStorage.BotRig：Bots.lua 开服时做的，士兵机器人也是它）就用 Roblox 小人，
  --   按乘员服上色、戴原模型的坦克帽；没有模板（Studio 连不上资源、模拟测试）照旧真人比例的人体模型（slimRig）
  local m, hrp, head = rigFromTemplate(dress)
  if not m then m, hrp, head = slimRig(dress) end
  local J = {}
  for _, d in ipairs(m:GetDescendants()) do
    if d:IsA("Motor6D") then J[d.Name] = { m = d, c0 = d.C0, c1 = d.C1, c1i = d.C1:Inverse() } end
  end
  for _, n in ipairs(JN) do
    if not J[n] then m:Destroy() return nil end
  end
  local k = head.Size.Y / 1.2
  headgear(m, head, dress, k)
  local function limb(a, b, c)
    local A, Bj, C = J[a], J[b], J[c]
    return { a = A, b = Bj, c = C, la = (Bj.c0.Position - A.c1.Position).Magnitude, lb = (C.c0.Position - Bj.c1.Position).Magnitude }
  end
  local f = { model = m, hrp = hrp, head = head, J = J, dress = dress,
    LA = limb("LeftShoulder", "LeftElbow", "LeftWrist"), RA = limb("RightShoulder", "RightElbow", "RightWrist"),
    LL = limb("LeftHip", "LeftKnee", "LeftAnkle"), RL = limb("RightHip", "RightKnee", "RightAnkle") }
  -- 头和头上戴的（第一人称时藏起来，自己看得见自己的手和腿）
  f.headParts = { head }
  for _, p in ipairs(m:GetDescendants()) do
    if p:IsA("BasePart") and (p.Name == "Gear" or p.Name == "Head" or p.Name == "NeckSkin" or p:IsDescendantOf(head)) then table.insert(f.headParts, p) end
    if p:IsA("Decal") and p.Parent == head then table.insert(f.headParts, p) end
  end
  -- 摆姿势（世界坐标，格）：pelvis 骨盆（下躯干）的姿态；chest 上身相对骨盆的转角（CFrame）；look 头朝哪看（世界方向）；
  --   lh / rh 左右手掌心的位置，lf / rf 脚踝的位置；elbow / knee 往哪边弯（世界方向）
  function f.set(P)
    local hcf = P.pelvis * J.Root.c1 * J.Root.c0:Inverse()   -- 根零件放在骨盆对应的位置（关节 C0 保持原样）
    hrp.CFrame = hcf
    J.Root.m.C0 = J.Root.c0
    local lt = P.pelvis
    local ut = lt * J.Waist.c0 * (P.chest or CF()) * J.Waist.c1i
    setJ(J.Waist, lt, ut)
    if P.look and P.look.Magnitude > 1e-4 then
      -- 头：脖子关节点不动，脸朝 look（离上身正前方超过 75° 的拉回来，脖子不拧断）
      local jp = (ut * J.Neck.c0).Position
      local fwd = P.look.Unit
      local tf = ut.LookVector
      local a = math.acos(clamp(fwd:Dot(tf), -1, 1))
      if a > rad(75) then fwd = tf:Lerp(fwd, rad(75) / a).Unit end
      local R = CFrame.lookAt(Vector3.zero, fwd, ut.UpVector)
      local Hw = CF(jp - R:VectorToWorldSpace(J.Neck.c1.Position)) * R
      setJ(J.Neck, ut, Hw)
    else
      J.Neck.m.C0 = J.Neck.c0
    end
    local up = ut.UpVector
    local rt = ut.RightVector
    local function arm(Lb, W, side, pole)
      if not W then
        -- 没给手的位置：手臂自然垂下、略往前
        W = (ut * CF(side * 1.1 * k, -1.5 * k, -0.45 * k)).Position
      end
      local e = pole or (rt * side * 0.8 - up * 0.6 + ut.LookVector * 0.1)
      local a, b, c = ik(Lb, ut, W, e, false, nil)
      setJ(Lb.a, ut, a)
      setJ(Lb.b, a, b)
      setJ(Lb.c, b, c)
    end
    arm(f.LA, P.lh, -1, P.lelbow)
    arm(f.RA, P.rh, 1, P.relbow)
    local function leg(Lb, W, side, pole)
      if not W then W = (lt * CF(side * 0.5 * k, -2.2 * k, -1.2 * k)).Position end
      local e = pole or (lt.LookVector * 1 + rt * side * 0.15)
      local a, b, c = ik(Lb, lt, W, e, true, P.footRot)
      setJ(Lb.a, lt, a)
      setJ(Lb.b, a, b)
      setJ(Lb.c, b, c)
    end
    leg(f.LL, P.lf, -1, P.lknee)
    leg(f.RL, P.rf, 1, P.rknee)
  end
  f.torsoParts = {}
  for _, n in ipairs({ "UpperTorso", "LowerTorso" }) do
    local p = m:FindFirstChild(n)
    if p then table.insert(f.torsoParts, p) end
  end
  function f.torsoVisible(on)
    for _, p in ipairs(f.torsoParts) do p.LocalTransparencyModifier = on and 0 or 1 end
  end
  function f.headVisible(on)
    for _, p in ipairs(f.headParts) do
      if p:IsA("BasePart") then p.LocalTransparencyModifier = on and 0 or 1
      elseif p:IsA("Decal") then p.Transparency = on and 0 or 1 end
    end
  end
  -- 整个人（第一人称的自己：用户 11-21「第一人称不要显示我的腿和胳膊」）
  function f.bodyVisible(on)
    for _, p in ipairs(m:GetDescendants()) do
      if p:IsA("BasePart") then p.LocalTransparencyModifier = on and 0 or 1
      elseif p:IsA("Decal") then p.Transparency = on and 0 or 1 end
    end
  end
  return f
end

K.rigFromTemplate, K.partRig = rigFromTemplate, partRig   -- 调试用（R15 模板、方块小人）
return K
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="234">
          <Properties>
            <string name="Name">InteriorScreens</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——内饰里各块屏幕的页面（SurfaceGui），由 Interior.lua 按实时数据刷新
--   热像（CITV、驾驶员视觉增强器、炮长面板的小窗）：没有第二台摄像机，按地形高度图一列列算山脊线（软件渲染），
--     车、人按真实位置投到画面上（白热 / 黑热）；遮挡也按地形算——看得见什么就是什么
--   指挥地图（JBC-P）：附近 ±1.6 公里的陆地按高度分层（一行行合并的色块）、据点、友军、看得见的敌人、自己的车和炮的指向
--   驾驶员仪表（DID）：车速、转速、油量、挡位、炮塔相对车体的方位、告警；炮长面板（GCDP）：弹种、待发、测距、倍率、极性
--   页面用 build(s, env) 搭界面，返回 update(d)（d 是 Interior 每次给的数据，见 Interior.lua 的 gather）
local Screens = {}
local RGB = Color3.fromRGB
local UD2 = UDim2.new
local V3 = Vector3.new
local PI = math.pi
local FONT = Enum.Font.RobotoMono
local FONTB = Enum.Font.BuilderSansMedium
local function clamp(x, a, b) return x < a and a or (x > b and b or x) end

---------------------------------------------------------------- 画图的小工具（像素坐标）

local function F(parent, x, y, w, h, col, tr, z)
  local f = Instance.new("Frame")
  f.Position = UD2(0, x, 0, y)
  f.Size = UD2(0, w, 0, h)
  f.BackgroundColor3 = col or RGB(0, 0, 0)
  f.BackgroundTransparency = tr or 0
  f.BorderSizePixel = 0
  f.ZIndex = z or 1
  f.Parent = parent
  return f
end
Screens.F = F
local function Tx(parent, s, x, y, w, h, size, col, align, font, z)
  local l = Instance.new("TextLabel")
  l.Position = UD2(0, x, 0, y)
  l.Size = UD2(0, w, 0, h)
  l.BackgroundTransparency = 1
  l.Text = s
  l.TextSize = size
  l.TextColor3 = col or RGB(255, 255, 255)
  l.Font = font or FONT
  l.TextXAlignment = align or Enum.TextXAlignment.Left
  l.TextYAlignment = Enum.TextYAlignment.Center
  l.ZIndex = z or 3
  l.Parent = parent
  return l
end
Screens.Tx = Tx
-- 一条线（转过角度的细框）
local function Ln(parent, x0, y0, x1, y1, t, col, z)
  local f = Instance.new("Frame")
  f.AnchorPoint = Vector2.new(0.5, 0.5)
  f.BorderSizePixel = 0
  f.BackgroundColor3 = col or RGB(255, 255, 255)
  f.ZIndex = z or 2
  f.Parent = parent
  local function set(a0, b0, a1, b1)
    local dx, dy = a1 - a0, b1 - b0
    f.Position = UD2(0, (a0 + a1) / 2, 0, (b0 + b1) / 2)
    f.Size = UD2(0, math.sqrt(dx * dx + dy * dy), 0, t or 1)
    f.Rotation = math.deg(math.atan2(dy, dx))
  end
  set(x0, y0, x1, y1)
  return f, set
end
Screens.Ln = Ln
-- 圆圈（描边）
local function Ring(parent, cx, cy, r, t, col, z, fill)
  local f = Instance.new("Frame")
  f.AnchorPoint = Vector2.new(0.5, 0.5)
  f.Position = UD2(0, cx, 0, cy)
  f.Size = UD2(0, r * 2, 0, r * 2)
  f.BackgroundColor3 = fill or RGB(0, 0, 0)
  f.BackgroundTransparency = fill and 0 or 1
  f.ZIndex = z or 2
  f.Parent = parent
  local c = Instance.new("UICorner")
  c.CornerRadius = UDim.new(0.5, 0)
  c.Parent = f
  if t and t > 0 then
    local s = Instance.new("UIStroke")
    s.Thickness = t
    s.Color = col or RGB(255, 255, 255)
    s.Parent = f
  end
  return f
end
Screens.Ring = Ring
local function grad(f, c0, c1, rot)
  local g = Instance.new("UIGradient")
  g.Color = ColorSequence.new(c0, c1)
  g.Rotation = rot or 90
  g.Parent = f
  return g
end
-- 方框（只描边）
-- 军标（用户 11-22：「电子屏地图要能显示敌单位，坦克、车之类的要有不同符号」）：照北约 APP-6 的样子简化——
--   友军蓝色长方框、敌军红色菱形框；框里的图形分兵种：坦克（装甲）一个椭圆（履带）、装甲车 / 步战车一个叉加椭圆（机械化步兵）、步兵一个叉、
--   自行火炮 / 岸炮一个实心圆点（炮兵）、防空车 / 高炮一道拱（防空）、直升机一个蝴蝶结（旋翼）、飞机一个尖头（固定翼）、军舰一条船身、工事一排垛口。
--   sym(parent, z) 返回一个能反复用的军标：set(x, y, typ, hostile, size)
local SYM_TYPES = { tank = true, apc = true, inf = true, arty = true, aa = true, heli = true, jet = true, ship = true, fort = true }
local function Sym(parent, z)
  local o = { typ = nil, hostile = nil }
  o.f = F(parent, 0, 0, 20, 20, RGB(0, 0, 0), 1, z)
  o.rect = F(o.f, 2, 4.5, 16, 11, RGB(70, 140, 255), 0.45, z + 1)
  o.rectS = Instance.new("UIStroke")
  o.rectS.Thickness, o.rectS.Color = 1.4, RGB(150, 200, 255)
  o.rectS.Parent = o.rect
  o.dia = F(o.f, 4, 4, 12, 12, RGB(230, 60, 50), 0.4, z + 1)
  o.dia.Rotation = 45
  o.diaS = Instance.new("UIStroke")
  o.diaS.Thickness, o.diaS.Color = 1.4, RGB(255, 150, 140)
  o.diaS.Parent = o.dia
  o.icon = F(o.f, 0, 0, 20, 20, RGB(0, 0, 0), 1, z + 2)
  local INK = RGB(250, 250, 250)
  local function line(x0, y0, x1, y1, t) return (Ln(o.icon, x0, y0, x1, y1, t or 1.3, INK, z + 3)) end
  local function ellipse(w, h)
    local e = F(o.icon, 10 - w / 2, 10 - h / 2, w, h, INK, 1, z + 3)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0.5, 0)
    c.Parent = e
    local st = Instance.new("UIStroke")
    st.Thickness, st.Color = 1.2, INK
    st.Parent = e
    return e
  end
  local function build(typ, hostile)
    for _, ch in ipairs(o.icon:GetChildren()) do ch:Destroy() end
    local k = hostile and 0.72 or 1   -- 菱形框里能画的地方小一点
    local a, b = 10 - 6 * k, 10 + 6 * k   -- 叉、线的左右端
    local u, v = 10 - 4 * k, 10 + 4 * k   -- 上下
    if typ == "tank" then ellipse(10 * k, 5 * k)
    elseif typ == "apc" then line(a, u, b, v) line(a, v, b, u) ellipse(8 * k, 4 * k)
    elseif typ == "inf" then line(a, u, b, v) line(a, v, b, u)
    elseif typ == "arty" then
      local d = F(o.icon, 10 - 2.2, 10 - 2.2, 4.4, 4.4, INK, 0, z + 3)
      local c = Instance.new("UICorner")
      c.CornerRadius = UDim.new(0.5, 0)
      c.Parent = d
    elseif typ == "aa" then   -- 一道拱：一个圆只露上半截
      local clip = F(o.icon, 10 - 5 * k, 10 - 3 * k, 10 * k, 5 * k, INK, 1, z + 3)
      clip.ClipsDescendants = true
      local r = F(clip, 0, 0, 10 * k, 10 * k, INK, 1, z + 3)
      local c = Instance.new("UICorner")
      c.CornerRadius = UDim.new(0.5, 0)
      c.Parent = r
      local st = Instance.new("UIStroke")
      st.Thickness, st.Color = 1.2, INK
      st.Parent = r
      line(10 - 5 * k, 10 + 2 * k, 10 + 5 * k, 10 + 2 * k, 1)
    elseif typ == "heli" then line(a, u, b, v) line(a, v, b, u) line(a, u, a, v) line(b, u, b, v)
    elseif typ == "jet" then line(a, v, 10, u) line(10, u, b, v) line(10, u, 10, v + 1)
    elseif typ == "ship" then line(a, 10 + 1, b, 10 + 1) line(a + 1.5 * k, v, b - 1.5 * k, v) line(a, 10 + 1, a + 1.5 * k, v) line(b, 10 + 1, b - 1.5 * k, v) line(10, u, 10, 10 + 1)
    else   -- 工事：一排垛口
      line(a, v, b, v)
      for i = 0, 2 do F(o.icon, a + (i * 2 + 0.5) * (b - a) / 6 - 1, 10 - 1 * k, (b - a) / 6, 3 * k + 1, INK, 0, z + 3) end
    end
  end
  function o.set(x, y, typ, hostile, size)
    typ = SYM_TYPES[typ] and typ or "apc"
    if typ ~= o.typ or hostile ~= o.hostile then
      o.typ, o.hostile = typ, hostile
      o.rect.Visible, o.dia.Visible = not hostile, hostile
      build(typ, hostile)
    end
    local sc = (size or 20) / 20
    o.f.Size = UD2(0, 20, 0, 20)
    o.f.Position = UD2(0, x - 10, 0, y - 10)
    if not o.scale then
      o.scale = Instance.new("UIScale")
      o.scale.Parent = o.f
    end
    o.scale.Scale = sc
    o.f.Visible = true
  end
  return o
end
Screens.Sym = Sym

local function Box(parent, x, y, w, h, t, col, z)
  local f = F(parent, x, y, w, h, RGB(0, 0, 0), 1, z)
  local s = Instance.new("UIStroke")
  s.Thickness = t or 1
  s.Color = col or RGB(255, 255, 255)
  s.Parent = f
  return f, s
end
Screens.Box = Box

---------------------------------------------------------------- 热像（软件渲染）

-- 极性 / 模式的配色：天、远处地面、近处地面、热目标
local PAL = {
  WHT = { sky0 = RGB(10, 12, 12), sky1 = RGB(46, 48, 48), g0 = RGB(70, 72, 70), g1 = RGB(122, 124, 120), hot = RGB(245, 245, 238), warm = RGB(190, 190, 184), ridge = RGB(150, 152, 146) },
  BLK = { sky0 = RGB(236, 236, 230), sky1 = RGB(200, 200, 194), g0 = RGB(170, 170, 164), g1 = RGB(120, 120, 116), hot = RGB(12, 12, 12), warm = RGB(60, 60, 58), ridge = RGB(110, 110, 106) },
  DAY = { sky0 = RGB(18, 26, 38), sky1 = RGB(52, 64, 78), g0 = RGB(46, 54, 40), g1 = RGB(66, 72, 52), hot = RGB(30, 32, 30), warm = RGB(60, 62, 56), ridge = RGB(70, 80, 60) },
  GRN = { sky0 = RGB(4, 16, 6), sky1 = RGB(20, 60, 26), g0 = RGB(40, 110, 50), g1 = RGB(80, 170, 90), hot = RGB(210, 255, 210), warm = RGB(150, 230, 160), ridge = RGB(110, 200, 120) },
  GRNB = { sky0 = RGB(168, 236, 168), sky1 = RGB(128, 206, 132), g0 = RGB(92, 168, 98), g1 = RGB(58, 126, 64), hot = RGB(6, 26, 8), warm = RGB(26, 72, 30), ridge = RGB(70, 140, 76) },   -- 绿色黑热（M1A2 CITV）
}
Screens.PAL = PAL

-- 在 parent（W × H 像素）里画热像；返回 { render(view) }：view = { eye, f, r, u（世界坐标的基）, hfov 水平视角（度）, pal, ents, Map, range }
function Screens.thermal(parent, W, H, opt)
  opt = opt or {}
  -- 列数（山脊线一列一列算）：按画面宽度加密到每 5 个设计像素一列、最多 72 列（用户 11-23：显示屏清晰度太低——原来 22～36 列，山一格一格的）
  local N = math.max(opt.cols or 36, math.min(72, math.floor(W / 5)))
  local o = {}
  local sky = F(parent, 0, 0, W, H, RGB(255, 255, 255), 0, 1)
  local skyG = grad(sky, RGB(0, 0, 0), RGB(0, 0, 0), 90)
  local cw = W / N
  local cols = {}
  for i = 1, N do
    local c = F(parent, math.floor((i - 1) * cw), H, math.ceil(cw) + 1, 0, RGB(255, 255, 255), 0, 2)
    local g = grad(c, RGB(0, 0, 0), RGB(0, 0, 0), 90)
    local edge = F(c, 0, 0, math.ceil(cw) + 1, 2, RGB(255, 255, 255), 0, 3)
    cols[i] = { f = c, g = g, e = edge, top = H }
  end
  local blobs = {}
  local function blob(i)
    local b = blobs[i]
    if not b then
      local f = F(parent, 0, 0, 4, 4, RGB(255, 255, 255), 0, 4)
      local cr = Instance.new("UICorner")
      cr.CornerRadius = UDim.new(0.35, 0)
      cr.Parent = f
      local core = F(f, 0, 0, 2, 2, RGB(255, 255, 255), 0, 5)
      core.AnchorPoint = Vector2.new(0.5, 0.5)
      core.Position = UD2(0.5, 0, 0.55, 0)
      core.Size = UD2(0.55, 0, 0.45, 0)
      local cc = Instance.new("UICorner")
      cc.CornerRadius = UDim.new(0.5, 0)
      cc.Parent = core
      b = { f = f, core = core }
      blobs[i] = b
    end
    return b
  end
  -- 噪点（热像的颗粒感）：几条半透明的横纹，每次随机挪
  local grain = {}
  for i = 1, 6 do grain[i] = F(parent, 0, 0, W, 1, RGB(255, 255, 255), 0.93, 6) end
  local cache = { eye = nil, f = nil, fov = nil }
  local DIST = { 6, 10, 16, 24, 34, 46, 60, 78, 100, 130, 170, 220, 290, 380, 500, 650, 850, 1100, 1450, 1900, 2500, 3300 }

  function o.render(view)
    local pal = view.pal or PAL.WHT
    local eye, f, r, u = view.eye, view.f, view.r, view.u
    local tx = math.tan(math.rad(view.hfov or 30) / 2)
    local ty = tx * H / W
    skyG.Color = ColorSequence.new(pal.sky0, pal.sky1)
    -- 山脊线：视线没怎么变就不重算（省事；转炮塔、开车才重算）
    local moved = not cache.eye or (cache.eye - eye).Magnitude > 1.5 or cache.f:Dot(f) < 0.99996 or cache.fov ~= view.hfov
    local Map = view.Map
    if moved and Map then
      cache.eye, cache.f, cache.fov = eye, f, view.hfov
      local fh = V3(f.X, 0, f.Z)
      if fh.Magnitude < 1e-3 then fh = V3(0, 0, -1) end
      fh = fh.Unit
      local rh = V3(-fh.Z, 0, fh.X)
      for i = 1, N do
        local sx = ((i - 0.5) / N - 0.5) * 2 * tx
        local d = (fh + rh * sx).Unit
        local best = H
        local near = 0
        for _, dist in ipairs(DIST) do
          local px, pz = eye.X + d.X * dist, eye.Z + d.Z * dist
          local hy = math.max(Map.height(px, pz), -1)
          local q = V3(px, hy, pz) - eye
          local z = q:Dot(f)
          if z > 0.5 then
            local y = q:Dot(u) / z
            local s = H / 2 - y / ty * H / 2
            if s < best then best, near = s, dist end
          end
        end
        local c = cols[i]
        local top = math.clamp(math.floor(best), -2, H)
        c.top = top
        c.near = near
        c.f.Position = UD2(0, c.f.Position.X.Offset, 0, top)
        c.f.Size = UD2(0, math.ceil(cw) + 1, 0, H - top)
      end
    end
    for i = 1, N do
      local c = cols[i]
      local k = clamp((c.near or 0) / 2000, 0, 1)   -- 远的山更暗（大气、温差小）
      c.g.Color = ColorSequence.new(pal.g0:Lerp(pal.sky1, k * 0.5), pal.g1)
      c.e.BackgroundColor3 = pal.ridge:Lerp(pal.sky1, k * 0.6)
    end
    -- 目标：车（大、热）、人（小、温）
    local n = 0
    for _, e in ipairs(view.ents or {}) do
      local q = e.pos - eye
      local z = q:Dot(f)
      local dist = q.Magnitude
      if z > 2 and dist < (view.range or 4000) then
        local x, y = q:Dot(r) / z, q:Dot(u) / z
        if math.abs(x) < tx * 1.1 and math.abs(y) < ty * 1.1 then
          -- 被山挡住：沿视线抽几处地形高度
          local hidden = false
          if Map then
            for s = 1, 7 do
              local p = eye + q * (s / 8)
              if Map.height(p.X, p.Z) > p.Y + 0.5 then hidden = true break end
            end
          end
          if not hidden then
            n += 1
            local b = blob(n)
            local sx = W / 2 + x / tx * W / 2
            local sy = H / 2 - y / ty * H / 2
            local pw = math.max(2, (e.w or 8) / z / tx * W / 2)
            local ph = math.max(2, (e.h or 6) / z / ty * H / 2)
            b.f.Visible = true
            b.f.Position = UD2(0, sx - pw / 2, 0, sy - ph / 2)
            b.f.Size = UD2(0, pw, 0, ph)
            b.f.BackgroundColor3 = (e.kind == "veh") and pal.warm or pal.warm:Lerp(pal.g1, 0.3)
            b.core.BackgroundColor3 = pal.hot
            b.core.Visible = e.kind == "veh" or e.kind == "air"
          end
        end
      end
    end
    for i = n + 1, #blobs do blobs[i].f.Visible = false end
    for _, g in ipairs(grain) do
      g.Position = UD2(0, 0, 0, math.random(0, H))
      g.BackgroundTransparency = 0.9 + math.random() * 0.08
    end
  end
  return o
end

---------------------------------------------------------------- 分划、读数（几种瞄准镜画面共用）

local function reticleTank(parent, W, H, col)
  local cx, cy = W / 2, H / 2
  local g = math.max(3, W * 0.02)
  local L = W * 0.12
  Ln(parent, cx - L - g, cy, cx - g, cy, 2, col, 7)
  Ln(parent, cx + g, cy, cx + L + g, cy, 2, col, 7)
  Ln(parent, cx, cy + g, cx, cy + L * 0.8 + g, 2, col, 7)
  Ln(parent, cx, cy - g * 3, cx, cy - g, 1, col, 7)
  for i = 1, 4 do   -- 横线上的刻度（密位）
    Ln(parent, cx - g - i * L / 4, cy - 3, cx - g - i * L / 4, cy + 3, 1, col, 7)
    Ln(parent, cx + g + i * L / 4, cy - 3, cx + g + i * L / 4, cy + 3, 1, col, 7)
  end
end

---------------------------------------------------------------- 页面

local P = {}
Screens.pages = P

-- 驾驶员视觉增强器：车头方向的热像（黑热），几乎没有符号
P.dve = function(s, env)
  local W, H = s.px.X, s.px.Y
  local th = Screens.thermal(s.root, W, H, { cols = 28 })
  local t1 = Tx(s.root, "DVE  BH", 6, 4, 80, 14, 12, RGB(200, 200, 200), nil, FONT, 8)
  local bar = F(s.root, W - 10, H * 0.2, 4, H * 0.6, RGB(200, 200, 200), 0.6, 8)
  local _ = t1 and bar
  return function(d)
    if not d.hullEye then return end
    th.render({ eye = d.hullEye, f = d.hullF, r = d.hullR, u = d.hullU, hfov = 40, pal = PAL.BLK, ents = d.ents, Map = env.Map, range = 1800 })
  end
end

