---------------------------------------------------------------- 火炮

D.plz07 = tracked({ cat = "arty", L = 22, W = 9.6, H = 9.0, hullH = 4.4, clear = 1.3, speed = 46.7, accel = 4.2, rev = 11.7, turn = 34,
  rw = { n = 6, r = 1.0, x = 3.8, z0 = -7.4, z1 = 7.2 },
