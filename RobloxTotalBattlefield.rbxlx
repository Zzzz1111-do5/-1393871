    ["coach.card.heli.3"] = "Mantém a inércia: mire mais alto para levantar o nariz e frear. Botão esq. canhão, F foguetes / mísseis, Espaço para sair",
    ["coach.card.jet.1"] = "Shift mais potência (máxima = pós-combustão); A / D dirigir na pista; em marcha lenta segure Ctrl para dar ré",
    ["coach.card.jet.2"] = "A {1} km/h segure S para decolar: o trem recolhe sozinho. W nariz para baixo, S nariz para cima, A / D rolagem; incline e puxe S para curvar",
    ["coach.card.jet.3"] = "Botão esq. canhão (atira no marcador do nariz; gruda em veículos inimigos a menos de 6° e antecipa), F míssil (1–6 cargas, trave antes), X flares. Pousar: G trem, Ctrl menos potência, nariz para a pista, pare para rearmar e reparar",
    ["coach.card.lcac.1"] = "W / S acelerador, A / D direção: mais brusca em velocidade, a popa derrapa",
    ["coach.card.lcac.2"] = "Suba numa praia e o veículo é descarregado sozinho",
    ["coach.card.lcac.3"] = "Depois desça dirigindo pela proa; Espaço para sair",
    ["coach.card.ship.1"] = "W / S ajustam o telégrafo passo a passo; A / D leme: navios grandes viram devagar",
    ["coach.card.ship.2"] = "O mouse mira, botão esq. atira: 1 canhões, 2 mísseis antinavio (R para travar)",
    ["coach.card.ship.3"] = "Botão dir. / V binóculos, N visão noturna, Espaço para deixar o navio",
    ["coach.card.uav.1"] = "Você pilota o drone por um tablet enquanto fica parado onde está: fique protegido",
    ["coach.card.uav.2"] = "O mouse dirige, W / S velocidade, A / D rolagem",
    ["coach.card.uav.3"] = "Botão dir. / V câmera, Z zoom, F míssil, Espaço para guardar o tablet",
    ["coach.card.veh.1"] = "W / S para dirigir, A / D para virar (veículos de lagarta giram no lugar)",
    ["coach.card.veh.2"] = "O mouse mira a torre, botão esq. atira, os números escolhem a munição / arma (veja a barra de munição)",
    ["coach.card.veh.3"] = "Shift para a mira do atirador (V: noturna / térmica), M fumaça, Espaço para sair",
    ["coach.cardSub"] = "Três passos · Enter para fechar",
