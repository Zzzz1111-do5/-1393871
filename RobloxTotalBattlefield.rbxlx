  { name = "金滩—机场", w = 10, p = { 770,-868,770,-875,770,-890,769,-901,769,-911,769,-926,769,-940,775,-954,782,-968,789,-982,799,-996,809,-1009,819,-1023,829,-1037,841,-1050,853,-1063,865,-1077,877,-1090,889,-1104,902,-1117,916,-1130,929,-1144,942,-1157,956,-1170,969,-1183,981,-1195,993,-1207,1005,-1219,1018,-1231,1030,-1243,1043,-1257,1056,-1270,1070,-1283,1080,-1293,1090,-1303 } },
  { name = "营地—侧翼滩", w = 10, p = { 140,-2076,153,-2076,166,-2076,179,-2076,199,-2076,218,-2076,235,-2076,253,-2076,270,-2076,290,-2076,310,-2077,324,-2078,337,-2078,353,-2080,356,-2083,359,-2086,362,-2087,365,-2088,368,-2088,370,-2090,371,-2095,372,-2101,372,-2110,373,-2116,374,-2119,377,-2119,380,-2116,382,-2115,383,-2115,384,-2116,384,-2119,385,-2121,386,-2121,389,-2119,392,-2116,405,-2114,417,-2113,429,-2113,446,-2112,464,-2112,479,-2112,494,-2112,509,-2112,527,-2110,545,-2109,560,-2106,574,-2103,584,-2098,594,-2094,606,-2082,623,-2073,635,-2070,646,-2067,660,-2065,674,-2064,690,-2064,707,-2064,720,-2065,734,-2066,744,-2068,755,-2071,770,-2077,779,-2086,791,-2093,808,-2097,818,-2098,829,-2099,841,-2098,853,-2098,872,-2097,884,-2097,890,-2096 } },
