    ["eo.bhot"] = "BHOT",
    ["eo.hint"] = "[P] 退出吊艙 · 滑鼠 轉動 · 滾輪 變焦\n[Z] 寬 / 窄視場 · [V] 白熱 / 黑熱 / 電視\n[R] 換目標 · 左鍵 投放 / 開火 · 飛機自動保持平飛",
    ["eo.range"] = "距離",
    ["eo.sayArea"] = "移動滑鼠搜尋目標，滾輪放大。",
    ["eo.sayHold"] = "彈已投出，吊艙一直對著目標。",
    ["eo.sayPoint"] = "已跟蹤目標，左鍵投放。",
    ["eo.title"] = "光電吊艙",
    ["eo.tv"] = "CCD",
    ["eo.whot"] = "WHOT",
    ["faction.atk.desc"] = "從海上一路打上去：先搶灘前哨島 A，再登陸主島拿下港口 C 和機場 D，最後攻下指揮部 E。上了主島以後可以直接在目標前面的攻擊出發陣地出生。每陣亡一人兵力少 1，兵力打光就輸。",
    ["faction.atk.desc@city"] = "從南邊的主基地出發（車場、直升機坪、跑道都在基地裡）：先拿下鋼廠 A，再打公園 B、中央廣場 C、火車站 D，最後攻下北邊的電視塔 E。街道窄、樓擋視線，注意轉角和樓縫；樹撞得倒，炮彈打得塌樓。",
    ["faction.atk.desc@sands"] = "從南邊的前進基地、前進機場北上：越過邊境沙牆拿下哨所 A，再打油田 B、鎮子 C、空軍基地 D，最後攻下巖嶺上的指揮部 E。每個階段都能在目標前面的攻擊出發陣地出生。每陣亡一人兵力少 1，兵力打光就輸。",
    ["faction.atk.desc@snow"] = "從南邊的主基地出發（車場、直升機坪、跑道都在基地裡）：先拿下鋸木廠 A，再打西坡上的雷達站 B、河邊的山村 C、冰湖邊的水電站 D，最後攻下北邊的山口檢查站 E。谷裡到處是山樑和沖溝：車體藏在梁後面打，冰面上沒有掩護。",
    ["faction.atk.en"] = "COALITION LANDING FORCE",
    ["faction.atk.name"] = "登陸聯軍",
    ["faction.atk.role"] = "進攻  ·  兩棲登陸",
    ["faction.atk.role@city"] = "進攻  ·  從南邊打進城",
    ["faction.atk.role@sands"] = "進攻  ·  裝甲突擊",
    ["faction.atk.role@snow"] = "進攻  ·  從南邊打進河谷",
    ["faction.def.desc"] = "一道防線一道防線地守：守住當前的據點，把攻方的兵力耗光、或者拖到時間結束就贏。據點被壓著時在後方集結點出生。",
    ["faction.def.desc@snow"] = "守住河谷：鋸木廠 A、雷達站 B、山村 C、水電站 D、山口 E 一個一個守。佔著高處（雷達站的臺地、山口兩邊的山肩）往下打，山村的廢墟里能藏車。",
    ["faction.def.en"] = "ISLAND GARRISON COMMAND",
    ["faction.def.name"] = "島嶼守備軍",
    ["faction.def.role"] = "防守  ·  島嶼防禦",
