  pine = { kind = "conifer", h = 49.43, r = 15.95, o = { 264.06, 0, 62.66 }, tris = 3990, parts = { { name = "Bark", c = { 0, 22.11, 0 }, s = { 22.26, 44.21, 23.39 } }, { name = "Leaves", c = { 0.09, 30.82, -0.35 }, s = { 31.72, 37.23, 31.04 } } } },
