    ["fort.aaa"] = "高射砲",
    ["fort.bunker"] = "機関銃トーチカ",
    ["fort.coastal"] = "沿岸砲",
    ["fort.howitzer"] = "M777 榴弾砲",
    ["fort.mine"] = "地雷",
    ["fort.strike"] = "砲兵",
    ["fw.flak35"] = "35 mm 連装高射機関砲",
    ["fw.hmg"] = "12.7 mm 機関銃",
    ["fw.how155"] = "155 mm 榴弾砲",
    ["fw.naval127"] = "127 mm 砲",
    ["game.title"] = "島嶼強襲",
    ["gar.back"] = "戻る",
    ["gar.cells"] = "ERA {1} 枚",
    ["gar.d.arat"] = "米軍 TUSK の ARAT-1：M19 反応装甲タイル、1 枚 65 lb（約 29.5 kg、米陸軍 2020 年）、RPG 対策。タンデムミサイルへの効果は小さく、APFSDS には無効。",
    ["gar.d.arat2"] = "TUSK II：M19 の上に ARAT-2（M32、屋根瓦のような曲面）をもう一層重ね、タンデム弾頭に対応 — ミサイルは 50%、ロケット弾は 25% に。工場装着の M19 の上にも重なる。M32 の重量は非公開。1 枚約 22 kg と仮定（推定）。",
    ["gar.d.belly"] = "車底全面の防護板：車体下で起爆した対戦車地雷や爆薬のダメージは半分（推定）。約 1.3 t（推定）。",
    ["gar.d.ep"] = "車体のマスをクリックして ERA を付ける / 外す：天板には付けない。照準器・ペリスコープ・ライト・発煙弾発射機・ハッチの上にも、砲塔旋回や俯角を取った砲身が通る場所にも付けない。工場装着のタイルは外せない。",
    ["gar.d.era"] = "ロケット弾やミサイルがブロックに当たると起爆し、ダメージの大半を防ぐ。重 ERA は運動エネルギー弾も減衰させる。使ったブロックはなくなる。",
    ["gar.d.eraZones"] = "反応装甲を付ける場所を選ぶ（左のカードか車体の円）：砲塔正面、砲塔側面、上部前面、サイドスカート。装着部にロケット弾やミサイルが当たるとそのブロックが起爆してダメージの大半を失う。未装着部は全ダメージを受ける。外す区画が増えるほど少し軽く速くなる。",
    ["gar.d.fy2"] = "第 2 世代 ERA：単弾頭 HEAT（RPG）に非常に有効 — タイル命中時のダメージは 30%。タンデム弾頭ミサイルは前段で無効化する。APFSDS には無効。1 枚約 22 kg（推定）。",
    ["gar.d.fy4"] = "重 ERA（コンタクト-5 級：長い弾芯をそらし折る厚い鋼板）：HEAT は約 22%、タンデムミサイルは約 60%、APFSDS は約 20% 減衰（コンタクト-5 の公称：貫徹力約 20% 減）。1 枚約 45 kg（推定）。",
    ["gar.d.gau8"] = "砲塔上に 30 mm ガトリングとドラム 2 個（2048 発）を追加、3 で切替。歩兵・軽装甲・陣地・低空機に有効。速度 −5%。",
    ["gar.d.gl5"] = "NORINCO GL5：砲塔四隅に発射ユニット 4 基とミリ波レーダー 4 基。方位 360° だが仰角は 20° まで（トップアタックは防げない）。100 m 以上先から追尾し、約 10 m 先で脅威を破壊。各ユニット 1 発、ゲームでは 45 秒ごとに 1 発補充。",
    ["gar.d.hk"] = "砲塔側面の発射器が飛来するロケット弾やミサイルを約 10 m 先で破壊。4 発、30 秒ごとに 1 発補充。戦車砲弾や急角度のトップアタックは防げない。速度 −3%。",
    ["gar.d.jd3"] = "99A の JD-3：レーザー警報 + レーザー対抗（照準器の妨害）+ 自動発煙。公開情報は少ない。ゲームでは警告・発煙し、約 45% の確率でミサイルのロックを外す（推定）。約 120 kg（推定）。",
    ["gar.d.lws"] = "レーザー警報受信機：レーザー誘導ミサイルや爆弾に狙われるとすぐ警告し方位を示し、自動で発煙弾を一斉発射 — 煙がレーザースポットを隠しミサイルはロックを失う。約 60 kg（推定）。",
    ["gar.d.mcs"] = "マルチスペクトル迷彩（サーブ バラクーダ MCS 級）：可視光・近赤外・熱赤外・レーダーを遮り、敵ボットや車両の発見距離が通常の 70% に（推定）。側面と後部のみで、天板や光学装置は覆わない。約 300 kg（推定）。",
    ["gar.d.none"] = "APS なし：軽く、少し速い。",
    ["gar.d.plow"] = "ピアソン全幅地雷処理鋤：3,600 kg、幅 4.2 m・深さ 175–300 mm の通路を 1–15 km/h で啓開、上げるのに 11 秒。走行中に J で下げ / 上げ：前方の通路の地雷は起爆せずに脇へ押しのけられる。",
    ["gar.d.shtora"] = "T-90A のシュトーラ-1：主砲の両側に OTShU-1-7 赤外線妨害灯（赤い一対のライト）とレーザー警報。レーザー照射を受けると自動で発煙。指令誘導の対戦車ミサイル（TOW、HOT、アタカ…）は約 850 m 以内で約半数がそらされる。",
    ["gar.d.slat"] = "車体後部・側面後部（機関室外）・砲塔後部から約 0.5 m 離した平鋼の格子：単弾頭ロケット弾の約半数は信管がつぶれて不発（Wikipedia：約 50%）。ミサイルや砲弾には無効。約 650 kg（推定）。",
    ["gar.d.stock"] = "車両本来の車上機関銃。",
    ["gar.d.trophy"] = "ラファエル Trophy（米陸軍 M1A2 SEPv2、海兵隊 M1A1 に装着）：旋回する発射器 2 基、EL/M-2133 レーダーの平面アンテナ 4 枚で 360° をカバー、同じ発射器の連射は最短 1.5 秒間隔。重量約 5,000 lb（2.3 t）増。米軍の試験で砲塔のバランスが崩れ旋回が遅くなった（ここでは −10%）。発射器ごとの弾数は非公開、4 発と仮定。",
    ["gar.fixed"] = "標準",
