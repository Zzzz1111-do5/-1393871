    <Item class="ModuleScript" referent="28">
      <Properties>
        <string name="Name">ImportedWpn</string>
        <ProtectedString name="Source"><![CDATA[-- 导弹合集（models/wpn/missiles.glb，tools/models/wpn2glb.py 生成）：署名（主菜单「致谢」）和导入了的型号
return {
  credit = "机载导弹、炸弹（AGM-114「地狱火」、AGM-65「小牛」、AIM-9X「响尾蛇」、AKD-10、GBU-12「宝石路」II、GBU-31 JDAM、GBU-32 JDAM、天燕-90）：Missile & Bomb Collection - Fighter Jets - Free，作者 bohmerang（https://sketchfab.com/3d-models/missile-bomb-collection-fighter-jets-free-d203b678424a43568703bf85ba680f47），CC BY-NC-SA 4.0 授权（https://creativecommons.org/licenses/by-nc-sa/4.0/）。署名见 models/wpn/credits.txt",
  keys = { "agm114", "agm65", "aim9x", "akd10", "gbu12", "gbu31", "gbu32", "ty90" },
}
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="29">
      <Properties>
        <string name="Name">Lang</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——界面文字。服务器给客户端发的是文字编号和参数，各人按自己的语言显示
--   中文、英文写在这个文件里（add）；11-28 用户「多语言做一下」：另外八种——繁體中文、日本語、한국어、Русский、Deutsch、Français、
--   Español、Português——的译文在 ReplicatedStorage.LangPacks.<代码>（tools/i18n 生成，见 tools/i18n/README.md），缺的退回英文（繁中退回简体）
--   客户端按 LocalizationService.RobloxLocaleId 挑（Lang.pick）；设置里能手动换
--   Lang.t(lang, key, ...)：{1} {2} … 换成参数；参数是表 { k = "编号", … } 时先翻译它（服务器发「据点 A」「步枪兵」这种）
local Lang = {}

local ZH, EN = {}, {}
Lang.zh, Lang.en = ZH, EN

local function add(key, zh, en)
  ZH[key] = zh
  EN[key] = en
end

