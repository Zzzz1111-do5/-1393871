    vs = { inf = 1.3, light = 1.0, armor = 0.5, fort = 1.5 }, splash = 1.4 },
  -- SU-100 的 100 毫米 D-10S（11-28）：五十年代随车带来的 BR-412 尖头穿甲榴弹
  br412 = { cls = "ap", name = "BR-412 APHE", sym = "穿甲", v0 = 895, k = 1.15e-4, bs = 1000, tr = true,             -- 尖头穿甲榴弹，带一点装药
    vs = { inf = 0.7, light = 1.1, armor = 1.0, fort = 0.9 }, splash = 1.0 },
