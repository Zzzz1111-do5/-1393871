  grass_s = { kind = "grass", h = 2.06, r = 5.77, o = { 249.37, 0, 150.04 }, tris = 1036, parts = { { name = "Leaves", c = { -1.53, 0.64, 0.2 }, s = { 5.67, 1.28, 8.25 } }, { name = "Leaves2", c = { 2.09, 1.03, -0.67 }, s = { 7.36, 2.06, 8.71 } } } },
