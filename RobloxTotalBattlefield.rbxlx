    ["gear.binoc.desc"] = "Marca inimigos para a equipe e pede artilharia",
    ["gear.breach.desc"] = "Detecta e remove minas, corta arame",
    ["gear.c4.desc"] = "Coloque e use de novo para detonar",
    ["gear.grenade.desc"] = "Explode alguns segundos após o arremesso",
    ["gear.lmg.desc"] = "Fita de 100 tiros para supressão; pesada e lenta para mirar",
    ["gear.m4.desc"] = "Carabina automática para curta e média distância",
    ["gear.manpads.desc"] = "Trave em helicópteros e jatos e então dispare",
    ["gear.medkit.desc"] = "Cura os aliados por perto; reanima os abatidos muito mais rápido e com vida cheia",
    ["gear.mortar.desc"] = "Mire no chão; as granadas caem segundos depois",
    ["gear.pistol.desc"] = "Arma secundária para quando a principal esvaziar",
    ["gear.qbz191.desc"] = "Fuzil padrão do ELP, 5,8 mm, automático",
    ["gear.repair.desc"] = "Repara veículos e fortificações",
    ["gear.rpg.desc"] = "Contra tanques, blindados e bunkers",
    ["gear.shotgun.desc"] = "Nove projéteis por tiro: letal de perto, inútil de longe",
