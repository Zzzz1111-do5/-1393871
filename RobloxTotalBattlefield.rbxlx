  jph2 = { credit = "民房：Japanese Residential Home 02，作者 Morrissey Alexander（https://sketchfab.com/3d-models/japanese-residential-home-02-c31697f09152453cb3ed215482e7a810），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 22.859, h = 19.682, name = "民房", o = { 54.208, 0, 0 }, parts = { Body_1 = { c = { 0, 9.841, 0 }, s = { 16.83, 19.682, 22.859 } } }, w = 16.83 },
  jph3 = { credit = "民房：Japanese Residential Home 03，作者 Morrissey Alexander（https://sketchfab.com/3d-models/japanese-residential-home-03-1c53f4f37fc44c32a8874464025aea48），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 33.052, h = 19.827, name = "民房", o = { 98.651, 0, 0 }, parts = { Body_1 = { c = { 0, 9.914, 0 }, s = { 32.056, 19.827, 33.052 } } }, w = 32.056 },
  house = { credit = "瓦房：House，作者 SpatialNeglect（https://sketchfab.com/3d-models/house-e70c4aebc911429ba9a894b38146892c），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 22.087, h = 16.83, name = "瓦房", o = { 148.335, 0, 0 }, parts = { Body_1 = { c = { 0.144, 11.462, -0.136 }, s = { 27.026, 8.76, 21.815 } }, Body_2 = { c = { 0.392, 4.363, 0.009 }, s = { 25.958, 8.727, 20.695 } }, Body_3 = { c = { -0.234, 10.38, 2.653 }, s = { 26.845, 12.9, 16.781 } }, Body_4 = { c = { 0.413, 8.338, 0.355 }, s = { 26.402, 13.862, 20.412 } } }, w = 27.313 },
  conc1 = { credit = "水泥楼：Old Concete Building Pack | Lowpoly，作者 Frid.blend（https://sketchfab.com/3d-models/old-concete-building-pack-lowpoly-6d070fcc86b0430dadf53da67545c6f3），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 29.294, h = 19.119, name = "水泥楼", o = { 196.638, 0, 0 }, parts = { Body_1 = { c = { 0, 9.56, 0 }, s = { 29.293, 19.119, 29.294 } } }, w = 29.293 },
  conc2 = { credit = "水泥楼：Old Concete Building Pack | Lowpoly，作者 Frid.blend（https://sketchfab.com/3d-models/old-concete-building-pack-lowpoly-6d070fcc86b0430dadf53da67545c6f3），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 28.242, h = 18.913, name = "水泥楼", o = { 245.406, 0, 0 }, parts = { Body_1 = { c = { 0, 9.457, 0 }, s = { 28.242, 18.913, 28.242 } } }, w = 28.242 },
  conc3 = { credit = "水泥楼：Old Concete Building Pack | Lowpoly，作者 Frid.blend（https://sketchfab.com/3d-models/old-concete-building-pack-lowpoly-6d070fcc86b0430dadf53da67545c6f3），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 24.132, h = 15.984, name = "水泥楼", o = { 291.593, 0, 0 }, parts = { Body_1 = { c = { 0, 7.992, 0 }, s = { 24.132, 15.984, 24.132 } } }, w = 24.132 },
  hangar = { credit = "机库：j type hanger，作者 ElectricL（https://sketchfab.com/3d-models/j-type-hanger-d86713d61b4941378a6ad21569e0cbac），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 125.837, h = 27.021, name = "机库", o = { 366.981, 0, 0 }, parts = { Body_1 = { c = { 0, 13.51, 0 }, s = { 86.644, 27.021, 125.837 } } }, w = 86.644 },
  atc = { credit = "塔台：Air Traffic Control Tower，作者 abass20（https://sketchfab.com/3d-models/air-traffic-control-tower-84f215391662453680e646649d42b264），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 27.051, h = 106.04, name = "塔台", o = { 443.829, 0, 0 }, parts = { Body_1 = { c = { 0, 53.02, 0 }, s = { 27.051, 106.04, 27.051 } } }, w = 27.051 },
  quonset = { credit = "铁皮营房：Military Style Building (with animations)，作者 TampaJoey（https://sketchfab.com/3d-models/military-style-building-with-animations-1671685e1dd94b6e9216ead632f08f6e），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 54.574, h = 16.765, name = "铁皮营房", o = { 493.808, 0, 0 }, parts = { Body_1 = { c = { -0.013, 3.752, -16.216 }, s = { 3.454, 5.959, 0.391 } }, Body_10 = { c = { -0.05, 5.065, -19.518 }, s = { 21.602, 3.825, 0.959 } }, Body_11 = { c = { -0.067, 4.959, -19.646 }, s = { 21.636, 4.695, 0.02 } }, Body_12 = { c = { -0.067, 4.959, -19.64 }, s = { 21.636, 4.695, 0.158 } }, Body_2 = { c = { -0.028, 4.964, -18.806 }, s = { 15.921, 4.822, 0.505 } }, Body_3 = { c = { 0, 5.889, 23.955 }, s = { 21.737, 10.54, 0.615 } }, Body_4 = { c = { 0.006, 5.417, 24.432 }, s = { 9.776, 9.305, 0.171 } }, Body_5 = { c = { -0.001, 8.577, 3.083 }, s = { 32.604, 16.376, 46.338 } }, Body_6 = { c = { 0, 7.723, 2.997 }, s = { 31.7, 15.049, 45.882 } }, Body_7 = { c = { 0.033, 5.037, -17.954 }, s = { 9.149, 9.903, 4.84 } }, Body_8 = { c = { 0.022, 6.006, 3.164 }, s = { 12.312, 1.478, 47.094 } }, Body_9 = { c = { 0, 0.378, 0 }, s = { 32.909, 0.756, 54.574 } } }, w = 32.909 },
  firestation = { credit = "消防站：Fire Station No. 1，作者 CommonSpence（https://sketchfab.com/3d-models/fire-station-no-1-87edf04deb28434993274d9f05070865），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 66.107, h = 29.591, name = "消防站", o = { 574.036, 0, 0 }, parts = { Body_1 = { c = { 0, 14.796, 0 }, s = { 87.545, 29.591, 66.107 } } }, w = 87.545 },
  wh3 = { credit = "库房：Pack - Realistic - 3 Warehouse，作者 Islide（https://sketchfab.com/3d-models/pack-realistic-3-warehouse-320c272513a94c0482dbb3c4e79d61f5），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 29.028, h = 12.2, name = "库房", o = { 703.88, 0, 0 }, parts = { Body_1 = { c = { -19.044, 2.813, -1.465 }, s = { 92.698, 5.625, 24.727 } }, Body_2 = { c = { 0, 9.844, -0 }, s = { 131.253, 4.712, 28.43 } }, Body_3 = { c = { 0, 6.153, 0 }, s = { 131.253, 11.133, 28.126 } }, Body_4 = { c = { 0, 0.293, 0 }, s = { 131.487, 0.586, 28.36 } }, Body_5 = { c = { 0, 6.1, 0 }, s = { 132.144, 12.2, 29.028 } }, Body_6 = { c = { -2.744, 3.809, -6.26 }, s = { 125.297, 2.725, 15.136 } } }, w = 132.144 },
  sawtooth = { credit = "厂房：Warehouse Building，作者 OmegaRedZA（https://sketchfab.com/3d-models/warehouse-building-0c37b0f92cb54e07a1e1c6c3df9f8439），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 63.237, h = 18.57, name = "厂房", o = { 812.884, 0, 0 }, parts = { Body_1 = { c = { -0.012, 14.686, 0 }, s = { 45.839, 7.768, 63.237 } }, Body_2 = { c = { 0.147, 5.624, -0.402 }, s = { 45.569, 11.249, 62.287 } }, Body_3 = { c = { 12.288, 5.624, -31.365 }, s = { 21.231, 11.249, 0.288 } }, Body_4 = { c = { 0.013, 5.768, 30.671 }, s = { 45.085, 11.249, 0.288 } }, Body_5 = { c = { 22.748, 5.768, -0.464 }, s = { 0.288, 11.249, 21.217 } }, Body_6 = { c = { 0.032, 14.615, -0.302 }, s = { 45.584, 7.641, 62.565 } }, Body_7 = { c = { 0.032, 0.453, -0.424 }, s = { 44.937, 0.302, 62.273 } } }, w = 45.863 },
  smallwh = { credit = "小库房：Small Warehouse，作者 Wardster（https://sketchfab.com/3d-models/small-warehouse-c7f4c017c20943cb9e9e559822a5c402），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 33.931, h = 10.736, name = "小库房", o = { 869.953, 0, 0 }, parts = { Body_1 = { c = { 0, 5.368, 0 }, s = { 28.276, 10.736, 33.931 } }, Body_2 = { c = { -1.548, 3.945, -16.527 }, s = { 22.784, 7.889, 0.356 } } }, w = 28.276 },
  industrial = { credit = "办公楼：industrial building，作者 spicybamer（https://sketchfab.com/3d-models/industrial-building-770acf6b0da74af397f748d95141f8be），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 57.956, h = 48.864, name = "办公楼", o = { 932.125, 0, 0 }, parts = { Body_1 = { c = { 0, 24.206, 0 }, s = { 56.067, 48.411, 57.956 } }, Body_2 = { c = { 0, 41.467, 0 }, s = { 56.067, 14.794, 57.956 } } }, w = 56.067 },
  flats1 = { credit = "公寓楼：Davison Street Flats 1 - Flat Roof，作者 Charlie_Zane（https://sketchfab.com/3d-models/davison-street-flats-1-flat-roof-0f461ea81f8541db8d6a5f5e35133588），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 25.2, h = 26.6, name = "公寓楼", o = { 1020.198, 0, 0 }, parts = { Body_1 = { c = { 0, 13.3, 0 }, s = { 80.08, 26.6, 25.2 } } }, w = 80.08 },
  wh99 = { credit = "砖砌库房：Warehouses，作者 99.Miles（https://sketchfab.com/3d-models/warehouses-e6e105d35b3f486292c42ffa52f363c0），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）", d = 60.243, h = 24.047, name = "砖砌库房", o = { 1149.333, 0, 0 }, parts = { Body_1 = { c = { 0, 12.024, 0 }, s = { 138.191, 24.047, 60.243 } } }, w = 138.191 },
}
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">Config</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——数值（服务器、客户端共用）
-- 文字都在 Lang.lua（中英双语），这里只放编号和数
local Config = {}

Config.Version = "1.0-alpha"
Config.SaveKey = "IslandAssault_v1"   -- DataStore 名字（改了就是新存档；游戏改过名（暗剑：登岛战 → Roblox全面大战场 → 全面大战场 / Island Assault）照旧用这个，玩家的军衔、经验不丢）
Config.Tick = 0.1                     -- 推演步长（秒）：占领、AI、炮弹、导弹

---------------------------------------------------------------- 回合

-- 准备 → 战斗（攻方每拿下一个据点加时间）→ 结算 → 重新随机分队
Config.Round = {
  prep = 30,            -- 准备（选兵种、等人）
  battle = 30 * 60,     -- 战斗时长（地图放大到 3 倍后从 20 分钟加到 30 分钟：走得远）
  perCapture = 240,     -- 攻方每拿下一个据点加多少秒
  overtime = 90,        -- 时间到时有据点正在被占：最多加时多久
  results = 20,         -- 结算画面
}
Config.RespawnDelay = 6   -- 阵亡后几秒回到部署界面
Config.MinPlayersToStart = 1

-- 分阶段突破（用户：玩法不够清晰、没法快速进入战局、感受不到激烈对抗）：5 个据点不再同时开，一个阶段一个阶段打——
--   同时只能占当前阶段的据点，两边的人（机器人也是）都往那里去；打下这一阶段的全部据点，战线往前推、出生点跟着走。
--   time 这一阶段限时（秒，到点守方赢；有据点正在被占就加时）；flank 侧翼据点：从这一阶段起开放，拿下给攻方补兵力，不拿也能往前推
Config.Stages = {   -- 用户：同一时间只开一个交战区（像 Battlefield 的突破模式）——一个阶段一个据点，灯塔岛 B 不开放
  { id = "beach", points = { "A" }, time = 7 * 60 },     -- 第一阶段：抢滩前哨岛
  { id = "port", points = { "C" }, time = 6 * 60 },      -- 第二阶段：登陆主岛，拿下港口
  { id = "airfield", points = { "D" }, time = 6 * 60 },  -- 第三阶段：机场
  { id = "hq", points = { "E" }, time = 7 * 60 },        -- 第四阶段：指挥部决战
}
Config.FirstWave = 45   -- 只有第一波坐登陆艇抢滩：开战后这么多秒以内还能上艇，之后攻方在攻击出发阵地出生（Round.lua）
-- 攻方兵力（门票）：攻方每阵亡一个（真人、机器人都算）扣 1，扣光了守方赢；打下一个阶段、拿下侧翼据点补兵力；人多的服多给一点
Config.Tickets = { start = 240, perReal = 10, perStage = 100, flank = 50, extraCap = 60 }   -- extraCap：阶段里拿下一个点（还没打完这一阶段）加多少秒
-- 昼夜（客户端 DayNight.lua）：用户 11-18「把白天模式去掉，就锁定晚上」——lockNight 一直停在半夜 clock 点（夜里那套灯光、出生自动开夜视）；
--   lockNight = false 才按 period（一圈多少秒，每局从早上 7:30 开始）昼夜更替
Config.DayNight = { lockNight = true, clock = 2.3, period = 24 * 60 }
Config.RallyBack = 200   -- 守方集结点：据点后面多远（格，150～250），守方在这里出生（用户：出生点跟着战线走）
Config.StageOff = 260    -- 攻方攻击出发阵地：据点往攻方来的方向多远（格，200～300），第一波以后攻方在这里出生（Round.lua）

-- 占领：圈里数双方的人（步兵、地面载具；飞机、舰艇不算；机器人也算）
Config.Capture = {
  r = 70,          -- 据点半径（和 Map.POINT_R 一样）
  height = 45,     -- 据点上下可占领的高度（格）
  slow = 45,       -- 攻方多 1 人：几秒占完
  fast = 15,       -- 攻方多 3 人以上：几秒占完
  decay = 90,      -- 守方人不少于攻方：进度从满退到零要几秒
  botW = 0.35,     -- PvP（用户：不要让 AI 带节奏）：机器人占点只算 0.35 个人；攻方有真人在服务器上时，圈里没有攻方真人就不涨
}

Config.Teams = {
  atk = { color = Color3.fromRGB(220, 70, 55), brick = "Bright red" },
  def = { color = Color3.fromRGB(60, 120, 230), brick = "Bright blue" },
}

---------------------------------------------------------------- 步兵兵种（9 种，无限复活）：主枪统一是 M4（狙击手另有狙击枪），机枪手并进了步枪兵

-- hp 血量、speed 走路速度；weapons 带的武器（按顺序进背包：1、2、3…）
Config.Roles = {
  { id = "rifle", hp = 100, speed = 16, weapons = { "m4", "grenade" } },
  { id = "sniper", hp = 90, speed = 16, weapons = { "sniper", "m4" } },
  { id = "at", hp = 100, speed = 15, weapons = { "m4", "rpg" } },
  { id = "aa", hp = 100, speed = 15, weapons = { "m4", "manpads" } },
  { id = "medic", hp = 100, speed = 16.5, weapons = { "m4", "medkit" } },
  { id = "engineer", hp = 105, speed = 15.5, weapons = { "m4", "repair", "breach" } },
  { id = "mortar", hp = 100, speed = 15, weapons = { "m4", "mortar" } },
  { id = "spec", hp = 110, speed = 18, weapons = { "m4", "c4", "grenade" } },
  { id = "spotter", hp = 95, speed = 16, weapons = { "m4", "binoc" } },
}
Config.RoleById = {}
for _, r in ipairs(Config.Roles) do Config.RoleById[r.id] = r end

-- 装备栏（用户：开局不选兵种，默认就是一个士兵，部署界面底下改枪械配置）：四格各挑一样，服务器按这张表核对；
--   上面的「兵种」只剩老的名字（测试、机器人、战况表的标签）还认
Config.Loadout = {
  { id = "primary", opts = { "m4", "sniper" } },                       -- 主武器
  { id = "secondary", opts = { "tablet" }, none = true },             -- 副武器：战术平板（R 币解锁：Config.Passes.tablet；用户：不要按 B 召唤平板，平板做成物品）
  { id = "launcher", opts = { "rpg", "manpads", "mortar" }, none = true },   -- 发射器（可以不带：跑得快一点）
  { id = "gadget", opts = { "medkit", "repair", "breach", "binoc" } },  -- 装备
  { id = "throw", opts = { "grenade", "c4" } },                        -- 投掷
}
Config.LoadoutDefault = { primary = "m4", gadget = "medkit", throw = "grenade" }

-- R 币解锁（游戏通行证 Game Pass）：在 Roblox 创作者后台给这个体验建两个通行证（价格照 price），把通行证编号填进 id——
--   id 还是 0 的时候谁都能用（没上架前不挡人，Studio 里测试也方便）；填了编号就只有买了的人能用，没买的点了弹出购买框
--   item：这个通行证解锁什么（装备栏里的物品 / 召唤点的机型）
Config.Passes = {
  tablet = { id = 0, price = 99, item = "tablet" },   -- 战术平板（副武器）：召唤步战车、空投补给、呼叫火力
  b2 = { id = 0, price = 199, item = "b2" },          -- B-2 隐身轰炸机（守方）
}
Config.PassFor = {}   -- 物品 / 机型 → 通行证名
for k, v in pairs(Config.Passes) do Config.PassFor[v.item] = k end
Config.Soldier = { hp = 100, speed = 16, heavy = 15 }   -- 带着发射器（火箭筒、防空导弹、迫击炮）走慢一点

-- 左下的雷达（用户：小地图改成雷达风格的绿色、圆形，能看到范围内的友军和敌军）：
--   友军都显示；敌人里车、船、飞机在范围内就显示（雷达回波），步兵要在自己视线里、开了枪（没消音的，开枪的地方闪一下）或者被友军标记了才显示——
--   不然雷达就成了透视；allEnemies = true 时范围内的敌人全显示
Config.Radar = { range = 520, veh = 900, heli = 4000, jet = 9000, sweep = 2.4, ping = 3, allEnemies = false }   -- 半径（格：步兵约 186 米、地面载具 320 米、直升机 1.4 公里、固定翼 3.2 公里）、扫一圈几秒、开枪的红圈留几秒

---------------------------------------------------------------- 武器

-- 目标类别：inf 步兵、light 轻型车、armor 装甲、air 飞机直升机、ship 舰艇、fort 工事
-- kind：gun 直射（服务器射线判定）；proj 有弹道的弹（speed 弹速、splash 溅射、drop 是否下坠）；throw 投掷（fuse 引信秒数）；
--   lock 锁定导弹（打 air，lockTime 锁定要几秒）；mortar 曲射（点地图上 / 准星下的地面，minR maxR 射程）；
--   heal 治疗（r 范围、amt 每次、cd 冷却）；repair 修车、修工事（每秒 rate）；place 放置（炸药包）；breach 破障器材；spot 望远镜标记敌人、呼叫炮击
--   （雷区、铁丝网、炮都是地图自带的，玩家不能自己布雷、架炮）
-- dmg 每发、rate 几秒一发、mag 弹匣、reserve 备弹（不算弹匣里的；没写就是无限）、reload 换弹秒数、range 射程、spread 散布（度）；
-- vs 对各类目标的伤害倍数
-- 枪（kind gun）的散布（用户 11-18：提高手感）：spread 是腰射，adsK 开镜乘几，moveK 跑到 16 格每秒多散几倍（开镜减半），
--   跳在半空乘 2.2，bloom = { 每发多几度, 最多多几度, 每秒收回几度, 停手几秒后才收回 }（连射越打越散，停手很快收回；开镜减半）——Config.gunSpread
local G_VS = { inf = 1, light = 0.15, armor = 0, air = 0.1, ship = 0, fort = 0.04 }
Config.Weapons = {
  m4 = { kind = "gun", dmg = 25, rate = 0.08, mag = 30, reload = 2.6, range = 650, spread = 0.55, adsK = 0.35, moveK = 0.8, bloom = { 0.06, 0.55, 2.2, 0.12 },
    auto = true, vs = G_VS, head = 1.6,
    scope = 3.5, optic = "acog" },   -- 两队都用这一种（第一人称动作照 M4 动作包）；上机匣导轨上一具 ACOG 3.5 倍镜（用户：武器瞄准没有镜子）
  -- 狙击枪：开镜 0.03°（原来不分开不开镜都是这么准），腰射 2.6°（不开镜别指望一枪一个）
  sniper = { kind = "gun", dmg = 96, rate = 1.35, mag = 5, reload = 3.0, range = 1500, spread = 2.6, adsK = 0.0115, moveK = 1.5,
    vs = { inf = 1, light = 0.25, armor = 0, air = 0.1, ship = 0, fort = 0.05 }, head = 2.2, scope = 5 },
  rpg = { kind = "proj", dmg = 110, rate = 0.5, mag = 1, reserve = 3, reload = 3.4, range = 700, spread = 0.4, speed = 230, splash = 11, drop = true,
    vs = { inf = 1, light = 5, armor = 5.5, air = 3, ship = 2.5, fort = 4 } },
  manpads = { kind = "lock", dmg = 120, rate = 0.5, mag = 1, reserve = 1, reload = 3.5, range = 1400, speed = 320, splash = 9, lockTime = 1.6,
    vs = { inf = 0.3, light = 0.5, armor = 0.3, air = 6, ship = 0.5, fort = 0.2 } },
  grenade = { kind = "throw", dmg = 115, rate = 1.0, mag = 1, reserve = 1, reload = 0.8, range = 90, fuse = 2.8, splash = 14, speed = 70,
    vs = { inf = 1, light = 0.8, armor = 0.15, air = 0, ship = 0.1, fort = 0.6 } },
  mortar = { kind = "mortar", dmg = 95, rate = 1.6, mag = 1, reserve = 11, reload = 2.6, minR = 90, maxR = 950, splash = 17, flight = 5,
    vs = { inf = 1, light = 0.8, armor = 0.3, air = 0, ship = 0.25, fort = 0.8 } },
  medkit = { kind = "heal", amt = 35, r = 14, cd = 6, mag = 1, rate = 0.5, reload = 0 },
  repair = { kind = "repair", rate = 90, range = 16, mag = 1, reload = 0 },
  breach = { kind = "breach", range = 6, detect = 34, time = 1.6, mag = 1, reload = 0 },   -- 破障器材：探雷（detect 格以内）、排雷 / 剪铁丝网（离得 range 格以内按住 time 秒）
  c4 = { kind = "place", dmg = 260, splash = 13, mag = 1, reserve = 1, reload = 0.6, rate = 0.8, trigger = "remote",
    vs = { inf = 1, light = 4, armor = 5, air = 0, ship = 2, fort = 5 } },
  tablet = { kind = "pad", mag = 1, reload = 0 },   -- 战术平板：拿在手上就打开平板（客户端 TacPad.lua），收起来就关上
  binoc = { kind = "spot", range = 1600, spotTime = 12, cd = 4, strikeCd = 75, strike = { n = 8, r = 26, dmg = 120, splash = 20, flight = 6,
    vs = { inf = 1, light = 1, armor = 0.45, air = 0, ship = 0.3, fort = 1 } }, mag = 1, reload = 0 },
}

---------------------------------------------------------------- 载具（按名额；每队每种同时在场有上限，按队伍人数算）

-- cat 类别：tank 坦克、apc 装甲车、aa 防空、arty 火炮、heli 直升机、jet 固定翼、ship 舰艇
-- 每类按队给几个型号（Lang 里有名字）；hp、speed（格 / 秒）、tgt 中弹按什么类别算伤害
Config.VehicleCats = {
  tank = { tgt = "armor", hp = 1600, speed = 34, perN = 8, min = 1, max = 4, cd = 60 },
  apc = { tgt = "light", hp = 800, speed = 46, perN = 6, min = 1, max = 5, cd = 45, seats = 5 },
  aa = { tgt = "light", hp = 700, speed = 36, perN = 12, min = 1, max = 2, cd = 60 },
  arty = { tgt = "light", hp = 650, speed = 30, perN = 14, min = 0, max = 2, cd = 70 },
  heli = { tgt = "air", hp = 900, speed = 85, perN = 12, min = 1, max = 3, cd = 75, seats = 4 },
  jet = { tgt = "air", hp = 700, speed = 260, perN = 12, min = 1, max = 3, cd = 90 },
  ship = { tgt = "ship", hp = 3000, speed = 45, perN = 16, min = 0, max = 2, cd = 120 },
}
Config.VehicleOrder = { "tank", "apc", "aa", "arty", "heli", "jet", "ship" }
-- 跳弹（用户：跳弹也做出来）：炮弹打在坦克（armor）、轻装甲车（light）上，入射方向离装甲面法线超过 a0 度开始有可能滑开、a1 度一定滑开；
--   滑开的弹只伤 dmg 倍，顺着反射方向飞走（速度剩 keep 倍，再飞 life 秒，碰到东西不炸）
Config.Ricochet = { a0 = { armor = 62, light = 70 }, a1 = { armor = 80, light = 84 }, dmg = 0.04, keep = 0.5, life = 1.2 }
-- 型号：每队每类可选的型号（编号对应 Lang 里的名字和模型名）；mod 按型号微调（hp 倍数、速度倍数、主炮伤害倍数）
Config.Vehicles = {
  atk = {
    tank = { "ztz96", "ztz99a" },   -- ZTQ-15 轻坦 11-19 删掉了（用户：建模非常粗糙）
    apc = { "ztd05", "zbd05", "zsl92b", "ptl02" },
    aa = { "pgz07", "pgl625", "ld2000" },
    arty = { "plz07" },
    heli = { "z10", "z20" },
    jet = { "j15t", "j35", "j20", "j16", "j50", "h6k", "gj11", "gj2" },
    ship = { "t055", "t054a", "t022" },
