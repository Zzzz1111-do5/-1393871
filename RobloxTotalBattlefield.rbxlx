  local HUDS = { bore, aimRing, spdBox, altBox, hdgBox, spdCap, altCap, thrText, vsText, warnText, fuelText, ring, ringText, wList, gText, aText, mText }

  -- 降落引导：自己这边能落的地方（航母拦阻索区、攻方机场岛、主岛机场——据点 D 在自己手里时），返回 接地点、着陆方向
  local function landSites()
    local out = {}
    local team = me:GetAttribute("Side")
    local function pointMine(id)
      for _, p in ipairs((G.S and G.S.points) or {}) do if p.id == id then return p.owner == team end end
      return false
    end
    local function runway(A)
      for s = -1, 1, 2 do   -- 两头都能落：接地点在跑道头往里 60 格
        local td = V(A.x + s * (A.len / 2 - 60), (A.y or 0), A.z)
        table.insert(out, { p = V(td.X, AD.ground(Map, td.X, td.Z), td.Z), dir = V(-s, 0, 0) })
      end
    end
    if team == "atk" then
      local base = AD.carrierCF(Map)
      if base and st.d.carrier then
        local Wd = AD.WIRES
        local td = (base * CF(Wd.x, 0, (Wd.z0 + Wd.z1) / 2)).Position
        table.insert(out, { p = td, dir = base:VectorToWorldSpace(V(-math.sin(Wd.a), 0, -math.cos(Wd.a))), deck = true })
      end
      runway(Map.AFIELD2)
      if pointMine("D") then runway(Map.AIRFIELD) end
    elseif pointMine("D") then
      runway(Map.AIRFIELD)
    end
    return out
  end

  ---------------------------------------------------------------- 手机：杆、油门 / 升降、开火、换武器、热诱弹、起落架、下飞机

  local touch = nil
  local touchUI = nil
  if UIS.TouchEnabled then
    touch = { up = false, down = false, fire = false, flare = false }
    local lb = ui.frame(gui, UDim2.fromOffset(90, 170), UDim2.new(0, 20, 1, -320), RGB(0, 0, 0), 1)
    local rb = ui.frame(gui, UDim2.fromOffset(250, 230), UDim2.new(1, -260, 1, -340), RGB(0, 0, 0), 1)
    local function hold(parent, text, size, pos, key)
      local b = ui.button(parent, text, size, pos, RGB(30, 36, 42))
      b.BackgroundTransparency = 0.35
      b.InputBegan:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch then touch[key] = true end end)
      b.InputEnded:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch then touch[key] = false end end)
      return b
    end
    local function tap(parent, text, pos, f)
      local b = ui.button(parent, text, UDim2.fromOffset(60, 60), pos, RGB(30, 36, 42))
      b.BackgroundTransparency = 0.35
      b.TextSize = 14
      b.Activated:Connect(function() if st then f() end end)
      return b
    end
    hold(lb, "▲", UDim2.fromOffset(80, 80), UDim2.fromOffset(5, 0), "up")
    hold(lb, "▼", UDim2.fromOffset(80, 80), UDim2.fromOffset(5, 90), "down")
    hold(rb, "●", UDim2.fromOffset(96, 96), UDim2.fromOffset(150, 130), "fire")
    tap(rb, "1/2", UDim2.fromOffset(80, 150), function() G.flyNextWeapon() end)
    hold(rb, "X", UDim2.fromOffset(60, 60), UDim2.fromOffset(150, 60), "flare")   -- 热诱弹：按住连续放
    tap(rb, "G", UDim2.fromOffset(80, 80), function() if st.d.kind == "jet" and not st.ground then st.gearWant = (st.gearWant > 0.5) and 0 or 1 end end)
    tap(rb, "R", UDim2.fromOffset(10, 150), function() G.flyNextTarget() end)
    tap(rb, "F", UDim2.fromOffset(10, 80), function() G.R.Drive:FireServer({ op = "exit" }) end)
    tap(rb, "J", UDim2.fromOffset(80, 10), function() G.R.Drive:FireServer({ op = "jettison" }) end)
    touchUI = { lb, rb }
    for _, f in ipairs(touchUI) do f.Visible = false end
  end

  ---------------------------------------------------------------- 武器栏、光电吊舱

  local function buildList()
    for _, r in ipairs(wRows) do r.f:Destroy() end
    wRows = {}
    if not st then return end
    local items = {}
    for i, wid in ipairs(st.wl) do items[#items + 1] = { key = tostring(i), wid = wid, w = AD.W[wid], idx = i } end
    items[#items + 1] = { key = "X", flare = true }
    local H = 34
    wList.Size = UDim2.fromOffset(260, #items * (H + 4))
    for i, it in ipairs(items) do
      local f = ui.frame(wList, UDim2.new(1, 0, 0, H), UDim2.fromOffset(0, (i - 1) * (H + 4)), RGB(0, 18, 6), 0.6)
      f.Name = "Row_" .. (it.wid or "flare")
      local sk = ui.stroke(f, HUD, 1, 0.7)
      local kb = ui.frame(f, UDim2.fromOffset(24, 24), UDim2.new(0, 6, 0.5, 0), RGB(0, 0, 0), 0.4, Vector2.new(0, 0.5))
      ui.stroke(kb, HUD, 1, 0.2)
      local kl = ui.label(kb, it.key, UDim2.fromScale(1, 1), nil, 15, HUD, Enum.Font.Code)
      kl.Name = "Key"
      local ic = ui.frame(f, UDim2.fromOffset(60, 20), UDim2.new(0, 38, 0.5, 0), RGB(0, 0, 0), 1, Vector2.new(0, 0.5))
      ic.Name = "Icon"
      drawIcon(ic, it)
      local nm = ui.label(f, it.flare and T("air.flareName") or T("aw." .. it.wid), UDim2.new(1, -164, 1, 0), UDim2.fromOffset(104, 0), 14, HUD, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
      nm.TextWrapped = false
      nm.Name = "Name"
      local cnt = ui.label(f, "", UDim2.fromOffset(58, H), UDim2.new(1, -6, 0, 0), 17, HUD, Enum.Font.Code, Vector2.new(1, 0), Enum.TextXAlignment.Right)
      cnt.Name = "Count"
      wRows[i] = { f = f, s = sk, cnt = cnt, nm = nm, it = it }
    end
  end

  -- 自己的飞机：看光电时藏起来（吊舱在机腹，不然一低头就是自己的机翼）；热成像高亮所有实体时也不把自己涂白
  local ownAir = Instance.new("Model")
  ownAir.Name = "OwnAir"
  ownAir.Parent = workspace
  local function ownHide(on)
    local v = st and G.views and G.views[st.em]
    if not v or not v.M then return end
    for _, p in ipairs(v.M.plist or {}) do
      if p:IsA("BasePart") then p.LocalTransparencyModifier = on and 1 or 0 end
    end
    if on and v.model and v.model.Parent == G.viewFolder then v.model.Parent = ownAir
    elseif not on and v.model and v.model.Parent == ownAir and G.viewFolder then v.model.Parent = G.viewFolder end
  end
  local function eoApply()
    local on = st ~= nil and st.eo == true
    eoGui.Visible = on
    if st then   -- 吊舱页面盖满屏幕：平显的速度、高度、航向框、武器栏、下面的信息栏收起来，出来再放回去
      for _, l in ipairs(HUDS) do if l ~= warnText then l.Visible = st.pilot == true and not on end end
      panel.Visible = not on
    end
    local m = on and EO_MODES[st.eoMode or 1] or nil
    eoCC.Enabled = on
    eoHl.Enabled = on and m ~= "tv"
    if on then
      if m == "tv" then
        eoCC.Saturation, eoCC.Contrast, eoCC.Brightness, eoCC.TintColor = -1, 0.25, 0.02, Color3.new(1, 1, 1)
      elseif m == "whot" then
        eoCC.Saturation, eoCC.Contrast, eoCC.Brightness, eoCC.TintColor = -1, 0.45, -0.3, RGB(225, 225, 225)
        eoHl.FillColor, eoHl.OutlineColor = Color3.new(1, 1, 1), Color3.new(1, 1, 1)
      else
        eoCC.Saturation, eoCC.Contrast, eoCC.Brightness, eoCC.TintColor = -1, 0.25, 0.22, RGB(235, 235, 235)
        eoHl.FillColor, eoHl.OutlineColor = Color3.new(0, 0, 0), Color3.new(0, 0, 0)
      end
      eoHl.Adornee = G.viewFolder
    end
  end
  -- P：进出光电吊舱（用户：飞机驾驶按 P 也要能切换光电视角）。鼠标只转吊舱（稳定在世界方向上），飞机自己保持平飞（固定翼按住进吊舱时的航向、
  --   航迹拉平；直升机机头不跟着转、不低头）；Z / 滚轮变焦，V 电视 / 白热 / 黑热；画面里的瞄准点就是吊舱看着的地方（对地弹、机头炮塔都朝那里）
  local function setEO(on)
    if not st then return end
    if st.uav then st.dcam = (st.dcam == "nose") and "chase" or "nose" return end   -- 无人机本来就有前视光电：P 跟 V 一样切
    on = on and st.pilot and not st.crashed
    if on == (st.eo == true) then return end
    st.eo = on
    if on then
      local look = cam.CFrame.LookVector
      st.eoYaw = math.atan2(-look.X, -look.Z)
      st.eoPitch = clamp(math.asin(clamp(look.Y, -1, 1)) - 0.15, -1.5, 0.35)
      st.eoMode = st.eoMode or 1
      st.zoom = 1
      if st.d.kind == "jet" then   -- 自动驾驶：按现在的航向平飞
        local v = (st.vel.Magnitude > 1) and st.vel.Unit or st.cf.LookVector
        st.aimYaw = math.atan2(-v.X, -v.Z)
        st.aimPitch = clamp(math.asin(clamp(v.Y, -1, 1)), -0.06, 0.12)
      else   -- 直升机：镜头回到略往下看，机头不跟吊舱转
        st.camPitch, st.camYaw = -0.12, st.yaw
      end
    else
      st.zoom = 1
    end
    ownHide(on)
    eoApply()
    if G.playSound then G.playSound("quiet", nil, on and 1.5 or 1.2) end
  end
  G.flyEO = setEO

  ---------------------------------------------------------------- 开始 / 结束

  local function findEnt(id)
    local f = workspace:FindFirstChild("Ents")
    if not f then return nil end
    for _, em in ipairs(f:GetChildren()) do
      if em:GetAttribute("EntId") == id then return em end
    end
    return nil
  end

  local mapParams = RaycastParams.new()
  mapParams.FilterType = Enum.RaycastFilterType.Include
  local aimParams = RaycastParams.new()
  aimParams.FilterType = Enum.RaycastFilterType.Exclude

  local controls = nil
  task.spawn(function()
    local ok, res = pcall(function()
      local pm = require(me:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10))
      return pm:GetControls()
    end)
    if ok then controls = res end
  end)

  local function begin(vs)
    local em = findEnt(vs.id)
    if not em then return end
    local d = AD.get(vs.m)
    if not d then return end
    local cf = em.Root.CFrame
    local look = cf.LookVector
    local yaw = math.atan2(-look.X, -look.Z)
    local onGround = vs.ground == true
    st = { id = vs.id, em = em, d = d, pilot = vs.pilot == true, cf = cf, vel = V(), spd = 0, sink = 0, pr = 0, rr = 0, yr = 0,
      thr = onGround and 0 or 85, ground = onGround, gearWant = onGround and 1 or 0, gear = onGround and 1 or 0, rpm = (d.kind == "heli" and not onGround) and 100 or 0,
      yaw = yaw, hv = V(), vy = 0, tiltP = 0, tiltR = 0, camYaw = yaw, camPitch = -0.15, aimYaw = yaw, aimPitch = 0, c = {},
      load = vs.load or {}, wl = AD.groups(d, vs.load or {}), wi = 1, firing = false, trig = false, sendT = 0, lock = nil, lockT = 0, nextFire = 0,
      ty = 0, gp = 0, lastHv = V(), crashed = false, bay = 0, bayS = 0 }
    for i, wid in ipairs(st.wl) do   -- 默认选中第一种挂载（机炮一直在鼠标左键上）
      local w = AD.W[wid]
      if w and w.kind ~= "gun" then st.wi = i break end
    end
    if not onGround then   -- 空中出发：带着速度
      if d.kind == "jet" then st.spd = d.vMil * 0.8 else st.hv = look * d.vMax * 0.6 end
      st.vel = look * ((d.kind == "jet") and st.spd or d.vMax * 0.6)
    end
    -- 遥控无人机（服务器 vs.uav）：人在地上端着战术平板，画面是平板（Tablet.lua）；默认前视光电，右键 / V 换外部视角，Z 变焦
    st.uav = vs.uav == true and d.drone == true
    st.dcam, st.zoom, st.zoomS = st.uav and "nose" or nil, 1, 1
    G.fly, G.drive = st, st   -- G.drive：步兵的操作（Play）先停下
    -- 直升机按住 E 爬升：身边的「按 E」提示（上车、召唤位终端）先关掉，免得误触
    pcall(function() game:GetService("ProximityPromptService").Enabled = false end)
    cam.CameraType = Enum.CameraType.Scriptable
    panel.Visible = true
    -- 平板模式：面板挪进平板屏幕里（底边外壳上不放东西）
    local rect = G.tabletRect
    panel.Position = (st.uav and rect) and UDim2.new(0.5, 0, rect[4], -12) or UDim2.new(0.5, 0, 1, -24)
    if st.uav and G.tabletOpen then G.tabletOpen(st) end
    for _, l in ipairs(HUDS) do l.Visible = st.pilot end
    buildList()
    if touchUI then for _, f in ipairs(touchUI) do f.Visible = st.pilot end end
    local m = workspace:FindFirstChild("Map")
    mapParams.FilterDescendantsInstances = m and { m } or {}
    if G.playSound then G.playSound("capture") end
  end

  local function stop()
    pcall(function() game:GetService("ProximityPromptService").Enabled = true end)
    if st and st.trig then G.R.Drive:FireServer({ op = "trig", on = false }) end
    if G.gunLoop then G.gunLoop("me", nil, nil, false) end
    if st and st.eo then
      ownHide(false)
      st.eo = false
    end
    eoGui.Visible, eoCC.Enabled, eoHl.Enabled = false, false, false
    local old = st
    st = nil
    G.fly = nil
    G.hitMarkerAt = nil
    if G.drive == old then G.drive = nil end
    cam.CameraType = Enum.CameraType.Custom
    cam.FieldOfView = 70
    if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then UIS.MouseBehavior = Enum.MouseBehavior.Default end
    panel.Visible = false
    for _, l in ipairs(HUDS) do l.Visible = false end
    lockBox.Visible, lockText.Visible, pipper.Visible = false, false, false
    landMark.Visible, landText.Visible, restText.Visible = false, false, false
    if touchUI then for _, f in ipairs(touchUI) do f.Visible = false end end
    panel.Position = UDim2.new(0.5, 0, 1, -24)
    if old and old.uav and G.tabletClose then G.tabletClose() end
  end

  ---------------------------------------------------------------- 武器

  local function curW()
    local wid = st.wl[st.wi]
    return wid, wid and AD.W[wid]
  end
  -- 鼠标左键打的机炮（没有炮就是 nil）；F 打的挂载（选中的那种，选的是炮就用第一种挂载）——用户：F 控制导弹，鼠标控制机枪
  local function gunW()
    for _, wid in ipairs(st.wl) do
      local w = AD.W[wid]
      if w and w.kind == "gun" then return wid, w end
    end
    return nil
  end
  local function storeW()
    local wid, w = curW()
    if w and w.kind ~= "gun" then return wid, w end
    for _, wid2 in ipairs(st.wl) do
      local w2 = AD.W[wid2]
      if w2 and w2.kind ~= "gun" then return wid2, w2 end
    end
    return nil
  end
  -- 这种弹还剩几枚（S.veh.stores 是服务器的数，开火时本地先扣）
  local function left(wid)
    local w = AD.W[wid]
    if not w then return 0 end
    if w.kind == "gun" then return st.gunAmmo or 0 end
    local n = 0
    for i, s in ipairs(st.d.st or {}) do
      if st.load[i] == wid then n += (st.stores and st.stores[i]) or 0 end
    end
    return n
  end
  function G.flyNextWeapon()
    if not st or #st.wl == 0 then return end
    st.wi = st.wi % #st.wl + 1
    st.lock, st.lockT = nil, 0
  end
  -- 弹舱：选中的弹在哪个舱里，那个舱门就开着
  local function bayOf(wid)
    local main, side = false, false
    for i, s in ipairs(st.d.st or {}) do
      if st.load[i] == wid and s.bay then
        if s.bay == "main" then main = true else side = true end
      end
    end
    return main, side
  end

  -- 能锁的目标：敌方实体（空空弹打飞机，空地弹 / 炸弹打地面、海上的）
  local GROUND_KINDS = { veh = true, bot = true, fort = true, lcm = true, lcac = true, ship = true }
  local function candidates(w)
    local out = {}
    local f = workspace:FindFirstChild("Ents")
    if not f or not st then return out end
    local myTeam = me:GetAttribute("Side")
    local p0 = st.cf.Position
    for _, em in ipairs(f:GetChildren()) do
      local kind = em:GetAttribute("Kind")
      local root = em:FindFirstChild("Root")
      if root and em ~= st.em and em:GetAttribute("Team") ~= myTeam and not em:GetAttribute("Wreck") and (em:GetAttribute("Hp") or 1) > 0 then
        local ok = (w.kind == "aam") and kind == "air" or ((w.kind == "agm" or w.kind == "bomb") and GROUND_KINDS[kind])
        if ok then
          local to = root.CFrame.Position - p0
          local dist = to.Magnitude
          if dist < (w.range or 3200) and dist > 30 then table.insert(out, { em = em, id = em:GetAttribute("EntId"), dir = to.Unit, dist = dist, pos = root.CFrame.Position }) end
        end
      end
    end
    return out
  end
  -- 导引头视场：导弹看机头前方 cone 度；炸弹看飞机下前方（俯冲投弹也行）
  local function inCone(w, c)
    local fwd = st.cf.LookVector
    if w.kind == "bomb" then
      local down = (fwd * 0.6 + V(0, -1, 0)).Unit
      return down:Dot(c.dir) > math.cos(rad(w.cone or 60))
    end
    local cone = w.cone or 30
    if st.d.kind == "heli" and w.kind == "agm" then cone += 20 end
    return fwd:Dot(c.dir) > math.cos(rad(cone))
  end
  -- 鼠标瞄准方向（用户：准星也要能控制飞行方向，WASD 也不要动）：固定翼的鼠标想去的方向；光电吊舱、飞出作战区时自动驾驶也用它
  local function autoDir() return (CFrame.Angles(0, st.aimYaw, 0) * CFrame.Angles(st.aimPitch, 0, 0)).LookVector end
  -- 瞄准 / 挑目标的方向：固定翼是鼠标瞄准方向（手机上是机头），直升机是镜头（鼠标瞄机头炮塔）
  local function aimDirNow()
    if st.d.kind == "jet" then return G.mobile and st.cf.LookVector or autoDir() end
    return cam.CFrame.LookVector
  end
  -- 光电吊舱看着的方向（世界方向，鼠标转）；瞄准、挑目标用的方向：开着光电就是吊舱，不然是鼠标瞄准方向
  local function eoDir() return (CFrame.Angles(0, st.eoYaw or 0, 0) * CFrame.Angles(st.eoPitch or 0, 0, 0)).LookVector end
  local function lookDir() return st.eo and eoDir() or aimDirNow() end
  local function pickTarget(w, skip)
    local best, bs = nil, math.huge
    local want = lookDir()
    for _, c in ipairs(candidates(w)) do
      if inCone(w, c) and c.id ~= skip then
        local s = 1 - want:Dot(c.dir) + c.dist / 20000
        if s < bs then best, bs = c, s end
      end
    end
    return best
  end
  function G.flyNextTarget()
    if not st then return end
    local _, w = storeW()
    if not w or w.kind == "gun" or w.kind == "rkt" then return end
    local c = pickTarget(w, st.lock and st.lock.id)
    st.lock, st.lockT = c, 0
  end

  local function setTrig(on)
    -- 航炮声：按住扳机就一直响（循环一小段起爆声，一圈一发），打光了就停
    local loud = on and (st.gunAmmo or 0) > 0 and (not G.S or G.S.phase == "battle")
    if G.gunLoop and loud ~= (st.gunSnd == true) then
      st.gunSnd = loud
      G.gunLoop("me", st.d.gun, nil, loud)
    end
    if st.trig == on then return end
    st.trig = on
    G.R.Drive:FireServer({ op = "trig", on = on, aim = st.aimPt })
  end

  local function fireStore(wid, w)
    local t = os.clock()
    if t < st.nextFire or left(wid) <= 0 then return end
    if G.S and G.S.phase ~= "battle" then G.toast(T("air.notYet"), "info") return end
    local locked = st.lock and st.lockT >= (w.lockTime or 1)
    if w.kind == "aam" and not locked then G.toast(T("air.needLock"), "info") return end
    st.nextFire = t + ((w.kind == "rkt") and (w.rate or 0.12) or 0.4)
    G.R.Drive:FireServer({ op = "fire", w = wid, tgt = locked and st.lock.id or nil, aim = st.aimPt })
    for i in ipairs(st.d.st or {}) do   -- 本地先扣一枚（服务器的数随后推过来）
      if st.load[i] == wid and (st.stores[i] or 0) > 0 then
        st.stores[i] -= 1
        break
      end
    end
    -- 开火声按武器（Fx.lua 的 G.sfx）：导弹低沉的点火 + 呼啸、火箭弹「噗」一声 + 呼的一下、炸弹挂架弹开「咣」一声
    if G.sfx then G.sfx((w.kind == "rkt") and "rkt" or ((w.kind == "bomb") and "bombRel" or "msl"), nil, { vol = (w.kind == "rkt") and 0.7 or 0.8 }) end
  end

  ---------------------------------------------------------------- 物理：固定翼

  local function key(k) return UIS:IsKeyDown(k) end
  local function crash()
    if st.crashed then return end
    st.crashed = true
    G.R.Drive:FireServer({ op = "crash", hit = true })
    if G.shake then G.shake(1) end
  end

  local function jetPhysics(dt)
    local d = st.d
    -- 用户 11-18：W 向前加速、S 减速（地上收到零了接着按 S 就倒退），纯准心控制（鼠标给方向，自动压坡度、拉杆转过去），
    --   A / D 滚转（滚筒的时候不把准心拽回机头：松开以后接着往准心飞），转弯比原来稍迟钝一点；Shift / Ctrl 也还能推、收油门
    local up = key(Enum.KeyCode.W) or key(Enum.KeyCode.Up) or key(Enum.KeyCode.LeftShift) or key(Enum.KeyCode.RightShift) or (touch and touch.up)
    local dn = key(Enum.KeyCode.S) or key(Enum.KeyCode.Down) or key(Enum.KeyCode.LeftControl) or key(Enum.KeyCode.RightControl) or (touch and touch.down)
    st.thr = clamp(st.thr + ((up and 1 or 0) - (dn and 1 or 0)) * 55 * dt, 0, d.ab and 130 or 100)
    -- 自动收油门（真飞机拉平时自动油门收到慢车）：接地太快贴着跑道飘的时候不按 W 就自己往回收（按住 W 是复飞）
    if not up and os.clock() - (st.floatT or -9) < 0.3 then st.thr = math.max(0, st.thr - 55 * dt) end
    if st.out then st.thr = 0 end   -- 油烧干了：发动机熄火，只能滑翔
    local rev = st.ground and not st.cat and not st.trap and dn and st.thr <= 0.5   -- 地上油门收到底还按着 S：倒退（推出来、调头）
    local rollIn = (key(Enum.KeyCode.D) and 1 or 0) - (key(Enum.KeyCode.A) and 1 or 0)
    local yawIn, pitchIn = 0, 0   -- 纯准心控制：键盘不管俯仰、方向舵（手机上摇杆照旧当驾驶杆）
    if G.mobile and controls then   -- 手机：摇杆直接当驾驶杆（往前推是低头）
      local ok, mv = pcall(function() return controls:GetMoveVector() end)
      if ok and typeof(mv) == "Vector3" then
        if math.abs(mv.X) > 0.1 then rollIn = mv.X end
        if math.abs(mv.Z) > 0.1 then pitchIn = mv.Z end
      end
    end
    local cf = st.cf
    local fwd, upV, right = cf.LookVector, cf.UpVector, cf.RightVector
    -- 降落辅助（用户：把降落做好）：起落架放着、离地不到 45 格、底下是跑道 / 甲板 / 能落的地方——
    --   不按 A / D 就自动摆平机翼，贴近时把下沉率收到能落的范围（真飞机的拉平），见下面天上那段
    local landAid = nil
    if st.gear and st.gear > 0.9 and not st.ground then
      local p0 = cf.Position
      local gH = ground(p0.X, p0.Z)
      local agl = p0.Y - d.gearH - gH
      if agl < 45 and (gH > 0.4 or AD.onDeck(Map, p0.X, p0.Z) ~= nil) then landAid = math.max(agl, 0) end
    end
    st.landAid = landAid
    -- 速度：油门给目标速度（加力到 vAB），往目标加减速；爬升掉速、俯冲加速、拉杆转弯掉能量；地上没油门时滚着慢下来
    -- 重量感（用户：飞机驾驶没有重量感）：W 越大越「沉」——F-22、歼-20 约 1，A-10 约 2，轰-6K、B-2、MQ-9 是 3
    local W = math.clamp(220 / math.max(d.roll or 200, 1), 1, 3)
    -- 发动机有迟滞：推力跟着油门慢慢起来（加力点着要一下）
    st.thrE = approach(st.thrE or st.thr, st.thr, (st.thr > (st.thrE or 0) and 38 or 55) / W * dt)
    local thr = st.thrE
    local tgt = (thr <= 100) and d.vMil * thr / 100 or (d.vMil + (d.vMax - d.vMil) * (thr - 100) / 30)
    local acc = (thr > 100) and (d.accel + (d.abAccel or 0)) or d.accel
    -- 副油箱的阻力：最大速度、加速度都少几成；油多就重：加速慢（满内油 + 两个副油箱比一半内油重三成多）
    tgt *= 1 - (st.drag or 0)
    acc *= (1 - (st.drag or 0)) / (st.heavy or 1)
    if rev then tgt = -12 end   -- 倒退：慢慢往后滑（约 4 米 / 秒）
    -- 进近自动油门（真飞机的速度保护 / 迎角地板）：起落架放着在天上，速度不掉到 1.2 倍失速以下——
    --   油门收太多也不至于失速、掉在跑道前面的海里（收起落架就没有这个保护）
    local apc = st.gear > 0.9 and not st.ground and not st.out and tgt < d.stall * 1.2
    if apc then tgt = d.stall * 1.2 end
    st.apc = apc
    -- 地上滑跑：推力要先克服整架飞机的重量和轮子的阻力，加速度只有天上的四分之一（战斗机滑跑两三百米、轰炸机五百米上下，
    --   一推油门不再四五十米就飞起来；弹射器单独算）
    if st.ground and not st.cat then acc *= 0.25 end
    if st.trap then   -- 挂着拦阻索：发动机推力不算，地上那段按拦阻索减速
    -- 地上减速：B 刹车 70；油门收到底自动刹车 36（落地滑跑五六秒停住，不用一直按 B）；带着点油门滑行只有轮子阻力 22
    elseif tgt > st.spd then st.spd += math.min(tgt - st.spd, acc * dt)
    else st.spd -= math.min(st.spd - tgt, (st.ground and ((key(Enum.KeyCode.B) and 70) or (st.thr < 5 and 36) or 22) or acc * 0.45) * dt) end
    if not st.ground then
      local vd = st.vdir or fwd
      st.spd -= GR * vd.Y * 0.9 * dt   -- 沿航迹爬升掉速、俯冲加速（拉杆掉的能量在下面按过载算：诱导阻力）
    end
    if st.trig and (st.gunAmmo or 0) > 0 then st.spd -= 5 * dt end   -- 航炮的后坐：开火时掉一点速度（30 毫米炮的后坐力有几吨）
    st.spd = clamp(st.spd, (st.ground and not st.cat) and -12 or 0, d.vMax * 1.3)
    local q = clamp((st.spd - d.stall * 0.4) / d.stall, 0.12, 1)   -- 舵效：慢了舵不灵
    -- 想怎么转（用户 11-18：方向只听鼠标准心，A / D 滚转不把准心拽回）：纯准心控制——像《战争雷霆》的教官，鼠标给想去的方向，
    --   自动压坡度让准心落到升力方向上、按偏差要过载（拉杆）转过去；按着 A / D 时滚转听键盘，俯仰照旧往准心拉
    --   飞机本身按升力物理飞（用户：操作感像玩具）：教官给的是「要几个 g」，飞控找迎角、升力带着航迹转，机头先抬、航迹慢半拍，拉得狠掉速；
    --   手机上摇杆当驾驶杆：往后拉要过载、松杆 1 g，坡度 33° 以内补一点杆保高度
    local bank = math.asin(clamp(right.Y, -1, 1))
    local upright = upV.Y > 0.3   -- 没倒飞、没在翻筋斗
    local nCmd, rc, yc
    if G.mobile then
      local pull = -pitchIn   -- 往后拉为正
      nCmd = (pull >= 0) and (1 + pull * (d.g - 1)) or (1 + pull * 3)   -- 推杆到 −2 g
      if pitchIn == 0 and upright and not st.ground then
        local phi = math.min(math.abs(bank), rad(75))
        nCmd = 1 + (1 / math.cos(phi) - 1) * (1 - Map.smooth(rad(33), rad(60), phi))
      end
      rc, yc = rollIn * rad(d.roll), yawIn * rad(d.yaw) * 0.6
      if landAid and rollIn == 0 then rc = clamp(bank * 2.5, -1, 1) * rad(d.roll) end   -- 贴着跑道 / 甲板：机翼自动摆平
    else
      local aim = autoDir()
      local l = cf:VectorToObjectSpace(aim)
      local fz = -l.Z
      local off = math.acos(clamp(fz, -1, 1))
      local w = Map.smooth(rad(2), rad(10), off)
      local toTarget = math.atan2(l.X, l.Y)   -- 让目标落到机头正上方（升力方向）要滚多少
      if fz < -0.2 and math.abs(l.X) < 0.15 then toTarget = 0 end   -- 目标在正后方偏一点点：先拉起来（筋斗），别来回滚
      local level = clamp(bank * 2.5, -1, 1)   -- 摆平机翼的滚转（bank 右翼抬起为正，rc 为正往右滚）
      local vd0 = st.vdir or cf.LookVector
      -- 准心相对航迹偏左 / 右多少（世界坐标里水平量，右为正）
      local vdH = V(vd0.X, 0, vd0.Z)
      local aimH = V(aim.X, 0, aim.Z)
      local psi = 0
      if vdH.Magnitude > 1e-3 and aimH.Magnitude > 1e-3 then
        vdH, aimH = vdH.Unit, aimH.Unit
        psi = math.atan2(aimH:Dot(V(-vdH.Z, 0, vdH.X)), aimH:Dot(vdH))
      end
      -- 降落辅助：离地 30 格以内拉平——航迹最陡只到下沉 6～14 格 / 秒（越低越平），准心压得再低也不往跑道上扎
      --   （原来下面只把航迹托平、机头照样压向准心，接地时机头朝下二十度判摔）：把要去的方向抬到这个下滑角
      --   准心不在前方 45° 以内（飞过了瞄的那一点、准心落到身后）就顺着现在的航向拉平，不往回拽
      local aimL = aim
      local flare = landAid and landAid < 30 and vdH.Magnitude > 0.5
      if flare then
        local gMin = -math.asin(clamp((6 + 8 * math.min(landAid, 25) / 25) / math.max(st.spd, 30), 0, 1))
        local ahead = aimH.Magnitude > 0.5 and aimH:Dot(vdH) > 0.7
        local gA = math.asin(clamp(aim.Y, -1, 1))
        if not ahead or gA < gMin then
          local g2 = ahead and math.max(gA, gMin) or gMin
          aimL = (ahead and aimH or vdH.Unit) * math.cos(g2) + V(0, math.sin(g2), 0)
        end
      end
      -- 机体的升力方向（垂直于航迹）
      local lh = upV - vd0 * vd0:Dot(upV)
      lh = (lh.Magnitude > 1e-3) and lh.Unit or upV
      -- 准心在机头下方不远（下滑、进近、对准跑道；放着起落架时 35° 以内，平时 15° 以内）：不翻过去「把目标滚到头顶再拉」
      --   （原来准心压到机头下面十度就整架翻过来，测试里进近时坡度一下子到 79°）；也不能只按机体坐标往目标那侧滚（机身一歪，
      --   下面的目标在机体坐标里就跑到低的那侧机翼，越滚越歪）——按升力矢量算：航迹要往准心那边转多快 → 要多大的加速度，
      --   加上抵消重力那份，就是升力该有的方向和大小；滚到那个方向、拉那么多 g。往下最多 0.8 g（一直是正过载，不翻过去），
      --   放着起落架时左右最多 0.58 g（坡度 30° 以内）；准心压得更低的照旧滚过去拉（俯冲攻击）
      local gentle = flare or (l.Y < 0 and (off < rad(15) or (st.gear > 0.9 and off < rad(35))))
      local nGentle, gentleW = nil, 0
      if gentle then
        toTarget = 0
        local ang = math.acos(clamp(vd0:Dot(aimL), -1, 1))
        local ev = aimL - vd0 * vd0:Dot(aimL)
        local aDes = (ev.Magnitude > 1e-4) and ev.Unit * math.min(ang * 2.1, rad(d.pitch)) * math.max(st.spd, 30) or V()
        local dnP = V(0, -1, 0) - vd0 * (-vd0.Y)   -- 垂直于航迹、朝下
        if dnP.Magnitude > 1e-3 then
          dnP = dnP.Unit
          local sdP = vd0:Cross(dnP)   -- 垂直于航迹的水平方向
          local cD, cS = aDes:Dot(dnP), aDes:Dot(sdP)
          local sMax = ((st.gear > 0.9) and 0.58 or 4) * GR
          aDes = dnP * math.min(cD, 0.8 * GR) + sdP * clamp(cS, -sMax, sMax)
        end
        local aL = aDes - (V(0, -GR, 0) - vd0 * (-GR * vd0.Y))   -- 升力要给的加速度 = 想要的 − 重力（垂直于航迹那份）
        local lhat = (aL.Magnitude > 1e-3) and aL.Unit or lh
        local th = math.atan2(vd0:Dot(lh:Cross(lhat)), lh:Dot(lhat))   -- 升力方向要绕航迹转多少（正：往右滚）
        -- 偏得很少（10° 以内，平时打仗修一点点方向）跟原来一样以摆平机翼为主，不为了几度就压个大坡度；拉平时全按升力矢量
        local wg = flare and 1 or w
        rc = (wg * clamp(th * 2.5, -1, 1) + (1 - wg) * level) * rad(d.roll)
        nGentle = math.max(aL:Dot(lh), 0) / GR
        gentleW = wg
      else
        rc = (w * clamp(toTarget * 3.2, -1, 1) + (1 - w) * level) * rad(d.roll)
      end
      -- 贴着跑道 / 甲板：机翼自动摆平，只留几度坡度对准跑道
      if landAid and rollIn == 0 then rc = clamp((bank + clamp(psi * 1.5, -rad(8), rad(8))) * 2.5, -1, 1) * rad(d.roll) end
      -- 俯仰按航迹（速度方向）对准心：机头比航迹高一个迎角，按机头对准心的话平飞会一直往下掉
      local pz, py = aimL:Dot(vd0), aimL:Dot(lh)
      local pe = math.atan2(py, math.max(pz, 0.05))
      if pz < 0 then pe = (py >= 0) and math.pi / 2 or -math.pi / 2 end
      local pc = clamp(pe * 2.1, -1, 1) * rad(d.pitch)   -- 增益再低一点（用户 11-18 两次：转弯稍微多一些迟钝感、再笨重一点）
      if math.abs(toTarget) > rad(100) and off > rad(25) then pc = math.min(pc, rad(d.pitch) * 0.15) end   -- 还没滚过去别乱拉
      local nPe = 1 + pc * math.max(st.spd, 30) / GR
      nCmd = nGentle and (gentleW * nGentle + (1 - gentleW) * math.max(nPe, 0)) or nPe
      yc = 0
      if rollIn ~= 0 then rc = rollIn * rad(d.roll) end
    end
    st.nCmd = clamp(nCmd, -2, d.g / math.sqrt(st.heavy or 1))   -- 重了拉不了那么多 g
    st.yawCmd = yc * q
    st.rr = approach(st.rr, rc * q, rad(d.roll) * 2.2 / W ^ 0.5 * dt)   -- 滚转有惯性：重的起来慢（2.8 → 2.2：用户说再笨重一点）
    if st.ground then st.rr, st.yr = 0, 0 end
    st.c.pit, st.c.rol, st.c.yaw = clamp(st.pr / math.max(rad(d.pitch), 1e-3), -1, 1), clamp(st.rr / math.max(rad(d.roll), 1e-3), -1, 1), clamp(st.yr / math.max(rad(d.yaw), 1e-3), -1, 1)
    local pos = cf.Position
    if st.ground and st.cat then
      -- 航母弹射器：卡上以后原地不动，油门推满按空格（手机：推满等一秒半）沿轨道加速，冲到舰艏就离舰
      local start, dir, len = AD.cat(Map, st.cat.i)
      if st.cat.state == "hooked" then
        st.spd = 0
        st.yaw = math.atan2(-dir.X, -dir.Z)
        pos = start + V(0, d.gearH, 0)
        cf = CFrame.lookAt(pos, pos + dir)
        st.cat.full = (st.thr >= 90) and ((st.cat.full or 0) + dt) or 0
        if st.thr >= 90 and st.cat.full > 1.2 and (st.foldK or 0) < 0.02 then   -- 推满油门一会儿就弹（空格改成下飞机了）；机翼还没展开完不弹
          st.cat.state, st.cat.s, st.cat.v = "launch", 0, 0
          if G.shake then G.shake(0.4) end
          if G.playSound then G.playSound("boom", pos, 1.6) end
        end
      else
        local vEnd = math.max(d.vRot * 1.2, d.stall * 1.35)
        st.cat.v += vEnd * vEnd / (2 * len) * dt
        st.cat.s += st.cat.v * dt
        st.spd = st.cat.v
        if st.cat.s >= len then   -- 离舰
          st.ground, st.cat = false, nil
          st.pr = rad(5)
          pos = start + dir * len + V(0, d.gearH + 1, 0)
          cf = CFrame.lookAt(pos, pos + dir) * CFrame.Angles(rad(5), 0, 0)
        else
          pos = start + dir * st.cat.s + V(0, d.gearH, 0)
          cf = CFrame.lookAt(pos, pos + dir)
          st.steamT = (st.steamT or 0) - dt
          if st.steamT <= 0 and G.fxPart then   -- 弹射轨道上一路冒白汽
            st.steamT = 0.05
            local s2 = G.fxPart(Enum.PartType.Ball, V(3, 3, 3), CFrame.new(pos - V(0, d.gearH - 0.5, 0)), RGB(236, 236, 232), Enum.Material.SmoothPlastic, 0.35)
            if G.tween then G.tween(s2, 1.4, { Size = V(9, 9, 9), Transparency = 1 }) end
            game:GetService("Debris"):AddItem(s2, 1.5)
          end
        end
      end
      st.vel = cf.LookVector * st.spd
      st.vdir, st.accV = cf.LookVector, nil
      st.sink = 0
    elseif st.ground then
      -- 地上：机头只能左右转（前轮转向：A / D、Q / E，或者鼠标往哪边），速度够了按 S 抬头（或者鼠标往上抬）就离地
      local aimG = autoDir()
      local lg = cf:VectorToObjectSpace(aimG)
      local steer = G.mobile and 0 or clamp(math.atan2(lg.X, math.max(-lg.Z, 0.05)) * 1.5, -1, 1)
      if yawIn ~= 0 or rollIn ~= 0 or G.mobile then steer = (yawIn ~= 0) and yawIn or rollIn end
      local sk = (st.spd >= 0) and clamp(st.spd / 25, 0.15, 1) or -clamp(-st.spd / 25, 0.15, 0.5)   -- 倒退时前轮转向反过来
      st.yaw -= steer * rad(30) * sk * dt
      -- 航母甲板：没上弹射器滑不快（起飞要靠弹射器）；挂上拦阻索的一路被拉停
      local deck = AD.onDeck(Map, pos.X, pos.Z)
      if st.trap then
        st.spd = math.max(0, st.spd - st.trapA * dt)
        if st.spd < 1 then st.trap = nil end
      elseif deck == "carrier" then
        st.spd = math.min(st.spd, AD.TAXI)
      end
      -- 滑到弹射器起点、机头对正、速度慢：卡上
      if deck == "carrier" and d.carrier and not st.trap and st.spd < 15 then
        local look0 = V(-math.sin(st.yaw), 0, -math.cos(st.yaw))
        for i = 1, #AD.CATS do
          local start, dir = AD.cat(Map, i)
          local rel = V(pos.X - start.X, 0, pos.Z - start.Z)
          local along = rel:Dot(dir)
          local lat = (rel - dir * along).Magnitude
          if math.abs(along) < 12 and lat < 7 and look0:Dot(dir) > math.cos(rad(25)) then
            st.cat = { i = i, state = "hooked" }
            if G.playSound then G.playSound("capture", pos) end   -- 卡上：咔一声，不出字
            break
          end
        end
      end
      local look = V(-math.sin(st.yaw), 0, -math.cos(st.yaw))
      pos += look * st.spd * dt
      local g = ground(pos.X, pos.Z)
      local wantUp = pitchIn < -0.3 or (not G.mobile and aimG.Y > math.sin(rad(3)))
      if st.spd >= d.vRot and wantUp then   -- 离地
        st.ground = false
        st.pr = rad(6)
        cf = CFrame.lookAt(pos + V(0, 0.5, 0), pos + V(0, 0.5, 0) + look) * CFrame.Angles(rad(4), 0, 0)
      elseif pos.Y - d.gearH > g + 2.5 then   -- 冲出甲板 / 跑道尽头：掉下去
        st.ground = false
        cf = CFrame.lookAt(pos, pos + look)
      else
        pos = V(pos.X, g + d.gearH, pos.Z)
        cf = CFrame.lookAt(pos, pos + look)
      end
      st.vel = look * st.spd
      st.vdir, st.accV = (st.ground and look) or cf.LookVector, nil
      st.sink = 0
    else
      -- 天上（用户：很像玩具——原来航迹直接被拉向机头，压坡度不拉杆就不转）：按真飞机的道理——
      --   升力 ∝ 速度² × 迎角，方向垂直于航迹、在机翼的上方；压坡度升力就斜过去，带着航迹转弯（竖直的那份不够重力就掉高度）；
      --   失速速度上用最大迎角正好 1 g，再慢就托不住；过了失速迎角升力往下掉。拉得越狠诱导阻力越大（∝ 过载² / 速度²），掉速
      --   飞控：要 nCmd 个 g 需要多大迎角（限在最大迎角里），机体俯仰角速度 = 航迹转的角速度 + 把迎角往要的那个收（零点几秒）
      cf = cf * CFrame.Angles(st.pr * dt, -st.yr * dt, -st.rr * dt)
      local fw, upB, rtB = cf.LookVector, cf.UpVector, cf.RightVector
      local spd = math.max(st.spd, 1)
      local vd = st.vdir or fw
      local aoa = math.atan2(-vd:Dot(upB), math.max(vd:Dot(fw), 0.05))
      local beta = math.asin(clamp(vd:Dot(rtB), -1, 1))
      local aMax = rad(d.aoaMax or 24)
      local ka = GR / (d.stall * d.stall * aMax) * spd * spd
      local function liftOf(a)
        if a > aMax then return ka * aMax * math.max(0.35, 1 - (a - aMax) / aMax * 1.5) end
        if a < -aMax * 0.6 then return -ka * aMax * 0.6 end
        return ka * a
      end
      local lhat = upB - vd * vd:Dot(upB)
      lhat = (lhat.Magnitude > 1e-3) and lhat.Unit or upB
      local gv = V(0, -GR, 0)
      local gPerp = gv - vd * vd:Dot(gv)
      local L = liftOf(aoa)
      local aNeed = clamp((st.nCmd or 1) * GR / math.max(ka, 1e-3), -aMax * 0.5, aMax * 0.95)
      local pc = (L + gPerp:Dot(lhat)) / spd + (aNeed - aoa) * 5
      pc = clamp(pc, -rad(d.pitch) * 0.7, rad(d.pitch))
      st.pr = approach(st.pr, pc, rad(d.pitch) * 3.2 / W ^ 0.8 * dt)   -- 转动惯量：零点几秒角速度才起来，重的更慢（4 → 3.2：再笨重一点）
      st.yr = approach(st.yr, clamp(beta * 3, -rad(d.yaw), rad(d.yaw)) + (st.yawCmd or 0), 1.5 / W ^ 0.6 * dt)   -- 自动协调：侧滑往零收
      local aPerp = lhat * L + gPerp - rtB * vd:Dot(rtB) * spd * 1.5   -- 升力 + 重力（垂直于航迹那份）+ 侧滑的侧力
      vd = vd + aPerp / spd * dt
      st.vdir = (vd.Magnitude > 1e-3) and vd.Unit or fw
      -- 降落辅助：离地 25 格以内把下沉率收到 6～14 格 / 秒（越低越小）——真飞机接地前的拉平（加上地效）；
      --   玩家把准心压在跑道上、速度别太快就落得住（原来照直往下扎，下沉过了 24 格 / 秒就判摔）
      if landAid and landAid < 25 and st.vdir.Y < 0 then
        local vyT = -(6 + 8 * landAid / 25) / spd
        if st.vdir.Y < vyT then
          local h = V(st.vdir.X, 0, st.vdir.Z)
          if h.Magnitude > 1e-3 then
            local vy = approach(st.vdir.Y, vyT, 1.2 * dt)
            st.vdir = h.Unit * math.sqrt(math.max(0, 1 - vy * vy)) + V(0, vy, 0)
          end
        end
      end
      local n = L / GR
      st.gLoad = n
      st.aoaDeg = math.deg(aoa)
      st.spd = math.max(0, st.spd - 0.33 * GR * n * n * (d.stall / spd) ^ 2 * dt)   -- 诱导阻力
      st.sink = 0
      local v0 = st.vel
      st.vel = st.vdir * st.spd
      if v0 then   -- 加速度（镜头用：过载把镜头甩开）
        local acc = (st.vel - v0) / math.max(dt, 1e-3)
        st.accV = (st.accV or acc):Lerp(acc, math.min(1, dt * 6))
      end
      pos += st.vel * dt
      cf = cf - cf.Position + pos
      -- 撞地 / 落地
      local g = ground(pos.X, pos.Z)
      if pos.Y - d.gearH <= g + 0.3 then
        local fw = cf.LookVector
        local bank = math.abs(deg(math.asin(clamp(cf.RightVector.Y, -1, 1))))
        local pitch = deg(math.asin(clamp(fw.Y, -1, 1)))
        local deckK = AD.onDeck(Map, pos.X, pos.Z)
        local landable = g > 0.4 or deckK ~= nil
        -- 用户：把降落做好——姿态放宽一点（下沉 30 格 / 秒、坡度 25°、俯仰 −10°～25° 以内）；
        --   姿态对、只是太快（1.5 倍着陆速度以内）：不摔，贴着跑道飘（地效托着、落不下去），提示收油门，慢到能落了就接地；
        --   航母上尾钩放着、飘过拦阻索区照样挂上（真舰载机是全推力着舰、靠拦阻索拉停）
        local attOk = st.gear > 0.9 and landable and st.vel.Y > -30 and bank < 25 and pitch > -10 and pitch < 25
        local hookOk = deckK == "carrier" and (st.c.hook or 0) > 0.5 and AD.inWires(Map, pos.X, pos.Z)
        if attOk and st.spd >= d.landMax and st.spd < d.landMax * 1.5 and not hookOk then
          pos = V(pos.X, g + d.gearH + 0.5, pos.Z)
          st.vdir = V(st.vdir.X, math.max(st.vdir.Y, 0), st.vdir.Z).Unit
          st.spd = math.max(0, st.spd - 14 * dt)   -- 地效 + 拉平的迎角：比空中多掉一点速度
          st.vel = st.vdir * st.spd
          cf = cf - cf.Position + pos
          st.floatT = os.clock()
        elseif attOk and (st.spd < d.landMax or (hookOk and st.spd < d.landMax * 1.5)) then
          st.ground = true
          st.yaw = math.atan2(-fw.X, -fw.Z)
          pos = V(pos.X, g + d.gearH, pos.Z)
          cf = CFrame.lookAt(pos, pos + V(fw.X, 0, fw.Z))
          st.sink, st.pr, st.rr, st.yr = 0, 0, 0, 0
          -- 接地：不按 W 就自动收到慢车（地上油门收到底就自动刹车，五六秒停住、停稳补给）；按住 W 是连续起降
          if not up and st.thr <= 100 then st.thr = 0 end
          if G.shake then G.shake(0.15) end
          -- 航母：尾钩放着、落在拦阻索区，被拦阻索拉停（85 格内停住）
          if AD.onDeck(Map, pos.X, pos.Z) == "carrier" and (st.c.hook or 0) > 0.5 and AD.inWires(Map, pos.X, pos.Z) then
            st.trap, st.trapA = true, math.max(20, st.spd * st.spd / (2 * 85))
            if G.shake then G.shake(0.5) end
          end
        else
          crash()
        end
      end
    end
    st.cf = cf
    -- 起落架（用户：起飞自动把起落架收了）：离地爬过 15 米、还在往上爬就自动收一次；这次起飞只收一次，之后按 G 放下就听玩家的；
    --   地上一直放着，落地重置
    if st.ground then
      st.gearWant, st.gearAuto = 1, false
    elseif not st.gearAuto and st.gearWant > 0.5 and st.vel and st.vel.Y > 0.5 then
      local p0 = cf.Position
      if p0.Y - d.gearH - math.max(ground(p0.X, p0.Z), 0) > 15 * AD.M then
        st.gearAuto, st.gearWant = true, 0
        if G.toast then G.toast(T("coach.gearAuto"), "info") end
      end
    end
    st.gear = approach(st.gear, st.gearWant, dt / 2.5)
    st.c.gear = st.gear
    st.c.thr = st.thr
    st.c.flap = (st.gear > 0.5 and st.spd < d.stall * 1.6) and 1 or 0
    st.c.can = (st.ground and st.thr < 5 and st.spd < 3) and 1 or 0
    -- 折翼（用户：飞机机翼折叠没有动画）：原来直接 0 / 1 一下就折好；现在约 4 秒折起 / 展开（真机十几秒，游戏里缩短），
    --   一上来就停在甲板上的直接是折着的；推油门就开始展开，展开完才能弹射
    local foldWant = (d.fold and st.ground and st.thr < 5 and st.spd < 3 and AD.onDeck(Map, pos.X, pos.Z)) and 1 or 0
    if st.foldK == nil then st.foldK = foldWant end
    st.foldK = approach(st.foldK, foldWant, dt / 4)
    st.c.fold = st.foldK
    st.c.hook = (d.gear and d.gear.hook and st.gear > 0.9 and not st.ground) and 1 or 0
    st.c.brk = (key(Enum.KeyCode.B)) and 1 or 0
    st.c.rpm = st.thr
  end

  ---------------------------------------------------------------- 物理：直升机

  -- 直升机（用户：直升机操作感觉不太真实）：按真直升机的道理飞——旋翼拉力沿桨盘法线，桨盘往哪倾就往哪加速：
  --   W / S 前推后拉驾驶杆（低头加速、抬头减速 / 后退）；姿态有惯性（二阶弹簧），松杆自动回平；
  --   低速（悬停附近）松杆时自动往反方向带一点把飘移收住，快的时候松杆就保持平飞、靠阻力慢慢减速（要停下来得抬头拉一下）；
  --   E / Q 总距（E 升、Q 降）：拉力大小（同样的总距，机身一倾、竖直方向的拉力就小了，会掉高度）；不按时自动把升降速度收到 0（定高）；
  --   A / D 脚蹬：偏航角速度，有惯性；速度上来以后压坡度就会转弯（协调转弯），尾翼让机头顺着来流（风标效应）；
  --   平移升力（二十几格每秒以上旋翼效率高一点）、地效（离地一个旋翼直径以内托得更稳）；最高平飞速度、爬升率照型号表
  local function heliPhysics(dt)
    local d = st.d
    if st.out then st.rpm = approach(st.rpm, 72, 9 * dt) else st.rpm = approach(st.rpm, 100, 22 * dt) end   -- 旋翼转起来要四五秒；熄火后靠气流自转，转速掉下来
    local lift = st.rpm >= 92
    local auto = st.out and not st.ground   -- 熄火自转下滑：还能往前飘一点，快落地时拉总距（空格）下沉慢一些
    -- 用户：桨盘对着哪里往哪飞（按受力算，要有物理引擎的感觉），准心决定机头朝向——
    --   鼠标转准心（镜头），机头跟着准心转：尾桨有惯性，最快 d.yaw 度 / 秒，起转、停住都要一会儿（按住 Alt 自由看，机头不跟）
    --   W / S 桨盘前倾 / 后仰（往前飞 / 带杆刹车、倒飞），A / D 桨盘左右倾（侧飞）；E 升、Q 降（Ctrl / C 也降）；空格下飞机
    --   拉力顺着桨盘法线：倾得越多水平推力越大、往上托的越少（猛一推杆先掉一点高度）；速度有惯性，松杆桨盘回平但人还往前冲，靠阻力慢慢停
    --   快速前飞时转机头，桨盘自动往那边压坡度（协调转弯），航迹跟着机头弯过去；侧面阻力大，侧飞快不起来
    local fwdIn = (key(Enum.KeyCode.W) and 1 or 0) - (key(Enum.KeyCode.S) and 1 or 0)
    local sideIn = (key(Enum.KeyCode.D) and 1 or 0) - (key(Enum.KeyCode.A) and 1 or 0)
    local yawIn = 0
    local upIn = ((key(Enum.KeyCode.E) or (touch and touch.up)) and 1 or 0)
      - ((key(Enum.KeyCode.Q) or key(Enum.KeyCode.LeftControl) or key(Enum.KeyCode.C) or (touch and touch.down)) and 1 or 0)
    if G.mobile and controls then
      local ok, mv = pcall(function() return controls:GetMoveVector() end)
      if ok and typeof(mv) == "Vector3" then
        if math.abs(mv.Z) > 0.1 then fwdIn = -mv.Z end
        if math.abs(mv.X) > 0.1 then yawIn, sideIn = mv.X, 0 end   -- 手机没有鼠标：摇杆左右转机头
      end
    end
    local GS = GR or 27.5
    local heavy = st.heavy or 1
    local maxT = rad(d.tilt)
    local f = V(-math.sin(st.yaw), 0, -math.cos(st.yaw))
    local r = V(math.cos(st.yaw), 0, -math.sin(st.yaw))
    local hv = st.hv
    local spd = hv.Magnitude
    local vf, vr = hv:Dot(f), hv:Dot(r)
    local g0 = ground(st.cf.Position.X, st.cf.Position.Z)
    local agl = st.cf.Position.Y - d.gearH - math.max(g0, 0)
    -- 机头：朝准心（镜头方位）转，角速度有上限、有角加速度（尾桨）；在地上转速够了才能原地慢慢转
    local maxR = rad(d.yaw)
    local yrWant
    if G.mobile then
      yrWant = -yawIn * maxR
    else
      yrWant = clamp(angDiff(st.yaw, st.noseYaw or st.camYaw) * 3.2, -maxR, maxR)
    end
    if st.ground then yrWant *= (lift and 0.3 or 0) end
    st.yr = approach(st.yr or 0, yrWant, maxR * 2.6 * dt)
    st.yaw += st.yr * dt
    -- 驾驶杆 → 桨盘想要的倾角（俯仰：负的是低头 = 往前倾）；松杆桨盘回平
    local tP = -fwdIn * maxT
    local tR = sideIn * maxT * 0.8
    -- 往前飞得快时转机头：桨盘自动压坡度——要的侧向加速度 = 转弯的向心那份（速度 × 角速度）+ 消掉侧滑的那份（没按 A / D 时），
    --   tan 坡度 = 侧向加速度 / g；坡度给的侧向力把航迹拉着跟机头弯过去（压不过来的那一截就是侧滑，靠侧面阻力慢慢吃掉）
    if not st.ground then
      local aLat = spd * -st.yr - ((sideIn == 0) and vr * 0.8 or 0)
      tR += clamp(math.atan(aLat / GS), -maxT, maxT) * smooth(12, 40, vf)
    end
    tP, tR = clamp(tP, -maxT, maxT), clamp(tR, -maxT, maxT)
    if st.ground then tP, tR = 0, 0 end
    -- 桨盘姿态：二阶弹簧（有惯性、接近临界阻尼，一秒左右到位）
    st.pR = (st.pR or 0) + ((tP - st.tiltP) * 12 - (st.pR or 0) * 6.5) * dt
    st.rR = (st.rR or 0) + ((tR - st.tiltR) * 12 - (st.rR or 0) * 6.5) * dt
    st.tiltP += st.pR * dt
    st.tiltR += st.rR * dt
    -- 拉力：总距（松开时慢慢稳住升降，不替你补桨盘倾斜少掉的那份；停在地上时放到底）× 平移升力 × 地效
    local colWant = upIn
    if upIn == 0 then colWant = clamp(-st.vy * 0.05, -0.6, 0.6) end
    if st.ground and upIn <= 0 then colWant = -0.5 end
    if upIn < 0 and agl < 25 then colWant = -0.45 end   -- 快到地面了：下降慢一点（落地不摔）
    st.col = approach(st.col or 0, colWant, dt * 1.6)
    local k = d.climb * 0.6 / GS / heavy   -- 满总距的爬升率 ≈ 型号表 climb
    local etl = 1 + 0.08 * smooth(16, 36, spd)
    local ige = 1 + 0.1 * (1 - clamp(agl / ((d.rotor and d.rotor.r or 20) * 2), 0, 1))
    local Tm
    if auto then Tm = GS * (0.74 + 0.3 * math.max(upIn, 0))
    elseif not lift then Tm = GS * (st.rpm / 100) * 0.8
    else Tm = GS * (1 + st.col * k) * etl * ige end
    local cfA = CFrame.Angles(0, st.yaw, 0) * CFrame.Angles(st.tiltP, 0, -st.tiltR)
    local up = cfA.UpVector
    -- 阻力（按机身方向分开算）：前后流线——桨盘前倾到底、拉力托住重量时正好飞到型号表的 vMax；侧面大得多，侧飞四十几格每秒就到头；
    --   悬停附近多一点（好稳住，不然松杆飘半天）
    local clF = 0.05 + 0.1 * (1 - smooth(6, 30, spd))
    local cq = math.max(1e-5, (GS * math.tan(maxT) - 0.05 * d.vMax) / (d.vMax * d.vMax)) * (1 + (st.drag or 0))
    st.lastHv = hv
    local acc = V(up.X, 0, up.Z) * Tm - f * (vf * (clF + cq * math.abs(vf))) - r * (vr * (clF * 2 + cq * 3 * math.abs(vr)))
    if st.ground then acc = V() hv *= math.max(0, 1 - 5 * dt) end
    st.hv = hv + acc * dt
    st.vy += (Tm * up.Y - GS - st.vy * 0.5) * dt
    -- 合速度不超过服务器认的（往下冲时重力也在加速）
    local v3 = st.hv + V(0, st.vy, 0)
    local cap = d.vMax * 1.3
    if v3.Magnitude > cap then
      v3 = v3.Unit * cap
      st.hv, st.vy = V(v3.X, 0, v3.Z), v3.Y
    end
    local pos = st.cf.Position + (st.hv + V(0, st.vy, 0)) * dt
    local g = ground(pos.X, pos.Z)
    if pos.Y - d.gearH <= g then
      local overSea = g <= 0.4 and not AD.onDeck(Map, pos.X, pos.Z)
      if (st.vy < -30 or overSea) and not st.ground and not st.crashed then crash() end
      pos = V(pos.X, g + d.gearH, pos.Z)
      st.vy = math.max(st.vy, 0)
      st.ground = upIn <= 0 and Tm * up.Y <= GS * 1.02
      if st.ground then st.hv *= math.max(0, 1 - 5 * dt) end
    else
      st.ground = false
    end
    st.cf = CF(pos) * CFrame.Angles(0, st.yaw, 0) * CFrame.Angles(st.tiltP, 0, -st.tiltR)
    st.vel = st.hv + V(0, st.vy, 0)
    -- 动画通道：驾驶杆（桨盘跟着倾）、脚蹬（尾桨）、总距
    st.c.pit = approach(st.c.pit or 0, clamp(-tP / maxT, -1, 1), dt * 4)
    st.c.rol = approach(st.c.rol or 0, clamp(tR / maxT, -1, 1), dt * 4)
    st.c.yaw, st.c.col = clamp(-st.yr / maxR, -1, 1), clamp(st.col, -1, 1)
    st.c.rpm, st.c.thr, st.c.gear = st.rpm, st.rpm, 1
  end

  ---------------------------------------------------------------- 输入

  UIS.InputBegan:Connect(function(io, gp)
    if gp or not st then return end
    local k = io.KeyCode
    if k == Enum.KeyCode.Space then G.R.Drive:FireServer({ op = "exit" }) return end   -- 用户：空格键脱离载具（在天上就跳伞）
    if not st.pilot then return end
    if io.UserInputType == Enum.UserInputType.MouseButton1 then
      st.firing = true
    elseif k == Enum.KeyCode.F then   -- 发导弹 / 火箭 / 炸弹（选中的那种）
      st.missile = true
    elseif k == Enum.KeyCode.C and st.d.kind == "jet" then   -- 鼠标瞄准回到机头正前方
      local lk = st.cf.LookVector
      st.aimYaw, st.aimPitch = math.atan2(-lk.X, -lk.Z), math.asin(clamp(lk.Y, -1, 1))
    elseif k == Enum.KeyCode.X then   -- 热诱弹：按住连续放（用户），每帧里按节拍发（stepFly）
      st.flareHold = true
      if os.clock() >= (st.flareNext or 0) and (st.flares or 0) > 0 then   -- 点一下也放一组（按下、松开在同一帧里的话，按住的逻辑一组都发不出去）
        st.flareNext = os.clock() + 0.3
        G.R.Drive:FireServer({ op = "flare" })
      end
    elseif k == Enum.KeyCode.J then   -- 抛副油箱（进空战前）
      G.R.Drive:FireServer({ op = "jettison" })
    elseif k == Enum.KeyCode.G then
      if st.d.kind == "jet" and not st.ground then st.gearWant = (st.gearWant > 0.5) and 0 or 1 end
    elseif k == Enum.KeyCode.R then
      G.flyNextTarget()
    elseif k == Enum.KeyCode.P then   -- 光电吊舱视角
      setEO(not st.eo)
    elseif st.eo and k == Enum.KeyCode.V then   -- 光电：电视 → 热成像白热 → 黑热
      st.eoMode = (st.eoMode or 1) % #EO_MODES + 1
      eoApply()
    elseif st.uav and (k == Enum.KeyCode.V or io.UserInputType == Enum.UserInputType.MouseButton2) then   -- 平板：前视光电 ↔ 外部视角
      st.dcam = (st.dcam == "nose") and "chase" or "nose"
    elseif (st.uav or st.eo) and k == Enum.KeyCode.Z then   -- 变焦一档一档跳：1× → 3× → 8× → 1×
      st.zoom = (st.zoom < 3.9) and 4 or ((st.zoom < 11.9) and 12 or ((st.zoom < 29.9) and 30 or 1))   -- 用户：光电要看得远一点（最大 30 倍）
    else
      local n = ({ [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3, [Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5, [Enum.KeyCode.Six] = 6 })[k]
      if n and st.wl[n] then
        st.wi = n
        st.lock, st.lockT = nil, 0
      end
    end
  end)
  UIS.InputEnded:Connect(function(io)
    if st and io.UserInputType == Enum.UserInputType.MouseButton1 then st.firing = false end
    if st and io.KeyCode == Enum.KeyCode.F then st.missile = false end
    if st and io.KeyCode == Enum.KeyCode.X then st.flareHold = false end
  end)
  UIS.InputChanged:Connect(function(io, gp)   -- 平板前视光电：滚轮细调倍率（1× ~ 12×）
    if gp or not st or not (st.uav or st.eo) or io.UserInputType ~= Enum.UserInputType.MouseWheel then return end
    st.zoom = clamp(st.zoom * (1 + 0.18 * io.Position.Z), 1, 40)
  end)

  G.R.Drive.OnClientEvent:Connect(function(m)
    if type(m) ~= "table" or not st then return end
    if m.op == "fix" and typeof(m.cf) == "CFrame" then   -- 服务器不认：拉回去
      st.cf = m.cf
      if typeof(m.v) == "Vector3" then
        st.vel = m.v
        st.spd = m.v.Magnitude
        st.hv = V(m.v.X, 0, m.v.Z)
      end
      -- 航迹方向跟着拉回去（不然留着原来的航迹，机头和航迹差得远，一下子掉光速度失速）
      st.vdir = (typeof(m.v) == "Vector3" and m.v.Magnitude > 1) and m.v.Unit or m.cf.LookVector
      st.accV = nil
    elseif m.op == "rwr" then   -- 有导弹朝我来了
      st.rwrT = os.clock() + 4
      if G.playSound then G.playSound("capture", nil, 2.2) end
    end
  end)

  ---------------------------------------------------------------- 每帧

  local SENS = 0.0042
  local function project(p)
    local sp, on = cam:WorldToViewportPoint(p)
    return UDim2.fromOffset(sp.X, sp.Y), on
  end

  -- 打中了（服务器发来的命中标记）：开着飞机时镜头猛跳一下、准星变红放大（Play.lua 的 G.hitMarker 调）
  function G.onHitMarker(kind)
    if st and st.pilot then st.hitKick = math.min(1.3, (st.hitKick or 0) + ((kind == "kill") and 1.0 or 0.45)) end
  end
  -- 吊舱页面每帧（用户给的 TGP 参考）：模式、视场、跟踪框、斜距、高度、指北、TTI、右栏
  -- 平显：俯仰梯、速度矢量、G / α / M（固定翼、飞行员、不在吊舱里）
  local function dcsHud(pos, kmh)
    local d = st.d
    local on = d.kind == "jet" and st.pilot and not st.eo and not st.crashed
    fpm.Visible, gText.Visible, aText.Visible, mText.Visible = false, on, on, on
    if not on then
      for _, L in ipairs(ladderPool) do L.f.Visible = false end
      return
    end
    local camP = cam.CFrame.Position
    local v = (st.vel.Magnitude > 5) and st.vel.Unit or st.cf.LookVector
    local hz = Vector3.new(v.X, 0, v.Z)
    hz = (hz.Magnitude > 1e-3) and hz.Unit or Vector3.new(0, 0, -1)
    local side = Vector3.new(-hz.Z, 0, hz.X)
    if not st.ground then
      local fp, fon = project(camP + v * 1000)
      fpm.Position, fpm.Visible = fp, fon
    end
    -- 俯仰梯：镜头看着的俯仰角上下各 25° 里每 5° 一根
    local lv = cam.CFrame.LookVector
    local camPitch = math.deg(math.asin(clamp(lv.Y, -1, 1)))
    local k0 = math.ceil((camPitch - 25) / 5)
    local used = 0
    local vh = cam.ViewportSize.Y
    for k = k0, k0 + 10 do
      local pa = k * 5
      if pa >= -90 and pa <= 90 then
        local r = rad(pa)
        local dirC = hz * math.cos(r) + Vector3.new(0, math.sin(r), 0)
        local c = camP + dirC * 1000
        local w = (pa == 0) and 260 or 130   -- 半宽（世界里一千格外的长度：地平线长一倍）
        local pl, onL = project(c - side * w)
        local pr, onR = project(c + side * w)
        if onL and onR then
          used += 1
          local L = ladderPool[used]
          if not L then break end
          local ax, ay = pl.X.Offset + pl.X.Scale * cam.ViewportSize.X, pl.Y.Offset + pl.Y.Scale * vh
          local bx, by = pr.X.Offset + pr.X.Scale * cam.ViewportSize.X, pr.Y.Offset + pr.Y.Scale * vh
          local cx, cy = (ax + bx) / 2, (ay + by) / 2
          local len = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)
          L.f.Position = UDim2.fromOffset(cx, cy)
          L.f.Size = UDim2.fromOffset(len, 2)
          L.f.Rotation = math.deg(math.atan2(by - ay, bx - ax))
          L.f.Visible = true
          local gap = math.min(70, len * 0.22)   -- 中间留空给速度矢量
          local half = len / 2 - gap
          local neg = pa < 0
          for i, sgm in ipairs(L.segs) do
            local left = i <= 2
            local inner = (i % 2 == 0)
            local x0 = left and 0 or (len / 2 + gap)
            if neg then   -- 虚线：每边两段
              local sl = half * 0.42
              local xs = x0 + (inner == left and (half - sl) or 0)
              if not left then xs = x0 + (inner and 0 or (half - sl)) end
              sgm.Size = UDim2.fromOffset(sl, 2)
              sgm.Position = UDim2.fromOffset(xs + sl / 2, 1)
              sgm.Visible = true
            else
              sgm.Size = UDim2.fromOffset(half, 2)
              sgm.Position = UDim2.fromOffset(x0 + half / 2, 1)
              sgm.Visible = (i == 1 or i == 3)
            end
          end
          -- 端头的小竖线：正的往下（指地平线），负的往上
          for i, tk in ipairs(L.ticks) do
            tk.Visible = pa ~= 0
            tk.Position = UDim2.fromOffset((i == 1) and 1 or (len - 1), neg and -8 or 1)
          end
          for i, lb in ipairs(L.labs) do
            lb.Text = (pa ~= 0) and tostring(math.abs(pa)) or ""
            lb.Position = UDim2.fromOffset((i == 1) and -18 or (len + 18), neg and -6 or 6)
            lb.Rotation = 0
          end
        end
      end
    end
    for i = used + 1, #ladderPool do ladderPool[i].f.Visible = false end
    -- G、α、M
    local gl = st.gLoad or 1
    gText.Text = string.format("G %.1f", gl)
    gText.TextColor3 = (gl > 7.5 or gl < -2.5) and RGB(255, 90, 80) or HUD
    aText.Text = string.format("α %.1f", st.aoaDeg or 0)
    mText.Text = string.format("M %.2f", st.vel.Magnitude / AD.M / 340)
  end
  -- 灰视 / 红视：正过载超过 6.5g 慢慢变暗、发灰（撑得越久越重，到 9g 几乎全黑），负过载超过 −2.5g 发红；松了一两秒恢复
  local function gEffect(dt)
    local gl = (st and st.d and st.d.kind == "jet" and st.pilot and not st.ground and not st.crashed) and (st.gLoad or 1) or 1
    local want = 0
    if gl > 6.5 then want = (gl - 6.5) / 2.5 elseif gl < -2.5 then want = (gl + 2.5) / 1.5 end
    want = clamp(want, -1, 1)
    local rate = (math.abs(want) > math.abs(gStress)) and 0.55 or 1.4   -- 压上去慢、缓过来快
    gStress += (want - gStress) * math.min(1, dt * rate)
    local k = math.abs(gStress)
    local red = gStress < 0
    local on = k > 0.02
    for _, f in ipairs(gVig) do
      f.Visible = on
      if on then
        f.BackgroundColor3 = red and RGB(120, 0, 0) or RGB(0, 0, 0)
        f.BackgroundTransparency = 1 - math.min(1, k * 1.3)
      end
    end
    gFill.BackgroundColor3 = red and RGB(110, 0, 0) or RGB(0, 0, 0)
    gFill.BackgroundTransparency = 1 - clamp((k - 0.5) * 1.6, 0, 0.92)
    gCC.Enabled = on
    if on then gCC.Saturation, gCC.Brightness = -k * 0.9, red and 0 or -k * 0.12 end
    G.gStress = gStress   -- 测试用
  end
  G.flyGEffect = gEffect

  local tgpStep
  local REL = { bomb = "CCRP", agm = "PRE", rkt = "RKT", aam = "SRM", gun = "GUN" }
  local function fmtT(t)
    if not t or t ~= t or t < 0 or t > 599 then return "-:--" end
    return string.format("%d:%02d", math.floor(t / 60), math.floor(t % 60))
  end
  function tgpStep(pos, wid, w)
    local m = EO_MODES[st.eoMode or 1]
    eoMode.Text = T("eo." .. m)
    TG.fov.Text = (st.zoomS >= 3) and "NARO" or "WIDE"
    TG.zoom.Text = string.format("%.1fx", st.zoomS)
    TG.ag.Text = (w and w.kind == "aam") and "A-A" or "A-G"
    local camP = cam.CFrame.Position
    local vs = cam.ViewportSize
    local dispH = vs.Y * 0.78
    local dispW = math.min(vs.X, dispH * 4 / 3)
    -- 跟踪：吊舱正看着车、船、飞机 → POINT，框按它在画面里多大；锁着的目标不在中间就框到它那里；都没有是 AREA（中间一个小框）
    local point, bx, by, bs = false, dispW / 2, dispH / 2, MOB and 18 or 26
    local function sizeOf(model, at)
      local root = model and model:FindFirstChild("Root")
      local sz = root and math.max(root.Size.X, root.Size.Y, root.Size.Z) or 10
      local dist = math.max(1, (at - camP).Magnitude)
      local f = (vs.Y / 2) / math.tan(math.rad(cam.FieldOfView / 2))
      return clamp(sz / dist * f * 1.15, MOB and 20 or 28, MOB and 90 or 150)
    end
    if st.aimEnt and st.aimEnt.Parent then
      point = true
      local root = st.aimEnt:FindFirstChild("Root")
      bs = sizeOf(st.aimEnt, root and root.CFrame.Position or st.aimPt)
    elseif st.lock and st.lock.pos then
      local sp, on = cam:WorldToViewportPoint(st.lock.pos)
      local lx, ly = sp.X - (vs.X - dispW) / 2, sp.Y - (vs.Y - dispH) / 2
      if on and lx > 0 and lx < dispW and ly > 0 and ly < dispH then
        point, bx, by = true, lx, ly
        bs = sizeOf(st.lock.em, st.lock.pos)
      end
    end
    TG.box.Position = UDim2.fromOffset(bx, by)
    TG.box.Size = UDim2.fromOffset(bs, bs)
    TG.boxStroke.Thickness = point and 1.5 or 1
    TG.track.Text = point and "POINT" or "AREA"
    -- 斜距（海里）、高度（英尺）、指北
    local slant = (st.aimPt - camP).Magnitude / AD.M
    TG.rng.Text = string.format("T %.1f", slant / 1852)
    TG.alt.Text = string.format("%d", math.floor(pos.Y / AD.M * 3.281 + 0.5))
    local lv = cam.CFrame.LookVector
    TG.north.Rotation = -90 - math.deg(math.atan2(lv.X, -lv.Z))
    -- 投出去的弹还在飞：TTI 按它离瞄准点多远、多快；没投就按现在投下去要飞多久
    local live, tti = nil, nil
    for _, s2 in pairs(G.flyingShots or {}) do
      if s2.by ~= nil and s2.by == st.id and (s2.kind == "bomb" or s2.kind == "missile" or s2.kind == "rocket") then
        if not live or s2.t < live.t then live = s2 end
      end
    end
    if live then
      tti = (st.aimPt - live.p).Magnitude / math.max(live.v.Magnitude, 1)
      live.tti0 = live.tti0 or math.max(tti, 0.1)
      TG.bar.Size = UDim2.fromScale(clamp(1 - tti / live.tti0, 0, 1), 1)
    else
      TG.bar.Size = UDim2.fromScale(0, 1)
      if w and w.kind == "bomb" then
        local h = pos.Y - math.max(ground(pos.X, pos.Z), 0)
        local vy = -st.vel.Y
        tti = (vy + math.sqrt(math.max(0, vy * vy + 2 * GR * math.max(h, 0)))) / GR
      elseif w and (w.kind == "agm" or w.kind == "rkt") then
        tti = slant * AD.M / math.max(w.speed or 300, 1)
      end
    end
    TG.tti.Text = "TTI " .. fmtT(tti)
    TG.ttiBig.Text = fmtT(tti)
    -- 右栏
    local nm = wid and T("aw." .. wid) or "--"
    TG.rel.Text = (REL[w and w.kind or "gun"] or "PRE") .. "  ·  " .. nm
    TG.away.Text = live and (nm .. "  AWAY") or ""
    local laser = w ~= nil and (w.kind == "bomb" or w.kind == "agm")
    TG.arm.Text = laser and "LASER ARM" or ""
    TG.lst.Text = live and string.format("LST %d s  ·  1688", math.max(0, math.floor((tti or 0) - 8))) or (laser and "LST  ·  1688" or "")
    TG.say.Text = live and T("eo.sayHold") or (point and T("eo.sayPoint") or T("eo.sayArea"))
    eoHint.Text = T("eo.hint")
  end

  function G.stepFly(dt)
    G.try_(gEffect, dt)
    local S = G.S
    local vs = S and S.alive and S.veh or nil
    if vs and not vs.air then vs = nil end
    if vs and (not st or st.id ~= vs.id) then
      if st then stop() end
      begin(vs)
    elseif not vs and st then
      stop()
    end
    if not st then return end
    if not st.em.Parent then stop() return end
    local d = st.d
    st.pilot = vs.pilot == true
    st.stores = st.storesLocal or {}
    -- 服务器推来的弹药数（半秒一次）：比本地扣的数少才换（本地先扣过的不回弹）
    if vs.stores then
      st.storesLocal = st.storesLocal or table.clone(vs.stores)
      for i, n in ipairs(vs.stores) do
        if st.storesSeen == nil or st.storesSeen[i] ~= n then st.storesLocal[i] = n end
      end
      st.storesSeen = table.clone(vs.stores)
      st.stores = st.storesLocal
    end
    st.gunAmmo, st.flares, st.load = vs.gun or 0, vs.flares or 0, vs.load or st.load
    -- 油量（服务器算，属性 Fuel / FuelX）：烧干了熄火；挂着的副油箱算阻力，油多算重量
    local f0, x0 = st.em:GetAttribute("Fuel"), st.em:GetAttribute("FuelX")
    st.fuel = (type(f0) == "number") and f0 or 1
    st.fuelX = (type(x0) == "number") and x0 or 0
    st.out = st.fuel <= 0 and st.fuelX <= 0
    st.heavy = AD.heavy(d, st.fuel, st.fuelX)
    st.drag, st.tanks = 0, 0
    for i, s2 in ipairs(d.st or {}) do
      local w2 = st.load and st.load[i] and AD.W[st.load[i]]
      if w2 and w2.kind == "tank" and (st.stores[i] or 0) > 0 then
        st.drag += w2.drag * st.stores[i]
        st.tanks += st.stores[i]
      end
    end
    -- 镜头转动
    if not G.mobile then UIS.MouseBehavior = Enum.MouseBehavior.LockCenter end
    local md = UIS:GetMouseDelta()
    -- 平板前视光电变焦：倍率越大鼠标越慢（准星在画面上走得一样快）
    st.zoomS = st.zoomS + ((((st.uav and st.dcam == "nose") or st.eo) and st.zoom or 1) - st.zoomS) * math.min(1, dt * 8)
    if st.uav or st.eo then md = md / st.zoomS end
    if st.eo then   -- 光电：鼠标只转吊舱（飞机按自动驾驶飞）
      st.eoYaw -= md.X * SENS
      st.eoPitch = clamp(st.eoPitch - md.Y * SENS, -1.5, 0.35)
    else
      if d.kind == "jet" and not G.mobile then   -- 鼠标瞄准：鼠标转的是想去的方向（飞机自动转过去）
        st.aimYaw -= md.X * SENS
        st.aimPitch = clamp(st.aimPitch - md.Y * SENS, -1.45, 1.45)
      end
      -- 直升机：机头跟着准心转（鼠标转的就是准心）；手机没有鼠标、坐后面的人不开飞机：镜头跟着机头一起转
      if d.kind == "heli" then
        if (G.mobile or not st.pilot) and st.yawSeen then st.camYaw += angDiff(st.yawSeen, st.yaw) end
        -- 按住 Alt 自由看：机头停在按下时的准心上；松开回到原来的准心
        local alt = st.pilot and not G.mobile and key(Enum.KeyCode.LeftAlt)
        if alt and not st.freeLook then
          st.freeLook = { st.camYaw, st.camPitch }
          st.noseYaw = st.camYaw
        elseif not alt and st.freeLook then
          st.camYaw, st.camPitch = st.freeLook[1], st.freeLook[2]
          st.freeLook, st.noseYaw = nil, nil
        end
      end
      st.yawSeen = st.yaw
      st.camYaw -= md.X * SENS
      st.camPitch = clamp(st.camPitch - md.Y * SENS, -1.2, 0.9)
    end
    -- 飞
    if st.pilot and not st.crashed then
      if d.kind == "jet" then jetPhysics(dt) else heliPhysics(dt) end
      -- 撞楼、撞舰岛：沿着速度方向打一条射线
      local stepV = st.vel * dt * 1.6
      if stepV.Magnitude > 0.5 and not st.ground then
        local res = workspace:Raycast(st.cf.Position, stepV + stepV.Unit * d.L * 0.4, mapParams)
        if res and res.Normal.Y < 0.6 then crash() end
      end
      -- 飞出作战区（±Map.PLAY，约 5 公里）：自动掉头（喷气机掉头半径七八百格）；再往外硬拦住（服务器在 Map.PLAY + 1200 以外不认）
      local p = st.cf.Position
      local lim = Map.PLAY
      st.oob = math.abs(p.X) > lim or math.abs(p.Z) > lim
      if st.oob and d.kind == "jet" then
        local back = V(-p.X, 0, -p.Z).Unit
        st.aimYaw = math.atan2(-back.X, -back.Z)
        st.aimPitch = 0.05
      end
      local hard = Map.PLAY + 1000
      if math.abs(p.X) > hard or math.abs(p.Z) > hard then
        st.cf = st.cf - p + V(math.clamp(p.X, -hard, hard), p.Y, math.clamp(p.Z, -hard, hard))
        if d.kind == "heli" then st.hv = V() end
      end
      if p.Y > 2600 then st.cf = st.cf - V(0, p.Y - 2600, 0) end
    else
      st.cf = st.em.Root.CFrame   -- 坐在后面：跟着服务器
    end
    -- 航炮后坐：开火时机身高频抖一点（模型跟着抖，用户：飞机机炮要有散布、后坐力和打击感）
    local gunOn = st.pilot and st.trig and (st.gunAmmo or 0) > 0 and not st.crashed
    st.recoil = approach(st.recoil or 0, gunOn and 1 or 0, dt * (gunOn and 14 or 6))
    st.hitKick = math.max(0, (st.hitKick or 0) - dt * 5)
    if st.recoil > 0.02 and st.pilot then
      local t = os.clock()
      local a = math.rad(0.05) * st.recoil
      st.cf = st.cf * CFrame.Angles(math.noise(t * 37, 2.1) * a, math.noise(t * 33, 5.3) * a, math.noise(t * 29, 8.7) * a)
    end
    -- 镜头
    local pos = st.cf.Position
    if st.eo then
      -- 光电吊舱：机腹下面（固定翼）/ 机头下面的光电球（直升机），视线稳定在世界方向上，不画镜头抖动
      local eye = (d.kind == "jet") and (st.cf * CF(0, -d.H * 0.5 - 0.6, -d.L * 0.12)).Position or (st.cf * CF(0, -d.H * 0.3, -d.L * 0.5 - 0.8)).Position
      cam.CFrame = CFrame.lookAt(eye, eye + eoDir() * 100)
    elseif st.uav and st.dcam == "nose" then
      -- 无人机前视光电（机头下面的光电球）：顺着鼠标想去的方向看（手机上就是机头方向），不画镜头抖动
      local eye = (st.cf * CF(0, -d.H * 0.22, -d.L * 0.5 - 0.8)).Position
      local look = G.mobile and st.cf.LookVector or aimDirNow()
      cam.CFrame = CFrame.lookAt(eye, eye + look * 100)
    elseif d.kind == "jet" and not G.mobile and st.pilot then
      -- 镜头在飞机后上方顺着鼠标瞄准方向看（按着键盘时瞄准方向跟着机头，镜头也就跟着机头）；地平线跟着坡度歪三成
      local aim = aimDirNow()
      -- 用户：视角要离飞机近一点（最早一倍半机身长再往后 26 格；11-18 改成 0.85 倍 + 12 格；11-18 晚又说再近一点）：
      --   现在 0.62 倍 + 6 格（歼-20 从 60 格到 41 格），按机身长和七成翼展里大的算——B-2 这种翼展比机身长得多的，镜头转到侧面不钻进机翼
      local size = math.max(d.L, d.W * 0.7)
      local back = size * 0.62 + 6
      -- 镜头带弹簧慢半拍跟上，加速度把镜头往反方向甩开一点（转弯时飞机在画面里往外偏、拉起时往下沉）；大过载、加力时轻轻抖
      local want = -aim * back + V(0, d.H * 0.45 + 2.5, 0)
      st.camOff = st.camOff and st.camOff:Lerp(want, 1 - math.exp(-dt * 7)) or want
      local acc = st.accV or V()
      local push = -acc * 0.014
      if push.Magnitude > 5 then push = push.Unit * 5 end
      st.camPush = (st.camPush or push):Lerp(push, 1 - math.exp(-dt * 4))
      local camPos = pos + st.camOff + st.camPush
      local gl = acc.Magnitude / GR   -- 大概几个 g
      local amp = math.clamp((gl - 3) * 0.0016, 0, 0.012) + ((st.thrE or 0) > 100 and 0.0012 or 0)
      local t = os.clock()
      local shake = CFrame.Angles(math.noise(t * 18, 1.3) * amp, math.noise(t * 18, 7.1) * amp, 0)
      local upC = (V(0, 1, 0) * 0.7 + st.cf.UpVector * 0.3)
      cam.CFrame = CFrame.lookAt(camPos, pos + aim * 300, (upC.Magnitude > 0.1) and upC.Unit or V(0, 1, 0)) * shake
    elseif d.kind == "jet" then
      local camPos = (st.cf * CF(0, d.H * 0.5 + 3, math.max(d.L, d.W * 0.7) * 0.65 + 7)).Position   -- 手机 / 坐后面的：也近一点
      cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(camPos, (st.cf * CF(0, 4, -300)).Position), math.min(1, dt * 8))
    else
      local dirCam = CFrame.Angles(0, st.camYaw, 0) * CFrame.Angles(st.camPitch, 0, 0)
      local camPos = pos + V(0, d.H * 0.45, 0) + dirCam:VectorToWorldSpace(V(0, 0, d.L * 0.62 + 7))   -- 直升机也近一点（0.8 倍 + 11 → 0.62 倍 + 7）
      cam.CFrame = CFrame.lookAt(camPos, camPos + dirCam.LookVector)
    end
    -- 视野：固定翼越快越宽；光电吊舱 / 无人机前视按倍率收（另一会话：开火时镜头抖、视野收一点，打中时再猛跳一下）
    local fovT = (d.kind == "jet") and math.clamp(70 + st.spd / d.vMax * 10, 70, 82) or 70
    if (st.uav and st.dcam == "nose") or st.eo then fovT = 70 / st.zoomS end
    st.fov = st.fov or cam.FieldOfView
    st.fov += (fovT - st.fov) * math.min(1, dt * ((st.uav and 10) or 4))
    local kick = (st.eo and 0) or ((st.recoil or 0) * 0.8 + (st.hitKick or 0))
    if kick > 0.01 then
      local t = os.clock()
      local a = math.rad(0.32) * kick
      cam.CFrame = cam.CFrame * CFrame.Angles(math.noise(t * 31, 1.3) * a, math.noise(t * 27, 7.1) * a, math.noise(t * 23, 4.7) * a * 0.5)
    end
    cam.FieldOfView = st.fov - (st.eo and 0 or (1.6 * (st.recoil or 0) + 1.2 * (st.hitKick or 0)))
    -- 瞄准点：镜头中间（固定翼：鼠标瞄准方向）打出去碰到的地方
    local ex = { G.viewFolder }
    if me.Character then table.insert(ex, me.Character) end
    table.insert(ex, st.em)
    aimParams.FilterDescendantsInstances = ex
    local adir = lookDir()
    local o = (d.kind == "jet" and not st.eo) and pos or cam.CFrame.Position
    local far = (st.eo or st.uav) and 24000 or 9000   -- 光电吊舱、前视光电看得远（八公里多）
    local res = workspace:Raycast(o + adir * (d.L * 0.6), adir * far, aimParams)
    st.aimPt = res and res.Position or (o + adir * far)
    do   -- 瞄准点打在哪个实体上（吊舱页面的 POINT 跟踪框）
      local hm = res and res.Instance and res.Instance:FindFirstAncestorOfClass("Model")
      st.aimEnt = (hm and hm ~= st.em and hm:GetAttribute("EntId") ~= nil) and hm or nil
    end
    -- 机头炮塔：跟着瞄准点转（鼠标瞄）
    local gid, gw = gunW()
    local wid, w = storeW()
    if d.gunPos and gw and gw.turret then
      local l = st.cf:PointToObjectSpace(st.aimPt) - d.gunPos
      st.ty = clamp(deg(math.atan2(l.X, -l.Z)), -110, 110)
      st.gp = clamp(deg(math.atan2(l.Y, math.sqrt(l.X * l.X + l.Z * l.Z))), -60, 11)
    end
    st.c.ty, st.c.gp = st.ty, st.gp
    -- 弹舱门
    local bm, bs = false, false
    if wid then bm, bs = bayOf(wid) end
    st.bay = approach(st.bay, bm and 1 or 0, dt * 2.5)
    st.bayS = approach(st.bayS, bs and 1 or 0, dt * 2.5)
    st.c.bay, st.c.bayS = st.bay, st.bayS
    -- 开火：鼠标左键 机炮按住连发（扳机发给服务器）；F 挂的弹一下一发（火箭按住连发）。没有炮的飞机左键也发挂的弹
    --   手机：开火键按选中的那种（选的是炮就打炮）
    if st.pilot then
      local _, cw = curW()
      local touchGun = touch and touch.fire and cw and cw.kind == "gun"
      local gunOn = gid ~= nil and ((st.firing and not G.mobile) or touchGun or false)
      if gid then setTrig(gunOn) end
      local fireS = st.missile or (st.firing and not gid) or (touch and touch.fire and not touchGun)
      if w and fireS then
        if w.kind == "rkt" or not st.fireLatch then fireStore(wid, w) end
        st.fireLatch = true
      else
        st.fireLatch = false
      end
    end
    -- 锁定：选中的弹要锁的话，目标在视场里待够锁定时间
    if st.pilot and w and (w.kind == "aam" or w.kind == "agm" or (w.kind == "bomb" and w.guided)) then
      if st.lock and (not st.lock.em.Parent or st.lock.em:GetAttribute("Wreck")) then st.lock = nil end
      if st.lock then
        local root = st.lock.em:FindFirstChild("Root")
        if root then
          local to = root.CFrame.Position - pos
          st.lock.dir, st.lock.dist, st.lock.pos = to.Unit, to.Magnitude, root.CFrame.Position
          if inCone(w, st.lock) and st.lock.dist < (w.range or 3200) * 1.1 then st.lockT += dt else st.lock, st.lockT = nil, 0 end
        else
          st.lock = nil
        end
      end
      if not st.lock then
        st.lock = pickTarget(w)
        st.lockT = 0
      end
    else
      st.lock, st.lockT = nil, 0
    end
    -- 报给服务器（每秒 15 次）
    -- 热诱弹：按住 X（手机按住 X 键）每 0.3 秒放一组
    if st.pilot and (st.flareHold or (touch and touch.flare)) and os.clock() >= (st.flareNext or 0) and (st.flares or 0) > 0 then
      st.flareNext = os.clock() + 0.3
      G.R.Drive:FireServer({ op = "flare" })
    end
    st.sendT -= dt
    if st.sendT <= 0 and st.pilot and not st.crashed then
      st.sendT = math.max(st.sendT + 1 / 15, 0)   -- 按平均每秒 15 次（原来每次重设，帧率低时间隔拖成两三帧）
      local c = st.c
      G.R.Drive:FireServer({ op = "state", cf = st.cf, v = st.vel, gd = st.ground, aim = st.aimPt, thr = c.thr, gear = c.gear, flap = c.flap, cp = c.pit, cr = c.rol,
        cy = c.yaw, bay = c.bay, bays = c.bayS, rpm = c.rpm, col = c.col, can = c.can, hook = c.hook, brk = c.brk, ty = c.ty, gp = c.gp, fold = c.fold })
    end
    -- 平显
    local em = st.em
    local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
    hpBar.Size = UDim2.fromScale(clamp(hp / mx, 0, 1), 1)
    hpBar.BackgroundColor3 = ui.hpColor(hp / mx)
    aName.Text = T("veh." .. d.id) .. (st.pilot and "" or ("   " .. T("air.passenger")))
    local kmh = math.floor(st.vel.Magnitude / AD.M * 3.6 + 0.5)
    local agl = math.floor((pos.Y - ground(pos.X, pos.Z) - d.gearH) / AD.M + 0.5)
    st.aglM, st.kmh = agl, kmh   -- 离地高度（米）、速度（km/h）：Coach.lua 看要不要提示放起落架
    aInfo.Text = T("ui.speed", kmh) .. "    " .. T("air.alt", math.max(0, agl)) .. "    " .. T("air.flares", st.flares) .. "    " .. T("air.fuelP", math.floor((st.fuel + st.fuelX) * 100 + 0.5))
      .. ((d.kind == "jet") and ("    " .. T("air.gearState." .. ((st.gearWant > 0.5) and "down" or "up"))) or "")
    if wid then
      aWpn.Text = "F  [" .. st.wi .. "/" .. #st.wl .. "] " .. T("aw." .. wid) .. "  ×" .. left(wid) .. (gid and ("    " .. T("air.mouseGun", T("aw." .. gid), left(gid))) or "")
    elseif gid then
      aWpn.Text = T("air.mouseGun", T("aw." .. gid), left(gid))
    else
      aWpn.Text = T("air.noWeapon")
    end
    st.help = st.pilot and (st.uav and "air.helpUav" or ((d.kind == "jet") and "air.helpJet" or "air.helpHeli")) or "air.helpPass"
    if st.pilot then
      spdText.Text = string.format("%d", kmh)
      altText.Text = string.format("%d", math.max(0, agl))
      thrText.Text = (d.kind == "jet") and ((st.thr > 100) and T("air.ab") or (string.format("%d%%", math.floor(st.thr + 0.5)) .. (st.apc and ("  " .. T("air.apc")) or ""))) or string.format("RPM %d%%", math.floor(st.rpm))
      vsText.Text = string.format("%+d", math.floor(st.vel.Y / AD.M + 0.5))
      -- 油量：内油 %（+ 副油箱 %）、照现在的油门还能飞几分几秒；少于两成半变黄、一成变红
      local tot = st.fuel + st.fuelX
      local rate = AD.burn(d, (d.kind == "heli") and 100 or st.thr, st.c.col or 0, (d.kind == "heli") and st.rpm or st.thr, st.vel.Magnitude / math.max(d.vMax, 1), st.ground)
      local secs = (rate > 0) and tot / rate or math.huge
      local left2 = (secs < 5999) and string.format("%d:%02d", math.floor(secs / 60), math.floor(secs % 60)) or "--:--"
      fuelText.Text = T("air.fuel", math.floor(st.fuel * 100 + 0.5)) .. ((st.fuelX > 0) and string.format(" +%d", math.floor(st.fuelX * 100 + 0.5)) or "") .. "  " .. left2
      fuelText.TextColor3 = (tot < 0.1) and RGB(255, 90, 80) or ((tot < 0.25) and RGB(255, 200, 90) or HUD)
      local bp, bon = project(pos + st.cf.LookVector * 400)
      bore.Position, bore.Visible = bp, bon and not st.eo
      G.try_(dcsHud, pos, kmh)
      -- 命中标记标在炮口指的地方（固定的航炮顺着机头打；机头炮塔跟着瞄准圈），打中时这个准星放大一下、变红（另一会话）
      G.hitMarkerAt = gw and (gw.turret and (G.mobile and UDim2.fromScale(0.5, 0.5) or aimRing.Position) or bp) or nil
      local hk = math.min(1, st.hitKick or 0)
      bore.TextSize = 34 + 14 * hk
      bore.TextColor3 = Color3.new(1, 1 - 0.7 * hk, 1 - 0.75 * hk)
      -- 大圈：圈心在机头指向；大小是选中武器能锁的离轴角（导弹的导引头）/ 航炮、火箭、炸弹的瞄准圈；圈底下写武器和剩几发
      local rdeg = (not w and 3) or (w.kind == "rkt" and 5) or (w.kind == "bomb" and 9) or (w.cone or 20)
      if d.kind == "heli" and w and w.kind == "agm" then rdeg += 20 end
      local vh = cam.ViewportSize.Y
      -- 用户：圈太小、挡视野——原来按导引头离轴角画，小的只有一两百像素、正好套在飞机和前方上；现在至少框到画面高度的八成，
      --   飞机和前方留空，离轴角大的弹（近距格斗弹）再大一点；武器名写在圈里靠下
      local px = clamp(vh / math.tan(rad(cam.FieldOfView / 2)) * math.tan(rad(math.min(rdeg, 55))), vh * 0.8, vh * 0.94)
      ring.Size, ring.Position, ring.Visible = UDim2.fromOffset(px, px), bp, bon and not st.eo and not st.uav
      ringText.Position, ringText.Visible = bp + UDim2.fromOffset(0, px / 2 - 30), bon and not st.eo and not st.uav
      ringText.Text = wid and (T("aw." .. wid) .. "  ×" .. left(wid)) or (gid and (T("aw." .. gid) .. "  ×" .. left(gid))) or ""
      local lk = st.cf.LookVector
      hdgText.Text = string.format("%03d", math.floor((math.deg(math.atan2(lk.X, -lk.Z)) + 360) % 360 + 0.5) % 360)
      -- 右侧武器栏：剩几发、选中的那行亮、打光了变灰
      for _, r in ipairs(wRows) do
        local n = r.it.flare and st.flares or left(r.it.wid)
        r.cnt.Text = "×" .. n
        local sel = r.it.idx == st.wi
        r.f.BackgroundColor3, r.f.BackgroundTransparency = sel and RGB(20, 96, 44) or RGB(0, 18, 6), sel and 0.3 or 0.6
        r.s.Transparency, r.s.Thickness = sel and 0 or 0.7, sel and 2 or 1
        local col = (n <= 0) and RGB(110, 130, 112) or HUD
        r.cnt.TextColor3, r.nm.TextColor3 = col, col
      end
      -- 光电画面的字：模式、倍率、目标距离、吊舱相对机头的方位 / 俯仰
      if st.eo then tgpStep(pos, wid, w) end
      if st.eo or (st.uav and st.dcam == "nose") then
        aimRing.Visible = false   -- 光电 / 前视光电：镜头就是瞄准方向，画十字线
      elseif d.kind == "jet" and not G.mobile then   -- 固定翼：小十字是机头（bore），圆圈是鼠标瞄准（飞机往圆圈那边转）
        local ap, aon = project(pos + aimDirNow() * 400)
        aimRing.Position, aimRing.Visible = ap, aon
      elseif d.kind == "jet" then
        aimRing.Visible = false
      else
        aimRing.Position, aimRing.Visible = UDim2.fromScale(0.5, 0.5), d.kind == "heli"
      end
      -- 警告
      local warn = nil
      if st.rwrT and os.clock() < st.rwrT then warn = ((os.clock() * 4) % 1 < 0.6) and T("air.missile") or ""
      elseif st.out and not st.ground then warn = T("air.flameout")
      elseif st.oob then warn = T("air.oob")
      elseif d.kind == "jet" and not st.ground and st.spd < d.stall * 1.05 then warn = T("air.stall")
      elseif os.clock() - (st.floatT or -9) < 0.6 then warn = T("air.tooFast")   -- 接地太快、贴着跑道飘：收油门
      elseif not st.ground and agl < 60 and st.vel.Y < -25 then warn = T("air.pullup")
      elseif not st.ground and st.fuel + st.fuelX < 0.12 then warn = ((os.clock() * 2) % 1 < 0.6) and T("air.bingo") or "" end   -- 油不多了：该回去了
      warnText.Text = warn or ""
      warnText.Visible = warn ~= nil
      -- 落地补给（用户：降落回去可以回血、补武器）：服务器 Rest 属性——1～5 停稳倒计时、10 在自己的机场还在滑、
      --   −1 补完了正在修、−2 全好了、−3 这里不是自己的机场 / 甲板
      local rest = st.ground and em:GetAttribute("Rest") or 0
      local rtx, rcol = nil, RGB(120, 230, 140)
      if type(rest) ~= "number" or rest == 0 then rtx = nil
      elseif rest > 0 and rest <= 5 then rtx = T("air.restWait", math.floor(rest))
      elseif rest == 10 then rtx = T("air.restRoll")
      elseif rest == -1 then rtx = T("air.restFix", math.floor(clamp(hp / mx, 0, 1) * 100))
      elseif rest == -2 then rtx = T("air.restDone")
      elseif rest == -3 and math.abs(st.spd) < 30 then rtx, rcol = T("air.restNo"), RGB(255, 200, 90) end
      restText.Text, restText.TextColor3, restText.Visible = rtx or "", rcol, rtx ~= nil
      -- 降落引导：起落架放着、在天上：最近的能落的地方画个菱形，旁边写公里数；菱形按下滑道（3.5°）变色——绿正好、黄偏高、红偏低
      local site = nil
      if d.kind == "jet" and not st.ground and st.gearWant > 0.5 then
        local bd = math.huge
        for _, s2 in ipairs(landSites()) do
          local dd = (V(s2.p.X, 0, s2.p.Z) - V(pos.X, 0, pos.Z)).Magnitude
          if dd < bd then site, bd = s2, dd end
        end
        if site then
          local lp, lon = project(site.p + V(0, 1, 0))
          landMark.Position, landMark.Visible = lp, lon
          landText.Position, landText.Visible = lp + UDim2.fromOffset(0, 22), lon
          local ideal = bd * math.tan(rad(3.5))
          local dh = (pos.Y - d.gearH - site.p.Y) - ideal
          local tol = ideal * 0.35 + 18
          local col = (dh > tol) and RGB(255, 200, 90) or ((dh < -tol) and RGB(255, 90, 80) or RGB(120, 230, 140))
          landMark.TextColor3, landText.TextColor3 = col, col
          landText.Text = string.format("%.1f", bd / AD.M / 1000)
        end
      end
      if not site then landMark.Visible, landText.Visible = false, false end
      -- 锁定框
      if st.lock then
        local lp, lon = project(st.lock.pos)
        local locked = st.lockT >= (w.lockTime or 1)
        lockBox.Position, lockBox.Visible = lp, lon
        lockStroke.Color = locked and RGB(255, 80, 70) or HUD
        lockBox.Size = locked and UDim2.fromOffset(38, 38) or UDim2.fromOffset(52, 52)
        lockText.Position = lp + UDim2.fromOffset(0, 30)
        lockText.Visible = lon
        lockText.Text = locked and (T("air.locked") .. string.format("  %dm", math.floor(st.lock.dist / AD.M))) or T("air.locking", math.floor(st.lockT / (w.lockTime or 1) * 100))
        lockText.TextColor3 = locked and RGB(255, 80, 70) or HUD
      else
        lockBox.Visible, lockText.Visible = false, false
      end
      -- 炸弹落点（不制导的、或者没锁上的制导炸弹）
      if w and w.kind == "bomb" and not (st.lock and st.lockT >= (w.lockTime or 1)) then
        local h = pos.Y - math.max(ground(pos.X, pos.Z), 0)
        local vy = -st.vel.Y
        local tf = (vy + math.sqrt(math.max(0, vy * vy + 2 * GR * math.max(h, 0)))) / GR
        local hit = pos + V(st.vel.X, 0, st.vel.Z) * tf * 0.97
        local gp2, gon = project(V(hit.X, ground(hit.X, hit.Z), hit.Z))
        pipper.Position, pipper.Visible = gp2, gon
      else
        pipper.Visible = false
      end
      if st.eo then   -- 吊舱画面里：平显的落点、降落菱形、锁定框都收起来（吊舱自己画跟踪框）
        pipper.Visible, landMark.Visible, landText.Visible, lockBox.Visible, lockText.Visible, restText.Visible = false, false, false, false, false, false
      end
    end
  end

  -- 被击毁 / 跳伞：服务器推来 alive = false 或 veh = nil，下一帧 stop()
end

return Fly
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="83">
          <Properties>
            <string name="Name">FortView</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——地图自带工事的样子：机枪碉堡、岸防炮、高炮、M777 榴弹炮，零件拼的；
--   炮塔、炮管按属性 Ty / Gp 平滑地转（自己在操作的用本地的），开炮后坐，被毁时顶板塌下来、发黑、冒火冒烟；队伍色小旗（据点被拿下换颜色）
--   走到自己队的工事旁出现「E 操作」提示、走到自己队的空车旁出现「E 上车」（ProximityPrompt：手机点一下、手柄按键也行）
--   G.solidAt(点, 半径)：开车时撞上工事、钢刺猬就停（Drive.lua 调）
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local FortView = {}

function FortView.init(G)
  local FD = require(RS:WaitForChild("FortDefs"))
  local Map = G.Map
  local Config = G.Config
  local V, CF, RGB = Vector3.new, CFrame.new, Color3.fromRGB
  local MAT = Enum.Material
  local CYL = Enum.PartType.Cylinder
  local me = Players.LocalPlayer
  local UP = CFrame.Angles(0, 0, math.pi / 2)      -- 圆柱的轴转到 Y（竖着的圆盘）
  local ALONG = CFrame.Angles(0, math.pi / 2, 0)   -- 圆柱的轴转到 Z（炮管）
  local function T(k, ...) return G.T(k, ...) end

  local CONC, CONC2, DARK, GUN = RGB(156, 152, 140), RGB(128, 126, 118), RGB(22, 22, 24), RGB(46, 48, 50)
  local OLIVE, OLIVE2, GREY, SOD = RGB(88, 98, 68), RGB(70, 80, 56), RGB(120, 126, 128), RGB(92, 116, 66)

  local function newPart(m, size, color, mat, shape)
    local x = Instance.new("Part")
    if shape then x.Shape = shape end
    x.Size, x.Color = size, color
    x.Material = mat or MAT.SmoothPlastic
    x.Anchored, x.CanCollide, x.CanQuery, x.CanTouch = true, false, false, false
    x.TopSurface, x.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    x.CastShadow = size.Magnitude > 3
    x.Parent = m
    return x
  end

  ---------------------------------------------------------------- 零件：每个 { 零件, 组（hull 不动 / turret 跟炮塔转 / gun 跟炮管俯仰 / roof 被毁时塌）, 偏移 }

  local BUILD = {}
  -- add(组, 尺寸, 偏移, 颜色, 材质, 形状)；炮管 barrel(组, 长, 粗, 偏移, 颜色)
  BUILD.bunker = function(add, barrel)
    add("hull", V(16.4, 0.8, 14.4), CF(0, 0.4, 0), CONC, MAT.Concrete)
    add("hull", V(16, 6.2, 1.6), CF(0, 3.9, 6.2), CONC, MAT.Concrete)       -- 后墙
    add("hull", V(1.6, 6.2, 11), CF(-7.2, 3.9, 0), CONC, MAT.Concrete)      -- 两侧墙
    add("hull", V(1.6, 6.2, 11), CF(7.2, 3.9, 0), CONC, MAT.Concrete)
    add("hull", V(16, 3.2, 1.8), CF(0, 2.4, -6.1), CONC, MAT.Concrete)      -- 射孔下沿（射孔高 4.0～5.2）
    add("hull", V(13, 1.2, 0.3), CF(0, 4.6, -4.9), DARK)                    -- 射孔里面黑的
    add("hull", V(2, 1.2, 1.8), CF(-7, 4.6, -6.1), CONC, MAT.Concrete)
    add("hull", V(2, 1.2, 1.8), CF(7, 4.6, -6.1), CONC, MAT.Concrete)
    add("hull", V(16, 1.6, 1.8), CF(0, 6.0, -6.1), CONC, MAT.Concrete)      -- 射孔上沿
    add("hull", V(3, 4.4, 0.3), CF(0, 3.0, 7.05), RGB(70, 60, 50), MAT.Wood)   -- 后门
    add("roof", V(17.6, 1.0, 15.6), CF(0, 7.3, -0.2), CONC2, MAT.Concrete)  -- 顶板
    add("roof", V(15, 0.9, 12.4), CF(0, 8.2, 0.4), SOD, MAT.Grass)          -- 顶上覆土
    -- 12.7 毫米机枪：机匣、枪管、提把、枪架
    add("gun", V(0.9, 0.9, 1.9), CF(0, 0, 0.75), GUN, MAT.Metal)
    barrel("gun", 4.4, 0.32, CF(0, 0.05, -2.2), GUN)
    add("gun", V(0.2, 0.35, 0.8), CF(0, 0.6, 0.3), GUN, MAT.Metal)
    add("turret", V(0.35, 1.0, 0.35), CF(0, -0.85, 0.8), GUN, MAT.Metal)
    return V(6.2, 8.7, 5.4)   -- 小旗的位置
  end
  BUILD.coastal = function(add, barrel)
    add("hull", V(1.2, 23, 23), CF(0, 0.6, 0) * UP, CONC2, MAT.Concrete, CYL)   -- 炮位底座
    for k = 1, 9 do   -- 一圈矮墙（后面留入口）
      local a = k * math.pi / 5
      add("hull", V(7.6, 3.2, 1.6), CF(math.sin(a) * 12.2, 2.4, math.cos(a) * 12.2) * CFrame.Angles(0, a, 0), CONC, MAT.Concrete)
    end
    add("turret", V(1.2, 9.6, 9.6), CF(0, -0.9, 0) * UP, GUN, MAT.Metal, CYL)    -- 座圈
    add("turret", V(8.6, 4.6, 8.4), CF(0, 1.9, 1.6), GREY, MAT.Metal)            -- 炮塔（Mk 45 式）
    add("turret", V(8.0, 3.6, 4.4), CF(0, 1.3, -3.6) * CFrame.Angles(math.rad(26), 0, 0), GREY, MAT.Metal)   -- 前面的斜面
    add("turret", V(1.6, 1.0, 1.6), CF(2.6, 4.6, 2.4), GUN, MAT.Metal)            -- 顶上的观察镜
    barrel("gun", 3.2, 1.8, CF(0, 0, -1.4), GREY)                                 -- 炮根护套
    barrel("gun", 20, 0.95, CF(0, 0, -10), GUN)
    return V(9.5, 6.5, 9.5)
  end
  BUILD.aaa = function(add, barrel)
    add("hull", V(8, 0.8, 8), CF(0, 0.6, 0), OLIVE, MAT.Metal)
    for k = 0, 3 do   -- 四条支腿、垫板
      local a = math.pi / 4 + k * math.pi / 2
      local c, s = math.cos(a), math.sin(a)
      add("hull", V(0.7, 0.5, 6.4), CF(c * 4.6, 0.35, s * 4.6) * CFrame.Angles(0, -a + math.pi / 2, 0), OLIVE2, MAT.Metal)
      add("hull", V(1.5, 0.3, 1.5), CF(c * 7.6, 0.15, s * 7.6), DARK, MAT.Metal)
    end
    add("turret", V(1.0, 5.2, 5.2), CF(0, -1.0, 0) * UP, OLIVE2, MAT.Metal, CYL)   -- 转盘
    add("turret", V(4.4, 2.2, 4.4), CF(0, 0.4, 0.6), OLIVE, MAT.Metal)             -- 炮架
    add("turret", V(1.3, 2.0, 3.6), CF(-2.9, 0.9, 0.2), OLIVE, MAT.Metal)          -- 两侧弹仓
    add("turret", V(1.3, 2.0, 3.6), CF(2.9, 0.9, 0.2), OLIVE, MAT.Metal)
    add("turret", V(1.4, 1.2, 1.4), CF(0, 1.1, 2.6), DARK, MAT.Metal)              -- 炮手座、瞄具
    add("gun", V(3.8, 0.9, 2.4), CF(0, 0, 0.4), OLIVE, MAT.Metal)                  -- 摇架
    for s = -1, 1, 2 do
      barrel("gun", 7.6, 0.42, CF(s * 1.5, 0, -3.8), GUN)
      barrel("gun", 0.9, 0.62, CF(s * 1.5, 0, -7.4), DARK)                           -- 消焰器
    end
    return V(4.5, 5.5, 4.5)
  end
  BUILD.howitzer = function(add, barrel)
    for s = -1, 1, 2 do   -- 大架：两条往后叉开，尾巴上驻锄
      add("hull", V(0.9, 0.7, 11), CF(s * 2.1, 0.55, 5.8) * CFrame.Angles(0, s * 0.3, 0), OLIVE, MAT.Metal)
      add("hull", V(1.8, 1.2, 0.4), CF(s * 3.8, 0.45, 10.9) * CFrame.Angles(0, s * 0.3, 0), DARK, MAT.Metal)
      add("hull", V(0.9, 2.6, 2.6), CF(s * 2.6, 1.3, 1.4), DARK, MAT.Rubber, CYL)  -- 车轮
    end
    add("hull", V(4.2, 1.0, 4.2), CF(0, 0.5, 0.6), OLIVE, MAT.Metal)               -- 座盘
    add("hull", V(2.2, 1.1, 1.3), CF(5.2, 0.55, 6.5), RGB(112, 92, 62), MAT.Wood)  -- 弹药箱
    add("hull", V(2.2, 1.1, 1.3), CF(5.6, 1.65, 6.6), RGB(112, 92, 62), MAT.Wood)
    add("net", V(16, 0.25, 22), CF(0, 7.6, 2), OLIVE2, MAT.Fabric)                  -- 伪装网
    add("turret", V(3.2, 1.8, 3.4), CF(0, -0.5, 0), OLIVE, MAT.Metal)              -- 上架
    add("turret", V(0.4, 2.6, 2.6), CF(-1.7, 0.2, -0.2), OLIVE, MAT.Metal)
    add("turret", V(0.4, 2.6, 2.6), CF(1.7, 0.2, -0.2), OLIVE, MAT.Metal)
    barrel("gun", 14.5, 0.7, CF(0, 0, -6.6), OLIVE2)
    add("gun", V(1.6, 1.1, 1.4), CF(0, 0, -14.1), DARK, MAT.Metal)                -- 炮口制退器
    add("gun", V(1.3, 1.3, 1.8), CF(0, 0, 1.0), OLIVE, MAT.Metal)                 -- 炮闩
    for s = -1, 1, 2 do barrel("gun", 6, 0.45, CF(s * 0.38, -0.65, -2.8), GUN) end -- 反后坐装置
    return V(6.5, 8.6, 7.5)
  end

  ---------------------------------------------------------------- 建、动

  local views = {}   -- [实体编号] = v（工事的）
  local function angDiff(a, b) return (b - a + 180) % 360 - 180 end

  local function teamCol(team) return (Config.Teams[team or "def"] or Config.Teams.def).color end

  local function build(v, em, team)
    local kind = em:GetAttribute("Model")
    local d = FD.D[kind or ""]
    local mk = BUILD[kind or ""]
    if not d or not mk then return false end
    local m = Instance.new("Model")
    m.Name = "Fort_" .. kind
    local list = {}
    local function add(grp, size, off, color, mat, shape)
      local part = newPart(m, size, color, mat, shape)
      if grp == "net" then part.Transparency = 0.35 grp = "hull" end
      table.insert(list, { part, grp, off })
      return part
    end
    local function barrel(grp, len, dia, off, color)
      return add(grp, V(len, dia, dia), off * ALONG, color, MAT.Metal, CYL)
    end
    local flagAt = mk(add, barrel)
    -- 队伍色小旗
    add("hull", V(0.2, 4.2, 0.2), CF(flagAt + V(0, -2.1, 0)), RGB(200, 200, 196), MAT.Metal)
    v.flag = add("hull", V(2.6, 1.5, 0.12), CF(flagAt + V(1.35, -0.5, 0)), teamCol(team), MAT.Fabric)
    -- 血条挂点、走过去的提示挂点
    local anchor = newPart(m, V(0.2, 0.2, 0.2), RGB(0, 0, 0))
    anchor.Transparency = 1
    local manA = newPart(m, V(0.4, 0.4, 0.4), RGB(0, 0, 0))
    manA.Transparency = 1
    v.model, v.anchor, v.manA = m, anchor, manA
    v.fd, v.fkind, v.parts = d, kind, list
    v.ty, v.gp, v.recoil = em:GetAttribute("Ty") or 0, em:GetAttribute("Gp") or 0, 0
    v.dirty = true
    v.plist, v.clist = {}, {}
    for i, it in ipairs(list) do v.plist[i] = it[1] end
    local pr = Instance.new("ProximityPrompt")
    pr.ActionText = T("ui.man")
    pr.ObjectText = T("fort." .. kind)
    pr.KeyboardKeyCode = Enum.KeyCode.E
    pr.HoldDuration = 0
    pr.MaxActivationDistance = 12
    pr.RequiresLineOfSight = false
    pr.Enabled = false
    pr.Parent = manA
    pr.Triggered:Connect(function() G.R.Act:FireServer("enterVeh", v.id) end)
    v.prompt = pr
    views[v.id] = v
    return true
  end

  local function wreckIt(v)
    v.wrecked = true
    for _, it in ipairs(v.parts) do
      local part = it[1]
      part.Color = part.Color:Lerp(Color3.new(0.05, 0.05, 0.05), 0.6)
    end
    if v.flag then v.flag.Transparency = 1 end
    local holder = v.anchor
    local fire = Instance.new("Fire")
    fire.Size, fire.Heat = 9, 12
    fire.Parent = holder
    local smoke = Instance.new("Smoke")
    smoke.Color, smoke.Opacity, smoke.RiseVelocity, smoke.Size = RGB(40, 40, 40), 0.6, 6, 8
    smoke.Parent = holder
    task.delay(40, function() if fire.Parent then fire.Enabled = false end end)
    v.dirty = true
  end

  local function step(v, dt, camPos)
    local em = v.em
    local root = v.root
    local d = v.fd
    local base = root.CFrame * CF(0, -d.size.Y / 2, 0)
    -- 队伍（据点被攻方拿下后这处工事归攻方）
    local team = em:GetAttribute("Team")
    if team ~= v.team then
      v.team = team
      if v.flag then v.flag.Color = teamCol(team) end
      if v.fill then v.fill.BackgroundColor3 = teamCol(team) end
    end
    if em:GetAttribute("Wreck") and not v.wrecked then wreckIt(v) end
    -- 炮塔、炮管：自己操作的用本地的，别人的平滑跟属性
    local own = G.gunner and G.gunner.id == v.id and G.gunner
    local ty, gp = em:GetAttribute("Ty") or 0, em:GetAttribute("Gp") or 0
    if v.wrecked then ty, gp = v.ty, d.turret.elev[1] - 8 end
    local oty, ogp = v.ty, v.gp
    if own then v.ty, v.gp = own.ty, own.gp else
      local k = math.min(1, dt * 8)
      v.ty = v.ty + angDiff(v.ty, ty) * k
      v.gp = v.gp + (gp - v.gp) * k
    end
    if v.recoil > 0 then v.recoil = math.max(0, v.recoil - dt * 2.2) v.dirty = true end
    local moved = math.abs(angDiff(oty, v.ty)) > 0.02 or math.abs(ogp - v.gp) > 0.02
    -- 离得远、没动：不用重摆
    if not v.dirty and not moved then return end
    if not v.dirty and (base.Position - camPos).Magnitude > 2200 then return end
    v.dirty = false
    local tF = base * CF(d.turret.pivot) * CFrame.Angles(0, -math.rad(v.ty), 0)
    local kick = (v.fkind == "howitzer") and 2.4 or ((v.fkind == "coastal") and 1.6 or 0.5)
    local gF = tF * CF(d.gun.pivot) * CFrame.Angles(math.rad(v.gp), 0, 0) * CF(0, 0, v.recoil * kick)
    local roofF = base
    if v.wrecked then roofF = base * CF(0, -1.6, 0.4) * CFrame.Angles(0.16, 0, 0.07) end
    local plist, clist = v.plist, v.clist
    for i, it in ipairs(v.parts) do
      local grp, off = it[2], it[3]
      if grp == "turret" then clist[i] = tF * off
      elseif grp == "gun" then clist[i] = gF * off
      elseif grp == "roof" then clist[i] = roofF * off
      else clist[i] = base * off end
    end
    workspace:BulkMoveTo(plist, clist, Enum.BulkMoveMode.FireCFrameChanged)
    v.anchor.CFrame = base * CF(0, d.size.Y + 2, 0)
    v.manA.CFrame = base * CF(FD.MAN[v.fkind])
  end

  local function recoil(v) v.recoil = 1 v.dirty = true end
  local function remove(v) views[v.id] = nil end

  G.viewKind = G.viewKind or {}
  G.viewKind.fort = { build = build, step = step, recoil = recoil, remove = remove }

  ---------------------------------------------------------------- 走过去的提示（工事、空车），每 0.25 秒更新一次

  local promptT = 0
  local function myAlive()
    local ch = me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0 and not G.drive
  end
  function G.stepForts(dt)
    promptT -= dt
    if promptT > 0 then return end
    promptT = 0.25
    local side = me:GetAttribute("Side")
    local ok = myAlive() and G.S and G.S.alive and not (G.S.veh)
    for _, v in pairs(views) do
      local em = v.em
      if v.prompt then
        v.prompt.Enabled = (ok and em.Parent ~= nil and em:GetAttribute("Team") == side and (em:GetAttribute("Gunner") or 0) == 0
          and not em:GetAttribute("Wreck") and (em:GetAttribute("Hp") or 0) > 0) and true or false
      end
    end
    -- 地面载具、飞机：自己队的、没人开的（运输直升机有人开也能坐后面）
    for em, v in pairs(G.views or {}) do
      if (v.kind == "veh" or v.kind == "air") and v.anchor then
        if not v.prompt then
          local pr = Instance.new("ProximityPrompt")
          pr.ActionText = T("ui.board")
          pr.ObjectText = T("veh." .. (v.def and v.def.id or ""))
          pr.KeyboardKeyCode = Enum.KeyCode.E
          pr.HoldDuration = 0
          local d = v.def
          pr.MaxActivationDistance = (v.kind == "air") and math.max(14, math.max(d and d.L or 10, d and d.W or 10) * 0.5 + 8)
            or math.max(12, (d and d.L or 10) * 0.6 + 6)
          pr.RequiresLineOfSight = false
          pr.Parent = v.anchor
          pr.Triggered:Connect(function() G.R.Act:FireServer("enterVeh", v.id) end)
          v.prompt = pr
        end
        local free = (em:GetAttribute("Driver") or 0) == 0 or (v.kind == "air" and v.def and v.def.transport)
        v.prompt.Enabled = (ok and em:GetAttribute("Team") == side and free and not em:GetAttribute("Wreck")
          and not em:GetAttribute("Locked")) and true or false
      end
    end
  end

  ---------------------------------------------------------------- 撞上工事、钢刺猬（开车用）

  local hogs = {}
  do
    local ok, ob = pcall(FD.obstacles, Map)
    if ok and ob then hogs = ob.hog end
  end
  local HOG_R = 2.6
  function G.solidAt(p, r)
    for _, v in pairs(views) do
      local root = v.root
      if root and root.Parent then
        local l = root.CFrame:PointToObjectSpace(p)
        local s = root.Size
        if math.abs(l.X) < s.X / 2 + r and math.abs(l.Z) < s.Z / 2 + r and math.abs(l.Y) < s.Y / 2 + 8 then return true end
      end
    end
    for _, h in ipairs(hogs) do
      local dx, dz = h.x - p.X, h.z - p.Z
      local rr = HOG_R + r
      if dx * dx + dz * dz < rr * rr then return true end
    end
    return false
  end
  G.fortViews = views
end

return FortView
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="84">
          <Properties>
            <string name="Name">Fx</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——特效与音效：曳光、枪口火光、弹着点（钢甲火花、跳弹、土、沙、水）、飞行中的火箭弹 / 导弹 / 手雷（照服务器给的初速本地算弹道）、炮弹落下的呼啸、爆炸、溅水、
--   治疗光圈、修车火花、据点易手、被标记的敌人（头顶红菱形 + 地图红点）、震屏；音效用 Roblox 自带的声音变调（不用上传素材）
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Fx = {}

function Fx.init(G)
  local Config = G.Config
  local V = Vector3.new
  local CF = CFrame.new
  local RGB = Color3.fromRGB
  local cam = workspace.CurrentCamera
  local BALL, CYL = Enum.PartType.Ball, Enum.PartType.Cylinder
  local me = Players.LocalPlayer
  local AD = require(game:GetService("ReplicatedStorage"):WaitForChild("AirDefs"))
  local WM = require(game:GetService("ReplicatedStorage"):WaitForChild("WeaponModels"))
  local MapM = require(game:GetService("ReplicatedStorage"):WaitForChild("Map"))
  local HitSurf = require(game:GetService("ReplicatedStorage"):WaitForChild("HitSurf"))   -- 子弹打在什么上面（弹着点按它画）

  local FXF = Instance.new("Folder")
  FXF.Name = "ClientFx"
  FXF.Parent = workspace
  G.fxFolder = FXF

  local function part(shape, size, cf, color, mat, tr)
    local p = Instance.new("Part")
    if shape then p.Shape = shape end
    p.Size, p.CFrame, p.Color = size, cf, color
    p.Material = mat or Enum.Material.Neon
    p.Transparency = tr or 0
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Parent = FXF
    return p
  end
  G.fxPart = part
  local function tween(o, t, props, style)
    local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
  end
  -- 夜战：一闪的光（枪口焰、炮口、爆炸）——看不见的锚定小零件挂一个点光源，亮度很快降到 0（Future 光照下会照亮四周的地面、墙、车）
  -- 一卡一卡（用户 11-18）：夜里每声枪响、每次爆炸都点一盏，同时亮着的太多（尤其投影子的）显卡一顿一顿——
  --   同时最多 10 盏、投影子的最多 2 盏，离镜头太远（光照范围外再 400 格）的不点
  local liveFlash, liveShadow = 0, 0
  local function flash(p, color, range, bright, t)
    local cam = workspace.CurrentCamera
    if cam and (cam.CFrame.Position - p).Magnitude > range + 400 then return nil end
    if liveFlash >= 10 then return nil end
    local shadows = range > 20 and liveShadow < 2
    local h = part(nil, V(0.2, 0.2, 0.2), CFrame.new(p), color, Enum.Material.SmoothPlastic, 1)
    local pl = Instance.new("PointLight")
    pl.Color, pl.Range, pl.Brightness, pl.Shadows = color, range, bright, shadows
    pl.Parent = h
    tween(pl, t, { Brightness = 0 })
    Debris:AddItem(h, t + 0.05)
    liveFlash += 1
    if shadows then liveShadow += 1 end
    task.delay(t + 0.05, function()
      liveFlash -= 1
      if shadows then liveShadow -= 1 end
    end)
    return pl
  end
  G.flash = flash
  -- 跟着一个零件走的光（导弹尾焰、热诱弹）
  local function glowOn(p, color, range, bright)
    local pl = Instance.new("PointLight")
    pl.Color, pl.Range, pl.Brightness, pl.Shadows = color, range, bright, false
    pl.Parent = p
    return pl
  end
  G.tween = tween

  ---------------------------------------------------------------- 音效

  local EXP = "rbxasset://sounds/impact_explosion_03.mp3"
  local TICK = "rbxasset://sounds/volume_slider.ogg"
  local SND = {
    boom = { EXP, 0.9, 0.8, 1.0 }, rocket = { EXP, 0.35, 1.7, 2.0 }, rifle = { EXP, 0.16, 2.9, 3.3 }, lmg = { EXP, 0.18, 2.7, 3.0 },
    sniper = { EXP, 0.4, 1.9, 2.1 }, pistol = { EXP, 0.14, 3.3, 3.6 }, quiet = { TICK, 0.25, 0.7, 0.8 }, mortar = { EXP, 0.4, 1.2, 1.4 },
    hit = { TICK, 0.5, 2.5, 2.7 }, killding = { TICK, 0.7, 1.7, 1.8 }, heal = { TICK, 0.5, 1.6, 1.7 }, capture = { TICK, 0.9, 1.3, 1.3 },
    hurt = { "rbxasset://sounds/ouch.ogg", 0.45, 1, 1.1 }, splash = { "rbxasset://sounds/action_jump_land.mp3", 0.6, 0.5, 0.6 },
  }
  local soundT, soundN = 0, 0
  function G.playSound(name, pos, speed)
    local def = SND[name]
    if not def then return end
    local t = os.clock()
    if t - soundT > 0.1 then soundT, soundN = t, 0 end
    soundN += 1
    if soundN > 8 then return end
    if pos and (pos - cam.CFrame.Position).Magnitude > 1800 then return end
    local snd = Instance.new("Sound")
    snd.SoundId = def[1]
    snd.Volume = def[2]
    snd.PlaybackSpeed = speed or (def[3] + (def[4] - def[3]) * math.random())
    snd.RollOffMinDistance = 30
    snd.RollOffMaxDistance = 1600
    if pos then
      local p = part(nil, V(0.2, 0.2, 0.2), CFrame.new(pos), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
      snd.Parent = p
      snd:Play()
      Debris:AddItem(p, 5)
    else
      snd.Parent = SoundService
      snd:Play()
      Debris:AddItem(snd, 5)
    end
  end

  ---------------------------------------------------------------- 自动画质（用户：太卡了优化不到位、视野很短）
  -- 按实际帧率调「画多远、画多细」：每两秒算一次平均帧率，连着两次低于 40 帧就往下降一档（树林 Scenery、士兵 Soldier、爆炸粒子都乘 G.perfK），
  --   高于 57 帧慢慢升回去，最高 1.2（机器好的树林画得更远）。G.perfFixed 为真时不调（模拟测试）
  G.perfK, G.frameRate = 1, 60   -- 帧率别叫 G.fps：那是 FPSView 的第一人称视图模型
  do
    local acc, n, low = 0, 0, 0
    RunService.RenderStepped:Connect(function(dt)
      acc += dt
      n += 1
      if acc < 2 then return end
      local fps = n / acc
      acc, n = 0, 0
      G.frameRate = fps
      if G.perfFixed then return end
      local k = G.perfK
      if fps < 40 then
        low += 1
        if low >= 2 then k = math.max(0.55, k - ((fps < 28) and 0.15 or 0.08)) end
      else
        low = 0
        if fps > 57 then k = math.min(1.2, k + 0.04) end
      end
      G.perfK = math.floor(k * 100 + 0.5) / 100
    end)
  end

  ---------------------------------------------------------------- 武器音效：几层叠起来（Roblox 自带的声音只有十来个：爆炸、风、水、咔哒……
  --   content/sounds 里就这些，不用上传素材）——截一段、循环一小段、变速、加效果（失真、均衡、回声）做出不同武器的声音：
  --   航炮：循环爆炸声起爆的那一小段，一圈正好一发（射速快的连成「嗡——」，链式炮一下一下的）；火箭弹：短促的「噗」+ 呼的一下；
  --   导弹：低沉的点火声 + 跟着弹飞走的发动机呼啸（风声加失真）；炸弹：挂架弹开「咣」一声；爆炸按大小分（远处的晚一点到、高音被吃掉）
  local WIND = "rbxasset://sounds/action_falling.ogg"
  local THUD = "rbxasset://sounds/action_jump_land.mp3"
  local WATER = "rbxasset://sounds/impact_water.mp3"
  local LEN = { [EXP] = 2.59, [WIND] = 10, [TICK] = 0.85, [THUD] = 0.27, [WATER] = 2.38 }
  local SFX = {
    -- 每层：id 采样、vol 音量、s 速度范围、reg 截取（采样里的秒）、loop 循环区间、eq {低, 中, 高} 分贝、dist 失真、echo {延迟, 反馈, 湿声分贝}、
    --   delay 晚几秒、fade 最后几秒淡出
    rkt = { { id = EXP, vol = 0.5, s = { 1.25, 1.4 }, reg = { 0.04, 0.34 }, eq = { 3, 0, -4 } },
      { id = WIND, vol = 10, s = { 1.7, 1.9 }, reg = { 2, 3.5 }, eq = { 0, 10, 3 }, fade = 0.4 } },
    msl = { { id = EXP, vol = 0.65, s = { 0.78, 0.86 }, reg = { 0.04, 1.2 }, eq = { 6, 0, -5 } },
      { id = WIND, vol = 10, s = { 1.05, 1.15 }, reg = { 3, 5.2 }, eq = { 4, 10, 0 }, dist = 0.5, fade = 0.8 } },
    bombRel = { { id = TICK, vol = 1, s = { 0.3, 0.34 } }, { id = THUD, vol = 0.8, s = { 0.5, 0.56 } } },
    -- 子弹从耳边飞过：一下尖的「嗖」（风声截短、拉快、削掉低音）+ 一声脆响
    whiz = { { id = WIND, vol = 7, s = { 2.6, 3.3 }, reg = { 2.1, 2.45 }, eq = { -12, 4, 8 } }, { id = TICK, vol = 0.45, s = { 3.6, 4.2 } } },
    -- 音爆（AirFx.lua）：N 形波的头尾两声连着的低沉「嘭——嘭」，放慢、失真、削掉高音；远处的人按距离晚到
    sonic = { { id = EXP, vol = 1.2, s = { 0.5, 0.55 }, reg = { 0, 1.7 }, eq = { 10, 0, -16 }, dist = 0.55 },
      { id = EXP, vol = 1, s = { 0.47, 0.5 }, reg = { 0, 1.5 }, eq = { 10, -2, -18 }, dist = 0.55, delay = 0.14 } },
    -- 爽感（Juice.lua）：爆头——打在头盔上的一声脆「叮」；连杀——往上走的三声；低血量——一下一下的心跳
    headshot = { { id = TICK, vol = 1, s = { 3.3, 3.4 }, eq = { -10, 2, 6 } }, { id = TICK, vol = 0.7, s = { 4.7, 4.8 }, eq = { -10, 0, 8 }, delay = 0.035 } },
    streak = { { id = TICK, vol = 0.8, s = { 1.6, 1.6 } }, { id = TICK, vol = 0.8, s = { 2.0, 2.0 }, delay = 0.09 }, { id = TICK, vol = 0.9, s = { 2.5, 2.5 }, delay = 0.18 },
      { id = EXP, vol = 0.25, s = { 1.6, 1.7 }, reg = { 0.02, 0.3 }, eq = { 6, 0, -8 } } },
    heart = { { id = THUD, vol = 1.6, s = { 0.5, 0.52 }, eq = { 10, -4, -24 } }, { id = THUD, vol = 1.1, s = { 0.47, 0.49 }, eq = { 10, -4, -24 }, delay = 0.24 } },
    -- 自己开枪（耳边，用户 11-18：提高手感；原来是一层拉快的爆炸声，薄）：脆的一下（起爆那一截拉快）+ 低沉的一下（放慢、只留低音）
    --   + 枪机的咔哒 + 很短的回声尾巴；狙击枪更重、尾巴更长
    rifleMe = { { id = EXP, vol = 0.3, s = { 2.5, 2.8 }, reg = { 0.02, 0.3 }, eq = { -3, 2, 4 } },
      { id = EXP, vol = 0.3, s = { 1.28, 1.4 }, reg = { 0, 0.34 }, eq = { 9, -3, -12 } },
      { id = TICK, vol = 0.18, s = { 1.9, 2.2 }, eq = { -6, 2, 2 }, delay = 0.012 },
      { id = EXP, vol = 0.08, s = { 0.95, 1.05 }, reg = { 0.06, 1.0 }, eq = { 2, -2, -14 }, echo = { 0.13, 0.2, -14 }, delay = 0.03 } },
    sniperMe = { { id = EXP, vol = 0.5, s = { 1.9, 2.05 }, reg = { 0.02, 0.4 }, eq = { -2, 2, 4 } },
      { id = EXP, vol = 0.5, s = { 0.9, 0.98 }, reg = { 0, 0.55 }, eq = { 10, -2, -12 } },
      { id = TICK, vol = 0.25, s = { 1.2, 1.35 }, eq = { -4, 2, 0 }, delay = 0.5 },
      { id = EXP, vol = 0.16, s = { 0.7, 0.76 }, reg = { 0.05, 1.8 }, eq = { 4, -2, -14 }, echo = { 0.22, 0.3, -10 }, delay = 0.05 } },
    dry = { { id = TICK, vol = 0.6, s = { 1.45, 1.55 }, eq = { -6, 3, 0 } } },   -- 打空了扣扳机
    brass = { { id = TICK, vol = 0.07, s = { 3.3, 3.9 }, eq = { -14, 0, 4 } }, { id = TICK, vol = 0.05, s = { 3.6, 4.2 }, eq = { -14, 0, 4 }, delay = 0.09 } },   -- 弹壳落地
    -- 弹着点（用户：枪打在坦克上要有火花）：子弹打在钢甲上一声脆的「叮」+ 一下金属的「嚓」；重机枪、航炮打上去低一点、重一点的「当」；
    --   跳弹飞走一声尖细的「啾——」；打在土、石头上闷闷的一下
    ping = { { id = TICK, vol = 0.85, s = { 2.6, 3.3 }, eq = { -12, 2, 6 } }, { id = EXP, vol = 0.14, s = { 2.6, 3.0 }, reg = { 0.02, 0.16 }, eq = { -12, 0, 6 } } },
    clang = { { id = TICK, vol = 1, s = { 1.45, 1.8 }, eq = { -6, 3, 4 } }, { id = EXP, vol = 0.3, s = { 1.7, 1.95 }, reg = { 0.02, 0.22 }, eq = { -4, 2, 2 } } },
    ric = { { id = WIND, vol = 6, s = { 2.8, 3.5 }, reg = { 2.15, 2.5 }, eq = { -14, 6, 6 } } },
    thud = { { id = THUD, vol = 0.45, s = { 1.6, 2.1 }, eq = { 0, 0, -4 } } },
    -- 坦克炮（用户：开火动画做的好一点）：起爆那一截拉快的脆响 + 放慢、失真、只留低音的轰隆 + 拖得很长的回声尾巴
    tankGun = { { id = EXP, vol = 0.9, s = { 1.5, 1.65 }, reg = { 0.02, 0.4 }, eq = { -2, 3, 4 } },
      { id = EXP, vol = 1.2, s = { 0.58, 0.64 }, reg = { 0, 2.2 }, eq = { 12, 0, -14 }, dist = 0.4 },
      { id = EXP, vol = 0.35, s = { 0.5, 0.55 }, reg = { 0.1, 2.4 }, eq = { 6, -2, -16 }, echo = { 0.3, 0.35, -8 }, delay = 0.08 } },
    -- 炮弹跳弹：钢甲上一声重的「当」+ 一下金属的「嚓」+ 尖啸着飞走
    shellRic = { { id = TICK, vol = 1, s = { 0.9, 1.05 }, eq = { -4, 4, 4 } }, { id = EXP, vol = 0.4, s = { 2.2, 2.5 }, reg = { 0.02, 0.2 }, eq = { -6, 2, 6 } },
      { id = WIND, vol = 8, s = { 2.2, 2.8 }, reg = { 2.1, 2.9 }, eq = { -14, 6, 8 }, delay = 0.03, fade = 0.2 } },
  }
  -- 导弹飞行中的发动机声：挂在弹上跟着飞走（燃烧完就停）
  local ROAR = { id = WIND, vol = 10, s = { 0.95, 1.05 }, loop = { 0.5, 9.5 }, eq = { 6, 10, -1 }, dist = 0.55 }

  local function makeSound(L, parent, o)
    local snd = Instance.new("Sound")
    snd.SoundId = L.id
    snd.Volume = math.min(10, L.vol * (o.vol or 1))
    local sp = (L.s[1] + (L.s[2] - L.s[1]) * math.random()) * (o.speed or 1)
    snd.PlaybackSpeed = sp
    snd.RollOffMinDistance = o.rmin or 40
    snd.RollOffMaxDistance = o.rmax or 1800
    if L.reg or L.loop then
      snd.PlaybackRegionsEnabled = true
      if L.reg then snd.PlaybackRegion = NumberRange.new(L.reg[1], L.reg[2]) end
      if L.loop then
        snd.Looped = true
        snd.LoopRegion = NumberRange.new(L.loop[1], L.loop[2])
      end
    end
    local hi = (L.eq and L.eq[3] or 0) + (o.hiCut or 0)
    if L.eq or hi ~= 0 then
      local e = Instance.new("EqualizerSoundEffect")
      e.LowGain, e.MidGain, e.HighGain = L.eq and L.eq[1] or 0, L.eq and L.eq[2] or 0, math.max(-80, hi)
      e.Parent = snd
    end
    if L.dist then
      local e = Instance.new("DistortionSoundEffect")
      e.Level = L.dist
      e.Parent = snd
    end
    if L.echo then
      local e = Instance.new("EchoSoundEffect")
      e.Delay, e.Feedback, e.WetLevel, e.DryLevel = L.echo[1], L.echo[2], L.echo[3], 0
      e.Parent = snd
    end
    snd.Parent = parent
    snd:Play()
    local len = L.loop and math.huge or ((L.reg and (L.reg[2] - L.reg[1]) or LEN[L.id] or 3) / sp + (L.echo and L.echo[1] * 8 or 0))
    if L.fade and len < math.huge then
      task.delay(math.max(0, len - L.fade), function() if snd.Parent then tween(snd, L.fade, { Volume = 0 }, Enum.EasingStyle.Linear) end end)
    end
    return snd, len
  end
  G.makeSound = makeSound

  -- 放一个叠层的声音：def 是 SFX 的名字或层表；pos 是世界坐标（nil：耳边）；o：vol 音量倍数、speed、delay 晚几秒、hiCut 高音衰减、rmax 传多远
  local sfxT, sfxN = 0, 0
  function G.sfx(def, pos, o)
    if type(def) == "string" then def = SFX[def] end
    if not def then return end
    o = o or {}
    local t = os.clock()
    if t - sfxT > 0.1 then sfxT, sfxN = t, 0 end
    if sfxN >= 10 and not o.must then return end
    sfxN += 1
    local function go()
      local holder = pos and part(nil, V(0.2, 0.2, 0.2), CFrame.new(pos), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1) or nil
      local longest = 0
      for _, L in ipairs(def) do
        local function one()
          local snd, len = makeSound(L, holder or SoundService, o)
          if not holder then Debris:AddItem(snd, len + 0.3) end
        end
        if L.delay then task.delay(L.delay, one) else one() end
        local sp = (L.s[1] + L.s[2]) / 2 * (o.speed or 1)
        longest = math.max(longest, (L.delay or 0) + (L.reg and (L.reg[2] - L.reg[1]) or LEN[L.id] or 3) / sp + (L.echo and L.echo[1] * 8 or 0))
      end
      if holder then Debris:AddItem(holder, longest + 0.5) end
    end
    if o.delay and o.delay > 0.03 then task.delay(o.delay, go) else go() end
  end

  -- 航炮：每架开火的飞机一个循环声（自己开的在耳边，别人的在炮口那里）；循环的是爆炸声起爆那一小段，一圈 = 一发（射速）
  local guns = {}
  local function gunLayer(w)
    local per = w.rate or 0.05
    local sp = math.clamp(0.05 / per, 0.9, 2.6)   -- 射速快的放快一点：一圈里能装下起爆的那一下（M61 尖、GAU-8 粗、链式炮一下一下）
    local a = 0.044   -- 采样里起爆前一点点
    return { id = EXP, vol = 1, s = { sp, sp }, loop = { a, a + per * sp }, eq = { (per > 0.03) and 7 or 4, 0, (per < 0.02) and 2 or -3 } }
  end
  function G.gunLoop(key, gid, p, on)
    local g = guns[key]
    if g and (not on or g.gid ~= gid) then
      g.snd:Destroy()
      if g.holder then g.holder:Destroy() end
      guns[key], g = nil, nil
    end
    if not on then return end
    local w = AD.W[gid or ""]
    if not w then return end
    if not g then
      local holder = p and part(nil, V(0.2, 0.2, 0.2), CFrame.new(p), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1) or nil
      local snd = makeSound(gunLayer(w), holder or SoundService, { vol = holder and 0.9 or 0.42, rmin = 60, rmax = 3000 })
      g = { snd = snd, holder = holder, gid = gid }
      guns[key] = g
    elseif p and g.holder then
      g.holder.CFrame = CFrame.new(p)
    end
    g.till = (key == "me") and math.huge or (os.clock() + 0.25)   -- 别人的：0.25 秒没再收到炮弹就停（服务器每 0.1 秒发一发）
  end
  local function stepGuns()
    local t = os.clock()
    for k, g in pairs(guns) do
      if t > g.till then G.gunLoop(k, nil, nil, false) end
    end
  end

  -- 镜头上的震屏和开枪后坐（用户 11-18：提高手感）
  --   Roblox 自带的镜头（步行时）每帧从「现在的朝向」接着算：往 cam.CFrame 上加的俯仰、偏航会一直留下。原来震屏每帧加全量，
  --   炸一下准星就被甩到别处（随机游走）；后坐每发一下子跳 1～1.7°、不回落，一梭子打完视线往上飘四五十度。现在分两份：
  --   · 一下就回来的（震屏、后坐的「踢」——弹簧，约 0.03 秒到顶、0.15 秒回到原处）：步行时每帧只加这一帧的增量，晃完视线回到原处；
  --     开车、开飞机是脚本镜头（每帧重新摆），照旧加全量。横滚每帧都被 Roblox 镜头摆正，加全量
  --   · 留下来的（后坐的上抬、左右飘）：几帧里平滑加上去（不是一下跳），要自己往下压枪
  local trauma = 0
  function G.shake(a) trauma = math.min(1, trauma + a) end
  local pp, py, pr, vp, vy, vr = 0, 0, 0, 0, 0, 0   -- 踢：俯仰、偏航、横滚（弧度）和角速度
  local climbP, climbY = 0, 0                       -- 还没加上去的上抬、左右飘
  local aP, aY = 0, 0                               -- 步行时已经加进镜头朝向里的「一下就回来的」那份
  local SPR = 30                                    -- 弹簧角频率（临界阻尼）
  pcall(function()
    RunService:BindToRenderStep("IAShake", Enum.RenderPriority.Last.Value, function(dt)
      dt = math.min(dt, 0.1)
      if trauma <= 0.002 and climbP == 0 and climbY == 0 and math.abs(pp) + math.abs(py) + math.abs(pr) + math.abs(vp) + math.abs(vy) + math.abs(vr) < 1e-5
        and aP == 0 and aY == 0 then
        pp, py, pr, vp, vy, vr = 0, 0, 0, 0, 0, 0
        return
      end
      local n = math.max(1, math.ceil(dt / (1 / 240)))   -- 弹簧分小步算（帧率低时不发散）
      local h = dt / n
      for _ = 1, n do
        vp += (-SPR * SPR * pp - 2 * SPR * vp) * h
        vy += (-SPR * SPR * py - 2 * SPR * vy) * h
        vr += (-SPR * SPR * pr - 2 * SPR * vr) * h
        pp += vp * h
        py += vy * h
        pr += vr * h
      end
      local sP, sY, sR = 0, 0, 0
      if trauma > 0.002 then
        local s = trauma * trauma
        local t = os.clock() * 26
        sP, sY, sR = math.noise(t, 1.7) * 0.05 * s, math.noise(t, 5.3) * 0.05 * s, math.noise(t, 9.1) * 0.03 * s
        trauma = math.max(0, trauma - dt * 1.6)
      else
        trauma = 0
      end
      local tP, tY, tR = pp + sP, py + sY, pr + sR
      local f = 1 - math.exp(-dt * 40)   -- 上抬几帧里加完（60 帧时一帧加一半）
      local cP, cY = climbP * f, climbY * f
      climbP -= cP
      climbY -= cY
      if math.abs(climbP) < 1e-6 then climbP = 0 end
      if math.abs(climbY) < 1e-6 then climbY = 0 end
      if cam.CameraType == Enum.CameraType.Scriptable then
        cam.CFrame = cam.CFrame * CFrame.Angles(tP, tY, tR)
        aP, aY = 0, 0
      else
        cam.CFrame = cam.CFrame * CFrame.Angles(cP + tP - aP, cY + tY - aY, tR)
        aP, aY = tP, tY
        if math.abs(aP) < 1e-6 and math.abs(aY) < 1e-6 and trauma == 0 then aP, aY = 0, 0 end
      end
    end)
  end)
  -- 开枪的后坐：up 每发留下来的上抬（度）、side 左右飘、punch 一下就回来的踢、roll 踢的横滚；开镜（ads）上抬 × 0.45、踢 × 0.45
  --   （开着 3.5 倍镜，同样的角度看着大三倍多）；一梭子的头一发 × 0.55，越打越大，第五发起 × 1.15（点射稳、扫射飘）；
  --   左右飘按一梭子里慢慢摆（每梭子起点随机），不是每发乱跳
  local RC = { m4 = { up = 0.3, side = 0.12, punch = 1.0, roll = 0.5 }, sniper = { up = 1.8, side = 0.35, punch = 3.4, roll = 1.2 } }
  local burstN, lastShot, driftPh = 0, 0, 0
  function G.kick(w, ads, id)
    local d = w.dmg or 20
    local rc = RC[id or ""] or { up = d * 0.012, side = d * 0.0045, punch = d * 0.04, roll = 0.5 }
    local t = os.clock()
    if t - lastShot > (w.rate or 0.1) * 2.5 + 0.08 then
      burstN = 0
      driftPh = math.random() * 2 * math.pi
    end
    lastShot = t
    burstN += 1
    local k = math.min(1.15, 0.55 + 0.15 * (burstN - 1)) * (ads and 0.45 or 1)
    local r = math.rad
    climbP += r(rc.up) * k * (0.85 + math.random() * 0.3)
    climbY += r(rc.side) * k * (math.sin(driftPh + burstN * 0.55) * 0.8 + (math.random() - 0.5) * 0.9)
    local v0 = r(rc.punch) * (ads and 0.45 or 1) * SPR * math.exp(1)   -- 临界阻尼弹簧：初速 v0 的峰值 = v0 / (ω·e)
    vp += v0 * (0.9 + math.random() * 0.2)
    vy += v0 * 0.25 * (math.random() - 0.5)
    vr += r(rc.roll) * (ads and 0.5 or 1) * SPR * math.exp(1) * (math.random() - 0.5) * 2
  end

  ---------------------------------------------------------------- 曳光、枪口火光

  local TRACER = { m4 = RGB(255, 220, 140), rifle = RGB(255, 220, 140), lmg = RGB(255, 190, 110), sniper = RGB(255, 245, 210),
    hmg = RGB(255, 96, 52), coax = RGB(255, 150, 70) }
  -- 车载机枪（遥控武器站的 M2、并列机枪）：曳光弹粗、长、亮，外面再套一层淡的光晕，飞得慢一点看得清（用户：机枪开火子弹要明显、要有曳光弹）
  local HEAVY = { hmg = { r = 0.32, len = 30, glow = 1.1, speed = 640 }, coax = { r = 0.24, len = 24, glow = 0.8, speed = 700 } }
  -- 一卡一卡（用户 11-18）：几十个机器人一起开枪，每一发都新建曳光、枪口火、灯光、弹着点的灰——一秒几百个零件加补间。
  --   别人打的：枪口离镜头 900 格外、弹道也没从镜头 300 格内擦过的不画；350 格外的只画曳光（不点灯、没有枪口火球和弹着灰）；
  --   画全套的每秒最多 50 发（多出来的也只画曳光）。自己打的照旧全画
  local gunTok, gunTokT = 50, 0
  local impact, probeAt   -- 弹着点（下面「弹着点」一节）
  local IMPK = { hmg = 1.7, coax = 1.4, ciws = 2, agun = 2, ac = 2, sniper = 1.3, lmg = 1.1 }   -- 弹着点的大小（按口径：步枪 1）
  -- h：打在什么上面（HitSurf 代号；别人打的服务器给，nil 是什么都没打中；自己打的不给，本地探一下）
  function G.gunFx(id, a, b, mine, h)
    local d = b - a
    local L = d.Magnitude
    if L < 0.5 then return end
    local lite = false
    if not mine then
      local c = workspace.CurrentCamera and workspace.CurrentCamera.CFrame.Position or a
      local da = (a - c).Magnitude
      if da > 350 then
        local u = math.clamp((c - a):Dot(d) / (L * L), 0, 1)
        if da > 900 and (a + d * u - c).Magnitude > 300 then return end
        lite = true
      end
      local now = os.clock()
      gunTok = math.min(50, gunTok + (now - gunTokT) * 50)
      gunTokT = now
      if not lite then
        if gunTok >= 1 then gunTok -= 1 else lite = true end
      end
    end
    local col = TRACER[id] or RGB(255, 220, 140)
    local hv = HEAVY[id]
    local len = math.min(L, hv and hv.len or 14)
    local r = hv and hv.r or 0.12
    local speed = hv and hv.speed or 900
    local tr = part(nil, V(r, r, len), CFrame.lookAt(a + d.Unit * len / 2, b), col, Enum.Material.Neon, hv and 0 or 0.1)
    local tw = tween(tr, L / speed, { CFrame = CFrame.lookAt(b - d.Unit * len / 2, b + d.Unit) }, Enum.EasingStyle.Linear)
    Debris:AddItem(tr, L / speed + 0.05)
    if hv and not lite then   -- 光晕：同一条线上粗一圈、很淡
      local gl = part(nil, V(hv.glow, hv.glow, len * 0.8), CFrame.lookAt(a + d.Unit * len / 2, b), col, Enum.Material.Neon, 0.78)
      tween(gl, L / speed, { CFrame = CFrame.lookAt(b - d.Unit * len * 0.4, b + d.Unit) }, Enum.EasingStyle.Linear)
      Debris:AddItem(gl, L / speed + 0.05)
    end
    if not lite then
      local fl = part(BALL, V(0.9, 0.9, 0.9), CFrame.new(a), RGB(255, 210, 120), Enum.Material.Neon, 0.2)
      tween(fl, 0.06, { Transparency = 1, Size = V(1.4, 1.4, 1.4) })
      Debris:AddItem(fl, 0.08)
      if id ~= "smgsd" then flash(a, RGB(255, 196, 120), 14, 3.2, 0.07) end   -- 枪口焰照亮四周（消音的没有）
    end
    -- 弹着点（原来不管打中什么都是一小团灰，打到天上也有）：按打中的东西画，曳光飞到了才出；
    --   远处只画钢甲上的火花（看得见）。打中的零件记下来，飞到时按它现在的位置画（车在走，火花跟着车身）
    if not lite or (h and HitSurf.METAL[h]) then
      local du = d.Unit
      local res = (h or mine) and probeAt(b, du) or nil
      if mine and h == nil and res then h = HitSurf.of(res.Instance, res.Material) end
      if h then
        local hp, rel, nl = nil, nil, nil
        if res then
          hp = res.Instance
          rel, nl = hp.CFrame:PointToObjectSpace(res.Position), hp.CFrame:VectorToObjectSpace(res.Normal)
        end
        local k = IMPK[id] or 1
        task.delay(L / speed, function()
          local p, nrm = b, nil
          if hp and hp.Parent then p, nrm = hp.CFrame * rel, hp.CFrame:VectorToWorldSpace(nl) end
          impact(p, du, h, k, nrm)
        end)
      end
    end
    if mine and (id == "m4" or id == "sniper" or id == "rifle") then   -- 自己开的：耳边叠层的枪声，弹壳过一会儿落地
      G.sfx((id == "sniper") and "sniperMe" or "rifleMe", nil, { must = true })
      if math.random() < 0.35 then G.sfx("brass", nil, { delay = 0.35 + math.random() * 0.25 }) end
      return
    end
    local snd = (id == "smgsd") and "quiet" or ((id == "sniper" or id == "lmg" or id == "pistol") and id or "rifle")
    G.playSound(snd, a)
  end

  ---------------------------------------------------------------- 爆炸
  --   按武器分（服务器 G.explode 给类别 c）：gun 航炮 / 小口径炮弹、nade 手雷 / 炸药、shell 炮弹 / 地雷、rkt 火箭弹、msl 导弹、bomb 炸弹、
  --   flak 高炮空炸、wreck 车 / 飞机 / 舰被击毁；没给的按大小猜。全用粒子（Roblox 自带的爆炸贴图）：白热闪光、翻卷的火球、地上冲起的尘土柱、
  --   乱飞的碎块和火星、贴地冲击波圈和一圈扬尘、往上飘的烟柱（炸弹的飘十来秒），大的还留一会儿余火；海面上是白色水柱和水雾；
  --   半空炸是一团火 + 一团黑烟。用户：导弹、炮弹爆炸效果都很小，要按不同武器改
  local TX = {
    core = "rbxasset://textures/particles/explosion01_core_main.dds",       -- 火球（橙色、翻卷）
    ring = "rbxasset://textures/particles/explosion01_shockwave_main.dds",  -- 冲击波圈
    glow = "rbxasset://textures/particles/explosion01_implosion_main.dds",  -- 白热的一团（闪光、火星）
    fire = "rbxasset://textures/particles/fire_main.dds",
    smoke = "rbxasset://textures/particles/smoke_main.dds",
    chunk = "rbxasset://textures/particles/SquareParticle.png",
  }
  local NSK, CSK = NumberSequenceKeypoint.new, ColorSequenceKeypoint.new
  local function nseq(...)
    local a, kp = { ... }, {}
    for i = 1, #a, 2 do kp[#kp + 1] = NSK(a[i], a[i + 1]) end
    return NumberSequence.new(kp)
  end
  local function cseq(a, b) return ColorSequence.new({ CSK(0, a), CSK(1, b) }) end
  -- 一组粒子：n 个，tex 贴图、life / spd 范围、size / tr 序列、col 颜色、acc 加速度、drag 阻力、le 自发光、dir 方向、spread 散开角、
  --   flat 平躺（冲击波圈）、radial 沿地面一圈往外（零件绕竖轴转着发，发射方向跟着零件转）、rate 持续冒（余火）
  local function burst(h, o)
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = o.tex
    pe.Rate = 0
    pe.Lifetime = NumberRange.new(o.life[1], o.life[2])
    pe.Speed = NumberRange.new(o.spd[1], o.spd[2])
    pe.SpreadAngle = Vector2.new(o.spread or 180, o.spread or 180)
    pe.Size = o.size
    pe.Transparency = o.tr
    pe.Color = o.col
    pe.Acceleration = o.acc or V()
    pe.Drag = o.drag or 0
    pe.LightEmission = o.le or 0
    pe.LightInfluence = (o.le or 0) > 0.5 and 0 or 1
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-(o.rot or 40), o.rot or 40)
    pe.ZOffset = o.z or 0
    pe.EmissionDirection = o.dir or Enum.NormalId.Top
    if o.flat then pe.Orientation = Enum.ParticleOrientation.VelocityPerpendicular end
    pe.Parent = h
    if o.rate then
      pe.Rate = o.rate
    elseif o.radial then
      local base = h.CFrame
      for i = 1, o.n do
        h.CFrame = base * CFrame.Angles(0, (i + math.random() * 0.6) * 2 * math.pi / o.n, 0)
        pe:Emit(1)
      end
      h.CFrame = base
    else
      pe:Emit(o.n)
    end
    return pe
  end

  ---------------------------------------------------------------- 弹着点
  -- 用户：枪打在坦克上要有火花。按打中的东西（HitSurf：别人打的服务器给，自己打的本地判）：
  --   钢甲（坦克、步战车、舰艇）——白热的一闪 + 一蓬往外溅的火星（细长、带重力、一下就灭）+ 一小缕青烟，三成子弹跳弹（擦着打的六成：
  --     一小段曳光斜着飞走），「叮」的一声（重机枪、航炮是低一点的「当」）；轻型车、飞机：火星少一点；炮弹直接命中（服务器的 spark）一大团；
  --   土、草地——往上踢起一股土和碎渣；沙——黄沙；石头、水泥、工事——灰尘、碎屑，偶尔一两颗火星；木头——木屑；水——一股细水柱；人——一小团灰
  --   粒子发射器常驻（每种一个看不见的小零件，打中了挪过去、朝该溅的方向 Emit，飞出去的粒子留在原地），不每发都新建零件；每秒最多 40 处
  local IMP = {}
  local function impEmitter(name, o)
    local h = part(nil, V(0.2, 0.2, 0.2), CFrame.new(0, -500, 0), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    h.Name = "Imp_" .. name
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = o.tex
    pe.Rate = 0
    pe.Lifetime = NumberRange.new(o.life[1], o.life[2])
    pe.Speed = NumberRange.new(o.spd[1], o.spd[2])
    pe.SpreadAngle = Vector2.new(o.spread or 30, o.spread or 30)
    pe.Size = o.size
    pe.Transparency = o.tr
    pe.Color = o.col
    pe.Acceleration = o.acc or V()
    pe.Drag = o.drag or 0
    pe.LightEmission = o.le or 0
    pe.LightInfluence = (o.le or 0) > 0.5 and 0 or 1
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-(o.rot or 0), o.rot or 0)
    pe.ZOffset = o.z or 0
    pe.EmissionDirection = Enum.NormalId.Top
    if o.streak then   -- 火星：顺着飞的方向拉成细长一道（Squash：老版本没有这个属性就算了）
      pe.Orientation = Enum.ParticleOrientation.VelocityParallel
      pe.Rotation = NumberRange.new(0)
      pcall(function() pe.Squash = o.streak end)
    end
    if o.bright then pe.Brightness = o.bright end
    pe.Parent = h
    IMP[name] = { h = h, pe = pe, spd = o.spd }
  end
  local SPARK_C = cseq(RGB(255, 250, 225), RGB(255, 132, 36))
  impEmitter("spark", { tex = TX.glow, life = { 0.12, 0.36 }, spd = { 22, 60 }, spread = 62, size = nseq(0, 0.3, 0.6, 0.2, 1, 0),
    tr = nseq(0, 0, 0.7, 0.15, 1, 1), col = SPARK_C, acc = V(0, -70, 0), drag = 3.5, le = 1, bright = 4, streak = nseq(0, 2.6, 1, 1.4), z = 0.5 })
  impEmitter("spark2", { tex = TX.glow, life = { 0.18, 0.55 }, spd = { 26, 72 }, spread = 70, size = nseq(0, 0.5, 0.6, 0.32, 1, 0),
    tr = nseq(0, 0, 0.7, 0.15, 1, 1), col = SPARK_C, acc = V(0, -70, 0), drag = 3, le = 1, bright = 5, streak = nseq(0, 2.8, 1, 1.5), z = 0.5 })
  impEmitter("flash", { tex = TX.glow, life = { 0.05, 0.08 }, spd = { 0, 0 }, spread = 0, size = nseq(0, 1.3, 1, 2.4),
    tr = nseq(0, 0, 1, 1), col = cseq(RGB(255, 255, 240), RGB(255, 205, 130)), le = 1, bright = 5, z = 1 })
  impEmitter("flash2", { tex = TX.glow, life = { 0.06, 0.1 }, spd = { 0, 0 }, spread = 0, size = nseq(0, 2.6, 1, 4.6),
    tr = nseq(0, 0, 1, 1), col = cseq(RGB(255, 255, 240), RGB(255, 200, 120)), le = 1, bright = 6, z = 1 })
  impEmitter("flash3", { tex = TX.glow, life = { 0.08, 0.13 }, spd = { 0, 0 }, spread = 0, size = nseq(0, 5, 1, 10),
    tr = nseq(0, 0, 1, 1), col = cseq(RGB(255, 255, 245), RGB(255, 190, 100)), le = 1, bright = 7, z = 1 })
  impEmitter("smoke", { tex = TX.smoke, life = { 0.5, 0.9 }, spd = { 1.5, 4 }, spread = 25, size = nseq(0, 0.5, 1, 2.4),
    tr = nseq(0, 0.55, 1, 1), col = cseq(RGB(150, 150, 146), RGB(118, 118, 116)), acc = V(0, 3, 0), drag = 2, rot = 30 })
  impEmitter("dirt", { tex = TX.smoke, life = { 0.35, 0.8 }, spd = { 8, 18 }, spread = 22, size = nseq(0, 0.6, 0.4, 1.8, 1, 2.8),
    tr = nseq(0, 0.25, 0.6, 0.55, 1, 1), col = cseq(RGB(112, 92, 66), RGB(148, 128, 98)), acc = V(0, -24, 0), drag = 2.5, rot = 40 })
  impEmitter("sand", { tex = TX.smoke, life = { 0.4, 0.9 }, spd = { 8, 18 }, spread = 24, size = nseq(0, 0.6, 0.4, 1.9, 1, 3),
    tr = nseq(0, 0.25, 0.6, 0.55, 1, 1), col = cseq(RGB(212, 188, 138), RGB(228, 210, 170)), acc = V(0, -22, 0), drag = 2.5, rot = 40 })
  impEmitter("rock", { tex = TX.smoke, life = { 0.4, 0.85 }, spd = { 6, 15 }, spread = 26, size = nseq(0, 0.5, 0.4, 1.6, 1, 2.6),
    tr = nseq(0, 0.3, 0.6, 0.6, 1, 1), col = cseq(RGB(150, 148, 142), RGB(186, 183, 176)), acc = V(0, -10, 0), drag = 2.5, rot = 40 })
  impEmitter("chips", { tex = TX.chunk, life = { 0.3, 0.6 }, spd = { 14, 30 }, spread = 35, size = nseq(0, 0.22, 1, 0.12),
    tr = nseq(0, 0, 1, 0.4), col = cseq(RGB(72, 64, 54), RGB(72, 64, 54)), acc = V(0, -90, 0), drag = 1, rot = 360 })
  impEmitter("spout", { tex = TX.smoke, life = { 0.35, 0.6 }, spd = { 16, 26 }, spread = 7, size = nseq(0, 0.35, 0.5, 0.8, 1, 1.3),
    tr = nseq(0, 0.15, 0.7, 0.5, 1, 1), col = cseq(RGB(236, 243, 246), RGB(220, 230, 236)), acc = V(0, -75, 0), drag = 1, rot = 20 })
  impEmitter("mist", { tex = TX.smoke, life = { 0.4, 0.7 }, spd = { 2, 5 }, spread = 60, size = nseq(0, 0.8, 1, 2.4),
    tr = nseq(0, 0.5, 1, 1), col = cseq(RGB(230, 238, 242), RGB(215, 225, 232)), drag = 2, rot = 20 })

  -- 让零件的 +Y（粒子往外飞的方向）朝 up
  local function upCF(p, up)
    local r = up:Cross((math.abs(up.Y) < 0.95) and V(0, 1, 0) or V(1, 0, 0)).Unit
    return CFrame.fromMatrix(p, r, up)
  end
  local function fire(name, cf, n, k)
    local e = IMP[name]
    if not e or n < 1 then return end
    e.h.CFrame = cf
    k = k or 1
    e.pe.Speed = NumberRange.new(e.spd[1] * k ^ 0.5, e.spd[2] * k ^ 0.5)   -- 大口径溅得远一点
    e.pe:Emit(math.floor(n + 0.5))
  end

  -- 弹着点打中的是什么零件、朝哪（沿弹道在落点前后各探 3 格）：客户端的样子（View 的文件夹）、特效、自己的角色不算
  local probe = RaycastParams.new()
  probe.FilterType = Enum.RaycastFilterType.Exclude
  probeAt = function(b, du)
    local ex = { FXF }
    if G.viewFolder then ex[#ex + 1] = G.viewFolder end
    if me.Character then ex[#ex + 1] = me.Character end
    probe.FilterDescendantsInstances = ex
    return workspace:Raycast(b - du * 3, du * 6, probe)
  end

  local impSndT, impSndN = 0, 0
  local function impactSound(p, d, kind)
    if d > ((kind == "thud") and 90 or 260) then return end
    local t = os.clock()
    if t - impSndT > 0.25 then impSndT, impSndN = t, 0 end
    if impSndN >= 4 then return end
    impSndN += 1
    G.sfx(kind, p, { vol = math.max(0.25, 1 - d / 320), rmin = 10, rmax = 320 })
  end

  -- 跳弹：一小段曳光从弹着点斜着飞走（每秒最多 12 道）
  local ricT, ricN = 0, 0
  local function ricochet(p, refl, k, d)
    local t = os.clock()
    if t - ricT > 1 then ricT, ricN = t, 0 end
    if ricN >= 12 then return end
    ricN += 1
    local rd = refl + V((math.random() - 0.5) * 0.9, math.random() * 0.5, (math.random() - 0.5) * 0.9)
    rd = (rd.Magnitude > 1e-3) and rd.Unit or refl
    local len = 2.6 * math.min(k, 1.6)
    local dist = 50 + math.random() * 60
    local dur = dist / 280
    local r = 0.09 * math.min(k, 1.8)
    local tr = part(nil, V(r, r, len), CFrame.lookAt(p + rd * len / 2, p + rd * (len + 1)), RGB(255, 205, 130), Enum.Material.Neon, 0.05)
    tween(tr, dur, { CFrame = CFrame.lookAt(p + rd * (dist - len / 2), p + rd * (dist + 1)), Transparency = 0.9 }, Enum.EasingStyle.Linear)
    Debris:AddItem(tr, dur + 0.05)
    if d < 150 and math.random() < 0.35 then G.sfx("ric", p, { vol = 0.8, rmin = 10, rmax = 200 }) end
  end

  local impTok, impTokT = 40, 0
  -- p 弹着点、du 弹道方向、h 打在什么上面（HitSurf）、k 大小（步枪 1、重机枪 1.7、航炮 2、炮弹 3 上下）、nrm 表面朝向（没探到就当正对着打）
  impact = function(p, du, h, k, nrm)
    if not h then return end
    local d = (p - cam.CFrame.Position).Magnitude
    if d > 900 then return end
    local t = os.clock()
    impTok = math.min(40, impTok + (t - impTokT) * 40)
    impTokT = t
    if impTok < 1 then return end
    impTok -= 1
    nrm = nrm or -du
    if HitSurf.METAL[h] then
      local steel = h == "a" or h == "s"
      local tier = (k >= 2.5 and 3) or (k >= 1.5 and 2) or 1
      local refl = du - 2 * du:Dot(nrm) * nrm
      local sd = nrm + refl * 0.7   -- 火星往外溅：在法线和反弹方向之间
      sd = (sd.Magnitude > 1e-3) and sd.Unit or nrm
      local far = d > 250 and 0.5 or 1
      fire((tier > 1) and "spark2" or "spark", upCF(p + nrm * 0.15, sd), (steel and 12 or 7) * k * far, k)
      fire(((tier == 3) and "flash3") or ((tier == 2) and "flash2") or "flash", upCF(p + nrm * 0.2, nrm), 1)
      if d < 300 then fire("smoke", upCF(p + nrm * 0.3, nrm), (tier == 3) and 4 or (steel and 1 or 2)) end
      if tier > 1 and d < 400 then flash(p + nrm * 0.6, RGB(255, 222, 165), 8 * k, 2.4, 0.06) end   -- 夜里照亮一下车身
      if steel and d < 600 then
        local graze = math.abs(du:Dot(nrm)) < 0.5
        if math.random() < (graze and 0.6 or 0.3) then ricochet(p, refl, k, d) end
      end
      impactSound(p, d, (tier > 1) and "clang" or "ping")
    elseif h == "w" then
      fire("spout", upCF(p, V(0, 1, 0)), 7 * k, k)
      fire("mist", upCF(p, V(0, 1, 0)), 2)
    else
      local cf = upCF(p + nrm * 0.1, (nrm + V(0, 0.35, 0)).Unit)
      local name = ((h == "n") and "sand") or ((h == "r" or h == "c" or h == "g") and "rock") or "dirt"
      fire(name, cf, (h == "f") and 1 or 3 * k, k)
      if h ~= "f" and d < 250 then fire("chips", cf, ((h == "o") and 7 or 4) * k, k) end
      if (h == "r" or h == "c") and math.random() < 0.25 then fire("spark", upCF(p + nrm * 0.1, nrm), 3, 0.8) end   -- 打在石头上偶尔迸一两颗火星
      if h ~= "f" then impactSound(p, d, "thud") end
    end
  end
  G.impact = impact   -- 测试用

  -- 爆炸声按大小：小的脆，大的低沉、带回声，炸弹再叠一层滚雷似的闷响；水里的加一声哗；远处的晚一点到（声速）、高音被吃掉
  local function boomSound(p, r, c, d, water)
    if c == "gun" and d > 900 then return end
    local L
    if c == "gun" then L = { { id = EXP, vol = 0.32, s = { 1.6, 1.9 }, reg = { 0.04, 0.55 } } }
    elseif r < 9 or c == "nade" then L = { { id = EXP, vol = 0.75, s = { 1.12, 1.28 } } }
    elseif r < 18 then L = { { id = EXP, vol = 0.95, s = { 0.92, 1.02 }, echo = { 0.2, 0.22, -10 } } }
    elseif c ~= "bomb" and r < 28 then L = { { id = EXP, vol = 1.15, s = { 0.76, 0.84 }, eq = { 4, 0, -2 }, echo = { 0.26, 0.28, -8 } } }
    else
      L = { { id = EXP, vol = 1.4, s = { 0.58, 0.64 }, eq = { 8, 0, -4 }, echo = { 0.32, 0.35, -6 } },
        { id = EXP, vol = 0.9, s = { 0.4, 0.44 }, eq = { 10, -6, -14 }, delay = 0.1 } }
    end
    if water then L = { L[1], { id = WATER, vol = 0.9, s = { 0.62, 0.72 }, delay = 0.06 } } end
    local far = math.clamp((d - 300) / 2500, 0, 1)
    G.sfx(L, p, { delay = math.max(0, d - 250) / 960, hiCut = -16 * far, rmin = 40 + r * 6, rmax = (c == "bomb") and 9000 or 4500, must = r >= 18 })
  end

  local KF = { nade = 0.5, shell = 0.75, rkt = 0.8, msl = 0.9, bomb = 1, flak = 0.6, wreck = 0.8 }   -- 火球半径 / 杀伤半径
  local RMIN = { shell = 5, rkt = 6, msl = 9, bomb = 24, wreck = 10 }
  local boomT, boomN = 0, 0
  local function boom(p, s, c)
    s = s or 1
    local r = 12 * s   -- 杀伤半径（格）
    if not c then c = (r < 5 and "gun") or (r < 13 and "shell") or (r < 26 and "msl") or "bomb" end
    local d = (p - cam.CFrame.Position).Magnitude
    local gy = MapM.height(p.X, p.Z)
    local water = gy < 0.3 and p.Y < 5
    local surf = water and 0 or math.max(gy, 0)
    local air = c == "flak" or (p.Y - surf) > math.max(6, r * 0.6)
    boomSound(p, r, c, d, water and not air)
    if d > ((c == "gun") and 1600 or ((c == "bomb" or c == "wreck") and 9000 or 5000)) then return end
    if c ~= "gun" then   -- 离得近震一下
      local shR = r * 12 + 60
      if d < shR then G.shake(math.clamp(r / 32, 0.12, 0.85) * (1 - d / shR)) end
    end
    local t = os.clock()
    if t - boomT > 0.25 then boomT, boomN = t, 0 end
    boomN += 1
    local lod = (d > 2500 or boomN > 6 or (G.perfK or 1) < 0.8) and 0.5 or 1   -- 远的、同一时刻扎堆的（集束、齐射）、机器跟不上的少画一半
    local function n(x) return math.max(1, math.floor(x * lod + 0.5)) end
    local h = part(nil, V(1, 1, 1), CFrame.new(p), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    local keep = 2.5

    if c == "gun" then   -- 航炮、小口径炮弹：一点火光、几颗火星、一小团土（水里一小柱水）
      burst(h, { tex = TX.glow, n = 1, life = { 0.07, 0.1 }, spd = { 0, 0 }, size = nseq(0, r * 0.9, 1, r * 1.4), tr = nseq(0, 0, 1, 1), col = cseq(RGB(255, 236, 190), RGB(255, 180, 100)), le = 1, z = 2 })
      burst(h, { tex = TX.glow, n = n(5), life = { 0.25, 0.5 }, spd = { 18, 50 }, spread = 70, acc = V(0, -90, 0), size = nseq(0, 0.5, 1, 0), tr = nseq(0, 0, 1, 0.3), col = cseq(RGB(255, 230, 160), RGB(255, 150, 60)), le = 1 })
      local col = water and RGB(236, 242, 246) or RGB(142, 124, 100)
      burst(h, { tex = TX.smoke, n = n(3), life = { 0.8, 1.4 }, spd = { r * 1.2, r * 2.6 }, spread = water and 12 or 35, acc = V(0, water and -40 or -10, 0), drag = 2,
        size = nseq(0, r * 0.5, 1, r * 1.6), tr = nseq(0, 0.2, 1, 1), col = cseq(col, col) })
      if d < 500 then flash(p + V(0, 2, 0), RGB(255, 190, 110), 12, 3, 0.12) end
      Debris:AddItem(h, 1.6)
      return
    end

    local R = math.max(r * (KF[c] or 0.8), RMIN[c] or 3)   -- 火球半径
    if water and not air then R = R * 0.6 end              -- 水里炸：火小、水柱大
    -- 白热闪光 + 照亮四周
    burst(h, { tex = TX.glow, n = 1, life = { 0.12, 0.18 }, spd = { 0, 0 }, size = nseq(0, R * 2.4, 1, R * 3.4), tr = nseq(0, 0, 1, 1), col = cseq(RGB(255, 244, 220), RGB(255, 196, 130)), le = 1, z = 3 })
    flash(p + V(0, R * 0.5, 0), RGB(255, 170, 90), math.min(60, 14 + R * 2.5), 8 + R / 4, 0.3 + R / 45)
    -- 翻卷的火球：往外冲一下就被空气挡住、热气往上升
    burst(h, { tex = TX.core, n = n(6 + R / 3), life = { 0.45, 0.85 + R / 50 }, spd = { R * 0.8, R * 2.2 }, drag = 5, acc = V(0, R * 1.2, 0),
      size = nseq(0, R * 0.9, 0.25, R * 1.6, 1, R * 2.1), tr = nseq(0, 0.05, 0.5, 0.35, 1, 1), col = cseq(RGB(255, 236, 200), RGB(150, 70, 30)), le = 0.85, rot = 90, z = 1 })
    -- 火星
    burst(h, { tex = TX.glow, n = n(6 + r / 2), life = { 0.4, 1 }, spd = { r * 2, r * 4.5 + 20 }, spread = air and 180 or 70, acc = V(0, -90, 0), drag = 0.8,
      size = nseq(0, 0.6 + r / 40, 1, 0), tr = nseq(0, 0, 1, 0.4), col = cseq(RGB(255, 230, 160), RGB(255, 140, 60)), le = 1 })

    local smokeT = (c == "bomb") and 9 or ((c == "msl" or c == "wreck") and 6 or 3.5)
    if air then
      -- 半空炸：一团黑烟（高炮的就是这一团），慢慢散开
      burst(h, { tex = TX.smoke, n = n(4 + r / 4), life = { smokeT * 0.5, smokeT * 0.8 }, spd = { r * 0.3, r * 0.8 }, drag = 2, acc = V(1, 1.5, 0.6),
        size = nseq(0, r * 0.5, 0.3, r * 1.3, 1, r * 1.9), tr = nseq(0, 1, 0.06, 0.15, 0.6, 0.4, 1, 1), col = cseq(RGB(42, 40, 38), RGB(96, 94, 92)), rot = 15 })
      keep = smokeT
    elseif water then
      -- 海面：白色水柱 + 一圈水雾 + 平躺的一圈白沫
      local wcol = RGB(238, 244, 248)
      burst(h, { tex = TX.smoke, n = n(10 + r / 2), life = { 1.3, 2.2 + r / 40 }, spd = { r * 2, r * 4.2 }, spread = 12, acc = V(0, -r * 3, 0), drag = 0.6,
        size = nseq(0, r * 0.3, 0.35, r * 0.85, 1, r * 1.4), tr = nseq(0, 0.05, 0.6, 0.3, 1, 1), col = cseq(wcol, RGB(214, 226, 232)), rot = 25 })
      burst(h, { tex = TX.smoke, n = n(8 + r / 3), radial = true, dir = Enum.NormalId.Front, spread = 10, life = { 1, 1.8 }, spd = { r * 1.2, r * 2.4 }, drag = 1.6,
        size = nseq(0, r * 0.35, 1, r * 1.3), tr = nseq(0, 0.25, 1, 1), col = cseq(wcol, wcol) })
      h.CFrame = CFrame.new(p.X, 0.6, p.Z)
      burst(h, { tex = TX.ring, n = 1, life = { 2.2, 2.8 }, spd = { 0.05, 0.05 }, spread = 0, flat = true, size = nseq(0, r * 0.5, 1, r * 3.5), tr = nseq(0, 0.2, 1, 1), col = cseq(wcol, wcol) })
      keep = 3
    else
      -- 地上：冲起的尘土柱（车、飞机被打爆没有）、乱飞的碎块、贴地冲击波圈和一圈扬尘、往上飘的烟柱
      local soil = RGB(116, 98, 74)
      if c ~= "wreck" then
        burst(h, { tex = TX.smoke, n = n(8 + r / 2), life = { 1.2, 2.2 + r / 40 }, spd = { r * 1.4, r * ((c == "bomb") and 4 or 3.2) }, spread = 22, acc = V(0, -r * 2.4, 0), drag = 1.4,
          size = nseq(0, r * 0.35, 0.3, r * 0.9, 1, r * 1.5), tr = nseq(0, 0.1, 0.6, 0.45, 1, 1), col = cseq(soil, RGB(150, 136, 116)), rot = 30 })
      end
      local chunk = (c == "wreck") and RGB(52, 52, 50) or RGB(60, 50, 40)
      burst(h, { tex = TX.chunk, n = n(6 + r / 2), life = { 1, 2.2 }, spd = { r * 1.6, r * 3.6 }, spread = 55, acc = V(0, -110, 0), drag = 0.4,
        size = nseq(0, 0.5 + r / 30, 1, 0.3 + r / 50), tr = nseq(0, 0, 0.8, 0, 1, 1), col = cseq(chunk, RGB(36, 32, 28)), rot = 400 })
      if r >= 7 then
        h.CFrame = CFrame.new(p.X, surf + 1.2, p.Z)
        burst(h, { tex = TX.ring, n = 1, life = { 0.35 + r / 120, 0.4 + r / 100 }, spd = { 0.05, 0.05 }, spread = 0, flat = true,
          size = nseq(0, r * 0.4, 1, r * 4.5), tr = nseq(0, 0.25, 1, 1), col = cseq(RGB(235, 220, 195), RGB(235, 220, 195)) })
        burst(h, { tex = TX.smoke, n = n(10 + r / 3), radial = true, dir = Enum.NormalId.Front, spread = 8, life = { 1.4, 2.4 + r / 30 }, spd = { r * 1.2, r * 2.2 }, drag = 1.8,
          acc = V(0, r * 0.15, 0), size = nseq(0, r * 0.4, 1, r * 1.3), tr = nseq(0, 0.35, 1, 1), col = cseq(RGB(170, 154, 128), RGB(190, 180, 160)) })
        h.CFrame = CFrame.new(p)
      end
      burst(h, { tex = TX.smoke, n = n(5 + r / 4), life = { smokeT * 0.6, smokeT }, spd = { r * 0.4, r * 1.1 }, spread = 60, drag = 1.2, acc = V(1.5, r * 0.35 + 2, 0.8),
        size = nseq(0, r * 0.6, 0.4, r * 1.6, 1, r * 2.6), tr = nseq(0, 1, 0.08, 0.2, 0.6, 0.45, 1, 1), col = cseq(RGB(58, 54, 50), RGB(128, 124, 118)), rot = 15 })
      keep = smokeT
      -- 大的留一会儿余火和黑烟（弹坑、残骸在烧）
      if (c == "bomb" or c == "msl" or c == "wreck") and lod == 1 then
        local fireT = (c == "bomb") and 7 or 5
        local f1 = burst(h, { tex = TX.fire, rate = 12, life = { 0.6, 1.2 }, spd = { 2, 6 }, spread = 25, acc = V(0, 6, 0), size = nseq(0, R * 0.3, 1, R * 0.05),
          tr = nseq(0, 0.2, 1, 1), col = cseq(RGB(255, 190, 110), RGB(255, 90, 40)), le = 0.9 })
        local f2 = burst(h, { tex = TX.smoke, rate = 3, life = { 4, 6 }, spd = { 3, 6 }, spread = 15, acc = V(1.2, 3, 0.6), size = nseq(0, R * 0.4, 1, R * 1.8),
          tr = nseq(0, 0.4, 1, 1), col = cseq(RGB(40, 38, 36), RGB(110, 108, 104)) })
        task.delay(fireT, function() f1.Enabled = false f2.Enabled = false end)
        keep = math.max(keep, fireT + 6)
      end
    end
    Debris:AddItem(h, keep + 0.5)
  end
  G.boom = boom

  -- 弹掉进海里：一小柱水
  local function splash(p)
    local h = part(nil, V(1, 1, 1), CFrame.new(p.X, 0.5, p.Z), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    local wcol = RGB(236, 242, 246)
    burst(h, { tex = TX.smoke, n = 5, life = { 0.8, 1.3 }, spd = { 10, 22 }, spread = 14, acc = V(0, -40, 0), drag = 0.8, size = nseq(0, 1.5, 1, 4), tr = nseq(0, 0.15, 1, 1), col = cseq(wcol, wcol) })
    Debris:AddItem(h, 1.6)
    G.playSound("splash", p)
  end

  ---------------------------------------------------------------- 飞行中的弹（照服务器给的初速本地算，收到结束就删）

  local GRAV = V(0, -workspace.Gravity * 0.55, 0)
  local flying = {}
  -- 导弹的发动机声挂在弹上跟着飞走（同时最多 4 枚，离镜头远的不挂）
  local roars = 0
  local function addRoar(s, holder, p, k)
    if roars >= 4 or (p - cam.CFrame.Position).Magnitude > 2500 then return end
    roars += 1
    s.roar = makeSound(ROAR, holder, { vol = k or 1, rmin = 50, rmax = 2600 })
  end
  local function stopRoar(s)
    if not s.roar then return end
    local snd = s.roar
    s.roar = nil
    roars -= 1
    tween(snd, 0.4, { Volume = 0 })
    Debris:AddItem(snd, 0.45)
  end
  -- 自己开的飞机打出去的：开火那一下 Fly.lua 已经在耳边放过了，这里不再放一遍
  local function mine(e) return G.fly ~= nil and e.by ~= nil and G.fly.id == e.by end

  local function newShot(e)
    local kind = e.kind
    local aw = e.w and AD.W[e.w]
    if kind == "shell" and e.f == "agun" and e.by and not mine(e) then G.gunLoop(e.by, e.w, e.p, true) end   -- 别人的航炮：炮口那里一个循环声
    if aw and (kind == "missile" or kind == "bomb") and typeof(e.v) == "Vector3" and e.v.Magnitude > 0.1 then   -- 机载导弹、炸弹：按型号的外形（折叠翼展开）
      local cf = CFrame.lookAt(e.p, e.p + e.v)
      local mdl = WM.make(FXF, aw, cf, true)
      local glow = nil
      if kind == "missile" then
        glow = part(BALL, V(1.1, 1.1, 1.1) * math.max(1, aw.shape and aw.shape.d * 1.6 or 1), CFrame.new(e.p), RGB(255, 200, 120), Enum.Material.Neon, 0)
        glowOn(glow, RGB(255, 180, 100), 22, 4)   -- 尾焰照亮弹体和周围
      end
      if not mine(e) then G.sfx((kind == "missile") and "msl" or "bombRel", e.p) end
      flying[e.id] = { wm = mdl, glow = glow, half = (aw.shape and aw.shape.L or 5) / 2, p = e.p, v = e.v, gb = kind == "bomb", t = 0, kind = kind, trailT = 0,
        burn = aw.burn or 4, cfs = table.create(#mdl.parts), tg = e.tg, w = e.w, my = mine(e) }   -- my：自己打出去的（Marks.lua 给自己的炸弹标落点）
      if glow then addRoar(flying[e.id], glow, e.p) end
      if mine(e) and G.onMyShot then G.onMyShot(e) end   -- 自己打出去的：导弹视角小窗（MslCam.lua）
      return
    end
    local body
    if kind == "shell" then   -- 炮弹：一道亮的曳光
      local big = e.f == "tank"
      body = part(CYL, big and V(5, 0.45, 0.45) or V(2.6, 0.22, 0.22), CFrame.new(e.p), big and RGB(255, 236, 190) or RGB(255, 200, 120), Enum.Material.Neon, 0)
      if big then glowOn(body, RGB(255, 220, 170), 10, 2) end
      flying[e.id] = { body = body, p = e.p, v = e.v, g = e.g, gs = e.gs or 1, t = 0, kind = kind, trailT = 0 }
      return
    elseif kind == "grenade" then
      body = part(BALL, V(0.7, 0.7, 0.7), CFrame.new(e.p), RGB(70, 80, 60), Enum.Material.Metal, 0)
    elseif kind == "bomb" then   -- 机载炸弹：粗短的弹体，真实重力往下掉（服务器隔一会儿校一下）
      body = part(CYL, V(3.6, 1, 1), CFrame.new(e.p), RGB(70, 76, 66), Enum.Material.Metal, 0)
      flying[e.id] = { body = body, p = e.p, v = e.v, gb = true, t = 0, kind = kind, trailT = 0 }
      return
    else
      local big = (e.w == "asm") and V(8, 1.3, 1.3) or ((e.w == "sam") and V(6, 1, 1)) or nil   -- 舰艇的反舰 / 防空导弹：大一号、灰白色
      body = part(CYL, big or V(2.2, 0.5, 0.5), CFrame.new(e.p), big and RGB(196, 198, 194) or RGB(80, 86, 70), Enum.Material.Metal, 0)
      local glow = part(BALL, big and V(1.8, 1.8, 1.8) or V(0.9, 0.9, 0.9), CFrame.new(e.p), RGB(255, 200, 120), Enum.Material.Neon, 0)
      if big then glowOn(glow, RGB(255, 190, 110), 26, 4) end
      glow.Name = "Glow"
      glow.Parent = body
    end
    flying[e.id] = { body = body, p = e.p, v = e.v, g = e.g, t = 0, kind = kind, trailT = 0, half = body.Size.X / 2 + 0.1 }
    if (kind == "rocket" or kind == "missile") and not mine(e) then
      G.sfx((kind == "missile" and (e.w == "asm" or e.w == "sam")) and "msl" or "rkt", e.p, { vol = aw and 1 or 0.85 })
    end
    if kind == "missile" and (e.w == "asm" or e.w == "sam") then
      local g = body:FindFirstChild("Glow")
      if g then addRoar(flying[e.id], g, e.p, 1.2) end
    end
  end
  G.flyingShots = flying   -- 导弹视角小窗按弹的位置摆镜头
  local function endShot(id)
    local s = flying[id]
    if s and G.onShotEnd then G.onShotEnd(id, s) end
    if s then
      stopRoar(s)
      if s.body then s.body:Destroy() end
      if s.wm then for _, p in ipairs(s.wm.parts) do p:Destroy() end end
      if s.glow then s.glow:Destroy() end
      flying[id] = nil
    end
  end
  local function stepShots(dt)
    for id, s in pairs(flying) do
      s.t += dt
      if s.g then s.v += GRAV * (s.gs or 1) * dt end
      if s.gb then s.v += V(0, -27.5, 0) * dt end   -- 机载炸弹：AirDefs.GRAV
      s.p += s.v * dt
      if s.wm then   -- 按型号拼的弹：整枚一起挪，导弹尾焰烧完就灭、尾烟跟着淡
        local cf = CFrame.lookAt(s.p, s.p + ((s.v.Magnitude > 0.1) and s.v or V(0, -1, 0)))
        for i, o in ipairs(s.wm.offs) do s.cfs[i] = cf * o end
        workspace:BulkMoveTo(s.wm.parts, s.cfs, Enum.BulkMoveMode.FireCFrameChanged)
        local burning = s.t < s.burn
        if not burning and s.roar then stopRoar(s) end
        if s.glow then
          s.glow.CFrame = cf * CFrame.new(0, 0, s.half + 0.5)
          s.glow.Transparency = burning and 0 or 1
        end
        if s.kind == "missile" then
          s.trailT += dt
          if s.trailT > (burning and 0.035 or 0.12) then
            s.trailT = 0
            local sm = part(BALL, V(1.3, 1.3, 1.3), cf * CFrame.new(0, 0, s.half + 1), RGB(222, 222, 218), Enum.Material.SmoothPlastic, burning and 0.25 or 0.6)
            tween(sm, burning and 2.2 or 1.2, { Size = V(5, 5, 5), Transparency = 1 })
            Debris:AddItem(sm, 2.3)
          end
        end
      elseif s.kind == "grenade" then
        s.body.CFrame = CFrame.new(s.p)
      elseif s.kind == "shell" or s.kind == "bomb" then
        s.body.CFrame = CFrame.lookAt(s.p, s.p + s.v) * CFrame.Angles(0, math.pi / 2, 0)
      elseif s.kind == "smoke" then   -- 烟幕弹：小罐子，后面拖一点白烟
        s.body.CFrame = CFrame.new(s.p)
        s.trailT += dt
        if s.trailT > 0.05 then
          s.trailT = 0
          local sm = part(BALL, V(0.6, 0.6, 0.6), CFrame.new(s.p), RGB(230, 230, 225), Enum.Material.SmoothPlastic, 0.4)
          tween(sm, 0.8, { Size = V(2.2, 2.2, 2.2), Transparency = 1 })
          Debris:AddItem(sm, 0.85)
        end
        if s.t > (s.life or 1) then endShot(id) end
      else
        local cf = CFrame.lookAt(s.p, s.p + s.v) * CFrame.Angles(0, math.pi / 2, 0)
        s.body.CFrame = cf
        local g = s.body:FindFirstChild("Glow")
        local back = s.half or 1.2
        if g then g.CFrame = CFrame.new(s.p - s.v.Unit * back) end
        s.trailT += dt
        if s.trailT > 0.04 then   -- 尾烟（舰艇导弹的粗一些）
          s.trailT = 0
          local k = math.max(1, back / 1.6)
          local sm = part(BALL, V(1, 1, 1) * k, CFrame.new(s.p - s.v.Unit * (back + 0.3)), RGB(200, 200, 200), Enum.Material.SmoothPlastic, 0.3)
          tween(sm, 1.2 * k, { Size = V(3.5, 3.5, 3.5) * k, Transparency = 1 })
          Debris:AddItem(sm, 1.25 * k)
        end
      end
      if s.t > ((s.kind == "bomb") and 40 or 15) then endShot(id) end
    end
  end
  -- 抛副油箱：照挂着的样子拼一个（WeaponModels 的外形），带着飞机的速度往下掉——空箱子阻力大很快慢下来，重心靠前机头往下栽、绕纵轴慢慢转；
  --   掉到海里溅一下、地上起一团土就没了
  local drops = {}
  local function tankDrop(e)
    local aw = e.w and AD.W[e.w]
    if not aw or typeof(e.cf) ~= "CFrame" then return end
    local mdl = WM.make(FXF, aw, e.cf, false)
    table.insert(drops, { wm = mdl, cf = e.cf, v = (typeof(e.v) == "Vector3") and e.v or V(), t = 0, spin = (math.random() - 0.5) * 2.4, cfs = table.create(#mdl.parts) })
    G.playSound("quiet", e.cf.Position, 0.6)
  end
  local function stepDrops(dt)
    for i = #drops, 1, -1 do
      local s = drops[i]
      s.t += dt
      s.v = (s.v + V(0, -27.5, 0) * dt) * (1 - 0.3 * dt)
      local p = s.cf.Position + s.v * dt
      s.cf = CFrame.new(p) * (s.cf - s.cf.Position) * CFrame.Angles(-0.8 * dt * math.min(1, s.t), 0, s.spin * dt)
      for k, o in ipairs(s.wm.offs) do s.cfs[k] = s.cf * o end
      workspace:BulkMoveTo(s.wm.parts, s.cfs, Enum.BulkMoveMode.FireCFrameChanged)
      local gy = math.max(AD.ground(MapM, p.X, p.Z), 0)   -- 甲板也算（落在航母上就没了）
      if p.Y <= gy + 0.5 or s.t > 30 then
        if p.Y <= gy + 2 then
          if gy <= 0.5 then splash(p) else
            local d = part(BALL, V(4, 4, 4), CFrame.new(p), RGB(168, 150, 122), Enum.Material.SmoothPlastic, 0.3)
            tween(d, 1.3, { Size = V(15, 15, 15), Transparency = 1 })
            Debris:AddItem(d, 1.35)
          end
        end
        for _, q in ipairs(s.wm.parts) do q:Destroy() end
        table.remove(drops, i)
      end
    end
  end
  -- 服务器校正：导弹拐弯、炸弹滑翔（本地只会直线 / 抛物线）
  local function fixShot(e)
    local s = flying[e.id]
    if not s or typeof(e.p) ~= "Vector3" or typeof(e.v) ~= "Vector3" then return end
    if (s.p - e.p).Magnitude > 60 then s.p = e.p else s.p = s.p:Lerp(e.p, 0.6) end
    s.v = e.v
  end
  -- 热诱弹：一串亮点往后下方撒开，拖着白烟
  local function flares(e)   -- 一组几发（按住 X 连续放：服务器每 0.25 秒一组 2 发）
    local v0 = (typeof(e.v) == "Vector3") and e.v or V()
    for i = 1, (e.n or 4) do
      local dir = (-v0.Unit * 0.4 + V((math.random() - 0.5) * 1.6, -0.4 - math.random() * 0.4, (math.random() - 0.5) * 1.6)).Unit
      local f = part(BALL, V(1.4, 1.4, 1.4), CFrame.new(e.p), RGB(255, 236, 170), Enum.Material.Neon, 0)
      local p1 = e.p + v0 * 0.35 + dir * (40 + i * 8)
      tween(f, 1.8, { CFrame = CFrame.new(p1 - V(0, 30, 0)), Transparency = 1, Size = V(0.6, 0.6, 0.6) })
      if i <= 2 then tween(glowOn(f, RGB(255, 222, 160), 34, 5), 1.8, { Brightness = 0 }) end   -- 夜里热诱弹把飞机照亮
      Debris:AddItem(f, 1.85)
      for k = 1, 3 do   -- 每发拖三团烟（连着放时零件不至于太多）
        task.delay(k * 0.3, function()
          local q = e.p:Lerp(p1, k / 3) - V(0, 30 * (k / 3) ^ 2, 0)
          local sm = part(BALL, V(1.5, 1.5, 1.5), CFrame.new(q), RGB(235, 235, 230), Enum.Material.SmoothPlastic, 0.35)
          tween(sm, 1.6, { Size = V(5, 5, 5), Transparency = 1 })
          Debris:AddItem(sm, 1.65)
        end)
      end
    end
    G.playSound("quiet", e.p, 1.6)
  end
  -- 弹射座椅：座舱盖飞走、座椅带着一道火冲上去
  local function eject(e)
    local cap = part(nil, V(3, 1.2, 6), CFrame.new(e.p), RGB(40, 56, 66), Enum.Material.Glass, 0.3)
    tween(cap, 1.2, { CFrame = CFrame.new(e.p + V(math.random() * 20 - 10, 25, 30)) * CFrame.Angles(2, 1, 0.5), Transparency = 1 })
    Debris:AddItem(cap, 1.25)
    local fl = part(BALL, V(2, 2, 2), CFrame.new(e.p), RGB(255, 190, 90), Enum.Material.Neon, 0)
    tween(fl, 0.5, { CFrame = CFrame.new(e.p + V(0, 30, 0)), Transparency = 1, Size = V(4, 4, 4) })
    Debris:AddItem(fl, 0.55)
    G.playSound("rocket", e.p, 1.2)
  end

  -- 车炮开火（用户：开火动画做的好一点）：
  --   小口径：一小团火光 + 枪声；
  --   坦克炮、自行火炮：顺着炮管拉长的火球（外面再一层橙色的）、炮口制退器两边横喷的火（十字形的闪）、垂直炮管一下子撑开的激波圈、
  --   向前喷一股快烟 + 一大团挂在空中慢慢飘上去的硝烟（开炮后前面一下子看不清，战雷那样）、炮口下面地上掀起的一圈土（在水上是水雾）、
  --   照亮四周的闪光、闷响 + 脆响 + 回声；炮管后坐、车体一晃（View 的 vehRecoil）；离得近震屏
  local SMOKE_TEX = "rbxasset://textures/particles/smoke_main.dds"
  local function emitter(holder, o)
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = o.tex or SMOKE_TEX
    pe.Rate = 0
    pe.Lifetime = NumberRange.new(o.life[1], o.life[2])
    pe.Speed = NumberRange.new(o.speed[1], o.speed[2])
    pe.SpreadAngle = Vector2.new(o.spread, o.spread)
    pe.Drag = o.drag or 0
    pe.Acceleration = o.acc or V()
    pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, o.size[1]), NumberSequenceKeypoint.new(1, o.size[2]) })
    pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, o.tr or 0.3), NumberSequenceKeypoint.new(1, 1) })
    pe.Color = ColorSequence.new(o.color)
    pe.RotSpeed = NumberRange.new(-40, 40)
    pe.Rotation = NumberRange.new(0, 360)
    pe.LightEmission = o.glow or 0
    pe.EmissionDirection = o.dir or Enum.NormalId.Front
    pe.Parent = holder
    pe:Emit(math.max(1, math.floor(o.n * math.clamp(G.perfK or 1, 0.4, 1.2) + 0.5)))
    return pe
  end
  G.emitBurst = emitter
  local function vfire(e)
    local big = e.f == "tank" or e.f == "arty"
    local dir = (typeof(e.d) == "Vector3") and e.d.Unit or V(0, 0, -1)
    local dd = (e.p - cam.CFrame.Position).Magnitude
    if not big then
      local fl = part(BALL, V(1.6, 1.6, 1.6), CFrame.new(e.p + dir * 0.6), RGB(255, 210, 120), Enum.Material.Neon, 0)
      tween(fl, 0.06, { Transparency = 1, Size = V(3, 3, 3) })
      Debris:AddItem(fl, 0.08)
      flash(e.p + dir, RGB(255, 190, 110), 16, 4, 0.1)
      G.playSound("lmg", e.p)
      if G.vehRecoil and e.id then G.vehRecoil(e.id, e.g) end
      return
    end
    local look = CFrame.lookAt(e.p, e.p + dir)
    local near = dd < 1100   -- 远了只画火光、出声
    -- ① 火球：顺着炮管拉长的白热一团 + 外面一层橙色的，0.1 秒内胀大、透明
    local core = part(BALL, V(2.4, 2.4, 7), look * CF(0, 0, -4.5), RGB(255, 240, 190), Enum.Material.Neon, 0)
    tween(core, 0.1, { Size = V(4, 4, 13), Transparency = 1, CFrame = look * CF(0, 0, -7) })
    Debris:AddItem(core, 0.12)
    local outer = part(BALL, V(5, 5, 6), look * CF(0, 0, -3), RGB(255, 150, 60), Enum.Material.Neon, 0.2)
    tween(outer, 0.16, { Size = V(11, 11, 13), Transparency = 1 })
    Debris:AddItem(outer, 0.18)
    -- ② 炮口制退器两边横喷的火
    for sx = -1, 1, 2 do
      local j = part(BALL, V(1.2, 1.2, 4), look * CF(sx * 2.1, 0, -0.6) * CFrame.Angles(0, sx * math.rad(78), 0), RGB(255, 205, 130), Enum.Material.Neon, 0.1)
      tween(j, 0.08, { Size = V(1.8, 1.8, 7.5), Transparency = 1 })
      Debris:AddItem(j, 0.1)
    end
    flash(e.p + dir * 3, RGB(255, 186, 104), 64, 13, 0.32)
    if near then
      -- ③ 激波圈：垂直炮管的薄圆盘（圆柱的轴转到炮管方向），一下子撑开
      local disc = part(CYL, V(0.25, 3, 3), look * CF(0, 0, -2.5) * CFrame.Angles(0, math.pi / 2, 0), RGB(255, 236, 214), Enum.Material.SmoothPlastic, 0.55)
      tween(disc, 0.18, { Size = V(0.25, 24, 24), Transparency = 1 })
      Debris:AddItem(disc, 0.2)
      -- ④ 炮口烟：快的一股往前喷，慢的一大团挂着往上飘
      local holder = part(nil, V(0.2, 0.2, 0.2), look * CF(0, 0, -1.5), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
      emitter(holder, { life = { 1.1, 2.4 }, speed = { 16, 40 }, spread = 22, drag = 3.2, size = { 2.5, 11 }, tr = 0.25, color = RGB(214, 208, 196), n = 16 })
      emitter(holder, { life = { 3.5, 6 }, speed = { 2, 9 }, spread = 70, drag = 1.1, acc = V(0, 1.4, 0), size = { 5, 19 }, tr = 0.4, color = RGB(170, 164, 154), n = 10 })
      emitter(holder, { tex = "rbxasset://textures/particles/sparkles_main.dds", life = { 0.15, 0.4 }, speed = { 40, 80 }, spread = 12, size = { 0.5, 0.2 }, tr = 0, color = RGB(255, 210, 130), glow = 1, n = 12 })
      Debris:AddItem(holder, 6.5)
      -- ⑤ 地上一圈掀起来的土（炮口离地不高才有；水上是白的水雾）
      local gy = G.Map and G.Map.ground and G.Map.ground(e.p.X, e.p.Z) or (e.p.Y - 4)
      if e.p.Y - gy < 10 then
        local wet = gy <= 0.2
        local col = wet and RGB(220, 230, 236) or RGB(176, 156, 120)
        local gp = V(e.p.X + dir.X * 3, gy + 0.6, e.p.Z + dir.Z * 3)
        local dust = part(nil, V(0.2, 0.2, 0.2), CFrame.lookAt(gp, gp + V(0, 1, 0)), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
        emitter(dust, { life = { 1, 2.6 }, speed = { 12, 30 }, spread = 80, drag = 2.8, acc = V(0, -5, 0), size = { 2, 10 }, tr = 0.3, color = col, n = 24 })
        Debris:AddItem(dust, 3)
        local ring = part(CYL, V(0.4, 6, 6), CFrame.new(gp) * CFrame.Angles(0, 0, math.pi / 2), col, Enum.Material.SmoothPlastic, 0.5)
        tween(ring, 0.55, { Size = V(0.4, 40, 40), Transparency = 1 })
        Debris:AddItem(ring, 0.6)
      end
    end
    -- ⑥ 声音：脆响 + 低沉的轰隆 + 回声（远处的晚一点到、高音被吃掉）
    G.sfx("tankGun", e.p, { must = true, rmax = 2600, delay = dd / 1100, hiCut = -math.min(18, dd / 80) })
    if G.vehRecoil and e.id then G.vehRecoil(e.id, e.g) end
    if dd < 200 then G.shake(0.38 * (1 - dd / 200)) end
  end

  -- 跳弹（用户：跳弹也做出来）：服务器判了打得太斜、弹头滑开——迸一串火星（顺着跳出去的方向拉成一溜）、一点白烟、「当」一声 + 尖啸飞走；
  --   飞着的曳光改走跳出去的方向（服务器给新的位置和速度）
  G.ricochetCount = 0   -- 测试用
  local function shellRicochet(e)
    if typeof(e.p) ~= "Vector3" then return end
    G.ricochetCount += 1
    local out = (typeof(e.v) == "Vector3" and e.v.Magnitude > 0.1) and e.v.Unit or V(0, 1, 0)
    local n = (typeof(e.n) == "Vector3") and e.n or out
    local holder = part(nil, V(0.2, 0.2, 0.2), CFrame.lookAt(e.p, e.p + out), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    emitter(holder, { tex = "rbxasset://textures/particles/sparkles_main.dds", life = { 0.25, 0.7 }, speed = { 50, 110 }, spread = 16, acc = V(0, -50, 0), size = { 0.55, 0.2 }, tr = 0, color = RGB(255, 226, 150), glow = 1, n = 40 })
    emitter(holder, { tex = "rbxasset://textures/particles/sparkles_main.dds", life = { 0.2, 0.5 }, speed = { 15, 45 }, spread = 70, acc = V(0, -60, 0), size = { 0.4, 0.15 }, tr = 0, color = RGB(255, 180, 90), glow = 1, n = 18 })
    emitter(holder, { life = { 0.8, 1.6 }, speed = { 3, 9 }, spread = 50, drag = 2, size = { 1.2, 5 }, tr = 0.45, color = RGB(200, 196, 190), n = 6 })
    Debris:AddItem(holder, 2)
    local glint = part(BALL, V(1.6, 1.6, 1.6), CFrame.new(e.p + n * 0.3), RGB(255, 246, 220), Enum.Material.Neon, 0)
    tween(glint, 0.12, { Size = V(3.5, 3.5, 3.5), Transparency = 1 })
    Debris:AddItem(glint, 0.14)
    flash(e.p, RGB(255, 220, 160), 20, 6, 0.15)
    G.sfx("shellRic", e.p, { must = true, rmax = 700 })
    local s = e.id and flying[e.id]
    if s and typeof(e.v) == "Vector3" then s.p, s.v = e.p, e.v end
  end

  -- 烟幕弹：从每根发射筒飞出去（小抛物线），0.9 秒后落地起一大团烟（持续 life 秒）
  local smokeN = 0
  local function smokeLaunch(e)
    for _, it in ipairs(e.list or {}) do
      local a, b = it.a, it.b
      local T0 = 0.9
      local v = (b - a) / T0 - GRAV * 0.5 * T0
      smokeN += 1
      local body = part(CYL, V(0.7, 0.32, 0.32), CFrame.new(a), RGB(70, 80, 64), Enum.Material.Metal, 0)
      flying["sm" .. smokeN] = { body = body, p = a, v = v, g = true, gs = 1, t = 0, kind = "smoke", trailT = 0, life = T0 }
    end
    G.playSound("rocket", e.list and e.list[1] and e.list[1].a or nil, 2.4)
  end
  local function smokeCloud(e)
    local holder = part(nil, V(0.2, 0.2, 0.2), CFrame.new(e.p), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    local life = e.life or 30
    for i = 1, 2 do
      local pe = Instance.new("ParticleEmitter")
      pe.Texture = SMOKE_TEX
      pe.Rate = (i == 1) and 8 or 4
      pe.Lifetime = NumberRange.new(6, 10)
      pe.Speed = NumberRange.new(1, 4)
      pe.SpreadAngle = Vector2.new(180, 180)
      pe.Acceleration = V(0, 0.6, 0)
      pe.Drag = 1.2
      pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(0.3, (e.r or 20) * 1.1), NumberSequenceKeypoint.new(1, (e.r or 20) * 1.5) })
      pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.7, 0.35), NumberSequenceKeypoint.new(1, 1) })
      pe.Color = ColorSequence.new((i == 1) and RGB(226, 228, 226) or RGB(190, 194, 192))
      pe.LightInfluence = 0.8
      pe.Parent = holder
      pe:Emit(18)
      task.delay(math.max(1, life - 8), function() pe.Rate = 0 end)
    end
    G.playSound("splash", e.p, 1.6)
    Debris:AddItem(holder, life + 12)
  end

  -- 垂发：舱口一团火光、往上翻的一大团白烟（防空导弹的小一点）
  local function vls(e)
    local s = e.sam and 0.7 or 1
    -- 船上掀开那一格垂发的舱盖 / 发射箱箱口崩盖子、箱尾喷气（ShipView.lua）
    local v = e.id and G.viewById and G.viewById(e.id)
    if v and v.ext and v.ext.launch then G.try_(v.ext.launch, v, e) end
    local fl = part(BALL, V(3, 3, 3) * s, CFrame.new(e.p), RGB(255, 214, 140), Enum.Material.Neon, 0)
    tween(fl, 0.3, { Size = V(9, 9, 9) * s, Transparency = 1 })
    Debris:AddItem(fl, 0.35)
    flash(e.p + V(0, 3, 0), RGB(255, 196, 120), 50 * s, 8, 0.5)
    for i = 1, 6 do
      local off = V(math.random() - 0.5, math.random() * 0.6, math.random() - 0.5) * 6 * s
      local sm = part(BALL, V(5, 5, 5) * s, CFrame.new(e.p + off), RGB(226, 226, 222), Enum.Material.SmoothPlastic, 0.2)
      tween(sm, 3 + math.random(), { Size = V(22, 22, 22) * s, Transparency = 1, CFrame = CFrame.new(e.p + off + V(0, 14 + i * 3, 0)) })
      Debris:AddItem(sm, 4.2)
    end
    G.playSound("rocket", e.p, 0.9)
    local d = (e.p - cam.CFrame.Position).Magnitude
    if d < 200 then G.shake(0.25 * (1 - d / 200)) end
  end

  -- 炮弹：落地前一秒多传来呼啸声
  local function shell(e)
    local t = e.t or 3
    task.delay(math.max(0, t - 1.3), function() G.playSound("rocket", e.p, 0.6) end)
  end

  ---------------------------------------------------------------- 被标记的敌人

  local spotMarks = {}
  local function spots(list)
    for _, m in ipairs(spotMarks) do m:Destroy() end
    spotMarks = {}
    for _, p in ipairs(list or {}) do
      local a = part(nil, V(0.2, 0.2, 0.2), CFrame.new(p + V(0, 6, 0)), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
      local bb = Instance.new("BillboardGui")
      bb.Size = UDim2.fromOffset(18, 18)
      bb.AlwaysOnTop = true
      bb.MaxDistance = 2500
      bb.Parent = a
      local l = Instance.new("TextLabel")
      l.Size = UDim2.fromScale(1, 1)
      l.BackgroundTransparency = 1
      l.Text = "◆"
      l.TextScaled = true
      l.TextColor3 = RGB(255, 60, 50)
      l.Parent = bb
      table.insert(spotMarks, a)
    end
    if G.mapSpots then G.mapSpots(list) end
  end

  ---------------------------------------------------------------- 服务器发来的特效

  -- 子弹擦身（用户：感受不到激烈对抗）：敌人的枪弹从离头 7 格以内飞过——嗖的一声，屏幕边缘发暗、微微模糊（压制，Hud.lua G.suppress），越近越重
  local function nearMiss(e)
    if typeof(e.a) ~= "Vector3" or typeof(e.b) ~= "Vector3" then return end
    if e.t and e.t == me:GetAttribute("Side") then return end   -- 自己人的
    local ch = me.Character
    local head = ch and ch:FindFirstChild("Head")
    if not head then return end
    local p = head.Position
    local ab = e.b - e.a
    local L2 = ab:Dot(ab)
    if L2 < 4 then return end
    local u = math.clamp((p - e.a):Dot(ab) / L2, 0, 1)
    if u < 0.04 then return end   -- 枪口就在身边（贴脸开枪的不算擦身）
    local q = e.a + ab * u
    local d = (q - p).Magnitude
    if d > 7 then return end
    if G.sfx then G.sfx("whiz", q, { vol = 1.15 - d / 9, rmax = 60 }) end
    if G.suppress then G.suppress(math.clamp(1 - d / 7, 0.2, 1) * 0.32) end
  end

  function G.onFx(list)
    for _, e in ipairs(list) do
      local k = e.k
      if k == "gun" then
        if e.mi and e.id then   -- 舰艇的近防炮：那一座转向目标（ShipView.lua）
          local v = G.viewById and G.viewById(e.id)
          if v and v.ext and v.ext.ciws then G.try_(v.ext.ciws, v, e.mi, e.b) end
        end
        if e.ent then   -- 机器人开的枪：小兵后坐、枪口焰，曳光从它的枪口出来（Soldier.lua）
          if G.vehRecoil then G.vehRecoil(e.ent) end
          local mz = G.botMuzzle and G.botMuzzle(e.ent)
          if mz and (mz - e.a).Magnitude < 8 then e.a = mz end
        end
        if e.by ~= me.UserId then
          nearMiss(e)
          G.gunFx(e.w, e.a, e.b, false, e.h)
          if G.radarShot then G.radarShot(e.a, e.t, e.q) end   -- 雷达：敌人开枪的地方闪一下（Hud.lua）
        end
      elseif k == "boom" then boom(e.p, e.s, e.c)
      elseif k == "spark" then   -- 炮弹、航炮直接打在车、船、飞机上：钢甲上一大团火花（Ents.lua）
        if typeof(e.p) == "Vector3" then
          local n = (typeof(e.n) == "Vector3" and e.n.Magnitude > 0.5) and e.n.Unit or V(0, 1, 0)
          impact(e.p, -n, e.h or "a", (e.s or 1) * 1.6, n)
        end
      elseif k == "shot" then
        newShot(e)
        local fs = flying[e.id]
        if fs then fs.by = e.by end   -- 谁打的（飞机的吊舱页面算自己投的弹的 TTI）
      elseif k == "shotEnd" then endShot(e.id)
      elseif k == "shotFix" then fixShot(e)
      elseif k == "flares" then flares(e)
      elseif k == "eject" then eject(e)
      elseif k == "shell" then shell(e)
      elseif k == "splash" then splash(e.p)
      elseif k == "mortarFire" then G.playSound("mortar", e.p)
      elseif k == "heal" then
        local r = part(CYL, V(0.3, 4, 4), CFrame.new(e.p - V(0, 2.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), RGB(90, 255, 120), Enum.Material.Neon, 0.3)
        tween(r, 0.8, { Size = V(0.3, 28, 28), Transparency = 1 })
        Debris:AddItem(r, 0.85)
        G.playSound("heal", e.p)
      elseif k == "repair" then
        local sp = part(BALL, V(0.6, 0.6, 0.6), CFrame.new(e.p + V(math.random() - 0.5, 2, math.random() - 0.5) * 3), RGB(255, 220, 120), Enum.Material.Neon, 0)
        tween(sp, 0.3, { Size = V(0.1, 0.1, 0.1), Transparency = 1 })
        Debris:AddItem(sp, 0.35)
      elseif k == "capture" then G.playSound("capture")
      elseif k == "spots" then spots(e.list)
      elseif k == "ramp" then G.playSound("splash")
      elseif k == "vfire" then vfire(e)
      elseif k == "ricochet" then shellRicochet(e)
      elseif k == "vls" then vls(e)
      elseif k == "smokeLaunch" then smokeLaunch(e)
      elseif k == "smokeCloud" then smokeCloud(e)
      elseif k == "tankDrop" then tankDrop(e)
      elseif G.fxExtra and G.fxExtra[k] then G.fxExtra[k](e)   -- 别的模块登记的（战术平板的空投、空袭：TacPad.lua）
      end
    end
  end

  function G.stepFx(dt)
    stepShots(dt or 1 / 60)
    stepGuns()
    if #drops > 0 then stepDrops(dt or 1 / 60) end
  end
end

return Fx
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="85">
          <Properties>
            <string name="Name">Garage</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——坦克改装界面（用户 11-19：可以改坦克，像给飞机选导弹那样选装）
--   召唤地面载具时选了有改装的坦克（TankMods.FOR）先进这里：全屏暗底，中间是 3D 的坦克（VehModels 按现在选的改装拼：发射器、雷达板、
--   加特林、补贴的爆反块都看得见；拖动转视角、滚轮 / 双指缩放，不动时自己慢慢转）；模型上每个改装位一个白圈（爆反、主动防御、车顶武器），
--   点白圈或左边的卡片展开这一位能选的，点哪个装哪个、模型马上换；右下是选中那一项的说明和车速；底部「返回」「出车」
--   G.openGarage(id, mods, onSpawn)：mods 上次选的（{ aps = "hk", roof = "gau8" }），出车时 onSpawn(新的 mods)
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Garage = {}

function Garage.init(G)
  local TM = require(RS:WaitForChild("TankMods"))
  local VD = require(RS:WaitForChild("VehDefs"))
  local VM = require(script.Parent:WaitForChild("VehModels"))
  local V, CF, RGB = Vector3.new, CFrame.new, Color3.fromRGB
  local UD2 = UDim2.new
  local me = Players.LocalPlayer
  local ui = G.ui
  local function T(k, ...) return G.T(k, ...) end
  local TEXT, MUTE, ACC = RGB(236, 240, 238), RGB(150, 158, 160), RGB(120, 220, 230)

  local gui = Instance.new("ScreenGui")
  gui.Name = "Garage"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 20
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local bg = ui.frame(gui, UDim2.fromScale(1, 1), nil, RGB(6, 8, 10), 0)
  bg.Active = true
  local grad = Instance.new("UIGradient")   -- 中间亮一点、四周暗（像车库里一盏顶灯）
  grad.Color = ColorSequence.new(RGB(30, 36, 40), RGB(4, 5, 6))
  grad.Rotation = 90
  grad.Parent = bg
  local modal = Instance.new("TextButton")   -- 第一人称时放开鼠标（同 Hangar.lua）
  modal.Text, modal.Size, modal.BackgroundTransparency, modal.AutoButtonColor, modal.Modal = "", UDim2.fromOffset(1, 1), 1, false, true
  modal.Parent = gui

  local vp = Instance.new("ViewportFrame")
  vp.Size = UDim2.fromScale(1, 1)
  vp.BackgroundTransparency = 1
  vp.Ambient = RGB(150, 156, 164)
  vp.LightColor = RGB(255, 250, 240)
  vp.LightDirection = V(-0.5, -1, -0.35)
  vp.Parent = bg
  local world = Instance.new("WorldModel")
  world.Parent = vp
  local vcam = Instance.new("Camera")
  vcam.FieldOfView = 34
  vcam.Parent = vp
  vp.CurrentCamera = vcam
  -- 地面：一块暗色的圆台，车停在上面
  local floor = Instance.new("Part")
  floor.Shape = Enum.PartType.Cylinder
  floor.Size = V(0.4, 44, 44)
  floor.CFrame = CF(0, -0.2, 0) * CFrame.Angles(0, 0, math.pi / 2)
  floor.Color, floor.Material, floor.Anchored = RGB(26, 30, 32), Enum.Material.Concrete, true
  floor.Parent = world

  local function square(x) for _, c in ipairs(x:GetChildren()) do if c:IsA("UICorner") then c:Destroy() end end return x end
  local title = ui.label(bg, "", UDim2.fromOffset(640, 30), UD2(0.5, 0, 0, 24), 24, TEXT, Enum.Font.GothamBlack, Vector2.new(0.5, 0))
  local sub = ui.label(bg, T("gar.sub"), UDim2.fromOffset(640, 18), UD2(0.5, 0, 0, 58), 13, MUTE, Enum.Font.GothamMedium, Vector2.new(0.5, 0))
  -- 左边：三个改装位
  local left = ui.frame(bg, UDim2.fromOffset(330, 470), UD2(0, 36, 0.5, 0), RGB(0, 0, 0), 1, Vector2.new(0, 0.5))
  local lay = Instance.new("UIListLayout")
  lay.Padding = UDim.new(0, 6)
  lay.SortOrder = Enum.SortOrder.LayoutOrder
  lay.Parent = left
  -- 右下：说明
  local info = ui.frame(bg, UDim2.fromOffset(380, 150), UD2(1, -36, 1, -100), RGB(10, 12, 14), 0.12, Vector2.new(1, 1))
  ui.stroke(info, RGB(255, 255, 255), 1, 0.88)
  local infoT = ui.label(info, "", UD2(1, -28, 0, 22), UDim2.fromOffset(14, 12), 16, TEXT, Enum.Font.GothamBold)
  local infoD = ui.label(info, "", UD2(1, -28, 0, 78), UDim2.fromOffset(14, 40), 13, RGB(196, 204, 206), Enum.Font.Gotham)
  infoD.TextWrapped, infoD.TextYAlignment = true, Enum.TextYAlignment.Top
  local infoS = ui.label(info, "", UD2(1, -28, 0, 18), UD2(0, 14, 1, -28), 13, ACC, Enum.Font.GothamBold)
  local backBtn = square(ui.button(bg, T("gar.back"), UDim2.fromOffset(150, 44), UD2(1, -236, 1, -36), RGB(30, 34, 38), Vector2.new(1, 1)))
  local goBtn = square(ui.button(bg, T("gar.spawn"), UDim2.fromOffset(180, 44), UD2(1, -36, 1, -36), RGB(54, 150, 160), Vector2.new(1, 1)))
  goBtn.Name, backBtn.Name = "GarageGo", "GarageBack"
  goBtn.Font, backBtn.Font = Enum.Font.GothamBlack, Enum.Font.GothamBold
  goBtn.TextSize, backBtn.TextSize = 17, 15
  ui.stroke(backBtn, RGB(255, 255, 255), 1, 0.8)
  local spots = ui.frame(bg, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)

  local S = nil   -- 打开时：{ id, d, mods, team, onSpawn, M, yaw, pitch, dist, tYaw, …, open（展开的改装位）, focus（说明里显示哪一项） }
  local spotBtns = {}

  -- 静止的样子：炮塔朝前、炮平着
  local function pose(M, d)
    local tp = M.tpiv or (d.turret and d.turret.pivot) or V()
    local tF = CF(tp)
    local gF = tF * CF(M.gpiv or (d.gun and d.gun.pivot) or V())
    local rF = M.rpiv and (tF * CF(M.rpiv)) or tF
    local rgF = (M.rpiv and M.rgpiv) and (rF * CF(M.rgpiv)) or rF
    local kF = M.kpiv and (tF * CF(M.kpiv)) or tF
    for _, it in ipairs(M.parts) do
      local p, grp, off, idx = it[1], it[2], it[3], it[4]
      local cf
      if grp == "turret" then cf = tF * off
      elseif grp == "gun" then cf = gF * off
      elseif grp == "rws" then cf = rF * off
      elseif grp == "rwg" then cf = rgF * off
      elseif grp == "kit" then cf = kF * off
      elseif grp == "wheel" then
        local w = M.wheels[idx]
        cf = w and (CF(w.x, w.r, w.z) * off) or off
      else cf = off end
      p.CFrame = cf
    end
  end

  -- 每个改装位在模型上的点（白圈）：爆反——首上那一片；主动防御——左边的发射器；车顶武器——炮塔顶左侧
  local function slotPoint(slot)
    local L = S and S.M and S.M.eraL
    if not L then return nil end
    if slot == "era" then
      local best = nil
      for _, b in ipairs(L.b) do
        if not best or b[4] < best[4] then best = b end   -- 最靠前的一块
      end
      return best and V(best[2], best[3], best[4]) or nil
    elseif slot == "aps" then
      local a = L.aps and L.aps.l and L.aps.l[1]
      return a and V(a[1], a[2] + 0.4, a[3]) or nil
    elseif slot == "roof" then
      return TM.kitPivot(L)
    end
  end

  local refresh
  local function choose(slot, opt)
    if not S then return end
    S.mods[slot] = opt
    S.mods = TM.clean(S.id, S.mods)
    S.focus = opt
    refresh(true)
  end

  local cards = {}
  local function card(text, sub2, h, color, order)
    local b = square(ui.button(left, "", UDim2.fromOffset(330, h), nil, color or RGB(20, 24, 28)))
    b.LayoutOrder = order
    b.AutoButtonColor = true
    ui.stroke(b, RGB(255, 255, 255), 1, 0.88)
    local t1 = ui.label(b, text, UD2(1, -24, 0, 20), UDim2.fromOffset(12, 8), 15, TEXT, Enum.Font.GothamBold)
    local t2 = ui.label(b, sub2 or "", UD2(1, -24, 0, 16), UDim2.fromOffset(12, h - 24), 12, ACC, Enum.Font.GothamMedium)
    t1.TextXAlignment, t2.TextXAlignment = Enum.TextXAlignment.Left, Enum.TextXAlignment.Left
    table.insert(cards, b)
    return b, t1, t2
  end

  refresh = function(remodel)
    if not S then return end
    local d = S.d
    if remodel then
      if S.M then S.M.model:Destroy() end
      S.M = VM.build(d, S.team, S.mods)
      pose(S.M, d)
      S.M.model.Parent = world
    end
    for _, c in ipairs(cards) do c:Destroy() end
    cards = {}
    local F = TM.FOR[S.id]
    local order = 0
    for _, slot in ipairs(TM.SLOTS) do
      local list = F[slot] or {}
      local cur = S.mods[slot]
      local fixed = #list <= 1
      order += 1
      local b = card(T("gar.slot." .. slot), (fixed and (T("gar.fixed") .. " · ") or "") .. T("gar.opt." .. cur), 56, (S.open == slot) and RGB(26, 40, 46) or nil, order)
      b.Activated:Connect(function()
        if not S then return end
        S.open = (S.open == slot) and nil or slot
        S.focus = cur
        refresh(false)
      end)
      if S.open == slot and not fixed then
        for _, opt in ipairs(list) do
          order += 1
          local sel = opt == cur
          local ob, t1 = card("    " .. T("gar.opt." .. opt), "", 34, sel and RGB(40, 92, 100) or RGB(14, 17, 20), order)
          t1.TextColor3 = sel and RGB(255, 255, 255) or RGB(206, 212, 214)
          ob.Activated:Connect(function() choose(slot, opt) end)
        end
      end
    end
    local f = S.focus or S.mods.era
    infoT.Text = T("gar.opt." .. f)
    infoD.Text = T("gar.d." .. f)
    local dd = TM.applyDef(d, S.mods)
    infoS.Text = T("gar.speed", math.floor(dd.speed / 2.8 * 3.6 + 0.5))
    title.Text = T("gar.title") .. "  ·  " .. T("veh." .. S.id)
  end

  local function close()
    if S and S.M then S.M.model:Destroy() end
    S = nil
    for _, b in ipairs(spotBtns) do b:Destroy() end
    spotBtns = {}
    gui.Enabled = false
  end

  backBtn.Activated:Connect(close)
  goBtn.Activated:Connect(function()
    if not S then return end
    local fn, mods = S.onSpawn, table.clone(S.mods)
    close()
    if fn then fn(mods) end
  end)

  -- 拖动转视角、滚轮缩放
  local drag, lastPos = false, nil
  bg.InputBegan:Connect(function(io)
    if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
      drag, lastPos = true, io.Position
      if S then S.idle = 0 end
    end
  end)
  UIS.InputEnded:Connect(function(io)
    if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then drag = false end
  end)
  UIS.InputChanged:Connect(function(io)
    if not S then return end
    if drag and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) and lastPos then
      local dlt = io.Position - lastPos
      lastPos = io.Position
      S.tYaw -= dlt.X * 0.01
      S.tPitch = math.clamp(S.tPitch + dlt.Y * 0.006, math.rad(-5), math.rad(60))
      S.idle = 0
    elseif io.UserInputType == Enum.UserInputType.MouseWheel then
      S.tDist = math.clamp(S.tDist * (1 - io.Position.Z * 0.1), S.size * 0.9, S.size * 3)
    end
  end)

  RunService.RenderStepped:Connect(function(dt)
    if not S then return end
    S.idle = (S.idle or 0) + dt
    if S.idle > 3 and not drag then S.tYaw += dt * 0.25 end   -- 不动时自己慢慢转
    local k = math.min(1, dt * 8)
    S.yaw += (S.tYaw - S.yaw) * k
    S.pitch += (S.tPitch - S.pitch) * k
    S.dist += (S.tDist - S.dist) * k
    local c = V(0, S.d.H * 0.45, 0)
    local dir = V(math.sin(S.yaw) * math.cos(S.pitch), math.sin(S.pitch), math.cos(S.yaw) * math.cos(S.pitch))
    vcam.CFrame = CFrame.lookAt(c + dir * S.dist, c)
    -- 白圈跟着模型上的点（同 Hangar.lua 的 project：界面铺满整屏、不让顶栏，框的大小就是屏幕大小）
    local vs = workspace.CurrentCamera.ViewportSize
    local tanY = math.tan(math.rad(vcam.FieldOfView) / 2)
    for _, b in ipairs(spotBtns) do
      local wp = slotPoint(b:GetAttribute("Slot"))
      local lp = wp and vcam.CFrame:PointToObjectSpace(wp)
      if lp and lp.Z < -0.5 then
        local nx = lp.X / (-lp.Z * tanY * (vs.X / math.max(vs.Y, 1)))
        local ny = lp.Y / (-lp.Z * tanY)
        b.Visible = true
        b.Position = UDim2.fromOffset((nx + 1) / 2 * vs.X, (1 - ny) / 2 * vs.Y)
        local open = S.open == b:GetAttribute("Slot")
        b.Size = open and UDim2.fromOffset(30, 30) or UDim2.fromOffset(24, 24)
        b.BackgroundTransparency = open and 0.25 or 0.8
      else
        b.Visible = false
      end
    end
  end)

  function G.openGarage(id, mods, onSpawn)
    local d = VD.get(id)
    if not d or not TM.has(id) then return false end
    if S then close() end
    local size = math.max(d.L, d.W)
    S = { id = id, d = d, mods = TM.clean(id, mods), team = me:GetAttribute("Side") or "atk", onSpawn = onSpawn,
      yaw = math.rad(140), pitch = math.rad(16), dist = size * 1.7, size = size, open = "aps" }
    S.tYaw, S.tPitch, S.tDist = S.yaw, S.pitch, S.dist
    S.focus = S.mods.aps
    gui.Enabled = true
    for _, slot in ipairs(TM.SLOTS) do
      local b = Instance.new("TextButton")
      b.Text = ""
      b.AnchorPoint = Vector2.new(0.5, 0.5)
      b.BackgroundColor3 = RGB(255, 255, 255)
      b.BackgroundTransparency = 0.8
      b.BorderSizePixel = 0
      b:SetAttribute("Slot", slot)
      local cr = Instance.new("UICorner")
      cr.CornerRadius = UDim.new(1, 0)
      cr.Parent = b
      ui.stroke(b, RGB(255, 255, 255), 2, 0.1)
      b.Parent = spots
      b.Activated:Connect(function()
        if not S then return end
        S.open = slot
        S.focus = S.mods[slot]
        refresh(false)
      end)
      table.insert(spotBtns, b)
    end
    refresh(true)
    return true
  end
  G.garageOpen = function() return S ~= nil end   -- 测试用
  G.garageState = function() return S end
end

return Garage
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="86">
          <Properties>
            <string name="Name">GearView</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——装备的 3D 小图（部署界面的装备格、右边的大图）
--   有真模型就用：手持装备是 Sketchfab 原模型（导入的或现生成的，Optics.lua），M4 是第一人称那支（FPSView）；
--   没有就用服务器放在 ReplicatedStorage.ToolPreview 里的工具样子（零件拼的，导入了原模型的工具上也是原模型）
--   G.gearModel(武器, 阵营) → Model（器材坐标：+Z 朝前、+Y 朝上），真模型还在生成中（过一会儿再要一次），是不是真模型
--   G.viewFit(ViewportFrame, Model, 留边, 视线方向) 把模型放进视口，相机（默认从右前方略俯视）按投影后的大小正好装下
local RS = game:GetService("ReplicatedStorage")

local GearView = {}

function GearView.init(G)
  local GD = require(RS:WaitForChild("GearDefs"))
  local CF, V = CFrame.new, Vector3.new
  local FLIP = CFrame.Angles(0, math.pi, 0)   -- 工具的枪口朝 −Z → 器材坐标 +Z

  local function realModel(id, team)
    local key = GD.key(id, team)
    local M = key and G.opticMeta and G.opticMeta[key]
    if not M or not G.opticParts then return nil, false end
    local mk = GD.MOUNT[key]
    if mk and not G.opticMeta[mk.key] then mk = nil end
    local op = G.opticParts(key)
    local mp = mk and G.opticParts(mk.key)
    if op and (not mk or mp) then
      local m = Instance.new("Model")
      for _, x in ipairs(op) do
        x.part.CFrame = x.cf
        x.part.Parent = m
      end
      if mp then
        local at = GD.mountAt(key, M)
        for _, x in ipairs(mp) do
          x.part.CFrame = at * x.cf
          x.part.Parent = m
        end
      end
      return m, false
    end
    local failed = G.opticFailed and (G.opticFailed(key) or (mk and G.opticFailed(mk.key)))
    return nil, not failed
  end

  local function toolModel(id, team)
    local tp = RS:FindFirstChild("ToolPreview")
    tp = tp and (tp:FindFirstChild(team or "def") or tp:FindFirstChild("def"))
    local t = tp and tp:FindFirstChild(id)
    local h = t and t:FindFirstChild("Handle")
    if not h then return nil end
    local m = Instance.new("Model")
    for _, d in ipairs(t:GetDescendants()) do
      if d:IsA("BasePart") and d ~= h and d.Transparency < 1 then
        local q = d:Clone()
        for _, c in ipairs(q:GetChildren()) do
          if not c:IsA("SurfaceAppearance") then c:Destroy() end
        end
        q.Anchored, q.CanCollide, q.CanQuery, q.CanTouch = true, false, false, false
        q.CFrame = FLIP * h.CFrame:ToObjectSpace(d.CFrame)
        q.Parent = m
      end
    end
    return m
  end

  function G.gearModel(id, team)
    local m, wait = realModel(id, team)
    if m then return m, false, true end
    if id == "m4" and G.m4Model then
      local mm = G.m4Model()
      if mm then return mm, false, true end
      wait = true
    end
    -- 工具上导入了原模型的（MeshPart）也算真的
    local tm = toolModel(id, team)
    local real = false
    if tm then
      for _, p in ipairs(tm:GetChildren()) do if p:IsA("MeshPart") then real = true end end
    end
    return tm, wait, real
  end

  -- 相机：从器材的右边、略靠前、略高处看过去（枪口朝屏幕右边）
  local LOOK = V(1, -0.2, -0.16).Unit
  function G.viewFit(vp, model, pad, look)
    for _, c in ipairs(vp:GetChildren()) do
      if c:IsA("Model") or c:IsA("Camera") or c:IsA("WorldModel") or c:IsA("BasePart") then c:Destroy() end
    end
    local cam = Instance.new("Camera")
    cam.FieldOfView = 24
    cam.Parent = vp
    vp.CurrentCamera = cam
    if not model then return end
    model.Parent = vp
    local R = CFrame.lookAt(V(), look or LOOK)
    local mn, mx = V(1e9, 1e9, 1e9), V(-1e9, -1e9, -1e9)
    for _, p in ipairs(model:GetDescendants()) do
      if p:IsA("BasePart") then
        local h = p.Size / 2
        for sx = -1, 1, 2 do
          for sy = -1, 1, 2 do
            for sz = -1, 1, 2 do
              local w = p.CFrame * V(sx * h.X, sy * h.Y, sz * h.Z)
              local l = R:PointToObjectSpace(w)
              mn = V(math.min(mn.X, l.X), math.min(mn.Y, l.Y), math.min(mn.Z, l.Z))
              mx = V(math.max(mx.X, l.X), math.max(mx.Y, l.Y), math.max(mx.Z, l.Z))
            end
          end
        end
      end
    end
    if mn.X > mx.X then return end
    local okA, abs = pcall(function() return vp.AbsoluteSize end)
    local aspect = (okA and abs and abs.X > 4 and abs.Y > 4) and (abs.X / abs.Y) or (16 / 9)
    local tv = math.tan(math.rad(cam.FieldOfView) / 2)
    local w, h = mx.X - mn.X, mx.Y - mn.Y
    local dist = math.max((w / 2) / (tv * aspect), (h / 2) / tv) * (pad or 1.12) + (mx.Z - mn.Z) / 2
    local c = (mn + mx) / 2
    cam.CFrame = R * CF(c.X, c.Y, c.Z + dist)
    -- 转的时候绕模型中心：中心记在属性 C 里，模型的轴心挪到那儿（零件的位置不动）
    local center = R * c
    pcall(function()
      model.WorldPivot = CF(center)
      model:SetAttribute("C", center)
    end)
  end
end

return GearView
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="87">
          <Properties>
            <string name="Name">Gunner</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——操作地图自带的工事（走到跟前按 E 接手，F 离开）
--   机枪碉堡：坐在机枪后面从射孔往外看，鼠标转枪（左右各 60°），按住左键连发；
--   高炮：炮后面的追尾镜头，按住左键连发（近炸引信），准星旁边给最近的敌机画提前量菱形；
--   岸防炮：炮塔后面的镜头，右键 / V 进瞄准镜（滚轮换倍率），准星指哪儿炮按弹道自己抬到哪儿，左键一发；
--   榴弹炮：高处往前看，准星下的地面就是落点（地上一个圈、显示距离和射程），左键开炮；炮只能左右转 25°
--   炮塔转动有速度上限（和服务器一样），每秒 12 次把方位、俯仰报给服务器
--   另：工兵的破障器材（G.breachStep，Play 每帧调）——每半秒探一次雷，地上标出来；按住左键排雷 / 剪铁丝网（有进度）
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local Gunner = {}

function Gunner.init(G)
  local FD = require(RS:WaitForChild("FortDefs"))
  local Map = G.Map
  local Config = G.Config
  local V, CF, RGB = Vector3.new, CFrame.new, Color3.fromRGB
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local ui = G.ui
  local function T(k, ...) return G.T(k, ...) end
  local SHELL_G = workspace.Gravity * 0.55

  local gs = nil   -- 正在操作的工事
  G.gunner = nil

  ---------------------------------------------------------------- 界面

  local gui = Instance.new("ScreenGui")
  gui.Name = "Gunner"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 5
  gui.Parent = me:WaitForChild("PlayerGui")

  local panel = ui.frame(gui, UDim2.fromOffset(420, 70), UDim2.new(0.5, 0, 1, -24), RGB(12, 16, 20), 0.3, Vector2.new(0.5, 1))   -- 操作说明在屏幕最下面一行（UI.lua，gs.help）
  panel.Visible = false
  local fName = ui.label(panel, "", UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 6), 16, Color3.new(1, 1, 1), Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  local hpBg = ui.frame(panel, UDim2.new(1, -20, 0, 6), UDim2.fromOffset(10, 29), RGB(0, 0, 0), 0.4)
  local hpBar = ui.frame(hpBg, UDim2.fromScale(1, 1), nil, RGB(90, 210, 110), 0)
  local fInfo = ui.label(panel, "", UDim2.new(1, -20, 0, 18), UDim2.fromOffset(10, 38), 14, Color3.new(1, 1, 1), Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local relBg = ui.frame(panel, UDim2.new(1, -20, 0, 4), UDim2.fromOffset(10, 58), RGB(0, 0, 0), 0.5)
  local relBar = ui.frame(relBg, UDim2.fromScale(1, 1), nil, RGB(240, 200, 80), 0)
  ui.flatPanel(panel, { hp = hpBg, rel = relBg, name = fName })   -- 跟新界面一个样子（UI.lua）
  local cross = ui.label(gui, "+", UDim2.fromOffset(30, 30), UDim2.fromScale(0.5, 0.5), 26, Color3.new(1, 1, 1), Enum.Font.GothamBold, Vector2.new(0.5, 0.5))
  cross.TextStrokeTransparency = 0.4
  cross.Visible = false
  local gunMark = ui.label(gui, "◯", UDim2.fromOffset(26, 26), UDim2.fromScale(0.5, 0.5), 20, RGB(255, 210, 80), Enum.Font.GothamBold, Vector2.new(0.5, 0.5))
  gunMark.TextStrokeTransparency = 0.3
  gunMark.Visible = false
  local leadMark = ui.label(gui, "◇", UDim2.fromOffset(26, 26), UDim2.fromScale(0.5, 0.5), 24, RGB(255, 90, 70), Enum.Font.GothamBold, Vector2.new(0.5, 0.5))
  leadMark.TextStrokeTransparency = 0.3
  leadMark.Visible = false
  local rangeText = ui.label(gui, "", UDim2.fromOffset(320, 24), UDim2.new(0.5, 0, 0.5, 34), 16, RGB(255, 236, 170), Enum.Font.Code, Vector2.new(0.5, 0))
  rangeText.TextStrokeTransparency = 0.4
  rangeText.Visible = false
  local scopeBox = ui.frame(gui, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)
  scopeBox.Visible = false
  do   -- 瞄准镜：四周压暗的圆、细十字
    local eye = Instance.new("Frame")
    eye.AnchorPoint = Vector2.new(0.5, 0.5)
    eye.Position = UDim2.fromScale(0.5, 0.5)
    eye.Size = UDim2.fromScale(0.86, 0.86)
    eye.BackgroundTransparency = 1
    eye.Parent = scopeBox
    local a = Instance.new("UIAspectRatioConstraint")
    a.AspectRatio = 1
    a.Parent = eye
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0.5, 0)
    c.Parent = eye
    local s = Instance.new("UIStroke")
    s.Thickness = 900
    s.Color = Color3.new(0, 0, 0)
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = eye
    ui.frame(scopeBox, UDim2.new(0.5, 0, 0, 1), UDim2.fromScale(0.5, 0.5), RGB(230, 230, 230), 0.2, Vector2.new(0.5, 0.5))
    ui.frame(scopeBox, UDim2.new(0, 1, 0.5, 0), UDim2.fromScale(0.5, 0.5), RGB(230, 230, 230), 0.2, Vector2.new(0.5, 0.5))
  end

  -- 榴弹炮的落点圈（只在本机）
  local ring = Instance.new("Part")
  ring.Shape = Enum.PartType.Cylinder
  ring.Size = V(0.3, 30, 30)
  ring.Color = RGB(255, 80, 60)
  ring.Material = Enum.Material.Neon
  ring.Transparency = 1
  ring.Anchored, ring.CanCollide, ring.CanQuery, ring.CanTouch = true, false, false, false
  ring.CastShadow = false
  ring.Parent = workspace

  ---------------------------------------------------------------- 开始、结束

  local function findEnt(id)
    local f = workspace:FindFirstChild("Ents")
    if not f then return nil end
    for _, em in ipairs(f:GetChildren()) do
      if em:GetAttribute("EntId") == id then return em end
    end
    return nil
  end

  local aimParams = RaycastParams.new()
  aimParams.FilterType = Enum.RaycastFilterType.Exclude

  local function begin(vs)
    local em = findEnt(vs.id)
    if not em then return end
    local d = FD.D[vs.fort]
    if not d then return end
    local root = em:FindFirstChild("Root")
    if not root then return end
    local base = root.CFrame * CF(0, -d.size.Y / 2, 0)
    local ty, gp = em:GetAttribute("Ty") or 0, em:GetAttribute("Gp") or 0
    local look = base.LookVector
    gs = { id = vs.id, em = em, kind = vs.fort, d = d, w = FD.W[d.weapon], base = base, ty = ty, gp = gp,
      ay = ty, ap = gp, camYaw = math.atan2(-look.X, -look.Z), camPitch = (vs.fort == "howitzer") and -0.32 or -0.1,
      sight = false, zoom = 1, firing = false, sendT = 0, nextAt = 0 }
    G.gunner, G.drive = gs, gs   -- G.drive：步兵的操作（Play）先停下
    cam.CameraType = Enum.CameraType.Scriptable
    panel.Visible, cross.Visible = true, true
    if G.touchGunUI then G.touchGunUI.Visible = true end
    if G.playSound then G.playSound("capture") end
  end

  local function stop()
    if gs and gs.firing then G.R.Drive:FireServer({ op = "trig", on = false }) end
    gs = nil
    if G.drive and G.drive == G.gunner then G.drive = nil end
    G.gunner = nil
    cam.CameraType = Enum.CameraType.Custom
    cam.FieldOfView = 70
    if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then UIS.MouseBehavior = Enum.MouseBehavior.Default end
    panel.Visible, cross.Visible, gunMark.Visible, leadMark.Visible, rangeText.Visible, scopeBox.Visible = false, false, false, false, false, false
    ring.Transparency = 1
    if G.touchGunUI then G.touchGunUI.Visible = false end
  end

  ---------------------------------------------------------------- 开火

  local function auto() return gs.w.kind == "gun" or gs.w.kind == "flak" end
  local function setTrig(on)
    if not gs then return end
    if auto() then
      if on ~= gs.firing then G.R.Drive:FireServer({ op = "trig", on = on }) end
      gs.firing = on
    elseif on then
      local t = os.clock()
      if t < gs.nextAt then return end
      gs.nextAt = t + gs.w.rate
      G.R.Drive:FireServer({ op = "fire", aim = gs.aimPt })
      if G.shake then G.shake(0.25) end
      if G.vehRecoil then G.vehRecoil(gs.id) end
    end
  end
  G.gunnerTrig = setTrig

  ---------------------------------------------------------------- 手机：开火、瞄准镜、离开；拖屏幕转炮

  if UIS.TouchEnabled then
    local rb = ui.frame(gui, UDim2.fromOffset(240, 200), UDim2.new(1, -250, 1, -300), RGB(0, 0, 0), 1)
    rb.Visible = false
    local function btn(text, pos, size)
      local b = ui.button(rb, text, UDim2.fromOffset(size or 64, size or 64), pos, RGB(30, 36, 42))
      b.BackgroundTransparency = 0.35
      b.TextSize = 15
      return b
    end
    local fb = btn("●", UDim2.fromOffset(140, 100), 90)
    fb.InputBegan:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch then setTrig(true) end end)
    fb.InputEnded:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch then setTrig(false) end end)
    btn("◎", UDim2.fromOffset(60, 120)).Activated:Connect(function() if gs then gs.sight = not gs.sight end end)
    btn("F", UDim2.fromOffset(0, 0)).Activated:Connect(function() G.R.Drive:FireServer({ op = "exit" }) end)
    G.touchGunUI = rb
  end

  ---------------------------------------------------------------- 输入

  local ZOOMS = { 24, 9 }
  UIS.InputBegan:Connect(function(io, gpe)
    if gpe or not gs then return end
    local k = io.KeyCode
    if io.UserInputType == Enum.UserInputType.MouseButton1 then
      setTrig(true)
    elseif io.UserInputType == Enum.UserInputType.MouseButton2 or k == Enum.KeyCode.V then
      gs.sight = not gs.sight
    elseif k == Enum.KeyCode.Z then
      gs.zoom = gs.zoom % #ZOOMS + 1
    elseif k == Enum.KeyCode.F or k == Enum.KeyCode.Space then   -- 空格也能离开炮位
      G.R.Drive:FireServer({ op = "exit" })
    end
  end)
  UIS.InputEnded:Connect(function(io)
    if gs and io.UserInputType == Enum.UserInputType.MouseButton1 then setTrig(false) end
  end)
  UIS.InputChanged:Connect(function(io)
    if not gs then return end
    if gs.sight and io.UserInputType == Enum.UserInputType.MouseWheel then
      gs.zoom = math.clamp(gs.zoom + ((io.Position.Z > 0) and 1 or -1), 1, #ZOOMS)
    elseif io.UserInputType == Enum.UserInputType.Touch and io.Delta then   -- 手机：拖屏幕转
      gs.touchD = (gs.touchD or Vector2.new()) + Vector2.new(io.Delta.X, io.Delta.Y)
    end
  end)

  ---------------------------------------------------------------- 每帧

  local function angDiff(a, b) return (b - a + 180) % 360 - 180 end
  local function approach(a, b, s) if a < b then return math.min(b, a + s) end return math.max(b, a - s) end
  -- 工事坐标系里的方位、俯仰 → 世界方向
  local function dirOf(base, yaw, pitch) return (base * CFrame.Angles(0, -math.rad(yaw), 0) * CFrame.Angles(math.rad(pitch), 0, 0)).LookVector end
  local function anglesOf(base, dir)
    local l = base:VectorToObjectSpace(dir)
    return math.deg(math.atan2(l.X, -l.Z)), math.deg(math.atan2(l.Y, math.sqrt(l.X * l.X + l.Z * l.Z)))
  end
  local function lowAngle(v, g, R, h)
    local v2 = v * v
    local disc = v2 * v2 - g * (g * R * R + 2 * h * v2)
    if disc < 0 or R < 1 then return nil end
    return math.atan((v2 - math.sqrt(disc)) / (g * R))
  end

  -- 准星打到哪：从镜头往前打一条射线（不算实体的样子、自己）
  local function aimRay(o, dir, len)
    local ex = { G.viewFolder }
    if me.Character then table.insert(ex, me.Character) end
    if gs and gs.em then table.insert(ex, gs.em) end
    aimParams.FilterDescendantsInstances = ex
    local res = workspace:Raycast(o, dir * len, aimParams)
    return res and res.Position or (o + dir * len), res ~= nil
  end

  -- 高炮：准星附近（20° 以内）最近的敌机，按它的速度和炮弹速度算提前量
  local track = {}
  local function leadFor(o)
    local ents = workspace:FindFirstChild("Ents")
    if not ents then return nil end
    local best, bd = nil, math.huge
    local look = cam.CFrame.LookVector
    local side = me:GetAttribute("Side")
    local t = os.clock()
    for _, m in ipairs(ents:GetChildren()) do
      if m:GetAttribute("Cat") == "air" and m:GetAttribute("Team") ~= side then
        local r = m:FindFirstChild("Root")
        if r then
          local p = r.Position
          local tr = track[m]
          if tr and t > tr.t then
            local v = (p - tr.p) / (t - tr.t)
            tr.v = tr.v and tr.v:Lerp(v, 0.25) or v
          end
          track[m] = { p = p, t = t, v = tr and tr.v or V() }
          local to = p - o
          local d = to.Magnitude
          if d < gs.w.range * 1.1 and to.Unit:Dot(look) > math.cos(math.rad(20)) and d < bd then best, bd = m, d end
        end
      end
    end
    if not best then return nil end
    local tr = track[best]
    local s = gs.w.speed
    local rel = tr.p - o
    local tof = rel.Magnitude / s
    for _ = 1, 3 do tof = ((tr.p + tr.v * tof) - o).Magnitude / s end
    return tr.p + tr.v * tof + V(0, 0.5 * SHELL_G * (gs.w.gscale or 0) * tof * tof, 0)
  end

  local SENS = 0.0042
  function G.stepGunner(dt)
    local S = G.S
    local vs = S and S.alive and S.veh or nil
    if vs and not vs.fort then vs = nil end
    if vs and (not gs or gs.id ~= vs.id) then
      if gs then stop() end
      begin(vs)
    elseif not vs and gs then
      stop()
    end
    if not gs then return end
    if not gs.em.Parent then stop() return end
    local d, w = gs.d, gs.w
    local root = gs.em:FindFirstChild("Root")
    if root then gs.base = root.CFrame * CF(0, -d.size.Y / 2, 0) end
    local base = gs.base
    local Tt = d.turret
    local full = Tt.arc >= 180
    -- 鼠标（手机拖屏幕）：转想要的方向
    UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
    local md = UIS:GetMouseDelta()
    if gs.touchD then md = md + gs.touchD * 0.6 gs.touchD = nil end
    local fov = gs.sight and ZOOMS[gs.zoom] or 70
    local sens = SENS * fov / 70
    local tPivot = (base * CF(Tt.pivot)).Position
    local o, look
    if gs.kind == "bunker" or gs.kind == "aaa" then
      -- 鼠标直接给想要的方位、俯仰（碉堡里限在射孔的范围内）；方位顺时针为正（dirOf），鼠标往右就是往右转
      --   （用户：驾驶炮的时候视角转动是反着的——原来减号，往右推鼠标高炮、机枪往左转）
      gs.ay = gs.ay + md.X * sens * 57.3
      gs.ap = math.clamp(gs.ap - md.Y * sens * 57.3, Tt.elev[1], Tt.elev[2])
      if full then gs.ay = (gs.ay + 180) % 360 - 180 else gs.ay = math.clamp(gs.ay, -Tt.arc, Tt.arc) end
      look = dirOf(base, gs.ay, gs.ap)
      if gs.kind == "bunker" then
        local tF = base * CF(Tt.pivot) * CFrame.Angles(0, -math.rad(gs.ty), 0)
        o = (tF * CF(0, 0.45, 1.7)).Position   -- 机枪后面，眼睛和射孔一样高
      else
        o = tPivot + dirOf(base, gs.ay, 0) * -16 + V(0, 5, 0)
      end
      if gs.sight then o = tPivot + V(0, 1.4, 0) end
      cam.CFrame = CFrame.lookAt(o, o + look)
      gs.aimPt = aimRay(cam.CFrame.Position, look, w.range)
    else
      -- 岸防炮、榴弹炮：镜头绕着炮转，准星指哪儿炮算到哪儿
      gs.camYaw -= md.X * sens
      gs.camPitch = math.clamp(gs.camPitch - md.Y * sens, -1.2, 0.5)
      local dirCam = CFrame.Angles(0, gs.camYaw, 0) * CFrame.Angles(gs.camPitch, 0, 0)
      look = dirCam.LookVector
      if gs.sight then
        o = tPivot + V(0, (gs.kind == "coastal") and 6 or 4, 0)
      elseif gs.kind == "coastal" then
        o = tPivot + dirCam:VectorToWorldSpace(V(0, 0, 34)) + V(0, 10, 0)
      else
        o = tPivot + dirCam:VectorToWorldSpace(V(0, 0, 30)) + V(0, 22, 0)
      end
      cam.CFrame = CFrame.lookAt(o, o + look)
      local maxL = (w.kind == "arty") and (w.maxR + 600) or w.range
      gs.aimPt = aimRay(o, look, maxL)
      local rel = gs.aimPt - tPivot
      local yaw = anglesOf(base, rel)
      local R = V(rel.X, 0, rel.Z).Magnitude
      if w.kind == "shell" then   -- 按弹道自动抬炮
        local mz = (base * CF(Tt.pivot) * CF(d.gun.pivot)).Position
        local rr = gs.aimPt - mz
        local th = lowAngle(w.speed, SHELL_G * w.gscale, V(rr.X, 0, rr.Z).Magnitude, rr.Y)
        gs.ay, gs.ap = yaw, th and math.deg(th) or Tt.elev[2]
      else   -- 榴弹炮：炮管抬到大约（只是好看，落点按准星算）
        gs.ay, gs.ap = yaw, math.clamp(18 + R / w.maxR * 45, 15, 65)
      end
      if not full then gs.ay = math.clamp(gs.ay, -Tt.arc, Tt.arc) end
      gs.ap = math.clamp(gs.ap, Tt.elev[1], Tt.elev[2])
    end
    cam.FieldOfView = cam.FieldOfView + (fov - cam.FieldOfView) * math.min(1, dt * 10)
    -- 炮塔（和服务器一样的回转速度）
    local s = Tt.trav * dt
    if full then gs.ty = (gs.ty + math.clamp(angDiff(gs.ty, gs.ay), -s, s) + 180) % 360 - 180
    else gs.ty = gs.ty + math.clamp(gs.ay - gs.ty, -s, s) end
    gs.gp = approach(gs.gp, gs.ap, math.max(30, Tt.trav) * dt)
    -- 报给服务器
    gs.sendT -= dt
    if gs.sendT <= 0 then
      gs.sendT = 1 / 12
      G.R.Drive:FireServer({ op = "aim", ty = gs.ty, gp = gs.gp, aim = gs.aimPt })
    end
    -- 炮现在指着哪（黄圈）；高炮的提前量（红菱形）
    local gF = FD.gunCF(d, base, gs.ty, gs.gp)
    local far = gF.Position + gF.LookVector * math.max(40, (gs.aimPt - gF.Position).Magnitude)
    local sp, on = cam:WorldToViewportPoint(far)
    gunMark.Visible = on and w.kind ~= "arty" and not gs.sight
    gunMark.Position = UDim2.fromOffset(sp.X, sp.Y)
    leadMark.Visible = false
    if w.kind == "flak" then
      local lp = leadFor(gF.Position)
      if lp then
        local p2, on2 = cam:WorldToViewportPoint(lp)
        leadMark.Visible = on2
        leadMark.Position = UDim2.fromOffset(p2.X, p2.Y)
      end
    end
    scopeBox.Visible = gs.sight and w.kind ~= "arty"
    -- 榴弹炮：落点圈、距离
    rangeText.Visible = w.kind == "arty" or w.kind == "shell"
    if w.kind == "arty" then
      local a = gs.aimPt
      local dist = V(a.X - tPivot.X, 0, a.Z - tPivot.Z).Magnitude
      local okR = dist >= w.minR and dist <= w.maxR
      ring.Transparency = 0.45
      ring.Color = okR and RGB(255, 200, 70) or RGB(255, 60, 50)
      ring.CFrame = CF(a.X, Map.ground(a.X, a.Z) + 0.3, a.Z) * CFrame.Angles(0, 0, math.pi / 2)
      rangeText.Text = T("ui.howRange", math.floor(dist / 2.8 + 0.5), math.floor(w.minR / 2.8), math.floor(w.maxR / 2.8))
      rangeText.TextColor3 = okR and RGB(255, 236, 170) or RGB(255, 110, 90)
    elseif w.kind == "shell" then
      ring.Transparency = 1
      local dist = (gs.aimPt - tPivot).Magnitude
      rangeText.Text = string.format("%04d m   %+.1f°", math.floor(dist / 2.8 / 5 + 0.5) * 5, gs.gp)
    else
      ring.Transparency = 1
    end
    cross.Visible = not (gs.sight and w.kind ~= "arty")
    -- 仪表
    local em = gs.em
    local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
    hpBar.Size = UDim2.fromScale(math.clamp(hp / mx, 0, 1), 1)
    hpBar.BackgroundColor3 = ui.hpColor(hp / mx)
    fName.Text = T("fort." .. gs.kind)
    local info = T("fw." .. w.id)
    local rel = 1
    if vs.reload and vs.reload > 0 then
      info = info .. "    " .. T("ui.reloadIn", math.ceil(vs.reload))
      rel = 0
    elseif vs.mag then
      info = info .. "    " .. vs.mag .. " / " .. (vs.magMax or "∞")
    end
    if not auto() then
      local left = gs.nextAt - os.clock()
      rel = 1 - math.clamp(left / w.rate, 0, 1)
    end
    relBar.Size = UDim2.fromScale(rel, 1)
    fInfo.Text = info
    gs.help = (w.kind == "arty") and "ui.howHelp" or "ui.fortHelp"
  end

  ---------------------------------------------------------------- 工兵的破障器材

  local RShoot = G.R.Shoot
  local W = Config.Weapons.breach
  local marks = {}       -- 本机探到的雷：[编号] = { part, p }
  local known = {}       -- 队友探出来的雷
  local scanT, work = 0, nil
  local wireList = {}
  do
    local ok, ob = pcall(FD.obstacles, Map)
    if ok and ob then wireList = ob.wire end
  end

  local function mark(list, key, p, at, far)
    local m = list[key]
    if m then m.p = p return end
    local a = Instance.new("Part")
    a.Size, a.Transparency, a.Anchored = V(0.2, 0.2, 0.2), 1, true
    a.CanCollide, a.CanQuery, a.CanTouch = false, false, false
    a.CFrame = CF(p + V(0, 2.2, 0))
    a.Parent = workspace
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(22, 22)
    bb.AlwaysOnTop = true
    bb.MaxDistance = far and 220 or 80
    bb.Parent = a
    local l = Instance.new("TextLabel")
    l.Size = UDim2.fromScale(1, 1)
    l.BackgroundTransparency = 1
    l.Text = at and "▲" or "●"
    l.TextScaled = true
    l.TextColor3 = at and RGB(255, 140, 40) or RGB(255, 60, 50)
    l.TextStrokeTransparency = 0.3
    l.Parent = bb
    list[key] = { part = a, p = p }
  end
  local function setMarks(list, items, far)
    local seen = {}
    for _, it in ipairs(items or {}) do
      if typeof(it.p) == "Vector3" then
        seen[it.k] = true
        mark(list, it.k, it.p, it.at, far)
      end
    end
    for k, m in pairs(list) do
      if not seen[k] then m.part:Destroy() list[k] = nil end
    end
  end

  -- 服务器发来的雷：自己探到的（mine）、队友探出来的（known）
  local onFx0 = G.onFx
  G.onFx = function(list)
    for _, e in ipairs(list) do
      if e.k == "mines" then
        if e.known then setMarks(known, e.list, true) else setMarks(marks, e.list, false) end
      elseif e.k == "wireCut" and G.playSound then G.playSound("repair", e.p)
      elseif e.k == "defuse" and G.playSound then G.playSound("heal", e.p) end
    end
    if onFx0 then onFx0(list) end
  end

  local function nearestThing(hp)
    local best, bd, kind = nil, W.range, nil
    for k, m in pairs(marks) do
      local dd = V(m.p.X - hp.X, 0, m.p.Z - hp.Z).Magnitude
      if dd < bd then best, bd, kind = k, dd, "mine" end
    end
    if best then return best, kind end
    local wf = workspace:FindFirstChild("Map")
    wf = wf and wf:FindFirstChild("Wire")
    for i, Wr in ipairs(wireList) do
      if wf and wf:FindFirstChild("Wire" .. i) then
        local ax, az, bx, bz = Wr.a.X, Wr.a.Z, Wr.b.X, Wr.b.Z
        local dx, dz = bx - ax, bz - az
        local L2 = dx * dx + dz * dz
        local k = (L2 > 0) and math.clamp(((hp.X - ax) * dx + (hp.Z - az) * dz) / L2, 0, 1) or 0
        local dd = V(ax + dx * k - hp.X, 0, az + dz * k - hp.Z).Magnitude
        if dd < bd then best, bd, kind = "w" .. i, dd, "wire" end
      end
    end
    return best, kind
  end

  -- Play 每帧调：active 拿着破障器材、firing 按着左键；返回要显示的提示
  function G.breachStep(dt, active, firing)
    if not active then
      if next(marks) then setMarks(marks, {}, false) end
      work = nil
      return nil
    end
    local char = me.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end
    scanT -= dt
    if scanT <= 0 then
      scanT = 0.5
      RShoot:FireServer("breach", "scan")
    end
    local key, kind = nearestThing(hrp.Position)
    if firing and key then
      if not work or work.key ~= key then
        work = { key = key, kind = kind, t = 0 }
        RShoot:FireServer("breach", "start", key)
      end
      work.t += dt
      if work.t >= W.time then
        RShoot:FireServer("breach", "done", key)
        if kind == "mine" and marks[key] then marks[key].part:Destroy() marks[key] = nil end
        work = nil
        return nil
      end
      return T((kind == "mine") and "ui.defusing" or "ui.cutting", math.floor(work.t / W.time * 100))
    end
    work = nil
    local n = 0
    for _ in pairs(marks) do n += 1 end
    if key and kind == "wire" and n == 0 then return T("ui.wireNear") end
    if n > 0 then return T("ui.mineNear", n) end
    return T("ui.noMines")
  end
end

return Gunner
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="88">
          <Properties>
            <string name="Name">Hangar</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——挂载编辑器（部署界面飞机卡片上的「改挂载」）
--   全屏黑底，中间是 3D 的飞机（AirModels 拼的，放下起落架、打开弹舱，挂着现在选的弹；拖动转视角、滚轮缩放）；
--   每个挂点一个白色圆圈，点一下镜头拉近到那个挂点，左边列出这个挂点能挂的弹（名字、类别、导引方式），点哪个挂哪个（默认左右对称一起换），
--   选中的弹发白光；右下角是这枚弹的资料（类别、导引方式、射程、数量、锁定时间）；上面一排是预设方案；底部「返回」「保存」
--   G.openHangar(id, load, onSave)：load 是每个挂点的武器（同 AirDefs.presetLoad 的格式），保存时 onSave(新的 load)
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local Hangar = {}

function Hangar.init(G)
  local AD = require(RS:WaitForChild("AirDefs"))
  local AM = require(script.Parent:WaitForChild("AirModels"))
  local V = Vector3.new
  local CF = CFrame.new
  local RGB = Color3.fromRGB
  local rad = math.rad
  local me = Players.LocalPlayer
  local ui = G.ui
  local function T(k, ...) return G.T(k, ...) end
  local TEXT, MUTE = RGB(240, 242, 240), RGB(160, 166, 164)

  local gui = Instance.new("ScreenGui")
  gui.Name = "Hangar"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 20
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local bg = ui.frame(gui, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 0)
  bg.Active = true   -- 点在编辑器上不算点在游戏里
  -- 第一人称时 Roblox 的镜头每帧把鼠标锁在屏幕中间（用户：改导弹时准心锁在中间改不了）：
  -- 有一个看得见的 Modal 按钮，引擎就放开鼠标；编辑器开着它就在（跟着这个 ScreenGui 开关）
  local modal = Instance.new("TextButton")
  modal.Name = "FreeMouse"
  modal.Text = ""
  modal.Size = UDim2.fromOffset(1, 1)
  modal.BackgroundTransparency = 1
  modal.AutoButtonColor = false
  modal.Modal = true
  modal.Parent = gui
  local vp = Instance.new("ViewportFrame")
  vp.Size = UDim2.fromScale(1, 1)
  vp.BackgroundColor3 = RGB(0, 0, 0)
  vp.BackgroundTransparency = 1
  vp.Ambient = RGB(172, 175, 182)   -- 全景从下面看机腹：环境光亮一点，不然一片黑
  vp.LightColor = RGB(255, 252, 246)
  vp.LightDirection = V(-0.6, -1, -0.5)
  vp.Parent = bg
  local world = Instance.new("WorldModel")
  world.Parent = vp
  local vcam = Instance.new("Camera")
  vcam.FieldOfView = 40
  vcam.Parent = vp
  vp.CurrentCamera = vcam

  local spots = ui.frame(bg, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)
  local title = ui.label(bg, "", UDim2.fromOffset(520, 30), UDim2.new(0.5, 0, 0, 22), 24, TEXT, Enum.Font.GothamBlack, Vector2.new(0.5, 0))
  -- 直角（跟新界面一样：深色、直角、细线）：ui.button 自带的圆角去掉
  local function square(x) for _, c in ipairs(x:GetChildren()) do if c:IsA("UICorner") then c:Destroy() end end return x end
  local symBtn = square(ui.button(bg, "", UDim2.fromOffset(150, 34), UDim2.new(1, -24, 0, 80), RGB(30, 34, 38), Vector2.new(1, 0)))
  symBtn.TextSize = 14
  ui.stroke(symBtn, RGB(255, 255, 255), 1, 0.85)
  -- 左边：这个挂点能挂的弹
  local listBox = ui.frame(bg, UDim2.fromOffset(370, 420), UDim2.new(0, 40, 1, -96), RGB(0, 0, 0), 1, Vector2.new(0, 1))
  local listLayout = Instance.new("UIListLayout")
  listLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
  listLayout.Padding = UDim.new(0, 8)
  listLayout.SortOrder = Enum.SortOrder.LayoutOrder
  listLayout.Parent = listBox
  -- 右下：弹的资料
  local info = ui.frame(bg, UDim2.fromOffset(380, 196), UDim2.new(1, -40, 1, -96), RGB(10, 12, 14), 0.1, Vector2.new(1, 1))
  ui.stroke(info, RGB(255, 255, 255), 1, 0.85)
  local iName = ui.label(info, "", UDim2.new(1, -40, 0, 26), UDim2.fromOffset(20, 18), 19, TEXT, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  local iCat = ui.label(info, "", UDim2.new(1, -40, 0, 18), UDim2.fromOffset(20, 50), 13, MUTE, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local rows = {}
  for k = 1, 4 do
    local a = ui.label(info, "", UDim2.new(0.5, -20, 0, 20), UDim2.fromOffset(20, 76 + k * 24), 14, MUTE, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
    local b = ui.label(info, "", UDim2.new(0.5, -20, 0, 20), UDim2.new(0.5, 0, 0, 76 + k * 24), 14, TEXT, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Right)
    rows[k] = { a, b }
  end
  local summary = ui.label(bg, "", UDim2.new(0.5, 0, 0, 18), UDim2.new(0.5, 0, 1, -112), 13, MUTE, Enum.Font.GothamMedium, Vector2.new(0.5, 1))
  -- 左上：内油（用户：增加油量这个东西）——四档，少带油轻、加速快，多带飞得久；下面写巡航能飞多久（副油箱另算）、重量
  local fuelBox = ui.frame(bg, UDim2.fromOffset(300, 104), UDim2.fromOffset(40, 80), RGB(10, 12, 14), 0.1)
  fuelBox.Name = "Fuel"
  ui.stroke(fuelBox, RGB(255, 255, 255), 1, 0.85)
  local fTitle = ui.label(fuelBox, "", UDim2.new(1, -28, 0, 18), UDim2.fromOffset(14, 10), 13, MUTE, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  local fuelBtns = {}
  for k, f in ipairs(AD.FUEL_OPTS) do
    local b = square(ui.button(fuelBox, string.format("%d%%", math.floor(f * 100 + 0.5)), UDim2.new(0.25, -9, 0, 30), UDim2.new((k - 1) * 0.25, 14 - (k - 1) * 4, 0, 32), RGB(8, 10, 12)))
    b.Name = "Fuel" .. math.floor(f * 100 + 0.5)
    b.TextSize = 15
    b.Font = Enum.Font.GothamMedium
    ui.stroke(b, RGB(255, 255, 255), 1, 0.8)
    fuelBtns[k] = { b = b, f = f }
  end
  local fInfo = ui.label(fuelBox, "", UDim2.new(1, -28, 0, 30), UDim2.fromOffset(14, 68), 12, TEXT, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  fInfo.TextWrapped = true
  fInfo.TextYAlignment = Enum.TextYAlignment.Top
  local backBtn = square(ui.button(bg, "", UDim2.fromOffset(130, 52), UDim2.new(0.5, -8, 1, -28), RGB(0, 0, 0), Vector2.new(1, 1)))
  ui.stroke(backBtn, RGB(255, 255, 255), 1, 0.7)
  backBtn.TextSize = 20
  backBtn.Font = Enum.Font.Gotham
  local saveBtn = square(ui.button(bg, "", UDim2.fromOffset(170, 52), UDim2.new(0.5, 8, 1, -28), RGB(255, 255, 255), Vector2.new(0, 1)))
  saveBtn.TextColor3 = RGB(10, 10, 10)
  saveBtn.TextSize = 20
  saveBtn.Font = Enum.Font.Gotham

  ---------------------------------------------------------------- 状态

  local H = nil   -- { d, load, team, M, sel（选中的挂点）, sym, yaw, pitch, dist, focus, 目标值…, onSave }
  local spotBtns = {}

  local function weaponCat(w)
    if w.kind == "tank" then return "wcat.tank" end
    if w.arm then return "wcat.arm" end
    if w.kind == "bomb" then return w.guided and "wcat.gbomb" or "wcat.bomb" end
    return "wcat." .. w.kind
  end
  local function km(studs) return string.format("%.1f", (studs or 0) / AD.M / 1000) end

  -- 选中挂点上的弹发白光（ViewportFrame 里没有高亮：把零件换成白色霓虹）
  local function glow(i)
    if not H or not H.M then return end
    for si, list in pairs(H.M.stores) do
      for _, it in ipairs(list) do
        local p = it.p
        if not it.c0 then it.c0, it.m0 = p.Color, p.Material end
        if si == i then
          p.Color = it.c0:Lerp(Color3.new(1, 1, 1), 0.65)
          p.Material = Enum.Material.Neon
        else
          p.Color, p.Material = it.c0, it.m0
        end
      end
    end
  end

  local function rebuild()
    if H.M then H.M.model:Destroy() end
    local M = AM.build(H.d, H.team, H.load)
    M.model.Parent = world
    H.M = M
    local c = { gear = 1, bay = 1, bayS = 1, can = 0, fold = 0, thr = 0, rpm = 0, flap = 0 }
    AM.pose(M, CF(), c, 0, world)
    glow(H.sel)
  end

  local function mates(i)   -- 左右成对的挂点（同名）
    local out = { i }
    local s = H.d.st[i]
    if H.sym then
      for j, s2 in ipairs(H.d.st) do if j ~= i and s2.name == s.name then table.insert(out, j) end end
    end
    return out
  end

  local function showInfo(wid, n)
    local w = wid and AD.W[wid]
    if not w then
      iName.Text = T("hangar.empty")
      iCat.Text = ""
      for _, r in ipairs(rows) do r[1].Text, r[2].Text = "", "" end
      return
    end
    iName.Text = T("aw." .. wid)
    iCat.Text = string.upper(T(weaponCat(w)))
    if w.kind == "tank" then   -- 副油箱：加多少油（按内油的几成）、多多少阻力、多飞几分钟
      local data = { { T("hangar.tankFuel"), string.format("+%d%%", math.floor(w.fuel * (n or 1) * 100 + 0.5)) },
        { T("hangar.tankDrag"), string.format("−%d%%", math.floor(w.drag * (n or 1) * 100 + 0.5)) },
        { T("hangar.tankMin"), T("hangar.min", AD.fuelMin(H.d, w.fuel * (n or 1))) }, { T("hangar.count"), "×" .. tostring(n or 1) } }
      for k, r in ipairs(rows) do
        local e = data[k]
        r[1].Text, r[2].Text = e and e[1] or "", e and e[2] or ""
      end
      return
    end
    local data = { { T("hangar.guide"), T("guide." .. (w.guide or "none")) } }
    if w.range then table.insert(data, { T("hangar.range"), T("hangar.km", km(w.range)) }) end
    if w.kind == "rkt" then table.insert(data, { T("hangar.count"), tostring(w.tubes or 1) }) else table.insert(data, { T("hangar.count"), "×" .. tostring(n or 1) }) end
    if w.lockTime then table.insert(data, { T("hangar.lock"), T("hangar.sec", string.format("%.1f", w.lockTime)) }) end
    for k, r in ipairs(rows) do
      local e = data[k]
      r[1].Text, r[2].Text = e and e[1] or "", e and e[2] or ""
    end
  end

  local listRows = {}
  local function buildList()
    for _, b in ipairs(listRows) do b:Destroy() end
    listRows = {}
    info.Visible = H.sel ~= nil   -- 资料框只在选了挂点时出现（全景时空着一大块）
    if not H.sel then
      listBox.Visible = false
      return
    end
    listBox.Visible = true
    local s = H.d.st[H.sel]
    local opts = table.clone(s.opts)
    table.insert(opts, false)   -- 不挂
    for k, wid in ipairs(opts) do
      local on = (H.load[H.sel] or false) == wid
      local b = Instance.new("TextButton")
      b.Text = ""
      b.LayoutOrder = k
      b.Size = UDim2.new(1, 0, 0, 62)
      b.BackgroundColor3 = on and RGB(255, 255, 255) or RGB(8, 10, 12)
      b.BackgroundTransparency = on and 0 or 0.15
      b.AutoButtonColor = true
      b.Parent = listBox
      ui.stroke(b, RGB(255, 255, 255), 1, on and 0 or 0.82)
      local fg = on and RGB(16, 16, 16) or TEXT
      local w = wid and AD.W[wid]
      local n = wid and AD.count(s, wid) or 0
      local nm = wid and T("aw." .. wid) or T("hangar.empty")
      if wid and n > 1 and w.kind ~= "rkt" then nm = n .. " × " .. nm end
      local l1 = ui.label(b, nm, UDim2.new(1, -24, 0, 26), UDim2.fromOffset(16, 6), 19, fg, Enum.Font.Gotham, nil, Enum.TextXAlignment.Left)
      l1.TextTruncate = Enum.TextTruncate.AtEnd
      ui.label(b, w and T(weaponCat(w)) or "", UDim2.new(0.62, -16, 0, 18), UDim2.fromOffset(16, 36), 14, on and RGB(60, 60, 60) or MUTE, Enum.Font.Gotham, nil, Enum.TextXAlignment.Left)
      local right = w and ((w.kind == "tank") and T("hangar.tankAdd", math.floor(w.fuel * n * 100 + 0.5)) or T("guide." .. (w.guide or "none"))) or ""
      ui.label(b, right, UDim2.new(0.38, -16, 0, 18), UDim2.new(0.62, 0, 0, 36), 13, on and RGB(60, 60, 60) or MUTE, Enum.Font.Gotham, nil, Enum.TextXAlignment.Right)
      b.MouseEnter:Connect(function() if H then showInfo(wid, n) end end)
      b.Activated:Connect(function()
        if not H then return end
        for _, j in ipairs(mates(H.sel)) do
          local s2 = H.d.st[j]
          H.load[j] = (wid and table.find(s2.opts, wid)) and wid or false
        end
        H.presetKey = nil
        rebuild()
        buildList()
        showInfo(wid, n)
        G.refreshHangar()
      end)
      table.insert(listRows, b)
    end
  end

  local function selectStation(i)
    H.sel = i
    local s = H.d.st[i]
    -- 镜头拉近到这个挂点（从它那一侧、稍微前上方看）
    H.tFocus = s.pos + V(0, -0.8, 0)
    -- 拉近到看得见这一侧机翼和机身（照飞机大小；原来按弹的长短，拉得太近，整架飞机撑出屏幕）
    local L = (H.load[i] and AD.W[H.load[i]] and AD.W[H.load[i]].shape and AD.W[H.load[i]].shape.L) or 6
    H.tDist = math.max(math.max(H.d.L, H.d.W) * 0.85, L * 2.6 + 14)
    H.tYaw = (s.pos.X >= 0) and rad(55) or rad(-55)
    if s.bay then H.tPitch = rad(-22) else H.tPitch = rad(-12) end
    glow(i)
    buildList()
    local wid = H.load[i]
    showInfo(wid, wid and AD.count(s, wid) or 0)
    G.refreshHangar()
  end

  function G.refreshHangar()
    if not H then return end
    title.Text = T("veh." .. H.d.id)
    symBtn.Text = T(H.sym and "hangar.symOn" or "hangar.symOff")
    backBtn.Text = T("hangar.back")
    saveBtn.Text = T(H.confirm or "hangar.save")
    -- 总共挂了什么
    local count, order = {}, {}
    for i, s in ipairs(H.d.st or {}) do
      local wid = H.load[i]
      if wid then
        if not count[wid] then table.insert(order, wid) end
        count[wid] = (count[wid] or 0) + AD.count(s, wid)
      end
    end
    local parts = {}
    if H.d.gun then table.insert(parts, T("aw." .. H.d.gun)) end
    for _, wid in ipairs(order) do table.insert(parts, T("aw." .. wid) .. " ×" .. count[wid]) end
    summary.Text = table.concat(parts, "   ·   ")
    if not H.sel then showInfo(nil) iName.Text = T("hangar.pick") end
    -- 油量：选中的那档白底；巡航续航（内油 + 副油箱）、比一半内油重多少；选了挂点时让开（左边是弹的列表，矮屏幕上会叠在一起）
    fuelBox.Visible = H.sel == nil
    fTitle.Text = T("hangar.fuel")
    for _, x in ipairs(fuelBtns) do
      local on = math.abs(x.f - H.fuel) < 0.01
      x.b.BackgroundColor3 = on and RGB(255, 255, 255) or RGB(8, 10, 12)
      x.b.TextColor3 = on and RGB(16, 16, 16) or TEXT
    end
    local tf = AD.tankFuel(H.d, H.load)
    local heavy = AD.heavy(H.d, H.fuel, tf)
    local txt = T("hangar.endur", AD.fuelMin(H.d, H.fuel + tf))
    if tf > 0 then txt = txt .. "  " .. T("hangar.endurTank", AD.fuelMin(H.d, tf)) end
    fInfo.Text = txt .. "\n" .. T("hangar.weight", string.format("%+d%%", math.floor((heavy - 1) * 100 + 0.5)))
  end
  for _, x in ipairs(fuelBtns) do
    x.b.Activated:Connect(function()
      if not H then return end
      H.fuel = x.f
      G.refreshHangar()
    end)
  end

  local function close()
    if H and H.M then H.M.model:Destroy() end
    H = nil
    for _, b in ipairs(spotBtns) do b:Destroy() end
    spotBtns = {}
    gui.Enabled = false
  end

  -- opts.confirm：右下按钮的文字键（生成点打开时是「生成」）；opts.fuel：上次选的内油（几成）；保存时 onSave(挂载, 预设键, 内油)
  function G.openHangar(id, load, onSave, presetKey, opts)
    local d = AD.get(id)
    if not d then return end
    if H then close() end
    local size = math.max(d.L, d.W)
    H = { d = d, load = table.clone(load or AD.presetLoad(d)), team = me:GetAttribute("Side") or "atk", onSave = onSave, sym = true, presetKey = presetKey,
      confirm = opts and opts.confirm, fuel = AD.cleanFuel(opts and opts.fuel or 1),
      yaw = rad(-150), pitch = rad(8), dist = size * 1.5, focus = V(0, -1, 0), shift = 0 }   -- 全景从左前稍下方看：挂点都在机腹、翼下，从上面看会挤成一团
    H.tYaw, H.tPitch, H.tDist, H.tFocus = H.yaw, H.pitch, H.dist, H.focus
    H.home = { yaw = H.yaw, pitch = H.pitch, dist = H.dist, focus = H.focus }
    for i = 1, #(d.st or {}) do if H.load[i] == nil then H.load[i] = false end end
    gui.Enabled = true
    rebuild()
    -- 挂点的白圈（空心圈 + 中间一个点，不把弹盖住；选中的变黄、变大）
    for i, s in ipairs(d.st or {}) do
      local b = Instance.new("TextButton")
      b.Text = ""
      b.Size = UDim2.fromOffset(26, 26)
      b.AnchorPoint = Vector2.new(0.5, 0.5)
      b.BackgroundColor3 = RGB(255, 255, 255)
      b.BackgroundTransparency = 0.85
      b.AutoButtonColor = false
      b.ZIndex = 3
      b.Parent = spots
      local c = Instance.new("UICorner")
      c.CornerRadius = UDim.new(0.5, 0)
      c.Parent = b
      local dot = ui.frame(b, UDim2.fromOffset(6, 6), UDim2.fromScale(0.5, 0.5), RGB(255, 255, 255), 0, Vector2.new(0.5, 0.5))
      dot.Name = "Dot"
      dot.ZIndex = 4
      ui.round(dot, 3)
      local st = ui.stroke(b, RGB(255, 255, 255), 2, 0.05)
      b.Activated:Connect(function() if H then selectStation(i) end end)
      spotBtns[i] = b
      b:SetAttribute("Station", i)
      b.Name = "Spot" .. i
      st.Name = "Ring"
    end
    H.sel = nil
    buildList()
    G.refreshHangar()
  end

  symBtn.Activated:Connect(function()
    if not H then return end
    H.sym = not H.sym
    G.refreshHangar()
  end)
  backBtn.Activated:Connect(function()
    if not H then return end
    if H.sel then   -- 先退回全景，再按一次关掉
      H.sel = nil
      H.tYaw, H.tPitch, H.tDist, H.tFocus = H.home.yaw, H.home.pitch, H.home.dist, H.home.focus
      glow(nil)
      buildList()
      G.refreshHangar()
      return
    end
    close()
  end)
  saveBtn.Activated:Connect(function()
    if not H then return end
    local f, load, key, fuel = H.onSave, table.clone(H.load), H.presetKey, H.fuel
    close()
    if f then f(load, key, fuel) end
  end)

  ---------------------------------------------------------------- 拖动转视角、滚轮缩放

  local dragging, last = false, nil
  vp.InputBegan:Connect(function(io)
    if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then
      dragging, last = true, io.Position
    end
  end)
  UIS.InputEnded:Connect(function(io)
    if io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch then dragging = false end
  end)
  UIS.InputChanged:Connect(function(io)
    if not H or not gui.Enabled then return end
    if dragging and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then
      local p = io.Position
      local dx, dy = p.X - (last and last.X or p.X), p.Y - (last and last.Y or p.Y)
      last = p
      H.tYaw -= dx * 0.008
      H.tPitch = math.clamp(H.tPitch - dy * 0.006, rad(-75), rad(40))
    elseif io.UserInputType == Enum.UserInputType.MouseWheel then
      H.tDist = math.clamp(H.tDist * ((io.Position.Z > 0) and 0.88 or 1.14), 10, math.max(H.d.L, H.d.W) * 3.5)
    end
  end)

  ---------------------------------------------------------------- 每帧：镜头、白圈的位置

  local function project(p, camCF)
    local lp = camCF:PointToObjectSpace(p)
    if lp.Z > -0.5 then return nil end
    local vs = workspace.CurrentCamera.ViewportSize   -- 编辑器铺满整屏、不让顶栏（IgnoreGuiInset），框的大小就是屏幕大小
    local tanY = math.tan(rad(vcam.FieldOfView) / 2)
    local nx = lp.X / (-lp.Z * tanY * (vs.X / vs.Y))
    local ny = lp.Y / (-lp.Z * tanY)
    return UDim2.fromOffset((nx + 1) / 2 * vs.X, (1 - ny) / 2 * vs.Y)
  end
  local function step(dt)
    if not H or not gui.Enabled then return end
    local k = math.min(1, dt * 6)
    H.yaw += (H.tYaw - H.yaw) * k
    H.pitch += (H.tPitch - H.pitch) * k
    H.dist += (H.tDist - H.dist) * k
    H.focus = H.focus:Lerp(H.tFocus, k)
    if not H.sel and not dragging then H.tYaw += dt * 0.12 end   -- 全景时慢慢转
    -- 选了挂点：镜头往左挪一点，挂点落在屏幕偏右（左边是弹的列表）
    H.shift += ((H.sel and -H.dist * 0.12 or 0) - H.shift) * k
    local camCF = CF(H.focus) * CFrame.Angles(0, H.yaw, 0) * CFrame.Angles(H.pitch, 0, 0) * CF(H.shift, 0, H.dist)
    vcam.CFrame = camCF
    for i, b in pairs(spotBtns) do
      local s = H.d.st[i]
      local pos = project(s.pos + V(0, -0.6, 0), camCF)
      -- 左右对称时一对挂点只画离镜头近的那个圈（点哪个都是一对一起换），不然机腹弹舱那几个圈挤成一团
      if pos and H.sym and H.sel ~= i then
        for j, s2 in ipairs(H.d.st) do
          if j ~= i and s2.name == s.name and (H.sel == j or (H.sel ~= i and (s2.pos - camCF.Position).Magnitude < (s.pos - camCF.Position).Magnitude - 0.01)) then
            pos = nil
            break
          end
        end
      end
      b.Visible = pos ~= nil
      if pos then b.Position = pos end
      local on = H.sel == i
      b.Size = on and UDim2.fromOffset(36, 36) or UDim2.fromOffset(26, 26)
      local ring = b:FindFirstChild("Ring")
      if ring then
        ring.Color = on and RGB(255, 210, 60) or RGB(255, 255, 255)
        ring.Thickness = on and 3 or 2
        ring.Transparency = (on or not H.sel) and 0.05 or 0.55   -- 选了一个挂点时别的圈淡一点
      end
      b.BackgroundTransparency = on and 0.6 or 0.85
    end
  end
  RunService.RenderStepped:Connect(function(dt)
    local ok, err = pcall(step, dt)
    if not ok and G.showError then G.showError("local hangar: " .. tostring(err)) end
  end)
  G.hangarOpen = function() return H ~= nil end
  G.hangarState = function() return H end
end

return Hangar
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="89">
          <Properties>
            <string name="Name">Hud</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——战斗中的界面，照用户给的截图做，要比截图更精致、更简洁（用户：现在这个太卡通）：
--   顶部：四角括号框住比分——两头小字队名、队色大数字（手里的据点数）、细线，中间时间、下面小字模式；再下面 A～E 小菱形
--     （自己队的描边、对面的实心、正在被占的下面一道细进度线、争夺中描边闪）。部署界面也显示
--   世界里的据点：字母 + 距离（米），隔着东西也看得见
--   左下：方形小地图（跟着人走、北朝上），右上角镜头朝向读数；小地图右边是小队（同队真人按 UserId 每 5 人一队：阿尔法 / 布拉沃…；名字 + 细血条）
--   右下：武器名 + 射击方式，弹药「028/900」（前面补的 0 暗一点）
--   第一次出生：屏幕上方一块「目标与据点」说明（4 页，回车下一页、退格关掉）
--   UI.lua 原来的顶栏、血条、兵种字，Play.lua 原来的弹药字交给这里：挪进一个关着的 ScreenGui（照样刷新，只是不画）；小地图框挪到左下
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Hud = {}

function Hud.init(G)
  local Config, Map = G.Config, G.Map
  local ui, P = G.ui, G.hudParts
  if not (ui and P) then return end
  local me = Players.LocalPlayer
  local RGB = Color3.fromRGB
  local V2 = Vector2.new
  local W = Config.Weapons
  local WHITE = Color3.new(1, 1, 1)
  local TEXT, MUTE, FAINT = RGB(232, 236, 238), RGB(160, 166, 170), RGB(110, 116, 120)
  local NUM = Enum.Font.Jura   -- 细的数字（弹药、距离、朝向）
  local M_PER = 2.8            -- 1 米多少格（同 AirDefs.M）
  local function T(k, ...) return G.T(k, ...) end
  local function teamColor(t) return Config.Teams[t or "atk"].color end
  local function other(t) return (t == "atk") and "def" or "atk" end
  local function hex(c) return string.format("rgb(%d,%d,%d)", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
  local function txt(parent, s, size, pos, ts, color, font, anchor, align, stroke)
    local l = ui.label(parent, s, size, pos, ts, color, font, anchor, align)
    l.TextWrapped = false
    l.TextStrokeTransparency = stroke or 0.75
    l.TextStrokeColor3 = Color3.new(0, 0, 0)
    return l
  end
  local function line(parent, size, pos, color, alpha, anchor) return ui.frame(parent, size, pos, color or WHITE, alpha or 0, anchor) end
  local mobile = G.mobile == true
  local reducedMotion = false
  pcall(function()
    local function syncMotion() reducedMotion = GuiService.ReducedMotionEnabled end
    syncMotion()
    GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(syncMotion)
  end)

  -- 旧的顶栏、血条、兵种字、弹药字：收进一个关着的 ScreenGui
  local stash = Instance.new("ScreenGui")
  stash.Name = "HudStash"
  stash.Enabled = false
  stash.ResetOnSpawn = false
  stash.Parent = me:WaitForChild("PlayerGui")
  for _, k in ipairs({ "topBar", "counts", "hpBg", "roleText" }) do
    if P[k] then P[k].Parent = stash end
  end
  if G.ammoLabel then G.ammoLabel.Parent = stash end

  ---------------------------------------------------------------- 顶部比分

  local BW, BH = mobile and 470 or 600, mobile and 62 or 72
  local top = ui.frame(G.gui, UDim2.fromOffset(BW, BH), UDim2.new(0.5, 0, 0, mobile and 4 or 10), RGB(8, 17, 24), 0.3, V2(0.5, 0))
  top.Name = "ScoreBar"
  top.ZIndex = 12
  for _, a in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do   -- 四角括号
    line(top, UDim2.fromOffset(14, 1), UDim2.fromScale(a[1], a[2]), WHITE, 0.25, V2(a[1], a[2]))
    line(top, UDim2.fromOffset(1, 14), UDim2.fromScale(a[1], a[2]), WHITE, 0.25, V2(a[1], a[2]))
  end
  local sides = {}
  for _, sx in ipairs({ -1, 1 }) do
    local left = sx < 0
    local s = {}
    s.name = txt(top, "", UDim2.fromOffset(70, 14), UDim2.new(0.5, sx * (BW / 2 - 18), 0, 17), 10, MUTE, Enum.Font.GothamMedium, V2(left and 0 or 1, 0.5),
      left and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right)
    s.name.TextTruncate = Enum.TextTruncate.AtEnd
    s.score = txt(top, "", UDim2.fromOffset(44, 26), UDim2.new(0.5, sx * (BW / 2 - (mobile and 84 or 96)), 0, 17), mobile and 20 or 24, WHITE, Enum.Font.GothamBold, V2(0.5, 0.5))
    local lw = mobile and 70 or 120
    s.barBg = line(top, UDim2.fromOffset(lw, 1), UDim2.new(0.5, sx * (46 + lw / 2), 0, 17), WHITE, 0.82, V2(0.5, 0.5))
    s.bar = line(s.barBg, UDim2.new(0, 0, 0, 2), UDim2.fromScale(left and 1 or 0, 0.5), WHITE, 0, V2(left and 1 or 0, 0.5))   -- 从时间那头往外长
    sides[sx] = s
  end
  local timer = txt(top, "", UDim2.fromOffset(84, 24), UDim2.new(0.5, 0, 0, 16), mobile and 17 or 20, WHITE, Enum.Font.GothamBold, V2(0.5, 0.5))
  local mode = txt(top, "", UDim2.fromOffset(170, 12), UDim2.new(0.5, 0, 0, 31), 9, MUTE, Enum.Font.GothamMedium, V2(0.5, 0.5))
  mode.TextTruncate = Enum.TextTruncate.AtEnd
  -- 比分条下面一行：现在该干什么（进攻 / 防守哪个据点，用户：玩法不够清晰）
  local goal = txt(top, "", UDim2.fromOffset(BW, 18), UDim2.new(0.5, 0, 1, mobile and 4 or 8), mobile and 12 or 14, TEXT, Enum.Font.GothamBold, V2(0.5, 0), nil, 0.5)
  goal.RichText = true
  goal.Size = UDim2.new(1, -8, 0, 18)
  goal.TextTruncate = Enum.TextTruncate.AtEnd
  -- A～E 小菱形
  local diamonds = {}
  for i, p in ipairs(Map.POINTS) do
    local cx = (i - (#Map.POINTS + 1) / 2) * (mobile and 30 or 34)
    local d = ui.frame(top, UDim2.fromOffset(13, 13), UDim2.new(0.5, cx, 0, BH - 20), WHITE, 1, V2(0.5, 0.5))
    d.Rotation = 45
    local st = ui.stroke(d, WHITE, 1, 0.15)
    local l = txt(top, p.id, UDim2.fromOffset(14, 14), UDim2.new(0.5, cx, 0, BH - 20), 8, WHITE, Enum.Font.GothamBold, V2(0.5, 0.5), nil, 1)
    local pb = line(top, UDim2.fromOffset(18, 1), UDim2.new(0.5, cx, 0, BH - 8), WHITE, 0.82, V2(0.5, 0))
    local pf = line(pb, UDim2.fromScale(0, 1), nil, WHITE, 0)
    diamonds[p.id] = { d = d, st = st, l = l, pb = pb, pf = pf }
  end

  ---------------------------------------------------------------- 世界里的据点：字母 + 距离

  local pg = me:WaitForChild("PlayerGui")
  local marks = {}
  for _, p in ipairs(Map.POINTS) do
    local a = Instance.new("Part")
    a.Name = "Obj_" .. p.id
    a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch, a.CastShadow = true, false, false, false, false
    a.Transparency = 1
    a.Size = Vector3.new(1, 1, 1)
    a.CFrame = CFrame.new(p.x, (p.y or 40) + 30, p.z)
    a.Parent = workspace.CurrentCamera   -- 只在自己这儿
    local bb = Instance.new("BillboardGui")
    bb.Name = "ObjMark_" .. p.id
    bb.Adornee = a
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Size = UDim2.fromOffset(80, 56)
    bb.ResetOnSpawn = false
    bb.Parent = pg
    local verb = txt(bb, "", UDim2.fromOffset(80, 13), UDim2.fromScale(0.5, 0), 10, TEXT, Enum.Font.GothamBold, V2(0.5, 0), nil, 0.5)   -- 进攻 / 防守
    local l = txt(bb, p.id, UDim2.fromOffset(40, 24), UDim2.new(0.5, 0, 0, 13), 20, WHITE, Enum.Font.GothamBold, V2(0.5, 0), nil, 0.55)
    local dist = txt(bb, "", UDim2.fromOffset(60, 14), UDim2.new(0.5, 0, 0, 37), 11, TEXT, NUM, V2(0.5, 0), nil, 0.55)
    marks[p.id] = { part = a, bb = bb, l = l, dist = dist, verb = verb, ok = p.y ~= nil, tries = 0, x = p.x, z = p.z }
  end
  -- 据点高度：Map 里没写的照地面找（地形生成好以前找不到，过一会儿再试）
  local rp = RaycastParams.new()
  rp.FilterType = Enum.RaycastFilterType.Include
  local function ground(m)
    rp.FilterDescendantsInstances = { workspace.Terrain }
    local hit = workspace:Raycast(Vector3.new(m.x, 2000, m.z), Vector3.new(0, -4000, 0), rp)
    if hit then
      m.part.CFrame = CFrame.new(m.x, math.max(hit.Position.Y, 0) + 30, m.z)
      m.ok = true
    end
  end

  ---------------------------------------------------------------- 右上方形小地图（用户：右上角加个正方形小地图，不要那根绕圈转的扫描线；11-19：不要黑绿，改成正常的）
  --   方框（UI.lua 建的 CanvasGroup 裁边）里是正常颜色的地图（北朝上、跟着人走）：有 EditableImage 时是 MapPaint 画的卫星图
  --   （暗淡、拟真：水深、沙滩、草地、土路、岩石、山体阴影，身边每像素 6.25 格），没有就是 MapUI 的「mini」色块，
  --   淡淡的白网格、四角的取景框、白边；亮点：友军蓝、敌军红；步兵圆点、车和船方块、飞机菱形；敌人开枪的地方闪一个红圈
  --   哪些敌人上雷达见 Config.Radar（车船飞机在范围内就有；步兵要在视线里、开了枪或者被标记）
  --   手机：右边一列是开火、换枪、夜视、战术平板的按钮，小地图还放左上

  local RC = Config.Radar or { range = 520, ping = 3 }
  local LINE, LINE_DIM = RGB(244, 246, 248), RGB(214, 220, 226)   -- 框、网格、字：白（原来是雷达绿）
  local FRIEND, FOE = RGB(72, 168, 255), RGB(255, 64, 52)
  local MS = mobile and 122 or 216   -- 手机：左上，往下是开车的方向键，小一点免得压着
  local box = P.miniBox
  box.AnchorPoint = mobile and V2(0, 0) or V2(1, 0)
  box.Position = mobile and UDim2.new(0, 16, 0, 118) or UDim2.new(1, -18, 0, 18)
  box.Size = UDim2.fromOffset(MS, MS)
  box.BackgroundColor3 = RGB(22, 36, 50)   -- 地图外面也是深海的蓝
  box.BackgroundTransparency = 0.12
  do
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 3)
    c.Parent = box
  end
  ui.stroke(box, LINE, 1.5, 0.35)
  local hudLayout = { radarRight = not mobile, radarX = mobile and 16 or 18, radarY = mobile and 118 or 18, radarSize = MS }
  G.hudLayout = hudLayout
  local scoreViewport, scoreRight, compactScore
  local function layoutScore(viewport)
    local edge = 12
    local right = hudLayout.radarRight and (hudLayout.radarX + hudLayout.radarSize + edge) or edge
    if mobile and viewport.Y < 360 and viewport.X > viewport.Y then right = G.infantryTouchWidth or 164 end
    if (scoreViewport == viewport.X and scoreRight == right) or viewport.X < 1 then return end
    scoreViewport, scoreRight = viewport.X, right
    local width = math.max(1, math.min(BW, viewport.X - edge - right))
    local center = math.max(edge + width / 2, math.min(viewport.X / 2, viewport.X - right - width / 2))
    compactScore = width < 440
    top.Size = UDim2.fromOffset(width, BH)
    top.Position = UDim2.fromOffset(center, mobile and 4 or 10)
    for _, sx in ipairs({ -1, 1 }) do
      local s = sides[sx]
      local scale = sx < 0 and 0 or 1
      if compactScore then
        s.name.Size = UDim2.fromOffset(math.clamp((width - 100) / 2 - 10, 0, 70), 14)
        s.name.Position = UDim2.new(scale, -sx * 10, 0, 11)
        s.score.Position = UDim2.new(scale, -sx * 32, 0, 31)
        s.barBg.Visible = false
      else
        s.name.Size = UDim2.fromOffset(70, 14)
        s.name.Position = UDim2.new(scale, -sx * 14, 0, 17)
        s.score.Position = UDim2.new(scale, -sx * 110, 0, 17)
        local railWidth = math.min(mobile and 70 or 120, width / 2 - 188)
        s.barBg.Size = UDim2.fromOffset(railWidth, 1)
        s.barBg.Position = UDim2.new(0.5, sx * (46 + railWidth / 2), 0, 17)
        s.barBg.Visible = true
      end
    end
    mode.Size = UDim2.fromOffset(math.max(1, math.min(170, width - 142)), 12)
    hudLayout.scoreBottom = top.Position.Y.Offset + BH + goal.Position.Y.Offset + goal.Size.Y.Offset
  end
  -- 坦克瞄准镜的目镜黑框（Drive，DisplayOrder 5）会盖住半个小地图：开镜时小地图挪到上面一层（像战雷，瞄准镜里也看得到小地图）
  local radarTop = Instance.new("ScreenGui")
  radarTop.Name = "RadarTop"
  radarTop.ResetOnSpawn = false
  radarTop.IgnoreGuiInset = true
  radarTop.DisplayOrder = 7
  radarTop.Parent = me:WaitForChild("PlayerGui")
  if P.feed and not mobile then P.feed.Position = UDim2.new(1, -16, 0, 18 + MS + 14) end
  -- 雷达范围跟着坐的东西变（用户：飞机的雷达有点近）：步兵 RC.range，地面载具 RC.veh，直升机 RC.heli，固定翼 RC.jet；换的时候慢慢缩放
  local curR = RC.range
  local function wantRange()
    local f = G.fly
    if f and f.d then return (f.d.kind == "jet") and (RC.jet or 9000) or (RC.heli or 4000) end
    if G.drive then return RC.veh or 900 end
    return RC.range
  end
  local MAPW = 6100 * ((G.Map and G.Map.K) or 1)   -- 整张地图（6100 × K 格见方，MapUI；地图放大了 K 倍）：画多大让半边正好是雷达范围
  -- 网格：横竖各三道淡线（四等分），中间两道稍亮；四个角上一对短线的取景框
  for i = 1, 3 do
    local k = i / 4
    local a = (i == 2) and 0.82 or 0.9
    local lv = line(box, UDim2.new(0, 1, 1, 0), UDim2.fromScale(k, 0.5), LINE, a, V2(0.5, 0.5))
    lv.ZIndex = 18
    local lh = line(box, UDim2.new(1, 0, 0, 1), UDim2.fromScale(0.5, k), LINE, a, V2(0.5, 0.5))
    lh.ZIndex = 18
    lv.Name, lh.Name = "RadarDeco", "RadarDeco"   -- 开坦克时小地图变圆（TankHud）：方框式的网格、取景框、读数收起
  end
  for _, c in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
    local ax = V2(c[1], c[2])
    local h = line(box, UDim2.fromOffset(12, 2), UDim2.new(c[1], c[1] == 0 and 4 or -4, c[2], c[2] == 0 and 4 or -4), LINE, 0.25, ax)
    local v = line(box, UDim2.fromOffset(2, 12), UDim2.new(c[1], c[1] == 0 and 4 or -4, c[2], c[2] == 0 and 4 or -4), LINE, 0.25, ax)
    h.ZIndex, v.ZIndex = 22, 22
    h.Name, v.Name = "RadarDeco", "RadarDeco"
  end
  local blipLayer = ui.frame(box, UDim2.fromScale(1, 1), nil, WHITE, 1)
  blipLayer.ZIndex = 20
  local arrow = txt(box, "▲", UDim2.fromOffset(14, 14), UDim2.fromScale(0.5, 0.5), 11, WHITE, Enum.Font.GothamBold, V2(0.5, 0.5), nil, 0.3)
  arrow.ZIndex = 22
  local north = txt(box, "N", UDim2.fromOffset(14, 14), UDim2.new(0.5, 0, 0, 4), 10, LINE, Enum.Font.GothamBold, V2(0.5, 0), nil, 0.5)
  north.ZIndex = 22
  local heading = txt(box, "", UDim2.fromOffset(44, 14), UDim2.new(0.5, 0, 1, -4), 11, LINE, NUM, V2(0.5, 1), nil, 0.4)
  heading.ZIndex = 22
  local rangeL = txt(box, math.floor(RC.range / M_PER + 0.5) .. "m", UDim2.fromOffset(52, 12), UDim2.new(1, -8, 1, -6), 9, LINE_DIM, NUM, V2(1, 1), Enum.TextXAlignment.Right, 0.6)
  rangeL.ZIndex = 22
  north.Name, heading.Name, rangeL.Name = "RadarDeco", "RadarDeco", "RadarDeco"

  -- 亮点（对象池）：kind inf 圆点 / veh 方块 / air 菱形 / ping 红圈
  local pool, used = {}, 0
  local function blip()
    used += 1
    local b = pool[used]
    if not b then
      local f = Instance.new("Frame")
      f.AnchorPoint = V2(0.5, 0.5)
      f.BorderSizePixel = 0
      f.ZIndex = 21
      f.Parent = blipLayer
      local c = Instance.new("UICorner")
      c.Parent = f
      local st = Instance.new("UIStroke")
      st.Thickness = 1
      st.Parent = f
      b = { f = f, c = c, st = st }
      pool[used] = b
    end
    b.f.Visible = true
    return b
  end
  local function shape(b, kind, col, alpha)
    local f = b.f
    if kind == "ping" then
      f.Size = UDim2.fromOffset(12, 12)
      f.Rotation = 0
      b.c.CornerRadius = UDim.new(0.5, 0)
      f.BackgroundTransparency = 1
      b.st.Color, b.st.Transparency, b.st.Thickness = col, alpha, 1.5
      return
    end
    local sz = (kind == "inf") and 5 or 7
    f.Size = UDim2.fromOffset(sz, sz)
    f.Rotation = (kind == "air") and 45 or 0
    b.c.CornerRadius = (kind == "inf") and UDim.new(0.5, 0) or UDim.new(0, 1)
    f.BackgroundColor3, f.BackgroundTransparency = col, alpha
    b.st.Color, b.st.Transparency, b.st.Thickness = Color3.new(0, 0, 0), 0.4 + alpha * 0.6, 1
  end

  -- 雷达里的东西：真人（角色带 Team）、实体（workspace.Ents：机器人、车、飞机、船；工事、地雷不上雷达）
  local CAT = { inf = "inf", light = "veh", armor = "veh", ship = "veh", air = "air" }
  local contacts = {}      -- { pos, team, kind, model }
  local seenT = {}         -- 敌人 → 最近一次看见（视线里）的时刻
  local losT = {}          -- 敌人 → 下次查视线的时刻
  local pings = {}         -- 敌人开枪的地方：{ pos, t }
  local rayP = RaycastParams.new()
  rayP.FilterType = Enum.RaycastFilterType.Exclude
  local scanT, purgeT = 0, 5
  local function myEnt(m)
    local d = G.drive
    if d and d.em == m then return true end
    local uid = me.UserId
    return m:GetAttribute("Driver") == uid or m:GetAttribute("Pilot") == uid or m:GetAttribute("Gunner") == uid
  end
  local function scan(center, mine)
    table.clear(contacts)
    local R = curR * 1.04   -- 方框：横竖各在半边宽以内（角上比边上远）
    local function add(pos, team, kind, model)
      local dx, dz = pos.X - center.X, pos.Z - center.Z
      if math.abs(dx) <= R and math.abs(dz) <= R then table.insert(contacts, { pos = pos, team = team, kind = kind, model = model }) end
    end
    for _, pl in ipairs(Players:GetPlayers()) do
      local ch = pl.Character
      local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
      local hum = ch and ch:FindFirstChildOfClass("Humanoid")
      if pl ~= me and hrp and hum and hum.Health > 0 then
        add(hrp.CFrame.Position, ch:GetAttribute("Team") or pl:GetAttribute("Side"), "inf", ch)
      end
    end
    local ents = workspace:FindFirstChild("Ents")
    for _, m in ipairs(ents and ents:GetChildren() or {}) do
      local kind = CAT[m:GetAttribute("Cat") or ""]
      local root = m.PrimaryPart or m:FindFirstChild("Root")
      if kind and root and not m:GetAttribute("Wreck") and (m:GetAttribute("Hp") or 1) > 0 and not myEnt(m) then
        add(root.CFrame.Position, m:GetAttribute("Team"), kind, m)
      end
    end
  end
  -- 敌人看不看得见：从镜头往它身上打一条线，先打到它自己（或者比它远的东西）就算看见
  local function visible(c, from)
    local to = c.pos + Vector3.new(0, 1.5, 0)
    local d = to - from
    local ex = { me.Character }
    if G.drive and G.drive.em then table.insert(ex, G.drive.em) end
    rayP.FilterDescendantsInstances = ex
    local hit = workspace:Raycast(from, d, rayP)
    return (not hit) or (c.model and hit.Instance:IsDescendantOf(c.model)) or (hit.Position - from).Magnitude > d.Magnitude - 3
  end
  -- 服务器发的开枪特效（Fx.lua）：敌人没消音的枪 → 雷达上开枪的地方闪一个红圈
  function G.radarShot(pos, team, quiet)
    if quiet or not pos or not team or team == me:GetAttribute("Side") then return end
    table.insert(pings, { pos = pos, t = os.clock() })
    if #pings > 40 then table.remove(pings, 1) end
  end
  G.radarContacts = function() return contacts end   -- 测试用
  G.radarShown = {}                                   -- 测试用：这一帧画出来的 { team, kind, enemy }

  ---------------------------------------------------------------- 小队（小地图右边）

  local squad = ui.frame(P.hud, UDim2.fromOffset(250, 150), UDim2.new(0, 22, 1, -18), RGB(0, 0, 0), 1, V2(0, 1))   -- 左下角（小地图搬到右上了）
  squad.Name = "Squad"
  squad.Visible = not mobile
  local sqHead = txt(squad, "", UDim2.new(1, 0, 0, 16), UDim2.fromOffset(0, 0), 13, WHITE, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left, 0.6)
  local rows = {}
  for i = 1, 5 do
    local y = 24 + (i - 1) * 25
    local mark = ui.frame(squad, UDim2.fromOffset(6, 6), UDim2.fromOffset(4, y + 7), teamColor("atk"), 0, V2(0.5, 0.5))
    mark.Rotation = 45
    local nm = txt(squad, "", UDim2.fromOffset(200, 16), UDim2.fromOffset(16, y), 13, TEXT, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left, 0.7)
    nm.TextTruncate = Enum.TextTruncate.AtEnd
    local hb = line(squad, UDim2.fromOffset(170, 1), UDim2.fromOffset(16, y + 18), WHITE, 0.82)
    local hf = line(hb, UDim2.new(1, 0, 0, 2), UDim2.fromScale(0, 0.5), WHITE, 0, V2(0, 0.5))
    local dead = txt(squad, "", UDim2.fromOffset(60, 16), UDim2.fromOffset(196, y), 11, RGB(230, 96, 84), Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left, 0.7)
    rows[i] = { mark = mark, nm = nm, hb = hb, hf = hf, dead = dead }
  end

  ---------------------------------------------------------------- 右下武器、弹药

  local wp = ui.frame(P.hud, UDim2.fromOffset(280, 64), mobile and UDim2.new(1, -260, 1, -62) or UDim2.new(1, -28, 1, -16), RGB(0, 0, 0), 1, V2(1, 1))   -- 手机：让开右下的开火按钮、下面的武器栏
  wp.Name = "Weapon"
  local wName = txt(wp, "", UDim2.new(1, 0, 0, 18), nil, 15, TEXT, NUM, nil, Enum.TextXAlignment.Right, 0.7)
  local wAmmo = txt(wp, "", UDim2.new(1, 0, 0, 40), UDim2.new(0, 0, 1, 0), 36, WHITE, NUM, V2(0, 1), Enum.TextXAlignment.Right, 0.6)
  wAmmo.RichText = true

  ---------------------------------------------------------------- 目标说明（第一次出生时）

  local tipW = mobile and 330 or 500
  local tip = ui.frame(P.hud, UDim2.fromOffset(tipW, 168), UDim2.new(mobile and 0.42 or 0.5, 0, 0, BH + (mobile and 10 or 24)), RGB(8, 10, 12), 0.12, V2(0.5, 0))   -- 手机：让开右边的按钮
  tip.Name = "Tips"
  tip.Visible = false
  local tipTitle = txt(tip, "", UDim2.new(1, -120, 0, 20), UDim2.fromOffset(20, 16), 16, WHITE, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left, 1)
  local tipPage = txt(tip, "", UDim2.fromOffset(80, 16), UDim2.new(1, -20, 0, 18), 11, MUTE, Enum.Font.GothamMedium, V2(1, 0), Enum.TextXAlignment.Right, 1)
  local NT = 4
  local segs = {}
  for k = 1, NT do
    segs[k] = line(tip, UDim2.new(1 / NT, -3, 0, 2), UDim2.new((k - 1) / NT, 0, 0, 48), WHITE, 0.8)
  end
  local tipBody = ui.label(tip, "", UDim2.new(1, -40, 0, 54), UDim2.fromOffset(20, 60), 13, TEXT, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  tipBody.TextYAlignment = Enum.TextYAlignment.Top
  line(tip, UDim2.new(1, -40, 0, 1), UDim2.new(0, 20, 1, -46), WHITE, 0.88)
  local function keyChip(parent, x, anchorX)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(120, 26)
    b.Position = UDim2.new(anchorX, x, 1, -14)
    b.AnchorPoint = V2(anchorX, 1)
    b.BackgroundTransparency = 1
    b.Text = ""
    b.Parent = parent
    local k = ui.frame(b, UDim2.fromOffset(46, 20), UDim2.new(anchorX, 0, 0.5, 0), RGB(40, 44, 48), 0.2, V2(anchorX, 0.5))
    local kl = txt(k, "", UDim2.fromScale(1, 1), nil, 9, TEXT, Enum.Font.GothamBold, nil, nil, 1)
    local wl = txt(b, "", UDim2.fromOffset(66, 20), UDim2.new(anchorX, (anchorX == 0) and 54 or -54, 0.5, 0), 12, TEXT, Enum.Font.GothamMedium, V2(anchorX, 0.5),
      (anchorX == 0) and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right, 1)
    return b, kl, wl
  end
  local closeB, closeK, closeW = keyChip(tip, 20, 0)
  local nextB, nextK, nextW = keyChip(tip, -20, 1)
  local tipI, tipDone = 1, false
  local function tipText(i)
    if i == 1 then return T("faction." .. ((G.S and G.S.team) or "atk") .. ".desc") end
    return T("hud.tip." .. i)
  end
  local function showTip()
    tipTitle.Text = T("hud.tip.title")
    tipPage.Text = T("hud.tip.page", tipI, NT)
    tipBody.Text = tipText(tipI)
    for k, s in ipairs(segs) do s.BackgroundTransparency = (k <= tipI) and 0 or 0.8 end
    closeK.Text, closeW.Text = T("hud.key.back"), T("hud.tip.close")
    nextK.Text, nextW.Text = T("hud.key.enter"), (tipI < NT) and T("hud.tip.next") or T("hud.tip.close")
  end
  local function closeTip()
    tipDone = true
    tip.Visible = false
  end
  local function nextTip()
    if tipI >= NT then closeTip() return end
    tipI += 1
    showTip()
  end
  closeB.Activated:Connect(closeTip)
  nextB.Activated:Connect(nextTip)
  UIS.InputBegan:Connect(function(io, gp)
    if gp or not tip.Visible then return end
    if io.KeyCode == Enum.KeyCode.Return then nextTip()
    elseif io.KeyCode == Enum.KeyCode.Backspace then closeTip() end
  end)
  local tipT0 = nil

  ---------------------------------------------------------------- 每帧

  local function fmtTime(s)
    s = math.max(0, math.floor(s or 0))
    return string.format("%02d:%02d", s // 60, s % 60)
  end
  -- 028 / 900：前面补的 0 暗一点
  local function padNum(n, dim)
    local s = string.format("%03d", math.max(0, n))
    local lead = string.match(s, "^0*")
    if #lead == #s then lead = string.sub(s, 1, #s - 1) end
    local rest = string.sub(s, #lead + 1)
    return (#lead > 0 and ('<font color="' .. dim .. '">' .. lead .. "</font>") or "") .. rest
  end
  local sqT, gT = 0, 0
  local function squadOf(team)
    local list = {}
    for _, pl in ipairs(Players:GetPlayers()) do
      if pl:GetAttribute("Side") == team then table.insert(list, pl) end
    end
    table.sort(list, function(a, b) return a.UserId < b.UserId end)
    local idx = table.find(list, me) or 1
    local g = (idx - 1) // 5
    local out = {}
    for i = g * 5 + 1, math.min(#list, g * 5 + 5) do table.insert(out, list[i]) end
    return out, g + 1
  end

  function G.stepHud(dt)
    local cam = workspace.CurrentCamera
    if cam then layoutScore(cam.ViewportSize) end
    local S = G.S
    local deployOn = G.menuOpen ~= nil and G.menuOpen() and not (G.hangarOpen and G.hangarOpen())
    -- 比分条：战斗中和部署界面都有；选阵营、结算、开服加载时不显示
    top.Visible = S ~= nil and S.picked ~= false and not G.factionOpen and S.phase ~= "end" and (S.progress or 1) >= 1 and (P.hud.Visible or deployOn)
    if not S or not top.Visible then
      for _, m in pairs(marks) do m.bb.Enabled = false end
      tip.Visible = false
      if not S then return end
    end
    local mine = S.team or "atk"
    local foe = other(mine)
    local pts = S.points or {}
    -- 比分：手里的据点数
    local held = { atk = 0, def = 0 }
    for _, s in ipairs(pts) do held[s.owner] = (held[s.owner] or 0) + 1 end
    local n = math.max(1, #pts)
    -- 分阶段突破：攻方那头是兵力（剩多少、细线按开局的比例），守方那头还是手里的据点数
    local tk = S.tickets
    for sx, t in pairs({ [-1] = mine, [1] = foe }) do
      local s = sides[sx]
      local c = teamColor(t)
      if t == "atk" and tk then
        s.name.Text = T("hud.atk") .. " · " .. T("hud.tickets")
        s.score.Text = tostring(tk)
        s.bar.Size = UDim2.new(math.clamp(tk / math.max(S.ticketsMax or tk, 1), 0, 1), 0, 0, 2)
        s.score.TextColor3 = tk <= 30 and RGB(255, 119, 105) or c:Lerp(WHITE, 0.15)
      else
        s.name.Text = T("hud." .. t)
        s.score.Text = tostring(held[t] or 0)
        s.bar.Size = UDim2.new((held[t] or 0) / n, 0, 0, 2)
        s.score.TextColor3 = c:Lerp(WHITE, 0.15)
      end
      s.bar.BackgroundColor3 = c
    end
    local stg = S.stageId and (T("hud.stage", S.stage or 1, S.stages or 3) .. " · " .. T("stage." .. S.stageId .. ".short")) or T("hud.mode")
    if S.phase == "prep" then
      timer.Text = fmtTime(S.left)
      mode.Text = compactScore and T("hud.prep") or (T("hud.prep") .. " · " .. stg)
    elseif S.ot then timer.Text = fmtTime(S.ot) mode.Text = T("hud.ot")
    else timer.Text = fmtTime(S.left) mode.Text = stg end
    -- 现在的目标：当前阶段开放的据点（侧翼另写）
    local main, flank = {}, {}
    for _, s in ipairs(pts) do
      if s.act and not s.locked then table.insert(s.flank and flank or main, compactScore and s.id or T("point." .. s.id)) end
    end
    local gtext = ""
    if #main > 0 then
      local col = hex(teamColor(mine):Lerp(WHITE, 0.25))
      gtext = '<font color="' .. col .. '">' .. T((mine == "atk") and "hud.goalAtk" or "hud.goalDef") .. "</font>  " .. table.concat(main, "  ·  ")
      if #flank > 0 then gtext ..= '   <font color="#9aa0a6">' .. T("hud.goalFlank", table.concat(flank, "  ·  ")) .. "</font>" end
    end
    goal.Text = gtext
    local t = os.clock()
    for _, s in ipairs(pts) do
      local d = diamonds[s.id]
      if d then
        local ours = s.owner == mine
        local idle = s.act == false and not s.locked   -- 还没轮到的阶段
        d.d.BackgroundColor3 = teamColor(s.owner)
        d.d.BackgroundTransparency = (ours or idle) and 1 or (s.locked and 0.45 or 0.05)
        local fight = (s.atk or 0) > 0 and (s.def or 0) > 0
        d.st.Transparency = fight and (reducedMotion and 0.12 or (0.4 + 0.3 * math.sin(t * 8))) or ((s.locked or idle) and 0.7 or 0.15)
        d.st.Color = ours and WHITE or teamColor(s.owner):Lerp(WHITE, 0.3)
        d.l.TextTransparency = (s.locked or idle) and 0.55 or 0
        local pr = (not s.locked and s.owner == "def") and (s.prog or 0) or 0
        d.pb.Visible = pr > 0
        d.pf.Size = UDim2.fromScale(pr, 1)
        d.pf.BackgroundColor3 = teamColor("atk")
      end
    end
    if not P.hud.Visible or not cam then return end
    -- 世界里的据点：没拿下的才标
    gT -= dt
    local cp = cam.CFrame.Position
    for _, s in ipairs(pts) do
      local m = marks[s.id]
      if m then
        if not m.ok and gT <= 0 and m.tries < 30 then
          m.tries += 1
          ground(m)
        end
        local on = not s.locked and s.act ~= false and not G.scopeOn   -- 只标当前阶段能占的
        m.bb.Enabled = on
        if on then
          m.l.TextColor3 = (s.owner == mine) and WHITE or teamColor(s.owner):Lerp(WHITE, 0.2)
          local dd = (Vector3.new(m.x, cp.Y, m.z) - cp).Magnitude
          m.dist.Text = math.floor(dd / M_PER + 0.5) .. "m"
          m.verb.Text = T((mine == "atk") and "hud.markAtk" or "hud.markDef") .. (s.flank and (" · " .. T("hud.flank")) or "")
          m.verb.TextColor3 = teamColor(mine):Lerp(WHITE, 0.35)
        end
      end
    end
    if gT <= 0 then gT = 2 end
    -- 雷达：跟着人走、北朝上
    local root = G.mapRoot
    local ch = me.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local pos = hrp and hrp.CFrame.Position or cp
    -- 视线从自己的眼睛（开车时从镜头）往外打：第三人称的镜头可能在墙外头
    local head = ch and ch:FindFirstChild("Head")
    local eye = (head and not G.drive) and head.CFrame.Position or cp
    curR += (wantRange() - curR) * math.min(1, dt * 3)
    rangeL.Text = (curR >= 2000 * M_PER) and string.format("%.1fkm", curR / M_PER / 1000) or (math.floor(curR / M_PER + 0.5) .. "m")
    local ZOOM = MAPW * (MS / 2) / curR
    if root and root.Parent == box and G.mapUV then
      if G.mapTheme then G.mapTheme("mini") end
      if G.mapFocus then G.mapFocus(pos.X, pos.Z, curR) end   -- 身边画细节块（MapUI 的卫星图）
      local u, v = G.mapUV(pos.X, pos.Z)
      root.AnchorPoint = V2(0, 0)
      root.Size = UDim2.fromOffset(ZOOM, ZOOM)
      root.Position = UDim2.new(0.5, -u * ZOOM, 0.5, -v * ZOOM)
      root.BackgroundTransparency = 0.1   -- 海稍微透一点（部署界面的大地图照旧不透明）
    elseif root and root.BackgroundTransparency ~= 0 then
      root.BackgroundTransparency = 0
      if G.mapTheme then G.mapTheme("map") end
    end
    local lv = cam.CFrame.LookVector
    local hdg = (math.deg(math.atan2(lv.X, -lv.Z)) + 360) % 360   -- 北 = −Z（地图上方）
    heading.Text = string.format("%03d°", math.floor(hdg + 0.5) % 360)
    arrow.Rotation = hdg
    local now = os.clock()
    do   -- 开着坦克瞄准镜（战况表、战术平板没开）：小地图在目镜黑框上面
      local dv = G.myVeh
      local over = dv ~= nil and dv == G.drive and dv.sight == true
        and not (G.tacOpen and G.tacOpen()) and not (G.boardShown and G.boardShown())
      local want = over and radarTop or P.hud
      if box.Parent ~= want then box.Parent = want end
    end
    -- 亮点：0.1 秒收一次雷达范围里的东西；敌方步兵每个 0.3 秒查一次视线
    scanT -= dt
    local mine = me:GetAttribute("Side")
    if scanT <= 0 then
      scanT = 0.1
      scan(pos, mine)
      purgeT -= 0.1
      if purgeT <= 0 then   -- 阵亡、消失了的模型不留在表里（长时间开着越积越多）
        purgeT = 5
        for mdl in pairs(seenT) do if not mdl.Parent then seenT[mdl] = nil end end
        for mdl in pairs(losT) do if not mdl.Parent then losT[mdl] = nil end end
      end
      for _, c in ipairs(contacts) do
        if c.team ~= mine and c.kind == "inf" and c.model and now >= (losT[c.model] or 0) then
          losT[c.model] = now + 0.3
          if visible(c, eye) then seenT[c.model] = now end
        end
      end
    end
    used = 0
    table.clear(G.radarShown)
    local px = (MS / 2) / curR
    local function place(b, wpos)
      b.f.Position = UDim2.new(0.5, (wpos.X - pos.X) * px, 0.5, (wpos.Z - pos.Z) * px)
    end
    local pulse = 0.08 + 0.14 * (0.5 + 0.5 * math.sin(now * 5))   -- 敌人的亮点轻轻地一明一暗（不靠扫描线也一眼看得到）
    for _, c in ipairs(contacts) do
      local enemy = c.team ~= mine
      local show = not enemy or RC.allEnemies or c.kind ~= "inf" or (c.model and now - (seenT[c.model] or -99) < 2)
      if show then
        local b = blip()
        shape(b, c.kind, enemy and FOE or FRIEND, enemy and pulse or 0.12)
        place(b, c.pos)
        table.insert(G.radarShown, { team = c.team, kind = c.kind, enemy = enemy })
      end
    end
    for i = #pings, 1, -1 do
      local p = pings[i]
      local age = now - p.t
      if age > RC.ping then
        table.remove(pings, i)
      else
        local dx, dz = p.pos.X - pos.X, p.pos.Z - pos.Z
        if math.abs(dx) <= curR and math.abs(dz) <= curR then
          local b = blip()
          shape(b, "ping", FOE, math.clamp(age / RC.ping, 0, 1) * 0.9)
          b.f.Size = UDim2.fromOffset(8 + age * 6, 8 + age * 6)
          place(b, p.pos)
          table.insert(G.radarShown, { team = "ping", kind = "ping", enemy = true })
        end
      end
    end
    for i = used + 1, #pool do pool[i].f.Visible = false end
    -- 小队（0.25 秒一次）
    sqT -= dt
    if sqT <= 0 and not mobile then
      sqT = 0.25
      local list, gi = squadOf(mine)
      sqHead.Text = T("hud.squad", T("hud.squad." .. math.clamp(gi, 1, 8))) .. "  " .. #list .. "/5"
      local tc = teamColor(mine)
      for i, r in ipairs(rows) do
        local pl = list[i]
        local vis = pl ~= nil
        r.mark.Visible, r.nm.Visible, r.hb.Visible, r.dead.Visible = vis, vis, vis, vis
        if pl then
          local hum = pl.Character and pl.Character:FindFirstChildOfClass("Humanoid")
          local k = hum and math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1) or 0
          local alive = hum ~= nil and hum.Health > 0
          r.nm.Text = string.upper(pl.DisplayName)
          r.nm.TextColor3 = (pl == me) and WHITE or TEXT
          r.nm.Font = (pl == me) and Enum.Font.GothamBold or Enum.Font.GothamMedium
          r.mark.BackgroundColor3 = tc
          r.hb.Visible = alive
          r.hf.Size = UDim2.new(k, 0, 0, 2)
          r.hf.BackgroundColor3 = (k > 0.35) and tc:Lerp(WHITE, 0.2) or RGB(235, 90, 70)
          r.dead.Text = alive and "" or T("hud.dead")
        end
      end
    end
    -- 武器、弹药
    local id, a = nil, nil
    if G.weaponNow then id, a = G.weaponNow() end
    local w = id and W[id]
    wp.Visible = w ~= nil and not G.drive
    if w then
      local name = T("weapon." .. id)
      if w.kind == "gun" then name = name .. "    [" .. T(w.auto and "hud.auto" or "hud.semi") .. "]" end
      wName.Text = name
      if w.kind == "heal" or w.kind == "repair" or w.kind == "spot" or w.kind == "breach" then
        wAmmo.Text = ""
      elseif a and a.r and a.r > 0 then
        wAmmo.Text = '<font size="18">' .. T("hud.reload") .. "</font>"
      elseif a then
        wAmmo.TextColor3 = ((a.n or 0) == 0) and RGB(235, 90, 70) or WHITE
        wAmmo.Text = padNum(a.n or 0, hex(FAINT)) .. '<font size="22" color="' .. hex(MUTE) .. '">/' .. (a.res and string.format("%03d", a.res) or "∞") .. "</font>"
      end
    end
    -- 目标说明：第一次出生后过一秒弹出来，一次进服只一次；开着战况表（Tab）时先让开
    local boardOn = G.boardShown ~= nil and G.boardShown()
    if not tipDone and S.alive and S.phase ~= "end" then
      tipT0 = tipT0 or t
      local want = t - tipT0 > 1 and not boardOn and not (G.operationHudVisible and G.operationHudVisible()) and not G.tankHudActive
      if want and not tip.Visible then
        tip.Visible = true
        showTip()
      elseif not want and tip.Visible then
        tip.Visible = false
      end
    end
  end

  ---------------------------------------------------------------- 重新部署（H，服务器 Round.lua redeploy）：离当前目标多远（格），活着、开战了才算
  function G.objDist()
    local S = G.S
    local char = me.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (S and S.alive and S.phase == "battle" and hrp) then return nil end
    local best = nil
    for _, s in ipairs(S.points or {}) do
      if s.act ~= false and not s.locked then
        for _, p in ipairs(Map.POINTS) do
          if p.id == s.id then
            local pos = hrp.CFrame.Position
            local d = ((p.x - pos.X) ^ 2 + (p.z - pos.Z) ^ 2) ^ 0.5
            if not best or d < best then best = d end
          end
        end
      end
    end
    return best
  end
  UIS.InputBegan:Connect(function(io, gp)
    if gp or io.KeyCode ~= Enum.KeyCode.H then return end
    local S = G.S
    if S and S.alive and S.phase == "battle" then G.R.Act:FireServer("redeploy") end
  end)

  ---------------------------------------------------------------- 压制（Fx.lua 子弹擦身时调 G.suppress）：屏幕四边往里渐暗、微微模糊，两三秒退掉；越近、越密越重
  local vig = {}
  for _, e in ipairs({ { V2(0, 0), UDim2.new(1, 0, 0.32, 0), 90 }, { V2(0, 1), UDim2.new(1, 0, 0.32, 0), -90 },
    { V2(0, 0), UDim2.new(0.26, 0, 1, 0), 0 }, { V2(1, 0), UDim2.new(0.26, 0, 1, 0), 180 } }) do
    local f = ui.frame(G.gui, e[2], UDim2.fromScale(e[1].X, e[1].Y), RGB(0, 0, 0), 1, e[1])
    f.Name = "Suppress"
    f.ZIndex = 1
    f.BackgroundTransparency = 0
    local g = Instance.new("UIGradient")
    g.Rotation = e[3]
    g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
    g.Parent = f
    f.Visible = false
    table.insert(vig, f)
  end
  local blur = Instance.new("BlurEffect")
  blur.Name = "SuppressBlur"
  blur.Size = 0
  blur.Enabled = false
  blur.Parent = workspace.CurrentCamera
  local supp = 0
  function G.suppress(k) supp = math.min(1, supp + (k or 0.3)) end
  G.frameConn("HudFx", function(dt)
    if supp <= 0 and not vig[1].Visible then return end
    supp = math.max(0, supp - dt * 0.45)
    local on = supp > 0.01
    for _, f in ipairs(vig) do
      f.Visible = on
      if on then f.BackgroundTransparency = 1 - supp * 0.85 end
    end
    blur.Enabled = supp > 0.12
    blur.Size = supp * 7
  end)

  ---------------------------------------------------------------- 准星下面弹一行（击杀、占领）：一两秒淡出，新的把旧的往上顶（用户：感受不到激烈对抗）
  local pops = {}
  function G.pop(text, kind)
    local col = (kind == "kill") and RGB(255, 214, 120) or (kind == "ric") and RGB(255, 178, 64) or (kind == "ricIn") and RGB(200, 220, 255) or RGB(140, 230, 160)
    local l = txt(G.gui, text, UDim2.fromOffset(420, 22), UDim2.fromScale(0.5, 0.6), mobile and 15 or 17, col, Enum.Font.GothamBold, V2(0.5, 0.5), nil, 0.45)
    l.ZIndex = 25
    table.insert(pops, 1, l)
    for i, x in ipairs(pops) do
      if x.Parent then x.Position = UDim2.new(0.5, 0, 0.6, -(i - 1) * 24) end
    end
    while #pops > 3 do table.remove(pops):Destroy() end
    task.delay(1.4, function()
      if l.Parent then TweenService:Create(l, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play() end
      task.delay(0.65, function()
        local i = table.find(pops, l)
        if i then table.remove(pops, i) end
        l:Destroy()
      end)
    end)
  end
end

return Hud
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="90">
          <Properties>
            <string name="Name">HudArt</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——驾驶界面的图标（用户 11-19：「像素感太强，我要 3A 级别的 UI」「每个坦克侧面截个图，做成全息颜色的 icon，
--   下面显示血量，全息微微带着光晕」）
--   ReplicatedStorage.HudIcons（tools/models/hudicons.py 生成）里是每辆地面载具从原模型正侧面拍的全息图（灰度 + 柔光晕）和
--   界面图形（六边形、炮弹、机枪弹、烟幕弹、「∧」、小炮弹，4 倍超采样画的，边缘不起锯齿），这里解成 EditableImage：
--   G.hudIcon(名字) → { content = Content（给 ImageLabel.ImageContent）, w, h }；用不了（游戏设置 → 安全里没打开 Mesh / Image API）返回 nil，
--   界面退回方块拼的。图是白的 / 灰的，界面上用 ImageColor3 染色（全息青、挨打红）。第一次用到时解（一张一两毫秒），之后缓存
local RS = game:GetService("ReplicatedStorage")

local HudArt = {}

function HudArt.init(G)
  local AS = game:GetService("AssetService")
  local data = nil
  local B64 = {}
  do
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i = 1, 64 do B64[string.byte(chars, i)] = i - 1 end
  end
  local function unb64(s)   -- → 二进制字符串（同 FPSView）
    local parts, chunk, cn = {}, {}, 0
    local pad = 0
    if string.sub(s, -1) == "=" then pad = (string.sub(s, -2, -2) == "=") and 2 or 1 end
    for i = 1, #s, 4 do
      local a, b, c, d = string.byte(s, i, i + 3)
      local x = B64[a] * 262144 + B64[b] * 4096 + (B64[c] or 0) * 64 + (B64[d] or 0)
      chunk[cn + 1] = math.floor(x / 65536) % 256
      chunk[cn + 2] = math.floor(x / 256) % 256
      chunk[cn + 3] = x % 256
      cn += 3
      if cn >= 3000 then
        parts[#parts + 1] = string.char(table.unpack(chunk, 1, cn))
        cn = 0
      end
    end
    if cn > 0 then parts[#parts + 1] = string.char(table.unpack(chunk, 1, cn)) end
    local out = table.concat(parts)
    if pad > 0 then out = string.sub(out, 1, #out - pad) end
    return out
  end

  local cache = {}
  local broken = false   -- EditableImage 用不了：不再试
  local function decode(t)
    local w, h = t.w, t.h
    local raw = unb64(t.d)
    local buf = buffer.create(w * h * 4)   -- 新建的是全 0（透明）
    local la = t.f == "la"
    local o, i, n = 0, 1, #raw
    while i <= n do
      local b = string.byte(raw, i)
      if b == 0 then
        o += string.byte(raw, i + 1)   -- 一串透明的：跳过
        i += 2
      else
        local l, a
        if la then
          l, a = math.floor(b / 16) * 17, (b % 16) * 17
        else
          l, a = 255, b
        end
        local p = o * 4
        buffer.writeu8(buf, p, l)
        buffer.writeu8(buf, p + 1, l)
        buffer.writeu8(buf, p + 2, l)
        buffer.writeu8(buf, p + 3, a)
        o += 1
        i += 1
      end
    end
    local img = AS:CreateEditableImage({ Size = Vector2.new(w, h) })
    img:WritePixelsBuffer(Vector2.zero, Vector2.new(w, h), buf)
    return { img = img, content = Content.fromObject(img), w = w, h = h }
  end

  function G.hudIcon(name)
    local c = cache[name]
    if c ~= nil then return c or nil end
    if broken then return nil end
    if not data then
      local ok, d = pcall(function() return require(RS:WaitForChild("HudIcons", 5)) end)
      data = (ok and type(d) == "table") and d or {}
    end
    local t = data[name]
    if not t then
      cache[name] = false
      return nil
    end
    local ok, res = pcall(decode, t)
    if not ok then
      broken = true
      cache[name] = false
      return nil
    end
    cache[name] = res
    return res
  end

  -- 给一个 ImageLabel 装上图标：成功返回 true（失败时 ImageLabel 不动，调用的地方显示方块拼的）
  function G.hudIconOn(label, name)
    local ic = G.hudIcon(name)
    if not ic then return false end
    local ok = pcall(function() label.ImageContent = ic.content end)
    if ok then label:SetAttribute("Icon", name) end   -- 测试的截图工具（tools/mock/hudshot.lua）认图用
    return ok
  end
end

return HudArt
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="91">
          <Properties>
            <string name="Name">Juice</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——爽感（用户：同时想办法增加玩家体验感和爽感）
--   ① 加分滚动（准星右边）：每次打死、摧毁、占领弹一行「+60 击杀」，上面一个大数字累计；2.5 秒没新的就淡出清零
--   ② 爆头：头盔上「叮」一声脆响，加分行里多一行金色的「爆头」
--   ③ 连杀：4.5 秒内接着打死——屏幕上方「双杀！三杀！四杀！N 连杀！」，一声往上走的提示音；
--      一条命里连着打死 5 / 10 / 15 个：「势不可挡 / 杀戮机器 / 战场之王」大横幅，死了清零
--   ④ 受伤方向：挨打时准星周围一道红弧指向开枪的人（炸的指向炸点），一秒多淡出
--   ⑤ 低血量：三成血以下屏幕四周发红、画面发灰，心跳一下一下（血越少越快）
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local Juice = {}

function Juice.init(G)
  local Config = G.Config
  local me = Players.LocalPlayer
  local pg = me:WaitForChild("PlayerGui")
  local V2, RGB = Vector2.new, Color3.fromRGB
  local SC = Config.Score
  local function T(k, ...) return G.T(k, ...) end
  local now = os.clock

  local gui = Instance.new("ScreenGui")
  gui.Name = "Juice"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 9
  gui.Parent = pg
  local function label(parent, text, size, pos, ts, color, font, anchor, align)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size, l.Position = size, pos
    l.AnchorPoint = anchor or V2(0, 0.5)
    l.Text = text
    l.TextSize = ts
    l.TextColor3 = color
    l.Font = font or Enum.Font.GothamBold
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextStrokeTransparency = 0.45
    l.Parent = parent
    return l
  end

  ---------------------------------------------------------------- ① 加分滚动

  local ticker = Instance.new("Frame")
  ticker.Name = "Ticker"
  ticker.BackgroundTransparency = 1
  ticker.Size = UDim2.fromOffset(260, 150)
  ticker.Position = UDim2.new(0.5, 64, 0.5, -42)
  ticker.Parent = gui
  local total = label(ticker, "", UDim2.fromOffset(240, 34), UDim2.fromOffset(0, 16), 28, RGB(255, 222, 120), Enum.Font.GothamBlack)
  total.Name = "Total"
  local tScale = Instance.new("UIScale")
  tScale.Parent = total
  local lines, sum, lastT = {}, 0, -1e9
  local function relayout()
    for i, l in ipairs(lines) do
      if l.Parent then l.Position = UDim2.fromOffset(2, 40 + (i - 1) * 21) end
    end
  end
  local function addLine(text, color)
    local l = label(ticker, text, UDim2.fromOffset(240, 20), UDim2.fromOffset(2, 40), 16, color or Color3.new(1, 1, 1))
    l.Name = "Line"
    table.insert(lines, 1, l)
    while #lines > 4 do table.remove(lines):Destroy() end
    relayout()
  end
  -- 加 pts 分、一行说明（pts 为 0 只加一行字，比如「爆头」）
  function G.juiceScore(pts, text, color)
    if now() - lastT > 2.5 then sum = 0 end
    sum += pts or 0
    lastT = now()
    total.Text = (sum > 0) and ("+" .. sum) or ""
    total.TextTransparency, total.TextStrokeTransparency = 0, 0.45
    tScale.Scale = 1.35
    TweenService:Create(tScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    addLine(((pts or 0) > 0 and ("+" .. pts .. "  ") or "") .. text, color)
  end

  ---------------------------------------------------------------- ③ 连杀横幅

  local banner = label(gui, "", UDim2.fromOffset(700, 60), UDim2.fromScale(0.5, 0.24), 44, RGB(255, 236, 170), Enum.Font.GothamBlack, V2(0.5, 0.5), Enum.TextXAlignment.Center)
  banner.Name = "Banner"
  banner.TextStrokeTransparency = 0.2
  banner.TextTransparency = 1
  local sub = label(gui, "", UDim2.fromOffset(500, 26), UDim2.new(0.5, 0, 0.24, 38), 18, RGB(255, 200, 120), Enum.Font.GothamBold, V2(0.5, 0.5), Enum.TextXAlignment.Center)
  sub.Name = "BannerSub"
  sub.TextTransparency = 1
  local bScale = Instance.new("UIScale")
  bScale.Parent = banner
  local bannerT = -1e9
  local function showBanner(text, small)
    banner.Text, sub.Text = text, small or ""
    banner.TextTransparency, banner.TextStrokeTransparency = 0, 0.2
    sub.TextTransparency, sub.TextStrokeTransparency = 0, 0.5
    bScale.Scale = 1.6
    TweenService:Create(bScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
    bannerT = now()
    if G.sfx then G.sfx("streak", nil, { vol = 0.9 }) end
    if G.shake then G.shake(0.12) end
  end
  local kills, life = {}, 0
  local MULTI = { [2] = "juice.x2", [3] = "juice.x3", [4] = "juice.x4" }
  local LIFE = { [5] = "juice.s5", [10] = "juice.s10", [15] = "juice.s15" }

  ---------------------------------------------------------------- 命中、打死（Play.lua 的 G.hitMarker 调）

  function G.juiceHit(kind)
    local kill = string.find(kind, "kill") ~= nil
    local head = string.find(kind, "head") ~= nil
    if head and G.sfx then G.sfx("headshot", nil, { vol = kill and 1.1 or 0.8 }) end
    if not kill then return end
    local pts, what = SC.botKill, T("juice.kill")
    if kind == "pkill" or kind == "headpkill" then pts = SC.kill
    elseif kind == "vkill" then pts, what = SC.vehicleKill, T("juice.vkill")
    elseif kind == "fkill" then pts, what = SC.fortKill, T("juice.fkill") end
    G.juiceScore(pts, what)
    if head then G.juiceScore(0, T("juice.head"), RGB(255, 205, 80)) end
    -- 连杀：4.5 秒内接着打死的算一串
    local t = now()
    for i = #kills, 1, -1 do if t - kills[i] > 4.5 then table.remove(kills, i) end end
    table.insert(kills, t)
    life += 1
    local n = #kills
    if LIFE[life] then
      showBanner(T(LIFE[life]), T("juice.streak", life))
    elseif n >= 2 then
      showBanner(MULTI[n] and T(MULTI[n]) or T("juice.xn", n))
    end
  end
  G.juiceState = function() return { sum = sum, life = life, multi = #kills } end   -- 测试用

  ---------------------------------------------------------------- ④ 受伤方向

  local hurtArcs = {}
  for i = 1, 6 do
    local f = Instance.new("Frame")
    f.Name = "HurtArc"
    f.AnchorPoint = V2(0.5, 0.5)
    f.Size = UDim2.fromOffset(74, 9)
    f.BackgroundColor3 = RGB(230, 40, 30)
    f.BorderSizePixel = 0
    f.BackgroundTransparency = 1
    f.Visible = false
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(1, 0)
    c.Parent = f
    local gr = Instance.new("UIGradient")   -- 两头淡、中间浓：像一道弧
    gr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
    gr.Parent = f
    f.Parent = gui
    hurtArcs[i] = { f = f, t = -1e9, pos = nil }
  end
  local hurtN = 0
  function G.juiceHurt(pos)
    hurtN = hurtN % #hurtArcs + 1
    local a = hurtArcs[hurtN]
    a.t, a.pos = now(), pos
    a.f.Visible = true
  end

  ---------------------------------------------------------------- ⑤ 低血量

  local edges = {}
  for _, side in ipairs({ { V2(0, 0), UDim2.new(1, 0, 0.22, 0), 90 }, { V2(0, 1), UDim2.new(1, 0, 0.22, 0), -90 }, { V2(0, 0), UDim2.new(0.18, 0, 1, 0), 0 }, { V2(1, 0), UDim2.new(0.18, 0, 1, 0), 180 } }) do
    local f = Instance.new("Frame")
    f.Name = "LowHp"
    f.AnchorPoint = side[1]
    f.Position = UDim2.fromScale(side[1].X, side[1].Y)
    f.Size = side[2]
    f.BackgroundColor3 = RGB(150, 0, 0)
    f.BorderSizePixel = 0
    f.Visible = false
    local gr = Instance.new("UIGradient")
    gr.Rotation = side[3]
    gr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
    gr.Parent = f
    f.Parent = gui
    table.insert(edges, f)
  end
  local cc = Instance.new("ColorCorrectionEffect")
  cc.Name = "JuiceLowHp"
  cc.Enabled = false
  cc.Parent = Lighting
  local beatT = 0

  ---------------------------------------------------------------- 每帧

  local lastAlive = true
  G.frameConn("Juice", function(dt)
    local t = now()
    -- 加分滚动：2.5 秒没新的就淡出
    local a = t - lastT
    if a > 2.5 and total.Text ~= "" then
      local k = math.clamp((a - 2.5) / 0.5, 0, 1)
      total.TextTransparency, total.TextStrokeTransparency = k, 0.45 + 0.55 * k
      for _, l in ipairs(lines) do l.TextTransparency, l.TextStrokeTransparency = k, 0.45 + 0.55 * k end
      if k >= 1 then
        total.Text = ""
        for _, l in ipairs(lines) do l:Destroy() end
        lines = {}
      end
    end
    -- 横幅：1.6 秒后淡出
    local b = t - bannerT
    if b > 1.6 and banner.TextTransparency < 1 then
      local k = math.clamp((b - 1.6) / 0.5, 0, 1)
      banner.TextTransparency, banner.TextStrokeTransparency = k, 0.2 + 0.8 * k
      sub.TextTransparency, sub.TextStrokeTransparency = k, 0.5 + 0.5 * k
    end
    -- 受伤方向：按伤害来的方向（相对镜头的水平方位）摆在准星周围一圈上
    local cam = workspace.CurrentCamera
    local cf = cam.CFrame
    for _, h in ipairs(hurtArcs) do
      if h.f.Visible then
        local age = t - h.t
        if age > 1.4 or not h.pos then
          h.f.Visible = false
        else
          local d = h.pos - cf.Position
          local x, z = d:Dot(cf.RightVector), d:Dot(Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z).Unit)
          local ang = math.atan2(x, z)   -- 0 正前、正的在右边
          local r = 120
          h.f.Position = UDim2.new(0.5, math.sin(ang) * r, 0.5, -math.cos(ang) * r)
          h.f.Rotation = math.deg(ang)
          h.f.BackgroundTransparency = 0.1 + 0.9 * math.clamp((age - 0.6) / 0.8, 0, 1)
        end
      end
    end
    -- 低血量
    local char = me.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local f = 1
    if hum and hum.MaxHealth > 0 and hum.Health > 0 then f = hum.Health / hum.MaxHealth end
    local low = (f < 0.35) and (0.35 - f) / 0.35 or 0
    local inVeh = G.drive ~= nil or G.fly ~= nil
    if inVeh then low = 0 end
    local on = low > 0.01
    for _, e in ipairs(edges) do
      e.Visible = on
      if on then e.BackgroundTransparency = 1 - (0.25 + 0.45 * low) * (0.75 + 0.25 * math.sin(t * (5 + 6 * low))) end
    end
    cc.Enabled = on
    if on then
      cc.Saturation = -0.55 * low
      cc.TintColor = Color3.new(1, 1 - 0.18 * low, 1 - 0.18 * low)
      if t >= beatT then
        beatT = t + 1.1 - 0.5 * low
        if G.sfx then G.sfx("heart", nil, { vol = 0.6 + 0.6 * low }) end
      end
    end
    -- 死了：一条命的连杀清零
    local alive = hum ~= nil and hum.Health > 0
    if lastAlive and not alive then life, kills = 0, {} end
    lastAlive = alive
  end)
end

return Juice
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="92">
          <Properties>
            <string name="Name">MapUI</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——地图界面：按 Map.lua 的高度画出群岛（每行相邻的同色格并成一块，几百个方块），标据点、海滩、舰队、出生点、自己、被标记的敌人
--   部署界面的大地图和右上角的小地图是同一张图：换父级、改大小（里面都按比例摆）
--   有 EditableImage 时上面盖一张 MapPaint 画的卫星图（整张图的底图 + 小地图身边的细节块），见下面「卫星图」
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local MapUI = {}

function MapUI.init(G)
  local Map = require(RS:WaitForChild("Map"))
  local Config = G.Config
  local player = Players.LocalPlayer
  local RGB = Color3.fromRGB

  -- 地图范围（世界坐标）：所有岛和舰队都在里面
  local K = Map.K or 1   -- 地图放大的倍数（Map.lua）
  local X0, X1, Z0, Z1 = -3000 * K, 3000 * K, -2500 * K, 3600 * K
  local SPAN = math.max(X1 - X0, Z1 - Z0)
  local function toUV(x, z) return (x - X0) / SPAN, (z - Z0) / SPAN end
  G.mapUV = toUV
  G.mapXZ = function(u, v) return X0 + u * SPAN, Z0 + v * SPAN end   -- 地图上的点 → 世界坐标（战术平板点目标用）
  G.mapSpan = SPAN

  local root = Instance.new("Frame")
  root.Name = "IslandMap"
  -- 配色压暗、去饱和（用户：界面太卡通，要精致、简洁）：深色的海、灰绿的陆地、细网格、直角
  root.BackgroundColor3 = RGB(14, 24, 32)
  root.BorderSizePixel = 0
  root.ClipsDescendants = true
  root.SizeConstraint = Enum.SizeConstraint.RelativeYY
  local land = Instance.new("Frame")
  land.Name = "Land"
  land.BackgroundTransparency = 1
  land.Size = UDim2.fromScale(1, 1)
  land.Parent = root
  local bands = Instance.new("Frame")   -- 按高度分档的色块、路线（有卫星图以后藏起来：用不了 EditableImage 时才看得到）
  bands.Name = "Bands"
  bands.BackgroundTransparency = 1
  bands.Size = UDim2.fromScale(1, 1)
  bands.Parent = land
  for k = 1, 7 do   -- 细网格
    for _, vert in ipairs({ true, false }) do
      local g = Instance.new("Frame")
      g.Name = "Grid"
      g.BorderSizePixel = 0
      g.BackgroundColor3 = Color3.new(1, 1, 1)
      g.BackgroundTransparency = 0.93
      g.Size = vert and UDim2.new(0, 1, 1, 0) or UDim2.new(1, 0, 0, 1)
      g.Position = vert and UDim2.fromScale(k / 8, 0) or UDim2.fromScale(0, k / 8)
      g.ZIndex = 2
      g.Parent = root
    end
  end
  local marks = Instance.new("Frame")
  marks.Name = "Marks"
  marks.BackgroundTransparency = 1
  marks.Size = UDim2.fromScale(1, 1)
  marks.ZIndex = 3
  marks.Parent = root

  -- 陆地：按高度分几档颜色
  local function band(y)
    if y <= 0.3 then return nil end
    if y < 4 then return 1 end
    if y < 40 then return 2 end
    if y < 110 then return 3 end
    if y < 200 then return 4 end
    return 5
  end
  local BAND = { RGB(118, 112, 92), RGB(62, 74, 58), RGB(54, 66, 50), RGB(70, 74, 64), RGB(92, 92, 88), RGB(42, 54, 42) }
  -- 放进左下的雷达时整张图换成墨绿（Hud.lua 调 G.mapTheme("radar")）：海近黑、陆地按高低深浅、路和网格是亮一点的绿
  local RADAR = { RGB(22, 66, 38), RGB(16, 54, 30), RGB(14, 48, 27), RGB(20, 60, 34), RGB(28, 72, 42), RGB(10, 40, 22) }
  -- 右上的小地图（用户 11-19：不要黑绿，改成正常的；再要暗淡、拟真）：深蓝的海，暗沙色海滩，暗绿的低地、山坡，高处灰褐；路是土色
  --   （有 EditableImage 时上面盖一张 MapPaint 画的卫星图，这些色块只在用不了时看得到）
  local MINI = { RGB(146, 136, 110), RGB(76, 90, 58), RGB(68, 82, 54), RGB(92, 94, 82), RGB(100, 98, 92), RGB(60, 74, 48) }
  local SEA = { map = RGB(14, 24, 32), radar = RGB(3, 14, 8), mini = RGB(22, 36, 50) }
  local theme = "map"
  local landBand = {}   -- 陆地块 → 档（换配色用）
  local roads = {}
  local fleetMarks = {}   -- 舰队、机场岛的小灰块：雷达里换成暗绿
  local function landCol(b) return ((theme == "radar" and RADAR) or (theme == "mini" and MINI) or BAND)[b] end
  local N = 110
  local cell = SPAN / N
  task.spawn(function()
    for j = 0, N - 1 do
      local z = Z0 + (j + 0.5) * cell
      local runB, runI = nil, 0
      for i = 0, N do
        local b = nil
        if i < N then
          local x = X0 + (i + 0.5) * cell
          b = band(Map.height(x, z))
          -- （树林删掉了，地图上不再画深绿的林子）
        end
        if b ~= runB then
          if runB then
            local f = Instance.new("Frame")
            f.BorderSizePixel = 0
            f.BackgroundColor3 = landCol(runB)
            landBand[f] = runB
            f.Position = UDim2.fromScale(runI / N, j / N)
            f.Size = UDim2.fromScale((i - runI) / N, 1 / N + 0.0008)
            f.Parent = bands
          end
          runB, runI = b, i
        end
      end
      if j % 12 == 0 then task.wait() end
    end
    -- 路网：沿路每隔几个点连一段细线（土黄色）
    for _, r in ipairs(Map.ROADS or {}) do
      local step = 3
      for i = 1, #r.x - 1, step do
        local k = math.min(#r.x, i + step)
        local u0, v0 = toUV(r.x[i], r.z[i])
        local u1, v1 = toUV(r.x[k], r.z[k])
        local len = math.sqrt((u1 - u0) ^ 2 + (v1 - v0) ^ 2)
        if len > 0 then
          local f = Instance.new("Frame")
          f.Name = "Road"
          f.BorderSizePixel = 0
          f.BackgroundColor3 = (theme == "radar") and RGB(70, 150, 90) or RGB(150, 140, 116)
          table.insert(roads, f)
          f.AnchorPoint = Vector2.new(0.5, 0.5)
          f.Position = UDim2.fromScale((u0 + u1) / 2, (v0 + v1) / 2)
          f.Size = UDim2.new(len * 1.04, 0, 0, 1)
          f.Rotation = math.deg(math.atan2(v1 - v0, u1 - u0))
          f.ZIndex = 2
          f.Parent = bands
        end
      end
    end
  end)

  local function dot(parent, u, v, size, color, text, z)
    local f = Instance.new("TextLabel")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.fromScale(u, v)
    f.Size = UDim2.fromOffset(size, size)
    f.BackgroundColor3 = color
    f.BorderSizePixel = 0
    f.Text = text or ""
    f.TextColor3 = Color3.new(1, 1, 1)
    f.TextScaled = true
    f.Font = Enum.Font.GothamBlack
    f.ZIndex = z or 4
    f.Parent = parent
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0.5, 0)
    c.Parent = f
    local s = Instance.new("UIStroke")
    s.Thickness = 1.5
    s.Color = Color3.new(0, 0, 0)
    s.Transparency = 0.3
    s.Parent = f
    return f
  end
  G.mapDot = dot

  -- 据点
  local pointDots = {}
  for _, p in ipairs(Map.POINTS) do
    local u, v = toUV(p.x, p.z)
    pointDots[p.id] = dot(marks, u, v, 18, Config.Teams.def.color, p.id, 5)
  end
  -- 舰队、机场岛（小灰块）
  for _, s in ipairs(Map.FLEET) do
    local u, v = toUV(s.x, s.z)
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.fromScale(u, v)
    f.Size = UDim2.fromScale((s.kind == "lst") and 0.006 or 0.009, (s.kind == "carrier") and 0.1 or 0.07)
    f.Size = UDim2.fromScale(0.012, (s.kind == "carrier") and 0.09 or ((s.kind == "lhd") and 0.07 or 0.045))
    f.BackgroundColor3 = (theme == "radar") and RGB(50, 110, 70) or RGB(120, 126, 132)
    f.BorderSizePixel = 0
    f.ZIndex = 2
    f.Parent = marks
    table.insert(fleetMarks, f)
  end
  -- 海滩：彩色短线
  for _, b in ipairs(Map.BEACHES) do
    local u0, v = toUV(b.x0, b.z)
    local u1 = toUV(b.x1, b.z)
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0, 0.5)
    f.Position = UDim2.fromScale(u0, v)
    f.Size = UDim2.new(u1 - u0, 0, 0, 4)
    f.BackgroundColor3 = b.color
    f.BorderSizePixel = 0
    f.ZIndex = 2
    f.Parent = marks
  end

  ---------------------------------------------------------------- 卫星图（用户 11-19：右上角小地图显示内容更精细、颜色更暗淡、更拟真）
  --   有 EditableImage（游戏设置 → 安全里打开 Mesh / Image API）就照 MapPaint 一个像素一个像素画：
  --   · 整张图一张 512 × 512 的底图（开局在后台画，每帧最多 3 毫秒，一行一行写上去），画完把色块、路线藏起来；
  --   · 小地图跟着人的时候（Hud.lua 每帧调 G.mapFocus），身边再画细节块（电脑 128 × 128 像素一块、800 格见方，每像素 6.25 格；
  --     触屏 80 × 80，每像素 10 格）：近的先画，全是深海的不画（底图就够了），最多留 36 块（最久没用的先扔）
  --   用不了 EditableImage 就照旧是色块（暗淡的那套配色）
  local AS = game:GetService("AssetService")
  local UIS = game:GetService("UserInputService")
  local Paint = require(RS:WaitForChild("MapPaint"))
  local imgOK = nil   -- nil 还没试、true 能用、false 用不了
  local function newImage(n)
    if imgOK == false then return nil end
    local ok, img = pcall(function() return AS:CreateEditableImage({ Size = Vector2.new(n, n) }) end)
    imgOK = (ok and img ~= nil) and true or false
    return imgOK and img or nil
  end
  local function satLabel(img, u0, v0, us, z)
    local l = Instance.new("ImageLabel")
    l.Name = "Sat"
    l.BackgroundTransparency = 1
    l.BorderSizePixel = 0
    l.Position = UDim2.fromScale(u0, v0)
    l.Size = UDim2.fromScale(us, us)
    l.ZIndex = z
    local ok = pcall(function() l.ImageContent = Content.fromObject(img) end)
    if not ok then
      l:Destroy()
      return nil
    end
    l.Parent = land
    return l
  end
  local BUDGET = 0.003
  local satReady = false
  -- 一块图一行一行画（每帧画到 BUDGET 为止），每行画完写进 EditableImage（没画到的行是透明的：底下的底图、色块照样看得到）
  local function paintInto(img, P, alive)
    local row = buffer.create(P.w * 4)
    local t0 = os.clock()
    for r = 0, P.h - 1 do
      if alive and not alive() then return false end
      Paint.paint(Map, P, r, r + 1, row)
      local ok = pcall(function() img:WritePixelsBuffer(Vector2.new(0, r), Vector2.new(P.w, 1), row) end)
      if not ok then return false end
      if os.clock() - t0 > BUDGET then
        task.wait()
        t0 = os.clock()
      end
    end
    return true
  end
  task.spawn(function()
    task.wait(1)   -- 开局别的先跑
    local NB = 512
    local img = newImage(NB)
    local lab = img and satLabel(img, 0, 0, 1, 1)
    if not lab then
      imgOK = false
      return
    end
    if paintInto(img, { x0 = X0, z0 = Z0, step = SPAN / NB, w = NB, h = NB, detail = false, exag = 2.6 }) then
      satReady = true
      bands.Visible = false
    end
  end)
  -- 细节块
  local touch = UIS.TouchEnabled and not UIS.KeyboardEnabled
  local TPX = touch and 80 or 128
  local TILE = 800
  local tiles, nTiles = {}, 0   -- [键] = { img, lab, used, sea }
  local queue = {}              -- [键] = { tx, tz }
  local focusX, focusZ = nil, nil
  local function key(tx, tz) return tx * 100000 + tz end
  function G.mapFocus(x, z, radius)
    if not satReady then return end
    focusX, focusZ = x, z
    local R = math.min((radius or 600) * 1.5, TILE * 2.5)
    local now = os.clock()
    for tz = math.floor((z - R - Z0) / TILE), math.floor((z + R - Z0) / TILE) do
      for tx = math.floor((x - R - X0) / TILE), math.floor((x + R - X0) / TILE) do
        local k = key(tx, tz)
        local t = tiles[k]
        if t then t.used = now elseif not queue[k] then queue[k] = { tx = tx, tz = tz } end
      end
    end
  end
  G.mapSatState = function() return imgOK, satReady, nTiles end   -- 测试用
  task.spawn(function()
    while true do
      local pick, pk, best = nil, nil, math.huge
      if focusX then
        for k, q in pairs(queue) do
          local cx, cz = X0 + (q.tx + 0.5) * TILE, Z0 + (q.tz + 0.5) * TILE
          local d = (cx - focusX) ^ 2 + (cz - focusZ) ^ 2
          if d > (TILE * 3.5) ^ 2 then queue[k] = nil   -- 走远了：不画了
          elseif d < best then pick, pk, best = q, k, d end
        end
      end
      if not pick then
        task.wait(0.25)
      else
        queue[pk] = nil
        local x0, z0 = X0 + pick.tx * TILE, Z0 + pick.tz * TILE
        if not Paint.hasLand(Map, x0, z0, TILE) then
          tiles[pk] = { sea = true, used = os.clock() }
        else
          -- 太多了：扔掉最久没用的那块
          if nTiles >= 36 then
            local old, ok2, ot = nil, nil, math.huge
            for k, t in pairs(tiles) do
              if not t.sea and t.used < ot then old, ok2, ot = t, k, t.used end
            end
            if old then
              old.lab:Destroy()
              pcall(function() old.img:Destroy() end)
              tiles[ok2] = nil
              nTiles -= 1
            end
          end
          local img = newImage(TPX)
          local u0, v0 = toUV(x0, z0)
          local lab = img and satLabel(img, u0, v0, TILE / SPAN, 2)
          if lab then
            local t = { img = img, lab = lab, used = os.clock() }
            tiles[pk] = t
            nTiles += 1
            paintInto(img, { x0 = x0, z0 = z0, step = TILE / TPX, w = TPX, h = TPX, detail = true, exag = 1.5 }, function() return tiles[pk] == t end)
          end
        end
        task.wait()
      end
    end
  end)

  -- 自己（箭头）、被标记的敌人（红点）
  local me = dot(marks, 0.5, 0.5, 10, RGB(255, 255, 255), "", 7)
  me.Visible = false
  local spotDots = {}

  function G.mapRefresh(S)
    if S and S.points then
      for _, s in ipairs(S.points) do
        local d = pointDots[s.id]
        if d then
          local col = Config.Teams[s.owner].color
          if s.owner == "def" and s.prog > 0 then col = col:Lerp(Config.Teams.atk.color, s.prog) end
          d.BackgroundColor3 = col
        end
      end
    end
  end

  function G.mapSpots(list)
    for _, d in ipairs(spotDots) do d:Destroy() end
    spotDots = {}
    for _, p in ipairs(list or {}) do
      local u, v = toUV(p.X, p.Z)
      table.insert(spotDots, dot(marks, u, v, 8, RGB(255, 50, 40), "", 6))
    end
  end

  function G.stepMap()
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and root.Parent then
      local u, v = toUV(hrp.Position.X, hrp.Position.Z)
      me.Position = UDim2.fromScale(u, v)
      me.Visible = true
    else
      me.Visible = false
    end
  end

  -- 放到某个界面里：size 是 UDim2，pos 位置
  function G.mapMount(parent, size, pos, anchor)
    root.Parent = parent
    root.Size = size
    root.Position = pos or UDim2.new()
    root.AnchorPoint = anchor or Vector2.new()
    return root, marks
  end
  G.mapRoot = root
  -- 配色：「map」部署界面的大地图（灰绿），「mini」右上的小地图（正常的地图颜色：深蓝的海、暗沙色海滩、暗绿的地），「radar」墨绿的雷达（不再用）
  function G.mapTheme(t)
    if t == theme then return end
    theme = t
    local radar, mini = t == "radar", t == "mini"
    root.BackgroundColor3 = SEA[t] or SEA.map
    for f, b in pairs(landBand) do f.BackgroundColor3 = landCol(b) end
    for _, f in ipairs(roads) do f.BackgroundColor3 = radar and RGB(70, 150, 90) or (mini and RGB(122, 110, 90) or RGB(150, 140, 116)) end
    for _, f in ipairs(fleetMarks) do f.BackgroundColor3 = radar and RGB(50, 110, 70) or (mini and RGB(128, 132, 136) or RGB(120, 126, 132)) end
    for _, g in ipairs(root:GetChildren()) do
      if g.Name == "Grid" then
        g.BackgroundColor3 = radar and RGB(80, 255, 140) or Color3.new(1, 1, 1)
        g.BackgroundTransparency = radar and 0.9 or (mini and 0.9 or 0.93)
      end
    end
  end
  G.mapThemeNow = function() return theme end   -- 测试用
end

return MapUI
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="93">
          <Properties>
            <string name="Name">Marks</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——炸弹落点标记（用户：飞机空投炸弹在地面要有标记，方便查看投到哪）
--   开飞机选中炸弹时，按服务器炸弹的算法（Air.lua guideBomb：投出去带着飞机的速度、往下 4 格 / 秒，重力 AD.GRAV、一点阻力）
--   算出落在哪，地上画一个杀伤半径的红圈、中间十字、一道竖光柱（高空也看得见）；制导炸弹锁上了就标在目标上。
--   扔出去的炸弹落地前，地上也一直标着它要落在哪（小一点的圈）。
--   （手雷的抛物线在 Nade.lua，另一个会话做的：按住右键瞄时画，算了弹跳和引信爆点）
--   标记零件都只在本地、不碰撞、不挡射线
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Marks = {}

function Marks.init(G)
  local AD = require(RS:WaitForChild("AirDefs"))
  local Map = G.Map or require(RS:WaitForChild("Map"))
  local W = G.Config.Weapons
  local me = Players.LocalPlayer
  local V, RGB = Vector3.new, Color3.fromRGB
  local GR = AD.GRAV or 27.5
  local function ground(x, z) return AD.ground and AD.ground(Map, x, z) or Map.ground(x, z) end

  local folder = Instance.new("Folder")
  folder.Name = "Marks"
  folder.Parent = workspace
  local function part(size, color, shape, tr)
    local p = Instance.new("Part")
    if shape then p.Shape = shape end
    p.Size, p.Color = size, color
    p.Material = Enum.Material.Neon
    p.Transparency = tr or 0
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Parent = nil
    return p
  end
  -- 地上的一个圈：扁圆柱（轴竖着）+ 中间一个亮点
  local function ring(color, tr)
    local disc = part(V(0.3, 10, 10), color, Enum.PartType.Cylinder, tr)
    disc.Name = "MarkRing"
    return disc
  end
  local function placeRing(disc, pos, r)
    disc.Size = V(0.3, r * 2, r * 2)
    disc.CFrame = CFrame.new(pos + V(0, 0.25, 0)) * CFrame.Angles(0, 0, math.pi / 2)
    disc.Parent = folder
  end

  ---------------------------------------------------------------- 炸弹落点

  local bombRing = ring(RGB(255, 60, 40), 0.68)
  local crossA = part(V(0.4, 0.4, 14), RGB(255, 70, 50), nil, 0.1)
  local crossB = part(V(14, 0.4, 0.4), RGB(255, 70, 50), nil, 0.1)
  local beam = part(V(0.6, 160, 0.6), RGB(255, 90, 60), nil, 0.55)
  crossA.Name, crossB.Name, beam.Name = "BombCross", "BombCross", "BombBeam"
  local function hideBomb()
    bombRing.Parent, crossA.Parent, crossB.Parent, beam.Parent = nil, nil, nil, nil
  end
  -- 按服务器的炸弹物理往前推，落到地面（或海面）为止
  local function bombImpact(p, v)
    local dt = 0.05
    for _ = 1, 1200 do
      v += V(0, -GR, 0) * dt
      v = v * (1 - 0.02 * dt)
      local np = p + v * dt
      local g = math.max(ground(np.X, np.Z), 0)
      if np.Y <= g then
        local k = (p.Y - g) / math.max(p.Y - np.Y, 1e-3)
        local hit = p:Lerp(np, math.clamp(k, 0, 1))
        return V(hit.X, g, hit.Z)
      end
      p = np
    end
    return V(p.X, math.max(ground(p.X, p.Z), 0), p.Z)
  end
  G.bombImpact = bombImpact   -- 测试用

  local function stepBomb()
    local st = G.fly
    if not st or not st.pilot or st.crashed or st.ground or not st.wl then
      hideBomb()
      return
    end
    local wid = st.wl[st.wi]
    local w = wid and AD.W[wid]
    if not w or w.kind ~= "bomb" then
      -- 选的是炮：看看挂载里第一种是不是炸弹（F 打的是它）
      for _, wid2 in ipairs(st.wl) do
        local w2 = AD.W[wid2]
        if w2 and w2.kind ~= "gun" then w = w2 break end
      end
    end
    if not w or w.kind ~= "bomb" then
      hideBomb()
      return
    end
    local hit
    local locked = st.lock and st.lockT and st.lockT >= (w.lockTime or 1)
    if w.guided and locked then   -- 制导炸弹锁上了：标在目标上
      local em = st.lock.em
      local root = em and em.Parent and em:FindFirstChild("Root")
      local tp = root and root.CFrame.Position or st.lock.pos
      if tp then hit = V(tp.X, math.max(ground(tp.X, tp.Z), 0), tp.Z) end
    end
    if not hit then
      local cf = st.cf
      local p0 = (cf * CFrame.new(0, -(st.d.H or 4) * 0.35 - 1.5, 0)).Position
      hit = bombImpact(p0, (st.vel or V()) - cf.UpVector * 4)
    end
    local r = w.splash or 30
    placeRing(bombRing, hit, r)
    crossA.Size, crossB.Size = V(0.5, 0.5, r * 2.2), V(r * 2.2, 0.5, 0.5)
    crossA.CFrame, crossB.CFrame = CFrame.new(hit + V(0, 0.45, 0)), CFrame.new(hit + V(0, 0.45, 0))
    beam.CFrame = CFrame.new(hit + V(0, 80, 0))
    crossA.Parent, crossB.Parent, beam.Parent = folder, folder, folder
  end

  -- 扔出去的炸弹：每颗地上一个小圈，跟着算到落地
  local live = {}   -- [弹编号] = 圈
  local function stepDropped()
    local fs = G.flyingShots or {}
    for id, s in pairs(fs) do
      if s.gb and s.my and s.p and s.v then
        local r = live[id]
        if not r then
          r = ring(RGB(255, 150, 60), 0.6)
          live[id] = r
        end
        local aw = s.w and AD.W[s.w]
        placeRing(r, bombImpact(s.p, s.v), math.max(8, (aw and aw.splash or 30) * 0.45))
      end
    end
    for id, r in pairs(live) do
      if not fs[id] then
        r:Destroy()
        live[id] = nil
      end
    end
  end

  G.frameConn("Marks", function()
    G.try_(stepBomb)
    G.try_(stepDropped)
  end)
end

return Marks
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="94">
          <Properties>
            <string name="Name">Menu</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——主菜单：照用户给的第一张截图，比截图更精致、更简洁
--   进服先到这里（还没定阵营时），盖在选阵营界面上面：左上玩家名、军衔、经验条；左边一列大卡片（只有字：用户嫌卡片里放坦克、战斗机这些模型奇怪）——
--   进入战斗（→ 选阵营 / 部署）· 选择阵营 · 操作说明 · 模型与授权（Sketchfab 作者署名，CC-BY 要求的）；右下游戏名、测试版、版本号
--   部署界面右上角「菜单」能回来
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local Menu = {}

function Menu.init(G)
  local me = Players.LocalPlayer
  local Config = G.Config
  local RGB = Color3.fromRGB
  local V2 = Vector2.new
  local function T(k, ...) return G.T(k, ...) end
  local WHITE, TEXT, MUTE, FAINT = Color3.new(1, 1, 1), RGB(236, 238, 240), RGB(156, 162, 168), RGB(104, 110, 116)
  local Stage = require(script.Parent:WaitForChild("MenuStage"))   -- 背后的 3D 场景（废墟、火光、火星、全副武装的士兵）

  local gui = Instance.new("ScreenGui")
  gui.Name = "Menu"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 14   -- 盖在选阵营（12）上面
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local function frame(parent, size, pos, color, tr, anchor)
    local f = Instance.new("Frame")
    f.Size, f.Position = size, pos or UDim2.new()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = color or RGB(0, 0, 0), tr or 0, 0
    if anchor then f.AnchorPoint = anchor end
    f.Parent = parent
    return f
  end
  local function text(parent, str, size, pos, ts, color, font, anchor, xa)
    local l = Instance.new("TextLabel")
    l.Size, l.Position = size, pos or UDim2.new()
    l.BackgroundTransparency = 1
    l.Text, l.TextSize, l.TextColor3, l.Font = str or "", ts or 14, color or TEXT, font or Enum.Font.GothamMedium
    l.TextXAlignment = xa or Enum.TextXAlignment.Left
    l.TextTruncate = Enum.TextTruncate.AtEnd
    if anchor then l.AnchorPoint = anchor end
    l.Parent = parent
    return l
  end
  local function stroke(f, tr)
    local s = Instance.new("UIStroke")
    s.Color, s.Transparency, s.Thickness, s.ApplyStrokeMode = WHITE, tr or 0.88, 1, Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
  end

  -- 背景：近黑，左边压暗（原来右边还放一个大的原模型，和卡片里的模型一起去掉了）
  local bg = frame(gui, UDim2.fromScale(1, 1), nil, RGB(6, 8, 10), 0)   -- 后面的场景搭好了就透明（MenuStage.lua），没搭好照旧近黑
  -- 左边压暗（卡片、玩家名压在上面看得清）；后面的场景开着时浅一点，像参考图那样卡片后面还透出火光和废墟
  local shade = frame(bg, UDim2.fromScale(1, 1), nil, RGB(6, 8, 10), 0)
  do
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.42, 0.08), NumberSequenceKeypoint.new(0.62, 0.75), NumberSequenceKeypoint.new(1, 0.9) })
    g.Parent = shade
  end
  -- 上下暗角（电影感）
  local vignette = frame(bg, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 0)
  do
    local g = Instance.new("UIGradient")
    g.Rotation = 90
    g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(0.18, 0.85), NumberSequenceKeypoint.new(0.75, 0.9), NumberSequenceKeypoint.new(1, 0.25) })
    g.Parent = vignette
  end
  -- 内容按 1280 × 720 摆，按屏幕整体缩放（手机横屏也放得下）
  local content = frame(bg, UDim2.fromOffset(1280, 720), UDim2.fromScale(0.5, 0.5), RGB(0, 0, 0), 1, V2(0.5, 0.5))
  local scale = Instance.new("UIScale")
  scale.Parent = content
  local function fit()
    local vs = workspace.CurrentCamera.ViewportSize
    scale.Scale = math.clamp(math.min(vs.X / 1280, vs.Y / 720), 0.4, 1.3)
  end
  fit()
  workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

  -- 左上：玩家名、军衔、经验条
  local X0, CW = 48, 440
  local who = text(content, "", UDim2.fromOffset(CW, 26), UDim2.fromOffset(X0, 92), 22, WHITE, Enum.Font.GothamBold)
  local rankLine = text(content, "", UDim2.fromOffset(CW - 140, 14), UDim2.fromOffset(X0, 122), 11, MUTE, Enum.Font.GothamMedium)
  local xpLine = text(content, "", UDim2.fromOffset(160, 14), UDim2.fromOffset(X0 + CW, 122), 11, MUTE, Enum.Font.GothamMedium, V2(1, 0), Enum.TextXAlignment.Right)
  local xpBg = frame(content, UDim2.fromOffset(CW, 2), UDim2.fromOffset(X0, 142), WHITE, 0.85)
  local xpFill = frame(xpBg, UDim2.fromScale(0, 1), nil, WHITE, 0)

  -- 模型署名（「模型与授权」面板用）
  local META = {}
  for _, k in ipairs({ "ImportedMeta", "ImportedAir", "ImportedShip" }) do
    local ok, r = pcall(function() return require(RS:WaitForChild(k, 3)) end)
    if ok and type(r) == "table" then META[k] = r end
  end

  ---------------------------------------------------------------- 卡片

  local cards = {}
  local CH, GAP, Y0 = 104, 8, 160
  local function card(i, onClick)
    local b = Instance.new("TextButton")
    b.Name = "Card" .. i
    b.Size = UDim2.fromOffset(CW, CH)
    b.Position = UDim2.fromOffset(X0, Y0 + (i - 1) * (CH + GAP))
    b.BackgroundColor3 = RGB(10, 12, 14)
    b.BackgroundTransparency = 0.3
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Text = ""
    b.ClipsDescendants = true
    b.Parent = content
    local st = stroke(b, 0.88)
    local K = { b = b, st = st }
    K.cat = text(b, "", UDim2.fromOffset(260, 12), UDim2.fromOffset(20, 24), 10, MUTE, Enum.Font.GothamMedium)
    K.title = text(b, "", UDim2.fromOffset(300, 30), UDim2.fromOffset(19, 40), 24, WHITE, Enum.Font.GothamBold)
    K.sub = text(b, "", UDim2.fromOffset(300, 14), UDim2.fromOffset(20, 74), 10, MUTE, Enum.Font.GothamMedium)
    K.tag = text(b, "", UDim2.fromOffset(180, 16), UDim2.new(1, -18, 0, 36), 13, WHITE, Enum.Font.GothamBold, V2(1, 0), Enum.TextXAlignment.Right)
    K.subtag = text(b, "", UDim2.fromOffset(180, 12), UDim2.new(1, -18, 0, 56), 10, MUTE, Enum.Font.GothamMedium, V2(1, 0), Enum.TextXAlignment.Right)
    for _, l in ipairs({ K.tag, K.subtag, K.title }) do
      l.TextStrokeTransparency = 0.6
      l.TextStrokeColor3 = Color3.new(0, 0, 0)
    end
    b.MouseEnter:Connect(function() st.Transparency, b.BackgroundTransparency = 0.55, 0.2 end)
    b.MouseLeave:Connect(function() st.Transparency, b.BackgroundTransparency = 0.88, 0.3 end)
    b.Activated:Connect(onClick)
    cards[i] = K
    return K
  end

  -- 右边的说明面板（操作说明、模型与授权）
  local panel = frame(content, UDim2.fromOffset(560, 560), UDim2.fromOffset(1232, 92), RGB(8, 10, 12), 0.08, V2(1, 0))
  panel.Visible = false
  stroke(panel, 0.86)
  local pTitle = text(panel, "", UDim2.new(1, -120, 0, 24), UDim2.fromOffset(24, 20), 18, WHITE, Enum.Font.GothamBold)
  local pClose = Instance.new("TextButton")
  pClose.Size, pClose.Position, pClose.AnchorPoint = UDim2.fromOffset(80, 24), UDim2.new(1, -20, 0, 20), V2(1, 0)
  pClose.BackgroundTransparency = 1
  pClose.TextColor3, pClose.TextSize, pClose.Font = MUTE, 12, Enum.Font.GothamMedium
  pClose.TextXAlignment = Enum.TextXAlignment.Right
  pClose.Parent = panel
  frame(panel, UDim2.new(1, -48, 0, 1), UDim2.fromOffset(24, 56), WHITE, 0.88)
  local pScroll = Instance.new("ScrollingFrame")
  pScroll.Size = UDim2.new(1, -40, 1, -84)
  pScroll.Position = UDim2.fromOffset(24, 68)
  pScroll.BackgroundTransparency = 1
  pScroll.BorderSizePixel = 0
  pScroll.ScrollBarThickness = 2
  pScroll.ScrollBarImageColor3 = WHITE
  pScroll.CanvasSize = UDim2.new()
  pScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
  pScroll.Parent = panel
  local pBody = Instance.new("TextLabel")
  pBody.Size = UDim2.new(1, -12, 0, 0)
  pBody.AutomaticSize = Enum.AutomaticSize.Y
  pBody.BackgroundTransparency = 1
  pBody.TextWrapped = true
  pBody.RichText = true
  pBody.TextXAlignment = Enum.TextXAlignment.Left
  pBody.TextYAlignment = Enum.TextYAlignment.Top
  pBody.TextSize = 13
  pBody.LineHeight = 1.25
  pBody.TextColor3 = TEXT
  pBody.Font = Enum.Font.GothamMedium
  pBody.Parent = pScroll
  local panelKind = nil
  local function head(s) return '<font color="#FFFFFF" size="14"><b>' .. s .. "</b></font>" end
  local function showPanel(kind)
    if panelKind == kind and panel.Visible then panel.Visible = false panelKind = nil return end
    panelKind = kind
    panel.Visible = true
    pClose.Text = T("menu.close")
    if kind == "help" then
      pTitle.Text = T("menu.c3.title")
      local function plain(k) return (string.gsub(T(k), " · ", "\n")) end
      pBody.Text = head(T("menu.h.inf")) .. "\n" .. plain("ui.help") .. "\n\n" .. head(T("menu.h.veh")) .. "\n" .. plain("ui.vehHelp")
        .. "\n\n" .. head(T("menu.h.jet")) .. "\n" .. plain("air.helpJet") .. "\n\n" .. head(T("menu.h.heli")) .. "\n" .. plain("air.helpHeli")
    else
      pTitle.Text = T("menu.c4.title")
      local lines = {}
      for _, k in ipairs({ "ImportedMeta", "ImportedAir", "ImportedShip" }) do
        local m = META[k]
        if m and m.m then
          local keys = {}
          for key in pairs(m.m) do table.insert(keys, key) end
          table.sort(keys)
          for _, key in ipairs(keys) do
            local c = m.m[key].credit
            if c then table.insert(lines, (string.gsub(c, "（https?://[^）]*）", ""))) end
          end
        end
      end
      local okO, OM = pcall(function() return require(RS:WaitForChild("OpticsMeta", 3)) end)
      if okO and type(OM) == "table" then
        local keys = {}
        for key in pairs(OM) do table.insert(keys, key) end
        table.sort(keys)
        for _, key in ipairs(keys) do
          local c = OM[key].credit
          if c then table.insert(lines, (string.gsub(c, "%s*https?://%S+", ""))) end
        end
      end
      local okW, WMeta = pcall(function() return require(RS:WaitForChild("ImportedWpn", 3)) end)   -- 导弹合集（CC BY-NC-SA）
      if okW and type(WMeta) == "table" and WMeta.credit then table.insert(lines, (string.gsub(WMeta.credit, "（https?://[^）]*）", ""))) end
      pBody.Text = table.concat(lines, "\n\n")
    end
  end
  pClose.Activated:Connect(function() panel.Visible = false panelKind = nil end)

  local entered = false   -- 点过「进入战斗」：这次进服不再自动弹主菜单
  local stageOn, stageTeam = false, nil   -- 背后的场景开着没有、按哪一方搭的
  local function enter()
    entered = true
    G.menuOpenNow = false
    gui.Enabled = false
    panel.Visible = false
    if stageOn then stageOn = false Stage.show(false) end
    if G.refresh then G.refresh() end
  end
  -- 第一张卡「快速加入」（用户：没法快速进入战局）：点一下自动分队、默认装备，直接出生在离当前目标最近的出生点（Round.lua ACT.quickJoin）
  local function quick()
    enter()
    G.quickAt = os.clock()   -- 等服务器出生的这一会儿别弹选阵营界面（Faction.lua）
    G.R.Act:FireServer("quickJoin")
  end
  G.quickJoin = quick
  card(1, quick)
  card(2, function()
    enter()
    if G.showFaction then G.showFaction() end
  end)
  card(3, function() showPanel("help") end)
  card(4, function() showPanel("credits") end)
  -- 回车：快速加入
  UIS.InputBegan:Connect(function(io, gp)
    if gp or not gui.Enabled then return end
    if io.KeyCode == Enum.KeyCode.Return then quick() end
  end)

  -- 右下：游戏名、测试版、版本号
  local gTitle = text(content, "", UDim2.fromOffset(400, 24), UDim2.fromOffset(1232, 624), 20, WHITE, Enum.Font.GothamBold, V2(1, 0), Enum.TextXAlignment.Right)
  local gSub = text(content, "", UDim2.fromOffset(400, 14), UDim2.fromOffset(1232, 652), 11, MUTE, Enum.Font.GothamMedium, V2(1, 0), Enum.TextXAlignment.Right)
  local gVer = text(content, "", UDim2.fromOffset(400, 12), UDim2.fromOffset(1232, 668), 10, FAINT, Enum.Font.GothamMedium, V2(1, 0), Enum.TextXAlignment.Right)

  ---------------------------------------------------------------- 刷新

  function G.stepMenu(dt) if stageOn then Stage.step(dt) end end
  function G.refreshMenu(S)
    if not S then return end
    local show = (G.menuOpenNow == true) or ((not entered) and (not S.alive) and (not S.picked) and (S.progress or 1) >= 1)
    gui.Enabled = show
    -- 背后的场景：开着主菜单时镜头对着它，关了收起来、镜头还给游戏
    if show ~= stageOn then
      stageOn = show
      Stage.show(show, S.team or "atk")
    elseif show and stageTeam ~= (S.team or "atk") then
      Stage.show(true, S.team or "atk")
    end
    stageTeam = S.team or "atk"
    local live = Stage.active()
    bg.BackgroundTransparency = live and 1 or 0
    shade.BackgroundTransparency = live and 0.4 or 0
    if not show then return end
    local mine = S.me or {}
    who.Text = me.DisplayName
    local R = Config.Ranks or { 0 }
    local rk = math.clamp(mine.rank or 1, 1, #R)
    local xp = mine.xp or 0
    if rk < #R then
      rankLine.Text = T("menu.rankLine", G.Lang.rank(G.lang, rk), G.Lang.rank(G.lang, rk + 1))
      xpLine.Text = T("menu.xp", xp, R[rk + 1])
      xpFill.Size = UDim2.fromScale(math.clamp((xp - R[rk]) / math.max(1, R[rk + 1] - R[rk]), 0, 1), 1)
    else
      rankLine.Text = T("menu.maxRank", G.Lang.rank(G.lang, rk))
      xpLine.Text = tostring(xp)
      xpFill.Size = UDim2.fromScale(1, 1)
    end
    local team = S.team or "atk"
    for i, K in ipairs(cards) do
      K.cat.Text = T("menu.c" .. i .. ".cat")
      K.title.Text = T("menu.c" .. i .. ".title")
      K.sub.Text = T("menu.c" .. i .. ".sub")
      K.tag.Text, K.subtag.Text = "", ""
    end
    cards[1].tag.Text = T("menu.c1.tag")
    cards[1].subtag.Text = T("menu.c1.subtag", (S.rAtk or 0) + (S.rDef or 0))
    cards[2].tag.Text = S.picked and T("faction." .. team .. ".name") or T("menu.c2.none")
    cards[2].subtag.Text = (S.rAtk or 0) .. " : " .. (S.rDef or 0)
    gTitle.Text = T("game.title")
    gSub.Text = T("menu.beta")
    gVer.Text = tostring(Config.Version or "")
  end
  -- 部署界面右上角「菜单」
  function G.showMenu()
    G.menuOpenNow = true
    if G.S then G.refreshMenu(G.S) end
  end
  G.menuEnter = enter   -- 测试、截图用
  function G.menuShown() return gui.Enabled end
end

return Menu
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="95">
          <Properties>
            <string name="Name">MenuStage</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——主菜单背后的场景（用户给了《坠落》主菜单的截图：「初始界面用这种背景图改一下」）：
--   夜里废墟、暗红的火光、往上飘的火星和烟，一个全副武装的士兵（头盔、放下来的夜视仪、防弹插板背心、弹匣包，手里本阵营的枪）的低机位特写，
--   人在画面右边（左边是菜单卡片）。只在本机：零件搭在地图外很远的地方，主菜单开着时镜头对着它、慢慢呼吸似地晃，关了主菜单收起来、镜头还给游戏。
--   枪用服务器放在 ReplicatedStorage.ToolPreview 里的工具样子（导入了原模型就是原模型）；没有就用零件拼一支
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local Stage = {}

local RGB = Color3.fromRGB
local V = Vector3.new
local CF = CFrame.new
local ORIGIN = CF(9000, 900, -9000)   -- 地图外（地图在 ±3000 格以内）、半空里：周围什么都没有
local UNIFORM = { atk = { RGB(150, 128, 92), RGB(110, 96, 70) }, def = { RGB(84, 104, 70), RGB(64, 78, 54) } }   -- 同 Round.lua 的迷彩色
local HELMET = { atk = RGB(96, 104, 72), def = RGB(146, 128, 96) }
local GEAR = { atk = RGB(70, 76, 56), def = RGB(118, 104, 80) }   -- 背心、弹匣包
local DARK = RGB(26, 26, 28)

local model, built, team0 = nil, false, nil
local fireLights, emitters = {}, {}
local cam0 = nil   -- 进主菜单前镜头的类型和视角（关了主菜单还回去）
local t = 0

local function part(parent, name, size, cf, color, mat, shape)
  local p = Instance.new("Part")
  p.Name = name
  p.Size = size
  p.CFrame = cf
  p.Color = color
  p.Material = mat or Enum.Material.SmoothPlastic
  if shape then p.Shape = shape end
  p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
  p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
  p.Parent = parent
  return p
end
-- 从 a 到 b 的一截（手臂、腿）
local function limb(parent, name, a, b, w, color, mat)
  local d = (b - a).Magnitude
  return part(parent, name, V(w, w, d), CFrame.lookAt((a + b) / 2, b), color, mat)
end

-- 士兵（站在 at，面朝 -Z）；团队决定迷彩、头盔、背心颜色
local function soldier(parent, at, team)
  local U = UNIFORM[team] or UNIFORM.def
  local gear, helm = GEAR[team] or GEAR.def, HELMET[team] or HELMET.def
  local m = Instance.new("Model")
  m.Name = "Soldier"
  m.Parent = parent
  local function P(name, size, off, color, mat, shape) return part(m, name, size, at * off, color, mat, shape) end
  local function L(name, a, b, w, color, mat) return limb(m, name, (at * CF(a)).Position, (at * CF(b)).Position, w, color, mat) end
  -- 腿：左腿在前一点，右腿在后（站姿）；护膝、靴子
  for _, s in ipairs({ { -0.5, -0.25, 1 }, { 0.5, 0.35, -1 } }) do
    local x, z = s[1], s[2]
    L("Thigh", V(x, 2.95, 0), V(x * 1.05, 1.6, z * 0.6), 0.95, U[2], Enum.Material.Fabric)
    L("Shin", V(x * 1.05, 1.6, z * 0.6), V(x * 1.1, 0.45, z), 0.88, U[2], Enum.Material.Fabric)
    P("KneePad", V(0.72, 0.6, 0.3), CF(x * 1.05, 1.62, z * 0.6 - 0.48), DARK, Enum.Material.Plastic)
    P("Boot", V(0.98, 0.55, 1.3), CF(x * 1.1, 0.28, z - 0.2), RGB(36, 30, 26), Enum.Material.Leather)
  end
  -- 腰带、腿挂
  P("Belt", V(2.15, 0.42, 1.18), CF(0, 2.98, 0), DARK, Enum.Material.Fabric)
  P("DropPouch", V(0.5, 0.7, 0.45), CF(-1.05, 2.6, 0.15), gear, Enum.Material.Fabric)
  -- 上身、防弹插板背心、弹匣包、无线电
  P("Torso", V(2, 2.05, 1), CF(0, 4.15, 0), U[1], Enum.Material.Fabric)
  P("PlateFront", V(1.9, 1.55, 0.34), CF(0, 4.3, -0.62), gear, Enum.Material.Fabric)
  P("PlateBack", V(1.9, 1.6, 0.34), CF(0, 4.3, 0.62), gear, Enum.Material.Fabric)
  P("Cummerbund", V(2.12, 0.7, 1.3), CF(0, 3.62, 0), gear, Enum.Material.Fabric)
  for i = -1, 1 do
    P("MagPouch", V(0.46, 0.66, 0.3), CF(i * 0.52, 3.72, -0.86), gear:Lerp(Color3.new(0, 0, 0), 0.12), Enum.Material.Fabric)
    P("MagFlap", V(0.48, 0.12, 0.34), CF(i * 0.52, 4.08, -0.87), gear:Lerp(Color3.new(0, 0, 0), 0.22), Enum.Material.Fabric)
  end
  P("Radio", V(0.5, 0.9, 0.4), CF(-0.62, 4.3, 0.98), DARK, Enum.Material.Plastic)
  P("Antenna", V(0.06, 1.6, 0.06), CF(-0.75, 5.4, 1.05) * CFrame.Angles(math.rad(-8), 0, math.rad(6)), DARK, Enum.Material.Metal)
  for _, sx in ipairs({ -1, 1 }) do P("Strap", V(0.36, 0.25, 1.36), CF(sx * 0.62, 5.12, 0), gear, Enum.Material.Fabric) end
  -- 头：面罩、耳机、头盔、放下来的夜视仪
  P("Neck", V(0.62, 0.35, 0.62), CF(0, 5.3, 0), DARK, Enum.Material.Fabric)
  local head = P("Head", V(1.15, 1.15, 1.15), CF(0, 5.95, -0.05) * CFrame.Angles(0, math.rad(-12), 0), RGB(34, 34, 36), Enum.Material.Fabric)
  local hc = head.CFrame
  local function H(name, size, off, color, mat) return part(m, name, size, hc * off, color, mat) end
  local shell = H("Helmet", V(1.46, 0.92, 1.56), CF(0, 0.45, 0.04), helm, Enum.Material.Fabric)
  local sm = Instance.new("SpecialMesh")
  sm.MeshType = Enum.MeshType.Sphere
  sm.Parent = shell
  H("HelmetRim", V(1.5, 0.14, 1.6), CF(0, 0.1, 0.04), helm:Lerp(Color3.new(0, 0, 0), 0.3), Enum.Material.Fabric)
  for _, sx in ipairs({ -1, 1 }) do
    H("Rail", V(0.1, 0.18, 0.8), CF(sx * 0.74, 0.32, 0.05), DARK, Enum.Material.Metal)
    H("EarCup", V(0.26, 0.6, 0.5), CF(sx * 0.66, -0.02, 0.05), RGB(52, 56, 46), Enum.Material.Plastic)
  end
  H("NVGMount", V(0.36, 0.26, 0.18), CF(0, 0.42, -0.78), DARK, Enum.Material.Metal)
  H("NVGBody", V(0.66, 0.22, 0.24), CF(0, 0.12, -0.9), RGB(30, 32, 34), Enum.Material.Metal)
  for _, sx in ipairs({ -1, 1 }) do
    local tube = H("NVGTube", V(0.34, 0.26, 0.26), CF(sx * 0.2, 0.03, -1.04) * CFrame.Angles(0, math.rad(90), 0), RGB(24, 26, 28), Enum.Material.Metal, nil)
    tube.Shape = Enum.PartType.Cylinder
    local lens = H("NVGLens", V(0.04, 0.2, 0.2), CF(sx * 0.2, 0.03, -1.18) * CFrame.Angles(0, math.rad(90), 0), RGB(40, 120, 70), Enum.Material.Neon)
    lens.Shape = Enum.PartType.Cylinder
    lens.Transparency = 0.35
  end
  H("Strobe", V(0.22, 0.14, 0.14), CF(0, 0.55, 0.78), DARK, Enum.Material.Plastic)
  -- 手臂：右手握把、左手护木（低姿持枪）；肩、肘、手的位置先定，再拉两截
  local T = V(0, 4.15, 0)
  local hands = { R = T + V(0.45, -0.35, -0.9), L = T + V(-0.4, -0.78, -1.62) }   -- 低姿持枪：护木的左手比握把低，枪口朝前下
  for _, s in ipairs({ { "R", 1 }, { "L", -1 } }) do
    local sh = T + V(s[2] * 1.12, 0.78, 0)
    local hand = hands[s[1]]
    local elbow = (sh + hand) / 2 + V(s[2] * 0.42, -0.5, 0.2)
    L("UpperArm", sh, elbow, 0.86, U[1], Enum.Material.Fabric)
    L("Forearm", elbow, hand, 0.8, U[1], Enum.Material.Fabric)
    P("Glove", V(0.62, 0.62, 0.62), CF(hand), RGB(30, 30, 30), Enum.Material.Leather)
    P("ShoulderPad", V(0.95, 0.4, 1.05), CF(sh + V(0, 0.15, 0)), gear, Enum.Material.Fabric)
  end
  -- 枪：右手到左手的方向，枪口朝前下方
  local grip = at * CF(hands.R)
  local fore = (at * CF(hands.L)).Position
  local dir = (fore - grip.Position).Unit
  local gunCF = CFrame.lookAt(grip.Position, grip.Position + dir)
  local prev = RS:FindFirstChild("ToolPreview")
  local tool = nil
  if prev and prev:FindFirstChild(team) then
    for _, tl in ipairs(prev[team]:GetChildren()) do
      if tl:GetAttribute("Weapon") == "m4" then tool = tl end
    end
  end
  local placed = false
  if tool then
    local ok = pcall(function()
      local c = tool:Clone()
      local handle = c:FindFirstChild("Handle")
      if not handle then error("no handle") end
      local g = Instance.new("Model")
      g.Name = "Rifle"
      for _, x in ipairs(c:GetDescendants()) do
        if x:IsA("BasePart") then x.Anchored, x.CanCollide, x.CanQuery, x.CanTouch = true, false, false, false end
      end
      -- 握持：握点 × 工具 Grip 的逆 = 把手（Roblox 拿工具就是这么焊的）；游戏里的枪沿把手的 −Z 朝前，握点的 −Z 对着枪口方向
      local rel = {}
      for _, x in ipairs(c:GetDescendants()) do
        if x:IsA("BasePart") then rel[x] = handle.CFrame:ToObjectSpace(x.CFrame) end
      end
      local hcf = gunCF * c.Grip:Inverse()
      for x, r in pairs(rel) do x.CFrame = hcf * r end
      for _, x in ipairs(c:GetChildren()) do x.Parent = g end
      c:Destroy()
      g.Parent = m
    end)
    placed = ok
  end
  if not placed then   -- 零件拼一支卡宾枪
    local function G2(name, size, off, color, mat) return part(m, name, size, gunCF * off, color, mat) end
    G2("Receiver", V(0.22, 0.38, 1.3), CF(0, 0.12, -0.35), DARK, Enum.Material.Metal)
    G2("Handguard", V(0.24, 0.26, 1.15), CF(0, 0.16, -1.5), RGB(34, 34, 36), Enum.Material.Metal)
    G2("Barrel", V(0.08, 0.08, 0.7), CF(0, 0.16, -2.4), RGB(20, 20, 22), Enum.Material.Metal)
    G2("Stock", V(0.2, 0.36, 0.95), CF(0, 0.06, 0.65), DARK, Enum.Material.Plastic)
    G2("Mag", V(0.16, 0.6, 0.3), CF(0, -0.3, -0.62) * CFrame.Angles(math.rad(12), 0, 0), DARK, Enum.Material.Metal)
    G2("Optic", V(0.18, 0.2, 0.42), CF(0, 0.42, -0.45), RGB(16, 16, 18), Enum.Material.Metal)
    G2("Grip", V(0.18, 0.45, 0.24), CF(0, -0.18, 0.05) * CFrame.Angles(math.rad(-15), 0, 0), DARK, Enum.Material.Plastic)
  end
  return m
end

local function build(team)
  model = Instance.new("Model")
  model.Name = "MenuStage"
  local o = ORIGIN
  local function W(name, size, off, color, mat) return part(model, name, size, o * off, color, mat) end
  -- 地面、瓦砾（随机数固定种子：每次一样）
  W("Ground", V(90, 1, 90), CF(0, -0.5, 0), RGB(36, 32, 30), Enum.Material.Concrete)
  local rnd = Random.new(7)
  for i = 1, 46 do
    local s = rnd:NextNumber(0.4, 2.6)
    local x, z = rnd:NextNumber(-22, 22), rnd:NextNumber(-6, 24)
    if math.abs(x) > 2.4 or z > 3 then
      local c = (rnd:NextNumber() < 0.5) and RGB(58, 50, 44) or RGB(44, 40, 38)
      W("Rubble", V(s * rnd:NextNumber(0.6, 1.6), s * rnd:NextNumber(0.3, 0.8), s), CF(x, s * 0.2, z) * CFrame.Angles(rnd:NextNumber(-0.4, 0.4), rnd:NextNumber(0, 6.28), rnd:NextNumber(-0.4, 0.4)),
        c, (i % 3 == 0) and Enum.Material.Brick or Enum.Material.Concrete)
    end
  end
  -- 后面一堵烧过的残墙：窗洞里透出外面的火光；柱子、断梁
  -- （镜头朝 +Z 看：屏幕右边是 −X、左边是 +X）
  W("WallL", V(26, 22, 2), CF(-12, 10, 26), RGB(50, 40, 34), Enum.Material.Brick)
  W("WallR", V(26, 22, 2), CF(24, 10, 26), RGB(48, 38, 32), Enum.Material.Brick)
  W("WallTop", V(10, 8, 2), CF(6, 17, 26), RGB(46, 36, 30), Enum.Material.Brick)
  W("WallLow", V(10, 5, 2), CF(6, 2.5, 26), RGB(46, 36, 30), Enum.Material.Brick)
  local glow = W("WindowGlow", V(10, 8, 0.4), CF(6, 9, 29), RGB(255, 120, 40), Enum.Material.Neon)
  glow.Transparency = 0.55
  W("Pillar", V(2.4, 24, 2.4), CF(-5, 11, 16), RGB(40, 34, 30), Enum.Material.Concrete)
  W("Beam", V(16, 1.4, 1.4), CF(-9, 6, 20) * CFrame.Angles(0, -0.3, -0.45), RGB(30, 26, 24), Enum.Material.Wood)
  W("SideWall", V(2, 16, 30), CF(-24, 8, 12), RGB(42, 36, 32), Enum.Material.Brick)
  -- 左后方一辆烧毁的车
  local car = Instance.new("Model")
  car.Name = "Wreck"
  car.Parent = model
  local cc = o * CF(12, 0, 14) * CFrame.Angles(0, -0.5, 0)
  local function C(name, size, off, color, mat, shape)
    return part(car, name, size, cc * off, color, mat, shape)
  end
  C("Body", V(6, 2.2, 11), CF(0, 1.8, 0), RGB(30, 27, 25), Enum.Material.CorrodedMetal)
  C("Cab", V(5.6, 2, 5), CF(0, 3.9, 1.5), RGB(26, 24, 22), Enum.Material.CorrodedMetal)
  for _, w in ipairs({ { -3, -3.5 }, { 3, -3.5 }, { -3, 3.5 }, { 3, 3.5 } }) do
    C("Wheel", V(0.9, 2.4, 2.4), CF(w[1], 1.1, w[2]), RGB(18, 18, 18), Enum.Material.Rubber, Enum.PartType.Cylinder)
  end
  -- 士兵
  soldier(model, o * CF(0, 0, 0) * CFrame.Angles(0, math.rad(-24), 0), team)   -- 朝镜头、稍微侧向左边的菜单
  -- 火：右前方地上（画面外）一堆烧着的瓦砾照亮士兵；车里也有余火；后面窗洞外的火
  local function fire(at, heat, size, light)
    local f = W("Fire", V(2, 1, 2), at, RGB(40, 30, 24), Enum.Material.Slate)
    local fi = Instance.new("Fire")
    fi.Heat, fi.Size = heat, size
    fi.Color, fi.SecondaryColor = RGB(255, 120, 40), RGB(255, 210, 120)
    fi.Parent = f
    if light then
      local pl = Instance.new("PointLight")
      pl.Color, pl.Range, pl.Brightness, pl.Shadows = RGB(255, 130, 60), light, 2.4, true
      pl.Parent = f
      table.insert(fireLights, { l = pl, b = 2.4, seed = #fireLights * 1.7 })
    end
    return f
  end
  fire(CF(-6, 0.5, -4), 9, 6, 26)
  fire(CF(12, 2.4, 13), 6, 4, 16)
  fire(CF(6, 0.5, 33), 12, 10, 30)
  -- 冷色的轮廓光：左后方一点蓝灰，把人从暗背景里勾出来
  do
    local rim = W("Rim", V(1, 1, 1), CF(7, 8, 8), Color3.new(0, 0, 0))
    rim.Transparency = 1
    local pl = Instance.new("PointLight")
    pl.Color, pl.Range, pl.Brightness = RGB(130, 150, 200), 18, 0.7
    pl.Parent = rim
  end
  -- 火星：从火堆一带往上飘、随风往左；烟：大团、慢慢往上
  local src = W("Embers", V(26, 1, 20), CF(-2, 0.5, 6), Color3.new(0, 0, 0))
  src.Transparency = 1
  local em = Instance.new("ParticleEmitter")
  em.Texture = "rbxasset://textures/particles/sparkles_main.dds"
  em.Color = ColorSequence.new(RGB(255, 170, 70), RGB(255, 90, 30))
  em.LightEmission = 1
  em.LightInfluence = 0
  em.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.14), NumberSequenceKeypoint.new(1, 0.03) })
  em.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.8, 0.3), NumberSequenceKeypoint.new(1, 1) })
  em.Lifetime = NumberRange.new(3.5, 7)
  em.Rate = 26
  em.Speed = NumberRange.new(1.5, 4.5)
  em.SpreadAngle = Vector2.new(35, 35)
  em.Acceleration = V(1.2, 1.4, 0)   -- 往屏幕左边飘
  em.RotSpeed = NumberRange.new(-90, 90)
  em.EmissionDirection = Enum.NormalId.Top
  em.Parent = src
  table.insert(emitters, em)
  local sm = Instance.new("ParticleEmitter")
  sm.Texture = "rbxasset://textures/particles/smoke_main.dds"
  sm.Color = ColorSequence.new(RGB(70, 60, 56), RGB(30, 28, 28))
  sm.LightInfluence = 0.6
  sm.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 16) })
  sm.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.82), NumberSequenceKeypoint.new(1, 1) })
  sm.Lifetime = NumberRange.new(8, 13)
  sm.Rate = 2.5
  sm.Speed = NumberRange.new(0.6, 1.8)
  sm.SpreadAngle = Vector2.new(25, 25)
  sm.Acceleration = V(0.4, 0.5, 0)
  sm.RotSpeed = NumberRange.new(-12, 12)
  sm.EmissionDirection = Enum.NormalId.Top
  sm.Parent = src
  table.insert(emitters, sm)
  built, team0 = true, team
end

-- 镜头：低机位、离人十来格，人在画面右边（镜头朝 +Z 看，看向人的 +X 一侧 = 屏幕左边一点）
local function camCF(k)
  local o = ORIGIN
  local eye = (o * CF(2.2 + math.sin(k * 0.21) * 0.25, 3.1 + math.sin(k * 0.37) * 0.12, -11.5)).Position
  local look = (o * CF(2.7, 4.3, 0)).Position
  return CFrame.lookAt(eye, look)
end

-- 打开 / 关上（Menu.lua 调）
function Stage.show(on, team)
  local cam = workspace.CurrentCamera
  if on then
    if built and team0 ~= team and model then   -- 换了阵营：换身衣服、换枪
      model:Destroy()
      built, model, fireLights, emitters = false, nil, {}, {}
    end
    if not built then
      local ok, err = pcall(build, team or "def")
      if not ok then warn("[全面大战场] 主菜单背景没搭好：" .. tostring(err)) return end
    end
    model.Parent = workspace
    for _, e in ipairs(emitters) do e.Enabled = true end
    if not cam0 then cam0 = { type = cam.CameraType, fov = cam.FieldOfView } end
    cam.CameraType = Enum.CameraType.Scriptable
    cam.FieldOfView = 38
    cam.CFrame = camCF(t)
  else
    if model and model.Parent then
      for _, e in ipairs(emitters) do e.Enabled = false end
      model.Parent = nil
    end
    if cam0 then
      cam.CameraType = cam0.type == Enum.CameraType.Scriptable and Enum.CameraType.Custom or cam0.type
      cam.FieldOfView = cam0.fov
      cam0 = nil
    end
  end
end

function Stage.step(dt)
  if not (model and model.Parent) then return end
  t += dt
  workspace.CurrentCamera.CFrame = camCF(t)
  for _, f in ipairs(fireLights) do   -- 火光闪
    f.l.Brightness = f.b * (0.78 + 0.16 * math.sin(t * 9.3 + f.seed) + 0.1 * math.sin(t * 23.1 + f.seed * 2))
  end
end

function Stage.active() return model ~= nil and model.Parent ~= nil end

return Stage
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="96">
          <Properties>
            <string name="Name">MslCam</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——导弹视角小窗（用户：继续做导弹视角小窗）
--   自己开飞机打出去的导弹 / 制导炸弹：右上角开一个小窗，从弹上往目标看——导引头的画面：暗灰的底、目标白热、十字线、
--   目标多远、还剩几秒；导引头视场跟着距离缩（目标在画面里大小差不多，越近越大）
--   Roblox 的小窗（ViewportFrame）画不了地形和别的东西，只把目标的模型复制进去（一次，之后只挪小窗里的镜头）：
--   空中目标背后是天，地面 / 海上目标脚下铺一块暗灰的地；没有目标（没锁定就打的）就顺着弹飞的方向看那块地
--   弹没了：离目标 30 格以内写「命中」，不然「未命中」，停一秒多再关；同时只看最后发的那一枚
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local MslCam = {}

function MslCam.init(G)
  local AD = require(RS:WaitForChild("AirDefs"))
  local me = Players.LocalPlayer
  local pg = me:WaitForChild("PlayerGui")
  local V = Vector3.new
  local RGB = Color3.fromRGB
  local M_PER = AD.M or 2.8
  local function T(k, ...) return G.T(k, ...) end

  local gui = Instance.new("ScreenGui")
  gui.Name = "MslCam"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 8
  gui.Enabled = false
  gui.Parent = pg
  local box = Instance.new("Frame")
  box.Name = "Box"
  box.Size = UDim2.fromOffset(300, 196)
  box.AnchorPoint = Vector2.new(1, 0)
  box.Position = UDim2.new(1, -20, 0, 92)
  box.BackgroundColor3 = RGB(0, 0, 0)
  box.BackgroundTransparency = 0.35
  box.BorderSizePixel = 0
  box.Parent = gui
  local stroke = Instance.new("UIStroke")
  stroke.Color, stroke.Transparency, stroke.Thickness = RGB(150, 255, 170), 0.35, 1
  stroke.Parent = box
  local vpf = Instance.new("ViewportFrame")
  vpf.Name = "View"
  vpf.Size = UDim2.new(1, -8, 1, -30)
  vpf.Position = UDim2.fromOffset(4, 4)
  vpf.BackgroundColor3 = RGB(26, 28, 30)
  vpf.BorderSizePixel = 0
  vpf.Ambient = RGB(170, 170, 170)
  vpf.LightColor = RGB(255, 255, 255)
  vpf.LightDirection = V(-0.3, -1, -0.2)
  vpf.Parent = box
  local vcam = Instance.new("Camera")
  vcam.FieldOfView = 12
  vcam.Parent = vpf
  vpf.CurrentCamera = vcam
  local GREEN = RGB(150, 255, 170)
  local function line(size, pos)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.AnchorPoint = size, pos, Vector2.new(0.5, 0.5)
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = GREEN, 0.25, 0
    f.Parent = vpf
    return f
  end
  -- 十字线（中间留空）
  line(UDim2.fromOffset(26, 1), UDim2.new(0.5, -24, 0.5, 0))
  line(UDim2.fromOffset(26, 1), UDim2.new(0.5, 24, 0.5, 0))
  line(UDim2.fromOffset(1, 18), UDim2.new(0.5, 0, 0.5, -18))
  line(UDim2.fromOffset(1, 18), UDim2.new(0.5, 0, 0.5, 18))
  local function label(name, pos, anchor, align, size, color)
    local l = Instance.new("TextLabel")
    l.Name = name
    l.BackgroundTransparency = 1
    l.Size = UDim2.fromOffset(150, 18)
    l.Position, l.AnchorPoint = pos, anchor
    l.Font = Enum.Font.Code
    l.TextSize = size or 13
    l.TextColor3 = color or GREEN
    l.TextXAlignment = align
    l.TextStrokeTransparency = 0.6
    l.Text = ""
    l.Parent = box
    return l
  end
  local title = label("Title", UDim2.new(0, 8, 1, -4), Vector2.new(0, 1), Enum.TextXAlignment.Left)
  local info = label("Info", UDim2.new(1, -8, 1, -4), Vector2.new(1, 1), Enum.TextXAlignment.Right)
  local result = label("Result", UDim2.new(0.5, 0, 0.5, -14), Vector2.new(0.5, 0.5), Enum.TextXAlignment.Center, 22, RGB(255, 240, 200))
  result.Size = UDim2.fromOffset(280, 30)
  result.Font = Enum.Font.GothamBlack

  local cur = nil   -- { id, w, tgt = { em, anchor, cl0 }, clone, ground, t0, done, endAt }

  local function clearView()
    for _, c in ipairs(vpf:GetChildren()) do
      if not c:IsA("Camera") and not (c:IsA("Frame") and c.Name ~= "Model") then c:Destroy() end
    end
  end
  -- 目标的实体：服务器的模型（workspace.Ents 里 EntId 对得上的）；客户端画的那一份（View 的视图）拿来复制
  local function findTarget(tg)
    if not tg then return nil end
    local ents = workspace:FindFirstChild("Ents")
    for _, m in ipairs(ents and ents:GetChildren() or {}) do
      if m:GetAttribute("EntId") == tg then
        local v = G.views and G.views[m]
        local anchor = (v and v.anchor) or m:FindFirstChild("Root")
        return m, v and v.model, anchor
      end
    end
    return nil
  end
  -- 复制一份白热的：去掉贴图、特效、灯，零件刷成亮白（导引头的红外画面）
  local function thermalClone(src)
    local ok, cl = pcall(function() return src:Clone() end)
    if not ok or not cl then return nil end
    for _, d in ipairs(cl:GetDescendants()) do
      if d:IsA("BasePart") then
        if d:IsA("MeshPart") then pcall(function() d.TextureID = "" end) end
        d.Color = RGB(236, 236, 232)
        d.Material = Enum.Material.SmoothPlastic
      elseif d:IsA("SurfaceAppearance") or d:IsA("ParticleEmitter") or d:IsA("Beam") or d:IsA("Trail") or d:IsA("Light") or d:IsA("Decal")
        or d:IsA("BillboardGui") or d:IsA("SurfaceGui") or d:IsA("Sound") or d:IsA("Attachment") then
        d:Destroy()
      end
    end
    cl.Name = "Model"
    return cl
  end
  local function groundPlane(at)
    local p = Instance.new("Part")
    p.Name = "Ground"
    p.Anchored = true
    p.Size = V(6000, 1, 6000)
    p.CFrame = CFrame.new(at.X, math.max(G.Map.ground(at.X, at.Z), 0) - 0.5, at.Z)
    p.Color = RGB(54, 56, 58)
    p.Material = Enum.Material.SmoothPlastic
    p.Parent = vpf
    return p
  end

  function G.onMyShot(e)
    clearView()
    local aw = e.w and AD.W[e.w]
    cur = { id = e.id, w = e.w, t0 = os.clock() }
    title.Text = T("mcam.title", aw and T("aw." .. e.w) or "")
    result.Text = ""
    local em, src, anchor = findTarget(e.tg)
    if em and src and anchor then
      local cl = thermalClone(src)
      if cl then
        cl.Parent = vpf
        local lo, hi = nil, nil   -- 目标多大（各零件的包围盒）：导引头视场按它缩
        for _, d in ipairs(cl:GetDescendants()) do
          if d:IsA("BasePart") and d.Transparency < 1 then
            local c, h = d.Position, d.Size * 0.5
            lo = lo and V(math.min(lo.X, c.X - h.X), math.min(lo.Y, c.Y - h.Y), math.min(lo.Z, c.Z - h.Z)) or (c - h)
            hi = hi and V(math.max(hi.X, c.X + h.X), math.max(hi.Y, c.Y + h.Y), math.max(hi.Z, c.Z + h.Z)) or (c + h)
          end
        end
        cur.tgt = { em = em, anchor = anchor, cl0 = anchor.CFrame, size = math.max(lo and (hi - lo).Magnitude or 0, 8) }
        local p = anchor.Position
        if p.Y - math.max(G.Map.ground(p.X, p.Z), 0) < 40 then groundPlane(p) end   -- 地面、海上的目标：脚下一块地
      end
    end
    if not cur.tgt then groundPlane(e.p) end
    local L = G.hudLayout   -- 右上是小地图（Hud.lua）：镜头框放到它左边
    box.Position = (L and L.radarRight) and UDim2.new(1, -(L.radarX + L.radarSize + 12), 0, L.radarY) or UDim2.new(1, -20, 0, 92)
    gui.Enabled = true
  end

  function G.onShotEnd(id, s)
    if not cur or cur.id ~= id or cur.done then return end
    cur.done, cur.endAt = true, os.clock() + 1.3
    local hit = false
    local t = cur.tgt
    if t and t.anchor and t.anchor.Parent then hit = (t.anchor.Position - s.p).Magnitude < 30 end
    result.Text = T(hit and "mcam.hit" or "mcam.miss")
    result.TextColor3 = hit and RGB(255, 236, 170) or RGB(200, 210, 210)
  end
  G.mslCamState = function() return cur end   -- 测试用

  function G.stepMslCam()
    if not cur then return end
    if cur.done then
      if os.clock() >= cur.endAt then
        cur = nil
        gui.Enabled = false
        clearView()
      end
      return
    end
    local s = G.flyingShots and G.flyingShots[cur.id]
    if not s then return end
    local p = s.p
    local t = cur.tgt
    if t and t.anchor and t.anchor.Parent then
      local a = t.anchor.CFrame
      local tp = a.Position
      local dist = (tp - p).Magnitude
      -- 小窗里的目标一直摆在复制时的位置：把「弹看目标」换到那个位置上（目标转了、动了，镜头跟着相对地转）
      local camWorld = CFrame.lookAt(p, tp)
      vcam.CFrame = t.cl0 * a:Inverse() * camWorld
      vcam.FieldOfView = math.clamp(math.deg(2 * math.atan(t.size * 1.6 / math.max(dist, 1))), 2, 50)
      local close = (s.v and s.v.Magnitude or 0)
      info.Text = string.format("%.1f km  T-%.1f", dist / M_PER / 1000, dist / math.max(close, 1))
    else
      local fwd = (s.v and s.v.Magnitude > 1) and s.v.Unit or V(0, -1, 0)
      vcam.CFrame = CFrame.lookAt(p, p + fwd)
      vcam.FieldOfView = 30
      info.Text = T("mcam.noTgt")
    end
  end
end

return MslCam
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="97">
          <Properties>
            <string name="Name">Nade</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——手雷抛物线预览（用户：持枪、手雷一切这种，放开了做）
--   拿着手雷（武器 kind = "throw"）按住右键瞄：照服务器扔雷的算法（Weapons.lua KIND.throw：头顶上方出手、45° 抛向准星、最远 range，
--   弹道重力 = Gravity × 0.55，碰到东西弹一下、速度剩 35%）一步步算出去，画一串由白到橙的小点；第一次落地的地方一个小圈；
--   引信到点（fuse 秒）时手雷在哪就在哪画一个红圈（爆炸半径 splash），上面写着秒数。松开右键、换武器、上车就收起来
local Players = game:GetService("Players")

local Nade = {}

function Nade.init(G)
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local V, CF, RGB = Vector3.new, CFrame.new, Color3.fromRGB
  local W = G.Config.Weapons
  local N_DOT = 34

  local folder = Instance.new("Folder")
  folder.Name = "NadeArc"
  folder.Parent = workspace
  local function mk(shape, size, color, tr)
    local p = Instance.new("Part")
    p.Shape = shape
    p.Size = size
    p.Color = color
    p.Material = Enum.Material.Neon
    p.Transparency = tr
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Parent = folder
    return p
  end
  local dots = {}
  for i = 1, N_DOT do
    local k = (i - 1) / (N_DOT - 1)
    dots[i] = mk(Enum.PartType.Ball, V(0.32, 0.32, 0.32), RGB(255, 255, 255):Lerp(RGB(255, 150, 60), k), 1)
  end
  local bounceRing = mk(Enum.PartType.Cylinder, V(0.15, 3, 3), RGB(255, 236, 200), 1)
  local boomRing = mk(Enum.PartType.Cylinder, V(0.15, 28, 28), RGB(255, 70, 50), 1)
  local boomCore = mk(Enum.PartType.Cylinder, V(0.16, 2.4, 2.4), RGB(255, 90, 60), 1)
  local bb = Instance.new("BillboardGui")
  bb.Size = UDim2.fromOffset(80, 22)
  bb.StudsOffsetWorldSpace = V(0, 3, 0)
  bb.AlwaysOnTop = true
  bb.Enabled = false
  bb.Adornee = boomCore
  bb.Parent = boomCore
  local fuseL = Instance.new("TextLabel")
  fuseL.Size = UDim2.fromScale(1, 1)
  fuseL.BackgroundTransparency = 1
  fuseL.Font = Enum.Font.GothamBold
  fuseL.TextSize = 15
  fuseL.TextColor3 = RGB(255, 120, 90)
  fuseL.TextStrokeTransparency = 0.4
  fuseL.Parent = bb

  local function hide()
    for _, d in ipairs(dots) do d.Transparency = 1 end
    bounceRing.Transparency, boomRing.Transparency, boomCore.Transparency = 1, 1, 1
    bb.Enabled = false
  end

  local rp = RaycastParams.new()
  rp.FilterType = Enum.RaycastFilterType.Exclude
  G.nadeArc = { on = false }   -- 测试用：on、bounce（第一次落地点）、boom（引信到点的位置）

  G.frameConn("Nade", function()
    local id, aiming = nil, false
    if G.curWeapon then id, aiming = G.curWeapon() end
    local w = id and W[id]
    local ch = me.Character
    local head = ch and ch:FindFirstChild("Head")
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    local on = w ~= nil and w.kind == "throw" and aiming == true and head ~= nil and hum ~= nil and hum.Health > 0 and not G.drive
    G.nadeArc.on = on
    if not on then hide() return end
    -- 出手：跟服务器一样
    local aim = G.aimPoint and G.aimPoint(w.range or 90) or (cam.CFrame.Position + cam.CFrame.LookVector * 40)
    local m = head.Position + V(0, 0.5, 0)
    local flat = V(aim.X - m.X, 0, aim.Z - m.Z)
    local d = math.min(flat.Magnitude, w.range or 90)
    local dir = (flat.Magnitude > 0.1) and flat.Unit or V(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit
    local sp = math.clamp(math.sqrt(math.max(1, d) * workspace.Gravity * 0.55), 20, w.speed or 70)
    local vel = dir * sp * 0.7071 + V(0, sp * 0.7071, 0)
    local grav = V(0, -workspace.Gravity * 0.55, 0)
    rp.FilterDescendantsInstances = { ch, folder, G.fxFolder, G.viewFolder }
    local p = m
    local fuse = w.fuse or 2.8
    local dt = 1 / 30
    local steps = math.floor(fuse / dt + 0.5)
    local bounce, path = nil, {}
    for i = 1, steps do
      vel += grav * dt
      local step = vel * dt
      local res = workspace:Raycast(p, step, rp)
      if res then   -- 弹一下（照服务器）
        if not bounce then bounce = res.Position end
        p = res.Position + res.Normal * 0.6
        vel = (vel - 1.6 * vel:Dot(res.Normal) * res.Normal) * 0.35
      else
        p += step
      end
      path[i] = p
    end
    -- 小点：沿着路径均匀取
    for i, dpart in ipairs(dots) do
      local k = math.clamp(math.floor((i - 1) / (N_DOT - 1) * (#path - 1)) + 1, 1, #path)
      dpart.CFrame = CF(path[k])
      dpart.Transparency = 0.15 + 0.5 * (i / N_DOT)
    end
    local up = CFrame.Angles(0, 0, math.pi / 2)   -- 圆柱的轴转到竖直：平放在地上的圆片
    if bounce then
      bounceRing.CFrame = CF(bounce + V(0, 0.08, 0)) * up
      bounceRing.Transparency = 0.35
    else
      bounceRing.Transparency = 1
    end
    local last = path[#path] or m
    local r = (w.splash or 14) * 2
    boomRing.Size = V(0.15, r, r)
    boomRing.CFrame = CF(last + V(0, 0.1, 0)) * up
    boomRing.Transparency = 0.72
    boomCore.CFrame = CF(last + V(0, 0.12, 0)) * up
    boomCore.Transparency = 0.25
    fuseL.Text = string.format("%.1f s", fuse)
    bb.Enabled = true
    G.nadeArc.bounce, G.nadeArc.boom = bounce, last
  end)
end

return Nade
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="98">
          <Properties>
            <string name="Name">Night</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——夜视仪（客户端）：现在有昼夜更替（DayNight.lua），天黑了出生自动打开；步兵、飞行员按 N 开关夜视（手机右边一个小按钮）
--   开着：整个画面都是夜视（本地增亮、绿色荧光调色、灯光强烈泛光、雾变淡一点看得更远、画面轻微闪烁；用户：要全屏的夜视，不要望远镜那样四周一圈黑）；
--     队友头盔后面的红外频闪一闪一闪（只有夜视里看得见）；镜筒翻下来（服务器改焊接，别人也看得到）
--   坐进载具（车、飞机、直升机、船、炮位）照样开着（用户：进载具夜视不要取消）；地面载具里 N 是切车上瞄准镜的夜视 / 热成像（Drive.lua），
--     开着车上的瞄准镜看时夜视仪先让出画面（瞄准镜有自己的调色，叠在一起热成像会发绿、过亮），退出瞄准镜自动恢复；死了关掉
--   默认开着（用户：视野不管是在什么情况默认夜视仪都是开着的）：每次出生自动打开；按 N 关掉的话这一条命里关着，下次出生又是开的；车上瞄准镜默认也是夜视档
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Night = {}

function Night.init(G)
  local me = Players.LocalPlayer
  local RGB = Color3.fromRGB
  local on = false
  local fx = {}

  ---------------------------------------------------------------- 开关

  -- 夜视的画面效果加上 / 撤掉（开着夜视仪、但正在看车上的瞄准镜时撤掉，on 不变）
  local fxOn = false
  local function fxApply(want)
    if want == fxOn then return end
    fxOn = want
    if want then
      -- 增亮、环境光、大气变淡交给昼夜（DayNight.lua 每次更新时按 G.nvLight 加上去：白天开夜视只亮一点点）
      G.nvLight = true
      local cc = Instance.new("ColorCorrectionEffect")
      cc.Name = "NVGrade"
      cc.Saturation, cc.Contrast, cc.Brightness, cc.TintColor = -1, 0.32, 0.04, RGB(120, 255, 158)
      cc.Parent = Lighting
      local bl = Instance.new("BloomEffect")
      bl.Name = "NVBloom"
      bl.Intensity, bl.Size, bl.Threshold = 1.8, 30, 0.82
      bl.Parent = Lighting
      local blur = Instance.new("BlurEffect")
      blur.Name = "NVBlur"
      blur.Size = 1.5
      blur.Parent = Lighting
      fx = { cc, bl, blur }
    else
      for _, e in ipairs(fx) do e:Destroy() end
      fx = {}
      G.nvLight = false
      G.irStrobes(false)
    end
  end
  -- 正在看车上的瞄准镜（它有自己的昼光 / 夜视 / 热成像调色）：夜视仪先让出画面
  local function held() return G.sightCC ~= nil and G.sightCC.Enabled end

  local function setOn(v)
    if v == on then return end
    local hum = me.Character and me.Character:FindFirstChildOfClass("Humanoid")
    if v and not (hum and hum.Health > 0) then return end   -- 没出生（部署界面、主菜单）不开
    on = v
    pcall(function() G.R.Act:FireServer("nvg", on) end)
    fxApply(on and not held())
    if on and G.playSound then G.playSound("quiet", nil, 2.4) end
  end
  G.nvgOn = function() return on end
  G.setNvg = setOn

  ---------------------------------------------------------------- 提示：出生后、坐上飞机或船时夜视没开，屏幕下方淡入一行「按 N 开启夜视」，十秒后淡出（用户：提示一下按 N 开启夜视）

  local hintGui = Instance.new("ScreenGui")
  hintGui.Name = "NVHint"
  hintGui.ResetOnSpawn = false
  hintGui.IgnoreGuiInset = true
  hintGui.DisplayOrder = 3
  hintGui.Parent = me:WaitForChild("PlayerGui")
  local hint = Instance.new("TextLabel")
  hint.Name = "Hint"
  hint.AnchorPoint = Vector2.new(0.5, 1)
  hint.Position = UDim2.new(0.5, 0, 1, -168)
  hint.Size = UDim2.fromOffset(240, 30)
  hint.BackgroundColor3 = RGB(10, 12, 12)
  hint.BackgroundTransparency = 1
  hint.TextColor3 = RGB(186, 255, 196)
  hint.TextTransparency = 1
  hint.Font = Enum.Font.GothamMedium
  hint.TextSize = 15
  hint.Visible = false
  hint.Parent = hintGui
  local hc = Instance.new("UICorner")
  hc.CornerRadius = UDim.new(0, 4)
  hc.Parent = hint
  local hintUntil, hideAt = 0, nil
  local function showHint(sec)
    if on then return end
    local key = UIS.TouchEnabled and not UIS.KeyboardEnabled and "nvg.hintTouch" or "nvg.hint"
    hint.Text = (G.T and G.T(key)) or "按 N 开启夜视"
    hint.Visible = true
    hintUntil, hideAt = os.clock() + (sec or 10), nil
    TweenService:Create(hint, TweenInfo.new(0.4), { TextTransparency = 0, BackgroundTransparency = 0.45 }):Play()
  end
  local function hideHint()
    if not hint.Visible or hideAt then return end
    hintUntil, hideAt = 0, os.clock() + 0.5   -- 淡出半秒后收起
    TweenService:Create(hint, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 }):Play()
  end
  G.nvgHint = showHint
  local function onChar(ch)
    -- 出生自动打开夜视（等人物的 Humanoid 到了；最多等 10 秒）
    -- 服务器给人戴夜视仪（头盔上的 NVG）可能比 Humanoid 晚到：到了再把开着的状态发一遍，别人那边镜筒才翻得下来
    ch.ChildAdded:Connect(function(c)
      if c.Name == "NVG" and on and me.Character == ch then pcall(function() G.R.Act:FireServer("nvg", true) end) end
    end)
    task.spawn(function()
      local hum = ch:WaitForChild("Humanoid", 10)
      ch:WaitForChild("NVG", 3)
      for _ = 1, 40 do
        if not ch.Parent or not hum or hum.Health <= 0 then return end
        if me.Character == ch then
          -- 昼夜更替以后：天黑了才自动打开（白天出生不开）；白天开着的到天亮了不关，玩家自己按 N
          if G.isNight and not G.isNight() then break end
          setOn(true)
          if on then break end
        end
        task.wait(0.25)
      end
    end)
    task.delay(2.5, function()   -- 万一没开（自己按 N 关了）：出生、部署界面关掉以后再提示（只在天黑时）
      local hum = ch and ch.Parent and ch:FindFirstChildOfClass("Humanoid")
      if hum and hum.Health > 0 and not on and not (G.isNight and not G.isNight()) then showHint(10) end
    end)
  end
  me.CharacterAdded:Connect(onChar)
  if me.Character then onChar(me.Character) end
  local wasAir = false
  RunService.Heartbeat:Connect(function()
    if on then hideHint()
    elseif hintUntil ~= 0 and os.clock() > hintUntil then hideHint() end
    if hideAt and os.clock() > hideAt then hint.Visible, hideAt = false, nil end
    local air = (G.fly ~= nil) or (G.sail ~= nil)   -- 坐上飞机、船：夜视在那里也能开（地面载具里 N 是瞄准镜的，不提示）
    if air and not wasAir then showHint(8) end
    wasAir = air
  end)

  -- 队友（真人）头盔后面的红外频闪：夜视里每 0.8 秒闪一下（本地改透明度，别人那边不变）
  local irT = 0
  function G.irStrobes(show)
    local side = me:GetAttribute("Side")
    local blink = show and (os.clock() % 0.8) < 0.09
    for _, pl in ipairs(Players:GetPlayers()) do
      local ch = pl.Character
      local ir = ch and ch:FindFirstChild("IRStrobe")
      if ir then
        local mine = pl:GetAttribute("Side") == side
        local tr = (show and mine and blink) and 0 or 1
        if ir.Transparency ~= tr then ir.Transparency = tr end
      end
    end
  end

  function G.nvgToggle()
    if G.drive and not G.fly and not G.sail then return end   -- 地面载具里 N 是瞄准镜的夜视 / 热成像（开船、开飞机时 N 照样是夜视仪）
    local hum = me.Character and me.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    setOn(not on)
  end
  UIS.InputBegan:Connect(function(io, gp)
    if not gp and io.KeyCode == Enum.KeyCode.N then G.nvgToggle() end
  end)
  local vehicleTouch
  if UIS.TouchEnabled then   -- 步兵按键由 Play.lua 排版；飞行和航行继续用各自的夜视入口。
    vehicleTouch = G.ui.button(G.gui:WaitForChild("Hud"), "NV", UDim2.fromOffset(52, 44), UDim2.new(1, -78, 0, 140), RGB(24, 28, 30))
    vehicleTouch.Name = "VehicleNightVision"
    vehicleTouch.Visible = false
    vehicleTouch.BackgroundTransparency = 0.35
    vehicleTouch.TextSize = 14
    vehicleTouch.Activated:Connect(G.nvgToggle)
  end

  G.frameConn("Night", function(dt)
    if vehicleTouch then vehicleTouch.Visible = (G.fly ~= nil or G.sail ~= nil) and not (G.menuOpen and G.menuOpen()) end
    if not on then return end
    local hum = me.Character and me.Character:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then setOn(false) return end
    fxApply(not held())   -- 坐进载具照样开着；看车上的瞄准镜时让出画面，退出来再加上
    if not fxOn then return end
    local cc = fx[1]
    if cc then cc.Brightness = 0.04 + (math.random() - 0.5) * 0.018 end   -- 增像管的轻微闪烁
    -- 夜视一直开着（夜战）：画面卡（自动画质 G.perfK 降下来）先关那层全屏的轻模糊，泛光收小一点
    local blur, bl = fx[3], fx[2]
    local hi = (G.perfK or 1) >= 0.8
    if blur and blur.Enabled ~= hi then blur.Enabled = hi end
    if bl then
      local sz = hi and 30 or 18
      if bl.Size ~= sz then bl.Size = sz end
    end
    irT += dt
    if irT > 0.05 then
      irT = 0
      G.irStrobes(true)
    end
  end)

  ---------------------------------------------------------------- 地图上会动的灯（服务器摆的零件带 Anim 属性）：blink 每秒闪 Spd 下、spin 绕 Pivot 转（灯塔光柱，Spd 圈 / 秒）

  ---------------------------------------------------------------- 光晕分级（用户：游戏非常卡顿）
  -- 地图上每盏灯（跑道灯、舰灯、营地灯，World.light）带一个 BillboardGui 光晕，全图 600 多个、6000 格内都在画——
  --   一个光晕就是一组界面（两块圆角方块），几百个一起画很费。按离镜头的距离分级：450 格内全亮，1100 格内亮一半，
  --   2400 格内亮四分之一（按黄金分割挑，跑道灯照样连成线，只是稀一点），再远的关掉（霓虹灯块本身和泛光还在）；
  --   画面卡（G.perfK 低）距离一起缩；同时亮着的超过 GLOW_CAP 就再缩一点。闪烁的灯灭的那一下也关着（下面 anim 用 glowDark）
  local GLOW_CAP = 150
  local glows, glowSeen, glowDark, glowAllow = {}, {}, {}, {}   -- glowSeen[光晕] = 它的记录
  local glowScale, glowAcc = 1, 0
  local function addGlow(g)
    if glowSeen[g] or not g:IsA("BillboardGui") or g.Name ~= "Glow" then return end
    local p = g.Parent
    if not (p and p:IsA("BasePart")) then return end
    local i = #glows + 1
    glows[i] = { g = g, p = p, r = (i * 0.6180339887) % 1, on = g.Enabled }
    glowSeen[g] = glows[i]
  end
  local function stepGlows()
    local cam = workspace.CurrentCamera
    if not cam or #glows == 0 then return end
    local cp = cam.CFrame.Position
    local k = math.clamp(G.perfK or 1, 0.55, 1.2) / glowScale
    local d1, d2, d3 = 450 * k, 1100 * k, 2400 * k
    local n, j = 0, 0
    for idx = 1, #glows do
      local x = glows[idx]
      if x.g.Parent == x.p and x.p.Parent then
        j += 1
        glows[j] = x
        local dv = x.p.Position - cp
        local dd = dv:Dot(dv)
        local allow = dd < d1 * d1 or (dd < d2 * d2 and x.r < 0.5) or (dd < d3 * d3 and x.r < 0.25)
        glowAllow[x.g] = allow
        if allow then n += 1 end
        local want = allow and not glowDark[x.g]
        if x.on ~= want then
          x.on = want
          x.g.Enabled = want
        end
      else
        glowSeen[x.g], glowDark[x.g], glowAllow[x.g] = nil, nil, nil
      end
    end
    for idx = #glows, j + 1, -1 do glows[idx] = nil end
    if n > GLOW_CAP then glowScale = math.min(4, glowScale * 1.15)
    elseif n < GLOW_CAP * 0.6 and glowScale > 1 then glowScale = math.max(1, glowScale / 1.08) end
    G.glowLit = n   -- 性能面板、测试用
  end
  G.glowCount = function() return #glows end

  local anim = {}
  task.spawn(function()
    for _ = 1, 120 do
      local root = workspace:FindFirstChild("Map")
      if root and G.S and (G.S.progress or 0) >= 1 then
        task.wait(2)
        for _, p in ipairs(root:GetDescendants()) do
          if p:IsA("BasePart") then
            local a = p:GetAttribute("Anim")
            if a == "blink" or a == "spin" then
              table.insert(anim, { p = p, a = a, spd = p:GetAttribute("Spd") or 1, cf0 = p.CFrame, pivot = p:GetAttribute("Pivot"),
                glow = p:FindFirstChild("Glow"), light = p:FindFirstChildWhichIsA("Light") })
            end
          elseif p:IsA("BillboardGui") then
            addGlow(p)
          end
        end
        root.DescendantAdded:Connect(function(d)   -- 后来摆的（舰艇重建等）
          if d.Name == "Glow" then task.defer(addGlow, d) end
        end)
        stepGlows()
        return
      end
      task.wait(1)
    end
  end)
  G.frameConn("Glow", function(dt)
    glowAcc += dt or 1 / 60
    if glowAcc >= 0.25 then
      glowAcc = 0
      local ok, err = pcall(stepGlows)
      if not ok and G.showError then G.showError("光晕：" .. tostring(err)) end
    end
    if #anim == 0 then return end
    local t = os.clock()
    for _, x in ipairs(anim) do
      if x.p.Parent then
        if x.a == "blink" then
          local lit = ((t * x.spd) % 1) < 0.16
          if x.lit ~= lit then
            x.lit = lit
            x.p.Transparency = lit and 0 or 0.85
            if x.glow then
              glowDark[x.glow] = (not lit) or nil
              local want = lit and glowAllow[x.glow] ~= false
              x.glow.Enabled = want
              local gx = glowSeen[x.glow]
              if gx then gx.on = want end
            end
            if x.light then x.light.Enabled = lit end
          end
        elseif x.a == "spin" and typeof(x.pivot) == "Vector3" then
          local P = CFrame.new(x.pivot)
          local angle = (workspace:GetServerTimeNow() * x.spd) % 1
          x.p.CFrame = P * CFrame.Angles(0, -angle * math.pi * 2, 0) * (P:Inverse() * x.cf0)
        end
      end
    end
  end)
end

return Night
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="99">
          <Properties>
            <string name="Name">Operation</string>
            <ProtectedString name="Source"><![CDATA[-- 夜间登陆的阶段简报与据点反馈。由服务器快照驱动，补上中途入场的当前目标。
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")

local Operation = {}

local RGB = Color3.fromRGB
local INK = RGB(9, 18, 25)
local SLATE = RGB(28, 47, 61)
local WHITE = RGB(234, 243, 247)
local MUTE = RGB(157, 182, 195)
local TEAL = RGB(121, 220, 213)
local AMBER = RGB(255, 192, 122)
local CENTER_TOP = Vector2.new(0.5, 0)
local LEFT = Enum.TextXAlignment.Left
local RIGHT = Enum.TextXAlignment.Right
local HOLD = 4.8
local OPENING_HOLD = 5.8

function Operation.init(G)
  local ui, T, mobile = G.ui, G.T, G.mobile
  local player = Players.LocalPlayer
  local stages = G.Config.Stages or {}
  local capture = G.Config.Capture
  local pointById = {}
  for _, p in ipairs(G.Map.POINTS) do pointById[p.id] = p end

  local reducedMotion = false
  pcall(function()
    local function syncMotion() reducedMotion = GuiService.ReducedMotionEnabled end
    syncMotion()
    GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(syncMotion)
  end)

  local function panel(className, name)
    local f = Instance.new(className)
    f.Name = name
    f.AnchorPoint = CENTER_TOP
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = INK, 0.1, 0
    f.ZIndex, f.Visible = 24, false
    f.Parent = G.gui
    return f
  end

  local function label(parent, name, size, pos, fontSize, color, font, align)
    local l = ui.label(parent, "", size, pos, fontSize, color, font, nil, align)
    l.Name = name
    return l
  end

  local brief = panel("CanvasGroup", "OperationBrief")
  brief.BackgroundTransparency = 1
  local backing = ui.frame(brief, UDim2.fromScale(1, 1), nil, WHITE, 0.05)
  local shade = Instance.new("UIGradient")
  shade.Color = ColorSequence.new(INK, SLATE)
  shade.Rotation = -12
  shade.Parent = backing
  ui.stroke(backing, MUTE, 1, 0.74)
  local rail = ui.frame(brief, UDim2.new(1, 0, 0, 2), nil, TEAL, 0)
  local railFade = Instance.new("UIGradient")
  railFade.Transparency = NumberSequence.new(0, 0.8)
  railFade.Parent = rail

  local header = label(brief, "Chapter", UDim2.new(0.57, -16, 0, 14), nil, 11, TEAL, Enum.Font.GothamBold, LEFT)
  local sector = label(brief, "Sector", UDim2.new(0.43, -16, 0, 14), nil, 11, WHITE, Enum.Font.GothamMedium, RIGHT)
  local title = label(brief, "Title", UDim2.new(), nil, 30, WHITE, Enum.Font.GothamBlack, LEFT)
  for _, textLabel in ipairs({ header, sector, title }) do
    textLabel.TextWrapped = false
    textLabel.TextTruncate = Enum.TextTruncate.AtEnd
  end
  title.TextScaled = true
  local titleSize = Instance.new("UITextSizeConstraint")
  titleSize.MinTextSize = 14
  titleSize.Parent = title
  local description = label(brief, "Orders", UDim2.new(), nil, 14, WHITE, Enum.Font.GothamMedium, LEFT)
  description.TextYAlignment = Enum.TextYAlignment.Top
  description.TextScaled = true
  local orderSize = Instance.new("UITextSizeConstraint")
  orderSize.MinTextSize = 11
  orderSize.Parent = description
  local route = ui.frame(brief, UDim2.new(), nil, INK, 1)
  route.Name = "Route"
  local stops = {}
  for i, stage in ipairs(stages) do
    local width = 1 / #stages
    local stop = ui.frame(route, UDim2.new(width, -3, 1, 0), UDim2.new((i - 1) * width, 0, 0, 0), INK, 0.25)
    stop.Name = stage.id
    local edge = ui.frame(stop, UDim2.new(1, 0, 0, 1), UDim2.fromScale(0, 1), MUTE, 0.55, Vector2.new(0, 1))
    local text = label(stop, "Objectives", UDim2.fromScale(1, 1), nil, 11, WHITE, Enum.Font.GothamBold)
    text.TextWrapped = false
    stops[i] = { frame = stop, edge = edge, label = text, points = table.concat(stage.points, " · ") }
  end

  local localPanel = panel("Frame", "ObjectiveStatus")
  localPanel.BackgroundTransparency = 0.08
  ui.stroke(localPanel, MUTE, 1, 0.68)
  local objective = label(localPanel, "Objective", UDim2.new(1, -80, 0, 18), UDim2.fromOffset(12, 6), 14, WHITE, Enum.Font.GothamBold, LEFT)
  local percent = label(localPanel, "Progress", UDim2.fromOffset(56, 18), UDim2.new(1, -68, 0, 6), 14, WHITE, Enum.Font.GothamBold, RIGHT)
  local status = label(localPanel, "Status", UDim2.new(1, -24, 0, 26), UDim2.fromOffset(12, 23), 11, MUTE, Enum.Font.GothamMedium, LEFT)
  local track = ui.frame(localPanel, UDim2.new(1, -24, 0, 3), UDim2.new(0, 12, 1, -9), MUTE, 0.72)
  local fill = ui.frame(track, UDim2.fromScale(0, 1), nil, AMBER, 0)

  local shownRound, shownStage, shownTeam, startedAt, renderedLanguage
  local baseX, baseY, viewportW, viewportH, touchWidth, routeNames, canFit
  local redeployHint = false
  local lastPoint, meter = nil, 0

  local function resize(viewport)
    viewportW, viewportH = viewport.X, viewport.Y
    touchWidth = G.infantryTouchWidth
    local compact = mobile or viewportH < 500 or viewportW < 640
    local tiny = compact and viewportH < 360
    local hud = G.hudLayout
    local left, right = 16, 16
    local radarReserve = hud and (hud.radarX + hud.radarSize + 12) or 0
    if hud and hud.radarRight then right = radarReserve end
    if mobile then
      if hud and not hud.radarRight then left = radarReserve end
      if viewportW >= viewportH then right = touchWidth or 178 end
    end
    local width = math.max(1, math.min(viewportW - left - right, compact and 456 or 588))
    canFit = width >= 150
    routeNames = width >= 390
    local center = math.max(left + width / 2, math.min(viewportW / 2, viewportW - right - width / 2))
    baseX = center - viewportW / 2
    baseY = (hud and hud.scoreBottom or (mobile and 88 or 108)) + 7
    local inset = compact and 12 or 19
    local contentSize = UDim2.new(1, -inset * 2, 0, compact and 26 or 42)
    brief.Size = UDim2.fromOffset(width, tiny and 80 or (compact and 104 or 139))
    header.Position = UDim2.fromOffset(inset, compact and 7 or 11)
    sector.Position = UDim2.new(0.57, 4, 0, compact and 7 or 11)
    header.TextSize, sector.TextSize = compact and 10 or 11, compact and 10 or 11
    title.Size, title.Position = contentSize, UDim2.fromOffset(inset, compact and 19 or 23)
    titleSize.MaxTextSize = compact and 23 or 35
    description.Size = UDim2.new(1, -inset * 2, 0, compact and 34 or 38)
    description.Position = UDim2.fromOffset(inset, compact and 46 or 65)
    orderSize.MaxTextSize = compact and 12 or 15
    route.Visible = not tiny
    route.Size = UDim2.new(1, -inset * 2 + 3, 0, compact and 18 or 23)
    route.Position = UDim2.new(0, inset, 1, compact and -23 or -31)
    localPanel.Size = UDim2.fromOffset(math.min(width, 334), 58)
    localPanel.Position = UDim2.new(0.5, baseX, 0, baseY)
  end

  local function writeBrief(s, stage)
    local accent = s.team == "atk" and AMBER or TEAL
    local key = "stage." .. stage.id
    rail.BackgroundColor3, header.TextColor3 = accent, accent
    header.Text = s.stage == 1 and T("operation.opening") or T("faction." .. s.team .. ".name")
    sector.Text = T("hud.stageN", s.stage, s.stages or #stages)
    title.Text, description.Text = T(key), T(key .. "." .. s.team)
    for i, stop in ipairs(stops) do
      local current, complete = i == s.stage, i < s.stage
      stop.frame.BackgroundColor3 = current and accent or INK
      stop.frame.BackgroundTransparency = current and 0.05 or 0.2
      stop.edge.BackgroundColor3 = complete and accent or MUTE
      stop.edge.Visible = not current
      stop.label.TextColor3 = current and INK or (complete and accent or MUTE)
      stop.label.Text = routeNames and (stop.points .. "  ·  " .. T("stage." .. stages[i].id .. ".short")) or stop.points
    end
    renderedLanguage = G.lang
  end

  local function closestPoint(s)
    if G.fly or G.sail then return nil end
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local pos = root.CFrame.Position
    local closest, best = nil, capture.r ^ 2
    for _, state in ipairs(s.points or {}) do
      local p = pointById[state.id]
      if p and state.act and not state.locked and math.abs(p.y - pos.Y) < capture.height then
        local distance = (p.x - pos.X) ^ 2 + (p.z - pos.Z) ^ 2
        if distance < best then closest, best = state, distance end
      end
    end
    return closest
  end

  local function showCapture(s, p, dt)
    local progress = math.clamp(p.prog or 0, 0, 1)
    local key, color = "operation.inZone", MUTE
    if p.motion == 1 then
      key = s.team == "atk" and "operation.capturing" or "operation.losing"
      color = AMBER
    elseif p.motion == -1 then
      key, color = "operation.recovering", TEAL
    elseif (p.atk or 0) > 0 then
      key = "operation.stalled"
    end
    if reducedMotion or lastPoint ~= p.id then meter = progress end
    lastPoint = p.id
    meter += (progress - meter) * math.min(dt * 14, 1)
    fill.Size = UDim2.fromScale(meter, 1)
    fill.BackgroundColor3 = color
    localPanel.Visible = true
    status.Text, status.TextColor3 = T(key), color
    objective.Text = T("point." .. p.id)
    percent.Text = string.format("%d%%", math.floor(progress * 100 + 0.5))
  end

  G.operationHudVisible = function() return brief.Visible or localPanel.Visible end
  function G.stepOperation(dt)
    local s = G.S
    local canBrief = s and s.phase == "battle" and s.alive and s.team
      and not G.scopeOn and not G.fpsAiming and not (G.drive and (G.drive.sight or G.drive.eo))
      and not (G.boardShown and G.boardShown()) and not (G.menuOpen and G.menuOpen())
      and not (G.menuShown and G.menuShown()) and not G.factionOpen
      and not (G.tabletState and G.tabletState.open)
      and not (G.killcamOn and G.killcamOn())
    if not canBrief then
      brief.Visible, localPanel.Visible, lastPoint = false, false, nil
      if s and s.phase ~= "battle" then startedAt = nil end
      return
    end

    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize
    if not viewport or viewport.X < 1 or viewport.Y < 1 then return end
    local resized = viewport.X ~= viewportW or viewport.Y ~= viewportH or touchWidth ~= G.infantryTouchWidth
    if resized then resize(viewport) end

    local time = os.clock()
    local stage = stages[s.stage]
    if stage and (s.round ~= shownRound or s.stage ~= shownStage) then
      redeployHint = not mobile and shownRound == s.round and shownStage ~= nil and s.stage > shownStage
      shownRound, shownStage, shownTeam, startedAt = s.round, s.stage, s.team, time
      writeBrief(s, stage)
      if G.playSound then G.playSound("capture", nil, 0.65) end
    end

    local hold = s.stage == 1 and OPENING_HOLD or HOLD
    local age = startedAt and time - startedAt or hold
    brief.Visible = canFit and stage ~= nil and age < hold
    if brief.Visible then
      if resized or renderedLanguage ~= G.lang or shownTeam ~= s.team then
        shownTeam = s.team
        writeBrief(s, stage)
      end
      local reveal = reducedMotion and 1 or math.clamp(age / 0.36, 0, 1)
      local eased = 1 - (1 - reveal) ^ 3
      brief.Position = UDim2.new(0.5, baseX, 0, baseY + 9 * (1 - eased))
      brief.GroupTransparency = reducedMotion and 0 or math.clamp(math.max(1 - reveal, (age - hold + 0.42) / 0.42), 0, 1)
      rail.Size = UDim2.new(eased, 0, 0, 2)
    elseif redeployHint then
      redeployHint = false
      local distance = G.objDist()
      if distance and distance > 1200 then G.toast(T("hud.redeployTip"), "info") end
    end

    local p = canFit and not brief.Visible and closestPoint(s)
    if p then
      showCapture(s, p, dt)
    else
      localPanel.Visible, lastPoint = false, nil
    end
  end
end

return Operation
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="100">
          <Properties>
            <string name="Name">Optics</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——瞄准镜、望远镜的真模型（Sketchfab 上的原模型，几何和贴图原样）：给第一人称（FPSView）用
--   有导入的（Studio 里导入 models/optics/<键>.glb，Imports.lua 收进 ReplicatedStorage.Imported.Optics.<键>，带原来的 PBR 贴图）就用它；
--   没有就用 OpticMesh/<键> 里嵌的网格和底色贴图，开局在后台用 EditableMesh / EditableImage 生成（要在游戏设置 → 安全里打开 Mesh / Image API）；
--   两样都没有时 G.opticParts 返回 nil，FPSView 照旧用零件拼的
--   G.opticParts(键) → { { name 块名, part 复制出来的 MeshPart, c 块中心（器材坐标） }, … }；G.opticMeta = OpticsMeta（目镜、物镜的位置和半径）
local RS = game:GetService("ReplicatedStorage")
local Tint = require(script.Parent:WaitForChild("Tint"))   -- 导入的贴图没出来时的底色（原贴图的平均色）
local TURN = require(RS:WaitForChild("ImportTurn")).TURN   -- 导入的每块网格被 Roblox 转了半圈（ImportTurn.lua）

local Optics = {}

function Optics.init(G)
  local okM, META = pcall(function() return require(RS:WaitForChild("OpticsMeta", 5)) end)
  if not okM or type(META) ~= "table" then return end
  G.opticMeta = META
  local V = Vector3.new

  local B64 = {}
  do
    local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i = 1, 64 do B64[string.byte(chars, i)] = i - 1 end
  end
  local function unb64(s)
    local parts, chunk, cn = {}, {}, 0
    local pad = 0
    if string.sub(s, -1) == "=" then pad = (string.sub(s, -2, -2) == "=") and 2 or 1 end
    for i = 1, #s, 4 do
      local a, b, c, d = string.byte(s, i, i + 3)
      local x = B64[a] * 262144 + B64[b] * 4096 + (B64[c] or 0) * 64 + (B64[d] or 0)
      chunk[cn + 1] = math.floor(x / 65536) % 256
      chunk[cn + 2] = math.floor(x / 256) % 256
      chunk[cn + 3] = x % 256
      cn += 3
      if cn >= 3000 then
        parts[#parts + 1] = string.char(table.unpack(chunk, 1, cn))
        cn = 0
      end
    end
    if cn > 0 then parts[#parts + 1] = string.char(table.unpack(chunk, 1, cn)) end
    local out = table.concat(parts)
    if pad > 0 then out = string.sub(out, 1, #out - pad) end
    return out
  end

  local function quiet(p)
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    return p
  end

  -- 导入的：ReplicatedStorage.Imported.Optics.<键> 里 O_<键>__<块名>
  local function imported(key)
    local f = RS:FindFirstChild("Imported")
    f = f and f:FindFirstChild("Optics")
    f = f and f:FindFirstChild(key)
    if not f then return nil end
    local n = f:GetAttribute("N")   -- 块还没全复制过来：先当没导入（不然拿到缺块的枪）
    if n and #f:GetChildren() < n then return nil end
    local list = {}
    for name, info in pairs(META[key].parts) do
      local src = f:FindFirstChild("O_" .. key .. "__" .. name)
      if src and src:IsA("BasePart") then
        local c = V(info.c[1], info.c[2], info.c[3])
        table.insert(list, { name = name, src = src, c = c, cf = CFrame.new(c) * TURN })   -- 导入的：补回转掉的半圈
      end
    end
    return (#list > 0) and list or nil
  end

  -- 嵌在游戏里的：后台生成一次，之后复制
  local gen, busy, failed = {}, {}, {}
  local running = 0   -- 正在现生成的件数：一次只生成一件（几件一起生成，手机上那几秒会掉帧、看着像卡住）
  local function build(key)
    if gen[key] or busy[key] or failed[key] then return end
    busy[key] = true
    task.spawn(function()
      while running > 0 do task.wait(0.1) end
      running += 1
      local ok, err = pcall(function()
        local D = require(RS:WaitForChild("OpticMesh", 5):WaitForChild(key, 5))
        local AS = game:GetService("AssetService")
        local list = {}
        for name, d in pairs(D.parts) do
          local pos = unb64(d.pos) task.wait()   -- 大件解码一段让一帧
          local nrm = unb64(d.nrm) task.wait()
          local uv = unb64(d.uv) task.wait()
          local idx = unb64(d.idx) task.wait()
          local b, ub = d.b, d.ub
          local em = AS:CreateEditableMesh()
          local vid, nid, uid = table.create(d.n), table.create(d.n), table.create(d.n)
          for i = 0, d.n - 1 do
            local qx, qy, qz = string.unpack("<HHH", pos, i * 6 + 1)
            vid[i + 1] = em:AddVertex(V(b[1] + (b[4] - b[1]) * qx / 65535, b[2] + (b[5] - b[2]) * qy / 65535, b[3] + (b[6] - b[3]) * qz / 65535))
            local nx, ny, nz = string.unpack("<bbb", nrm, i * 3 + 1)
            nid[i + 1] = em:AddNormal(V(nx / 127, ny / 127, nz / 127))
            local u, w = string.unpack("<HH", uv, i * 4 + 1)
            uid[i + 1] = em:AddUV(Vector2.new(ub[1] + (ub[3] - ub[1]) * u / 65535, ub[2] + (ub[4] - ub[2]) * w / 65535))
            if i % 1500 == 1499 then task.wait() end   -- 一帧少做一点：在战斗里现生成也不掉帧
          end
          for t = 0, d.t - 1 do
            local a, b2, c = string.unpack("<HHH", idx, t * 6 + 1)
            local f = em:AddTriangle(vid[a + 1], vid[b2 + 1], vid[c + 1])
            em:SetFaceNormals(f, { nid[a + 1], nid[b2 + 1], nid[c + 1] })
            em:SetFaceUVs(f, { uid[a + 1], uid[b2 + 1], uid[c + 1] })
            if t % 1500 == 1499 then task.wait() end
          end
          local mp = quiet(AS:CreateMeshPartAsync(Content.fromObject(em)))
          mp.Name = "O_" .. key .. "__" .. name
          mp.Material = Enum.Material.SmoothPlastic
          mp.Color = Color3.fromRGB(d.col[1], d.col[2], d.col[3])
          if d.tex then   -- 调色板贴图 → EditableImage
            local pal, px = unb64(d.tex.pal), unb64(d.tex.px)
            local img = AS:CreateEditableImage({ Size = Vector2.new(d.tex.w, d.tex.h) })
            local n = d.tex.w * d.tex.h
            local buf = buffer.create(n * 4)
            for i = 0, n - 1 do
              local k = string.byte(px, i + 1)
              local r, g, bb = string.byte(pal, k * 3 + 1, k * 3 + 3)
              buffer.writeu8(buf, i * 4, r)
              buffer.writeu8(buf, i * 4 + 1, g)
              buffer.writeu8(buf, i * 4 + 2, bb)
              buffer.writeu8(buf, i * 4 + 3, 255)
              if i % 65536 == 65535 then task.wait() end
            end
            img:WritePixelsBuffer(Vector2.zero, Vector2.new(d.tex.w, d.tex.h), buf)
            mp.TextureContent = Content.fromObject(img)
            mp.Color = Color3.new(1, 1, 1)
          end
          local info = META[key].parts[name]
          local c = info and V(info.c[1], info.c[2], info.c[3]) or V()
          table.insert(list, { name = name, src = mp, c = c, cf = CFrame.new(c) })   -- 现生成的网格方向本来就对
          task.wait()
        end
        gen[key] = list
      end)
      running -= 1
      busy[key] = nil
      if not ok then
        failed[key] = true
        warn("[全面大战场] 瞄准镜模型 " .. key .. " 生成不了（用零件拼的代替；在 Studio 的游戏设置 → 安全里打开 Mesh / Image API，或者导入 models/optics/" .. key .. ".glb）：" .. tostring(err))
      end
    end)
  end

  -- 现生成失败了（没开 Mesh / Image API）：用的地方别一直等
  function G.opticFailed(key) return failed[key] == true end

  -- 有没有现成的（导入的或已经生成好的），不复制
  function G.opticReady(key)
    return META[key] ~= nil and (imported(key) ~= nil or gen[key] ~= nil)
  end

  function G.opticParts(key)
    if not META[key] or failed[key] then return nil end
    local list = imported(key) or gen[key]
    if not list then
      build(key)
      return nil
    end
    local out = {}
    for _, x in ipairs(list) do
      local ok, p = pcall(function() return x.src:Clone() end)
      if ok and p then
        quiet(p)
        if x.src:IsDescendantOf(RS) then Tint.fix(p, x.src) end
        table.insert(out, { name = x.name, part = p, c = x.c, cf = x.cf })
      end
    end
    if #out == 0 then
      -- 有模型却一块也复制不出来（导入的零件不能复制、现生成的网格不让复制）：记成失败，用零件拼的。
      --   原来 opticReady 一直说「好了」、这里一直给 nil，第一人称每一帧都重建一遍视图模型——切到火箭筒就卡住（用户：第一人称用枪切火箭炮会卡住）
      failed[key] = true
      warn("[全面大战场] 装备模型 " .. key .. " 复制不出来，用零件拼的代替")
      return nil
    end
    return out
  end

  -- 出生以后：背包里的装备有真模型的，后台一件一件先生成好（第一次切过去不用现生成，不卡那一下）
  local me = game:GetService("Players").LocalPlayer
  local function prewarm(char)
    task.delay(3, function()
      local bp = me:FindFirstChildOfClass("Backpack")
      local keys = {}
      for _, holder in ipairs({ bp, char }) do
        if holder then
          for _, t in ipairs(holder:GetChildren()) do
            if t:IsA("Tool") then
              for _, a in ipairs({ "Gear", "GearMount" }) do
                local k = t:GetAttribute(a)
                if type(k) == "string" and META[k] then keys[k] = true end
              end
            end
          end
        end
      end
      for k in pairs(keys) do
        if not imported(k) then build(k) end
        task.wait(0.5)
      end
    end)
  end
  me.CharacterAdded:Connect(prewarm)
  if me.Character then prewarm(me.Character) end

  -- 开局后台先生成第一人称已经在用的（狙击镜、望远镜；导入了就不用）；别的件（狙击枪、火箭筒等，还没接进第一人称）用到时才生成，免得手机内存白占
  task.delay(4, function()
    for _, key in ipairs({ "acog", "atacr", "binoc" }) do   -- 步枪的 ACOG 人人都用：最先生成
      if META[key] and not imported(key) then build(key) end
      task.wait(1)
    end
  end)
end

return Optics
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="101">
          <Properties>
            <string name="Name">Perf</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——性能面板（F7）与自动画质多管的几样（用户 11-19：游戏非常卡顿）
--   F7 开关：左边一块小面板，每半秒刷新——帧率（平均、这半秒里最慢的一帧）、自动画质档位 G.perfK、
--     客户端每个模块每帧用掉多少毫秒（init.client.lua 的逐帧步骤、各模块自己用 G.frameConn 连的逐帧回调）、
--     引擎的统计（Stats：实例、零件、会动的零件、物理每步、内存、网络收发，读得到的话还有渲染的 CPU / GPU 时间）、
--     载具这一帧摆了多少零件、地图光晕亮着几个——截图发过来就知道卡在哪
--   自动画质（Fx.lua 按帧率调 G.perfK）多管两样：地形草（perfK ≤ 0.62 关，回到 0.8 以上再开；夜视的模糊在 Night.lua 按 perfK 关）
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")

local Perf = {}

function Perf.init(G)
  local me = Players.LocalPlayer
  local okS, Stats = pcall(function() return game:GetService("Stats") end)
  if not okS then Stats = nil end
  local zh = G.lang == "zh"
  local function L(a, b) return zh and a or b end
  -- 模块名 → 面板上的名字
  local NAMES = {
    drive = L("开车", "drive"), fly = L("飞机", "fly"), sail = L("开船", "sail"), view = L("实体画面", "view"), play = L("步兵操作", "play"),
    fx = L("特效", "fx"), forts = L("工事", "forts"), gunner = L("炮位", "gunner"), ui = L("界面", "ui"), map = L("地图", "map"),
    operation = L("战役", "operation"), hud = L("战场界面", "hud"), scenery = L("景物", "scenery"), chute = L("伞", "chute"),
    tablet = L("平板", "tablet"), tacpad = L("战术平板", "tacpad"), menu = L("菜单", "menu"), coach = L("指导", "coach"),
    daynight = L("昼夜", "daynight"), airfx = L("机动云雾", "airfx"), mslcam = L("导弹小窗", "mslcam"),
  }

  local gui = Instance.new("ScreenGui")
  gui.Name = "PerfPanel"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 60
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")
  local box = Instance.new("TextLabel")
  box.Name = "Stats"
  box.Size = UDim2.fromOffset(360, 300)
  box.Position = UDim2.fromOffset(12, 140)
  box.BackgroundColor3 = Color3.new(0, 0, 0)
  box.BackgroundTransparency = 0.35
  box.BorderSizePixel = 0
  box.Font = Enum.Font.Code
  box.TextSize = 13
  box.TextColor3 = Color3.fromRGB(224, 232, 236)
  box.TextXAlignment = Enum.TextXAlignment.Left
  box.TextYAlignment = Enum.TextYAlignment.Top
  box.TextWrapped = true
  box.Text = ""
  box.Parent = gui
  local pad = Instance.new("UIPadding")
  pad.PaddingLeft, pad.PaddingTop, pad.PaddingRight = UDim.new(0, 8), UDim.new(0, 6), UDim.new(0, 8)
  pad.Parent = box
  G.perfPanel = gui   -- 测试用

  UIS.InputBegan:Connect(function(input, gp)
    if input.KeyCode == Enum.KeyCode.F7 and not UIS:GetFocusedTextBox() then
      gui.Enabled = not gui.Enabled
    end
  end)

  local function stat(k)
    if not Stats then return nil end
    local ok, v = pcall(function() return Stats[k] end)
    return (ok and type(v) == "number") and v or nil
  end
  local function f1(x) return string.format("%.1f", x) end

  -- 地形草：卡了先关它（大片会动的草叶很吃显卡），流畅了再开回来（服务器开着才开）
  local decoServer, decoOff = nil, false
  local function stepDeco()
    local T = workspace:FindFirstChildOfClass("Terrain")
    if not T then return end
    local k = G.perfK or 1
    if decoServer == nil then
      local ok, v = pcall(function() return T.Decoration end)
      if ok then decoServer = v end
    end
    if not decoServer then return end
    if not decoOff and k <= 0.62 then
      decoOff = pcall(function() T.Decoration = false end)
    elseif decoOff and k >= 0.8 then
      pcall(function() T.Decoration = true end)
      decoOff = false
    end
  end

  local frames, acc, worst, puts0 = 0, 0, 0, 0
  RunService.RenderStepped:Connect(function(dt)
    frames += 1
    acc += dt or 0
    if (dt or 0) > worst then worst = dt end
    if acc < 0.5 then return end
    local T, n, a, w = G.perfT or {}, frames, acc, worst
    G.perfT = {}
    frames, acc, worst = 0, 0, 0
    pcall(stepDeco)
    local puts = G.viewPuts or 0
    local dPuts = puts - puts0
    puts0 = puts
    if not gui.Enabled then return end
    local lines = {}
    lines[#lines + 1] = string.format(L("帧率 %d · 最慢一帧 %d 毫秒 · 自动画质 %.2f", "FPS %d · worst %d ms · quality %.2f"),
      math.floor(n / a + 0.5), math.floor(w * 1000 + 0.5), G.perfK or 1)
    -- 脚本：每帧毫秒，大的在前
    local rows, tot = {}, 0
    for k, v in pairs(T) do
      rows[#rows + 1] = { k = NAMES[k] or k, v = v / n * 1000 }
      tot += v / n * 1000
    end
    table.sort(rows, function(x, y) return x.v > y.v end)
    lines[#lines + 1] = string.format(L("脚本 %s 毫秒/帧：", "scripts %s ms/frame:"), f1(tot))
    local part = {}
    for i = 1, math.min(9, #rows) do
      part[#part + 1] = rows[i].k .. " " .. f1(rows[i].v)
      if #part == 3 then
        lines[#lines + 1] = "  " .. table.concat(part, " · ")
        part = {}
      end
    end
    if #part > 0 then lines[#lines + 1] = "  " .. table.concat(part, " · ") end
    -- 引擎
    local inst, prim, mov, cont = stat("InstanceCount"), stat("PrimitivesCount"), stat("MovingPrimitivesCount"), stat("ContactsCount")
    if inst then
      lines[#lines + 1] = string.format(L("实例 %d · 零件 %d · 会动的 %d · 接触 %d", "instances %d · parts %d · moving %d · contacts %d"),
        inst, prim or 0, mov or 0, cont or 0)
    end
    local phys, hb = stat("PhysicsStepTimeMs"), stat("HeartbeatTimeMs")
    local mem = nil
    if Stats then
      local ok, v = pcall(function() return Stats:GetTotalMemoryUsageMb() end)
      if ok then mem = v end
    end
    if phys or mem then
      lines[#lines + 1] = string.format(L("物理 %s 毫秒 · 心跳 %s 毫秒 · 内存 %d MB", "physics %s ms · heartbeat %s ms · memory %d MB"),
        f1(phys or 0), f1(hb or 0), math.floor(mem or 0))
    end
    local rx, tx = stat("DataReceiveKbps"), stat("DataSendKbps")
    if rx then lines[#lines + 1] = string.format(L("网络 收 %s KB/s · 发 %s KB/s", "network in %s KB/s · out %s KB/s"), f1(rx), f1(tx or 0)) end
    local rc, rg = stat("RenderCPUFrameTime"), stat("RenderGPUFrameTime")
    if rc or rg then
      local function ms(x) return f1((x or 0) < 1 and (x or 0) * 1000 or (x or 0)) end
      lines[#lines + 1] = string.format(L("渲染 CPU %s 毫秒 · GPU %s 毫秒", "render CPU %s ms · GPU %s ms"), ms(rc), ms(rg))
    end
    -- 本游戏自己的
    lines[#lines + 1] = string.format(L("载具摆零件 %d/帧 · 光晕亮着 %d/%d · 地形草 %s", "vehicle parts moved %d/frame · glows %d/%d · grass %s"),
      math.floor(dPuts / n + 0.5), G.glowLit or 0, G.glowCount and G.glowCount() or 0, decoOff and L("关", "off") or L("开", "on"))
    lines[#lines + 1] = L("F7 关掉这个面板", "F7 hides this panel")
    box.Text = table.concat(lines, "\n")
    box.Size = UDim2.fromOffset(360, 18 + #lines * 16)
  end)
end

return Perf
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="102">
          <Properties>
            <string name="Name">Play</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——操作：武器栏（1–4、点选）、第一人称（默认；镜头前的枪和方块手臂在 FPSView，V 切到第三人称的肩后视角）、
--   开火（连发 / 单发）、右键瞄准（狙击镜）、R 换弹、各种装备（火箭筒、防空导弹右键锁定、手雷、迫击炮、急救包、扳手按住修车、
--   炸药包左键放右键引爆、破障器材按住排雷剪铁丝网、望远镜左键标记 F 呼叫炮击）、命中标记、弹药显示；手机上屏幕按钮
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")

local Play = {}

function Play.init(G)
  local Config = G.Config
  local W = Config.Weapons
  local player = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local V = Vector3.new
  local RGB = Color3.fromRGB
  local ui = G.ui
  local T = G.T
  local now = os.clock
  local RShoot, RAct = G.R.Shoot, G.R.Act
  G.mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled

  ---------------------------------------------------------------- 界面：武器栏、准星、弹药、命中标记

  local hud = G.gui:WaitForChild("Hud")
  local bar = ui.frame(hud, UDim2.fromOffset(560, 32), UDim2.new(0.5, 0, 1, -50), RGB(0, 0, 0), 1, Vector2.new(0.5, 0))
  local barList = Instance.new("UIListLayout")
  barList.FillDirection = Enum.FillDirection.Horizontal
  barList.HorizontalAlignment = Enum.HorizontalAlignment.Center
  barList.Padding = UDim.new(0, 4)
  barList.Parent = bar
  local slots = {}
  -- 准星：四条细线 + 中间一点，张开多少照这一发的散布（Config.gunSpread：跑起来、跳起来、连射都会张开，停下很快收回；开枪那一下弹一下）
  --   （原来是一个「+」字，看不出现在准不准）
  local cross = Instance.new("Frame")
  cross.Name = "Crosshair"
  cross.AnchorPoint = Vector2.new(0.5, 0.5)
  cross.Position = UDim2.fromScale(0.5, 0.5)
  cross.Size = UDim2.fromOffset(120, 120)
  cross.BackgroundTransparency = 1
  cross.Visible = false
  cross.ZIndex = 15
  cross.Parent = G.gui
  local crossBars = {}
  for i = 1, 5 do
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.BorderSizePixel = 0
    f.BackgroundColor3 = Color3.new(1, 1, 1)
    f.BackgroundTransparency = (i == 5) and 0.15 or 0.12
    f.Size = (i == 5) and UDim2.fromOffset(2, 2) or ((i <= 2) and UDim2.fromOffset(2, 9) or UDim2.fromOffset(9, 2))
    f.Position = UDim2.fromScale(0.5, 0.5)
    f.ZIndex = 15
    local st = Instance.new("UIStroke")   -- 一圈淡黑边：亮的地方也看得清
    st.Color, st.Transparency, st.Thickness = Color3.new(0, 0, 0), 0.55, 1
    st.Parent = f
    f.Parent = cross
    crossBars[i] = f
  end
  local crossGap, crossPop = 8, 0
  local hitX = ui.label(G.gui, "✕", UDim2.fromOffset(34, 34), UDim2.fromScale(0.5, 0.5), 28, Color3.new(1, 1, 1), Enum.Font.GothamBold, Vector2.new(0.5, 0.5))
  hitX.TextTransparency = 1
  hitX.ZIndex = 16
  local hitT = 0
  local ammoText = ui.label(hud, "", UDim2.fromOffset(320, 26), UDim2.new(1, -260, 1, -90), 18, Color3.new(1, 1, 1), Enum.Font.GothamBold, Vector2.new(1, 0), Enum.TextXAlignment.Right)
  ammoText.TextStrokeTransparency = 0.4
  G.ammoLabel = ammoText   -- Hud.lua 换成右下角的武器、弹药（这一行字收起来）
  local tipText = ui.label(G.gui, "", UDim2.fromOffset(300, 22), UDim2.new(0.5, 0, 0.5, 30), 14, RGB(255, 230, 140), Enum.Font.GothamBold, Vector2.new(0.5, 0))
  tipText.TextStrokeTransparency = 0.4
  tipText.ZIndex = 15
  local scope = { Visible = false }   -- 狙击镜、望远镜开镜：圆形目镜和光学效果在 Scope.lua（这里只记开没开）

  -- 命中提示：kind 是 hit / head、打死的 kill / headkill（小兵）、pkill / headpkill（真人）、vkill（车船）、fkill（工事）
  --   打死的红叉、爆头金色（爆头打死橙红），打死的叉先放大再缩回去；加分、连杀在 Juice.lua
  function G.hitMarker(kind)
    local kill = string.find(kind, "kill") ~= nil
    local head = string.find(kind, "head") ~= nil
    hitX.Position = G.hitMarkerAt or UDim2.fromScale(0.5, 0.5)   -- 开飞机时标在炮口指的地方（Fly.lua 每帧设），不然在屏幕中间
    hitX.TextColor3 = (kill and head and RGB(255, 150, 40)) or (kill and RGB(255, 70, 60)) or (head and RGB(255, 220, 80)) or Color3.new(1, 1, 1)
    hitX.TextTransparency = 0
    hitX.TextSize = kill and 44 or (head and 34 or 28)
    hitT = now()
    if G.playSound then G.playSound(kill and "killding" or "hit") end
    if G.onHitMarker then G.onHitMarker(kill and "kill" or kind) end
    if G.juiceHit then G.juiceHit(kind) end
  end

  ---------------------------------------------------------------- 武器栏

  local cur = { tool = nil, id = nil, nextShot = 0, firing = false, aiming = false, lockT = 0, lockId = nil }
  local bloomOf = {}   -- [枪] = { v 连射攒下的散布（度）, t 上一发 }：和服务器 Weapons.lua 一样算，准星照它张开
  local ammo = {}
  function G.refillAmmo() ammo = {} end   -- 补给箱（战术平板）：下次取弹药时按满弹匣、满备弹重新算
  local function ammoOf(id)
    local w = W[id]
    local a = ammo[id]
    if not a then
      a = { n = w.mag or 1, res = w.reserve, r = 0 }
      ammo[id] = a
    end
    if a.r > 0 and now() >= a.r then
      local need = (w.mag or 1) - a.n
      if a.res then
        local k = math.min(need, a.res)
        a.n += k
        a.res -= k
      else
        a.n += need
      end
      a.r = 0
    end
    return a
  end
  -- 现在拿着哪件、弹药（Hud.lua 画右下角）
  function G.weaponNow()
    if not cur.id or not W[cur.id] then return nil end
    return cur.id, ammoOf(cur.id)
  end
  local function reload()
    local id = cur.id
    if not id then return end
    local w = W[id]
    local a = ammoOf(id)
    if a.r > 0 or a.n >= (w.mag or 1) or (a.res and a.res <= 0) or (w.reload or 0) <= 0 then return end
    a.r = now() + w.reload
    RAct:FireServer("reload", id)
    if G.fpsReload then G.fpsReload(id, w.reload, a.n <= 0) end   -- 第一人称：播换弹（打空了是空仓换弹）
  end

  -- 身上的装备，按装备栏格子的顺序排成 1、2、3……（用户：第一人称持枪的时候无法切换枪——原来按格子号，默认不带发射器，
  --   第 2 格是空的，按 2 没反应；现在第几把就按几）
  local function tools()
    local bySlot = {}
    local bp = player:FindFirstChildOfClass("Backpack")
    for _, holder in ipairs({ bp, player.Character }) do
      if holder then
        for _, t in ipairs(holder:GetChildren()) do
          if t:IsA("Tool") and t:GetAttribute("Slot") then table.insert(bySlot, t) end
        end
      end
    end
    table.sort(bySlot, function(a, b) return a:GetAttribute("Slot") < b:GetAttribute("Slot") end)
    return bySlot
  end
  local lastTool = nil   -- 上一把（Q 切回去）
  local function equipTool(t)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or G.drive or not t then return end
    if t.Parent == char then return end   -- 已经拿着
    local cur0 = char:FindFirstChildOfClass("Tool")
    if cur0 then lastTool = cur0 end
    hum:EquipTool(t)
  end
  -- 按数字键拿第几件：已经拿着就不动（原来是收起来、变成空手——用户：切到 2 号武器就卡住，多半是连按 / 按住时收起来了）；
  --   0.15 秒内只认一次（键盘连发、和别的界面同时收到按键）
  local lastEquipT = 0
  local function equip(i)
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 or G.drive then return end
    local t = tools()[i]
    if not t or t.Parent == char then return end
    local now = os.clock()
    if now - lastEquipT < 0.15 then return end
    lastEquipT = now
    equipTool(t)
  end
  -- 滚轮 / 手柄：换下一把、上一把（d = 1 / −1）
  local function cycle(d)
    local list = tools()
    if #list == 0 then return end
    local char = player.Character
    local i0 = 0
    for i, t in ipairs(list) do if t.Parent == char then i0 = i end end
    local j = (i0 == 0) and ((d > 0) and 1 or #list) or ((i0 - 1 + d) % #list + 1)
    equipTool(list[j])
  end
  G.equipSlot = equip
  G.equipCycle = cycle
  G.equipTool = equipTool
  -- 换回上一把（平板界面收起时：TacPad.lua）；没有上一把就拿第一件
  G.equipLast = function()
    if lastTool and lastTool.Parent and lastTool.Parent ~= player.Character then equipTool(lastTool) else equip(1) end
  end

  local function drawBar()
    for _, s in ipairs(slots) do s:Destroy() end
    slots = {}
    for i, t in ipairs(tools()) do
      local id = t:GetAttribute("Weapon")
      local on = t.Parent == player.Character
      -- 细线、半透明、直角（用户：界面要精致简洁，不要卡通）；拿在手里的那格顶上一道白线
      local b = Instance.new("TextButton")
      b.Size = UDim2.fromOffset(124, 32)
      b.BackgroundColor3 = RGB(8, 10, 12)
      b.BackgroundTransparency = on and 0.3 or 0.6
      b.BorderSizePixel = 0
      b.AutoButtonColor = false
      b.Text = i .. "   " .. T("weapon." .. id)
      b.TextSize = 13
      b.Font = on and Enum.Font.GothamBold or Enum.Font.GothamMedium
      b.TextColor3 = on and RGB(255, 255, 255) or RGB(150, 156, 160)
      b.Parent = bar
      if on then ui.frame(b, UDim2.new(1, 0, 0, 2), nil, RGB(255, 255, 255), 0) end
      b.LayoutOrder = i
      b.Activated:Connect(function() equip(i) end)
      table.insert(slots, b)
    end
  end

  local function onChar(char)
    ammo = {}
    cur.tool, cur.id = nil, nil
    char.ChildAdded:Connect(function(c)
      if c:IsA("Tool") and c:GetAttribute("Weapon") then
        cur.tool, cur.id = c, c:GetAttribute("Weapon")
        cur.lockT, cur.lockId = 0, nil
        drawBar()
      end
    end)
    char.ChildRemoved:Connect(function(c)
      if c == cur.tool then
        cur.tool, cur.id, cur.firing, cur.aiming = nil, nil, false, false
        drawBar()
      end
    end)
    task.delay(0.6, drawBar)
    local bp = player:WaitForChild("Backpack", 5)
    if bp then
      bp.ChildAdded:Connect(function() task.defer(drawBar) end)
    end
    task.delay(0.8, function() if char.Parent and not cur.tool then equip(1) end end)   -- 出生拿第一把
  end
  player.CharacterAdded:Connect(onChar)
  if player.Character then onChar(player.Character) end

  ---------------------------------------------------------------- 瞄准

  local rayP = RaycastParams.new()
  rayP.FilterType = Enum.RaycastFilterType.Exclude
  -- 屏幕中间（准星）对着的点；ground 只要地面（迫击炮、放东西）
  local function aimPoint(range, ground)
    local vp = cam.ViewportSize
    local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
    -- 实体（小兵、车、船、工事）不打服务器的隐形命中盒，按画面上看得见的位置算（View.lua G.viewRay；服务器按你看到的那一刻判定，Rewind.lua）
    rayP.FilterDescendantsInstances = { player.Character, G.fxFolder, G.viewFolder, workspace:FindFirstChild("Ents") }
    local len = range or 1500
    local res = workspace:Raycast(ray.Origin, ray.Direction * len, rayP)
    if not ground and G.viewRay then
      local vp3, vem = G.viewRay(ray.Origin, ray.Direction, res and (res.Position - ray.Origin).Magnitude or len)
      if vp3 then return vp3, vem end
    end
    if res then return res.Position, res.Instance end
    return ray.Origin + ray.Direction * len, nil
  end
  G.aimPoint = aimPoint
  G.curWeapon = function() return cur.id, cur.aiming end   -- 手雷抛物线预览（Nade.lua）：拿着什么、按没按右键

  -- 防空导弹锁定：准星 12° 以内、射程内最近的敌方飞机直升机
  local function lockCandidate(w)
    local look = cam.CFrame.LookVector
    local best, bd = nil, math.huge
    local ents = workspace:FindFirstChild("Ents")
    if not ents then return nil end
    for _, m in ipairs(ents:GetChildren()) do
      if m:GetAttribute("Cat") == "air" and m:GetAttribute("Team") ~= player:GetAttribute("Side") then
        local r = m:FindFirstChild("Root")
        if r then
          local to = r.Position - cam.CFrame.Position
          local d = to.Magnitude
          if d < w.range and to.Unit:Dot(look) > math.cos(math.rad(12)) and d < bd then best, bd = m, d end
        end
      end
    end
    return best
  end

  local function nearestFriendlyEnt(range)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local ents = workspace:FindFirstChild("Ents")
    if not hrp or not ents then return nil end
    local best, bd = nil, math.huge
    for _, m in ipairs(ents:GetChildren()) do
      local r = m:FindFirstChild("Root")
      local kd = m:GetAttribute("Kind")
      if r and m:GetAttribute("Team") == player:GetAttribute("Side") and m:GetAttribute("Cat") ~= "inf" and kd ~= "c4" and kd ~= "mine" and not m:GetAttribute("Wreck") then
        local d = (r.Position - hrp.Position).Magnitude - math.max(r.Size.X, r.Size.Z) / 2
        if d < range and d < bd then best, bd = m, d end
      end
    end
    return best
  end

  ---------------------------------------------------------------- 开火

  local function tryFire(alt)
    local id = cur.id
    local char = player.Character
    if not id or not char or G.drive then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return end
    local S = G.S
    if not S or S.phase ~= "battle" then return end
    local w = W[id]
    if not w or w.kind == "pad" then return end   -- 战术平板不开火（拿在手上平板界面开着，点的是平板上的地图）
    local t = now()
    if t < cur.nextShot then return end
    if w.kind == "heal" then
      cur.nextShot = t + w.cd
      RShoot:FireServer(id)
      return
    end
    if w.kind == "spot" then
      cur.nextShot = t + (alt and 0.5 or w.cd)
      local p = aimPoint(w.range, alt)
      RShoot:FireServer(id, p, alt and "strike" or nil)
      return
    end
    if w.kind == "repair" then
      cur.nextShot = t + 0.25
      local m = nearestFriendlyEnt(w.range)
      if m then RShoot:FireServer(id, m:GetAttribute("EntId")) end
      return
    end
    if w.kind == "breach" then return end   -- 破障器材：按住左键排雷 / 剪铁丝网，在 Gunner 的 G.breachStep 里
    if w.kind == "place" and id == "c4" and alt then
      cur.nextShot = t + 0.4
      RShoot:FireServer(id, "det")
      return
    end
    local a = ammoOf(id)
    if a.r > 0 then return end
    if a.n <= 0 then
      if a.res and a.res <= 0 then   -- 没子弹了：扣扳机咔一声（不连着响）
        cur.nextShot = t + 0.35
        if G.sfx then G.sfx("dry") end
      else
        reload()
      end
      return
    end
    cur.nextShot = t + (w.rate or 0.2)
    a.n -= 1
    if a.n <= 0 then reload() end
    if G.fpsFire then G.fpsFire(id) end   -- 第一人称：后坐、枪口火光
    if G.scopeFire then G.scopeFire() end   -- 开着镜：出瞳一甩、像糊一下
    if w.kind == "gun" then
      local p = aimPoint(w.range)
      local handle = cur.tool and cur.tool:FindFirstChild("Handle")
      local mz = handle and handle:FindFirstChild("Muzzle")
      local from = (G.fpsMuzzle and G.fpsMuzzle()) or (mz and mz.WorldPosition)   -- 第一人称时曳光从镜头前那支枪的枪口出去
      if G.gunFx and from then G.gunFx(id, from, p, true) end
      -- 开着镜（镜子已经举到眼前）告诉服务器：散布按开镜算（Config.gunSpread）；镜子还在往上举的那一下按腰射算
      local ads = cur.aiming and not (G.fpsOpticPending and G.fpsOpticPending())
      RShoot:FireServer(id, p, ads and "ads" or nil)
      if w.bloom then   -- 本地也照服务器那样攒连射的散布（准星画多大）
        bloomOf[id] = { v = math.min(w.bloom[2], Config.bloomAt(w, bloomOf[id], t) + w.bloom[1]), t = t }
      end
      crossPop = 1
      if G.kick then G.kick(w, ads, id) end
    elseif w.kind == "lock" then
      RShoot:FireServer(id, cur.lockId, aimPoint(w.range))
      cur.lockT, cur.lockId = 0, nil
    elseif w.kind == "mortar" or w.kind == "place" then
      RShoot:FireServer(id, (aimPoint(w.maxR or 60, true)))
    else
      RShoot:FireServer(id, (aimPoint(w.range or 800)))
    end
  end

  ---------------------------------------------------------------- 输入

  UIS.InputBegan:Connect(function(io, gp)
    if gp or G.drive then return end
    if G.menuOpen and G.menuOpen() then return end   -- 挂载编辑器里点 3D 的飞机（ViewportFrame 不吞点击）不能开枪
    local k = io.KeyCode
    if G.tacOpen and G.tacOpen() and (io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.MouseButton2
      or k == Enum.KeyCode.One or k == Enum.KeyCode.Two or k == Enum.KeyCode.Three or k == Enum.KeyCode.Four or k == Enum.KeyCode.Five) then
      return   -- 平板开着：鼠标点平板、数字键选支援（TacPad.lua），不切枪、不开火
    end
    if io.UserInputType == Enum.UserInputType.MouseButton1 then
      cur.firing = true
      tryFire(false)
    elseif io.UserInputType == Enum.UserInputType.MouseButton2 then
      cur.aiming = true
      if cur.id and (W[cur.id].kind == "place") then tryFire(true) end
    elseif k == Enum.KeyCode.R then reload()
    elseif k == Enum.KeyCode.V then G.firstPerson = not (G.firstPerson ~= false)   -- 第一 / 第三人称
    elseif k == Enum.KeyCode.F then
      if cur.id and W[cur.id].kind == "spot" then tryFire(true) end
    elseif k == Enum.KeyCode.One then equip(1)
    elseif k == Enum.KeyCode.Two then equip(2)
    elseif k == Enum.KeyCode.Three then equip(3)
    elseif k == Enum.KeyCode.Four then equip(4)
    elseif k == Enum.KeyCode.Five then equip(5)
    elseif k == Enum.KeyCode.Q then   -- 切回上一把
      if lastTool and lastTool.Parent and lastTool.Parent ~= player.Character then equipTool(lastTool) else cycle(1) end
    end
  end)
  -- 滚轮换枪（开着狙击镜时滚轮是变倍，Scope.lua 管）
  UIS.InputChanged:Connect(function(io, gp)
    if gp or G.drive or io.UserInputType ~= Enum.UserInputType.MouseWheel then return end
    if G.scopeOn or (G.menuOpen and G.menuOpen()) or not G.fpActive then return end   -- 第三人称时滚轮还是拉镜头
    if io.Position.Z ~= 0 then cycle((io.Position.Z < 0) and 1 or -1) end
  end)
  UIS.InputEnded:Connect(function(io)
    if io.UserInputType == Enum.UserInputType.MouseButton1 then cur.firing = false
    elseif io.UserInputType == Enum.UserInputType.MouseButton2 then cur.aiming = false end
  end)

  local touchControls, layoutTouch, touchSpot
  -- 右手触控区避开右下的跳跃键。横竖屏切换时按实际视口重新排列。
  if UIS.TouchEnabled then
    touchControls = ui.frame(hud, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)
    touchControls.Name = "InfantryTouch"
    touchControls.Visible = false
    local function tbtn(name)
      local b = ui.button(touchControls, "", UDim2.new(), nil, RGB(18, 29, 37), Vector2.new(1, 1))
      b.Name = name
      b.BackgroundTransparency = 0.24
      b.TextScaled = true
      local textSize = Instance.new("UITextSizeConstraint")
      textSize.MinTextSize, textSize.MaxTextSize = 11, 14
      textSize.Parent = b
      ui.stroke(b, RGB(184, 208, 220), 1, 0.6)
      return b
    end
    local fire = tbtn("Fire")
    fire.InputBegan:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch then cur.firing = true tryFire(false) end end)
    fire.InputEnded:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch then cur.firing = false end end)
    local aim = tbtn("Aim")
    aim.Activated:Connect(function() cur.aiming = not cur.aiming end)
    local rl = tbtn("Reload")
    rl.Activated:Connect(reload)
    local sw = tbtn("Swap")
    sw.Activated:Connect(function() cycle(1) end)
    touchSpot = tbtn("Support")
    touchSpot.Activated:Connect(function() tryFire(true) end)
    local night = tbtn("NightVision")
    night.Text = "NV"
    night.Activated:Connect(function() if G.nvgToggle then G.nvgToggle() end end)
    local tablet = tbtn("Tablet")
    tablet.Activated:Connect(function() if G.tacToggle then G.tacToggle() end end)
    local lastWidth, lastHeight, lastLanguage, lastAim
    function layoutTouch()
      local camera = workspace.CurrentCamera
      local viewport = camera and camera.ViewportSize
      if viewport and viewport.Y > 0 and (viewport.X ~= lastWidth or viewport.Y ~= lastHeight) then
        lastWidth, lastHeight = viewport.X, viewport.Y
        local edge, spacing = 18, 8
        local fireSize = math.floor(math.clamp(viewport.Y * 0.19, 58, 78))
        local aimSize = math.floor(math.clamp(viewport.Y * 0.155, 48, 65))
        local bottom = math.floor(math.clamp(viewport.Y * 0.24, 76, 116))
        local aimX = edge + fireSize + spacing
        fire.Size, fire.Position = UDim2.fromOffset(fireSize, fireSize), UDim2.new(1, -edge, 1, -bottom)
        aim.Size, aim.Position = UDim2.fromOffset(aimSize, aimSize), UDim2.new(1, -aimX, 1, -bottom)
        rl.Size, rl.Position = UDim2.fromOffset(math.max(aimSize, 56), 44), UDim2.new(1, -aimX, 1, -bottom - aimSize - spacing)
        sw.Size, sw.Position = UDim2.fromOffset(math.max(56, fireSize - 12), 44), UDim2.new(1, -edge, 1, -bottom - fireSize - spacing)
        touchSpot.Size, touchSpot.Position = UDim2.fromOffset(math.max(56, aimSize), 44), UDim2.new(1, -aimX, 1, -bottom + 52)
        local utilityY = -bottom - fireSize - 44 - spacing * 2
        night.Size, night.Position = sw.Size, UDim2.new(1, -edge, 1, utilityY)
        tablet.Size, tablet.Position = rl.Size, UDim2.new(1, -aimX, 1, utilityY)
        G.infantryTouchWidth = aimX + math.max(aimSize, 56) + 10
      end
      if G.lang ~= lastLanguage then
        lastLanguage = G.lang
        fire.Text, aim.Text = T("touch.fire"), T("touch.aim")
        rl.Text, sw.Text, touchSpot.Text = T("touch.reload"), T("touch.swap"), T("touch.support")
        tablet.Text = T("tac.key")
      end
      if cur.aiming ~= lastAim then
        lastAim = cur.aiming
        aim.BackgroundColor3 = cur.aiming and RGB(37, 75, 83) or RGB(18, 29, 37)
      end
    end
    layoutTouch()
  end

  ---------------------------------------------------------------- 每帧

  local function weaponHud()
    local id = cur.id
    if not id then
      ammoText.Text = ""
      tipText.Text = ""
      return
    end
    local w = W[id]
    local a = ammoOf(id)
    local name = T("weapon." .. id)
    if w.kind == "heal" or w.kind == "repair" or w.kind == "spot" or w.kind == "breach" then
      ammoText.Text = name
    elseif a.r > 0 then
      ammoText.Text = T("ui.reloading", name)
    else
      -- 「R 换弹」只在打空了时提示（用户：持枪第一视角不要显示键位）
      ammoText.Text = T("ui.ammo", name, a.n, a.res and tostring(a.res) or "∞") .. ((G.mobile or a.n > 0) and "" or ("   " .. T("ui.reloadKey")))
    end
    tipText.Text = ""
    if w.kind == "lock" then
      if cur.lockId then tipText.Text = T("ui.locked")
      elseif cur.lockT > 0 then tipText.Text = T("ui.locking") end
    elseif w.kind == "mortar" then
      local p = aimPoint(w.maxR + 200, true)
      local char = player.Character
      local hrp = char and char:FindFirstChild("HumanoidRootPart")
      if hrp then
        local d = (V(p.X, 0, p.Z) - V(hrp.Position.X, 0, hrp.Position.Z)).Magnitude
        tipText.Text = math.floor(d) .. (G.lang == "zh" and " 格" or " studs") .. ((d < w.minR or d > w.maxR) and ("  " .. T("ui.mortarRange", w.minR, w.maxR)) or "")
      end
    end
  end

  local baseFov = 70
  local fpMode = nil
  -- 第一人称：镜头最近、最远都设 0.5（Roblox 就进第一人称，鼠标锁在中间、人跟着镜头转）；第三人称：拉开到肩后
  local function setFirstPerson(on)
    if fpMode == on then return end
    fpMode = on
    if on then
      player.CameraMinZoomDistance, player.CameraMaxZoomDistance = 0.5, 0.5
    else
      player.CameraMaxZoomDistance = 40
      player.CameraMinZoomDistance = 8
    end
  end
  function G.stepPlay(dt)
    if G.drive then   -- 开着车：镜头、开火归 Drive 管；武器栏、弹药字藏起来（载具面板在同一个位置）
      if touchControls then touchControls.Visible = false end
      cross.Visible, scope.Visible, bar.Visible = false, false, false
      if G.scopeStep then G.scopeStep(dt, false) end
      ammoText.Text, tipText.Text = "", ""
      cur.firing = false
      G.fpsAiming = false
      G.fpActive = false
      if G.fpsOff then G.fpsOff() end
      return
    end
    bar.Visible = true
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local armed = cur.id ~= nil and hum and hum.Health > 0 and not G.drive and not (hrp and hrp.Anchored)
    local fp = G.firstPerson ~= false and hum ~= nil and hum.Health > 0 and not (hrp and hrp.Anchored)
    G.fpActive = fp   -- 步行第一人称（UI 据此藏鼠标指针、底部键位说明）
    local menu = G.menuOpen and G.menuOpen()
    if menu then cur.firing, cur.aiming = false, false end
    if touchControls then
      local touchVisible = armed == true and not menu and not (G.boardShown and G.boardShown())
      if touchControls.Visible and not touchVisible then cur.firing = false end
      touchControls.Visible = touchVisible
      if touchVisible then
        touchSpot.Visible = W[cur.id].kind == "spot"
        layoutTouch()
      end
    end
    if hum and hum.Health > 0 then setFirstPerson(fp) end
    baseFov = fp and 68 or 70   -- 第一人称的枪照竖直视角约 60° 做的（原动作包的相机水平 90°）；记录仪是广角，放宽到 68°
    if fp then
      hum.AutoRotate = true
      hum.CameraOffset = V()
    elseif armed and not G.mobile and not menu then   -- 第三人称：肩后视角，鼠标锁在中间、人跟着镜头转（开着挂载编辑器时不锁）
      UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
      hum.AutoRotate = false
      hum.CameraOffset = hum.CameraOffset:Lerp(V(1.9, 0.5, 0), math.min(1, dt * 10))
      local look = cam.CFrame.LookVector
      local yaw = math.atan2(-look.X, -look.Z)
      hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)
    elseif hum then
      if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then UIS.MouseBehavior = Enum.MouseBehavior.Default end
      hum.AutoRotate = true
      hum.CameraOffset = hum.CameraOffset:Lerp(V(), math.min(1, dt * 10))
    end
    local wc = cur.id and W[cur.id]
    G.fpsAiming = armed == true and cur.aiming == true   -- 记录仪观感（Bodycam.lua）：开镜时镜头不晃
    -- 开着镜不画准星（第三人称也是）；第一人称是记录仪的画面（Bodycam.lua）：不画四根线，只有一个淡淡的小点
    cross.Visible = armed == true and not (fp and cur.aiming) and not (fp and G.bodycamOn) and not (cur.aiming and wc and (wc.scope ~= nil or wc.kind == "spot"))
    if cross.Visible and wc and hrp then
      -- 张开多少：这一发的散布在屏幕上有多宽（跑起来、跳起来、连射攒的都算），开枪那一下再弹开一点
      local okv, v = pcall(function() return hrp.AssemblyLinearVelocity end)   -- 读不到（测试台）就当站着不动
      if not okv or typeof(v) ~= "Vector3" then v = V() end
      local okf, fm = pcall(function() return hum.FloorMaterial end)
      local air = okf and fm == Enum.Material.Air and math.abs(v.Y) > 1.5
      local b = Config.bloomAt(wc, bloomOf[cur.id], now())
      local deg = (wc.kind == "gun") and Config.gunSpread(wc, false, V(v.X, 0, v.Z).Magnitude, air, b) or math.max(wc.spread or 0.4, 0.4)
      -- 服务器的散布是方形的（每个方向各自 ±deg），斜着最远约 1.4 倍：准星的线画在最远那一圈
      local px = cam.ViewportSize.Y / 2 * math.tan(math.rad(deg * 1.4)) / math.tan(math.rad(cam.FieldOfView / 2))
      crossGap += (math.clamp(px, 4, 90) + crossPop * 5 - crossGap) * math.min(1, dt * 18)
      crossPop = math.max(0, crossPop - dt * 9)
      local g = math.floor(crossGap + 0.5) + 4
      crossBars[1].Position = UDim2.new(0.5, 0, 0.5, -g)
      crossBars[2].Position = UDim2.new(0.5, 0, 0.5, g)
      crossBars[3].Position = UDim2.new(0.5, -g, 0.5, 0)
      crossBars[4].Position = UDim2.new(0.5, g, 0.5, 0)
    end
    -- 瞄准：拉近；狙击镜、望远镜放大得多
    local w = cur.id and W[cur.id]
    local zoom = 1
    if armed and cur.aiming and w then
      if w.scope or w.kind == "spot" then zoom = G.scopeZoom and G.scopeZoom(w) or (w.scope or 5) else zoom = 1.35 end   -- 镜子的倍率滚轮能变
    end
    scope.Visible = armed and cur.aiming and w and (w.scope ~= nil or w.kind == "spot") or false
    G.scopeVisible = G.scopeVisible or function() return scope.Visible end
    if G.scopeStep then G.scopeStep(dt, scope.Visible, w) end
    cam.FieldOfView = cam.FieldOfView + (baseFov / zoom - cam.FieldOfView) * math.min(1, dt * 12)
    -- 连发
    if cur.firing and armed and w and (w.auto or w.kind == "repair") then tryFire(false) end
    -- 防空导弹锁定：右键按住对准
    if armed and w and w.kind == "lock" then
      local m = cur.aiming and lockCandidate(w) or nil
      if m then
        cur.lockT += dt
        if cur.lockT >= w.lockTime then cur.lockId = m:GetAttribute("EntId") end
      else
        cur.lockT, cur.lockId = 0, nil
      end
    end
    weaponHud()
    -- 第一人称：镜头前的枪和方块手臂（狙击镜、望远镜放大时藏起来）
    if G.stepFPS then
      if fp and armed then G.stepFPS(dt, true, cur.aiming, scope.Visible, cur.tool) elseif G.fpsOff then G.fpsOff() end
    end
    if G.breachStep then   -- 破障器材：探雷标记、按住排雷 / 剪铁丝网的进度
      local tip = G.breachStep(dt, armed and w and w.kind == "breach" or false, cur.firing)
      if tip then tipText.Text = tip end
    end
    local a = now() - hitT
    hitX.TextTransparency = math.clamp(a / 0.25, 0, 1)
    if hitX.TextSize > 28 then hitX.TextSize = math.max(28, hitX.TextSize - 90 * (1 / 60)) end   -- 打死的大叉缩回去
  end
end

return Play
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="103">
          <Properties>
            <string name="Name">Sail</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——开船：位置在本地算（车钟定航速、舵慢慢打过去、要有航速才转得动；船头碰到浅水、码头、别的船就停），每秒 15 次报给服务器
--   W / S 车钟加一档 / 减一档（后退二 … 全速前进）、A / D 按住打舵（松开回正舵）；鼠标转镜头（追尾），右键 / V 望远镜（舰桥上看出去，Z 换倍率）
--   1 舰炮：炮塔跟着准星转（回转速度、射界、俯仰照型号），按弹道自动抬炮；画面上黄色小十字是现在炮管指向的落点；左键开火（机枪、30 毫米炮按住连发）
--   2 反舰导弹：准星附近 10° 以内最近的敌方水面 / 岸上目标自动框住，R 锁住 / 解锁；左键发射（没框住目标就打准星下那一点）
--   防空导弹、近防炮是自动的（服务器）；回到自己码头停稳补弹、修理；F 下船
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local Sail = {}

function Sail.init(G)
  local Map = require(RS:WaitForChild("Map"))
  local SD = require(RS:WaitForChild("ShipDefs"))
  local V, CF, RGB = Vector3.new, CFrame.new, Color3.fromRGB
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local ui = G.ui
  local function T(k, ...) return G.T(k, ...) end
  local SHELL_G = workspace.Gravity * 0.55

  local st = nil
  G.sail = nil

  ---------------------------------------------------------------- 界面

  local gui = Instance.new("ScreenGui")
  gui.Name = "Sail"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 5
  gui.Parent = me:WaitForChild("PlayerGui")

  local panel = ui.frame(gui, UDim2.fromOffset(470, 96), UDim2.new(0.5, 0, 1, -24), RGB(12, 16, 20), 0.3, Vector2.new(0.5, 1))
  panel.Visible = false
  local vName = ui.label(panel, "", UDim2.new(1, -20, 0, 20), UDim2.fromOffset(10, 6), 16, Color3.new(1, 1, 1), Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  local hpBg = ui.frame(panel, UDim2.new(1, -20, 0, 6), UDim2.fromOffset(10, 29), RGB(0, 0, 0), 0.4)
  local hpBar = ui.frame(hpBg, UDim2.fromScale(1, 1), nil, RGB(90, 210, 110), 0)
  local info1 = ui.label(panel, "", UDim2.new(1, -20, 0, 18), UDim2.fromOffset(10, 39), 14, Color3.new(1, 1, 1), Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local info2 = ui.label(panel, "", UDim2.new(1, -20, 0, 18), UDim2.fromOffset(10, 59), 14, RGB(222, 226, 230), Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local relBg = ui.frame(panel, UDim2.new(1, -20, 0, 4), UDim2.fromOffset(10, 83), RGB(0, 0, 0), 0.5)
  local relBar = ui.frame(relBg, UDim2.fromScale(0, 1), nil, RGB(240, 200, 80), 0)
  ui.flatPanel(panel, { hp = hpBg, rel = relBg, name = vName })   -- 跟新界面一个样子（UI.lua）

  local cross = ui.label(gui, "◯", UDim2.fromOffset(30, 30), UDim2.fromScale(0.5, 0.5), 22, Color3.new(1, 1, 1), Enum.Font.GothamBold, Vector2.new(0.5, 0.5))
  cross.TextStrokeTransparency = 0.4
  cross.Visible = false
  local gunMark = ui.label(gui, "+", UDim2.fromOffset(26, 26), UDim2.fromScale(0.5, 0.5), 26, RGB(255, 210, 80), Enum.Font.GothamBold, Vector2.new(0.5, 0.5))
  gunMark.TextStrokeTransparency = 0.3
  gunMark.Visible = false
  -- 导弹的锁定框（四角）
  local lockBox = Instance.new("Frame")
  lockBox.AnchorPoint = Vector2.new(0.5, 0.5)
  lockBox.Size = UDim2.fromOffset(46, 46)
  lockBox.BackgroundTransparency = 1
  lockBox.Visible = false
  lockBox.Parent = gui
  local lockStroke = Instance.new("UIStroke")
  lockStroke.Color = RGB(255, 80, 60)
  lockStroke.Thickness = 2
  lockStroke.Parent = lockBox
  local lockText = ui.label(gui, "", UDim2.fromOffset(360, 20), UDim2.new(0.5, 0, 0.5, 46), 14, RGB(255, 120, 100), Enum.Font.GothamBold, Vector2.new(0.5, 0))
  lockText.TextStrokeTransparency = 0.4
  lockText.Visible = false
  local warn = ui.label(gui, "", UDim2.fromOffset(400, 30), UDim2.new(0.5, 0, 0, 120), 24, RGB(255, 90, 70), Enum.Font.GothamBlack, Vector2.new(0.5, 0))
  warn.TextStrokeTransparency = 0.3
  warn.Visible = false
  -- 望远镜：四周压暗的框、倍率
  local bino = ui.frame(gui, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)
  bino.Visible = false
  local binoIn = Instance.new("Frame")
  binoIn.AnchorPoint, binoIn.Position, binoIn.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.82, 0.7)
  binoIn.BackgroundTransparency = 1
  binoIn.Parent = bino
  local bs = Instance.new("UIStroke")
  bs.Thickness = 700
  bs.Color = Color3.new(0, 0, 0)
  bs.Transparency = 0.25
  bs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
  bs.Parent = binoIn
  local binoText = ui.label(bino, "", UDim2.fromOffset(260, 22), UDim2.new(0.5, 0, 0.85, 0), 16, RGB(230, 230, 230), Enum.Font.Code, Vector2.new(0.5, 0.5))

  ---------------------------------------------------------------- 开船

  local function findEnt(id)
    local f = workspace:FindFirstChild("Ents")
    if not f then return nil end
    for _, em in ipairs(f:GetChildren()) do
      if em:GetAttribute("EntId") == id then return em end
    end
    return nil
  end
  local mapParams = RaycastParams.new()
  mapParams.FilterType = Enum.RaycastFilterType.Include
  local aimParams = RaycastParams.new()
  aimParams.FilterType = Enum.RaycastFilterType.Exclude

  local function begin(vs)
    local em = findEnt(vs.id)
    local d = SD.get(vs.m or "")
    if not em or not d then return end
    local root = em.Root.CFrame
    local base = root * CF(0, -(d.H / 2 - d.draft), 0)
    local look = base.LookVector
    local yaw = math.atan2(-look.X, -look.Z)
    local p = base.Position
    st = { id = vs.id, em = em, d = d, pos = V(p.X, 0, p.Z), yaw = yaw, speed = 0, order = 0, rudder = 0, rcmd = 0,
      camYaw = yaw, camPitch = -0.18, bino = false, zoom = 1, wi = 1, ty = {}, gp = {}, next = {}, onT = {}, sendT = 0, firing = false,
      lock = nil, sticky = false, lockT = 0, mslT = 0, warnT = 0, rwrT = 0, help = "ship.help" }
    for gi in ipairs(d.guns) do st.ty[gi], st.gp[gi], st.next[gi] = em:GetAttribute("Ty" .. gi) or 0, em:GetAttribute("Gp" .. gi) or 0, 0 end
    st.cf = CFrame.lookAt(st.pos, st.pos + V(-math.sin(yaw), 0, -math.cos(yaw)))
    G.sail, G.drive = st, st   -- G.drive：步兵的操作（Play）先停下、界面最下面一行换成开船说明
    cam.CameraType = Enum.CameraType.Scriptable
    panel.Visible, cross.Visible = not G.vehHudOn, not G.vehHudOn   -- 有新的驾驶界面（VehHud.lua）就不画这块小面板和圆圈
    if G.touchSailUI then for _, f in ipairs(G.touchSailUI) do f.Visible = true end end
    local m = workspace:FindFirstChild("Map")
    mapParams.FilterDescendantsInstances = m and { m } or {}
    if G.playSound then G.playSound("capture") end
  end

  local function stop()
    if st and st.trigOn then G.R.Drive:FireServer({ op = "trig", on = false, g = st.trigG }) end
    local old = st
    st = nil
    G.sail = nil
    if G.drive == old then G.drive = nil end
    cam.CameraType = Enum.CameraType.Custom
    cam.FieldOfView = 70
    if UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then UIS.MouseBehavior = Enum.MouseBehavior.Default end
    panel.Visible, cross.Visible, gunMark.Visible, lockBox.Visible, lockText.Visible, warn.Visible, bino.Visible = false, false, false, false, false, false, false
    if G.touchSailUI then for _, f in ipairs(G.touchSailUI) do f.Visible = false end end
  end

  local function approach(a, b, s)
    if a < b then return math.min(b, a + s) end
    return math.max(b, a - s)
  end
  local function angDiff(a, b) return (b - a + 180) % 360 - 180 end
  local function fwdOf(yaw) return V(-math.sin(yaw), 0, -math.cos(yaw)) end

  -- 这一点水够不够深（船吃水的三成以上）
  local function deep(p, d) return Map.height(p.X, p.Z) < -d.draft * 0.35 end
  -- 船头（倒车时船尾）前面撞上码头、平台、别的船没有
  local function blockedAt(np, yaw, dir, d)
    local f = fwdOf(yaw)
    local r = V(-f.Z, 0, f.X)
    local tip = np + f * dir * (d.L / 2)
    local pts = { tip, np + f * dir * (d.L * 0.32) + r * (d.W * 0.45), np + f * dir * (d.L * 0.32) - r * (d.W * 0.45) }
    for _, p in ipairs(pts) do
      if not deep(p, d) then return "shallow" end
      if math.abs(p.X) > Map.SEA_LIM or math.abs(p.Z) > Map.SEA_LIM then return "edge" end
    end
    -- 码头、登陆平台、舰队（地图零件）：从船头往前打一小段射线
    local res = workspace:Raycast(tip + V(0, 2.5, 0) - f * dir * 2, f * dir * 6, mapParams)
    if res then return "hit" end
    -- 别的船：船头这一点在不在它的船体方块里（宽出 3 格）
    for em, v in pairs(G.views or {}) do
      if v.kind == "ship" and em ~= st.em and v.root and v.root.Parent and not em:GetAttribute("Wreck") then
        local l = v.root.CFrame:PointToObjectSpace(V(tip.X, v.root.CFrame.Position.Y, tip.Z))
        local s = v.root.Size
        if math.abs(l.X) < s.X / 2 + 3 and math.abs(l.Z) < s.Z / 2 + 3 then return "hit" end
      end
    end
    return nil
  end

  local function physics(dt)
    local d = st.d
    local tgt = d.speed * (SD.ORDERS[st.order] or 0)
    local a = (math.abs(tgt) < math.abs(st.speed) or (tgt > 0) ~= (st.speed > 0)) and d.accel * 0.8 or d.accel
    st.speed = approach(st.speed, tgt, a * dt)
    -- 舵：按住慢慢打过去（满舵约 1.2 秒），松开回正；转得动要有航速
    local cmd = (UIS:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UIS:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
    if G.touchSail and G.touchSail.str ~= 0 then cmd = G.touchSail.str end
    st.rcmd = cmd
    st.rudder = approach(st.rudder, cmd, dt * 0.85)
    local eff = math.clamp(math.abs(st.speed) / (d.speed * 0.35), 0.06, 1) * ((st.speed < -0.5) and -1 or 1)
    -- 驾驶手感（用户：驾驶手感也做到最好）：舵打下去船头要一会儿才转起来、回正以后还接着转一阵（船越长越迟钝）；
    --   转弯掉速（满舵全速每秒掉 8% 上下）；船身往外侧滑——前进方向慢半拍才跟上船头
    local lag = math.clamp((d.L or 60) / 110, 0.5, 2.6)
    st.yr = (st.yr or 0) + (st.rudder * math.rad(d.turn) * eff - (st.yr or 0)) * math.min(1, dt / lag)
    local ny = st.yaw - st.yr * dt
    st.speed -= st.speed * math.clamp(math.abs(st.yr) / math.max(math.rad(d.turn), 1e-3), 0, 1) * 0.08 * dt
    st.slip = (st.slip or 0) + (st.yr * math.abs(st.speed) * 0.025 - (st.slip or 0)) * math.min(1, dt * 1.1)
    local right = V(math.cos(ny), 0, -math.sin(ny))
    local step = st.speed * dt
    local np = st.pos + fwdOf(ny) * step - right * st.slip * dt
    local why = (math.abs(step) > 1e-4) and blockedAt(np, ny, (step > 0) and 1 or -1, d) or nil
    if why then
      if math.abs(st.speed) > d.speed * 0.3 and G.shake then G.shake(0.3) end
      st.speed = -st.speed * 0.15   -- 顶住了：往回弹一点
      if why == "shallow" then st.warnT = os.clock() + 2 end
      st.yaw = ny
    else
      st.pos, st.yaw = np, ny
    end
    st.cf = CFrame.lookAt(st.pos, st.pos + fwdOf(st.yaw))
  end

  -- 准星打到哪（不算自己的船；实体的样子不挡射线，打到的是命中盒、地形、海面）
  local function aimPoint()
    local o, dir = cam.CFrame.Position, cam.CFrame.LookVector
    local ex = { st.em }
    if me.Character then table.insert(ex, me.Character) end
    if G.viewFolder then table.insert(ex, G.viewFolder) end
    aimParams.FilterDescendantsInstances = ex
    local res = workspace:Raycast(o, dir * 6000, aimParams)
    if res then return res.Position end
    if dir.Y < -0.01 then   -- 没打到东西但朝下：落在海平面上
      local t = -o.Y / dir.Y
      if t > 0 and t < 9000 then return o + dir * t end
    end
    return o + dir * 6000
  end

  local function lowAngle(v, g, R, h)
    local v2 = v * v
    local disc = v2 * v2 - g * (g * R * R + 2 * h * v2)
    if disc < 0 or R < 1 then return nil end
    return math.atan((v2 - math.sqrt(disc)) / (g * R))
  end

  -- 炮塔转向准星：直射的机枪对着打；炮弹按弹道抬（打不到就抬到 45°）
  local function aimGuns(dt)
    local d = st.d
    local cf = st.cf
    local ap = st.aimPt
    for gi, g in ipairs(d.guns) do
      local w = SD.W[g.w]
      local piv = SD.gunCF(d, cf, gi, st.ty[gi], 0).Position
      local rel = ap - piv
      local hz = V(rel.X, 0, rel.Z)
      local dir
      if w.kind == "gun" or hz.Magnitude < 1 then dir = rel.Unit else
        local th = lowAngle(w.speed, SHELL_G * w.gscale, hz.Magnitude, rel.Y) or math.rad(45)
        dir = hz.Unit * math.cos(th) + V(0, math.sin(th), 0)
      end
      local l = cf:VectorToObjectSpace(dir)
      if g.aft then l = V(-l.X, l.Y, -l.Z) end
      local wy = math.deg(math.atan2(l.X, -l.Z))
      local wp = math.deg(math.atan2(l.Y, math.sqrt(l.X * l.X + l.Z * l.Z)))
      local inArc = math.abs(wy) <= g.arc
      local goal = math.clamp(wy, -g.arc, g.arc)
      st.ty[gi] = st.ty[gi] + math.clamp(angDiff(st.ty[gi], goal), -g.trav * dt, g.trav * dt)
      st.gp[gi] = approach(st.gp[gi], math.clamp(wp, g.elev[1], g.elev[2]), 30 * dt)
      st.onT[gi] = inArc and math.abs(angDiff(st.ty[gi], wy)) < 1.5 and math.abs(st.gp[gi] - math.clamp(wp, g.elev[1], g.elev[2])) < 1.5
    end
  end

  -- 第 gi 门炮按现在的指向打出去落在哪（炮弹算弹道，落到准星那一点的高度；机枪就是一条直线）
  local function fallOfShot(gi)
    local d = st.d
    local g = d.guns[gi]
    local w = SD.W[g.w]
    local mz = SD.muzzle(d, st.cf, gi, st.ty[gi], st.gp[gi])
    local p0, dir = mz.Position, mz.LookVector
    if w.kind == "gun" then return p0 + dir * math.min(w.range, (st.aimPt - p0).Magnitude) end
    local gg = SHELL_G * w.gscale
    local vy = dir.Y * w.speed
    local yt = st.aimPt.Y
    local disc = vy * vy + 2 * gg * (p0.Y - yt)
    if disc < 0 then return nil end
    local t = (vy + math.sqrt(disc)) / gg
    return p0 + V(dir.X, 0, dir.Z) * w.speed * t + V(0, yt - p0.Y, 0)
  end
  G.sailFall = fallOfShot   -- 新的驾驶界面（VehHud.lua）按它画炮的落点

  local function tryFire()
    local d = st.d
    if st.wi == 2 then
      if not d.missiles then return end
      local t = os.clock()
      if t < st.mslT then return end
      local vs = G.S and G.S.veh
      if vs and (vs.msl or 0) <= 0 then return end
      st.mslT = t + 1.3
      G.R.Drive:FireServer({ op = "msl", tgt = st.lock and st.lock.id or nil, aim = st.aimPt })
      return
    end
    local t = os.clock()
    for gi, g in ipairs(d.guns) do
      local w = SD.W[g.w]
      if w.kind == "gun" then
        if not st.trigOn then
          st.trigOn, st.trigG = true, gi
          G.R.Drive:FireServer({ op = "trig", on = true, g = gi, ty = st.ty[gi], gp = st.gp[gi] })
        end
      elseif st.onT[gi] and t >= (st.next[gi] or 0) then
        st.next[gi] = t + w.rate
        G.R.Drive:FireServer({ op = "fire", g = gi, ty = st.ty[gi], gp = st.gp[gi] })
        if G.vehRecoil then G.vehRecoil(st.id, gi) end
        if G.shake then G.shake((w.dmg > 400) and 0.3 or 0.12) end
      end
    end
  end
  local function releaseTrig()
    if st and st.trigOn then
      st.trigOn = false
      G.R.Drive:FireServer({ op = "trig", on = false, g = st.trigG })
    end
  end

  -- 导弹框的目标：准星附近 10° 以内、射程内、看得见的敌方水面 / 岸上目标（舰艇、登陆艇、车、工事），离准星最近的
  local LOCK_KINDS = { ship = true, lcm = true, lcac = true, veh = true, fort = true }
  local function pickLock()
    local d = st.d
    local w = d.missiles and SD.W[d.missiles.w]
    if not w then return nil end
    local side = me:GetAttribute("Side")
    local o, look = cam.CFrame.Position, cam.CFrame.LookVector
    local best, ba = nil, math.rad(10)
    for em, v in pairs(G.views or {}) do
      if LOCK_KINDS[v.kind] and v.team ~= side and em.Parent and v.root and (em:GetAttribute("Hp") or 1) > 0 and not em:GetAttribute("Wreck") then
        local p = v.root.CFrame.Position
        if (p - st.pos).Magnitude < w.range then
          local a = math.acos(math.clamp(look:Dot((p - o).Unit), -1, 1))
          if a < ba then best, ba = v, a end
        end
      end
    end
    return best
  end

  ---------------------------------------------------------------- 手机：车钟、舵、开火、换武器、望远镜、下船

  if UIS.TouchEnabled then
    local touch = { str = 0 }
    local tb = ui.frame(gui, UDim2.fromOffset(250, 170), UDim2.new(0, 20, 1, -190), RGB(0, 0, 0), 1)
    tb.Visible = false
    local function btn(parent, text, pos, size)
      local b = ui.button(parent, text, size or UDim2.fromOffset(64, 64), pos, RGB(30, 36, 42))
      b.BackgroundTransparency = 0.35
      b.TextSize = 14
      return b
    end
    btn(tb, "▲", UDim2.fromOffset(93, 0)).Activated:Connect(function() if st then st.order = math.min(5, st.order + 1) end end)
    btn(tb, "▼", UDim2.fromOffset(93, 104)).Activated:Connect(function() if st then st.order = math.max(-2, st.order - 1) end end)
    local function holdStr(b, s)
      b.InputBegan:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch then touch.str = s end end)
      b.InputEnded:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch then touch.str = 0 end end)
    end
    holdStr(btn(tb, "◀", UDim2.fromOffset(20, 52)), -1)
    holdStr(btn(tb, "▶", UDim2.fromOffset(166, 52)), 1)
    local rb = ui.frame(gui, UDim2.fromOffset(240, 220), UDim2.new(1, -250, 1, -330), RGB(0, 0, 0), 1)
    rb.Visible = false
    local fb = btn(rb, "●", UDim2.fromOffset(140, 120), UDim2.fromOffset(90, 90))
    fb.InputBegan:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch and st then st.firing = true tryFire() end end)
    fb.InputEnded:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch and st then st.firing = false releaseTrig() end end)
    btn(rb, "1/2", UDim2.fromOffset(170, 40)).Activated:Connect(function() if st then releaseTrig() st.wi = (st.wi == 1 and st.d.missiles) and 2 or 1 end end)
    btn(rb, "◎", UDim2.fromOffset(60, 140)).Activated:Connect(function() if st then st.bino = not st.bino end end)
    btn(rb, "R", UDim2.fromOffset(60, 66)).Activated:Connect(function() if st then st.sticky = not st.sticky if st.sticky then st.lock = pickLock() st.sticky = st.lock ~= nil end end end)
    btn(rb, "F", UDim2.fromOffset(0, 0)).Activated:Connect(function() G.R.Drive:FireServer({ op = "exit" }) end)
    G.touchSail = touch
    G.touchSailUI = { tb, rb }
  end

  ---------------------------------------------------------------- 输入

  local ZOOMS = { 24, 9 }   -- 望远镜视场（度）：约 3×、8×
  UIS.InputBegan:Connect(function(io, gp)
    if gp or not st then return end
    local k = io.KeyCode
    if io.UserInputType == Enum.UserInputType.MouseButton1 then
      st.firing = true
      tryFire()
    elseif io.UserInputType == Enum.UserInputType.MouseButton2 or k == Enum.KeyCode.V then
      st.bino = not st.bino
    elseif k == Enum.KeyCode.Z then
      st.zoom = st.zoom % #ZOOMS + 1
    elseif k == Enum.KeyCode.W then
      st.order = math.min(5, st.order + 1)
    elseif k == Enum.KeyCode.S then
      st.order = math.max(-2, st.order - 1)
    elseif k == Enum.KeyCode.One then
      releaseTrig()
      st.wi = 1
    elseif k == Enum.KeyCode.Two then
      if st.d.missiles then releaseTrig() st.wi = 2 end
    elseif k == Enum.KeyCode.R then
      if st.sticky then st.sticky = false else
        st.lock = pickLock()
        st.sticky = st.lock ~= nil
      end
    elseif k == Enum.KeyCode.F or k == Enum.KeyCode.Space then   -- 空格也能下船
      G.R.Drive:FireServer({ op = "exit" })
    end
  end)
  UIS.InputEnded:Connect(function(io)
    if st and io.UserInputType == Enum.UserInputType.MouseButton1 then
      st.firing = false
      releaseTrig()
    end
  end)

  G.R.Drive.OnClientEvent:Connect(function(m)
    if type(m) ~= "table" or not st then return end
    if m.op == "fix" and m.ship and typeof(m.cf) == "CFrame" then   -- 服务器不认（跑太快、搁浅）：拉回去
      local p = m.cf.Position
      local look = m.cf.LookVector
      st.pos, st.yaw, st.speed = V(p.X, 0, p.Z), math.atan2(-look.X, -look.Z), 0
      st.cf = CFrame.lookAt(st.pos, st.pos + fwdOf(st.yaw))
    elseif m.op == "rwr" then
      st.rwrT = os.clock() + 5
    end
  end)

  ---------------------------------------------------------------- 每帧

  local SENS = 0.0042
  function G.stepSail(dt)
    local S = G.S
    local vs = S and S.alive and S.veh or nil
    if vs and not vs.ship then vs = nil end
    if vs and (not st or st.id ~= vs.id) then
      if st then stop() end
      begin(vs)
    elseif not vs and st then
      stop()
    end
    if not st then return end
    if not st.em.Parent then stop() return end
    local d = st.d
    -- 镜头转动
    UIS.MouseBehavior = Enum.MouseBehavior.LockCenter
    local md = UIS:GetMouseDelta()
    local sens = SENS * (st.bino and (ZOOMS[st.zoom] / 70) or 1)
    st.camYaw -= md.X * sens
    st.camPitch = math.clamp(st.camPitch - md.Y * sens, -0.8, 0.5)
    physics(dt)
    local dirCam = CFrame.Angles(0, st.camYaw, 0) * CFrame.Angles(st.camPitch, 0, 0)
    if st.bino then   -- 望远镜：舰桥（第二块上层建筑前面）上看出去
      local s2 = d.look and d.look.sup and d.look.sup[2]
      local eye = s2 and (st.cf * CF(0, s2[5] + s2[4] + 1.5, s2[1] + 2)).Position or (st.cf * CF(0, d.deck + 4, 0)).Position
      cam.CFrame = CFrame.lookAt(eye, eye + dirCam.LookVector)
      cam.FieldOfView = cam.FieldOfView + (ZOOMS[st.zoom] - cam.FieldOfView) * math.min(1, dt * 10)
    else
      local center = st.pos + V(0, d.H * 0.45, 0)
      local dist = d.L * 0.75 + d.H * 0.6 + 20
      local camPos = center + dirCam:VectorToWorldSpace(V(0, 0, dist)) + V(0, d.H * 0.5, 0)
      camPos = V(camPos.X, math.max(camPos.Y, 3), camPos.Z)
      cam.CFrame = CFrame.lookAt(camPos, camPos + dirCam.LookVector)
      cam.FieldOfView = cam.FieldOfView + (70 - cam.FieldOfView) * math.min(1, dt * 10)
    end
    st.aimPt = aimPoint()
    aimGuns(dt)
    if st.firing then tryFire() end
    -- 导弹框：选中导弹时每 0.2 秒重挑（锁住的就一直跟着它，没了才放）
    st.lockT -= dt
    if st.wi == 2 then
      if st.sticky and (not st.lock or not st.lock.em.Parent or st.lock.em:GetAttribute("Wreck") or (st.lock.em:GetAttribute("Hp") or 1) <= 0) then st.sticky, st.lock = false, nil end
      if not st.sticky and st.lockT <= 0 then
        st.lockT = 0.2
        st.lock = pickLock()
      end
    else
      st.lock, st.sticky = nil, false
    end
    -- 报给服务器（每秒 15 次）
    st.sendT -= dt
    if st.sendT <= 0 then
      st.sendT = 1 / 15
      G.R.Drive:FireServer({ op = "state", cf = st.cf, sp = st.speed, o = st.order, ty = st.ty, gp = st.gp })
    end
    -- 画面：弹着点、锁定框、警告
    gunMark.Visible = false
    if st.wi == 1 and d.guns[1] then
      local fp = fallOfShot(1)
      if fp then
        local sp, on = cam:WorldToViewportPoint(fp)
        gunMark.Visible = on and not G.vehHudOn
        gunMark.Position = UDim2.fromOffset(sp.X, sp.Y)
        gunMark.TextColor3 = st.onT[1] and RGB(255, 210, 80) or RGB(170, 170, 170)
      end
    end
    lockBox.Visible = false
    lockText.Visible = st.wi == 2 and not G.vehHudOn   -- 有新的驾驶界面（VehHud.lua）：锁定框照《现代战舰》画在那边
    if st.wi == 2 and not G.vehHudOn then
      if st.lock and st.lock.root then
        local sp, on = cam:WorldToViewportPoint(st.lock.root.CFrame.Position)
        lockBox.Visible = on
        lockBox.Position = UDim2.fromOffset(sp.X, sp.Y)
        lockStroke.Color = st.sticky and RGB(255, 60, 40) or RGB(255, 190, 80)
        local lk = st.lock
        local key = (lk.kind == "fort") and ("fort." .. tostring(lk.em:GetAttribute("Model") or "bunker"))
          or ("veh." .. ((lk.d and lk.d.id) or (lk.def and lk.def.id) or lk.kind or ""))
        lockText.Text = T("ship.lock", T(key))
      else
        lockText.Text = T("ship.noLock")
      end
    end
    local t = os.clock()
    if t < st.rwrT then
      warn.Visible = (t * 4) % 1 < 0.6
      warn.Text = T("air.missile")
    elseif t < st.warnT then
      warn.Visible = true
      warn.Text = T("ship.shallow")
    else
      warn.Visible = false
    end
    bino.Visible = st.bino
    cross.Visible = not G.vehHudOn
    if st.bino then binoText.Text = string.format("×%.0f", 70 / ZOOMS[st.zoom]) end
    -- 仪表
    local em = st.em
    local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
    hpBar.Size = UDim2.fromScale(math.clamp(hp / mx, 0, 1), 1)
    hpBar.BackgroundColor3 = ui.hpColor(hp / mx)
    vName.Text = T("veh." .. d.id) .. ((vs.rest and vs.rest > 0) and ("   " .. T("ship.rest")) or "")
    local f = fwdOf(st.yaw)
    local hdg = math.floor((math.deg(math.atan2(f.X, -f.Z)) + 360) % 360 + 0.5) % 360
    local kn = math.floor(math.abs(st.speed) / 2.8 * 1.944 + 0.5)
    local rd = math.floor(math.abs(st.rudder) * 35 + 0.5)
    local rtxt = (rd == 0) and T("ship.mid") or T((st.rudder > 0) and "ship.right" or "ship.left", rd)
    info1.Text = T("ship.kn", kn) .. "    " .. T("ship.order." .. st.order) .. "    " .. rtxt .. "    " .. T("ship.hdg", hdg)
    local parts = {}
    local rel = 1
    if st.wi == 2 and d.missiles then
      table.insert(parts, "2  " .. T("sw." .. (d.missiles.name or "yj83")) .. "  " .. tostring(vs.msl or 0))
      rel = 1 - math.clamp((st.mslT - t) / 1.3, 0, 1)
    elseif d.guns[1] then
      local g = d.guns[1]
      local w = SD.W[g.w]
      table.insert(parts, "1  " .. T("sw." .. g.w) .. ((#d.guns > 1) and (" ×" .. #d.guns) or ""))
      rel = 1 - math.clamp(((st.next[1] or 0) - t) / math.max(w.rate, 0.01), 0, 1)
    end
    if d.sam then table.insert(parts, T("ship.sam", vs.sam or 0)) end
    if d.ciws and #d.ciws > 0 then table.insert(parts, T("ship.ciws")) end
    info2.Text = table.concat(parts, "    ")
    relBar.Size = UDim2.fromScale(rel, 1)
  end
end

return Sail
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="104">
          <Properties>
            <string name="Name">Scenery</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——地图上的石头：按离镜头的距离摆出来（只在本机，不挡子弹、不挡人和车）
--   用户：花草树木删掉，用 Roblox 自带的草更合适——树林、灌木、草丛、花丛不再摆（下面 LAYERS 只留 rock），草地上是地形自带的会动的草；
--   下面的说明是原来摆树林时写的，树的代码留着（LAYERS 里加回 "tree" 等就恢复）
--   长在哪由 Flora.lua 按格子算（每个人看到的一样）；这里管「画多少、画哪一版」：
--     针叶树近处（130 格内）是完整的树、中距离（210 格内）是作者给的简化版、再远到 1300 格是公告板（两片交叉的贴图；松树借冷杉的）；
--     阔叶树、枯树 540 格内、灌木倒木 300 格内、石头 480 格内；草丛 115 格内、花丛 135 格内；按画质设置整体放远 / 拉近（画质 6 时乘 0.9）
--     这样密林里原模型一共约两百万个三角形
--   模型：Studio 里导入了 models/scenery/scenery.glb（Imports.lua 收进 ReplicatedStorage.Imported.Scenery.<键>）就用原模型，
--     没导入用零件拼的（树干 + 几团球形树冠、石块；草不拼——地形草已经开了）
--   性能：同一种、同一档大小的模型放进对象池反复用（离开范围的挪到地下藏起来），一次 BulkMoveTo 挪完；每帧算格子、换模型都有上限
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Tint = require(script.Parent:WaitForChild("Tint"))   -- 导入的贴图没出来时的底色（原贴图的平均色）
local TURN = require(RS:WaitForChild("ImportTurn")).TURN   -- 导入的每块网格被 Roblox 转了半圈（ImportTurn.lua）：摆的时候转回来

local Scenery = {}

function Scenery.init(G)
  local Flora = require(RS:WaitForChild("Flora"))
  local META = require(RS:WaitForChild("SceneryMeta"))
  local V = Vector3.new
  local CF = CFrame.new
  local RGB = Color3.fromRGB
  local cam = workspace.CurrentCamera
  local CELL = Flora.CELL
  local HIDE = CF(0, -6000, 0)

  local folder = Instance.new("Folder")
  folder.Name = "Scenery"
  folder.Parent = workspace
  G.sceneryFolder = folder

  -- 画质（1～10；自动按 6）：距离整体乘 0.65～1.1
  local quality = 6
  pcall(function()
    local lvl = UserSettings():GetService("UserGameSettings").SavedQualityLevel
    local n = tonumber(string.match(tostring(lvl), "(%d+)$"))
    if n then quality = n end
  end)
  local K = 0.6 + quality * 0.05
  local D = { near = 130 * K, mid = 210 * K, far = 1300 * K, broad = 540 * K, bush = 300 * K, rock = 480 * K, grass = 115 * K, flower = 135 * K }
  -- 没有远景版本的针叶树：远处借身高差不多的冷杉公告板（松树 50 格高 → fir2_f，小冷杉 → fir5_f）
  local FAR_PROXY = { pine = "fir2_f", nfir = "fir5_f" }
  local LAYER_R = { tree = D.far, bush = D.bush, rock = D.rock, grass = D.grass, flower = D.flower }
  G.sceneryDist = D

  -- 这一株在这个距离画哪一版（nil = 不画）
  local function want(k, d)
    local m = META[k]
    if not m then return nil end
    local kind = m.kind
    if kind == "conifer" or kind == "young" then
      if d < D.near then return k end
      if d < D.mid then return META[k .. "_m"] and (k .. "_m") or k end
      local f = META[k .. "_f"] and (k .. "_f") or FAR_PROXY[k]
      if f then return (d < D.far) and f or nil end
      return (d < D.broad) and k or nil
    elseif kind == "broad" or kind == "dead" then return (d < D.broad) and k or nil
    elseif kind == "bush" or kind == "log" then return (d < D.bush) and k or nil
    elseif kind == "rock" or kind == "outcrop" then return (d < D.rock) and k or nil
    elseif kind == "grass" then return (d < D.grass) and k or nil
    elseif kind == "flower" then return (d < D.flower) and k or nil end
    return nil
  end

  ---------------------------------------------------------------- 模板：导入的原模型，或者零件拼的

  local templates = {}   -- [键] = { { p = 零件, rel = 相对这株原点的 CFrame }, … }（false = 这种不画）
  local function importedFolder()
    local imp = RS:FindFirstChild("Imported")
    return imp and imp:FindFirstChild("Scenery")
  end
  local function prepPart(p, shadow)
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
    p.CastShadow = shadow
  end
  -- 零件拼的：按种类、高、冠幅
  local TRUNK, NEEDLE, LEAF, BUSHC, ROCK = RGB(86, 66, 50), RGB(34, 58, 36), RGB(64, 96, 48), RGB(58, 84, 46), RGB(112, 110, 104)
  local function ball(list, d, c, color, mat)
    local p = Instance.new("Part")
    p.Shape = Enum.PartType.Ball
    p.Size = V(d, d, d)
    p.Color = color
    p.Material = mat or Enum.Material.Grass
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    table.insert(list, { p = p, rel = CF(c) })
  end
  local function trunk(list, h, dia, color)
    local p = Instance.new("Part")
    p.Shape = Enum.PartType.Cylinder
    p.Size = V(h, dia, dia)
    p.Color = color or TRUNK
    p.Material = Enum.Material.Wood
    table.insert(list, { p = p, rel = CF(0, h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2) })
  end
  local function fallback(k)
    local base = string.gsub(k, "_[mf]$", "")
    local m = META[base] or META[k]
    if not m then return false end
    local list = {}
    local h, r = m.h, m.r
    local kind = m.kind
    if kind == "conifer" or kind == "young" then
      trunk(list, h * 0.35, math.max(0.8, h * 0.035))
      for i = 0, 3 do   -- 下面大、上面小的几团：冷杉的样子
        local t = i / 3
        ball(list, r * 1.5 * (1 - t * 0.72), V(0, h * (0.32 + t * 0.48), 0), NEEDLE)
      end
    elseif kind == "broad" then
      trunk(list, h * 0.5, math.max(0.9, h * 0.03))
      ball(list, r * 1.3, V(0, h * 0.62, 0), LEAF)
      ball(list, r * 0.95, V(r * 0.35, h * 0.78, r * 0.2), LEAF)
      ball(list, r * 0.85, V(-r * 0.3, h * 0.74, -r * 0.25), LEAF)
    elseif kind == "dead" then
      trunk(list, h * 0.9, math.max(0.7, h * 0.025), RGB(96, 84, 72))
    elseif kind == "bush" then
      ball(list, r * 1.3, V(0, r * 0.45, 0), BUSHC)
      ball(list, r * 0.9, V(r * 0.4, r * 0.35, 0), BUSHC)
    elseif kind == "log" then
      local p = Instance.new("Part")
      p.Shape = Enum.PartType.Cylinder
      p.Size = V(r * 1.8, 1.6, 1.6)
      p.Color, p.Material = TRUNK, Enum.Material.Wood
      table.insert(list, { p = p, rel = CF(0, 0.8, 0) })
    elseif kind == "rock" or kind == "outcrop" then
      local n = (kind == "outcrop") and 3 or 1
      for i = 1, n do
        local p = Instance.new("Part")
        p.Size = V(r * 1.1, h * 0.9, r * 0.9) * ((i == 1) and 1 or 0.7)
        p.Color, p.Material = ROCK, Enum.Material.Rock
        table.insert(list, { p = p, rel = CF((i - 1) * r * 0.5, h * 0.4, (i % 2) * r * 0.3) * CFrame.Angles(0.2 * i, i, 0.15) })
      end
    elseif kind == "flower" and k == "flowers" then
      for i = 1, 6 do
        ball(list, 0.55, V(math.cos(i * 1.7) * r * 0.5, 0.7, math.sin(i * 2.3) * r * 0.5), RGB(236, 204, 40), Enum.Material.SmoothPlastic)
      end
    else
      return false   -- 草丛：零件拼不出来（地形草已经有了）
    end
    return list
  end
  -- 导入的原模型：各块按元数据里的中心找回这株的原点
  local function fromImport(k)
    local f = importedFolder()
    local src = f and f:FindFirstChild(k)
    local m = META[k]
    if not src or not m then return nil end
    local parts = {}
    for _, p in ipairs(src:GetChildren()) do
      if p:IsA("BasePart") then table.insert(parts, p) end
    end
    if #parts == 0 then return nil end
    -- 各块照元数据里的中心摆（相对这株的原点），再补回导入时转掉的半圈（ImportTurn.lua）——不用导入零件自己的位置和朝向
    local byName = {}
    for _, pm in ipairs(m.parts) do byName[pm.name] = pm end
    local list = {}
    for _, p in ipairs(parts) do
      local pm = byName[string.match(p.Name, "__([%w_]+)$") or ""]
      if pm then table.insert(list, { p = p, rel = CF(pm.c[1], pm.c[2], pm.c[3]) * TURN }) end
    end
    if #list == 0 then return nil end
    return list
  end
  local function template(k)
    local t = templates[k]
    if t == nil then
      t = fromImport(k) or fallback(k)
      templates[k] = t
    end
    return t
  end
  G.sceneryImported = function() local f = importedFolder() return f ~= nil and #f:GetChildren() > 0 end

  ---------------------------------------------------------------- 对象池（同一种、同一档大小）

  local pools = {}   -- [键 .. "#" .. 档] = { 实例, … }
  local nLive, nMade = 0, 0
  local function bucketOf(s) return math.clamp(math.floor((s - 0.85) / 0.15 + 0.5), 0, 2) end
  local function newInst(k, b)
    local t = template(k)
    if not t then return nil end
    local s = 0.85 + b * 0.15
    local kind = META[k] and META[k].kind or ""
    local shadow = (kind == "conifer" or kind == "broad" or kind == "rock" or kind == "outcrop") and quality >= 7
    local inst = { k = k, b = b, parts = {}, rels = {} }
    for i, it in ipairs(t) do
      local p = Tint.fix(it.p:Clone(), it.p)
      prepPart(p, shadow)
      p.Size = it.p.Size * s
      local r = it.rel
      inst.parts[i] = p
      inst.rels[i] = CF(r.Position * s) * (r - r.Position)
      p.CFrame = HIDE
      p.Parent = folder
    end
    nMade += 1
    return inst
  end
  local moveP, moveC = {}, {}
  local function queueMove(inst, cf)
    for i, p in ipairs(inst.parts) do
      moveP[#moveP + 1] = p
      moveC[#moveC + 1] = cf * inst.rels[i]
    end
  end
  local function take(k, s)
    local b = bucketOf(s)
    local key = k .. "#" .. b
    local pool = pools[key]
    local inst = pool and table.remove(pool)
    if not inst then inst = newInst(k, b) end
    if inst then nLive += 1 end
    return inst
  end
  local function give(inst)
    local key = inst.k .. "#" .. inst.b
    pools[key] = pools[key] or {}
    table.insert(pools[key], inst)
    queueMove(inst, HIDE)
    nLive -= 1
  end

  ---------------------------------------------------------------- 格子

  local cells = {}   -- [格子键] = { cx, cz, [层] = { 株, … } }
  local function cellKey(cx, cz) return cx * 100003 + cz end
  -- 用户：花草树木删掉，用 Roblox 地形自带的草（World.lua 开着 Terrain.Decoration，草地是 Grass 材质）——树、灌木、草丛、花丛都不摆了，只留石头
  local LAYERS = { "rock" }
  local maxR = 0
  for _, l in ipairs(LAYERS) do maxR = math.max(maxR, LAYER_R[l] or 0) end

  local lastPos, timer = nil, 0
  -- 自动画质（Fx.lua 的 G.perfK）：卡了树林画得近一点，流畅了再放远；变了就整片重挑一次
  local D0, curK = {}, 1
  for name, r in pairs(D) do D0[name] = r end
  local function applyK(k)
    curK = k
    for name, r in pairs(D0) do D[name] = r * k end
    LAYER_R.tree, LAYER_R.bush, LAYER_R.rock, LAYER_R.grass, LAYER_R.flower = D.far, D.bush, D.rock, D.grass, D.flower
    maxR = 0
    for _, l in ipairs(LAYERS) do maxR = math.max(maxR, LAYER_R[l] or 0) end
    lastPos = nil
  end
  local stats = { cells = 0, items = 0, live = 0, made = 0, genMs = 0 }
  G.sceneryStats = stats

  -- 车压着的草、花、灌木、石头不画（用户：坦克都卡在地底下——草丛一丛 2～3.5 格高、石头半埋，原来照样从车身里长出来，
  --   履带、车体下半截全被盖住，夜视里看着就像车陷在地里）。车的占地（长宽各放 3 格）按车头方向算；树不管（车从树林穿过去照旧）
  local FLAT_KIND = { grass = true, flower = true, bush = true, log = true, rock = true, outcrop = true }
  local flats = {}
  local function collectFlats(cp)
    table.clear(flats)
    for _, v in pairs(G.views or {}) do
      local d = v.def
      if v.kind == "veh" and d and v.cf and d.L and d.W then
        local p = v.cf.Position
        if math.abs(p.X - cp.X) < maxR and math.abs(p.Z - cp.Z) < maxR then
          local lv = v.cf.LookVector
          local fx, fz = lv.X, lv.Z
          local m = math.sqrt(fx * fx + fz * fz)
          if m > 1e-3 then fx, fz = fx / m, fz / m else fx, fz = 0, -1 end
          table.insert(flats, { x = p.X, z = p.Z, fx = fx, fz = fz, hl = d.L / 2 + 3, hw = d.W / 2 + 3, r = math.sqrt(d.L * d.L + d.W * d.W) / 2 + 9 })
        end
      end
    end
  end
  local function underVeh(it)
    if #flats == 0 then return false end
    local m = META[it.k]
    if not m or not FLAT_KIND[m.kind] then return false end
    local rr = math.min(4, (m.r or 2) * (it.s or 1) * 0.5)
    for _, f in ipairs(flats) do
      local dx, dz = it.x - f.x, it.z - f.z
      if math.abs(dx) < f.r and math.abs(dz) < f.r then
        local along = dx * f.fx + dz * f.fz
        local side = dx * f.fz - dz * f.fx
        if math.abs(along) < f.hl + rr and math.abs(side) < f.hw + rr then return true end
      end
    end
    return false
  end
  G.sceneryUnderVeh = underVeh

  -- 一次更新：镜头附近的格子按距离挑版本；超出范围的收回池里
  local function update(budgetMs)
    local cp = cam.CFrame.Position
    local t0 = os.clock()
    collectFlats(cp)
    local ccx, ccz = math.floor(cp.X / CELL), math.floor(cp.Z / CELL)
    local rc = math.ceil(maxR / CELL) + 1
    local changes = 0
    local seen = {}
    -- 由近到远：先摆近的（预算用完了远处下次再说）
    local order = {}
    for dz = -rc, rc do
      for dx = -rc, rc do
        local x0, z0 = (ccx + dx) * CELL, (ccz + dz) * CELL
        local ex = math.max(x0 - cp.X, 0, cp.X - (x0 + CELL))
        local ez = math.max(z0 - cp.Z, 0, cp.Z - (z0 + CELL))
        local d = math.sqrt(ex * ex + ez * ez)
        if d < maxR then table.insert(order, { ccx + dx, ccz + dz, d }) end
      end
    end
    table.sort(order, function(a, b) return a[3] < b[3] end)
    for _, o in ipairs(order) do
      local cx, cz, dCell = o[1], o[2], o[3]
      local key = cellKey(cx, cz)
      seen[key] = true
      local c = cells[key]
      if not c then
        c = { cx = cx, cz = cz }
        cells[key] = c
      end
      for _, layer in ipairs(LAYERS) do
        if dCell < LAYER_R[layer] then
          local list = c[layer]
          if not list and os.clock() - t0 < budgetMs / 1000 then
            local g0 = os.clock()
            list = Flora.cell(cx, cz, layer)
            stats.genMs += (os.clock() - g0) * 1000
            c[layer] = list
            stats.items += #list
          end
          if list then
            for _, it in ipairs(list) do
              local dx, dz = it.x - cp.X, it.z - cp.Z
              local dy = (it.y - cp.Y) * 0.5   -- 天上往下看：高度算一半（飞机上看地面不至于全变公告板）
              local d = math.sqrt(dx * dx + dz * dz + dy * dy)
              local w = want(it.k, d)
              if w and underVeh(it) then w = nil end   -- 车压着：先收起来，车开走了下一次更新再摆回去
              if w ~= it.cur then
                if changes < 400 then
                  if it.inst then give(it.inst) it.inst = nil end
                  if w then
                    local inst = take(w, it.s)
                    if inst then
                      queueMove(inst, CF(it.x, it.y, it.z) * CFrame.Angles(0, it.yaw, 0))
                      it.inst = inst
                    end
                  end
                  it.cur = w
                  changes += 1
                end
              end
            end
          end
        elseif c[layer] then   -- 这一层超出范围：全收回
          for _, it in ipairs(c[layer]) do
            if it.inst then give(it.inst) it.inst = nil end
            it.cur = nil
          end
        end
      end
    end
    -- 远得不在范围里的格子：收回、扔掉（再回来重新算）
    for key, c in pairs(cells) do
      if not seen[key] then
        for _, layer in ipairs(LAYERS) do
          for _, it in ipairs(c[layer] or {}) do if it.inst then give(it.inst) it.inst = nil end end
        end
        cells[key] = nil
      end
    end
    if #moveP > 0 then
      workspace:BulkMoveTo(moveP, moveC, Enum.BulkMoveMode.FireCFrameChanged)
      table.clear(moveP)
      table.clear(moveC)
    end
    local n = 0
    for _ in pairs(cells) do n += 1 end
    stats.cells, stats.live, stats.made = n, nLive, nMade
    -- 按版本数：摆出来多少株、原模型的话一共多少三角形（调距离用）
    local byKey, tris = {}, 0
    for _, c in pairs(cells) do
      for _, layer in ipairs(LAYERS) do
        for _, it in ipairs(c[layer] or {}) do
          if it.cur then
            byKey[it.cur] = (byKey[it.cur] or 0) + 1
            tris += (META[it.cur] and META[it.cur].tris or 0)
          end
        end
      end
    end
    stats.byKey, stats.tris = byKey, tris
    return changes
  end
  G.sceneryUpdate = update

  ---------------------------------------------------------------- 远海
  -- 地形的海水只灌到 ±Map.R；再往外是跟着镜头走的一圈平面（11 × 11 块，每块 2048 格，镜头外一万格以上，盖过雾的尽头 8500）：飞到哪都看得到海一直铺到天边，
  --   不用在服务器上摆一大片（用户：海洋过于小了）。块按 2048 的格子对齐，地形海水那一片里的不摆（不和地形水面打架）
  local Map = G.Map
  local OS, ON = 2048, 7   -- 15 × 15 块：镜头外一万五千格（地形海水铺到 ±SEA_R 以后，这圈平面只在作战区边上才看得到）
  local ocean = Instance.new("Folder")
  ocean.Name = "Ocean"
  ocean.Parent = workspace
  local tiles = {}
  for i = 1, (2 * ON + 1) ^ 2 do
    local p = Instance.new("Part")
    p.Name = "Sea"
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Size = V(OS, 1, OS)
    p.Material = Enum.Material.SmoothPlastic   -- 原来是半透明玻璃：要折射，铺满半个屏幕最费（用户：太卡了）；夜里不透明的看着一样
    p.Color = RGB(24, 84, 102)   -- 往地形海水的颜色靠（Terrain.WaterColor 30, 112, 136 透过深水看暗一些）
    p.Reflectance = 0.22
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    tiles[i] = p
  end
  local seaKey = nil
  local RI = math.floor((Map.SEA_R or Map.R or 4096) / OS)   -- 地形海水占了 [−RI, RI) 这些格（近海 ±R 深水 + 外面 ±SEA_R 一圈薄水，World.lua）
  local function stepOcean()
    local c = cam.CFrame.Position
    local gx, gz = math.floor(c.X / OS), math.floor(c.Z / OS)
    local key = gx * 65536 + gz
    if key == seaKey then return end
    seaKey = key
    local n = 0
    for i = gx - ON, gx + ON do
      for k = gz - ON, gz + ON do
        n += 1
        local p = tiles[n]
        if i >= -RI and i < RI and k >= -RI and k < RI then
          p.Parent = nil
        else
          p.CFrame = CF((i + 0.5) * OS, -0.6, (k + 0.5) * OS)
          p.Parent = ocean
        end
      end
    end
  end
  G.oceanTiles = function()
    local n = 0
    for _, p in ipairs(tiles) do if p.Parent then n += 1 end end
    return n
  end

  -- 每帧：镜头挪了 10 格以上、或者过了 0.3 秒，更新一次（每次最多 4 毫秒算格子、400 处换模型）
  function G.stepScenery(dt)
    stepOcean()
    local pk = G.perfK or 1
    if math.abs(pk - curK) > 0.01 then applyK(pk) end
    timer += dt
    local cp = cam.CFrame.Position
    if (lastPos and (cp - lastPos).Magnitude < 10 and timer < 0.3) then return end
    if timer < 0.08 then return end
    timer = 0
    lastPos = cp
    update(4)
  end
  local _ = Players
end

return Scenery
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="105">
          <Properties>
            <string name="Name">Scope</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——瞄准镜（客户端）：狙击镜、望远镜开镜后的光学目镜（替换原来 Play 里四块黑板围出的方框）
--   用户：瞄准镜第一人称太粗糙、要有光学效果，而且居然不是圆的而是多边形
--   出瞳是正圆：Frame + UICorner 成圆，外面一圈特别粗的黑描边把四周盖住（同夜视仪的镜筒）。狙击镜两个圆叠着——
--     A 是目镜的视场光阑（边利、渐暗带窄），B 是眼睛的出瞳（大一点、渐暗带宽）：眼睛对正时 B 在 A 外面；镜子一晃、转得快、走路、开枪、
--     刚贴上目镜时两个圆错开，看得见的是两圆相交那块，边上一道月牙形的「镜内阴影」
--   边缘渐暗：一圈圈半透明黑描边叠出来（UI 没有径向渐变）；红、蓝两道细圈朝相反方向错开一点，是边上的色散彩边
--   镜片：镀膜的淡色、左上一道反光弧（描边挂渐变，只露一段）、镜头里有月亮时的眩光（光源和画面中心的连线上一串彩色鬼影、一道横向拉丝）
--   开镜：先黑一下（眼睛贴上目镜），出瞳从小变大，画面从糊到清楚（对焦）；滚轮变倍、开枪时也轻轻糊一下
--   分划在第二焦平面（大小不随倍率变）：狙击镜是密位点 + 四根粗柱，中心红点夜里发光（开着夜视仪时调暗）；
--     望远镜：两个圆并排（左右各按半边屏幕裁开，正好是两圆的并集，中间上下两个尖角）、测距框和密位刻度，底下一行琥珀色的距离 / 方位 / 倍率
--   手稳：呼吸晃，按住 Shift 屏住（稳几秒，憋过头晃得更厉害、一会儿屏不了），走动晃得多；晃动加在镜头上（子弹照样打屏幕正中），
--     镜头转得快、开枪时出瞳跟着偏；倍率高时鼠标灵敏度跟着降
--   别人开着镜对着你（他的视线在你附近 20° 以内）时他的镜片闪光：服务器只记 Scoped / ScopeDir 两个属性，闪光是看的人本地画的、墙挡得住
--   步枪（M4）上装的 ACOG（kind acog）：固定 3.5 倍、TA31 的红色箭形分划和测距线，不屏息、不闪镜片（用户：武器瞄准没有镜子）
--   Play 调：G.scopeStep(dt, 开没开, 武器表) 每帧、G.scopeZoom(武器表) 现在的倍率、G.scopeFire() 开了一枪
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local CAS = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")

local Scope = {}

function Scope.init(G)
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local RGB, V2 = Color3.fromRGB, Vector2.new
  local now = os.clock
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local BLACK = RGB(0, 0, 0)

  ---------------------------------------------------------------- 界面零件

  local gui = Instance.new("ScreenGui")
  gui.Name = "Scope"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = -1   -- 在主界面（弹药、命中标记）下面、夜视仪镜筒上面
  gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local function fr(parent, z, color, alpha)
    local f = Instance.new("Frame")
    f.AnchorPoint = V2(0.5, 0.5)
    f.BackgroundColor3 = color or BLACK
    f.BackgroundTransparency = (alpha == nil) and 0 or alpha
    f.BorderSizePixel = 0
    f.ZIndex = z or 1
    f.Parent = parent
    return f
  end
  local function round(f)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0.5, 0)
    c.Parent = f
    return f
  end
  local function ring(f, th, color, alpha)
    local s = Instance.new("UIStroke")
    s.Thickness, s.Color, s.Transparency = th, color, alpha
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
  end
  local function grad(parent, rot, keys)   -- 透明度渐变：keys = { { 位置, 透明度 }, … }
    local g = Instance.new("UIGradient")
    g.Rotation = rot
    local seq = {}
    for _, k in ipairs(keys) do table.insert(seq, NumberSequenceKeypoint.new(k[1], k[2])) end
    g.Transparency = NumberSequence.new(seq)
    g.Parent = parent
    return g
  end
  local function at(f, x, y) f.Position = UDim2.fromOffset(x, y) end
  local function sz(f, w, h) f.Size = UDim2.fromOffset(w, h or w) end

  local root = Instance.new("Frame")
  root.Size = UDim2.fromScale(1, 1)
  root.BackgroundTransparency = 1
  root.Parent = gui

  -- 一个圆形出瞳：容器（D × D）里一个圆，外面 3200 像素的黑描边盖住四周；里面 n 圈半透明黑描边叠成边缘渐暗
  --   band 渐暗带占直径的比例，k 最外一圈的不透明度，pw 往里衰减的指数
  local function aperture(parent, z, n, band, k, pw)
    local box = fr(parent, z, BLACK, 1)
    local mask = round(fr(box, z, BLACK, 1))
    mask.Position, mask.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
    ring(mask, 3200, BLACK, 0)
    local rings = {}
    for i = 1, n do
      local f = round(fr(box, z, BLACK, 1))
      f.Position = UDim2.fromScale(0.5, 0.5)
      rings[i] = { f = f, s = ring(f, 1, BLACK, 1 - k * (1 - (i - 1) / n) ^ pw) }
    end
    return { box = box, rings = rings, band = band, d = -1 }
  end
  local function sizeAp(ap, D)   -- 按像素直径摆渐暗圈（直径变了才重摆）；圈宽取整、一圈挨一圈（叠起来的地方会多出一道细纹）
    D = math.floor(D / 2 + 0.5) * 2
    if ap.d == D then return end
    ap.d = D
    sz(ap.box, D)
    local n = #ap.rings
    local w = math.max(1, math.floor(D * ap.band / n + 0.5))
    for i, r in ipairs(ap.rings) do
      sz(r.f, math.max(2, D - 2 * i * w))
      r.s.Thickness = w
    end
  end

  ---------------------------------------------------------------- 层（从下往上）：镜片 → 分划 → 眩光 → 出瞳 B → 出瞳 A → 色散彩边 → 黑场 → 读数

  -- 镜片：镀膜的淡色、反光弧（狙击镜跟着出瞳 A 走）
  local lens = fr(root, 1, BLACK, 1)
  local tint = round(fr(lens, 1, RGB(18, 34, 44), 0.93))
  tint.Position, tint.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
  grad(tint, 90, { { 0, 0.4 }, { 0.5, 0.75 }, { 1, 0.15 } })   -- 上下边色深一点
  local glare = round(fr(lens, 1, BLACK, 1))
  glare.Position, glare.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.9, 0.9)
  local glareS = ring(glare, 3, RGB(235, 245, 255), 0)
  grad(glareS, 45, { { 0, 1 }, { 0.1, 0.86 }, { 0.2, 0.8 }, { 0.3, 0.93 }, { 0.4, 1 }, { 1, 1 } })   -- 只左上露一段
  local glare2 = round(fr(lens, 1, BLACK, 1))   -- 右下一道暖色的弱反光
  glare2.Position, glare2.Size = UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.8, 0.8)
  local glare2S = ring(glare2, 2, RGB(255, 214, 160), 0)
  grad(glare2S, 45, { { 0, 1 }, { 0.72, 1 }, { 0.84, 0.9 }, { 0.94, 1 }, { 1, 1 } })

  -- 分划：容器在屏幕正中（子弹打这儿），零件位置按直径的比例，布置在 layoutRet 里
  local ret = fr(root, 2, BLACK, 1)
  local retParts = {}   -- { f, x, y, w, h（直径的比例；w / h 小于 0 是像素数）, kind }
  local function rp(kind, x, y, w, h, color, alpha, isRound)
    local f = fr(ret, 2, color, alpha)
    if isRound then round(f) end
    table.insert(retParts, { f = f, x = x, y = y, w = w, h = h, kind = kind, a0 = alpha })
    return f
  end
  local RC = RGB(6, 6, 6)            -- 刻线
  local RED = RGB(255, 46, 30)       -- 发光的中心
  local AMB = RGB(255, 160, 52)      -- 望远镜的琥珀色读数
  local RCI = RGB(150, 26, 18)        -- 照明分划：暗红（夜里能看清，不刺眼）
  -- 狙击镜分划（第一焦平面，同这具 ATACR F1：刻线跟倍率一起放大缩小，1 密位在目标上永远是 1 米 / 千米）：
  --   细十字贯穿；每 1 密位一个刻度（5、10 长一点），倍率高时加半密位；10 密位以外是粗柱；右边、下边标 2 4 6 8；
  --   中心下面一组提前量 / 风偏点（倍率够高才画）；中心 ±2 密位那段细十字和中心点夜里发暗红光
  --   零件位置是「密位」，layoutFfp 按现在每密位多少像素摆；mw / mh 宽高（密位，0 = 只按像素下限），pw / ph 像素下限，need 每密位至少几像素才画
  local ffp = {}
  local function fe(x, y, mw, mh, pw, ph, need, color, alpha, isRound, lit)
    local f = fr(ret, 2, color or RC, alpha or 0)
    if isRound then round(f) end
    table.insert(ffp, { f = f, x = x, y = y, mw = mw, mh = mh, pw = pw, ph = ph, need = need or 0, lit = lit })
    return f
  end
  fe(0, 0, 400, 0, 0, 1)
  fe(0, 0, 0, 400, 1, 0)
  fe(0, 0, 4, 0, 0, 1, 0, RCI, 0.05, false, true)   -- 中心发光的一段
  fe(0, 0, 0, 4, 1, 0, 0, RCI, 0.05, false, true)
  for _, sgn in ipairs({ -1, 1 }) do
    fe(sgn * 60, 0, 100, 0.32, 0, 3)   -- 粗柱：10 密位以外
    fe(0, sgn * 60, 0.32, 100, 3, 0)
    for i = 1, 10 do
      local big = i % 5 == 0
      local L = big and 0.9 or 0.5
      local tx = fe(sgn * i, 0, 0, L, 1, big and 5 or 3)
      local ty = fe(0, sgn * i, L, 0, big and 5 or 3, 1)
      if sgn > 0 then tx.Name, ty.Name = "MilX" .. i, "MilY" .. i end   -- 测试按名字找（第 i 个密位的刻度）
      fe(sgn * (i - 0.5), 0, 0, 0.25, 1, 2, 9)   -- 半密位
      fe(0, sgn * (i - 0.5), 0.25, 0, 2, 1, 9)
    end
  end
  local ffpNum = {}
  for _, v in ipairs({ 2, 4, 6, 8 }) do
    for _, axis in ipairs({ "x", "y" }) do
      local l = Instance.new("TextLabel")
      l.AnchorPoint = V2(0.5, 0.5)
      l.BackgroundTransparency = 1
      l.Font = Enum.Font.RobotoMono
      l.TextColor3 = RC
      l.Text = tostring(v)
      l.ZIndex = 2
      l.Size = UDim2.fromOffset(24, 16)
      l.Parent = ret
      table.insert(ffpNum, { l = l, x = (axis == "x") and v or -0.95, y = (axis == "x") and 0.95 or v })
    end
  end
  for j = 2, 6 do   -- 中心下面的提前量 / 风偏点
    for i = 1, j - 1 do
      fe(-i, j, 0.1, 0.1, 2, 2, 11, RC, 0, true)
      fe(i, j, 0.1, 0.1, 2, 2, 11, RC, 0, true)
    end
  end
  local dot = fe(0, 0, 0.16, 0.16, 3, 3, 0, RED, 0.08, true, true)
  local glow = fe(0, 0, 0.5, 0.5, 9, 9, 0, RED, 0.82, true, true)
  local ffpK = -1
  local function layoutFfp(k)   -- k：每密位多少像素
    if math.abs(k - ffpK) < ffpK * 0.004 then return end
    ffpK = k
    for _, e in ipairs(ffp) do
      e.f.Visible = k >= e.need
      if e.f.Visible then
        sz(e.f, math.max(e.pw, math.floor(e.mw * k + 0.5)), math.max(e.ph, math.floor(e.mh * k + 0.5)))
        at(e.f, math.floor(e.x * k + 0.5), math.floor(e.y * k + 0.5))
      end
    end
    local ts = math.clamp(math.floor(k * 0.55), 10, 15)
    for _, n in ipairs(ffpNum) do
      n.l.Visible = k >= 7
      n.l.TextSize = ts
      at(n.l, math.floor(n.x * k + 0.5), math.floor(n.y * k + 0.5))
    end
  end
  -- 望远镜：测距框（四个角）、中心小十字（中间空着）、下面一条密位刻度
  for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
    rp("ba", c[1] * 0.04 - c[1] * 0.008, c[2] * 0.04, 0.016, -1, AMB, 0.12)
    rp("ba", c[1] * 0.04, c[2] * 0.04 - c[2] * 0.008, -1, 0.016, AMB, 0.12)
  end
  for _, c in ipairs({ { -0.013, 0, 0.012, -1 }, { 0.013, 0, 0.012, -1 }, { 0, -0.013, -1, 0.012 }, { 0, 0.013, -1, 0.012 } }) do
    rp("b", c[1], c[2], c[3], c[4], AMB, 0.2)
  end
  rp("b", 0, 0.1, 0.4, -1, AMB, 0.45)
  for k = -10, 10 do
    local big = k % 5 == 0
    rp("b", k * 0.02, 0.1 - (big and 0.012 or 0.006), -1, big and 0.024 or 0.012, AMB, big and 0.3 or 0.5)
  end
  local function layoutRet(D, kind)   -- 望远镜的刻线（按直径的比例）
    local t1 = math.max(1, math.floor(D / 700 + 0.5))
    local t2 = math.max(4, math.floor(D / 95 + 0.5))
    for _, p in ipairs(retParts) do
      local mine = kind == "binoc"
      p.f.Visible = mine
      if mine then
        local px = function(v) if v >= 0 then return math.max(1, math.floor(v * D + 0.5)) end return (v == -3) and t2 or t1 end
        local w, h = px(p.w), px(p.h)
        sz(p.f, w, h)
        at(p.f, math.floor(p.x * D + 0.5), math.floor(p.y * D + 0.5))
      end
    end
  end

  -- 步枪上的 ACOG（Trijicon TA31 的箭形分划，第二焦平面：大小按出瞳直径的比例，不随倍率变）：中心一个红色发光的箭形（尖是瞄准点），
  --   下面一根细竖线挂着 400～800 米的测距横线（越远越短，正好是人肩宽），左右各一段横线（不到中心）
  local acogRet = fr(root, 2, BLACK, 1)
  local acog = {}   -- { f, x, y, w, h（直径的比例；负数是像素），lit 发光的、a0 原来的透明度 }
  local function ae(x, y, w, h, color, alpha, rot, lit)
    local f = fr(acogRet, 2, color or RC, alpha or 0)
    if rot then f.Rotation = rot end
    table.insert(acog, { f = f, x = x, y = y, w = w, h = h, lit = lit, a0 = alpha or 0 })
    return f
  end
  do
    local CH, CA = 0.042, 50   -- 箭形每边多长（直径的比例）、和竖直方向的夹角（度）
    local sa, ca = math.sin(math.rad(CA)), math.cos(math.rad(CA))
    local CR = RGB(255, 52, 36)
    for _, k in ipairs({ { -10, 1.16, 0.84 }, { -4, 1, 0.02 } }) do   -- 先画一圈晕光、再画箭形本身
      ae(CH * 0.5 * sa, CH * 0.5 * ca, k[1], CH * k[2], CR, k[3], -CA, true)
      ae(-CH * 0.5 * sa, CH * 0.5 * ca, k[1], CH * k[2], CR, k[3], CA, true)
    end
    local y0, y1 = CH * ca + 0.012, 0.19
    ae(0, (y0 + y1) / 2, -1, y1 - y0, RC, 0.1)
    for _, v in ipairs({ { 0.07, 0.05 }, { 0.1, 0.041 }, { 0.13, 0.034 }, { 0.16, 0.028 }, { 0.19, 0.023 } }) do ae(0, v[1], v[2], -2, RC, 0.08) end
    ae(-0.3, 0, 0.4, -2, RC, 0.04)
    ae(0.3, 0, 0.4, -2, RC, 0.04)
  end
  local function layoutAcog(D)
    for _, e in ipairs(acog) do
      local w = (e.w >= 0) and math.max(1, math.floor(e.w * D + 0.5)) or -e.w
      local h = (e.h >= 0) and math.max(1, math.floor(e.h * D + 0.5)) or -e.h
      sz(e.f, w, h)
      at(e.f, math.floor(e.x * D + 0.5), math.floor(e.y * D + 0.5))
    end
  end

  -- 出瞳：狙击镜 A（视场光阑）、B（眼睛的出瞳）；望远镜左右两个（各在半边屏幕的裁剪框里）
  local apB = aperture(root, 4, 12, 0.13, 0.95, 1.6)
  local apA = aperture(root, 5, 10, 0.075, 0.92, 2.2)
  local clipL = fr(root, 5, BLACK, 1)
  clipL.AnchorPoint, clipL.ClipsDescendants = V2(0, 0), true
  local clipR = fr(root, 5, BLACK, 1)
  clipR.AnchorPoint, clipR.ClipsDescendants = V2(0, 0), true
  local apL = aperture(clipL, 5, 10, 0.09, 0.93, 2.0)
  local apR = aperture(clipR, 5, 10, 0.09, 0.93, 2.0)
  local tintL = round(fr(clipL, 4, RGB(40, 34, 18), 0.94))   -- 望远镜的镀膜偏暖
  local tintR = round(fr(clipR, 4, RGB(40, 34, 18), 0.94))

  -- 色散彩边：出瞳 A 边上一红一蓝两道细圈，朝相反方向错开
  local caR = round(fr(root, 6, BLACK, 1))
  local caRs = ring(caR, 2, RGB(255, 90, 50), 0.55)
  local caB = round(fr(root, 6, BLACK, 1))
  local caBs = ring(caB, 2, RGB(70, 120, 255), 0.5)

  -- 开镜时黑一下
  local blackout = fr(root, 8, BLACK, 1)
  blackout.AnchorPoint, blackout.Size = V2(0, 0), UDim2.fromScale(1, 1)

  -- 读数：狙击镜在出瞳右边的黑处写倍率、下面一条屏息条；望远镜在视野底部写距离 · 方位 · 倍率（琥珀色）
  local function txt(z, size, color)
    local l = Instance.new("TextLabel")
    l.AnchorPoint = V2(0.5, 0.5)
    l.BackgroundTransparency = 1
    l.Font = Enum.Font.Code
    l.TextColor3 = color
    l.TextSize = size
    l.ZIndex = z
    l.Size = UDim2.fromOffset(520, size + 6)
    l.Parent = root
    return l
  end
  local zoomT = txt(9, 18, RGB(150, 156, 152))
  local breathBg = fr(root, 9, RGB(60, 64, 62), 0.35)
  local breathFill = fr(breathBg, 9, RGB(200, 206, 200), 0.1)
  breathFill.AnchorPoint = V2(0.5, 1)
  breathFill.Position = UDim2.fromScale(0.5, 1)
  local lrfT = txt(9, 18, AMB)
  lrfT.TextStrokeTransparency, lrfT.TextStrokeColor3 = 0.6, RGB(80, 30, 0)

  -- 手机：变倍按钮
  local zin, zout
  if UIS.TouchEnabled then
    local function zb(text)
      local b = Instance.new("TextButton")
      b.AnchorPoint = V2(0.5, 0.5)
      b.Size = UDim2.fromOffset(46, 46)
      b.BackgroundColor3 = RGB(18, 20, 22)
      b.BackgroundTransparency = 0.25
      b.BorderSizePixel = 0
      b.Text = text
      b.TextColor3 = RGB(220, 224, 220)
      b.TextSize = 24
      b.Font = Enum.Font.GothamMedium
      b.ZIndex = 9
      b.Parent = root
      round(b)
      ring(b, 1, RGB(255, 255, 255), 0.8)
      return b
    end
    zin, zout = zb("+"), zb("−")
  end

  ---------------------------------------------------------------- 本地画面效果：开镜对焦的模糊、镜片调色

  local blur = Instance.new("BlurEffect")
  blur.Name = "ScopeFocus"
  blur.Size = 0
  blur.Enabled = false
  blur.Parent = Lighting
  local cc = Instance.new("ColorCorrectionEffect")
  cc.Name = "ScopeGrade"
  cc.Contrast, cc.Saturation, cc.Brightness, cc.TintColor = 0.07, 0.08, 0.015, RGB(247, 251, 255)
  cc.Enabled = false
  cc.Parent = Lighting

  ---------------------------------------------------------------- 状态

  local KINDS = {
    sniper = { zooms = { 7, 10, 14, 20, 27, 35 }, sway = 0.0017, def = 10 },   -- 这具 ATACR 是 7–35 倍
    acog = { zooms = { 3.5 }, sway = 0.0008, def = 3.5 },   -- 步枪上的 ACOG：固定 3.5 倍，倍率低、晃得少
    binoc = { zooms = { 4, 6, 8, 10 }, sway = 0.0011, def = 8 },
  }
  local S = {
    kind = nil, t0 = 0, zi = {}, eye = V2(), eyeV = V2(), ang = V2(), breath = 1, hold = false, tired = 0,
    swayP = 0, swayY = 0, appP = 0, appY = 0, prev = nil, vs = V2(), blurK = 0, sens = nil, sendT = 0, sentDir = nil,
    lrfT = 0, phase = 0,
  }
  G.scopeOn = false

  local function kindOf(w)
    if w and w.kind == "spot" then return "binoc" end
    if w and w.optic == "acog" then return "acog" end
    return "sniper"
  end
  local function zoomIndex(kind, want)
    local K, best, bd = KINDS[kind], 1, 1e9
    for i, z in ipairs(K.zooms) do
      if math.abs(z - want) < bd then best, bd = i, math.abs(z - want) end
    end
    return best
  end
  function G.scopeZoom(w)
    local kind = kindOf(w)
    if not S.zi[kind] then S.zi[kind] = zoomIndex(kind, KINDS[kind].def) end
    return KINDS[kind].zooms[S.zi[kind]]
  end
  local function changeZoom(d)
    local kind = S.kind
    if not kind then return end
    local K = KINDS[kind]
    local i = math.clamp((S.zi[kind] or zoomIndex(kind, K.def)) + d, 1, #K.zooms)
    if i == S.zi[kind] then return end
    S.zi[kind] = i
    S.blurK = math.max(S.blurK, 4)   -- 变倍时像糊一下再对上焦
    if G.playSound then G.playSound("quiet", nil, 1.9) end
  end

  local function onHold(_, state)
    if state == Enum.UserInputState.Begin then S.hold = true
    elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then S.hold = false end
    return Enum.ContextActionResult.Sink   -- 别让 Shift 去切 Roblox 的视角锁定
  end

  local D, Db = 0, 0   -- 狙击镜出瞳直径、望远镜每个圆的直径（像素）
  local function layout(kind)
    local vs = cam.ViewportSize
    S.vs = vs
    D = math.min(vs.X, vs.Y) * 0.96
    Db = math.min(vs.Y * 0.86, vs.X * 0.5)
    local Dr = (kind == "binoc") and Db * 1.1 or D
    layoutRet(Dr, kind)
    at(ret, vs.X / 2, vs.Y / 2)
    sz(ret, 0)
    ret.Visible = kind ~= "acog"
    acogRet.Visible = kind == "acog"
    if kind == "acog" then
      layoutAcog(D)
      at(acogRet, vs.X / 2, vs.Y / 2)
      sz(acogRet, 0)
    end
    local big = kind ~= "binoc"
    apA.box.Visible, apB.box.Visible, lens.Visible, caR.Visible, caB.Visible = big, big, big, big, big
    clipL.Visible, clipR.Visible = not big, not big
    sizeAp(apL, Db)
    sizeAp(apR, Db)
    sz(tintL, Db)
    sz(tintR, Db)
    zoomT.TextSize = math.max(14, math.floor(D / 48))
    lrfT.TextSize = math.max(14, math.floor(Db / 40))
    zoomT.Visible, breathBg.Visible = kind == "sniper", kind == "sniper"   -- ACOG 是定倍的、也不用屏息
    lrfT.Visible = not big
    if zin then   -- 手机：变倍按钮在镜子左边（右边是开火键、小地图）
      local bx = math.max(36, vs.X / 2 - Dr / 2 - 40)
      zin.Visible, zout.Visible = kind ~= "acog", kind ~= "acog"
      at(zin, bx, vs.Y / 2 - 78)
      at(zout, bx, vs.Y / 2 - 24)
    end
  end

  local function sendState(on)
    pcall(function() G.R.Act:FireServer("scope", on, on and cam.CFrame.LookVector or nil) end)
  end

  local function enter(kind)
    S.kind = kind
    S.t0 = now()
    G.scopeOn = true
    layout(kind)
    S.eye = V2(0, (kind == "binoc" and Db or D) * 0.16)   -- 刚贴上目镜：出瞳从下面进来
    S.eyeV = V2()
    S.blurK = 0
    S.prev, S.lastP = nil, nil
    gui.Enabled = true
    blur.Enabled, cc.Enabled = true, true
    if G.mapRoot then G.mapRoot.Visible = false end   -- 开着镜不画小地图（手机上它会挡住半个目镜）
    if not S.sens then pcall(function() S.sens = UIS.MouseDeltaSensitivity end) end
    if kind ~= "acog" then   -- 步枪的 ACOG：Shift 留给别的（不屏息）；也不告诉服务器（人人端枪都闪镜片就没意思了，闪光只留给狙击镜、望远镜）
      pcall(function()
        CAS:BindActionAtPriority("ScopeHoldBreath", onHold, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonL3)
      end)
      S.sendT, S.sentDir = now(), cam.CFrame.LookVector
      sendState(true)
    end
    if G.playSound then G.playSound("quiet", nil, 1.1) end
  end

  local function exit()
    local was = S.kind
    S.kind = nil
    G.scopeOn = false
    gui.Enabled = false
    blur.Enabled, cc.Enabled = false, false
    blur.Size = 0
    if G.mapRoot then G.mapRoot.Visible = true end
    S.hold = false
    if S.sens then
      local v = S.sens
      pcall(function() UIS.MouseDeltaSensitivity = v end)
      S.sens = nil
    end
    pcall(function() CAS:UnbindAction("ScopeHoldBreath") end)
    if was ~= "acog" then sendState(false) end
  end

  function G.scopeFire()
    if not S.kind then return end
    local d = (S.kind == "binoc") and Db or D
    S.eyeV += V2((math.random() - 0.5) * 0.5 * d, 2.2 * d)   -- 后坐：镜子往后往上一跳，出瞳往下甩
    S.blurK = math.max(S.blurK, 5)
  end

  ---------------------------------------------------------------- 每帧（Play 调）

  local function moonOnScreen()
    local ok, dir = pcall(function() return Lighting:GetMoonDirection() end)
    if not ok or typeof(dir) ~= "Vector3" or dir.Y < -0.05 then return nil end
    local p, vis = cam:WorldToViewportPoint(cam.CFrame.Position + dir * 5000)
    if not vis or p.Z <= 0 then return nil end
    return V2(p.X, p.Y)
  end

  local function bearing(look)
    local deg = math.deg(math.atan2(look.X, -look.Z)) % 360   -- 北是 −Z、东是 +X（同地图）
    return deg, T("dir." .. (math.floor((deg + 22.5) / 45) % 8))
  end

  local rayP = RaycastParams.new()
  rayP.FilterType = Enum.RaycastFilterType.Exclude

  function G.scopeStep(dt, on, w)
    if on and G.fpsOpticPending and G.fpsOpticPending() then on = false end   -- 第一人称还在把真瞄准镜举到眼前：举到了再换成目镜里的像
    local kind = on and kindOf(w) or nil
    if kind ~= S.kind then
      if S.kind then exit() end
      if kind then enter(kind) end
    end
    if not kind then return end
    dt = math.clamp(dt or 1 / 60, 1 / 240, 0.1)
    local t = now()
    local vs = cam.ViewportSize
    if vs ~= S.vs then layout(kind) end
    local K = KINDS[kind]
    local zoom = G.scopeZoom(w)
    local cx, cy = vs.X / 2, vs.Y / 2
    local d = (kind == "binoc") and Db or D

    -- 呼吸、屏息、走动 → 晃动幅度
    local ch = me.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local spd = 0   -- 走多快：按位置变化算（同 FPSView）
    if hrp then
      local p = hrp.Position
      if S.lastP then spd = V2(p.X - S.lastP.X, p.Z - S.lastP.Z).Magnitude / dt end
      S.lastP = p
      spd = math.min(spd, 40)
    end
    local move = math.clamp(spd / 16, 0, 1.5)
    local amp = K.sway * (1 + move * 2.5)
    if S.tired > 0 then
      S.tired -= dt
      amp *= 2.2
      S.breath = math.min(1, S.breath + dt / 6)
    elseif S.hold and S.breath > 0 and kind == "sniper" then
      S.breath -= dt / 5
      amp *= 0.12
      if S.breath <= 0 then S.breath, S.tired = 0, 2.5 end
    else
      S.breath = math.min(1, S.breath + dt / 4)
    end
    if UIS.TouchEnabled and not UIS.KeyboardEnabled then amp *= 0.6 end
    local tt = t * 6.2832
    S.swayP = amp * (math.sin(tt * 0.21) + 0.9 * math.noise(t * 0.7, 3.1))
    S.swayY = amp * 0.7 * (math.sin(tt * 0.13 + 1.1) + 1.0 * math.noise(t * 0.6, 7.7))

    -- 出瞳的偏移（弹簧）：镜头转得快 → 落后；走路一颠一颠；呼吸带一点
    S.phase += dt * spd * 0.55
    local target = V2(-S.ang.X, S.ang.Y) * 0.05 * d
      + V2(math.sin(S.phase) * 0.045 * d * move, math.abs(math.cos(S.phase)) * 0.03 * d * move)
      + V2(S.swayY, -S.swayP) * 6 * d
    S.eyeV += ((target - S.eye) * 150 - S.eyeV * 19) * dt
    S.eye += S.eyeV * dt
    if S.eye.Magnitude > 0.24 * d then S.eye = S.eye.Unit * 0.24 * d end
    local eye = S.eye

    -- 开镜动画：黑一下、出瞳由小变大、对焦
    local k = math.clamp((t - S.t0) / 0.24, 0, 1)
    local ease = 1 - (1 - k) ^ 3
    local scale = 0.8 + 0.2 * ease
    blackout.BackgroundTransparency = math.clamp((t - S.t0 - 0.04) / 0.13, 0, 1)
    S.blurK = math.max(0, S.blurK - dt * 22)
    local focus = (1 - math.clamp((t - S.t0) / 0.34, 0, 1)) ^ 2 * 16
    blur.Size = math.max(focus, S.blurK)
    -- 鼠标灵敏度随倍率降（高倍时拖一下不会甩出去好远）
    if S.sens then
      local v = S.sens * (1 / zoom) ^ 0.85
      if UIS.MouseDeltaSensitivity ~= v then pcall(function() UIS.MouseDeltaSensitivity = v end) end
    end

    if kind == "sniper" or kind == "acog" then
      local DA = D * scale
      local ax, ay = cx + eye.X, cy + eye.Y
      sizeAp(apA, DA)
      at(apA.box, ax, ay)
      sizeAp(apB, DA * 1.06)
      at(apB.box, cx - eye.X * 0.8, cy - eye.Y * 0.8)
      at(lens, ax, ay)
      sz(lens, DA)
      -- 色散：偏得越多彩边越宽
      local off = eye.Magnitude > 0.5 and eye.Unit * math.min(eye.Magnitude * 0.035, 3.5) or V2()
      local ca = math.min(0.35, eye.Magnitude / d * 1.6)   -- 对正时几乎看不出，偏了才明显
      local dc = DA - 5
      sz(caR, dc)
      sz(caB, dc)
      at(caR, ax + off.X + 0.35, ay + off.Y + 0.2)
      at(caB, ax - off.X - 0.35, ay - off.Y - 0.2)
      caRs.Transparency = 0.8 - ca
      caBs.Transparency = 0.78 - ca
      if kind == "acog" then
        -- 箭形照明：夜里亮（光纤 + 氚光），开着夜视仪调暗；分划跟着出瞳一起晃（第二焦平面，大小不变）
        local nv = G.nvgOn and G.nvgOn()
        for _, e in ipairs(acog) do
          if e.lit then e.f.BackgroundTransparency = nv and math.min(0.92, e.a0 + 0.45) or e.a0 end
        end
      else
        -- 倍率、屏息条（出瞳左边的黑处；右下角是小地图）
        local rx = math.max(40, cx - D / 2 - 46)
        zoomT.Text = string.format("%.1f×", zoom)
        at(zoomT, rx, cy + D * 0.3)
        sz(breathBg, 3, math.floor(D * 0.12))
        at(breathBg, rx, cy + D * 0.38)
        breathFill.Size = UDim2.new(1, 0, math.clamp(S.breath, 0, 1), 0)
        breathFill.BackgroundColor3 = (S.tired > 0) and RGB(220, 90, 70) or RGB(200, 206, 200)
        breathBg.BackgroundTransparency = (S.breath >= 1 and not S.hold) and 0.75 or 0.35
        -- 分划按现在的视角摆（第一焦平面：每密位的像素数 = 屏幕半高 ÷ tan(半视角) × 0.001）
        layoutFfp(0.001 * (vs.Y / 2) / math.tan(math.rad(cam.FieldOfView) / 2))
        -- 照明：夜里中心那段细十字和中心点发暗红光；开着夜视仪时画面本来就亮，照明调暗（不然一团光）
        local nv = G.nvgOn and G.nvgOn()
        if S.lit ~= (not nv) then
          S.lit = not nv
          for _, e in ipairs(ffp) do
            if e.lit and e.f ~= glow and e.f ~= dot then e.f.BackgroundTransparency = S.lit and 0.05 or 1 end
          end
        end
        dot.BackgroundTransparency = nv and 0.5 or 0.08
        glow.BackgroundTransparency = nv and 0.94 or 0.82
      end
    else
      local s = Db * 0.84 * scale
      local Dd = Db * scale
      local split = math.floor(cx + eye.X + 0.5)
      clipL.Position, clipL.Size = UDim2.fromOffset(0, 0), UDim2.fromOffset(split, vs.Y)
      clipR.Position, clipR.Size = UDim2.fromOffset(split, 0), UDim2.fromOffset(vs.X - split, vs.Y)
      sizeAp(apL, Dd)
      sizeAp(apR, Dd)
      sz(tintL, Dd)
      sz(tintR, Dd)
      local ly, lx, rxx = cy + eye.Y, cx - s / 2 + eye.X, cx + s / 2 + eye.X - split
      at(apL.box, lx, ly)
      at(tintL, lx, ly)
      at(apR.box, rxx, ly)
      at(tintR, rxx, ly)
      -- 激光测距、方位（每 0.1 秒量一次）
      if t - S.lrfT > 0.1 then
        S.lrfT = t
        rayP.FilterDescendantsInstances = { me.Character, cam }
        local look = cam.CFrame.LookVector
        local res = workspace:Raycast(cam.CFrame.Position, look * 3000, rayP)
        local deg, dirName = bearing(look)
        local dist = res and string.format("%04d m", math.floor((res.Position - cam.CFrame.Position).Magnitude / 2.8 + 0.5)) or "---- m"
        lrfT.Text = string.format("%s   %03d° %s   %.0f×", dist, math.floor(deg + 0.5) % 360, dirName, zoom)
      end
      at(lrfT, cx, cy + Db * 0.36)
    end

    -- 杂散光：月亮在视野里时整块镜片泛白一点
    local m = moonOnScreen()
    local center = V2(cx, cy)
    local inten = 0
    if m then
      local r = (kind == "binoc") and Db * 0.95 or D * 0.5
      inten = math.clamp(1 - (m - center).Magnitude / r, 0, 1) ^ 1.5
    end
    tint.BackgroundTransparency = 0.93 - 0.05 * inten   -- 对着亮处，整块镜片泛白一点（杂散光）

    -- 告诉服务器：开着镜、朝哪看（别人那边画镜片闪光；步枪的 ACOG 不发）
    if kind ~= "acog" and t - S.sendT > 0.25 then
      local look = cam.CFrame.LookVector
      if not S.sentDir or look:Dot(S.sentDir) < 0.9997 then
        S.sendT, S.sentDir = t, look
        sendState(true)
      end
    end
  end

  -- 晃动加在镜头上：在 Roblox 镜头更新之后（Camera + 1），只加这一帧的增量（镜头下一帧从当前朝向接着算，加总量会越转越偏）；
  --   顺便量镜头转得多快（上一帧加完晃动之后 → 这一帧镜头更新完），给出瞳偏移用
  RunService:BindToRenderStep("ScopeSway", Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not S.kind then
      S.prev, S.appP, S.appY = nil, 0, 0
      return
    end
    local cf = cam.CFrame
    if S.prev and dt > 0 then
      local lv = S.prev:ToObjectSpace(cf).LookVector
      local yaw = math.atan2(-lv.X, -lv.Z)
      local pitch = math.asin(math.clamp(lv.Y, -1, 1))
      S.ang = S.ang:Lerp(V2(-yaw / dt, pitch / dt), math.min(1, dt * 18))
    end
    local dp, dy = S.swayP - S.appP, S.swayY - S.appY
    S.appP, S.appY = S.swayP, S.swayY
    cam.CFrame = cf * CFrame.Angles(dp, dy, 0)
    S.prev = cam.CFrame
  end)

  UIS.InputChanged:Connect(function(io)
    if S.kind and io.UserInputType == Enum.UserInputType.MouseWheel then changeZoom(io.Position.Z > 0 and 1 or -1) end
  end)
  if zin then
    zin.Activated:Connect(function() changeZoom(1) end)
    zout.Activated:Connect(function() changeZoom(-1) end)
  end
  cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() if S.kind then layout(S.kind) end end)

  ---------------------------------------------------------------- 别人的镜片闪光

  local glints = {}   -- [Player] = { bb, core, halo, h, v }
  local function makeGlint(head)
    local bb = Instance.new("BillboardGui")
    bb.Name = "ScopeGlint"
    bb.Size = UDim2.fromOffset(110, 110)
    bb.LightInfluence = 0
    bb.Brightness = 5
    bb.AlwaysOnTop = false   -- 墙挡得住
    bb.MaxDistance = 3000
    bb.Adornee = head
    local function g(w, h, color, isRound)
      local f = Instance.new("Frame")
      f.AnchorPoint = V2(0.5, 0.5)
      f.Position = UDim2.fromScale(0.5, 0.5)
      f.Size = UDim2.fromOffset(w, h)
      f.BackgroundColor3 = color
      f.BorderSizePixel = 0
      f.BackgroundTransparency = 1
      f.Parent = bb
      if isRound then round(f) end
      return f
    end
    local G2 = { bb = bb }
    G2.halo = g(36, 36, RGB(205, 228, 255), true)
    G2.h = g(110, 2, RGB(235, 244, 255))
    grad(G2.h, 0, { { 0, 1 }, { 0.5, 0 }, { 1, 1 } })
    G2.v = g(2, 64, RGB(235, 244, 255))
    grad(G2.v, 90, { { 0, 1 }, { 0.5, 0 }, { 1, 1 } })
    G2.core = g(9, 9, RGB(255, 255, 255), true)
    bb.Parent = head
    return G2
  end
  local glintScan = 0
  G.frameConn("Scope", function(dt)
    local t = now()
    if t - glintScan > 0.25 then   -- 每 0.25 秒看一遍谁开着镜
      glintScan = t
      local side = me:GetAttribute("Side")
      for _, pl in ipairs(Players:GetPlayers()) do
        local ch = pl.Character
        local head = ch and ch:FindFirstChild("Head")
        local want = pl ~= me and head ~= nil and ch:GetAttribute("Scoped") == true and pl:GetAttribute("Side") ~= side
        local gl = glints[pl]
        if want and (not gl or gl.bb.Parent ~= head) then
          if gl then gl.bb:Destroy() end
          glints[pl] = makeGlint(head)
        elseif not want and gl then
          gl.bb:Destroy()
          glints[pl] = nil
        end
      end
    end
    local eyeP = cam.CFrame.Position
    for pl, gl in pairs(glints) do
      local ch = pl.Character
      local head = gl.bb.Adornee
      if not ch or not head or not head.Parent then
        gl.bb:Destroy()
        glints[pl] = nil
      else
        local dir = ch:GetAttribute("ScopeDir")
        if typeof(dir) ~= "Vector3" or dir.Magnitude < 0.5 then dir = head.CFrame.LookVector end
        dir = dir.Unit
        local to = eyeP - head.Position
        local dist = to.Magnitude
        local c = (dist > 1) and dir:Dot(to / dist) or 0
        local i = math.clamp((c - 0.94) / 0.06, 0, 1) ^ 2   -- 20° 以内开始闪，正对着最亮
        i *= 0.75 + 0.25 * math.sin(t * 19 + pl.UserId % 7)
        if dist < 25 then i = 0 end
        gl.bb.Enabled = i > 0.02
        gl.bb.StudsOffsetWorldSpace = dir * 1.15 + Vector3.new(0, 0.12, 0)
        gl.core.BackgroundTransparency = 1 - 0.95 * i
        gl.halo.BackgroundTransparency = 1 - 0.45 * i
        gl.h.BackgroundTransparency = 1 - 0.8 * i
        gl.v.BackgroundTransparency = 1 - 0.55 * i
      end
    end
  end)
  Players.PlayerRemoving:Connect(function(pl)
    if glints[pl] then glints[pl].bb:Destroy() glints[pl] = nil end
  end)
end

return Scope
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="106">
          <Properties>
            <string name="Name">ShipView</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——舰艇的样子（G.viewKind.ship，View.lua 每帧调）：按 ShipDefs 的 look 拼零件——
--   船体（水线下红色防污漆、水线一圈黑色、水线上舰体灰；船头两块楔形收成尖）、双体 / 三体、甲板、上层建筑（隐身舰两层收口）、舰桥窗、
--   桅杆（055 / 054A 的四面相控阵在一体化桅杆上，美舰的在舰桥四角）、烟囱、垂发（一格一格）、斜置的导弹发射箱、直升机甲板标线、
--   舰炮（炮塔按 Ty / Gp 转，开炮炮管后坐）、近防炮、舷号、航行灯（桅顶白、左红右绿、艉白）、舰旗；
--   随浪起伏、转弯外倾；船头浪花、尾迹、烟囱排烟；挨打冒烟着火；击沉后慢慢倾覆、下沉
--   自己开的船用本地算的位置和炮塔角（Sail.lua 的 G.sail），别人的平滑跟着服务器；船尾一个「上船」提示（码头上走过去按 E）
--   原模型（网页版的舰艇模型原样转的 models/ship/<型号>.glb，Studio 导入后 Imports.lua 收进 ReplicatedStorage.Imported.Ship.<型号>，元数据 ImportedShip）：
--     有就只换「蒙皮」——船体、上层建筑、桅杆、烟囱、垂发、近防炮、舷号换成原模型；主炮用原模型上的（炮塔连炮管跟着炮塔角转，不俯仰）；
--     航行灯、舰旗挪到原模型上，浪花、尾迹、烟囱排烟、着火照旧
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local Tint = require(script.Parent:WaitForChild("Tint"))   -- 导入的贴图没出来时的底色（原贴图的平均色）
local TURN = require(RS:WaitForChild("ImportTurn")).TURN   -- 导入的每块网格被 Roblox 转了半圈（ImportTurn.lua）：摆的时候转回来

local ShipView = {}

function ShipView.init(G)
  local SD = require(RS:WaitForChild("ShipDefs"))
  local V, CF, RGB = Vector3.new, CFrame.new, Color3.fromRGB
  local MAT = Enum.Material
  local BALL, CYL = Enum.PartType.Ball, Enum.PartType.Cylinder
  local me = Players.LocalPlayer
  local function T(k, ...) return G.T(k, ...) end
  local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
  local RED_LOW, BOOT, GLASS = RGB(118, 44, 40), RGB(30, 32, 34), RGB(28, 36, 44)
  local TEAMC = { atk = RGB(214, 52, 44), def = RGB(52, 96, 190) }
  local IS = nil   -- 原模型的元数据（tools/models/ship2glb.py 生成）
  do
    local ok, r = pcall(function() return require(RS:WaitForChild("ImportedShip", 3)) end)
    if ok and type(r) == "table" then IS = r end
  end
  local function importedFor(d)
    local info = IS and IS.m and IS.m[d.id]
    local imp = RS:FindFirstChild("Imported")
    local sh = imp and imp:FindFirstChild("Ship")
    local f = sh and sh:FindFirstChild(d.id)
    local n = f and f:GetAttribute("N")   -- 块还没全复制过来就先不用（View 等块齐了再重建）
    if n and #f:GetChildren() < n then return nil end
    if info and f then return info, f end
    return nil
  end
  -- 正在拼哪一类零件（有原模型时只留下 lamp 灯、fx 粒子、flag 舰旗，其余是蒙皮）
  local TAG = nil

  ---------------------------------------------------------------- 拼零件

  -- 一个零件：grp "hull" 跟着船、"t" 跟着第 gi 座炮塔转、"g" 跟着炮管（俯仰、后坐）；off 相对船（水线中心）/ 炮塔 / 炮管的 CFrame
  local function mk(M, cls, size, off, color, mat, grp, gi, shape)
    local p = Instance.new(cls or "Part")
    if shape then p.Shape = shape end
    p.Size, p.Color = size, color
    p.Material = mat or MAT.SmoothPlastic
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.CastShadow = size.Magnitude > 3
    p.CFrame = off
    p.Parent = M.model
    table.insert(M.items, { p = p, g = grp or "hull", off = off, i = gi, tag = TAG })
    return p
  end

  -- 船体一段：宽 w、中线在 x，从 z0（船头尖）到 z1（船尾），底 yb、顶 yt；船头 bowL 长收成尖（左右两块楔形，宽的一头接船身）
  local function hullSeg(M, x, w, z0, z1, yb, yt, bowL, col)
    local h = yt - yb
    if h <= 0.04 then return end
    local yc = (yb + yt) / 2
    local L = z1 - z0 - bowL
    mk(M, "Part", V(w, h, L), CF(x, yc, z0 + bowL + L / 2), col, MAT.Metal)
    mk(M, "WedgePart", V(h, w / 2, bowL), CF(x + w / 4, yc, z0 + bowL / 2) * CFrame.Angles(0, 0, -math.pi / 2), col, MAT.Metal)
    mk(M, "WedgePart", V(h, w / 2, bowL), CF(x - w / 4, yc, z0 + bowL / 2) * CFrame.Angles(0, 0, math.pi / 2), col, MAT.Metal)
  end
  -- 一条船体：水线下红、水线一圈黑、上面舰体色；顶上一层甲板色
  local function hull(M, x, w, z0, z1, yb, yt, bowL, col, deckCol)
    hullSeg(M, x, w, z0, z1, yb, math.min(-0.5, yt), bowL, RED_LOW)
    hullSeg(M, x, w + 0.08, z0 - 0.04, z1 + 0.04, math.max(-0.5, yb), math.min(0.7, yt), bowL, BOOT)
    hullSeg(M, x, w, z0, z1, math.max(0.7, yb), yt, bowL, col)
    if deckCol then
      local L = z1 - z0 - bowL
      mk(M, "Part", V(w - 0.3, 0.12, L - 0.3), CF(x, yt + 0.06, z0 + bowL + L / 2), deckCol, MAT.Concrete)
      mk(M, "WedgePart", V(0.12, w / 2 - 0.2, bowL - 0.6), CF(x + w / 4 - 0.05, yt + 0.06, z0 + bowL / 2 + 0.3) * CFrame.Angles(0, 0, -math.pi / 2), deckCol, MAT.Concrete)
      mk(M, "WedgePart", V(0.12, w / 2 - 0.2, bowL - 0.6), CF(x - w / 4 + 0.05, yt + 0.06, z0 + bowL / 2 + 0.3) * CFrame.Angles(0, 0, math.pi / 2), deckCol, MAT.Concrete)
    end
  end

  -- 夜里的灯：霓虹小块 + 远处也看得见的光晕（BillboardGui）+ 小点光源
  local function lamp(M, off, color, size, range)
    local t0 = TAG
    TAG = "lamp"
    local p = mk(M, "Part", V(size, size, size), off, color, MAT.Neon)
    TAG = t0
    p.CastShadow = false
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.new(size * 5, 4, size * 5, 4)
    bb.LightInfluence = 0
    bb.MaxDistance = 5000
    bb.Parent = p
    local halo = Instance.new("Frame")
    halo.AnchorPoint, halo.Position, halo.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 1)
    halo.BackgroundColor3, halo.BackgroundTransparency, halo.BorderSizePixel = color, 0.72, 0
    halo.Parent = bb
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0.5, 0)
    c.Parent = halo
    if range then
      local L = Instance.new("PointLight")
      L.Color, L.Range, L.Brightness, L.Shadows = color, range, 1.2, false
      L.Parent = p
    end
    return p
  end

  -- 舷号：船头两侧各一块透明薄板上的字（右舷读向船头、左舷读向船尾，从外面看都是正的）
  local function hullNumber(M, d, text, zc, yc, h)
    if not text or text == "" then return end
    local len = h * 0.62 * #text + h * 0.3
    for _, s in ipairs({ 1, -1 }) do
      local p = mk(M, "Part", V(0.1, h, len), CF(s * (d.W / 2 + 0.1), yc, zc), RGB(0, 0, 0), MAT.SmoothPlastic)
      p.Transparency = 1
      p.CastShadow = false
      local sg = Instance.new("SurfaceGui")
      sg.Face = (s > 0) and Enum.NormalId.Right or Enum.NormalId.Left
      sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
      sg.PixelsPerStud = 24
      sg.LightInfluence = 0.7
      sg.Parent = p
      local l = Instance.new("TextLabel")
      l.Size = UDim2.fromScale(1, 1)
      l.BackgroundTransparency = 1
      l.Text = text
      l.TextScaled = true
      l.Font = Enum.Font.GothamBlack
      l.TextColor3 = RGB(236, 238, 236)
      l.TextStrokeColor3 = RGB(10, 10, 10)
      l.TextStrokeTransparency = 0.25
      l.Parent = sg
    end
  end

  -- 粒子：挂在一个看不见的小零件上（跟着船走）
  local function emitter(M, off, props)
    local t0 = TAG
    TAG = "fx"
    local h = mk(M, "Part", V(0.2, 0.2, 0.2), off, RGB(0, 0, 0), MAT.SmoothPlastic)
    TAG = t0
    h.Transparency = 1
    h.CastShadow = false
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = SMOKE
    pe.Rate = 0
    for k, v in pairs(props) do pe[k] = v end
    pe.Parent = h
    return pe
  end
  local function seq(a, b) return NumberSequence.new({ NumberSequenceKeypoint.new(0, a), NumberSequenceKeypoint.new(1, b) }) end

  -- 一座炮：炮塔（隐身舰前面一块斜面）、炮盾、炮管（双联 / 加特林）、炮口
  local CAL = { g130 = 1.2, g127 = 1.1, g76 = 0.8, g57 = 0.62, g30 = 0.9, m2x2 = 0.24 }
  local function gun(M, d, gi, col)
    local g = d.guns[gi]
    local s = g.size
    mk(M, "Part", V(s.X, s.Y, s.Z), CF(0, s.Y / 2, 0), col, MAT.Metal, "t", gi)
    if g.stealth then
      mk(M, "WedgePart", V(s.X, s.Y * 0.92, s.Z * 0.42), CF(0, s.Y * 0.46, -s.Z / 2 - s.Z * 0.21), col, MAT.Metal, "t", gi)
    elseif not g.twin then
      mk(M, "Part", V(s.X * 0.9, s.Y * 0.3, s.Z * 0.5), CF(0, s.Y + s.Y * 0.15, s.Z * 0.15), col:Lerp(RGB(0, 0, 0), 0.1), MAT.Metal, "t", gi)   -- 炮塔顶
    end
    local c = CAL[g.w] or 0.6
    local len = g.len
    if g.twin then
      for _, x in ipairs({ -0.35, 0.35 }) do
        mk(M, "Part", V(len, c, c), CF(x, 0, -len / 2) * CFrame.Angles(0, math.pi / 2, 0), RGB(40, 42, 44), MAT.Metal, "g", gi, CYL)
      end
      mk(M, "Part", V(1.6, 1.0, 0.15), CF(0, 0.2, -0.3), RGB(70, 78, 66), MAT.Metal, "g", gi)   -- 枪盾
    elseif g.gatling then
      mk(M, "Part", V(len, c, c), CF(0, 0, -len / 2) * CFrame.Angles(0, math.pi / 2, 0), RGB(44, 46, 48), MAT.Metal, "g", gi, CYL)
      mk(M, "Part", V(0.3, c * 1.3, c * 1.3), CF(0, 0, -len + 0.15) * CFrame.Angles(0, math.pi / 2, 0), RGB(30, 30, 32), MAT.Metal, "g", gi, CYL)
    else
      mk(M, "Part", V(len, c, c), CF(0, 0, -len / 2) * CFrame.Angles(0, math.pi / 2, 0), col:Lerp(RGB(0, 0, 0), 0.25), MAT.Metal, "g", gi, CYL)
      mk(M, "Part", V(len * 0.12, c * 1.35, c * 1.35), CF(0, 0, -len * 0.06) * CFrame.Angles(0, math.pi / 2, 0), col:Lerp(RGB(0, 0, 0), 0.15), MAT.Metal, "g", gi, CYL)   -- 炮管根部的加粗段
      mk(M, "Part", V(s.X * 0.45, s.Y * 0.5, 0.4), CF(0, 0, 0.1), col:Lerp(RGB(0, 0, 0), 0.2), MAT.Metal, "g", gi)   -- 炮盾
    end
  end

  -- 近防炮：底座、白色雷达罩、一束炮管——整座绕 mp 的竖轴转向目标（grp "c"，off 相对 mp）；
  --   平时炮口朝 ry（原模型里这一座朝哪，ShipDefs.ciwsInfo；没有原模型的是 0 船头），跟原模型的那座一样
  local function ciws(M, d, mp, col, mi)
    local R = CFrame.Angles(0, -math.rad((d.ciwsInfo and d.ciwsInfo[mi] and d.ciwsInfo[mi].ry) or 0), 0)
    local function c(cls, size, off, ...)
      local p = mk(M, cls, size, R * off, ...)
      M.items[#M.items].piv = CF(mp)
      return p
    end
    c("Part", V(2.4, 1.6, 2.4), CF(0, -0.9, 0), col, MAT.Metal, "c", mi)
    c("Part", V(2.3, 2.3, 2.3), CF(0, 0.9, 0.1), RGB(232, 234, 232), MAT.SmoothPlastic, "c", mi, BALL)
    c("Part", V(1.4, 1.4, 1.6), CF(0, -0.1, 0), RGB(220, 222, 220), MAT.SmoothPlastic, "c", mi)
    c("Part", V(2.4, 0.5, 0.5), CF(0, -0.1, -1.8) * CFrame.Angles(0, math.pi / 2, 0), RGB(40, 42, 44), MAT.Metal, "c", mi, CYL)
  end

  local function build(d, team)
    local L = d.look or {}
    local M = { model = Instance.new("Model"), items = {} }
    M.model.Name = "Ship_" .. d.id
    local col = L.color or RGB(120, 126, 130)
    local deckCol = col:Lerp(RGB(30, 34, 36), 0.45)
    local supCol = col:Lerp(RGB(255, 255, 255), 0.04)
    local yb = -d.draft
    local bowL = d.L * 0.27
    local z0, z1 = -d.L / 2, d.L / 2
    -- 船体
    if L.hulls == 2 then   -- 双体（022）：两条窄船体 + 上面一整块桥接甲板（前端一块斜面）
      local hw = d.W * 0.28
      for _, s in ipairs({ -1, 1 }) do hull(M, s * (d.W / 2 - hw / 2), hw, z0, z1, yb, 1.6, d.L * 0.22, col) end
      local cz0 = z0 + d.L * 0.16
      mk(M, "Part", V(d.W, d.deck - 1.4, z1 - cz0 - 6), CF(0, (d.deck + 1.4) / 2, (cz0 + 6 + z1) / 2), col, MAT.Metal)
      mk(M, "WedgePart", V(d.W, d.deck - 1.4, 6), CF(0, (d.deck + 1.4) / 2, cz0 + 3), col, MAT.Metal)
      mk(M, "Part", V(d.W - 0.3, 0.12, z1 - cz0 - 6.3), CF(0, d.deck + 0.06, (cz0 + 6 + z1) / 2), deckCol, MAT.Concrete)
    elseif L.hulls == 3 then   -- 三体（LCS-2）：中间主船体、两边细长的侧体，后面三分之二是整块宽甲板
      local cw = d.W * 0.26
      hull(M, 0, cw, z0, z1, yb, d.deck, d.L * 0.3, col, deckCol)
      for _, s in ipairs({ -1, 1 }) do hull(M, s * (d.W / 2 - d.W * 0.05), d.W * 0.1, -d.L * 0.12, z1, -d.draft * 0.5, 2, d.L * 0.14, col) end
      local sz0 = z0 + d.L * 0.34
      mk(M, "Part", V(d.W, d.deck - 2, z1 - sz0), CF(0, (d.deck + 2) / 2, (sz0 + z1) / 2), col, MAT.Metal)
      mk(M, "WedgePart", V(d.W * 0.6, d.deck - 2, d.L * 0.12), CF(0, (d.deck + 2) / 2, sz0 - d.L * 0.06), col, MAT.Metal)
      mk(M, "Part", V(d.W - 0.3, 0.12, z1 - sz0 - 0.3), CF(0, d.deck + 0.06, (sz0 + z1) / 2), deckCol, MAT.Concrete)
    elseif L.open then   -- 小艇（PBR）：玻璃钢艇身、低矮的驾驶台、后面的发动机舱盖
      hull(M, 0, d.W, z0, z1, yb, d.deck, d.L * 0.3, col, col:Lerp(RGB(0, 0, 0), 0.25))
      mk(M, "Part", V(d.W * 0.7, 1.6, 3), CF(0, d.deck + 0.8, 0.5), col:Lerp(RGB(0, 0, 0), 0.1), MAT.SmoothPlastic)
      mk(M, "Part", V(d.W * 0.66, 0.8, 0.12), CF(0, d.deck + 2, -1.05) * CFrame.Angles(math.rad(-20), 0, 0), GLASS, MAT.Glass).Transparency = 0.3
      mk(M, "Part", V(0.15, 2.6, 0.15), CF(0, d.deck + 2.9, 1.5), RGB(40, 42, 44), MAT.Metal)
      mk(M, "Part", V(1, 0.5, 1), CF(0, d.deck + 4.3, 1.5), RGB(220, 222, 220), MAT.SmoothPlastic, nil, nil, BALL)   -- 雷达罩
      mk(M, "Part", V(d.W * 0.8, 0.8, 4), CF(0, d.deck + 0.4, 5.2), col:Lerp(RGB(0, 0, 0), 0.2), MAT.SmoothPlastic)
      mk(M, "Part", V(1.4, 0.5, 1.4), CF(0, d.deck + 0.25, -5.2), RGB(60, 66, 58), MAT.Metal, nil, nil, CYL)   -- 枪座
    else
      hull(M, 0, d.W, z0, z1, yb, d.deck, bowL, col, deckCol)
    end
    -- 上层建筑：第一块主上层建筑、第二块舰桥（前面一排窗）、其余（机库……）；隐身舰两层（上层窄一点像收口的斜面）
    for k, s in ipairs(L.sup or {}) do
      local za, zb, w, h, y = s[1], s[2], s[3], s[4], s[5]
      local zc, len = (za + zb) / 2, zb - za
      if L.stealth then
        mk(M, "Part", V(w, h * 0.72, len), CF(0, y + h * 0.36, zc), supCol, MAT.Metal)
        mk(M, "Part", V(w * 0.86, h * 0.28, len - w * 0.07), CF(0, y + h * 0.86, zc), supCol, MAT.Metal)
        mk(M, "WedgePart", V(w * 0.86, h * 0.28, w * 0.07), CF(0, y + h * 0.86, za + w * 0.035), supCol, MAT.Metal)
      else
        mk(M, "Part", V(w, h, len), CF(0, y + h / 2, zc), supCol, MAT.Metal)
      end
      if k == 2 then
        local wt = L.stealth and (w * 0.86) or w
        mk(M, "Part", V(wt * 0.84, h * 0.2, 0.2), CF(0, y + h * 0.78, za - 0.08), GLASS, MAT.Glass)
        for _, sx in ipairs({ -1, 1 }) do   -- 两侧舰桥翼
          mk(M, "Part", V(2.4, 0.5, 4), CF(sx * (w / 2 + 1.2), y + h * 0.62, za + 3), supCol, MAT.Metal)
        end
      end
    end
    -- 桅杆：一体化桅杆（宽的）四面相控阵；美舰的相控阵在舰桥（第二块）四角
    local mast = L.mast
    local mastTop = nil
    if mast then
      local mw, mh = L.mastW or 6, L.mastH or 10
      local panelC = RGB(58, 66, 74)
      if mw >= 9 then
        mk(M, "Part", V(mw, mh * 0.75, mw * 1.2), CF(mast + V(0, mh * 0.375, 0)), supCol, MAT.Metal)
        mk(M, "Part", V(mw * 0.7, mh * 0.25, mw * 0.84), CF(mast + V(0, mh * 0.875, 0)), supCol, MAT.Metal)
        if L.panel then
          local ps = mw * 0.62
          for _, f in ipairs({ { 0, -1 }, { 0, 1 }, { 1, 0 }, { -1, 0 } }) do
            local off = (f[2] ~= 0) and V(0, mh * 0.42, f[2] * (mw * 0.6 + 0.12)) or V(f[1] * (mw / 2 + 0.12), mh * 0.42, 0)
            local sz = (f[2] ~= 0) and V(ps, ps, 0.24) or V(0.24, ps, ps)
            mk(M, "Part", sz, CF(mast + off), panelC, MAT.SmoothPlastic)
          end
        end
      else
        mk(M, "Part", V(mw, mh * 0.55, mw), CF(mast + V(0, mh * 0.275, 0)), supCol, MAT.Metal)
        mk(M, "Part", V(0.5, mh * 0.45, 0.5), CF(mast + V(0, mh * 0.55 + mh * 0.225, 0)), RGB(60, 62, 64), MAT.Metal)
        mk(M, "Part", V(mw * 1.8, 0.35, 0.35), CF(mast + V(0, mh * 0.82, 0)), RGB(60, 62, 64), MAT.Metal)   -- 横桁
        local s2 = L.sup and L.sup[2]
        if L.panel and s2 then   -- 舰桥四角斜着的四块（SPY 雷达）
          local za, zb, w, h, y = s2[1], s2[2], s2[3], s2[4], s2[5]
          local ps = math.min(h * 0.8, w * 0.5)
          for _, c in ipairs({ { -1, za, 1 }, { 1, za, 1 }, { -1, zb, -1 }, { 1, zb, -1 } }) do
            local pc = CF(c[1] * w * 0.32, y + h * 0.5, c[2] + c[3] * 0.6) * CFrame.Angles(0, c[1] * c[3] * math.rad(-40), 0)
            mk(M, "Part", V(ps, ps, 0.3), pc, panelC, MAT.SmoothPlastic)
          end
        end
      end
      mastTop = mast + V(0, mh + 0.8, 0)
      mk(M, "Part", V(0.4, 3, 0.4), CF(mastTop + V(0, 0.7, 0)), RGB(60, 62, 64), MAT.Metal)
      TAG = "flag"
      local flag = mk(M, "Part", V(0.08, 1.6, 2.6), CF(mastTop + V(0, 0.4, 1.4)), TEAMC[team] or RGB(200, 200, 200), MAT.Fabric)
      TAG = nil
      flag.CastShadow = false
      M.flag = flag
    end
    -- 烟囱：方的烟囱、顶上一圈黑
    local fl = L.funnel or {}
    M.funnels = {}
    for i = 1, #fl - 1, 2 do
      local p, s = fl[i], fl[i + 1]
      mk(M, "Part", s, CF(p), supCol, MAT.Metal)
      mk(M, "Part", V(s.X * 0.86, 0.5, s.Z * 0.86), CF(p + V(0, s.Y / 2 + 0.2, 0)), RGB(26, 26, 28), MAT.Metal)
      table.insert(M.funnels, p + V(0, s.Y / 2 + 0.6, 0))
    end
    -- 垂发：甲板上一块深灰板，一格一格的缝
    for _, v in ipairs(L.vls or {}) do
      local za, zb = v[1], v[2]
      local w = d.W * 0.5
      local zc, len = (za + zb) / 2, zb - za
      mk(M, "Part", V(w, 0.3, len), CF(0, d.deck + 0.15, zc), RGB(66, 70, 72), MAT.DiamondPlate)
      mk(M, "Part", V(0.15, 0.32, len), CF(0, d.deck + 0.18, zc), RGB(30, 32, 34), MAT.Metal)
      for zz = za + 3.6, zb - 1, 3.6 do mk(M, "Part", V(w, 0.32, 0.15), CF(0, d.deck + 0.18, zz), RGB(30, 32, 34), MAT.Metal) end
    end
    -- 斜置的导弹发射箱：左右两排，箱口朝前上方
    local cn = L.canisters
    if cn then
      for _, s in ipairs({ -1, 1 }) do
        for k2 = 0, (cn.n or 4) / 2 - 1 do
          for r = 0, 1 do
            mk(M, "Part", V(1.5, 1.5, 8), CF(s * (1.2 + k2 * 1.7), cn.y + 1.6 + r * 1.6, cn.z) * CFrame.Angles(math.rad(22), 0, 0), col:Lerp(RGB(0, 0, 0), 0.15), MAT.Metal)
          end
        end
      end
    end
    -- 直升机甲板：两条白边、黄色圆圈、中线
    local hl = L.heli
    if hl then
      local za, zb = hl[1], hl[2]
      local zc, len = (za + zb) / 2, zb - za
      local w = (L.hulls == 3) and d.W * 0.9 or d.W * 0.86
      for _, sx in ipairs({ -1, 1 }) do mk(M, "Part", V(0.4, 0.08, len), CF(sx * w / 2, d.deck + 0.16, zc), RGB(225, 226, 224)) end
      local r = math.min(w * 0.7, len * 0.7)
      mk(M, "Part", V(0.06, r, r), CF(0, d.deck + 0.15, zc) * CFrame.Angles(0, 0, math.pi / 2), RGB(226, 190, 60), MAT.SmoothPlastic, nil, nil, CYL)
      mk(M, "Part", V(0.07, r - 1, r - 1), CF(0, d.deck + 0.155, zc) * CFrame.Angles(0, 0, math.pi / 2), deckCol, MAT.Concrete, nil, nil, CYL)
      mk(M, "Part", V(0.35, 0.08, len * 0.9), CF(0, d.deck + 0.17, zc), RGB(226, 190, 60))
    end
    -- 炮、近防炮
    for gi in ipairs(d.guns or {}) do gun(M, d, gi, supCol) end
    for mi, mp in ipairs(d.ciws or {}) do ciws(M, d, mp, supCol, mi) end
    -- 舷号：船头两侧
    if not L.open then hullNumber(M, d, L.num, z0 + bowL + math.max(4, d.deck * 0.9), d.deck * 0.55 + 0.4, math.max(1.6, d.deck * 0.5)) end
    -- 航行灯：桅顶白灯、舰桥两侧左红右绿、船尾白灯
    local s2 = L.sup and L.sup[2]
    if mastTop then lamp(M, CF(mastTop + V(0, 2.4, 0)), RGB(255, 250, 236), 0.5, 10) end
    if s2 then
      lamp(M, CF(-(s2[3] / 2 + 2.6), s2[5] + s2[4] * 0.62 + 0.6, s2[1] + 3), RGB(255, 50, 40), 0.45, 8)
      lamp(M, CF(s2[3] / 2 + 2.6, s2[5] + s2[4] * 0.62 + 0.6, s2[1] + 3), RGB(60, 255, 120), 0.45, 8)
    elseif L.open then
      lamp(M, CF(-d.W * 0.36, d.deck + 1.7, -0.9), RGB(255, 50, 40), 0.25, 5)
      lamp(M, CF(d.W * 0.36, d.deck + 1.7, -0.9), RGB(60, 255, 120), 0.25, 5)
      lamp(M, CF(0, d.deck + 4.9, 1.5), RGB(255, 250, 236), 0.25, 6)
    end
    lamp(M, CF(0, d.deck + 1, z1 + 0.3), RGB(255, 250, 236), L.open and 0.25 or 0.45, 8)
    -- 粒子：船头浪花（左右）、尾迹、烟囱排烟、挨打着火冒黑烟
    local k = math.clamp(d.W / 20, 0.3, 2.4)
    M.spray = {}
    for _, s in ipairs({ -1, 1 }) do
      table.insert(M.spray, emitter(M, CF(s * d.W * 0.3, 0.4, z0 + bowL * 0.55) * CFrame.Angles(0, 0, 0), {
        EmissionDirection = (s > 0) and Enum.NormalId.Right or Enum.NormalId.Left, Speed = NumberRange.new(4 * k, 10 * k), SpreadAngle = Vector2.new(25, 35),
        Lifetime = NumberRange.new(0.8, 1.6), Size = seq(1.5 * k, 5 * k), Transparency = seq(0.25, 1), Color = ColorSequence.new(RGB(238, 244, 246)),
        Acceleration = V(0, -18, 0), Drag = 1.5, LightInfluence = 0.6 }))
    end
    M.wake = emitter(M, CF(0, 0.3, z1 + 1), {
      EmissionDirection = Enum.NormalId.Back, Speed = NumberRange.new(1, 3), SpreadAngle = Vector2.new(20, 5), Lifetime = NumberRange.new(5, 8),
      Size = seq(d.W * 0.5, d.W * 1.6), Transparency = seq(0.35, 1), Color = ColorSequence.new(RGB(232, 240, 242)), Drag = 0.6, LightInfluence = 0.6 })
    M.smoke = {}
    for _, fp in ipairs(M.funnels) do
      table.insert(M.smoke, emitter(M, CF(fp), {
        EmissionDirection = Enum.NormalId.Top, Speed = NumberRange.new(4, 8), SpreadAngle = Vector2.new(8, 8), Lifetime = NumberRange.new(3, 5),
        Size = seq(3 * k, 12 * k), Transparency = seq(0.55, 1), Color = ColorSequence.new(RGB(70, 70, 72)), Acceleration = V(0, 1, 0), LightInfluence = 0.7 }))
    end
    local s1 = L.sup and L.sup[1]
    local fireAt = s1 and V(0, s1[5] + s1[4], (s1[1] + s1[2]) / 2) or V(0, d.deck + 1, 0)
    M.fire = emitter(M, CF(fireAt), {
      EmissionDirection = Enum.NormalId.Top, Speed = NumberRange.new(4, 9), SpreadAngle = Vector2.new(30, 30), Lifetime = NumberRange.new(0.6, 1.2),
      Size = seq(3 * k, 1 * k), Transparency = seq(0.1, 1), Color = ColorSequence.new(RGB(255, 170, 60), RGB(255, 80, 30)), LightEmission = 1 })
    M.black = emitter(M, CF(fireAt + V(0, 2, 0)), {
      EmissionDirection = Enum.NormalId.Top, Speed = NumberRange.new(6, 12), SpreadAngle = Vector2.new(15, 15), Lifetime = NumberRange.new(4, 7),
      Size = seq(4 * k, 18 * k), Transparency = seq(0.25, 1), Color = ColorSequence.new(RGB(30, 28, 26)), Acceleration = V(0, 2, 0), LightInfluence = 0.5 })
    M.fireLight = Instance.new("PointLight")
    M.fireLight.Color, M.fireLight.Range, M.fireLight.Brightness, M.fireLight.Enabled = RGB(255, 140, 60), 40, 3, false
    M.fireLight.Parent = M.fire.Parent
    local info, folder = importedFor(d)
    if info then
      -- 蒙皮换成原模型：零件拼的只留灯、粒子、舰旗（主炮也不要：原模型上的炮跟着转；挑不出来的那门就不转）
      local n = 0
      for i = 1, #M.items do
        local it = M.items[i]
        local ic = it.g == "c" and info.ciws and info.ciws[it.i]
        if it.tag == "lamp" or it.tag == "fx" or it.tag == "flag" or (ic and not ic.g) then   -- 原模型上没拆出来的近防炮：留零件拼的那座（也会转）
          n += 1
          M.items[n] = it
        else
          it.p:Destroy()
        end
      end
      for i = #M.items, n + 1, -1 do M.items[i] = nil end
      for name, p in pairs(info.parts) do
        local src = folder:FindFirstChild("S_" .. d.id .. "__" .. name)
        if src and src:IsA("BasePart") then
          local mp = Tint.fix(src:Clone(), src)
          mp.Anchored, mp.CanCollide, mp.CanQuery, mp.CanTouch = true, false, false, false
          mp.Size = V(p.s[1], p.s[2], p.s[3])
          local okT, tid = pcall(function() return mp.TextureID end)   -- 不是 MeshPart 的没有这个属性
          if p.col and not mp:FindFirstChildOfClass("SurfaceAppearance") and (not okT or (tid or "") == "") then
            mp.Color = RGB(p.col[1], p.col[2], p.col[3])   -- 原模型这块本来就没贴图：照原材质颜色（Studio 导入不一定带过来）
            if p.a then mp.Transparency = 1 - p.a end
          end
          mp.Parent = M.model
          local c = CF(p.c[1], p.c[2], p.c[3]) * TURN
          local gi = tonumber(string.match(p.g, "^T(%d+)$"))
          local bi = tonumber(string.match(p.g, "^B(%d+)$"))
          local ci = tonumber(string.match(p.g, "^C(%d+)$"))
          local gd = gi and info.guns and info.guns[gi]
          local bd = bi and info.guns and info.guns[bi]
          local cd = ci and info.ciws and info.ciws[ci]
          if gd then   -- 主炮炮塔：绕原模型的炮塔转轴转
            local piv = CF(gd.piv[1], gd.piv[2], gd.piv[3])
            table.insert(M.items, { p = mp, g = "ti", i = gi, piv = piv, off = piv:Inverse() * c })
          elseif bd and bd.trn then   -- 炮管：跟着炮塔转，再绕耳轴俯仰、开炮往后坐（船尾的炮原模型里朝后：俯仰、后坐反过来）
            local piv = CF(bd.piv[1], bd.piv[2], bd.piv[3])
            local trn = CF(bd.trn[1] - bd.piv[1], bd.trn[2] - bd.piv[2], bd.trn[3] - bd.piv[3])
            local sg = (d.guns[bi] and d.guns[bi].aft) and -1 or 1
            table.insert(M.items, { p = mp, g = "bi", i = bi, piv = piv, trn = trn, sg = sg, off = (piv * trn):Inverse() * c })
          elseif cd then   -- 近防炮：整座绕自己的竖轴转（原模型里炮口朝 ry）
            local piv = CF(cd.piv[1], cd.piv[2], cd.piv[3])
            table.insert(M.items, { p = mp, g = "c", i = ci, piv = piv, off = piv:Inverse() * c })
          else
            table.insert(M.items, { p = mp, g = "hull", off = c })
          end
        end
      end
      -- 航行灯、舰旗挪到原模型上：最高的白灯 → 桅顶，左红右绿 → 舰桥两侧贴着原模型的外侧，最靠后的白灯 → 船尾甲板
      local top = info.top and V(info.top[1], info.top[2], info.top[3])
      local whites, mast, stern = {}, nil, nil
      for _, it in ipairs(M.items) do
        if it.tag == "lamp" then
          local c = it.p.Color
          if c.R > 0.9 and c.G > 0.9 then table.insert(whites, it)
          elseif info.side then
            local sx = (c.R > c.G) and -1 or 1   -- 红灯在左舷
            it.off = CF(sx * (info.side[1] + 0.4), info.side[2], info.side[3])
          end
        end
      end
      for _, it in ipairs(whites) do if not mast or it.off.Position.Y > mast.off.Position.Y then mast = it end end
      for _, it in ipairs(whites) do if it ~= mast and (not stern or it.off.Position.Z > stern.off.Position.Z) then stern = it end end
      if top and mast then mast.off = CF(top + V(0, 1.2, 0)) end
      if info.stern and stern then stern.off = CF(info.stern[1], info.stern[2] + 0.8, info.stern[3] + 0.3) end
      if top and M.flag then
        for _, it in ipairs(M.items) do
          if it.p == M.flag then it.off = CF(top + V(0, -1.6, 1.4)) end
        end
      end
      M.imported = d.id
    end
    return M
  end
  G.buildShipModel = build

  ---------------------------------------------------------------- 每帧

  local function angDiff(a, b) return (b - a + 180) % 360 - 180 end

  local function viewBuild(v, em, team)
    local d = SD.get(em:GetAttribute("Model") or "")
    if not d then return false end
    local M = build(d, team)
    v.M, v.d, v.model = M, d, M.model
    local anchor = Instance.new("Part")   -- 血条挂的点（桅杆上方）
    anchor.Size, anchor.Transparency, anchor.Anchored = V(0.2, 0.2, 0.2), 1, true
    anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = false, false, false
    anchor.Parent = M.model
    v.anchor = anchor
    -- 上船提示：船尾甲板上（码头在船尾或船边）
    local board = Instance.new("Part")
    board.Size, board.Transparency, board.Anchored = V(0.2, 0.2, 0.2), 1, true
    board.CanCollide, board.CanQuery, board.CanTouch = false, false, false
    board.Parent = M.model
    local pr = Instance.new("ProximityPrompt")
    pr.ActionText = T("ui.boardShip")
    pr.ObjectText = T("veh." .. d.id)
    pr.KeyboardKeyCode = Enum.KeyCode.E
    pr.HoldDuration = 0
    pr.MaxActivationDistance = d.W / 2 + 26
    pr.RequiresLineOfSight = false
    pr.Enabled = false
    pr.Parent = board
    pr.Triggered:Connect(function() G.R.Act:FireServer("enterVeh", v.id) end)
    v.board, v.prompt = board, pr
    v.plist, v.clist = {}, {}
    for i, it in ipairs(M.items) do v.plist[i] = it.p end
    v.base = v.root.CFrame * CF(0, -(d.H / 2 - d.draft), 0)
    v.ty, v.gp, v.rec = {}, {}, {}
    for gi in ipairs(d.guns) do v.ty[gi], v.gp[gi], v.rec[gi] = em:GetAttribute("Ty" .. gi) or 0, em:GetAttribute("Gp" .. gi) or 0, 0 end
    -- 近防炮：现在朝哪（cy，相对船头的度数，正数往右）、要转到哪（cyT）、最后一次开火（cyAt：三秒没打就慢慢转回原位）
    v.cy, v.cyT, v.cyAt = {}, {}, {}
    for mi in ipairs(d.ciws or {}) do
      local ry = (d.ciwsInfo and d.ciwsInfo[mi] and d.ciwsInfo[mi].ry) or 0
      v.cy[mi], v.cyT[mi], v.cyAt[mi] = ry, ry, -1e9
    end
    v.lids = {}   -- 掀开的垂发舱盖（开火时加，合上以后去掉）
    v.phase = math.random() * 6
    v.lastYaw = 0
    v.yawRate = 0
    v.frame = 0
    v.promptT = 0
    return true
  end

  local function viewStep(v, dt, camPos)
    local em, d, M = v.em, v.d, v.M
    local own = G.sail and G.sail.em == em and G.sail or nil
    -- 位置：自己开的用本地的；别人的快照插值（View.lua G.follow：匀速，不一顿一顿；跳太远直接过去）
    local target = v.root.CFrame * CF(0, -(d.H / 2 - d.draft), 0)
    if own and own.cf then v.base = own.cf
    else v.base = G.follow(v, target, 160) end
    local pos = v.base.Position
    local far = (pos - camPos).Magnitude
    v.frame += 1
    v.dtAcc = (v.dtAcc or 0) + dt
    if far > 2600 and v.frame % 4 ~= 0 then return end   -- 很远：四帧挪一次（这几帧的时间攒着一起算：下沉、浪的计时不变慢）
    dt = v.dtAcc
    v.dtAcc = 0
    local t = os.clock()
    local wreck = em:GetAttribute("Wreck") == true
    -- 速度、转向（转弯时外倾）
    local spd = own and own.speed or (em:GetAttribute("Sp") or 0)
    local _, yaw = v.base:ToEulerAnglesYXZ()
    local yr = angDiff(math.deg(v.lastYaw), math.deg(yaw)) / math.max(dt, 1e-3)
    v.lastYaw = yaw
    v.yawRate = v.yawRate + (yr - v.yawRate) * math.min(1, dt * 3)
    local frac = math.clamp(math.abs(spd) / math.max(1, d.speed), 0, 1)
    local k = math.clamp(60 / d.L, 0.12, 1.6)
    local ph = v.phase
    local bob = math.sin(t * 0.8 + ph) * 0.35 * k
    local pitch = math.sin(t * 0.6 + ph * 1.3) * 0.012 * k + frac * 0.01 * math.clamp(k, 0.3, 1)
    local roll = math.sin(t * 0.5 + ph * 0.7) * 0.025 * k + math.clamp(v.yawRate * math.abs(spd) * 0.00025, -0.09, 0.09)
    local cf = v.base * CF(0, bob, 0) * CFrame.Angles(pitch, 0, roll)
    -- 击沉：慢慢倾覆、下沉（20 多秒）
    if wreck then
      v.sinkT = (v.sinkT or 0) + dt
      local st = v.sinkT
      v.sinkDir = v.sinkDir or ((math.random() < 0.5) and -1 or 1)
      cf = v.base * CF(0, -math.min(st * 0.9, d.H * 0.95), 0) * CFrame.Angles(math.min(st * 0.012, 0.22), 0, v.sinkDir * math.min(st * 0.025, 0.55))
    end
    -- 炮塔、炮
    for gi in ipairs(d.guns) do
      local ty, gp
      if own and own.ty then ty, gp = own.ty[gi] or 0, own.gp[gi] or 0 else
        ty = v.ty[gi] + angDiff(v.ty[gi], em:GetAttribute("Ty" .. gi) or 0) * math.min(1, dt * 8)
        gp = v.gp[gi] + ((em:GetAttribute("Gp" .. gi) or 0) - v.gp[gi]) * math.min(1, dt * 8)
      end
      v.ty[gi], v.gp[gi] = ty, gp
      v.rec[gi] = math.max(0, v.rec[gi] - dt * 3)
    end
    local tcf, gcf = {}, {}
    for gi in ipairs(d.guns) do
      tcf[gi] = SD.turretCF(d, cf, gi, v.ty[gi])
      gcf[gi] = SD.gunCF(d, cf, gi, v.ty[gi], v.gp[gi]) * CF(0, 0, v.rec[gi])
    end
    -- 近防炮：转向最近一次打的目标（每秒最多 220 度），三秒没打就转回原位
    local cyR = {}
    for mi, ry in pairs(v.cy) do
      local want = (t - v.cyAt[mi] < 3) and v.cyT[mi] or ((d.ciwsInfo and d.ciwsInfo[mi] and d.ciwsInfo[mi].ry) or 0)
      local dd = angDiff(ry, want)
      local step = 220 * dt
      v.cy[mi] = ry + math.clamp(dd, -step, step)
      cyR[mi] = CFrame.Angles(0, -math.rad(v.cy[mi] - ((d.ciwsInfo and d.ciwsInfo[mi] and d.ciwsInfo[mi].ry) or 0)), 0)
    end
    local plist, clist = v.plist, v.clist
    for i, it in ipairs(M.items) do
      if it.g == "t" then clist[i] = tcf[it.i] * it.off
      elseif it.g == "g" then clist[i] = gcf[it.i] * it.off
      elseif it.g == "ti" then clist[i] = cf * it.piv * CFrame.Angles(0, -math.rad(v.ty[it.i] or 0), 0) * it.off   -- 原模型的主炮（船尾的炮原模型里本来就朝后）
      elseif it.g == "bi" then   -- 原模型的炮管：炮塔转 → 耳轴俯仰 → 后坐
        clist[i] = cf * it.piv * CFrame.Angles(0, -math.rad(v.ty[it.i] or 0), 0) * it.trn
          * CFrame.Angles(it.sg * math.rad(v.gp[it.i] or 0), 0, 0) * CF(0, 0, it.sg * (v.rec[it.i] or 0)) * it.off
      elseif it.g == "c" then clist[i] = cf * it.piv * (cyR[it.i] or CFrame.identity) * it.off
      else clist[i] = cf * it.off end
    end
    workspace:BulkMoveTo(plist, clist, Enum.BulkMoveMode.FireCFrameChanged)
    -- 垂发舱盖：0.22 秒掀开到 105 度，开 2.4 秒，0.5 秒合上；盖子绕格子靠船头那条边转（铰链在前），底下一块黑的是打开的格子
    for k2 = #v.lids, 1, -1 do
      local L = v.lids[k2]
      local a = t - L.t0
      local open
      if a < 0.22 then open = a / 0.22
      elseif a < 2.62 then open = 1
      elseif a < 3.12 then open = 1 - (a - 2.62) / 0.5
      else open = 0 end
      local base = cf * CF(L.lp)
      local hinge = base * CF(0, 0.08, -L.l / 2) * CFrame.Angles(-math.rad(105) * open, 0, 0) * CF(0, 0, L.l / 2)
      L.lid.CFrame = hinge
      L.hole.CFrame = base * CF(0, 0.03, 0)
      if a > 3.2 then
        L.lid:Destroy()
        L.hole:Destroy()
        table.remove(v.lids, k2)
      end
    end
    v.anchor.CFrame = cf * CF(0, d.H - d.draft + 4, 0)
    v.board.CFrame = cf * CF(0, d.deck + 2, d.L / 2 - math.min(10, d.L * 0.2))
    if v.bb and not v.bbSet then v.bbSet = true v.bb.MaxDistance = 1800 v.bb.Size = UDim2.fromOffset(70, 7) end
    -- 粒子：近处才算；浪花、尾迹跟速度，烟囱有人开 / 走起来冒烟；血少于四成着火冒黑烟
    if far < 2200 then
      local moving = not wreck and frac > 0.04
      for _, pe in ipairs(M.spray) do pe.Rate = moving and (frac * 40) or 0 end
      M.wake.Rate = moving and (2 + frac * 10) or 0
      local lit = (em:GetAttribute("Driver") or 0) ~= 0 or em:GetAttribute("AI") == true
      for _, pe in ipairs(M.smoke) do pe.Rate = wreck and 0 or ((lit and 1.5 or 0) + frac * 6) end
      local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
      local burning = wreck or hp < mx * 0.4
      M.fire.Rate = burning and (wreck and 40 or 18) or 0
      M.black.Rate = burning and (wreck and 14 or 6) or 0
      M.fireLight.Enabled = burning
      if burning then M.fireLight.Brightness = 2.2 + math.random() * 1.6 end
    end
    if M.flag then M.flag.CFrame = M.flag.CFrame * CFrame.Angles(0, math.sin(t * 6 + ph) * 0.04, 0) end
    if wreck and not v.darkened then   -- 沉船：灯灭、颜色发黑
      v.darkened = true
      for _, it in ipairs(M.items) do
        local p = it.p
        if p.Material == MAT.Neon then p.Transparency = 1 end
        for _, c in ipairs(p:GetChildren()) do
          if c:IsA("BillboardGui") or (c:IsA("PointLight") and c ~= M.fireLight) then c.Enabled = false end
        end
        if p:IsA("MeshPart") then   -- 原模型：贴图盖住颜色，烧黑要先把贴图去掉
          for _, sa in ipairs(p:GetChildren()) do if sa:IsA("SurfaceAppearance") then sa:Destroy() end end
          pcall(function() p.TextureID = "" end)
          if p.Transparency < 1 then p.Color = RGB(34, 33, 32) end
        elseif p.Transparency < 1 then p.Color = p.Color:Lerp(RGB(18, 18, 18), 0.5) end
      end
    end
    -- 上船提示：自己队的、没人开、不是 AI、没沉；自己活着、没在开别的
    v.promptT -= dt
    if v.promptT <= 0 then
      v.promptT = 0.25
      local ch = me.Character
      local hum = ch and ch:FindFirstChildOfClass("Humanoid")
      local ok = hum and hum.Health > 0 and not G.drive and G.S and G.S.alive and not G.S.veh
      v.prompt.Enabled = (ok and em:GetAttribute("Team") == me:GetAttribute("Side") and (em:GetAttribute("Driver") or 0) == 0
        and not em:GetAttribute("AI") and not wreck) and true or false
    end
  end

  local function viewRecoil(v, g)
    local gi = g or 1
    if v.rec and v.d and v.d.guns[gi] then v.rec[gi] = math.min(1.6, v.d.guns[gi].len * 0.11) end
  end

  -- 近防炮开火（Fx.lua 收到服务器的 gun / ciws，带着船的编号和第几座）：这一座转向目标
  local function viewCiws(v, mi, target)
    if not (v.cy and v.cy[mi] and v.d and v.d.ciws and v.d.ciws[mi]) or typeof(target) ~= "Vector3" then return end
    local cf = v.base or v.root.CFrame
    local lp = (cf * CF(v.d.ciws[mi])):PointToObjectSpace(target)
    v.cyT[mi] = math.deg(math.atan2(lp.X, -lp.Z))
    v.cyAt[mi] = os.clock()
  end

  -- 导弹出筒（Fx.lua 的 vls）：垂发掀开那一格的舱盖；斜置的发射箱箱口的盖子崩飞、箱尾往后喷一股燃气
  local function viewLaunch(v, e)
    local d = v.d
    if not d or not v.M then return end
    local cf = v.base or v.root.CFrame
    if e.b and e.c then
      local lp, w, l = SD.vlsCell(d, e.b, e.c)
      if not lp then return end
      local lid = Instance.new("Part")
      lid.Size, lid.Color, lid.Material = V(w * 0.86, 0.14, l * 0.86), RGB(74, 78, 80), MAT.DiamondPlate
      local hole = Instance.new("Part")
      hole.Size, hole.Color, hole.Material = V(w * 0.8, 0.04, l * 0.8), RGB(8, 8, 9), MAT.SmoothPlastic
      for _, p in ipairs({ lid, hole }) do
        p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
        p.CFrame = cf * CF(lp)
        p.Parent = v.M.model
      end
      table.insert(v.lids, { lid = lid, hole = hole, lp = lp, l = l * 0.86, t0 = os.clock() })
      G.shipLidCount = (G.shipLidCount or 0) + 1   -- 测试用
    elseif e.can then
      local mouth = SD.canTube(d, e.can, e.tube or 0)
      local rear = SD.canTube(d, e.can, e.tube or 0, true)
      if not mouth then return end
      local wm, wr = cf * mouth, cf * rear
      -- 箱口的盖子：一块圆片往前上方崩飞、翻着落进海里
      local cap = Instance.new("Part")
      cap.Shape, cap.Size, cap.Color, cap.Material = CYL, V(0.12, 1.3, 1.3), RGB(150, 148, 140), MAT.SmoothPlastic
      cap.Anchored, cap.CanCollide, cap.CanQuery, cap.CanTouch = true, false, false, false
      cap.CFrame = wm * CFrame.Angles(0, math.pi / 2, 0)
      cap.Parent = workspace
      local vel = wm.LookVector * 28 + V((math.random() - 0.5) * 6, 10, (math.random() - 0.5) * 6)
      local spin = V(math.random() * 12 - 6, math.random() * 12 - 6, math.random() * 12 - 6)
      local t0 = os.clock()
      local conn
      conn = game:GetService("RunService").Heartbeat:Connect(function(dt)
        if not cap.Parent or os.clock() - t0 > 3 then
          conn:Disconnect()
          cap:Destroy()
          return
        end
        vel += V(0, -60 * dt, 0)
        cap.CFrame = (cap.CFrame + vel * dt) * CFrame.Angles(spin.X * dt, spin.Y * dt, spin.Z * dt)
        if cap.CFrame.Position.Y < -1 then cap.Transparency = 1 end
      end)
      -- 箱尾燃气：往后一大团白烟；箱口一团火（Fx.lua 的 G.emitBurst 从看不见的小零件的正面喷）
      local function burst(pos, dir, o)
        if not G.emitBurst then return end
        local h = Instance.new("Part")
        h.Size, h.Transparency, h.Anchored = V(0.2, 0.2, 0.2), 1, true
        h.CanCollide, h.CanQuery, h.CanTouch = false, false, false
        h.CFrame = CFrame.lookAt(pos, pos + dir)
        h.Parent = workspace
        G.emitBurst(h, o)
        game:GetService("Debris"):AddItem(h, 3)
      end
      burst(wr.Position, -wm.LookVector, { life = { 0.8, 2.2 }, speed = { 26, 55 }, spread = 18, drag = 2.2, size = { 2.5, 11 }, tr = 0.3, color = RGB(232, 230, 224), n = 26 })
      burst(wm.Position, wm.LookVector, { life = { 0.15, 0.4 }, speed = { 30, 60 }, spread = 25, size = { 2.2, 0.4 }, tr = 0.05, color = RGB(255, 196, 110), glow = 1, n = 16 })
      G.shipCanCount = (G.shipCanCount or 0) + 1   -- 测试用
    end
  end

  G.viewKind = G.viewKind or {}
  G.viewKind.ship = { build = viewBuild, step = viewStep, recoil = viewRecoil, ciws = viewCiws, launch = viewLaunch, remove = function() end,
    importReady = function(v) return v.M ~= nil and not v.M.imported and v.d ~= nil and importedFor(v.d) ~= nil end }   -- 原模型后来才复制齐：View 重建
end

return ShipView
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="107">
          <Properties>
            <string name="Name">Soldier</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——机器人士兵：Roblox 正常小人 + 程序动画
--   用户：士兵用 Roblox 正常小人的建模；给小兵加上动画和姿势；每个人要有自己的动作逻辑，不要一堆人一模一样
--   样子：服务器开服时生成一个默认的 R15 小人当模板（ReplicatedStorage.BotRig，Bots.lua），每个机器人克隆一个：按队伍迷彩上色、手套黑，
--     戴头盔和夜视仪、右臂臂章、一支步枪；没有模板（Studio 里连不上资源、模拟测试）用零件拼一个关节名字一样的小人（经典圆头、笑脸）
--   动作全是程序算的（不用 Roblox 的动画资源，那套是拿玩具的姿势）：躯干、头按姿势摆，双手按反向运动学握在枪上（右手握把、左手护木），
--     脚按步态踩在地上（在地上那一段脚不打滑）——站着端枪 / 低姿持枪、走、跑（枪斜挎在胸前）、蹲着走、单膝跪射、卧倒瞄准、匍匐、
--     换弹匣（旧弹匣掉地上）、扔手雷、小队长打手势、开枪后坐和枪口焰、挨打一缩、四种倒法（往后倒、往前扑、侧着瘫下去、转半圈倒）
--   姿势从服务器的属性来（Bots.lua）：St 姿势（0 站、1 蹲 / 跪、2 卧）、Aim 枪口俯仰（度，有目标时才有）、Act 动作（"r12" 换弹、"g13" 扔雷、
--     "s14" 打手势；字母后面是序号，变了才算一次新的）、Ride 在登陆艇上（蹲着不迈腿）、DieD 打死的那一枪从哪边来（度，0 正前）
--   每个人不一样：按实体编号给一套自己的参数——步频、站姿宽窄、身子前倾多少、低姿持枪的枪口高低、跪哪条腿、东张西望和做小动作
--     （扶头盔、看枪、回头看）的间隔、枪口晃的大小、默认倒法
--   远了降帧：300 格外每秒 15 次、700 格外每秒 4 次；1500 格外（跟着自动画质缩放）整个收起来
--   零件都不碰撞、不挡射线（子弹打的是服务器上的命中盒）
local RS = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Soldier = {}

function Soldier.init(G)
  local Config = G.Config
  local V, CF, RGB = Vector3.new, CFrame.new, Color3.fromRGB
  local ANG = CFrame.Angles
  local PI = math.pi
  local UNIFORM = { atk = { RGB(150, 128, 92), RGB(110, 96, 70) }, def = { RGB(84, 104, 70), RGB(64, 78, 54) } }   -- 同 Round.lua 给玩家穿的
  local HELMET = { atk = RGB(96, 104, 72), def = RGB(146, 128, 96) }
  local SKIN, GLOVE, GUN = RGB(234, 194, 150), RGB(38, 38, 36), RGB(42, 44, 46)
  local HALF = 2.8   -- 服务器命中盒的中心在脚底上 2.8 格（趴下、蹲下也不变，变的是另一个命中零件）
  local UPV = V(0, 1, 0)
  local function clamp(x, a, b) return x < a and a or (x > b and b or x) end
  local function lerp(a, b, t) return a + (b - a) * t end
  local function lerpV(a, b, t) return a + (b - a) * t end
  local function sm(t) t = clamp(t, 0, 1) return t * t * (3 - 2 * t) end
  local function ease(rate, dt) return 1 - math.exp(-rate * dt) end

  local function quiet(p, anchored)
    p.Anchored = anchored == true
    p.CanCollide, p.CanQuery, p.CanTouch = false, false, false
    p.Massless = true
  end
  local function part(parent, size, color, mat, shape)
    local p = Instance.new("Part")
    if shape then p.Shape = shape end
    p.Size, p.Color = size, color
    p.Material = mat or Enum.Material.SmoothPlastic
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    quiet(p, false)
    p.Parent = parent
    return p
  end
  local function weld(p0, p1, c0)
    local w = Instance.new("Weld")
    w.Part0, w.Part1, w.C0 = p0, p1, c0
    w.Parent = p1
    return w
  end
  local function motor(name, p0, p1, c0, c1)
    local m = Instance.new("Motor6D")
    m.Name, m.Part0, m.Part1, m.C0, m.C1 = name, p0, p1, c0, c1 or CF()
    m.Parent = p1
    return m
  end

  -- 步枪（M4 的样子，全长 2.6 格 ≈ 0.85 米）：原点在握把顶上，枪口朝 −Z、顶上朝 +Y；挂在根零件上（RifleJ），每帧摆到该在的地方，双手去握它
  local RIF = { butt = V(0, 0.05, 0.74), grip = V(0, -0.02, 0.12), fore = V(0, -0.04, -0.8), mag = V(0, -0.38, -0.44), bolt = V(0.12, 0.24, -0.05),
    muzzle = V(0, 0.17, -1.92) }
  local function rifle(parent)
    local rr = part(parent, V(0.2, 0.2, 0.2), GUN)
    rr.Name, rr.Transparency = "RifleRoot", 1
    local function g(size, off, color, shape, mat)
      local p = part(parent, size, color or GUN, mat or Enum.Material.Metal, shape)
      weld(rr, p, off)
      return p
    end
    g(V(0.2, 0.3, 0.95), CF(0, 0.16, -0.3))                     -- 机匣
    g(V(0.2, 0.25, 0.62), CF(0, 0.17, -1.08))                   -- 护木
    g(V(0.52, 0.09, 0.09), CF(0, 0.17, -1.64) * ANG(0, PI / 2, 0), GUN, Enum.PartType.Cylinder)   -- 枪管
    g(V(0.18, 0.3, 0.62), CF(0, 0.07, 0.45))                    -- 枪托
    local mag = g(V(0.14, 0.42, 0.22), CF(0, -0.15, -0.42) * ANG(math.rad(-10), 0, 0))   -- 弹匣
    g(V(0.12, 0.32, 0.15), CF(0, -0.07, 0.04) * ANG(math.rad(18), 0, 0))                -- 握把
    g(V(0.14, 0.15, 0.34), CF(0, 0.38, -0.28), RGB(30, 31, 32))  -- 瞄准镜
    local fl = g(V(0.3, 0.3, 0.42), CF(RIF.muzzle + V(0, 0, -0.18)), RGB(255, 214, 140), Enum.PartType.Ball, Enum.Material.Neon)   -- 枪口焰
    fl.Name, fl.Transparency = "Flash", 1
    return rr, mag, fl
  end
  -- 头盔、夜视仪（头的大小按 1.2 格的 R15 头算，k 缩放）
  local function helmet(parent, head, team, k, y0)
    local col = HELMET[team] or HELMET.def
    local h = part(parent, V(1.42, 0.86, 1.5) * k, col, Enum.Material.Fabric)
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Parent = h
    weld(head, h, CF(0, y0 + 0.42 * k, 0.04 * k))
    weld(head, part(parent, V(1.46, 0.14, 1.54) * k, col:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Fabric), CF(0, y0 + 0.08 * k, 0.04 * k))
    weld(head, part(parent, V(0.34, 0.26, 0.16) * k, RGB(34, 36, 38), Enum.Material.Metal), CF(0, y0 + 0.42 * k, -0.74 * k))
    for _, sx in ipairs({ -1, 1 }) do   -- 夜视仪镜筒（翻上去的）
      weld(head, part(parent, V(0.4, 0.22, 0.22) * k, RGB(22, 24, 26), Enum.Material.Metal, Enum.PartType.Cylinder),
        CF(sx * 0.17 * k, y0 + 0.62 * k, -0.78 * k) * ANG(0, PI / 2, math.rad(70)))
    end
  end

  ---------------------------------------------------------------- 骨架：关节、骨长

  local JN = { "Root", "Waist", "Neck", "LeftShoulder", "LeftElbow", "LeftWrist", "RightShoulder", "RightElbow", "RightWrist",
    "LeftHip", "LeftKnee", "LeftAnkle", "RightHip", "RightKnee", "RightAnkle" }

  -- 两种小人共用：挂头盔、臂章、枪、手雷，量骨长
  local function finish(v, m, hrp, head, team, k, y0)
    local J = {}
    for _, d in ipairs(m:GetDescendants()) do
      if d:IsA("Motor6D") then J[d.Name] = { m = d, c0 = d.C0, c1 = d.C1, c1i = d.C1:Inverse() } end
    end
    for _, n in ipairs(JN) do if not J[n] then return false end end
    helmet(m, head, team, k, y0)
    local rua = J.RightShoulder.m.Part1
    weld(rua, part(m, V(rua.Size.X + 0.06, 0.3, rua.Size.Z + 0.06), Config.Teams[team or "atk"].color, Enum.Material.Neon), CF(0, 0.15, 0))
    local rr, mag, fl = rifle(m)
    v.rj = motor("RifleJ", hrp, rr, CF(0.6, -0.6, -1), CF())
    v.mag, v.flash = mag, fl
    local nade = part(m, V(0.38, 0.5, 0.38), RGB(66, 74, 56), Enum.Material.SmoothPlastic, Enum.PartType.Ball)   -- 手雷（扔的时候才露出来）
    nade.Name, nade.Transparency = "Nade", 1
    weld(J.RightWrist.m.Part1, nade, CF(0, -0.34, 0))
    v.nadeP = nade
    local function limb(a, b, c)
      local A, B, C = J[a], J[b], J[c]
      return { a = A, b = B, c = C, la = (B.c0.Position - A.c1.Position).Magnitude, lb = (C.c0.Position - B.c1.Position).Magnitude }
    end
    v.LA, v.RA = limb("LeftShoulder", "LeftElbow", "LeftWrist"), limb("RightShoulder", "RightElbow", "RightWrist")
    v.LL, v.RL = limb("LeftHip", "LeftKnee", "LeftAnkle"), limb("RightHip", "RightKnee", "RightAnkle")
    local foot = J.LeftAnkle.m.Part1
    v.ankH = J.LeftAnkle.c1.Position.Y + foot.Size.Y / 2   -- 脚放平时踝关节离地多高
    v.J = J
    v.gY = -v.hip   -- 地面（根零件坐标里）
    v.hipOff = J.LeftHip.c0.Position
    v.ltStand = v.gY + v.ankH + (v.LL.la + v.LL.lb) * 0.985 - v.hipOff.Y   -- 站着时下躯干中心多高（膝盖微屈，脚一定够得着地）
    return true
  end

  -- R15 小人（模板克隆）
  local function buildRig(v, tpl, team)
    local m = tpl:Clone()
    m.Name = "bot"
    local U = UNIFORM[team] or UNIFORM.atk
    local hrp = m:FindFirstChild("HumanoidRootPart")
    local head = m:FindFirstChild("Head")
    local hum = m:FindFirstChildOfClass("Humanoid")
    if not hrp or not head or not hum then
      m:Destroy()
      return false
    end
    local low = math.huge
    for _, p in ipairs(m:GetDescendants()) do
      if p:IsA("BasePart") then
        quiet(p, p == hrp)
        local n = p.Name
        if n == "Head" then p.Color = SKIN
        elseif string.find(n, "Hand") then p.Color = GLOVE
        elseif string.find(n, "Leg") or string.find(n, "Foot") or n == "LowerTorso" then p.Color = U[2]
        elseif string.find(n, "Arm") or n == "UpperTorso" then p.Color = U[1] end
        if p ~= hrp then low = math.min(low, p.Position.Y - p.Size.Y / 2) end
      elseif p:IsA("BodyColors") then
        p:Destroy()
      end
    end
    hrp.Transparency = 1
    hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
    pcall(function() hum.EvaluateStateMachine = false end)   -- 不跑人物的状态机（站、跳、掉）：位置是这里摆的
    local an = hum:FindFirstChildOfClass("Animator")   -- 动作全是这里算的：Roblox 的动画器去掉，免得它每帧把关节写回去
    if an then an:Destroy() end
    local hip = hrp.Position.Y - low
    -- R15 的 HipHeight 就是根零件底面离地多高，按它算更靠得住（模板的关节没解算时零件位置不对，量出来偏小，小人被摆低、半截身子埋在地里）
    if hum.RigType == Enum.HumanoidRigType.R15 and (hum.HipHeight or 0) > 0.5 then hip = hum.HipHeight + hrp.Size.Y / 2 end
    v.model, v.anchor, v.hrp, v.hip, v.rig = m, head, hrp, math.clamp(hip, 2.4, 3.6), true
    if not finish(v, m, hrp, head, team, head.Size.Y / 1.2, 0) then
      m:Destroy()
      return false
    end
    return true
  end

  -- 零件拼的小人：关节名字、层级照 R15（同一套姿势代码），头是经典的圆头笑脸
  local function buildParts(v, team)
    local m = Instance.new("Model")
    m.Name = "bot"
    local U = UNIFORM[team] or UNIFORM.atk
    local function P(name, size, color)
      local p = part(m, size, color)
      p.Name = name
      return p
    end
    local hrp = P("HumanoidRootPart", V(2, 2, 1), U[1])
    hrp.Transparency, hrp.Anchored = 1, true
    local lt = P("LowerTorso", V(1.9, 0.45, 0.95), U[2])
    local ut = P("UpperTorso", V(2, 1.6, 1), U[1])
    local head = P("Head", V(2, 1, 1), SKIN)
    local hm = Instance.new("SpecialMesh")
    hm.MeshType = Enum.MeshType.Head
    hm.Scale = V(1.25, 1.25, 1.25)
    hm.Parent = head
    local face = Instance.new("Decal")
    face.Name = "face"
    face.Texture = "rbxasset://textures/face.png"
    face.Face = Enum.NormalId.Front
    face.Parent = head
    motor("Root", hrp, lt, CF(0, -0.8, 0), CF())
    motor("Waist", lt, ut, CF(0, 0.2, 0), CF(0, -0.8, 0))
    motor("Neck", ut, head, CF(0, 0.8, 0), CF(0, -0.55, 0))
    for _, s in ipairs({ -1, 1 }) do
      local side = (s < 0) and "Left" or "Right"
      local ua = P(side .. "UpperArm", V(0.95, 1.2, 0.95), U[1])
      local la = P(side .. "LowerArm", V(0.9, 1.1, 0.9), U[1])
      local hd = P(side .. "Hand", V(0.85, 0.32, 0.85), GLOVE)
      motor(side .. "Shoulder", ut, ua, CF(s * 1.5, 0.6, 0), CF(0, 0.4, 0))
      motor(side .. "Elbow", ua, la, CF(0, -0.55, 0), CF(0, 0.5, 0))
      motor(side .. "Wrist", la, hd, CF(0, -0.45, 0), CF(0, 0.1, 0))
      local ul = P(side .. "UpperLeg", V(0.95, 1.2, 0.95), U[2])
      local ll = P(side .. "LowerLeg", V(0.9, 1.1, 0.9), U[2])
      local ft = P(side .. "Foot", V(0.9, 0.3, 1.2), RGB(40, 38, 34))
      motor(side .. "Hip", lt, ul, CF(s * 0.5, -0.2, 0), CF(0, 0.5, 0))
      motor(side .. "Knee", ul, ll, CF(0, -0.45, 0), CF(0, 0.45, 0))
      motor(side .. "Ankle", ll, ft, CF(0, -0.4, 0), CF(0, 0.05, 0.15))
    end
    v.model, v.anchor, v.hrp, v.hip, v.rig = m, head, hrp, 3.0, false
    return finish(v, m, hrp, head, team, 1, 0)
  end

  ---------------------------------------------------------------- 每个人自己的参数

  local function rng(seed)
    local s = math.floor(seed) % 2147483647
    if s <= 0 then s += 2147483646 end
    return function()
      s = (s * 16807) % 2147483647
      return s / 2147483647
    end
  end
  local function personal(v)
    local n = tonumber(string.match(tostring(v.id or ""), "%d+")) or math.random(1, 999999)
    local r = rng(n * 7919 + 101)
    for _ = 1, 4 do r() end
    v.P = {
      cad = 0.9 + r() * 0.2,          -- 步频（步子大小跟着变：脚在地上那一段不打滑）
      width = 0.38 + r() * 0.26,      -- 站姿宽窄
      lean = -0.02 - r() * 0.08,      -- 身子前倾
      carry = r(),                    -- 低姿持枪：枪口往下多少
      look = 2.5 + r() * 6,           -- 东张西望的间隔（秒）
      fidget = 12 + r() * 24,         -- 小动作的间隔
      die = 1 + math.floor(r() * 4),  -- 默认倒法
      sway = 0.5 + r() * 1.0,         -- 枪口晃
      phase = r() * PI * 2,
      kneelL = r() < 0.25,            -- 跪左腿（多数跪右腿）
      cant = (r() - 0.5) * 0.12,      -- 枪身歪一点
      bob = 0.8 + r() * 0.5,          -- 跑起来上下颠的大小
    }
    v.ph = v.P.phase
  end

  ---------------------------------------------------------------- 反向运动学

  -- 一段两节的肢体（肩—肘—腕 / 髋—膝—踝）：父零件 P0（根零件坐标）不动，末端关节放到 W，肘 / 膝往 pole 那边弯；
  --   leg：腿（膝盖往前、小腿往后折）；返回上节、下节、末端零件的 CFrame（末端朝向给了 endRot 就用它，不然顺着下节）；
  --   够不着时伸直、末端停在够得着的地方
  local function ik(Lb, P0, W, pole, leg, endRot)
    local A, B, C = Lb.a, Lb.b, Lb.c
    local la, lb = Lb.la, Lb.lb
    local S = P0 * A.c0.Position
    local d = W - S
    local L = d.Magnitude
    local reach = (la + lb) * 0.97
    if L > reach and L > 1e-4 then   -- 够不着：肩膀往前探一点（最多 0.65 格，R15 的肩膀太宽、胳膊短），胳膊和身子错开一点看不出来
      local k = math.min(L - reach, 0.7)
      S += d * (k / L)
      d = W - S
      L = d.Magnitude
    end
    local du = (L > 1e-4) and d / L or V(0, -1, 0)
    L = clamp(L, math.abs(la - lb) + 0.02, (la + lb) * 0.999)
    local ca = clamp((la * la + L * L - lb * lb) / (2 * la * L), -1, 1)
    local sa = math.sqrt(math.max(0, 1 - ca * ca))
    local pp = pole - du * pole:Dot(du)
    if pp.Magnitude < 1e-4 then pp = (math.abs(du.Y) < 0.9) and UPV:Cross(du) or V(1, 0, 0) end
    pp = pp.Unit
    local E = S + du * (la * ca) + pp * (la * sa)
    local Wc = S + du * L
    local hx = leg and du:Cross(pp) or pp:Cross(du)   -- 关节的转轴（零件的 X）
    local y1 = (S - E).Unit
    local x1 = hx - y1 * hx:Dot(y1)
    x1 = (x1.Magnitude > 1e-4) and x1.Unit or V(1, 0, 0)
    local r1 = CFrame.fromMatrix(Vector3.zero, x1, y1, x1:Cross(y1))
    local y2 = (E - Wc).Unit
    local x2 = x1 - y2 * x1:Dot(y2)
    x2 = (x2.Magnitude > 1e-4) and x2.Unit or x1
    local r2 = CFrame.fromMatrix(Vector3.zero, x2, y2, x2:Cross(y2))
    local r3 = endRot or r2
    return CF(S - r1:VectorToWorldSpace(A.c1.Position)) * r1, CF(E - r2:VectorToWorldSpace(B.c1.Position)) * r2,
      CF(Wc - r3:VectorToWorldSpace(C.c1.Position)) * r3
  end
  -- 关节的 C0：让子零件正好在 P1（父零件在 P0）——Part1 = Part0 * C0 * C1⁻¹
  local function setJ(Jx, P0, P1) Jx.m.C0 = P0:Inverse() * P1 * Jx.c1 end
  local function fkCF(Jx, P0, rot) return P0 * Jx.c0 * rot * Jx.c1i end
  local function limbIK(v, Lb, P0, W, pole, leg, endRot)
    local a, b, c = ik(Lb, P0, W, pole, leg, endRot)
    setJ(Lb.a, P0, a)
    setJ(Lb.b, a, b)
    setJ(Lb.c, b, c)
    return c
  end

  ---------------------------------------------------------------- 动作的关键帧

  -- 换弹匣（2.4 秒）：左手 0 护木 → 弹匣（拔下来、掉地上）→ 胸前弹匣包 → 插上 → 拉枪机 → 回护木；{ 时刻, 跟着谁（"r" 枪 / "u" 上身）, 点 }
  local RELOAD = { { 0, "r", RIF.fore }, { 0.32, "r", RIF.mag }, { 0.55, "r", RIF.mag + V(0, -0.2, 0.05) }, { 0.95, "u", V(-0.42, -0.42, -0.62) },
    { 1.25, "u", V(-0.4, -0.36, -0.66) }, { 1.6, "r", RIF.mag + V(0, -0.06, 0) }, { 1.78, "r", RIF.mag }, { 2.0, "r", RIF.bolt }, { 2.4, "r", RIF.fore } }
  local function keyAt(K, a)
    if a <= K[1][1] then return K[1] , K[1], 0 end
    for i = 2, #K do
      if a <= K[i][1] then return K[i - 1], K[i], sm((a - K[i - 1][1]) / (K[i][1] - K[i - 1][1])) end
    end
    return K[#K], K[#K], 0
  end

  ---------------------------------------------------------------- 每帧的姿势

  local function stepPose(v, dt)
    local P, J = v.P, v.J
    local t = os.clock()
    local gY, ank = v.gY, v.ankH
    local st = v.st or 0
    v.wK = v.wK + (((st == 1) and 1 or 0) - v.wK) * ease((st == 1) and 7 or 5, dt)
    v.wP = v.wP + (((st == 2) and 1 or 0) - v.wP) * ease(2.6, dt)
    local wK, wP = v.wK, v.wP
    local sp = v.ride and 0 or (v.spd or 0)
    local mv = sm((sp - 0.6) / 2.4)       -- 在走
    local run = sm((sp - 9) / 6) * (1 - wK) * (1 - wP)   -- 在跑
    local wS = (1 - wK) * (1 - wP)
    -- 戒备（有目标、刚开过枪）：抵肩瞄准；不然低姿持枪，跑起来斜挎在胸前
    local alert = (v.aimSeen ~= nil and t - v.aimSeen < 2.5) or (v.fireT ~= nil and t - v.fireT < 3)
    v.wA = v.wA + ((alert and 1 or 0) - v.wA) * ease(alert and 8 or 2.2, dt)
    local wA = v.wA * (1 - 0.7 * run)
    local wPort = run * (1 - wA)
    v.aimS = v.aimS + ((v.aimP or 0) - v.aimS) * ease(6, dt)
    local aimP = v.aimS
    -- 步态：步频按速度、每人不一样；一步走多远 = 速度 ÷ 步频（脚在地上那一段正好跟身体走的一样多，不打滑）
    local cad
    if wP > 0.5 then cad = clamp(0.8 + sp * 0.3, 0.8, 1.7)
    elseif wK > 0.5 then cad = clamp(1.7 + sp * 0.2, 1.7, 3.0)
    else cad = clamp(2.4 + sp * 0.15, 2.4, 4.6) end
    cad = cad * P.cad
    if mv > 0.01 then v.ph = (v.ph + dt * cad * PI) % (PI * 2) end
    local duty = lerp(0.62, 0.36, sm((sp - 3) / 7)) + 0.12 * wK
    local half = math.min(duty * sp / math.max(cad, 0.5), 1.35)
    local lift = (lerp(0.16, 0.6, run) + 0.1 * mv) * (1 - wK * 0.4)
    local function foot(ph)
      local u = (ph % (PI * 2)) / (PI * 2)
      if u < duty then
        local s = u / duty
        return lerp(-half, half, s), 0, (s > 0.65) and -(s - 0.65) / 0.35 * 0.5 or 0   -- z（往后为正）、抬多高、脚掌俯仰（蹬地时脚跟抬）
      end
      local s = (u - duty) / (1 - duty)
      local a = sm(s / 0.3)   -- 刚抬脚时脚跟还抬着（接着蹬地那一下），往前摆时勾脚尖，落地前放平
      return lerp(half, -half, sm(s)), lift * math.sin(PI * s), -0.5 * (1 - a) + 0.25 * math.sin(PI * s) * a
    end
    local zl, yl, pl = foot(v.ph)
    local zr, yr, pr = foot(v.ph + PI)
    -- 骨盆：站（呼吸、重心左右换、走起来上下颠、跑起来前倾）/ 蹲跪 / 趴
    local bob = (lerp(0.03, 0.14, run) * P.bob) * (0.5 - 0.5 * math.cos(v.ph * 2)) * mv
    -- 步子迈开了腿要够得着地：骨盆按步长往下沉（弯着膝盖走，像战术行进），够不着才会脚打滑
    local reachL = (v.LL.la + v.LL.lb) * 0.95
    local hipH = v.ltStand + v.hipOff.Y - (gY + ank)
    local sink = math.max(0, hipH - math.sqrt(math.max(0, reachL * reachL - half * half))) * mv
    local shift = math.sin(t * 0.45 + P.phase) * 0.06 * (1 - mv)
    local ltStand = CF(shift, v.ltStand - 0.03 - bob - sink, 0) * ANG(P.lean - 0.2 * run - 0.04 * mv, 0.07 * math.sin(v.ph) * mv, 0.035 * math.sin(v.ph) * mv)
    local kn = P.kneelL and -1 or 1
    local kneeY = gY + 0.3
    local ltKneelY = kneeY + v.RL.la * 0.96 - v.hipOff.Y
    local ltKneel = CF(0, lerp(ltKneelY, v.ltStand - 0.62, mv), lerp(0.12, 0, mv)) * ANG(lerp(-0.06, -0.36, mv), 0, 0)
    local crawl = math.sin(v.ph) * mv
    local ltProne = CF(0.08 * crawl, gY + 0.56, 0.62) * ANG(-PI / 2 + 0.07, 0.07 * crawl, 0.05 * crawl)
    local LT = ltStand:Lerp(ltKneel, wK):Lerp(ltProne, wP)
    -- 动作（换弹、扔雷、手势、小动作）
    local act = v.act
    local aT = act and (t - act.t0) or 0
    if act and aT > act.dur then
      v.act, act = nil, nil
      if v.mag then v.mag.Transparency = 0 end
      if v.nadeP then v.nadeP.Transparency = 1 end
    end
    local throwK = (act and act.k == "g") and sm(math.min(aT / 0.15, (act.dur - aT) / 0.2)) or 0
    -- 挨打一缩（衰减的一下）
    local fl = v.flT and math.exp(-(t - v.flT) * 7) * math.min(1, (t - v.flT) * 30) or 0
    -- 上身：瞄准时侧过身（右肩往后，像真的端枪），头转回来对着前面；扔雷先往右拧再往左甩
    local twist = (-0.62 * wA - 0.3 * (1 - wA) + 0.2 * wPort) * (1 - wP)
    local throwTw = 0
    if throwK > 0 then throwTw = (aT < 0.55) and 0.5 * sm((aT - 0.2) / 0.3) or lerp(0.5, -0.55, sm((aT - 0.55) / 0.15)) end
    twist = lerp(twist, throwTw, throwK)
    local breath = math.sin(t * 1.7 + P.phase) * 0.012
    local wPitch = (aimP * 0.3 * wA) * (1 - wP) + 0.16 * wP + fl * 0.22 + 0.08 * wK * (1 - wP)
    local UT = LT * J.Waist.c0 * ANG(wPitch + breath, twist + 0.07 * math.sin(v.ph) * mv * wS, fl * 0.1 * (v.flS or 1)) * J.Waist.c1i
    -- 头：瞄准时贴腮（低一点、歪向右边的枪）；平时东张西望（每人自己的间隔）
    if t > (v.lookAt or 0) then
      v.lookAt = t + P.look * (0.5 + math.random())
      v.lookTo = (math.random() - 0.5) * 1.7
      v.lookUp = (math.random() - 0.6) * 0.3
    end
    local idle = (1 - wA) * (1 - mv)
    v.look = v.look + ((v.lookTo or 0) * idle - v.look) * ease(2.5, dt)
    local nPitch = (aimP * 0.5 - 0.16) * wA * (1 - wP) + (v.lookUp or 0) * idle + 1.05 * wP + fl * 0.25
    local nYaw = -twist * 0.9 + v.look
    local nRoll = -0.14 * wA * (1 - wP)
    -- 小动作：回头看
    if act and act.k == "f" and act.v == 3 then nYaw += 1.15 * sm(math.min(aT / 0.4, (act.dur - aT) / 0.4)) end
    if act and act.k == "f" and act.v == 2 then nPitch -= 0.4 * sm(math.min(aT / 0.3, (act.dur - aT) / 0.3)) end
    local HD = UT * J.Neck.c0 * ANG(nPitch, nYaw, nRoll) * J.Neck.c1i
    -- 枪：三种端法按权重混——低姿（枪托在胸口、枪口朝下）、跑（斜挎胸前，枪口朝左上）、瞄准（枪托抵右肩、枪口指向目标）
    local sw = P.sway * (1 - 0.6 * wA)
    local swy = math.noise(t * 0.7, P.phase) * 0.03 * sw
    local swp = math.noise(P.phase, t * 0.6) * 0.025 * sw
    local readyDir = UT:VectorToWorldSpace(V(-0.3, -math.sin(0.5 + 0.35 * P.carry), -math.cos(0.5 + 0.35 * P.carry)))
    local readyR = CFrame.lookAt(Vector3.zero, readyDir, UT.UpVector) * ANG(0, 0, P.cant)
    local ready = CF(UT * V(0.4, 0.1, -0.6) - readyR:VectorToWorldSpace(RIF.butt)) * readyR
    local portR = CFrame.lookAt(Vector3.zero, UT:VectorToWorldSpace(V(-0.55, 0.62, -0.56)), UT:VectorToWorldSpace(V(0.4, 0.4, -0.6)))
    local port = CF(UT * V(0.5, -0.45, -0.66) - portR:VectorToWorldSpace(RIF.butt)) * portR
    local aimDir = V(math.sin(swy) * math.cos(aimP), math.sin(aimP + swp), -math.cos(aimP) * math.cos(swy))
    if wP > 0.5 then aimDir = V(aimDir.X, math.sin(aimP * 0.5 + swp), aimDir.Z) end
    local aimR = CFrame.lookAt(Vector3.zero, aimDir, UPV) * ANG(0, 0, P.cant * 0.5)
    local aimC = CF(UT * V(0.7, 0.9, -0.5) - aimR:VectorToWorldSpace(RIF.butt)) * aimR
    local rif = ready:Lerp(port, wPort):Lerp(aimC, wA)
    -- 后坐：枪往后一顶、枪口往上跳；换弹时枪往里收、侧过来
    local rec = v.rec or 0
    if rec > 0.001 then rif = rif * CF(0, 0, 0.16 * rec) * ANG(0.08 * rec, 0, 0) end
    if act and act.k == "r" then
      local k = sm(math.min(aT / 0.3, (act.dur - aT) / 0.35))
      local rlR = CFrame.lookAt(Vector3.zero, UT:VectorToWorldSpace(V(-0.25, 0.3, -1)), UT.UpVector) * ANG(0, 0, 0.6)
      rif = rif:Lerp(CF(UT * V(0.45, 0.25, -0.75) - rlR:VectorToWorldSpace(RIF.grip)) * rlR, k)
    end
    if throwK > 0 then   -- 扔雷：枪换到左手、枪口朝下垂在左边
      local hangR = CFrame.lookAt(Vector3.zero, UT:VectorToWorldSpace(V(0.1, -0.85, -0.5)), UT:VectorToWorldSpace(V(0, 0.4, -1)))
      rif = rif:Lerp(CF(UT * V(-0.95, -0.35, -0.75) - hangR:VectorToWorldSpace(RIF.fore)) * hangR, throwK)
    end
    if v.dropR then rif = v.dropR end
    v.rj.C0 = rif
    -- 手：右手握把，左手护木；动作的时候换地方
    local rW = rif * RIF.grip
    local lW = rif * lerpV(RIF.fore, V(0, -0.12, -0.5), wP)   -- 趴着：左手托在弹匣前面（胳膊撑在地上够不到护木前头）
    if act and act.k == "r" then
      local a0, a1, k = keyAt(RELOAD, aT)
      local p0 = (a0[2] == "r") and rif * a0[3] or UT * a0[3]
      local p1 = (a1[2] == "r") and rif * a1[3] or UT * a1[3]
      lW = lerpV(p0, p1, k)
      if aT > 0.5 and aT < 1.55 and v.mag and v.mag.Transparency < 1 then
        v.mag.Transparency = 1
        if not act.dropped then   -- 旧弹匣掉到地上
          act.dropped = true
          local d = v.mag:Clone()
          d.Transparency = 0
          d.Anchored = true
          d.Parent = v.model.Parent
          local p0w = (v.hrp.CFrame * rif * CF(RIF.mag)).Position
          local gy = (v.hrp.CFrame * V(0, gY + 0.1, 0)).Y
          d.CFrame = CF(p0w)
          pcall(function()
            game:GetService("TweenService"):Create(d, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
              { CFrame = CF(p0w.X, gy, p0w.Z) * ANG(PI / 2, math.random() * 6, 0) }):Play()
          end)
          Debris:AddItem(d, 6)
        end
      elseif aT >= 1.55 and v.mag and v.mag.Transparency > 0 then
        v.mag.Transparency = 0
      end
    elseif act and act.k == "g" then
      -- 右手：掏雷（胸前）→ 举到脑后 → 往前上方甩出去（0.62 秒出手）→ 往下收
      local K = { { 0, V(0.3, -0.3, -0.7) }, { 0.22, V(0.35, -0.35, -0.68) }, { 0.52, V(1.25, 1.35, 0.55) }, { 0.66, V(0.45, 1.25, -1.65) }, { 0.9, V(0.15, -0.2, -1.2) }, { 1.1, V(0.3, -0.3, -0.7) } }
      local a0, a1, k = keyAt(K, aT)
      rW = rW:Lerp(UT * lerpV(a0[2], a1[2], k), throwK)
      if v.nadeP then v.nadeP.Transparency = (aT > 0.18 and aT < 0.64) and 0 or 1 end
    elseif act and act.k == "s" then
      -- 手势（往前推进）：左手离开枪，举起来往前劈两下
      local K = { { 0, nil }, { 0.25, V(-0.85, 1.55, -1.25) }, { 0.45, V(-0.85, 0.85, -1.85) }, { 0.65, V(-0.85, 1.5, -1.3) }, { 0.85, V(-0.85, 0.85, -1.85) }, { 1.2, nil } }
      local a0, a1, k = keyAt(K, aT)
      local p0, p1 = a0[2] and UT * a0[2] or lW, a1[2] and UT * a1[2] or lW
      lW = lerpV(p0, p1, k)
    elseif act and act.k == "f" and act.v == 1 then   -- 小动作：扶一下头盔
      local k = sm(math.min(aT / 0.35, (act.dur - aT) / 0.35))
      lW = lerpV(lW, HD * V(-0.75, 0.45, -0.1), k)
    end
    -- 胳膊：肘往外下方（瞄准时右肘抬起来）；趴着时肘撑在地上
    local rPole = UT:VectorToWorldSpace(V(1, lerp(-1, -0.35, wA), 0.35))
    local lPole = UT:VectorToWorldSpace(V(-0.8, -1.2, 0.15))
    if wP > 0.5 then rPole, lPole = V(0.6, -1, 0.3), V(-0.6, -1, 0.3) end
    limbIK(v, v.RA, UT, rW, rPole, false, nil)
    limbIK(v, v.LA, UT, lW, lPole, false, nil)
    -- 腿：站 / 走（步态）、蹲跪（跪的那条腿膝盖着地、脚背贴地）、趴（伸直、脚尖点地、匍匐时轮流收一条腿）
    local hxL, hxR = J.LeftHip.c0.Position.X, J.RightHip.c0.Position.X
    local wide = (P.width - 0.5) * (1 - run)
    local stag = 0.2 * (1 - mv)   -- 站着：左脚在前一点（端枪的站法）
    local function toe(p) return (p < 0) and 0.72 * math.sin(-p) or 0.22 * math.sin(p) end   -- 蹬地绕脚尖、勾脚尖绕脚跟：踝关节跟着抬
    local sL = V(hxL - wide * 0.5 + run * 0.14, gY + ank + (yl + toe(pl)) * mv, lerp(-stag, zl, mv))
    local sR = V(hxR + wide * 0.5 - run * 0.14, gY + ank + (yr + toe(pr)) * mv, lerp(stag * 0.5, zr, mv))
    local flatL = ANG(lerp(0, pl, mv), lerp(0.12, 0, mv), 0)
    local flatR = ANG(lerp(0, pr, mv), lerp(-0.25, 0, mv), 0)
    local kx, fx = (kn > 0) and hxR or hxL, (kn > 0) and hxL or hxR
    local kneeBack = V(kx * 1.05, gY + 0.26, 0.12 + v.RL.lb * 0.96)
    local kneeFront = V(fx * 1.15, gY + ank, -0.85)
    local cL = V(hxL * 1.1, gY + ank + yl * mv * 0.7, zl * 0.8)
    local cR = V(hxR * 1.1, gY + ank + yr * mv * 0.7, zr * 0.8)
    local kL = lerpV((kn > 0) and kneeFront or kneeBack, cL, mv)
    local kR = lerpV((kn > 0) and kneeBack or kneeFront, cR, mv)
    local kRotBack = ANG(2.9, 0, 0)   -- 跪着的那只脚：脚背贴地、脚掌朝上朝后
    local kRL = (kn > 0) and ANG(0, 0, 0) or kRotBack
    local kRR = (kn > 0) and kRotBack or ANG(0, 0, 0)
    local hipW = LT * V(0, v.hipOff.Y, 0)
    local legL = (v.LL.la + v.LL.lb) * 0.97
    local pL = V(hxL * 1.3 + 0.35 * math.max(0, crawl), gY + 0.34, hipW.Z + legL - 0.7 * math.max(0, crawl))
    local pR = V(hxR * 1.3 - 0.35 * math.max(0, -crawl), gY + 0.34, hipW.Z + legL - 0.7 * math.max(0, -crawl))
    local pRot = ANG(-2.84, 0, 0)   -- 趴着：脚尖朝后、脚背贴地
    local tL = lerpV(lerpV(sL, kL, wK), pL, wP)
    local tR = lerpV(lerpV(sR, kR, wK), pR, wP)
    local rL = flatL:Lerp(kRL:Lerp(flatL, mv), wK):Lerp(pRot, wP)
    local rR = flatR:Lerp(kRR:Lerp(flatR, mv), wK):Lerp(pRot, wP)
    local poleL = lerpV(V(-0.2, -0.15 * wK, -1), V(0.25 * math.max(0, crawl), -1, 0.1), wP)
    local poleR = lerpV(V(0.2, -0.15 * wK, -1), V(-0.25 * math.max(0, -crawl), -1, 0.1), wP)
    if kn > 0 then poleR = lerpV(poleR, V(0, -1, -0.5), wK * (1 - mv) * (1 - wP)) else poleL = lerpV(poleL, V(0, -1, -0.5), wK * (1 - mv) * (1 - wP)) end
    limbIK(v, v.LL, LT, tL, poleL, true, rL)
    limbIK(v, v.RL, LT, tR, poleR, true, rR)
    -- 躯干、头
    setJ(J.Root, CF(), LT)
    J.Waist.m.C0 = LT:Inverse() * UT * J.Waist.c1
    J.Neck.m.C0 = UT:Inverse() * HD * J.Neck.c1
    -- 枪口焰：开枪后一闪
    if v.flash then
      local on = v.fireT ~= nil and t - v.fireT < 0.05
      v.flash.Transparency = on and 0.1 or 1
      if on then v.flash.Size = V(0.26, 0.26, 0.36) * (0.8 + math.random() * 0.6) end
    end
    v.rec = (v.rec or 0) * math.exp(-dt * 16)
  end

  ---------------------------------------------------------------- 倒下

  -- 四种倒法：1 往后倒（膝盖一软、仰面倒下）、2 往前扑（跪下、脸朝下扑倒）、3 侧着瘫下去（蜷着腿）、4 转半圈仰面倒
  --   趴着被打死的：头一垂、胳膊一松；终点姿势用正向运动学（关节角）算一次，过程按关节的 C0 插值
  local function fkSet(v, LT, A)
    local J = v.J
    local out = { Root = LT * J.Root.c1 }
    local function fkv(name, a) out[name] = J[name].c0 * ANG(a[1], a[2], a[3]) end
    fkv("Waist", A.waist)
    fkv("Neck", A.neck)
    fkv("LeftShoulder", A.lsh)
    fkv("RightShoulder", A.rsh)
    fkv("LeftElbow", A.lel)
    fkv("RightElbow", A.rel)
    fkv("LeftWrist", { 0, 0, 0 })
    fkv("RightWrist", { 0, 0, 0 })
    fkv("LeftHip", A.lhp)
    fkv("RightHip", A.rhp)
    fkv("LeftKnee", A.lkn)
    fkv("RightKnee", A.rkn)
    fkv("LeftAnkle", A.lan or { 0.5, 0, 0 })
    fkv("RightAnkle", A.ran or { 0.5, 0, 0 })
    return out
  end
  local function deathPlan(v)
    local P, gY = v.P, v.gY
    local kind = P.die
    local dd = v.em and v.em:GetAttribute("DieD")
    if type(dd) == "number" then
      local a = math.abs(dd)
      if a < 55 then kind = (P.die % 2 == 0) and 4 or 1
      elseif a > 125 then kind = 2
      else kind = 3 end
    end
    local side = (type(dd) == "number" and dd > 0) and -1 or 1   -- 往挨打的另一边倒
    local mid, fin
    if (v.wP or 0) > 0.5 then
      local LT = CF(0, gY + 0.5, 0.62) * ANG(-PI / 2 + 0.03, 0.15 * side, 0.12 * side)
      fin = fkSet(v, LT, { waist = { 0.02, 0, 0 }, neck = { 0.55, 0.9 * side, 0 }, lsh = { 2.6, 0, 0.5 }, rsh = { 2.2, 0, -0.7 }, lel = { 0.3, 0, 0 }, rel = { 0.6, 0, 0 },
        lhp = { 0, 0, -0.12 }, rhp = { 0, 0, 0.18 }, lkn = { -0.2, 0, 0 }, rkn = { -0.05, 0, 0 }, lan = { -1.2, 0, 0 }, ran = { -1.2, 0, 0 } })
      return { kind = 0, fin = fin, t1 = 0.01, t2 = 0.45 }
    end
    local kneelLT = CF(0, gY + 0.32 + v.RL.la * 0.96 - v.hipOff.Y, 0.15)
    if kind == 1 or kind == 4 then
      mid = fkSet(v, kneelLT * ANG(0.25, 0, 0), { waist = { 0.25, 0, 0 }, neck = { 0.4, 0, 0 }, lsh = { 0.9, 0, 0.6 }, rsh = { 1.1, 0, -0.5 }, lel = { 0.5, 0, 0 }, rel = { 0.6, 0, 0 },
        lhp = { 0.9, 0, 0 }, rhp = { 0.6, 0, 0 }, lkn = { -1.6, 0, 0 }, rkn = { -1.9, 0, 0 } })
      local spin = (kind == 4) and 1.5 * side or 0.2 * side
      fin = fkSet(v, CF(0.4 * side, gY + 0.5, 1.6) * ANG(0, spin, 0) * ANG(PI / 2 - 0.06, 0, 0.05 * side), { waist = { 0.08, 0, 0 }, neck = { -0.1, 1.0 * side, 0 },
        lsh = { 0.4, 0, 1.45 }, rsh = { 0.9, 0, -1.2 }, lel = { 0.5, 0, 0 }, rel = { 0.25, 0, 0 },
        lhp = { 0.35, 0, -0.2 }, rhp = { 0.1, 0, 0.25 }, lkn = { -0.8, 0, 0 }, rkn = { -0.2, 0, 0 }, lan = { 0.6, 0, 0 }, ran = { 0.8, 0, 0 } })
    elseif kind == 2 then
      mid = fkSet(v, CF(0, gY + 0.32 + v.LL.la * 0.95 - v.hipOff.Y, 0.25) * ANG(-0.35, 0, 0), { waist = { -0.35, 0, 0 }, neck = { -0.3, 0, 0 },
        lsh = { 0.3, 0, -0.1 }, rsh = { 0.5, 0, 0.1 }, lel = { 0.2, 0, 0 }, rel = { 0.2, 0, 0 },
        lhp = { 1.3, 0, 0 }, rhp = { 1.3, 0, 0 }, lkn = { -1.5, 0, 0 }, rkn = { -1.5, 0, 0 }, lan = { -1.0, 0, 0 }, ran = { -1.0, 0, 0 } })
      fin = fkSet(v, CF(0.2 * side, gY + 0.5, -1.3) * ANG(0, 0.3 * side, 0) * ANG(-PI / 2 + 0.05, 0, 0), { waist = { 0.02, 0, 0 }, neck = { 0.5, 1.25 * side, 0 },
        lsh = { 2.4, 0, 0.9 }, rsh = { 0.4, 0, -0.35 }, lel = { 1.2, 0, 0 }, rel = { 0.2, 0, 0 },
        lhp = { 0, 0, -0.15 }, rhp = { 0.5, 0, 0.3 }, lkn = { -0.1, 0, 0 }, rkn = { -1.0, 0, 0 }, lan = { -1.3, 0, 0 }, ran = { -1.1, 0, 0 } })
    else
      mid = fkSet(v, kneelLT * ANG(-0.2, 0, 0.25 * side), { waist = { -0.3, 0, 0.2 * side }, neck = { -0.5, 0, 0.3 * side }, lsh = { 0.3, 0, -0.2 }, rsh = { 0.3, 0, 0.2 }, lel = { 0.6, 0, 0 }, rel = { 0.6, 0, 0 },
        lhp = { 1.2, 0, 0 }, rhp = { 1.0, 0, 0 }, lkn = { -1.7, 0, 0 }, rkn = { -1.8, 0, 0 } })
      fin = fkSet(v, CF(1.1 * side, gY + 0.62, 0.35) * ANG(0, -0.4 * side, 0) * ANG(0.15, 0, PI / 2 * 0.96 * side), { waist = { -0.35, 0, 0 }, neck = { -0.3, 0, 0.35 * side },
        lsh = { 1.1, 0, -0.3 * side }, rsh = { 0.8, 0, 0.2 * side }, lel = { 1.0, 0, 0 }, rel = { 0.9, 0, 0 },
        lhp = { 1.0, 0, 0 }, rhp = { 0.7, 0, 0 }, lkn = { -1.4, 0, 0 }, rkn = { -1.1, 0, 0 } })
    end
    return { kind = kind, mid = mid, fin = fin, t1 = (kind == 2) and 0.32 or 0.26, t2 = (kind == 2) and 0.82 or 0.9, side = side }
  end

  ---------------------------------------------------------------- 接到 View.lua（G.viewKind.bot）

  local dying = {}
  G.viewKind = G.viewKind or {}
  local function attrs(v)
    local em = v.em
    v.st = em:GetAttribute("St") or 0
    v.ride = em:GetAttribute("Ride") == true
    local a = em:GetAttribute("Aim")
    if type(a) == "number" then
      v.aimP = math.rad(clamp(a, -60, 60))
      v.aimSeen = os.clock()
    end
    local act = em:GetAttribute("Act") or ""
    if v.actSeen == nil then v.actSeen = act end   -- 刚生成就带着的旧动作不放
    if type(act) == "string" and act ~= v.actSeen then
      v.actSeen = act
      local k = string.sub(act, 1, 1)
      if k == "r" then v.act = { k = "r", t0 = os.clock(), dur = 2.45 }
      elseif k == "g" then v.act = { k = "g", t0 = os.clock(), dur = 1.15 } v.fireT = os.clock()
      elseif k == "s" then v.act = { k = "s", t0 = os.clock(), dur = 1.2 } end
    end
    local hp = em:GetAttribute("Hp") or 1
    if v.hpSeen2 and hp < v.hpSeen2 and hp > 0 then v.flT, v.flS = os.clock(), (math.random() < 0.5) and -1 or 1 end
    v.hpSeen2 = hp
  end
  G.viewKind.bot = {
    build = function(v, em, team)
      local tpl = RS:FindFirstChild("BotRig")
      local ok = tpl and buildRig(v, tpl, team)
      if not ok then ok = buildParts(v, team) end
      if not ok then return false end
      personal(v)
      v.spd, v.lastP = 0, v.root.CFrame.Position
      v.cf = v.root.CFrame
      v.wK, v.wP, v.wA, v.aimS, v.look, v.acc = 0, 0, 0, 0, 0, 0
      attrs(v)
      v.wK = (v.st == 1) and 1 or 0
      v.wP = (v.st == 2) and 1 or 0
      v.hrp.CFrame = v.cf * CF(0, v.hip - HALF, 0)
      G.try_(stepPose, v, 0)
      return true
    end,
    step = function(v, dt, camPos)
      local target = v.root.CFrame
      local p = target.Position
      -- 远了（1500 格外，跟着自动画质 G.perfK 缩放）：整个人收起来（不画、动作也不算）；回到范围里再摆回去
      local dist = (p - camPos).Magnitude
      local hideD = 1500 * (G.perfK or 1)
      if dist > hideD then
        if not v.hidden then
          v.hidden, v.home = true, v.model.Parent
          v.model.Parent = nil
        end
        v.cf, v.lastP, v.spd, v.fl = target, p, 0, nil   -- 插值的快照也扔掉：回到范围里从当时的位置重新开始
        return
      elseif v.hidden and dist < hideD * 0.95 then
        v.hidden = false
        v.model.Parent = v.home
      end
      -- 位置：快照插值（View.lua G.follow：匀速走）
      v.cf = G.follow(v, target)
      v.lastP = p
      local fv = v.fl.vel
      v.spd = v.spd + (V(fv.X, 0, fv.Z).Magnitude - v.spd) * math.min(1, dt * 5)
      v.hrp.CFrame = v.cf * CF(0, v.hip - HALF, 0)
      -- 动作：远了降帧
      v.acc += dt
      local gap = (dist > 700 * (G.perfK or 1)) and 0.25 or ((dist > 300) and 1 / 15 or 0)
      if v.acc < gap then return end
      local d2 = v.acc
      v.acc = 0
      attrs(v)
      stepPose(v, math.min(d2, 0.3))
    end,
    -- 开枪（Fx 的 gun 带着开枪的实体编号）：后坐、枪口焰，之后几秒保持端枪
    recoil = function(v)
      v.fireT = os.clock()
      v.rec = math.min(1.4, (v.rec or 0) + 1)
    end,
    -- 死了：按倒法倒下，枪脱手掉地上；8 秒后消失（最后一秒沉到地下）；返回 true = 模型自己收（View.lua 不马上删）
    remove = function(v)
      if (v.em:GetAttribute("Hp") or 1) > 0 then return false end
      if v.bb then v.bb:Destroy() end
      local ok, plan = pcall(deathPlan, v)
      if not ok or not plan then return false end
      local c0 = {}
      for n, Jx in pairs(v.J) do c0[n] = Jx.m.C0 end
      plan.c0, plan.t0, plan.cf = c0, os.clock(), v.cf
      plan.rif0 = v.rj.C0
      local s = plan.side or 1
      plan.rif1 = CF(0.9 * s + (math.random() - 0.5), v.gY + 0.14, -0.4 + math.random() * 1.2) * ANG(0, math.random() * 6.28, PI / 2 * s)
      v.flash.Transparency = 1
      if v.nadeP then v.nadeP.Transparency = 1 end
      table.insert(dying, { v = v, plan = plan })
      return true
    end,
  }
  -- 枪口在哪（Fx 画机器人开枪的曳光从枪口出来，不从头上）
  function G.botMuzzle(id)
    local v = G.viewById and G.viewById(id)
    if not v or not v.rj or v.hidden then return nil end
    return (v.hrp.CFrame * v.rj.C0 * CF(RIF.muzzle)).Position
  end
  G.frameConn("Soldier", function()
    local t = os.clock()
    for i = #dying, 1, -1 do
      local d = dying[i]
      local v, P = d.v, d.plan
      local a = t - P.t0
      if a > 8 or not v.model.Parent then
        v.model:Destroy()
        table.remove(dying, i)
      else
        -- 两段：先软下去（膝盖一软 / 跪下），再倒（像被重力拽下去，越倒越快），最后落地轻轻一弹
        local from, to, k
        if P.mid and a < P.t1 then
          from, to, k = P.c0, P.mid, sm(a / P.t1)
        else
          local a2 = (a - (P.mid and P.t1 or 0)) / (P.t2 - (P.mid and P.t1 or 0))
          from, to = P.mid or P.c0, P.fin
          k = clamp(a2, 0, 1)
          k = k * k
          if a2 > 1 then k = 1 + 0.04 * math.sin(math.min(1, (a2 - 1) * 2.5) * PI) end
        end
        for n, Jx in pairs(v.J) do
          local c1 = to[n]
          if c1 then Jx.m.C0 = from[n]:Lerp(c1, k) end
        end
        local kr = clamp(a / 0.5, 0, 1)
        v.rj.C0 = P.rif0:Lerp(P.rif1, kr * kr)
        local sink = (a > 7) and (a - 7) * 2.2 or 0
        v.hrp.CFrame = P.cf * CF(0, v.hip - HALF - sink, 0)
      end
    end
  end)
end

return Soldier
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="108">
          <Properties>
            <string name="Name">Tablet</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——遥控无人机的战术平板（用户：无人机驾驶应该是用一个战术平板）
--   开无人机时（Fly.lua：st.uav）人站在原地端着平板（服务器 Air.lua 摆胳膊、焊平板零件，别人看得到这个人在遥控），自己的画面就是这块平板：
--     四周一圈加固外壳（黑色玻璃边、两侧橡胶握条、前置摄像头、指示灯、硬键），屏幕里是无人机的画面——前视光电（默认）/ 外部视角（右键或 V），
--     Z 变焦 1× / 3× / 8×（滚轮细调）；屏幕上叠地面站的遥测：录像计时、数据链信号（卫通满格；视距的离得越远越弱，弱了画面出雪花）、
--     平板电量、时间、航向带、高度 / 速度 / 离操作员多远 / 瞄准点距离和坐标；
--     拿出平板：整屏先黑、外壳从下往上抬进画面，屏幕「建立数据链…」再出画面；收起：外壳往下落，露出身边的样子；操作员（自己）挨打时屏幕边一圈红闪
--   没在遥控时：自己放出去的无人机断了链路在天上盘旋（服务器 Loiter，75 秒）或停在地上 → 提示「按 T 重新连接无人机」（手机上点提示）
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local Tablet = {}

function Tablet.init(G)
  local me = Players.LocalPlayer
  local RGB = Color3.fromRGB
  local UDs, UDo, UD = UDim2.fromScale, UDim2.fromOffset, UDim2.new
  local V2 = Vector2.new
  local function T(k, ...) return G.T(k, ...) end
  local mob = G.mobile == true
  local AL, AC, AR = Enum.TextXAlignment.Left, Enum.TextXAlignment.Center, Enum.TextXAlignment.Right

  -- 屏幕在画面里的位置（比例）；手机上外壳窄，留地方给触屏按钮
  local X0, Y0, X1, Y1 = 0.062, 0.07, 0.938, 0.872
  if mob then X0, Y0, X1, Y1 = 0.026, 0.035, 0.974, 0.955 end
  G.tabletRect = { X0, Y0, X1, Y1 }

  local gui = Instance.new("ScreenGui")
  gui.Name = "UavTablet"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
  gui.DisplayOrder = -1   -- 在主界面、驾驶平显下面：比分、小地图、平显照样盖在上面
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local function fr(parent, pos, size, col, tr)
    local f = Instance.new("Frame")
    f.Position, f.Size = pos, size
    f.BackgroundColor3 = col or RGB(0, 0, 0)
    f.BackgroundTransparency = tr or 0
    f.BorderSizePixel = 0
    f.Parent = parent
    return f
  end
  local function corner(f, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r)
    c.Parent = f
  end
  local function stroke(f, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = col, th, tr or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
  end
  local function shade(f, a, b, rot)   -- 外壳的明暗（UIGradient 乘在底色上）
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(Color3.new(a, a, a), Color3.new(b, b, b))
    g.Rotation = rot
    g.Parent = f
  end
  local function fade(f, t0, t1, rot)   -- 渐隐（屏幕四边压暗）
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new(t0, t1)
    g.Rotation = rot
    g.Parent = f
  end
  local function txt(parent, text, pos, size, ts, col, font, ax, anchor)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position, l.Size = pos, size
    l.AnchorPoint = anchor or V2(0, 0)
    l.Text = text
    l.TextSize = ts
    l.TextColor3 = col
    l.Font = font or Enum.Font.Code
    l.TextXAlignment = ax or AL
    l.TextStrokeTransparency = 0.6
    l.TextStrokeColor3 = RGB(0, 0, 0)
    l.Parent = parent
    return l
  end

  ---------------------------------------------------------------- 外壳

  local statics = {}   -- 外壳上印的字：{ 标签, 文字编号 }（拿出平板时按当前语言重写）
  local black = fr(gui, UDs(0, 0), UDs(1, 1), RGB(0, 0, 0), 1)   -- 拿出来那一下整屏先黑（外壳还没抬到位，不露出无人机的画面）
  local root = fr(gui, UDs(0, 1), UDs(1, 1), RGB(0, 0, 0), 1)    -- 整块平板：拿出来 / 收起时整块上下滑
  local SHELL = RGB(52, 56, 50)
  local E = 0.004
  shade(fr(root, UDs(0, 0), UDs(1, Y0 + E), SHELL), 1.0, 0.82, 90)
  shade(fr(root, UDs(0, Y1 - E), UDs(1, 1 - Y1 + E), SHELL), 0.86, 0.6, 90)
  shade(fr(root, UDs(0, 0), UDs(X0 + E, 1), SHELL), 0.7, 0.95, 0)
  shade(fr(root, UDs(X1 - E, 0), UDs(1 - X1 + E, 1), SHELL), 0.95, 0.7, 0)
  -- 屏幕外一圈黑玻璃边：屏幕大小的透明框 + 圆角 + 粗描边（描边画在框外面，顺带把方角和圆角之间的缝填上）
  local glass = fr(root, UDs(X0, Y0), UDs(X1 - X0, Y1 - Y0), RGB(0, 0, 0), 1)
  corner(glass, mob and 10 or 16)
  stroke(glass, RGB(12, 14, 14), mob and 10 or 26)
  local edge = fr(root, UDs(X0, Y0), UDs(X1 - X0, Y1 - Y0), RGB(0, 0, 0), 1)   -- 显示区边上一道很细的反光
  corner(edge, mob and 10 or 16)
  stroke(edge, RGB(120, 130, 130), 1, 0.75)
  if not mob then
    -- 两侧橡胶握条（一道道横纹）
    for _, side in ipairs({ { 0.012, X0 - 0.024 }, { X1 + 0.012, 1 - X1 - 0.024 } }) do
      local g = fr(root, UDs(side[1], 0.3), UDs(side[2], 0.4), RGB(26, 28, 26))
      corner(g, 10)
      stroke(g, RGB(14, 15, 14), 1)
      for i = 1, 11 do fr(g, UDs(0.15, i / 12), UD(0.7, 0, 0, 2), RGB(44, 47, 44)) end
    end
    -- 顶边：前置摄像头、光线传感器、两个指示灯
    local lens = fr(root, UD(0.5, -7, Y0 * 0.5, -7), UDo(14, 14), RGB(6, 7, 9))
    corner(lens, 7)
    stroke(lens, RGB(70, 74, 70), 1.5)
    local glint = fr(lens, UDo(3, 3), UDo(4, 4), RGB(90, 120, 170))
    corner(glint, 2)
    corner(fr(root, UD(0.5, 22, Y0 * 0.5, -3), UDo(6, 6), RGB(10, 11, 12)), 3)
    G.tabletLeds = {}
    for i, name in ipairs({ "LINK", "PWR" }) do
      local x = (i == 1) and (X0 + 0.01) or (X1 - 0.05)
      local led = fr(root, UD(x, 0, Y0 * 0.5, -4), UDo(8, 8), RGB(80, 230, 110))
      corner(led, 4)
      txt(root, name, UD(x, 14, Y0 * 0.5, -7), UDo(60, 14), 11, RGB(150, 156, 150), Enum.Font.GothamMedium)
      G.tabletLeds[name] = led
    end
    -- 底边：牌子、四个硬键（键帽上印着键位）
    statics[#statics + 1] = { txt(root, "", UD(X0 + 0.004, 0, Y1 + (1 - Y1) * 0.18, 0), UDo(360, 18), 12, RGB(132, 138, 130), Enum.Font.GothamBold), "uav.brand" }
    local keys = { { "V", "uav.kCam" }, { "Z", "uav.kZoom" }, { "N", "uav.kNv" }, { "F", "uav.kExit" } }
    for i, kk in ipairs(keys) do
      local x = X1 - 0.004 - (#keys - i + 1) * 0.052
      local cap = fr(root, UD(x, 0, Y1 + (1 - Y1) * 0.16, 0), UDo(46, 22), RGB(28, 30, 28))
      corner(cap, 5)
      stroke(cap, RGB(78, 82, 76), 1)
      txt(cap, kk[1], UDs(0, 0), UDs(1, 1), 13, RGB(230, 232, 226), Enum.Font.GothamBold, AC).TextStrokeTransparency = 1
      statics[#statics + 1] = { txt(root, "", UD(x, 23, Y1 + (1 - Y1) * 0.16, 24), UDo(80, 14), 10, RGB(130, 136, 128), Enum.Font.GothamMedium, AC, V2(0.5, 0)), kk[2] }
    end
  end

  ---------------------------------------------------------------- 屏幕上的遥测

  local osd = fr(root, UDs(X0, Y0), UDs(X1 - X0, Y1 - Y0), RGB(0, 0, 0), 1)
  osd.ClipsDescendants = true
  -- 四边压暗一点（像小屏幕看画面）
  fade(fr(osd, UDs(0, 0), UDs(1, 0.14), RGB(0, 0, 0), 0.35), 0, 1, 90)
  fade(fr(osd, UDs(0, 0.86), UDs(1, 0.14), RGB(0, 0, 0), 0.35), 1, 0, 90)
  fade(fr(osd, UDs(0, 0), UDs(0.07, 1), RGB(0, 0, 0), 0.45), 0, 1, 0)
  fade(fr(osd, UDs(0.93, 0), UDs(0.07, 1), RGB(0, 0, 0), 0.45), 1, 0, 0)
  local WHITE, AMBER, RED = RGB(236, 240, 236), RGB(255, 206, 110), RGB(255, 84, 72)
  -- 顶上一条状态栏
  local bar = fr(osd, UDs(0, 0), UD(1, 0, 0, 26), RGB(0, 0, 0), 0.5)
  local recDot = fr(bar, UD(0, 10, 0.5, -5), UDo(10, 10), RED)
  corner(recDot, 5)
  local recText = txt(bar, "", UDo(26, 0), UD(0, 90, 1, 0), 14, WHITE)
  local linkText = txt(bar, "", UDo(114, 0), UD(0, 60, 1, 0), 14, WHITE)
  local sig = {}   -- 信号格：五根一根比一根高的竖条
  for i = 1, 5 do sig[i] = fr(bar, UD(0, 166 + (i - 1) * 6, 1, -5 - i * 2.4), UDo(4, i * 2.4), WHITE) end
  local linkType = txt(bar, "", UDo(202, 0), UD(0, 80, 1, 0), 14, WHITE)
  local title = txt(bar, "", UDs(0.5, 0), UD(0, 420, 1, 0), 14, WHITE, Enum.Font.GothamBold, AC, V2(0.5, 0))
  local batText = txt(bar, "", UD(1, -12, 0, 0), UD(0, 230, 1, 0), 14, WHITE, Enum.Font.Code, AR, V2(1, 0))
  -- 航向带：每 10° 一格，看得见左右 30°
  local tape = fr(osd, UD(0.5, 0, 0, 32), UD(0.4, 0, 0, 22), RGB(0, 0, 0), 0.65)
  tape.AnchorPoint = V2(0.5, 0)
  tape.ClipsDescendants = true
  local marks = {}
  local NAMES = { [0] = "N", [90] = "E", [180] = "S", [270] = "W" }
  for i = 0, 35 do
    local a = i * 10
    local s = NAMES[a] or ((a % 30 == 0) and tostring(a // 10) or "·")
    marks[i] = txt(tape, s, UDs(0.5, 0.5), UDo(30, 20), (NAMES[a] and 15) or 13, NAMES[a] and AMBER or WHITE, Enum.Font.GothamBold, AC, V2(0.5, 0.5))
    marks[i].Visible = false
  end
  fr(tape, UD(0.5, -1, 0, 0), UD(0, 2, 0, 5), AMBER)
  local hdgText = txt(osd, "", UD(0.5, 0, 0, 56), UDo(70, 18), 14, AMBER, Enum.Font.Code, AC, V2(0.5, 0))
  -- 左下：遥测
  local tele = fr(osd, UD(0, 14, 1, -138), UDo(220, 120), RGB(0, 0, 0), 0.6)
  corner(tele, 6)
  local tl = {}
  for i = 1, 5 do tl[i] = txt(tele, "", UDo(10, 4 + (i - 1) * 22), UD(1, -16, 0, 20), 15, WHITE) end
  -- 右下：瞄准点坐标
  local aimBox = fr(osd, UD(1, -14, 1, -82), UDo(230, 64), RGB(0, 0, 0), 0.6)
  aimBox.AnchorPoint = V2(1, 0)
  corner(aimBox, 6)
  local al1 = txt(aimBox, "", UDo(10, 6), UD(1, -16, 0, 20), 15, AMBER)
  local al2 = txt(aimBox, "", UDo(10, 32), UD(1, -16, 0, 20), 15, WHITE)
  -- 前视光电的十字线（中间留空）、倍率
  local cross = {}
  for i, v in ipairs({ { -1, 0 }, { 1, 0 }, { 0, -1 }, { 0, 1 } }) do
    local w, h = (v[1] ~= 0) and 54 or 2, (v[2] ~= 0) and 54 or 2
    local f = fr(osd, UD(0.5, v[1] * (16 + 27) - w / 2, 0.5, v[2] * (16 + 27) - h / 2), UDo(w, h), WHITE, 0.15)
    stroke(f, RGB(0, 0, 0), 1, 0.45)
    cross[i] = f
  end
  local zoomText = txt(osd, "", UD(0.5, 64, 0.5, 40), UDo(80, 18), 15, WHITE)
  -- 信号弱：一条条横着的雪花
  local noise = {}
  for i = 1, 9 do
    local f = fr(osd, UDs(0, 0), UD(1, 0, 0, 3), RGB(255, 255, 255), 1)
    noise[i] = f
  end
  local weakText = txt(osd, "", UD(0.5, 0, 0, 80), UDo(300, 20), 16, AMBER, Enum.Font.GothamBold, AC, V2(0.5, 0))
  -- 操作员挨打：屏幕边一圈红闪 + 字
  local hurt = fr(osd, UDo(8, 8), UD(1, -16, 1, -16), RGB(0, 0, 0), 1)
  local hurtS = stroke(hurt, RED, 8, 1)
  local hurtText = txt(osd, "", UD(0.5, 0, 0, 104), UDo(420, 24), 18, RED, Enum.Font.GothamBold, AC, V2(0.5, 0))
  -- 开机：黑屏 + 「建立数据链…」+ 进度条
  local boot = fr(osd, UDs(0, 0), UDs(1, 1), RGB(4, 6, 6), 0)
  local bootT = txt(boot, "", UDs(0.5, 0.46), UDo(420, 24), 18, RGB(150, 230, 170), Enum.Font.Code, AC, V2(0.5, 0.5))
  local bootBg = fr(boot, UD(0.5, -130, 0.52, 0), UDo(260, 4), RGB(40, 60, 46))
  local bootBar = fr(bootBg, UDs(0, 0), UDs(0, 1), RGB(120, 230, 150))

  ---------------------------------------------------------------- 开、关、每帧

  local S = { open = false, t = 0, closeT = nil, st = nil, hp = nil, hurtT = -9, bat = nil, tool = nil }
  local RAISE, BOOT = 0.35, 0.9

  function G.tabletOpen(st)
    S.open, S.st, S.t, S.closeT = true, st, 0, nil
    S.bat = S.bat or math.random(76, 96)
    gui.Enabled = true
    root.Position = UDs(0, 1)
    black.BackgroundTransparency = 0
    boot.Visible, boot.BackgroundTransparency = true, 0
    bootT.TextTransparency = 0
    bootT.Text = T("uav.link")
    bootBar.BackgroundTransparency, bootBg.BackgroundTransparency = 0, 0
    for _, x in ipairs(statics) do x[1].Text = T(x[2]) end
    -- 枪收起来（两只手端着平板），收平板时再拿回来
    local char = me.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local tool = char and char:FindFirstChildOfClass("Tool")
    S.tool = tool
    if hum and tool then hum:UnequipTools() end
    S.hp = hum and hum.Health or nil
    S.hurtT = -9
  end
  function G.tabletClose()
    if not S.open then return end
    S.open, S.st, S.closeT = false, nil, 0
    local tool = S.tool
    S.tool = nil
    local char = me.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if tool and hum and hum.Health > 0 and tool.Parent and tool.Parent ~= char and not tool.Parent:IsA("Model") then hum:EquipTool(tool) end
  end
  G.tabletState = S

  local function fmtClock(s)
    s = math.max(0, math.floor(s))
    return string.format("%02d:%02d", s // 60, s % 60)
  end
  local function angDiff(a, b) return (b - a + 180) % 360 - 180 end

  local function stepOpen(dt)
    local st = S.st
    S.t += dt
    local t = S.t
    -- 抬进画面（先快后慢）；开机画面
    local k = math.clamp(t / RAISE, 0, 1)
    root.Position = UDs(0, (1 - k) * (1 - k) * 1.0)
    black.BackgroundTransparency = (k >= 1) and 1 or 0
    if t < RAISE + BOOT then
      local b = math.clamp((t - RAISE * 0.6) / BOOT, 0, 1)
      bootBar.Size = UDs(b, 1)
      boot.Visible, boot.BackgroundTransparency = true, 0
      bootT.TextTransparency = 0
    else
      local f = math.clamp((t - RAISE - BOOT) / 0.3, 0, 1)
      boot.BackgroundTransparency = f
      bootT.TextTransparency = f
      bootBar.BackgroundTransparency, bootBg.BackgroundTransparency = f, f
      boot.Visible = f < 1
    end
    if not st or not st.d then return end
    local d = st.d
    local cf = st.cf
    local pos = cf.Position
    local M = G.AD and G.AD.M or 3.57
    -- 离操作员多远、数据链信号（卫通满格；视距的越远越弱）
    local char = me.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local dist = hrp and (pos - hrp.Position).Magnitude or 0
    local R = (G.Map and G.Map.R) or 3000
    local bars = d.sat and 5 or math.clamp(5 - math.floor(dist / (R * 0.45)), 1, 5)
    linkText.Text = T("uav.linkName")
    linkType.Text = T(d.sat and "uav.sat" or "uav.los")
    for i, f in ipairs(sig) do
      f.BackgroundColor3 = (bars <= 1) and AMBER or WHITE
      f.BackgroundTransparency = (i <= bars) and 0 or 0.75
    end
    if G.tabletLeds then
      G.tabletLeds.LINK.BackgroundColor3 = (bars <= 1 and (os.clock() * 3) % 1 < 0.5) and RGB(60, 40, 20) or RGB(80, 230, 110)
    end
    -- 录像计时、电量、时间
    recText.Text = T("uav.rec") .. " " .. fmtClock(t)
    recDot.BackgroundTransparency = ((os.clock() % 1) < 0.55) and 0 or 1
    S.bat = math.max(5, S.bat - dt / 45)
    local now = os.date and os.date("*t")
    batText.Text = T("uav.bat", math.floor(S.bat)) .. (now and string.format("   %02d:%02d", now.hour, now.min) or "")
    -- 标题：型号 · 镜头 · 倍率
    local nose = st.dcam == "nose"
    title.Text = T("veh." .. d.id) .. "  ·  " .. T(nose and "uav.nose" or "uav.chase") .. (nose and string.format("  ×%.1f", st.zoomS or 1) or "")
    -- 航向带（看的方向：前视看镜头方向、外部看机头方向）
    local look = nose and workspace.CurrentCamera.CFrame.LookVector or cf.LookVector
    local hdg = (math.deg(math.atan2(look.X, -look.Z)) + 360) % 360
    for i = 0, 35 do
      local dd = angDiff(hdg, i * 10)
      local l = marks[i]
      if math.abs(dd) < 33 then
        l.Visible = true
        l.Position = UDs(0.5 + dd / 66, 0.5)
      else
        l.Visible = false
      end
    end
    hdgText.Text = string.format("%03d°", math.floor(hdg + 0.5) % 360)
    -- 遥测
    local gy = G.AD and G.AD.ground and G.AD.ground(G.Map, pos.X, pos.Z) or 0
    local kmh = math.floor(st.vel.Magnitude / M * 3.6 + 0.5)
    tl[1].Text = T("uav.alt", math.max(0, math.floor((pos.Y - math.max(gy, 0)) / M + 0.5)))
    tl[2].Text = T("uav.spd", kmh)
    tl[3].Text = T("uav.vs", string.format("%+.0f", st.vel.Y / M))
    tl[4].Text = T("uav.dist", string.format("%.1f", dist / M / 1000))
    tl[5].Text = T("uav.flr", st.flares or 0)
    local ap = st.aimPt
    if ap then
      al1.Text = T("uav.aim", string.format("%.1f", (ap - pos).Magnitude / M / 1000))
      al2.Text = string.format("E %05d  N %05d", math.floor((ap.X + 20000) / M) % 100000, math.floor((20000 - ap.Z) / M) % 100000)
    else
      al1.Text, al2.Text = "", ""
    end
    -- 前视：十字线、倍率
    for _, f in ipairs(cross) do f.Visible = nose end
    zoomText.Visible = nose
    zoomText.Text = string.format("×%.1f", st.zoomS or 1)
    -- 信号弱：雪花
    local weak = bars <= 1
    for i, f in ipairs(noise) do
      if weak and math.random() < 0.7 then
        f.BackgroundTransparency = 0.55 + math.random() * 0.4
        f.Position = UDs(0, math.random())
        f.Size = UD(1, 0, 0, math.random(1, 5))
      else
        f.BackgroundTransparency = 1
      end
    end
    weakText.Text = weak and T("uav.weak") or ""
    -- 操作员挨打
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
      if S.hp and hum.Health < S.hp - 0.5 then S.hurtT = os.clock() end
      S.hp = hum.Health
    end
    local ht = os.clock() - S.hurtT
    if ht < 2.5 then
      local a = 0.5 + 0.5 * math.cos(ht * 12)
      hurtS.Transparency = 0.15 + 0.5 * a
      hurtText.Text = T("uav.hit")
      hurtText.TextTransparency = 0.3 * a
    else
      hurtS.Transparency = 1
      hurtText.Text = ""
    end
  end

  ---------------------------------------------------------------- 重连提示

  local hintGui = Instance.new("ScreenGui")
  hintGui.Name = "UavLink"
  hintGui.ResetOnSpawn = false
  hintGui.IgnoreGuiInset = true
  hintGui.DisplayOrder = 3
  hintGui.Parent = me:WaitForChild("PlayerGui")
  local hint = Instance.new("TextButton")
  hint.Size = UDo(440, 34)
  hint.Position = UD(0.5, 0, 1, -206)   -- 在夜视提示（-168）上面
  hint.AnchorPoint = V2(0.5, 1)
  hint.BackgroundColor3 = RGB(10, 14, 16)
  hint.BackgroundTransparency = 0.35
  hint.BorderSizePixel = 0
  hint.AutoButtonColor = false
  hint.Font = Enum.Font.GothamMedium
  hint.TextSize = 15
  hint.TextColor3 = RGB(236, 240, 236)
  hint.Text = ""
  hint.Visible = false
  hint.Parent = hintGui
  corner(hint, 8)
  stroke(hint, RGB(120, 230, 150), 1, 0.4)
  local mine = nil   -- 能重连的那架（实体模型）
  local scanT = 0
  local function relink()
    if mine and mine.Parent and not G.drive then G.R.Act:FireServer("uavLink", mine:GetAttribute("EntId")) end
  end
  hint.Activated:Connect(relink)
  UIS.InputBegan:Connect(function(io, gp)
    if gp then return end
    if io.KeyCode == Enum.KeyCode.T and mine and not G.drive then relink() end
  end)
  local function stepHint(dt)
    scanT -= dt
    if scanT <= 0 then
      scanT = 0.5
      mine = nil
      local f = workspace:FindFirstChild("Ents")
      local uid = me.UserId
      if f and not G.drive then
        for _, em in ipairs(f:GetChildren()) do
          if em:GetAttribute("Op") == uid and em:GetAttribute("Driver") == 0 and not em:GetAttribute("Wreck") and em:GetAttribute("Kind") == "air" then
            mine = em
            break
          end
        end
      end
    end
    local alive = G.S and G.S.alive
    if mine and mine.Parent and alive and not G.drive then
      local name = T("veh." .. tostring(mine:GetAttribute("Model")))
      local endT = mine:GetAttribute("LoitEnd")
      if mine:GetAttribute("Loiter") and endT then
        local left = math.max(0, math.floor(endT - workspace:GetServerTimeNow()))
        hint.Text = T(mob and "uav.relinkTouchAir" or "uav.relinkAir", name, left)
      else
        hint.Text = T(mob and "uav.relinkTouch" or "uav.relink", name)
      end
      hint.Visible = true
    else
      hint.Visible = false
    end
  end

  function G.stepTablet(dt)
    stepHint(dt)
    if S.open then
      stepOpen(dt)
    elseif S.closeT then
      -- 收起：往下落
      S.closeT += dt
      local k = math.clamp(S.closeT / 0.28, 0, 1)
      root.Position = UDs(0, k * k)
      black.BackgroundTransparency = 1
      if k >= 1 then
        S.closeT = nil
        gui.Enabled = false
      end
    end
  end
end

return Tablet
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="109">
          <Properties>
            <string name="Name">TacPad</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——单兵战术平板（用户：增加一个单兵战术平板，可以召唤空投载具、空中打击，但必须要有次数限制）
--   平板是副武器（用户：不要按 B 召唤平板，平板做成物品；R 币 99 解锁）：部署时装备栏副武器选上，按它的数字键（手机：右边「平板」按钮）拿在手上
--     就打开、切回别的武器（Q）就关上：人端着平板（服务器 Air.lua 的 G.uavTablet，别人看得到）；画面中间一块加固平板——
--     左边一列支援：空投载具、空投补给、精确打击、机炮扫射、集束轰炸（Config.TacPad），每样这一局还剩几次（圆点）、冷却还有多久
--       （次数、冷却都是服务器 Tactical.lua 管的，随状态发来 G.S.tac）；1–5 选、或者点卡片；
--     右边是群岛地图（借 MapUI 那张图，以自己为中心放大；滚轮缩放、右键拖动），一圈呼叫范围；左键点目标，
--       扫射、轰炸画出顺着「自己 → 目标」方向的覆盖带；「确认呼叫」（Enter）发给服务器核对，过了平板自动收起，抬头看飞机飞过来；没过就在平板上写原因
--   飞机、落下来的货盘和炸弹是这里画的（Fx 的 tac 特效，所有人都看得到；伤害、生成车和补给箱是服务器的事）：
--     精确打击：战斗机高空飞过、放下一枚激光制导炸弹（目标上一个闪烁的激光照射点，呼叫的人那里一道照射光束——夜视里看得清）；
--     机炮扫射：攻击机俯冲下来，一串曳光弹扫到地上；集束轰炸：轰炸机沿方向飞过，炸弹一枚枚落下；
--     空投：运输直升机低空飞来，货盘挂伞落下（载具是三顶伞的重装平台），落地那一刻换成服务器生成的车 / 补给箱
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local RS = game:GetService("ReplicatedStorage")

local TacPad = {}

function TacPad.init(G)
  local TP = G.Config.TacPad
  if not TP then return end
  local AD = require(RS:WaitForChild("AirDefs"))
  local WM = require(RS:WaitForChild("WeaponModels"))
  local MapM = require(RS:WaitForChild("Map"))
  local AM = require(script.Parent:WaitForChild("AirModels"))
  local me = Players.LocalPlayer
  local RGB = Color3.fromRGB
  local UDs, UDo, UD = UDim2.fromScale, UDim2.fromOffset, UDim2.new
  local V2, V = Vector2.new, Vector3.new
  local CF = CFrame.new
  local UPV = V(0, 1, 0)
  local function T(k, ...) return G.T(k, ...) end
  local mob = UIS.TouchEnabled and not UIS.KeyboardEnabled
  local AL, AC, AR = Enum.TextXAlignment.Left, Enum.TextXAlignment.Center, Enum.TextXAlignment.Right
  local M_PER = 2.8   -- 1 米多少格（同 Hud.lua）
  local ORDER = TP.order

  -- 配色：深色、去饱和，选中的一样用琥珀色点一下（用户：精致、简洁，不要卡通）
  local TEXT, DIM, FAINT = RGB(226, 232, 228), RGB(140, 149, 145), RGB(82, 90, 88)
  local AMBER, RED, GOOD = RGB(255, 196, 92), RGB(255, 94, 78), RGB(128, 222, 156)
  local SHELL, RUBBER = RGB(46, 49, 44), RGB(23, 25, 23)
  local SCREEN, CARD, CARD_ON, OFF = RGB(8, 11, 12), RGB(15, 19, 20), RGB(27, 32, 33), RGB(30, 34, 34)

  -- 平板按设计尺寸（像素）摆，整块用 UIScale 缩到屏幕上（电脑 1120 × 700；手机横屏扁一些、卡片矮一些、不写说明）
  local DW, DH = 1120, 700
  local BL, BT, BR, BB = 36, 40, 36, 52   -- 外壳边：左、上、右、下
  local LW, CH, CG = 336, 74, 8           -- 左列宽、卡片高、卡片间距
  if mob then DW, DH, BL, BT, BR, BB, LW, CH, CG = 900, 428, 18, 14, 18, 14, 286, 46, 5 end
  local SW, SH = DW - BL - BR, DH - BT - BB
  local TOP = mob and 24 or 30            -- 屏幕顶上状态栏
  local VX, VY = LW, TOP + 12             -- 地图区
  local VW, VH = SW - LW - 12, SH - TOP - 24

  local function fr(parent, pos, size, col, tr)
    local f = Instance.new("Frame")
    f.Position, f.Size = pos, size
    f.BackgroundColor3 = col or RGB(0, 0, 0)
    f.BackgroundTransparency = tr or 0
    f.BorderSizePixel = 0
    f.Parent = parent
    return f
  end
  local function corner(f, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = (typeof(r) == "UDim") and r or UDim.new(0, r)
    c.Parent = f
    return c
  end
  local function stroke(f, col, th, tr)
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = col, th, tr or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
  end
  local function shade(f, a, b, rot)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new(Color3.new(a, a, a), Color3.new(b, b, b))
    g.Rotation = rot
    g.Parent = f
    return g
  end
  local function txt(parent, text, pos, size, ts, col, font, ax, anchor)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Position, l.Size = pos, size
    l.AnchorPoint = anchor or V2(0, 0)
    l.Text = text or ""
    l.TextSize = ts
    l.TextColor3 = col
    l.Font = font or Enum.Font.Gotham
    l.TextXAlignment = ax or AL
    l.Parent = parent
    return l
  end
  local function seg(parent, a, b, th, col, tr)   -- 两点之间一条线（设计像素）
    local d = b - a
    local f = fr(parent, UDo((a.X + b.X) / 2, (a.Y + b.Y) / 2), UDo(math.max(1, d.Magnitude), th), col, tr)
    f.AnchorPoint = V2(0.5, 0.5)
    f.Rotation = math.deg(math.atan2(d.Y, d.X))
    return f
  end

  ---------------------------------------------------------------- 外壳

  local gui = Instance.new("ScreenGui")
  gui.Name = "TacPad"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
  gui.DisplayOrder = 6   -- 盖在主界面、载具平显（5）上面；选阵营、主菜单（12、14）还在它上面
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")
  local dimBg = fr(gui, UDs(0, 0), UDs(1, 1), RGB(0, 0, 0), 1)   -- 四周压暗（拿出平板时淡入）
  local modal = Instance.new("TextButton")   -- 第一人称里把鼠标放出来点地图
  modal.Name = "Modal"
  modal.Modal = true
  modal.BackgroundTransparency = 1
  modal.Text = ""
  modal.Size = UDo(1, 1)
  modal.Parent = gui

  local dev = fr(gui, UD(0.5, 0, 0.5, 0), UDo(DW, DH), RGB(0, 0, 0), 1)
  dev.Name = "Device"
  dev.AnchorPoint = V2(0.5, 0.5)
  local scale = Instance.new("UIScale")
  scale.Parent = dev

  local shell = fr(dev, UDs(0, 0), UDs(1, 1), SHELL)
  corner(shell, mob and 18 or 30)
  shade(shell, 1.0, 0.72, 90)
  stroke(shell, RGB(14, 15, 14), 2)
  local sheen = fr(dev, UDo(40, 3), UD(1, -80, 0, 2), RGB(255, 255, 255), 0.9)   -- 上沿一道反光
  corner(sheen, 1)
  if not mob then
    -- 四个角的橡胶护角（屏幕玻璃压在上面，只露出外壳角上一圈 L 形）
    for _, c in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
      local b = fr(dev, UD(c[1], (c[1] == 0) and -6 or 6, c[2], (c[2] == 0) and -6 or 6), UDo(104, 104), RUBBER)
      b.AnchorPoint = V2(c[1], c[2])
      corner(b, 34)
      shade(b, 1.0, 0.7, 90)
      stroke(b, RGB(10, 11, 10), 1.5)
    end
    -- 两侧橡胶握条（一道道横纹）
    for _, x in ipairs({ 8, DW - 8 - 18 }) do
      local g = fr(dev, UDo(x, DH * 0.33), UDo(18, DH * 0.34), RUBBER)
      corner(g, 8)
      for i = 1, 13 do fr(g, UD(0.22, 0, i / 14, 0), UD(0.56, 0, 0, 2), RGB(40, 43, 40)) end
    end
  end
  -- 顶边：前置摄像头、两个指示灯
  local lens = fr(dev, UD(0.5, -6, 0, BT / 2 - 6), UDo(12, 12), RGB(5, 6, 8))
  corner(lens, 6)
  stroke(lens, RGB(72, 76, 72), 1.5)
  local leds = {}
  if not mob then
    for i, nm in ipairs({ "GPS", "LINK" }) do
      local x = BL + 70 + (i - 1) * 64
      local led = fr(dev, UDo(x, BT / 2 - 3), UDo(6, 6), GOOD)
      corner(led, 3)
      txt(dev, nm, UDo(x + 12, BT / 2 - 7), UDo(50, 14), 10, RGB(150, 156, 150), Enum.Font.GothamMedium)
      leds[nm] = led
    end
  end
  -- 底边：牌子、硬键（键帽上印键位）
  local brand = txt(dev, "", UDo(BL + 4, DH - BB / 2 - 8), UDo(360, 16), 11, RGB(128, 134, 126), Enum.Font.GothamBold)
  brand.Visible = not mob
  local capLabels = {}
  if not mob then
    local caps = { { "1–5", "tac.kSel" }, { "ENTER", "tac.kCall" }, { "Q", "tac.kClose" } }   -- Q 换回上一把武器 = 收起平板
    local x = DW - BR
    for i = #caps, 1, -1 do
      local c = caps[i]
      local w = 22 + #c[1] * 6
      x -= w
      local cap = fr(dev, UDo(x, DH - BB / 2 - 11), UDo(w, 22), RGB(28, 30, 28))
      corner(cap, 5)
      stroke(cap, RGB(78, 82, 76), 1)
      local l = txt(cap, c[1], UDs(0, 0), UDs(1, 1), 11, TEXT, Enum.Font.GothamBold, AC)
      l.TextYAlignment = Enum.TextYAlignment.Center
      local lab = txt(dev, "", UDo(x - 6, DH - BB / 2 - 7), UDo(70, 14), 11, RGB(130, 136, 128), Enum.Font.GothamMedium, AR, V2(1, 0))
      capLabels[#capLabels + 1] = { lab, c[2] }
      x -= 84
    end
  end

  -- 屏幕：黑玻璃边、显示区、一道细反光
  local glassF = fr(dev, UDo(BL - 7, BT - 7), UDo(SW + 14, SH + 14), RGB(4, 5, 6))
  corner(glassF, mob and 10 or 16)
  local scr = fr(dev, UDo(BL, BT), UDo(SW, SH), SCREEN)
  scr.Name = "Screen"
  corner(scr, mob and 6 or 9)
  scr.ClipsDescendants = true
  local edge = fr(dev, UDo(BL, BT), UDo(SW, SH), RGB(0, 0, 0), 1)
  corner(edge, mob and 6 or 9)
  stroke(edge, RGB(120, 130, 130), 1, 0.8)

  -- 状态栏
  local bar = fr(scr, UDs(0, 0), UD(1, 0, 0, TOP), RGB(0, 0, 0), 0.45)
  local title = txt(bar, "", UDo(14, 0), UD(0, 320, 1, 0), mob and 12 or 13, TEXT, Enum.Font.GothamBold)
  local coord = txt(bar, "", UDs(0.5, 0), UD(0, 300, 1, 0), mob and 11 or 12, DIM, Enum.Font.Code, AC, V2(0.5, 0))
  local clock = txt(bar, "", UD(1, -14, 0, 0), UD(0, 280, 1, 0), mob and 11 or 12, TEXT, Enum.Font.Code, AR, V2(1, 0))
  fr(scr, UDo(0, TOP), UD(1, 0, 0, 1), RGB(255, 255, 255), 0.92)
  local bat = math.random(72, 96)

  ---------------------------------------------------------------- 左列：支援卡片

  -- 卡片上的小图标（几条线、几个方块拼的，同一个颜色）
  local function icon(box, kind)
    local s = box.Size.X.Offset
    local o = fr(box, UDs(0, 0), UDs(1, 1), RGB(0, 0, 0), 1)
    local parts = {}
    local function add(f) parts[#parts + 1] = f return f end
    local k = s / 44
    if kind == "drop" or kind == "supply" then   -- 伞 + 吊着的箱子
      local dome = add(fr(o, UDo(10 * k, 7 * k), UDo(24 * k, 9 * k), TEXT))
      corner(dome, UDim.new(0.5, 0))
      add(seg(o, V2(12 * k, 13 * k), V2(19 * k, 27 * k), 1.5, TEXT))
      add(seg(o, V2(32 * k, 13 * k), V2(25 * k, 27 * k), 1.5, TEXT))
      local w = (kind == "drop") and 14 or 10
      add(fr(o, UDo(22 * k - w * k / 2, 27 * k), UDo(w * k, 9 * k), TEXT))
    elseif kind == "pgm" then   -- 准星：圈 + 四个刻 + 中心点
      local ring = fr(o, UDo(11 * k, 11 * k), UDo(22 * k, 22 * k), RGB(0, 0, 0), 1)
      corner(ring, UDim.new(0.5, 0))
      parts[#parts + 1] = stroke(ring, TEXT, 1.5)
      add(fr(o, UDo(21 * k, 5 * k), UDo(2, 8 * k), TEXT))
      add(fr(o, UDo(21 * k, 31 * k), UDo(2, 8 * k), TEXT))
      add(fr(o, UDo(5 * k, 21 * k), UDo(8 * k, 2), TEXT))
      add(fr(o, UDo(31 * k, 21 * k), UDo(8 * k, 2), TEXT))
      local dot = add(fr(o, UDo(20 * k, 20 * k), UDo(4 * k, 4 * k), TEXT))
      corner(dot, UDim.new(0.5, 0))
    elseif kind == "gunrun" then   -- 一串斜着的曳光
      for i = 0, 3 do
        local a = V2((8 + i * 7) * k, (12 + i * 6) * k)
        add(seg(o, a, a + V2(6 * k, 5 * k), 2, TEXT))
      end
      add(seg(o, V2(10 * k, 36 * k), V2(36 * k, 36 * k), 1, TEXT, 0.5))
    else   -- 集束：两行炸点
      for r = 0, 1 do
        for c = 0, 2 do
          local d = add(fr(o, UDo((9 + c * 10 + r * 5) * k, (14 + r * 11) * k), UDo(6 * k, 6 * k), TEXT))
          corner(d, UDim.new(0.5, 0))
        end
      end
    end
    return function(col)
      for _, p in ipairs(parts) do
        if p:IsA("UIStroke") then p.Color = col else p.BackgroundColor3 = col end
      end
    end
  end

  local sel = ORDER[1]
  local cards = {}
  local IB = mob and 32 or 44
  local NX = (mob and 8 or 12) + IB + 12
  for i, id in ipairs(ORDER) do
    local it = TP.items[id]
    local y = TOP + 12 + (i - 1) * (CH + CG)
    local b = Instance.new("TextButton")
    b.Name = "Card_" .. id
    b.AutoButtonColor = false
    b.Text = ""
    b.BackgroundColor3 = CARD
    b.BorderSizePixel = 0
    b.Position, b.Size = UDo(12, y), UDo(LW - 24, CH)
    b.Parent = scr
    corner(b, 6)
    local st = stroke(b, RGB(255, 255, 255), 1, 0.93)
    local acc = fr(b, UDo(0, 8), UD(0, 3, 1, -16), AMBER)
    corner(acc, 1)
    local ib = fr(b, UDo(mob and 8 or 12, (CH - IB) / 2), UDo(IB, IB), RGB(23, 28, 29))
    corner(ib, 5)
    local paint = icon(ib, (it.kind == "drop") and "drop" or it.kind)
    if not mob then txt(ib, tostring(i), UD(1, -3, 1, -1), UDo(12, 12), 9, FAINT, Enum.Font.GothamBold, AR, V2(1, 1)) end
    local name = txt(b, "", UDo(NX, mob and 5 or 10), UDo(LW - 24 - NX - 96, 18), mob and 13 or 15, TEXT, Enum.Font.GothamBold)
    local state = txt(b, "", UD(1, -12, 0, mob and 5 or 10), UDo(96, 18), mob and 10 or 11, DIM, Enum.Font.GothamMedium, AR, V2(1, 0))
    if mob then state.Position, state.AnchorPoint, state.TextXAlignment = UDo(NX, 24), V2(0, 0), AL end
    local desc
    if not mob then
      desc = txt(b, "", UDo(NX, 31), UDo(LW - 24 - NX - 50, 32), 11, DIM, Enum.Font.Gotham)
      desc.TextWrapped = true
      desc.TextYAlignment = Enum.TextYAlignment.Top
    end
    local pips = {}
    for k = 1, it.n do
      local p = fr(b, UD(1, -12 - (it.n - k) * 11, 1, mob and -19 or -14), UDo(7, 7), TEXT)
      p.AnchorPoint = V2(1, 1)
      corner(p, 4)
      pips[k] = p
    end
    local cdBar = fr(b, UD(0, 0, 1, -2), UD(0, 0, 0, 2), AMBER, 0.2)   -- 冷却进度（底边一道）
    b.Activated:Connect(function() sel = id end)
    cards[id] = { b = b, st = st, acc = acc, name = name, state = state, desc = desc, pips = pips, cd = cdBar, paint = paint }
  end

  -- 选中那一样的详情 + 呼叫按钮
  local DY = TOP + 12 + #ORDER * (CH + CG) + (mob and 0 or 4)
  local det = fr(scr, UDo(12, DY), UDo(LW - 24, SH - DY - 12), RGB(0, 0, 0), 1)
  local dName = txt(det, "", UDo(2, 0), UD(1, -4, 0, 22), 18, TEXT, Enum.Font.GothamBold)
  local dInfo = txt(det, "", UDo(2, 26), UD(1, -4, 0, 16), 12, DIM, Enum.Font.Gotham)
  local dTgt = txt(det, "", UDo(2, mob and 0 or 50), UD(1, -4, 0, 16), mob and 12 or 13, TEXT, Enum.Font.Code)
  local dWarn = txt(det, "", UDo(2, mob and 17 or 70), UD(1, -4, 0, 14), 11, RED, Enum.Font.GothamMedium)
  dName.Visible, dInfo.Visible = not mob, not mob
  local BTN_H = mob and 40 or 46
  local callBtn = Instance.new("TextButton")
  callBtn.Name = "Call"
  callBtn.AutoButtonColor = true
  callBtn.BorderSizePixel = 0
  callBtn.Position, callBtn.Size = UD(0, 0, 1, -BTN_H), UD(1, 0, 0, BTN_H)
  callBtn.Font = Enum.Font.GothamBold
  callBtn.TextSize = mob and 14 or 15
  callBtn.Parent = det
  corner(callBtn, 6)

  ---------------------------------------------------------------- 右边：地图

  local view = fr(scr, UDo(VX, VY), UDo(VW, VH), RGB(14, 24, 32))
  view.Name = "MapView"
  view.ClipsDescendants = true
  local holder = fr(view, UDs(0, 0), UDs(1, 1), RGB(0, 0, 0), 1)   -- 借来的地图挂在这里
  holder.ZIndex = 1
  local catcher = Instance.new("TextButton")   -- 接点击（盖在地图上面、标记下面）
  catcher.Name = "Catch"
  catcher.BackgroundTransparency = 1
  catcher.Text = ""
  catcher.AutoButtonColor = false
  catcher.Size = UDs(1, 1)
  catcher.ZIndex = 2
  catcher.Parent = view
  local over = fr(view, UDs(0, 0), UDs(1, 1), RGB(0, 0, 0), 1)
  over.ZIndex = 3
  local vEdge = fr(scr, UDo(VX, VY), UDo(VW, VH), RGB(0, 0, 0), 1)
  stroke(vEdge, RGB(255, 255, 255), 1, 0.88)

  -- 呼叫范围：一圈细线、圈里淡淡一层
  local ring = fr(over, UDs(0.5, 0.5), UDo(10, 10), RGB(255, 255, 255), 0.96)
  ring.AnchorPoint = V2(0.5, 0.5)
  corner(ring, UDim.new(0.5, 0))
  stroke(ring, TEXT, 1.5, 0.45)
  local ringLabel = txt(over, "", UDs(0.5, 0.5), UDo(160, 14), 11, DIM, Enum.Font.GothamMedium, AC, V2(0.5, 1))
  -- 自己 → 目标的连线、覆盖带、目标标记
  local path = fr(over, UDs(0.5, 0.5), UDo(10, 1.5), TEXT, 0.55)
  path.AnchorPoint = V2(0.5, 0.5)
  local strip = fr(over, UDs(0.5, 0.5), UDo(10, 10), AMBER, 0.8)
  strip.AnchorPoint = V2(0.5, 0.5)
  stroke(strip, AMBER, 1, 0.3)
  local blast = fr(over, UDs(0.5, 0.5), UDo(10, 10), AMBER, 0.82)
  blast.AnchorPoint = V2(0.5, 0.5)
  corner(blast, UDim.new(0.5, 0))
  local mark = fr(over, UDs(0.5, 0.5), UDo(26, 26), RGB(0, 0, 0), 1)
  mark.AnchorPoint = V2(0.5, 0.5)
  corner(mark, UDim.new(0.5, 0))
  local markS = stroke(mark, AMBER, 2)
  local ticks = {}
  for i, v in ipairs({ { 0, -1 }, { 0, 1 }, { -1, 0 }, { 1, 0 } }) do
    local t = fr(mark, UD(0.5, v[1] * 19 - ((v[1] ~= 0) and 4 or 1), 0.5, v[2] * 19 - ((v[2] ~= 0) and 4 or 1)), UDo((v[1] ~= 0) and 8 or 2, (v[2] ~= 0) and 8 or 2), AMBER)
    ticks[i] = t
  end
  local markL = txt(over, "", UDs(0.5, 0.5), UDo(220, 16), 12, AMBER, Enum.Font.Code, AL, V2(0, 0.5))
  markL.TextStrokeTransparency = 0.4
  -- 北、比例尺、操作提示、状态
  local north = txt(over, "N", UD(1, -14, 0, 10), UDo(20, 16), 13, TEXT, Enum.Font.GothamBold, AC, V2(1, 0))
  local nTick = fr(over, UD(1, -24, 0, 6), UDo(2, 5), TEXT)
  nTick.AnchorPoint = V2(0.5, 0)
  local _ = north
  local sbar = fr(over, UD(0, 14, 1, -18), UDo(80, 2), TEXT, 0.15)
  local sbarL = fr(sbar, UDo(0, -4), UDo(1.5, 6), TEXT)
  local sbarR = fr(sbar, UD(1, -1.5, 0, -4), UDo(1.5, 6), TEXT)
  local _ = sbarL, sbarR
  local sText = txt(over, "", UD(0, 14, 1, -36), UDo(120, 14), 11, TEXT, Enum.Font.Code)
  local hint = txt(over, "", UD(1, -14, 1, -12), UDo(360, 14), 11, DIM, Enum.Font.Gotham, AR, V2(1, 1))
  local pill = fr(over, UD(0.5, 0, 0, 12), UDo(360, 26), RGB(0, 0, 0), 0.25)
  pill.AnchorPoint = V2(0.5, 0)
  corner(pill, 4)
  local pillT = txt(pill, "", UDs(0, 0), UDs(1, 1), 13, TEXT, Enum.Font.GothamMedium, AC)
  pill.Visible = false
  -- 缩放按钮（右下）
  local zoomBtns = {}
  for i, s in ipairs({ "+", "−" }) do
    local b = Instance.new("TextButton")
    b.Name = "Zoom" .. i
    b.Text = s
    b.Font = Enum.Font.GothamBold
    b.TextSize = 18
    b.TextColor3 = TEXT
    b.BackgroundColor3 = RGB(0, 0, 0)
    b.BackgroundTransparency = 0.35
    b.BorderSizePixel = 0
    b.AutoButtonColor = true
    b.AnchorPoint = V2(1, 1)
    b.Position = UD(1, -12, 1, -34 - (2 - i) * 38)
    b.Size = UDo(32, 32)
    b.ZIndex = 4
    b.Parent = view
    corner(b, 4)
    stroke(b, RGB(255, 255, 255), 1, 0.85)
    zoomBtns[i] = b
  end

  ---------------------------------------------------------------- 状态（服务器给的次数、冷却）

  local seenS, cdAt, left = nil, {}, {}
  local function sync()
    local S = G.S
    if S == seenS then return end
    seenS = S
    local tac = S and S.tac
    if type(tac) ~= "table" then return end
    local t = os.clock()
    for id, v in pairs(tac) do
      if type(v) == "table" then
        left[id] = v.n
        cdAt[id] = t + (v.cd or 0)
      end
    end
  end
  local function state(id)
    sync()
    local it = TP.items[id]
    return math.max(0, left[id] or it.n), math.max(0, math.ceil((cdAt[id] or 0) - os.clock())), it
  end
  local function mmss(s) return string.format("%d:%02d", s // 60, s % 60) end

  local function myPos()
    local ch = me.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.Position
  end

  ---------------------------------------------------------------- 地图：放大、拖动、点目标

  local zoom, pan = 1, V2(0, 0)
  local tgt = nil        -- 选的目标（世界 x, z）
  local sending = nil    -- 发出去了、等服务器回话的时刻
  local pillUntil = 0
  local function kPx() return zoom * (VH * 0.86) / (2 * TP.range) end   -- 每格多少设计像素（放大 1 倍时呼叫范围占地图高的 86%）
  local function center()
    local p = myPos()
    return (p and V2(p.X, p.Z) or V2(0, 0)) + pan
  end
  local function at(x, z, c, k) return UD(0.5, (x - c.X) * k, 0.5, (z - c.Y) * k) end
  local function flash(text, col, sec)
    pillT.Text = text
    pillT.TextColor3 = col or TEXT
    pill.Size = UDo(math.min(VW - 40, 40 + utf8.len(text) * 13), 26)
    pill.Visible = true
    pillUntil = os.clock() + (sec or 3)
  end
  local function setTarget(w)
    local p = myPos()
    if not p then return end
    local d = w - V2(p.X, p.Z)
    if d.Magnitude > TP.range then   -- 点到圈外：收到圈边上
      w = V2(p.X, p.Z) + d.Unit * (TP.range - 1)
      flash(T("tac.far", math.floor(TP.range / M_PER)), AMBER)
    end
    tgt = w
  end
  G.tacPick = function(x, z) setTarget(V2(x, z)) end   -- 测试用：直接给目标
  local function screenToWorld(p)   -- p：InputObject.Position（同 AbsolutePosition 一个坐标系）
    local a, s = view.AbsolutePosition, view.AbsoluteSize
    if s.X < 2 then return nil end
    local k = kPx() * (s.X / VW)
    local c = center()
    return V2(c.X + (p.X - (a.X + s.X / 2)) / k, c.Y + (p.Y - (a.Y + s.Y / 2)) / k)
  end
  local dragging, dragFrom = false, nil
  catcher.InputBegan:Connect(function(io)
    local ut = io.UserInputType
    if ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch then
      local ok, w = pcall(screenToWorld, io.Position)
      if ok and w then setTarget(w) end
    elseif ut == Enum.UserInputType.MouseButton2 then
      dragging, dragFrom = true, io.Position
    end
  end)
  catcher.InputChanged:Connect(function(io)
    if io.UserInputType == Enum.UserInputType.MouseWheel then
      zoom = math.clamp(zoom * ((io.Position.Z > 0) and 1.25 or 0.8), 0.6, 6)
    end
  end)
  UIS.InputChanged:Connect(function(io)
    if dragging and io.UserInputType == Enum.UserInputType.MouseMovement and dragFrom then
      local ok, s = pcall(function() return view.AbsoluteSize.X / VW end)
      local k = kPx() * ((ok and s and s > 0) and s or 1)
      local d = io.Position - dragFrom
      dragFrom = io.Position
      pan -= V2(d.X, d.Y) / k
      if pan.Magnitude > TP.range * 1.3 then pan = pan.Unit * TP.range * 1.3 end
    end
  end)
  UIS.InputEnded:Connect(function(io)
    if io.UserInputType == Enum.UserInputType.MouseButton2 then dragging = false end
  end)
  zoomBtns[1].Activated:Connect(function() zoom = math.clamp(zoom * 1.4, 0.6, 6) end)
  zoomBtns[2].Activated:Connect(function() zoom = math.clamp(zoom / 1.4, 0.6, 6) end)

  local function stepMap()
    local root = G.mapRoot
    local k, c = kPx(), center()
    if root and root.Parent == holder and G.mapUV and G.mapSpan then
      local Z = G.mapSpan * k
      local u, v = G.mapUV(c.X, c.Y)
      root.AnchorPoint = V2(0, 0)
      root.Size = UDo(Z, Z)
      root.Position = UD(0.5, -u * Z, 0.5, -v * Z)
      root.BackgroundTransparency = 0
    end
    local p = myPos()
    if p then
      ring.Visible = true
      ring.Position = at(p.X, p.Z, c, k)
      ring.Size = UDo(TP.range * 2 * k, TP.range * 2 * k)
      ringLabel.Position = UD(0.5, (p.X - c.X) * k, 0.5, (p.Z - c.Y) * k - TP.range * k - 4)
      ringLabel.Text = T("tac.range", math.floor(TP.range / M_PER))
    else
      ring.Visible = false
    end
    local it = TP.items[sel]
    local has = tgt ~= nil and p ~= nil
    mark.Visible, markL.Visible, path.Visible = has, has, has
    strip.Visible = has and (it.kind == "gunrun" or it.kind == "cluster")
    blast.Visible = has and it.kind == "pgm"
    if has then
      local me2 = V2(p.X, p.Z)
      local d = tgt - me2
      local dir = (d.Magnitude > 1) and d.Unit or V2(0, -1)
      local rot = math.deg(math.atan2(dir.X, -dir.Y))   -- 相对北（地图上方）顺时针
      local mp = at(tgt.X, tgt.Y, c, k)
      mark.Position = mp
      local col = (os.clock() % 0.8 < 0.62) and AMBER or TEXT
      markS.Color = col
      for _, t in ipairs(ticks) do t.BackgroundColor3 = col end
      markL.Position = UD(0.5, (tgt.X - c.X) * k + 20, 0.5, (tgt.Y - c.Y) * k)
      local brg = (math.deg(math.atan2(dir.X, -dir.Y)) + 360) % 360
      markL.Text = T("tac.target", math.floor(d.Magnitude / M_PER + 0.5), string.format("%03d", math.floor(brg + 0.5) % 360))
      local a = V2((p.X - c.X) * k, (p.Z - c.Y) * k)
      local b = V2((tgt.X - c.X) * k, (tgt.Y - c.Y) * k)
      local mid = (a + b) / 2
      path.Position = UD(0.5, mid.X, 0.5, mid.Y)
      path.Size = UDo(math.max(1, (b - a).Magnitude), 1.5)
      path.Rotation = math.deg(math.atan2(b.Y - a.Y, b.X - a.X))
      if strip.Visible then
        local w = (it.kind == "cluster") and 70 or 22
        strip.Position = mp
        strip.Size = UDo(math.max(6, w * k), math.max(18, (it.len or 100) * k))
        strip.Rotation = rot
      end
      if blast.Visible then
        local r = math.max(8, 60 * k)
        blast.Position = mp
        blast.Size = UDo(r * 2, r * 2)
      end
    end
    -- 比例尺：取一个整数距离，长 60～150 像素
    local best = 100
    for _, m in ipairs({ 50, 100, 200, 250, 500, 1000, 2000, 5000 }) do
      if m * M_PER * k <= 150 then best = m end
    end
    sbar.Size = UDo(best * M_PER * k, 2)
    sText.Text = (best >= 1000) and string.format("%g km", best / 1000) or (best .. " m")
    if pill.Visible and os.clock() > pillUntil then pill.Visible = false end
  end

  ---------------------------------------------------------------- 文字、卡片、按钮

  local function canCall()
    local n, cd, it = state(sel)
    if n <= 0 then return false, T("tac.out"), FAINT end
    if cd > 0 then return false, T("tac.cdShort", mmss(cd)), AMBER end
    if not tgt then return false, T("tac.pick"), DIM end
    if sending and os.clock() - sending < 3 then return false, "· · ·", DIM end
    if (it.kind == "drop" or it.kind == "supply") and MapM.ground(tgt.X, tgt.Y) < 0.5 then return false, T("tac.water"), AMBER end
    return true, mob and T("tac.call") or T("tac.callNow"), RGB(10, 12, 12)
  end
  local function redraw()
    title.Text = T("tac.title")
    brand.Text = T("tac.brand")
    for _, c in ipairs(capLabels) do c[1].Text = T(c[2]) end
    hint.Text = mob and T("tac.zoomTouch") or T("tac.zoom")
    local p = myPos()
    if p then
      local R = MapM.R or 12288
      coord.Text = string.format("%s %05d · %05d", "GRID", math.floor((p.X + R) / M_PER), math.floor((R - p.Z) / M_PER))
    end
    local ct = Lighting.ClockTime
    clock.Text = string.format("%02d:%02d   %d%%", math.floor(ct) % 24, math.floor((ct % 1) * 60), bat)
    for _, id in ipairs(ORDER) do
      local c = cards[id]
      local n, cd, it = state(id)
      local on = id == sel
      c.b.BackgroundColor3 = on and CARD_ON or CARD
      c.st.Transparency = on and 0.75 or 0.93
      c.st.Color = on and AMBER or RGB(255, 255, 255)
      c.acc.Visible = on
      local usable = n > 0
      c.name.Text = T("tac." .. id)
      c.name.TextColor3 = usable and TEXT or FAINT
      if c.desc then c.desc.Text = T("tac." .. id .. ".desc") c.desc.TextColor3 = usable and DIM or FAINT end
      c.paint(usable and (on and AMBER or TEXT) or FAINT)
      for k, pp in ipairs(c.pips) do
        pp.BackgroundColor3 = (k <= n) and (on and AMBER or TEXT) or RGB(60, 66, 64)
        pp.BackgroundTransparency = (k <= n) and 0 or 0.2
      end
      if not usable then
        c.state.Text, c.state.TextColor3 = T("tac.out"), FAINT
        c.cd.Size = UD(0, 0, 0, 2)
      elseif cd > 0 then
        c.state.Text, c.state.TextColor3 = T("tac.cdShort", mmss(cd)), AMBER
        c.cd.Size = UD(1 - cd / math.max(1, it.cd), 0, 0, 2)
      else
        c.state.Text, c.state.TextColor3 = T("tac.ready"), GOOD
        c.cd.Size = UD(0, 0, 0, 2)
      end
    end
    local n, _, it = state(sel)
    dName.Text = T("tac." .. sel)
    dInfo.Text = T("tac.eta", it.flight) .. "   ·   " .. T("tac.limit", it.n, it.cd)
    if tgt and p then
      local d = (tgt - V2(p.X, p.Z)).Magnitude
      dTgt.Text = T("tac.target", math.floor(d / M_PER + 0.5), string.format("%03d", math.floor((math.deg(math.atan2(tgt.X - p.X, -(tgt.Y - p.Z))) + 360) % 360 + 0.5) % 360))
      dTgt.TextColor3 = AMBER
      dWarn.Text = (it.kind ~= "drop" and it.kind ~= "supply" and d < 110) and T("tac.danger") or ""
    else
      dTgt.Text = T("tac.pick")
      dTgt.TextColor3 = DIM
      dWarn.Text = ""
    end
    local ok, label, tcol = canCall()
    callBtn.Text = label
    callBtn.TextColor3 = tcol
    callBtn.BackgroundColor3 = ok and TEXT or OFF
    callBtn.AutoButtonColor = ok
    local _ = n
  end

  ---------------------------------------------------------------- 拿出来、收起、呼叫

  local open, closing, prevTool = false, nil, nil
  local function fit()
    local cam = workspace.CurrentCamera
    local ok, vp = pcall(function() return cam.ViewportSize end)
    if not ok or not vp or vp.X < 10 then vp = V2(1280, 720) end
    local s = math.min(vp.X * (mob and 0.985 or 0.92) / DW, vp.Y * (mob and 0.97 or 0.92) / DH)
    scale.Scale = math.clamp(s, 0.3, 1.6)
  end
  local function canUse()
    local ch = me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if G.drive or G.fly or G.sail or G.gunner then return false end   -- 只有步行能用（车上、飞机上、工事上不行）
    if G.S and (G.S.alive == false or G.S.phase == "end") then return false end
    if G.menuShown and G.menuShown() then return false end
    if G.tabletState and G.tabletState.open then return false end   -- 正在遥控无人机
    if G.scopeOn then return false end
    return true
  end
  -- 平板这件工具（装备栏副武器）：手上的、背包里的
  local function isPad(t) return t and t:IsA("Tool") and t:GetAttribute("Weapon") == "tablet" end
  local function heldPad()
    local ch = me.Character
    local t = ch and ch:FindFirstChildOfClass("Tool")
    return isPad(t) and t or nil
  end
  local function padTool()
    for _, holder in ipairs({ me.Character, me:FindFirstChildOfClass("Backpack") }) do
      if holder then
        for _, t in ipairs(holder:GetChildren()) do if isPad(t) then return t end end
      end
    end
    return nil
  end
  G.tacHasPad = function() return padTool() ~= nil end
  local function openPad(fromTool)
    if open or not canUse() then return end
    if not fromTool and not heldPad() then   -- 没拿在手上：拿出平板（工具拿到手上时再打开）；没带平板就提示去装备栏选
      local t = padTool()
      local hum = me.Character and me.Character:FindFirstChildOfClass("Humanoid")
      if t and hum then
        if G.equipTool then G.equipTool(t) else hum:EquipTool(t) end
      elseif G.toast then
        G.toast(T("tac.needPad"), "info")
      end
      return
    end
    open, closing, sending = true, nil, nil
    gui.Enabled = true
    fit()
    prevTool = nil   -- 手上拿的就是平板（收起时换回之前那把：Play.lua 的 G.equipLast）
    -- 借地图（收起时还给右下角的雷达）
    if G.mapMount and G.mapRoot then
      G.mapMount(holder, UDo(10, 10))
      if G.mapTheme then G.mapTheme("map") end
    end
    pan = V2(0, 0)
    pcall(function() G.R.Act:FireServer("tacPad", true) end)
    dev.Position = UD(0.5, 0, 1.5, 0)
    TweenService:Create(dev, TweenInfo.new(0.32, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UD(0.5, 0, 0.5, 0) }):Play()
    dimBg.BackgroundTransparency = 1
    TweenService:Create(dimBg, TweenInfo.new(0.3), { BackgroundTransparency = 0.5 }):Play()
    if G.playSound then G.playSound("quiet", nil, 1.3) end
    stepMap()
    redraw()
  end
  local function closePad(keepTool)
    if not open then return end
    open, sending, dragging = false, nil, false
    local root = G.mapRoot
    if root and root.Parent == holder and G.hudParts and G.hudParts.miniBox then G.mapMount(G.hudParts.miniBox, UDs(1, 1)) end
    pcall(function() G.R.Act:FireServer("tacPad", false) end)
    local ch = me.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    prevTool = nil
    -- 平板界面上收起的（收起按钮、呼叫成功）：平板放回去，换回拿平板之前那把；切枪切走的（keepTool）不用管
    if not keepTool and heldPad() and hum and hum.Health > 0 and not G.drive then
      hum:UnequipTools()
      if G.equipLast then G.equipLast() end
    end
    local mine = {}
    closing = mine
    TweenService:Create(dev, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UD(0.5, 0, 1.5, 0) }):Play()
    TweenService:Create(dimBg, TweenInfo.new(0.22), { BackgroundTransparency = 1 }):Play()
    task.delay(0.24, function() if closing == mine and not open then gui.Enabled = false end end)
  end
  G.tacOpen = function() return open end
  G.tacToggle = function() if open then closePad() else openPad() end end
  -- 平板拿到手上就打开，收起来（切枪、Q、死了）就关上
  local function watch(ch)
    ch.ChildAdded:Connect(function(c)
      if isPad(c) then task.defer(function() if c.Parent == ch then openPad(true) end end) end
    end)
    ch.ChildRemoved:Connect(function(c)
      if isPad(c) and open then closePad(true) end
    end)
  end
  if me.Character then watch(me.Character) end
  me.CharacterAdded:Connect(watch)
  G.tacSelect = function(id) if TP.items[id] then sel = id end end

  local function callNow()
    if not open then return end
    local ok, label = canCall()
    if not ok then
      if label and label ~= "· · ·" then flash(label, AMBER) end
      return
    end
    sending = os.clock()
    pcall(function() G.R.Act:FireServer("tacCall", sel, V(tgt.X, 0, tgt.Y)) end)
    redraw()
  end
  G.tacCallNow = callNow
  callBtn.Activated:Connect(callNow)

  -- 服务器回话：不行的原因写在平板上（主界面的提示被平板挡着）
  local prevMsg = G.onMsg
  G.onMsg = function(kind, key, ...)
    if open and kind == "bad" and type(key) == "string" and string.sub(key, 1, 4) == "tac." then
      sending = nil
      flash(T(key, ...), RED, 4)
      redraw()
    end
    return prevMsg(kind, key, ...)
  end

  -- 键：开着时 Enter 呼叫、1–5 选（这时 Play.lua 不拿数字键切枪）；不再有 B 键（用户：不要让 B 召唤平板）
  local KEYS = { [Enum.KeyCode.One] = 1, [Enum.KeyCode.Two] = 2, [Enum.KeyCode.Three] = 3, [Enum.KeyCode.Four] = 4, [Enum.KeyCode.Five] = 5 }
  UIS.InputBegan:Connect(function(io, gp)
    if gp then return end
    local k = io.KeyCode
    if open and k == Enum.KeyCode.Return then
      callNow()
    elseif open and KEYS[k] and ORDER[KEYS[k]] then
      sel = ORDER[KEYS[k]]
      redraw()
    end
  end)
  if mob then   -- 开启入口由步兵触控区排版。收起按钮留在平板上。
    function G.tacToggle() if open then closePad() else openPad() end end
    local closeBtn = Instance.new("TextButton")   -- 平板右上角的「收起」
    closeBtn.Name = "Close"
    closeBtn.Size = UDo(70, TOP - 4)
    closeBtn.Position = UD(1, -84, 0, 2)
    closeBtn.BackgroundTransparency = 1
    closeBtn.Font = Enum.Font.GothamBold
    closeBtn.TextSize = 12
    closeBtn.TextColor3 = AMBER
    closeBtn.Text = T("tac.closeTouch")
    closeBtn.Parent = bar
    closeBtn.Activated:Connect(function() closePad() end)
    clock.Position = UD(1, -92, 0, 0)
  end

  ---------------------------------------------------------------- 飞过来的飞机、落下的货盘和炸弹（所有人都看得到）

  local FXF = G.fxFolder or workspace
  local jobs = {}
  local function newPart(size, cf, col, mat, tr)
    local p = Instance.new("Part")
    p.Size, p.CFrame, p.Color = size, cf, col
    p.Material = mat or Enum.Material.SmoothPlastic
    p.Transparency = tr or 0
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = FXF
    return p
  end
  local function ground(x, z) return math.max(MapM.ground(x, z), 0) end
  local function lookCF(p, fwd, up)
    if fwd.Magnitude < 1e-3 then fwd = V(0, 0, -1) end
    return CFrame.lookAt(p, p + fwd, up or UPV)
  end

  -- 飞机：AirModels 拼的整架（跟部署界面、空中别人的飞机一个样子；挂架空着）
  local function plane(id, team)
    local d = AD.get(id)
    if not d then return nil end
    local load = {}
    for k = 1, #(d.st or {}) do load[k] = false end
    local ok, M = pcall(AM.build, d, team, load)
    if not ok or not M then return nil end
    M.model.Parent = FXF
    return { M = M, d = d, c = { thr = 96, gear = 0, flap = 0, pit = 0, rol = 0, yaw = 0, bay = 0, bayS = 0, can = 0, hook = 0, fold = 0, rpm = 100,
      door = 0, ramp = 0, ty = 0, gp = 0, spin1 = math.random() * 6, spin2 = math.random() * 6, spinT = 0, spinP = 0 } }
  end
  local function posePlane(P, cf, dt)
    local c, d = P.c, P.d
    if d.rotor then c.spin1 = (c.spin1 + d.rotor.rpm / 60 * math.pi * 2 * 0.3 * dt) % (math.pi * 2) end
    if d.rotor2 then c.spin2 = (c.spin2 + d.rotor2.rpm / 60 * math.pi * 2 * 0.3 * dt) % (math.pi * 2) end
    if d.tail then c.spinT = (c.spinT + 18 * dt) % (math.pi * 2) end
    if d.prop then c.spinP = (c.spinP + 30 * dt) % (math.pi * 2) end
    if d.fanEng then c.spinF = ((c.spinF or 0) + 45 * dt) % (math.pi * 2) end   -- A-10 的涡扇风扇
    pcall(AM.pose, P.M, cf, c, os.clock())
  end
  local function job(f, kill)
    table.insert(jobs, { f = f, kill = kill, t = 0 })
  end
  local function stepJobs(dt)
    for i = #jobs, 1, -1 do
      local j = jobs[i]
      j.t += dt
      local ok, keep = pcall(j.f, j.t, dt)
      if not ok or not keep then
        pcall(j.kill)
        table.remove(jobs, i)
      end
    end
  end

  -- 一枚炸弹从 a 落到 b（t0 → t1），水平先快后慢、竖直越落越快，弹头顺着速度
  local function bombDrop(wid, a, b, t0, t1)
    local aw = AD.W[wid]
    if not aw then return end
    local mdl = WM.make(FXF, aw, CF(a), true)
    for _, p in ipairs(mdl.parts) do p.Parent = nil end
    local cfs = table.create(#mdl.parts)
    local shown = false
    local function posAt(s)
      local h = a:Lerp(b, 1 - (1 - s) ^ 1.6)
      return V(h.X, a.Y + (b.Y - a.Y) * s ^ 1.7, h.Z)
    end
    job(function(t)
      if t < t0 then return true end
      if t >= t1 then return false end
      if not shown then
        shown = true
        for _, p in ipairs(mdl.parts) do p.Parent = FXF end
      end
      local s = (t - t0) / (t1 - t0)
      local p = posAt(s)
      local q = posAt(math.min(1, s + 0.02))
      local cf = lookCF(p, q - p)
      for k, o in ipairs(mdl.offs) do cfs[k] = cf * o end
      workspace:BulkMoveTo(mdl.parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
      return true
    end, function() for _, p in ipairs(mdl.parts) do p:Destroy() end end)
  end

  -- 降落伞（货盘用）：扁椭球伞衣 + 四根伞绳；k 张开程度 0～1
  local function chute(r)
    local canopy = newPart(V(r * 2, r * 0.8, r * 2), CF(), RGB(112, 112, 88), Enum.Material.Fabric)
    local mesh = Instance.new("SpecialMesh")
    mesh.MeshType = Enum.MeshType.Sphere
    mesh.Parent = canopy
    local vent = newPart(V(r * 0.5, r * 0.22, r * 0.5), CF(), RGB(78, 78, 62), Enum.Material.Fabric)
    local vm = Instance.new("SpecialMesh")
    vm.MeshType = Enum.MeshType.Sphere
    vm.Parent = vent
    local lines = {}
    for i = 1, 4 do lines[i] = newPart(V(0.12, 0.12, 1), CF(), RGB(52, 52, 46), Enum.Material.SmoothPlastic) end
    local C = { canopy = canopy, vent = vent, lines = lines, r = r, mesh = mesh, vm = vm }
    function C.place(top, low, k, sway)   -- top：伞衣中心，low：吊点（四角按 1 格外扩）
      k = math.clamp(k, 0.05, 1)
      local rr = r * k
      local ccf = CF(top) * CFrame.Angles(sway.X, 0, sway.Y)
      mesh.Scale = V(k, 0.4 + 0.6 * k, k)
      canopy.CFrame = ccf
      vent.CFrame = ccf * CF(0, r * 0.38 * (0.4 + 0.6 * k), 0)
      for i, l in ipairs(lines) do
        local ang = (i - 0.5) * math.pi / 2
        local rim = (ccf * CF(math.cos(ang) * rr * 0.92, -r * 0.1, math.sin(ang) * rr * 0.92)).Position
        local dl = low - rim
        l.Size = V(0.12, 0.12, math.max(0.2, dl.Magnitude))
        l.CFrame = CFrame.lookAt(rim + dl / 2, low)
      end
    end
    function C.kill()
      canopy:Destroy()
      vent:Destroy()
      for _, l in ipairs(lines) do l:Destroy() end
    end
    return C
  end

  -- 空投货盘：supply 帆布箱；vdrop 重装平台（车罩着篷布、三顶伞）
  local function cargo(kind)
    local parts, offs = {}, {}
    local function add(size, off, col, mat, tr)
      local p = newPart(size, CF(), col, mat, tr)
      table.insert(parts, p)
      table.insert(offs, off)
      return p
    end
    local lamp
    if kind == "drop" then
      add(V(13, 1.2, 22), CF(0, 0.6, 0), RGB(64, 58, 46), Enum.Material.WoodPlanks)   -- 平台
      add(V(11, 5.2, 19), CF(0, 3.8, 0), RGB(70, 76, 58), Enum.Material.Fabric)      -- 罩着篷布的车
      add(V(9, 2.4, 9), CF(0, 7.6, 2), RGB(64, 70, 54), Enum.Material.Fabric)
      for _, z in ipairs({ -6, 0, 6 }) do add(V(11.2, 0.3, 0.5), CF(0, 5.3, z), RGB(34, 36, 30), Enum.Material.Fabric) end
      lamp = add(V(0.6, 0.6, 0.6), CF(5.6, 1.6, 10.4), RGB(150, 255, 170), Enum.Material.Neon)
    else
      add(V(6.4, 0.5, 4.6), CF(0, 0.25, 0), RGB(64, 58, 46), Enum.Material.WoodPlanks)
      add(V(5.8, 3.4, 4.0), CF(0, 2.2, 0), RGB(78, 86, 60), Enum.Material.Fabric)
      add(V(0.3, 3.5, 4.1), CF(1.4, 2.2, 0), RGB(40, 42, 36), Enum.Material.Fabric)
      add(V(0.3, 3.5, 4.1), CF(-1.4, 2.2, 0), RGB(40, 42, 36), Enum.Material.Fabric)
      lamp = add(V(0.45, 0.45, 0.45), CF(0, 4.1, 0), RGB(150, 255, 170), Enum.Material.Neon)
    end
    local pl = Instance.new("PointLight")   -- 化学荧光棒：夜里好找
    pl.Color, pl.Range, pl.Brightness, pl.Shadows = RGB(140, 255, 160), 12, 0.8, false
    pl.Parent = lamp
    return { parts = parts, offs = offs, cfs = table.create(#parts), top = (kind == "drop") and 9 or 4.4, lamp = lamp }
  end

  local function fxTac(e)
    if typeof(e.p) ~= "Vector3" then return end
    local team = (e.team == "def") and "def" or "atk"
    local kind = e.kind
    local P0 = e.p
    local dir = (typeof(e.d) == "Vector3" and e.d.Magnitude > 0.1) and V(e.d.X, 0, e.d.Z).Unit or V(0, 0, -1)
    local side = dir:Cross(UPV)
    local T1 = tonumber(e.t) or 6
    local jets = TP.jets[team] or TP.jets.atk
    local jid = jets[(kind == "supply") and "drop" or kind] or jets.pgm
    -- 呼叫的是自己：平板上说一声，过一会儿收起来看
    if e.by == me.UserId and open then
      sending = nil
      flash(T("tac.sent", T1), GOOD, 3)
      task.delay(1.1, function() if open then closePad() end end)
    end
    local P = plane(jid, team)
    local gy0 = P0.Y

    if kind == "pgm" then
      -- 战斗机高空水平飞过；落弹前 3.4 秒在投弹点（目标前方 520 格）放弹
      local H, VP, FALL = 820, 480, 3.4
      local tr = math.max(0.4, T1 - FALL)
      local rel = P0 - dir * 520
      local function pos(t) return rel + dir * VP * (t - tr) + UPV * (gy0 + H - rel.Y) end
      if P then
        job(function(t, dt)
          if t > tr + 5 then return false end
          posePlane(P, lookCF(pos(t), dir), dt)
          return true
        end, function() P.M.model:Destroy() end)
      end
      bombDrop((team == "def") and "gbu12" or "lt2", pos(tr) - UPV * 3, P0, tr, T1)
      -- 激光照射点（一闪一闪）+ 呼叫的人那里一道照射光束（夜视里看得见）
      local spot = newPart(V(1.6, 1.6, 1.6), CF(P0 + UPV * 0.6), RGB(255, 80, 70), Enum.Material.Neon, 0.1)
      spot.Shape = Enum.PartType.Ball
      local beam = newPart(V(0.14, 0.14, 1), CF(), RGB(190, 255, 200), Enum.Material.Neon, 0.72)
      local caller = Players:GetPlayerByUserId(tonumber(e.by) or 0)
      job(function(t)
        if t > T1 + 0.1 then return false end
        spot.Transparency = ((t * 8) % 1 < 0.5) and 0.05 or 0.6
        local ch = caller and caller.Character
        local head = ch and ch:FindFirstChild("Head")
        if head then
          local a = head.Position + V(0, 0.2, 0)
          local d = P0 + UPV * 0.6 - a
          beam.Size = V(0.14, 0.14, d.Magnitude)
          beam.CFrame = CFrame.lookAt(a + d / 2, P0)
          beam.Transparency = 0.72
        else
          beam.Transparency = 1
        end
        return true
      end, function() spot:Destroy() beam:Destroy() end)

    elseif kind == "gunrun" then
      -- 攻击机俯冲：开火时在扫射带起点后 520 格、离地 260 格，一边打一边往下压，打完拉起
      local len, n = tonumber(e.len) or 170, tonumber(e.n) or 24
      local dur = (n - 1) * 0.045
      local VP = 300
      local s0 = P0 - dir * (len / 2)
      local function alt(t)
        local u = t - T1
        if u < 0 then return 260 + 150 * math.min(1, -u / 4) end
        if u < dur then return 260 - 70 * (u / dur) end
        return 190 + 90 * (u - dur) ^ 1.4
      end
      local function pos(t) return s0 - dir * 520 + dir * VP * (t - T1) + UPV * (gy0 + alt(t) - s0.Y) end
      local nose = nil
      if P then
        job(function(t, dt)
          if t > T1 + dur + 4 then return false end
          local p = pos(t)
          local q = pos(t + 0.05)
          posePlane(P, lookCF(p, q - p), dt)
          nose = p + (q - p).Unit * 24 - UPV * 2
          return true
        end, function() P.M.model:Destroy() end)
      end
      -- 曳光：每一发从机头打到扫射带上那一点（爆点是服务器给的）
      local fired = 0
      local gunKey = "tac" .. tostring(e.id or math.random(1, 1e6))
      local flashP = newPart(V(3, 3, 3), CF(0, -500, 0), RGB(255, 214, 140), Enum.Material.Neon, 1)
      flashP.Shape = Enum.PartType.Ball
      local fl = Instance.new("PointLight")
      fl.Color, fl.Range, fl.Brightness, fl.Shadows = RGB(255, 200, 130), 40, 0, false
      fl.Parent = flashP
      local tracers = {}
      job(function(t)
        if t > T1 + dur + 0.6 then return false end
        while fired < n and t >= T1 + fired * 0.045 do
          fired += 1
          local f = (fired - 1) / math.max(1, n - 1) - 0.5
          local hit = P0 + dir * f * len
          hit = V(hit.X, ground(hit.X, hit.Z), hit.Z)
          local from = nose or pos(t)
          local d = hit - from
          local tr = newPart(V(0.4, 0.4, d.Magnitude), CFrame.lookAt(from + d / 2, hit), RGB(255, 206, 128), Enum.Material.Neon, 0.1)
          table.insert(tracers, { p = tr, t = t })
          if G.gunLoop then   -- 航炮声：机头那里一个循环声（一圈一发，Fx.lua），打完 0.25 秒自己停
            local jd = G.AD and G.AD.get and G.AD.get(jid)
            G.gunLoop(gunKey, (jd and jd.gun) or "gau8", from, true)
          elseif fired % 3 == 1 and G.playSound then G.playSound("lmg", from, 0.55 + math.random() * 0.1) end
        end
        local firing = t >= T1 and t <= T1 + dur
        if firing and nose then
          flashP.CFrame = CF(nose)
          flashP.Transparency = (math.random() < 0.5) and 0.1 or 0.5
          fl.Brightness = 3
        else
          flashP.Transparency, fl.Brightness = 1, 0
        end
        for i = #tracers, 1, -1 do
          local x = tracers[i]
          local age = t - x.t
          if age > 0.08 then x.p:Destroy() table.remove(tracers, i) else x.p.Transparency = 0.1 + age * 10 end
        end
        return true
      end, function()
        flashP:Destroy()
        for _, x in ipairs(tracers) do x.p:Destroy() end
      end)

    elseif kind == "cluster" then
      -- 轰炸机高空沿方向飞过，炸弹按服务器的落点时刻一枚枚放下（落 4.2 秒）
      local len, n = tonumber(e.len) or 230, tonumber(e.n) or 12
      local H, VB, FALL = 1250, 330, 4.2
      local tMid = T1 + (n - 1) * 0.12 / 2 - FALL
      local cpt = P0 - dir * (VB * FALL * 0.6)
      local function pos(t) return cpt + dir * VB * (t - tMid) + UPV * (gy0 + H - cpt.Y) end
      if P then
        job(function(t, dt)
          if t > tMid + 7 then return false end
          posePlane(P, lookCF(pos(t), dir), dt)
          return true
        end, function() P.M.model:Destroy() end)
      end
      local wid = (team == "def") and "mk82" or "b250"
      for i = 1, n do
        local ti = T1 + (i - 1) * 0.12
        local f = (i - 1) / math.max(1, n - 1) - 0.5
        local q = P0 + dir * f * len + side * ((math.random() - 0.5) * 30)
        q = V(q.X, ground(q.X, q.Z), q.Z)
        local t0 = math.max(0, ti - FALL)
        bombDrop(wid, pos(t0) - UPV * 4, q, t0, ti)
      end

    else   -- drop / supply：运输直升机低空飞来，落地前 FALL 秒在目标上空放货盘
      local heavy = kind == "drop"
      local H, VH = heavy and 190 or 150, 120
      local FALL = heavy and 6.5 or 5
      local tr = math.max(0.5, T1 - FALL)
      local rel = P0 - dir * 30
      local function pos(t) return rel + dir * VH * (t - tr) + UPV * (gy0 + H - rel.Y) end
      if P then
        job(function(t, dt)
          if t > tr + 6 then return false end
          local p = pos(t)
          posePlane(P, lookCF(p, dir - UPV * 0.06), dt)
          return true
        end, function() P.M.model:Destroy() end)
      end
      local cg = cargo(heavy and "drop" or "supply")
      local chutes = {}
      for i = 1, heavy and 3 or 1 do chutes[i] = chute(heavy and 15 or 9) end
      for _, p in ipairs(cg.parts) do p.Parent = nil end
      local shown = false
      local OPEN = 0.9
      local yRel = gy0 + H - 8
      job(function(t)
        if t < tr then return true end
        if not shown then
          shown = true
          for _, p in ipairs(cg.parts) do p.Parent = FXF end
        end
        local u = t - tr
        local horiz = rel + dir * VH * math.min(u, 0.6) * 0.5
        local y
        local yOpen = yRel - 0.5 * 60 * OPEN * OPEN
        if u < OPEN then y = yRel - 0.5 * 60 * u * u
        else y = yOpen + (gy0 - yOpen) * math.clamp((u - OPEN) / math.max(0.5, FALL - OPEN), 0, 1) end
        local landed = u >= FALL
        local base = V(horiz.X, math.max(gy0, y), horiz.Z)
        local sway = V2(math.sin(t * 1.3) * 0.06, math.cos(t * 1.1) * 0.05)
        local cf = CF(base) * CFrame.Angles(0, math.atan2(-dir.X, -dir.Z), 0) * CFrame.Angles(sway.X * 0.5, 0, sway.Y * 0.5)
        for k, o in ipairs(cg.offs) do cg.cfs[k] = cf * o end
        workspace:BulkMoveTo(cg.parts, cg.cfs, Enum.BulkMoveMode.FireCFrameChanged)
        cg.lamp.Transparency = ((t * 2.2) % 1 < 0.15) and 0 or 0.7
        local k = math.clamp((u - 0.25) / OPEN, 0, 1)
        for i, c in ipairs(chutes) do
          local off = (#chutes == 1) and V() or ((cf.RightVector * ((i - 2) * 16)) + cf.LookVector * ((i == 2) and 4 or -3))
          local top = base + UPV * (cg.top + 5 + 26 * k) + off * k
          if landed then   -- 落地：伞衣塌下来、淡掉
            local f = math.clamp((u - FALL) / 0.8, 0, 1)
            top = base + UPV * (cg.top + (5 + 26) * (1 - f)) + off + dir * 10 * f
            c.canopy.Transparency, c.vent.Transparency = f, f
            for _, l in ipairs(c.lines) do l.Transparency = f end
          end
          c.place(top, base + UPV * cg.top, k, sway)
        end
        if landed then   -- 服务器那边的车 / 补给箱这时生成：货盘淡掉
          local f = math.clamp((u - FALL) / 0.35, 0, 1)
          for _, p in ipairs(cg.parts) do p.Transparency = math.max(p.Transparency, f) end
          if u > FALL + 0.9 then return false end
        end
        return true
      end, function()
        for _, p in ipairs(cg.parts) do p:Destroy() end
        for _, c in ipairs(chutes) do c.kill() end
      end)
    end
  end
  G.fxExtra = G.fxExtra or {}
  G.fxExtra.tac = fxTac
  -- 战场氛围（服务器原来的 Ambience.lua，用户嫌假炮火怪已删掉，现在没人发这个特效；留着以后用）：两架战机从目标上空低空掠过——前后错开、一左一右，四百多格 / 秒，开着加力；只是画的，打不着也打不到人
  G.fxExtra.flyby = function(e)
    if typeof(e.p) ~= "Vector3" then return end
    local team = (e.team == "def") and "def" or "atk"
    local jets = TP.jets[team] or TP.jets.atk
    local dir = (typeof(e.d) == "Vector3" and e.d.Magnitude > 0.1) and V(e.d.X, 0, e.d.Z).Unit or V(0, 0, -1)
    local side = dir:Cross(UPV)
    local H, VP, HALF = 230 + math.random() * 120, 430, 2200
    for i = 1, math.clamp(tonumber(e.n) or 2, 1, 3) do
      local P = plane((i == 1) and jets.pgm or (jets.gunrun or jets.pgm), team)
      if P then
        P.c.thr = 125   -- 加力
        local off = side * ((i % 2 == 0) and 70 or -40) - dir * (i - 1) * 110 + UPV * (i - 1) * 25
        local function pos(t) return e.p - dir * HALF + dir * VP * t + off + UPV * H end
        local roar = false
        job(function(t, dt)
          if t > HALF * 2 / VP then return false end
          posePlane(P, lookCF(pos(t), dir), dt)
          if not roar and t > HALF / VP - 1.2 then   -- 快到头顶：呼的一声
            roar = true
            if G.sfx then G.sfx({ { id = "rbxasset://sounds/action_falling.ogg", vol = 10, s = { 0.75, 0.85 }, reg = { 2, 5 }, eq = { 6, 8, -2 }, dist = 0.4, fade = 1.2 } }, pos(t), { rmax = 2400 }) end
          end
          return true
        end, function() P.M.model:Destroy() end)
      end
    end
  end

  ---------------------------------------------------------------- 每帧

  local acc = 0
  function G.stepTacPad(dt)
    stepJobs(dt)
    if not open then return end
    if not canUse() then closePad(true) return end
    -- 有人把枪拿出来了（别的模块装备）：再收起来
    local ch = me.Character
    local tool = ch and ch:FindFirstChildOfClass("Tool")
    if tool then
      prevTool = prevTool or tool
      local hum = ch:FindFirstChildOfClass("Humanoid")
      if hum then hum:UnequipTools() end
    end
    local root = G.mapRoot
    if root and root.Parent ~= holder and G.mapMount then G.mapMount(holder, UDo(10, 10)) end
    stepMap()
    acc += dt
    if acc > 0.1 then
      acc = 0
      redraw()
    end
    for _, led in pairs(leds) do led.BackgroundTransparency = (os.clock() % 1.6 < 1.3) and 0 or 0.6 end
  end
end

return TacPad
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="110">
          <Properties>
            <string name="Name">TankHud</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——坦克驾驶界面的补充（用户 11-19 给了一张手机坦克游戏的截图：「坦克驾驶操作界面改成这样」）
--   照那张图的布局和感觉做（不照抄它的图标、配色细节）：
--   · 敌人头顶：看得见的敌方车辆上面一个小牌子（红色的型号名、距离「183 米」），最多 6 个，离得远的、被挡住的不画
--   · 「被发现！」：附近有敌人看得见自己（视线没被挡），或者刚挨了打——左边一块琥珀色的牌子，一闪一闪
--   · 爆反、主动防御还剩多少（右下面板上面一行，青色）
--   · 开坦克时（电脑）右上的方形小地图挪到左下角、裁成圆的，外圈 0 / 90 / 180 / 270 的方位刻度；下车、换别的载具恢复
--   VehHud.lua 每帧调 G.tankHudExtra(st, 血量比例)；准星两边的弹药数、已就绪、测距在 VehHud 里
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local TankHud = {}

function TankHud.init(G)
  local V2, V3, UD2 = Vector2.new, Vector3.new, UDim2.new
  local RGB = Color3.fromRGB
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local CYAN, RED, AMBER, INK = RGB(110, 226, 240), RGB(255, 78, 64), RGB(255, 186, 72), RGB(6, 10, 14)
  local MONO, BOLD = Enum.Font.RobotoMono, Enum.Font.GothamBold
  local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled

  local gui = Instance.new("ScreenGui")
  gui.Name = "TankHud"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 4
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local function label(parent, text, size, pos, ts, color, font, anchor, align)
    local l = Instance.new("TextLabel")
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.BackgroundTransparency = 1
    l.Text, l.TextSize, l.TextColor3, l.Font = text or "", ts or 13, color or CYAN, font or BOLD
    l.TextXAlignment = align or Enum.TextXAlignment.Center
    l.TextStrokeTransparency = 0.55
    l.Parent = parent
    return l
  end

  -- 敌人头顶的牌子（对象池）
  local tags = {}
  for i = 1, 6 do
    local f = Instance.new("Frame")
    f.Size = UDim2.fromOffset(130, 34)
    f.AnchorPoint = V2(0.5, 1)
    f.BackgroundTransparency = 1
    f.Visible = false
    f.Parent = gui
    local nm = label(f, "", UD2(1, 0, 0, 16), UD2(0, 0, 0, 0), 13, RED, BOLD)
    local dist = label(f, "", UD2(1, 0, 0, 14), UD2(0, 0, 0, 17), 12, Color3.new(1, 1, 1), MONO)
    tags[i] = { f = f, nm = nm, dist = dist }
  end

  -- 「被发现！」
  local spot = Instance.new("Frame")
  spot.Size = UDim2.fromOffset(150, 30)
  spot.AnchorPoint = V2(0, 0.5)
  spot.Position = mobile and UD2(0, 16, 0.3, 0) or UD2(0, 36, 0.42, 0)
  spot.BackgroundColor3, spot.BackgroundTransparency = INK, 0.35
  spot.Visible = false
  spot.Parent = gui
  do
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 4)
    c.Parent = spot
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = AMBER, 1, 0.3
    s.Parent = spot
  end
  local eye = label(spot, "◉", UDim2.fromOffset(26, 30), UD2(0, 4, 0, 0), 16, AMBER, BOLD)
  local spotTxt = label(spot, "", UD2(1, -34, 1, 0), UD2(0, 30, 0, 0), 15, AMBER, BOLD, nil, Enum.TextXAlignment.Left)

  -- 爆反 / 主动防御还剩多少
  local armLine = label(gui, "", UDim2.fromOffset(300, 18), mobile and UD2(0.5, 0, 0, 72) or UD2(1, -24, 1, -150), 13, CYAN, MONO,
    mobile and V2(0.5, 0) or V2(1, 1), mobile and Enum.TextXAlignment.Center or Enum.TextXAlignment.Right)

  -- 圆形小地图的方位刻度（挪到左下时才显示）
  local MS = 210
  local ring = Instance.new("Frame")
  ring.Size = UDim2.fromOffset(MS + 30, MS + 30)
  ring.AnchorPoint = V2(0.5, 0.5)
  ring.Position = UD2(0, 26 + MS / 2, 1, -26 - MS / 2)
  ring.BackgroundTransparency = 1
  ring.Visible = false
  ring.Parent = gui
  do
    local edge = Instance.new("Frame")
    edge.Size = UDim2.fromOffset(MS + 6, MS + 6)
    edge.AnchorPoint, edge.Position = V2(0.5, 0.5), UD2(0.5, 0, 0.5, 0)
    edge.BackgroundTransparency = 1
    edge.Parent = ring
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0.5, 0)
    c.Parent = edge
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = CYAN, 1.5, 0.35
    s.Parent = edge
    for _, b in ipairs({ { 0, "0" }, { 90, "90" }, { 180, "180" }, { 270, "270" } }) do
      local a = math.rad(b[1])
      label(ring, b[2], UDim2.fromOffset(34, 14), UD2(0.5, math.sin(a) * (MS / 2 + 11), 0.5, -math.cos(a) * (MS / 2 + 11)), 11, CYAN, MONO, V2(0.5, 0.5))
    end
  end

  -- 小地图挪到左下变圆 / 恢复
  local docked, saved = false, nil
  local function dock(on)
    if mobile then on = false end
    if on == docked then return end
    local box = G.hudParts and G.hudParts.miniBox
    if not box then return end
    docked = on
    local corner = box:FindFirstChildOfClass("UICorner")
    local squad = G.hudParts.hud and G.hudParts.hud:FindFirstChild("Squad")   -- 左下的小队名单（Hud.lua）：挪到圆形小地图右边，不叠在一起
    -- 用户 11-19（MWT 截图）：圆形小地图里只有地图和亮点——方框式的网格、取景框、N / 航向 / 范围读数收起（外圈 0 / 90 / 180 / 270 是这里画的）；
    --   小队名单开坦克时收起（截图上没有）
    local function deco(show)
      for _, c in ipairs(box:GetChildren()) do
        if c.Name == "RadarDeco" and c:IsA("GuiObject") then c.Visible = show end
      end
    end
    if on then
      saved = { a = box.AnchorPoint, p = box.Position, s = box.Size, r = corner and corner.CornerRadius,
        rr = G.hudLayout and G.hudLayout.radarRight, sq = squad and squad.Visible }
      box.AnchorPoint, box.Position, box.Size = V2(0, 1), UD2(0, 26, 1, -26), UDim2.fromOffset(MS, MS)
      if corner then corner.CornerRadius = UDim.new(0.5, 0) end
      if G.hudLayout then G.hudLayout.radarRight = false end
      if squad then squad.Visible = false end
      deco(false)
    elseif saved then
      box.AnchorPoint, box.Position, box.Size = saved.a, saved.p, saved.s
      if corner and saved.r then corner.CornerRadius = saved.r end
      if G.hudLayout then G.hudLayout.radarRight = saved.rr end
      if squad and saved.sq ~= nil then squad.Visible = saved.sq end
      deco(true)
    end
    ring.Visible = on
  end
  G.tankHudDocked = function() return docked end   -- 测试用

  ---------------------------------------------------------------- 谁看得见
  local rp = RaycastParams.new()
  rp.FilterType = Enum.RaycastFilterType.Exclude
  local function entOf(inst)
    local ents = workspace:FindFirstChild("Ents")
    while inst and inst.Parent and inst.Parent ~= ents do inst = inst.Parent end
    return (inst and inst.Parent == ents) and inst or nil
  end
  local function excludeList(st)
    local list = {}
    local vf = workspace:FindFirstChild("EntView")   -- View.lua 画的车、船、小兵（看不见的命中盒在 Ents 里）
    if vf then table.insert(list, vf) end   -- 客户端画的车、船（看不见的命中盒在 Ents 里）
    if st and st.em then table.insert(list, st.em) end
    if me.Character then table.insert(list, me.Character) end
    return list
  end
  local function clear(from, to, target, st)
    rp.FilterDescendantsInstances = excludeList(st)
    local hit = workspace:Raycast(from, to - from, rp)
    if not hit then return true end
    local e = entOf(hit.Instance)
    return e ~= nil and e == target
  end

  local cands, lastScan, lastSpot, spotted, hurtT, lastK = {}, 0, 0, false, -9, nil
  local function enemy(em, side)
    if em:GetAttribute("Wreck") or (em:GetAttribute("Hp") or 1) <= 0 then return false end
    local tm = em:GetAttribute("Team")
    return tm ~= nil and tm ~= side
  end

  function G.tankHudExtra(st, hpK)
    gui.Enabled = true
    dock(true)
    local t = os.clock()
    local side = me:GetAttribute("Side")
    local myPos = st.root and st.root.Position or cam.CFrame.Position
    local ents = workspace:FindFirstChild("Ents")
    -- 敌人：每 0.25 秒重新挑一遍（距离、视线），每帧摆牌子
    if t - lastScan > 0.25 then
      lastScan = t
      cands = {}
      for _, em in ipairs(ents and ents:GetChildren() or {}) do
        local cat = em:GetAttribute("Cat")
        if (cat == "armor" or cat == "light" or cat == "ship") and enemy(em, side) then
          local r = em:FindFirstChild("Root")
          if r then
            local d = (r.Position - myPos).Magnitude
            if d < 1100 and clear(cam.CFrame.Position, r.Position, em, st) then table.insert(cands, { em = em, r = r, d = d }) end
          end
        end
      end
      table.sort(cands, function(a, b) return a.d < b.d end)
    end
    local n = 0
    for _, c in ipairs(cands) do
      if n >= #tags then break end
      if c.em.Parent and c.r.Parent then
        local top = c.r.Position + V3(0, c.r.Size.Y / 2 + 2.5, 0)
        local sp, on = cam:WorldToViewportPoint(top)
        if on then
          n += 1
          local tg = tags[n]
          tg.f.Visible = true
          tg.f.Position = UDim2.fromOffset(sp.X, sp.Y)
          local id = c.em:GetAttribute("Model")
          tg.nm.Text = id and T("veh." .. id) or ""
          tg.dist.Text = T("vh.m", math.floor((c.r.Position - myPos).Magnitude / 2.8 + 0.5))
        end
      end
    end
    for i = n + 1, #tags do tags[i].f.Visible = false end
    -- 被发现：附近（500 格以内）的敌方车辆、敌方玩家看得见自己；或者刚挨了打
    if lastK and hpK < lastK - 0.001 then hurtT = t end
    lastK = hpK
    if t - lastSpot > 0.4 then
      lastSpot = t
      spotted = false
      for _, c in ipairs(cands) do
        if c.d < 500 then spotted = true break end   -- 我看得见它，它也看得见我（同一条视线）
      end
      if not spotted then
        for _, pl in ipairs(Players:GetPlayers()) do
          if pl ~= me and pl:GetAttribute("Side") and pl:GetAttribute("Side") ~= side then
            local hrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
            if hrp and (hrp.Position - myPos).Magnitude < 500 then
              rp.FilterDescendantsInstances = excludeList(st)
              local hit = workspace:Raycast(myPos + V3(0, 4, 0), hrp.Position - myPos - V3(0, 4, 0), rp)
              if not hit or hit.Instance:IsDescendantOf(pl.Character) then spotted = true break end
            end
          end
        end
      end
    end
    local show = spotted or (t - hurtT < 3)
    spot.Visible = show
    if show then
      spotTxt.Text = T("vh.spotted")
      local blink = (t * 2.5) % 1 < 0.6
      eye.TextTransparency = blink and 0 or 0.6
    end
    -- 爆反、主动防御
    local em = st.em
    local parts = {}
    local nEra = em and em:GetAttribute("Era")
    if nEra then
      local dead = 0
      for _ in string.gmatch(em:GetAttribute("EraX") or "", "%d+") do dead += 1 end
      table.insert(parts, T("vh.era", nEra - dead, nEra))
    end
    local aps = em and em:GetAttribute("ApsMax")
    if aps then table.insert(parts, T("vh.aps", em:GetAttribute("Aps") or 0, aps)) end
    armLine.Text = table.concat(parts, "   ·   ")
  end

  -- 不在开坦克：收起来，小地图放回去
  G.frameConn("TankHud", function()
    if not G.myVeh then
      if gui.Enabled then
        gui.Enabled = false
        for _, tg in ipairs(tags) do tg.f.Visible = false end
      end
      if docked then dock(false) end
    end
  end)
end

return TankHud
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="111">
          <Properties>
            <string name="Name">Tint</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——导入的原模型贴图没出来时的底色
--   Studio「导入 3D」时网格和贴图分开上传：贴图没传上去、还在审核或者被拒，零件就是一块白的（导入器把零件颜色设成白色，等贴图盖上）；
--   没贴图的材质导入器也不一定把颜色带过来。这里按 ImportedTint（tools/models/tint.py：每块零件原贴图按面积取样的平均色 × 材质底色）补：
--   1. 复制出来的零件颜色一律先换成平均色——贴图正常时被贴图盖住看不出来，贴图出不来时露出来的是这个颜色而不是白色；
--   2. 带贴图的（SurfaceAppearance 的贴图出不来时不露零件颜色）：这块零件第一次用到时在后台对导入的原件查一次（ContentProvider:PreloadAsync），
--      贴图加载失败就去掉贴图、上平均色，已经摆出去的同名零件一起改；输出窗口列出贴图没出来的模型，好重新导入
--   用法：Tint.fix(复制出来的零件, 导入的原件) —— 要在调用方自己上色（换涂装、烧黑）之前调
local RS = game:GetService("ReplicatedStorage")

local Tint = {}

local DATA = nil
do
  local ok, r = pcall(function() return require(RS:WaitForChild("ImportedTint", 3)) end)
  if ok and type(r) == "table" then DATA = r end
end

local state = {}   -- [零件名] = "wait" / "ok" / "bad"
local live = {}    -- [零件名] = { [复制出来的零件] = true }（弱引用）：等检查结果的
local bad = {}     -- [模型键] = 贴图没出来的块数
local reportAt = nil

local function surf(p) return p:FindFirstChildOfClass("SurfaceAppearance") end
local function texId(p)
  local ok, t = pcall(function() return p.TextureID end)   -- 不是 MeshPart 的没有这个属性
  return ok and t or ""
end
local function textured(p) return surf(p) ~= nil or (texId(p) or "") ~= "" end

-- 去掉贴图、上平均色
local function paint(p, col)
  for _, sa in ipairs(p:GetChildren()) do
    if sa:IsA("SurfaceAppearance") then sa:Destroy() end
  end
  pcall(function() p.TextureID = "" end)
  p.Color = col
end

local function report()
  if reportAt then return end
  reportAt = os.clock()
  task.delay(4, function()
    reportAt = nil
    local list = {}
    for k, n in pairs(bad) do table.insert(list, k .. "（" .. n .. " 块）") end
    table.sort(list)
    if #list > 0 then
      warn("[全面大战场] 这些原模型的贴图没加载出来，先用原贴图的平均色代替：" .. table.concat(list, "、")
        .. "。多半是 Studio 导入时贴图没传上去或者还在审核：过几分钟再开一次；还不行就把这几个 GLB 删掉重新导入（一次少导几个），导入时看输出窗口有没有上传失败")
    end
  end)
end

local function check(name, src)
  state[name] = "wait"
  task.spawn(function()
    local failed = false
    local okM, meshId = pcall(function() return src.MeshId end)
    pcall(function()
      game:GetService("ContentProvider"):PreloadAsync({ src }, function(id, status)
        if status == Enum.AssetFetchStatus.Failure or status == Enum.AssetFetchStatus.TimedOut then
          if not (okM and id == meshId) then failed = true end   -- 网格没出来的零件本来就看不见，只管贴图
        end
      end)
    end)
    state[name] = failed and "bad" or "ok"
    local set = live[name]
    live[name] = nil
    if failed then
      local c = DATA[name]
      local col = Color3.fromRGB(c[1], c[2], c[3])
      for p in pairs(set or {}) do
        if p.Parent and textured(p) then paint(p, col) end   -- 调用方已经自己去掉贴图（换涂装、烧黑）的不动
      end
      local key = string.match(name, "^%a_([%w_]-)__") or string.match(name, "^(FPS_M4)") or name
      bad[key] = (bad[key] or 0) + 1
      report()
    end
  end)
end

function Tint.fix(p, src)
  if not DATA or not p then return p end
  local name = (src and src.Name) or p.Name
  local c = DATA[name]
  if not c then return p end
  local col = Color3.fromRGB(c[1], c[2], c[3])
  p.Color = col
  if not textured(p) then return p end   -- 没贴图：平均色就是它本来的颜色
  local st = state[name]
  if st == "bad" then
    paint(p, col)
  elseif st ~= "ok" then
    live[name] = live[name] or setmetatable({}, { __mode = "k" })
    live[name][p] = true
    if st == nil then check(name, src or p) end
  end
  return p
end

-- 有没有这块零件的平均色（调用方没贴图时自己上色用）
function Tint.color(name)
  local c = DATA and DATA[name]
  return c and Color3.fromRGB(c[1], c[2], c[3]) or nil
end

return Tint
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="112">
          <Properties>
            <string name="Name">UI</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——界面：部署（兵种卡片 + 地图上点出生点 + 出击）、战斗中的顶栏（时间、5 个据点）、血条、小地图、
--   击杀信息、屏幕中间的大字、底部提示、战况表（Tab）、结算画面、出错红条；所有文字按 G.lang 中英切换
local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("ReplicatedStorage")

local UI = {}

function UI.init(G)
  local Config, Lang = G.Config, G.Lang
  local Map = require(RS:WaitForChild("Map"))
  local player = Players.LocalPlayer
  local RGB = Color3.fromRGB
  local function T(key, ...) return Lang.t(G.lang, key, ...) end
  G.T = T

  pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)   -- 武器栏自己画（中英文）
  pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false) end)   -- 战况表自己画（Tab）

  local gui = Instance.new("ScreenGui")
  gui.Name = "Main"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
  gui.Parent = player:WaitForChild("PlayerGui")
  G.gui = gui

  ---------------------------------------------------------------- 小工具

  local PANEL, LINE, TEXT, MUTE = RGB(16, 20, 24), RGB(255, 255, 255), RGB(236, 240, 236), RGB(160, 170, 166)
  local function frame(parent, size, pos, color, alpha, anchor)
    local f = Instance.new("Frame")
    f.Size = size
    f.Position = pos or UDim2.new()
    f.AnchorPoint = anchor or Vector2.new()
    f.BackgroundColor3 = color or PANEL
    f.BackgroundTransparency = alpha or 0.25
    f.BorderSizePixel = 0
    f.Parent = parent
    return f
  end
  local function round(f, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 8)
    c.Parent = f
    return f
  end
  local function stroke(f, color, t, alpha)
    local s = Instance.new("UIStroke")
    s.Color = color or LINE
    s.Thickness = t or 1
    s.Transparency = alpha or 0.85
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
  end
  local function label(parent, text, size, pos, ts, color, font, anchor, align)
    local l = Instance.new("TextLabel")
    l.Size = size
    l.Position = pos or UDim2.new()
    l.AnchorPoint = anchor or Vector2.new()
    l.BackgroundTransparency = 1
    l.Text = text or ""
    l.TextSize = ts or 16
    l.TextColor3 = color or TEXT
    l.Font = font or Enum.Font.GothamMedium
    l.TextXAlignment = align or Enum.TextXAlignment.Center
    l.TextWrapped = true
    l.Parent = parent
    return l
  end
  local function button(parent, text, size, pos, color, anchor)
    local b = Instance.new("TextButton")
    b.Size = size
    b.Position = pos or UDim2.new()
    b.AnchorPoint = anchor or Vector2.new()
    b.BackgroundColor3 = color or RGB(40, 46, 52)
    b.BackgroundTransparency = 0.1
    b.BorderSizePixel = 0
    b.Text = text or ""
    b.TextColor3 = TEXT
    b.TextSize = 16
    b.Font = Enum.Font.GothamBold
    b.AutoButtonColor = true
    b.Parent = parent
    round(b, 8)
    return b
  end
  -- 载具、飞机、舰艇、工事的信息面板（Drive / Fly / Sail / Gunner）跟新界面一个样子：深色、直角、细线；血条、装填条换成细线，名字不加粗
  local function flatPanel(p, o)
    for _, c in ipairs(p:GetChildren()) do if c:IsA("UICorner") then c:Destroy() end end
    p.BackgroundColor3, p.BackgroundTransparency = RGB(6, 8, 10), 0.2
    stroke(p, LINE, 1, 0.88)
    for _, bg in ipairs({ o.hp or false, o.rel or false }) do
      if bg then
        bg.Size = UDim2.new(bg.Size.X.Scale, bg.Size.X.Offset, 0, (bg == o.hp) and 3 or 2)
        bg.BackgroundColor3, bg.BackgroundTransparency = LINE, 0.86
      end
    end
    if o.name then o.name.Font, o.name.TextColor3 = Enum.Font.GothamMedium, TEXT end
  end
  local function hpColor(k) return RGB(232, 84, 72):Lerp(TEXT, math.clamp(k, 0, 1)) end   -- 满血白、快没了红
  G.ui = { frame = frame, round = round, stroke = stroke, label = label, button = button, flatPanel = flatPanel, hpColor = hpColor }

  local function teamColor(t) return Config.Teams[t or "atk"].color end
  local function fmtTime(s)
    s = math.max(0, math.floor(s or 0))
    return string.format("%d:%02d", s // 60, s % 60)
  end

  ---------------------------------------------------------------- 出错红条、开服进度

  local errBar = label(gui, "", UDim2.new(1, -40, 0, 0), UDim2.new(0.5, 0, 0, 6), 14, RGB(255, 220, 220), Enum.Font.GothamMedium, Vector2.new(0.5, 0))
  errBar.AutomaticSize = Enum.AutomaticSize.Y
  errBar.BackgroundColor3 = RGB(150, 30, 30)
  errBar.BackgroundTransparency = 0.15
  errBar.Visible = false
  errBar.ZIndex = 50
  local errs = {}
  function G.showError(msg)
    table.insert(errs, 1, tostring(msg))
    while #errs > 3 do table.remove(errs) end
    errBar.Text = table.concat(errs, "\n")
    errBar.Visible = true
  end

  local loading = frame(gui, UDim2.fromScale(1, 1), nil, RGB(10, 14, 18), 0)
  loading.ZIndex = 40
  local loadText = label(loading, "", UDim2.new(1, 0, 0, 40), UDim2.fromScale(0, 0.5), 22, TEXT, Enum.Font.GothamBold)
  loadText.ZIndex = 41

  ---------------------------------------------------------------- 部署界面
  -- 照用户给的参考图：不选兵种，进来默认就是一个士兵；底下一排装备格改枪械配置（点一格，上面弹出能换的），右下白色「选择生成点」→ 地图上选点、出击。
  --   两页：kit 装备（左上标题、说明、数据条，右边转着的大图，底下 4 格）· spawn 生成点（左边出生点列表，右边地图）
  --   要比参考图精致、简洁（用户：现在这个太卡通）：黑底半透明、细线、直角、小字，只有主按钮是白底黑字
  local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled   -- G.mobile 要到 Play.lua 才有：这里自己判断
  local M0 = mobile and 18 or 48   -- 左右边距
  local WHITE, DIM, FAINT = Color3.new(1, 1, 1), RGB(150, 156, 160), RGB(96, 102, 106)
  local deploy = frame(gui, UDim2.fromScale(1, 1), nil, RGB(4, 6, 8), 0.08)
  deploy.Name = "Deploy"
  deploy.Visible = false
  deploy.ZIndex = 10
  do   -- 保留远景，限制夜视和照明弹在部署页背后的亮斑
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.13), NumberSequenceKeypoint.new(1, 0.24) })
    g.Rotation = -20
    g.Parent = deploy
  end
  local function hair(parent, size, pos, alpha, anchor)   -- 一像素的细线
    return frame(parent, size, pos, WHITE, alpha or 0.86, anchor)
  end
  local function txt(parent, s, size, pos, ts, color, font, anchor, align)
    local l = label(parent, s, size, pos, ts, color, font, anchor, align)
    l.TextWrapped = false
    l.TextTruncate = Enum.TextTruncate.AtEnd
    return l
  end
  -- 主按钮：白底黑字（字写在按钮自己身上），右边一个小键位
  local function mainButton(parent, size, pos, anchor)
    local b = Instance.new("TextButton")
    b.Size, b.Position, b.AnchorPoint = size, pos, anchor or Vector2.new()
    b.BackgroundColor3 = WHITE
    b.BorderSizePixel = 0
    b.AutoButtonColor = true
    b.Text = ""
    b.TextSize = mobile and 16 or 19
    b.TextColor3 = RGB(10, 10, 12)
    b.Font = Enum.Font.GothamBold
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.Parent = parent
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft = UDim.new(0, 22)
    pad.Parent = b
    local k = txt(b, "", UDim2.fromOffset(60, 20), UDim2.new(1, -18, 0.5, 0), 11, RGB(120, 120, 124), Enum.Font.GothamMedium, Vector2.new(1, 0.5), Enum.TextXAlignment.Right)
    return b, b, k
  end
  -- 只有字的按钮（页签、换阵营、语言）
  local function link(parent, s, size, pos, ts, anchor, align)
    local b = Instance.new("TextButton")
    b.Size, b.Position, b.AnchorPoint = size, pos, anchor or Vector2.new()
    b.BackgroundTransparency = 1
    b.Text = s
    b.TextSize = ts or 13
    b.TextColor3 = DIM
    b.Font = Enum.Font.GothamMedium
    b.TextXAlignment = align or Enum.TextXAlignment.Left
    b.AutoButtonColor = false
    b.Parent = parent
    return b
  end

  local sel = { role = nil, spawn = nil, page = nil, pageUser = nil, slot = nil }
  G.deploySel = sel
  -- 装备栏：上次选的（这一局里记着）；开局默认 M4 + 急救包 + 手雷
  sel.kit = table.clone(Config.LoadoutDefault or { primary = "m4" })
  local SLOTS = Config.Loadout or { { id = "primary", opts = { "m4" } } }
  -- R 币解锁（Config.Passes）：服务器把有没有写在玩家属性 Pass_<名字> 上；通行证编号还是 0 的谁都能用
  local function passOk(name)
    local c = Config.Passes and Config.Passes[name]
    if not c or (c.id or 0) == 0 then return true end
    return player:GetAttribute("Pass_" .. name) == true
  end
  G.passOk = passOk
  G.passFor = function(item) return Config.PassFor and Config.PassFor[item] end   -- 物品 / 机型 → 通行证名（不用的是 nil）
  G.buyPass = function(name) pcall(function() G.R.Act:FireServer("buyPass", name) end) end
  for name in pairs(Config.Passes or {}) do
    pcall(function() player:GetAttributeChangedSignal("Pass_" .. name):Connect(function() if G.refreshDeploy then G.refreshDeploy() end end) end)
  end

  -- 顶上一行：页签（装备 / 生成点），右边换阵营、语言
  local topY = mobile and 74 or 96
  local tabs = {}
  for i, pg in ipairs({ "kit", "spawn" }) do
    local b = link(deploy, "", UDim2.fromOffset(mobile and 70 or 92, 26), UDim2.fromOffset(M0 + (i - 1) * (mobile and 80 or 104), topY), mobile and 14 or 16)
    b.Font = Enum.Font.GothamBold
    local u = hair(b, UDim2.new(0, 22, 0, 2), UDim2.new(0, 0, 1, 2), 0)
    tabs[pg] = { b = b, u = u }
  end
  local langBtn = link(deploy, "", UDim2.fromOffset(110, 26), UDim2.new(1, -M0, 0, topY), 12, Vector2.new(1, 0), Enum.TextXAlignment.Right)
  local sideBtn = link(deploy, "", UDim2.fromOffset(110, 26), UDim2.new(1, -M0 - 118, 0, topY), 12, Vector2.new(1, 0), Enum.TextXAlignment.Right)
  sideBtn.Activated:Connect(function() if G.showFaction then G.showFaction() end end)
  local menuBtn = link(deploy, "", UDim2.fromOffset(80, 26), UDim2.new(1, -M0 - 236, 0, topY), 12, Vector2.new(1, 0), Enum.TextXAlignment.Right)
  menuBtn.Activated:Connect(function() if G.showMenu then G.showMenu() end end)
  hair(deploy, UDim2.new(1, -M0 * 2, 0, 1), UDim2.fromOffset(M0, topY + 34), 0.9)

  local kitPage = frame(deploy, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)
  local spawnPage = frame(deploy, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)

  ------------------------------------ 装备页
  local infoY = topY + (mobile and 40 or 66)
  local facDot = frame(kitPage, UDim2.fromOffset(6, 6), UDim2.fromOffset(M0, infoY + 5), WHITE, 0)
  local facLine = txt(kitPage, "", UDim2.fromOffset(360, 16), UDim2.fromOffset(M0 + 14, infoY), 12, DIM, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local bigName = txt(kitPage, "", UDim2.fromOffset(mobile and 360 or 520, mobile and 34 or 50), UDim2.fromOffset(M0 - 2, infoY + 20), mobile and 28 or 42, WHITE, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  local bigDesc = txt(kitPage, "", UDim2.fromOffset(mobile and 360 or 460, 18), UDim2.fromOffset(M0, infoY + (mobile and 56 or 76)), 13, DIM, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local stats = {}
  for k = 1, 4 do
    local y = infoY + (mobile and 84 or 112) + (k - 1) * 24
    local a = txt(kitPage, "", UDim2.fromOffset(80, 16), UDim2.fromOffset(M0, y), 11, DIM, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
    local bg = hair(kitPage, UDim2.fromOffset(180, 2), UDim2.fromOffset(M0 + 86, y + 7), 0.86)
    local fill = frame(bg, UDim2.fromScale(0.5, 1), nil, WHITE, 0.05)
    local v = txt(kitPage, "", UDim2.fromOffset(84, 16), UDim2.fromOffset(M0 + 274, y), 11, WHITE, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
    stats[k] = { a = a, bg = bg, fill = fill, v = v }
    a.Visible, bg.Visible, v.Visible = not mobile, not mobile, not mobile
  end
  -- 右边的大图（慢慢左右转）
  local big = Instance.new("ViewportFrame")
  big.Name = "GearBig"
  big.BackgroundTransparency = 1
  big.Size = mobile and UDim2.new(0.5, 0, 0.42, 0) or UDim2.new(0.56, 0, 0.5, 0)
  big.Position = mobile and UDim2.new(0.97, 0, 0.16, 0) or UDim2.new(0.97, 0, 0.17, 0)
  big.AnchorPoint = Vector2.new(1, 0)
  big.Ambient = RGB(150, 152, 158)
  big.LightColor = RGB(255, 250, 242)
  big.LightDirection = Vector3.new(-0.35, -1, -0.55)
  big.Parent = kitPage
  -- 底下的装备格
  local SW, SH, GAP = mobile and 128 or 206, mobile and 80 or 124, mobile and 6 or 10
  local slotY = mobile and -14 or -40
  local cards = {}
  local picker = frame(kitPage, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)
  picker.Visible = false
  local pickHead = txt(picker, "", UDim2.fromOffset(300, 16), UDim2.new(0, M0, 1, slotY - SH - 14 - (mobile and 70 or 104) - 22), 12, DIM, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  local pickCards = {}
  local function newCard(parent, w, h)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(w, h)
    b.BackgroundColor3 = RGB(12, 14, 16)
    b.BackgroundTransparency = 0.35
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Text = ""
    b.Parent = parent
    local st = Instance.new("UIStroke")
    st.Color = WHITE
    st.Thickness = 1
    st.Transparency = 0.88
    st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    st.Parent = b
    local vp = Instance.new("ViewportFrame")
    vp.BackgroundTransparency = 1
    vp.Size = UDim2.new(1, -24, 1, -(mobile and 34 or 44))
    vp.Position = UDim2.fromOffset(12, mobile and 10 or 16)
    vp.Ambient = RGB(150, 152, 158)
    vp.LightColor = RGB(255, 250, 242)
    vp.LightDirection = Vector3.new(-0.35, -1, -0.55)
    vp.Parent = b
    local idx = txt(b, "", UDim2.fromOffset(40, 14), UDim2.fromOffset(10, 7), 10, FAINT, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
    local cat = txt(b, "", UDim2.fromOffset(w - 50, 14), UDim2.new(1, -10, 0, 7), 10, FAINT, Enum.Font.GothamMedium, Vector2.new(1, 0), Enum.TextXAlignment.Right)
    local nm = txt(b, "", UDim2.new(1, -60, 0, 16), UDim2.new(0, 10, 1, -(mobile and 20 or 24)), mobile and 11 or 13, WHITE, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
    local cnt = txt(b, "", UDim2.fromOffset(50, 18), UDim2.new(1, -10, 1, -(mobile and 21 or 26)), mobile and 13 or 16, WHITE, Enum.Font.GothamBold, Vector2.new(1, 0), Enum.TextXAlignment.Right)
    local bar = frame(b, UDim2.new(1, 0, 0, 2), nil, WHITE, 1)   -- 选中的那格顶上一道白线
    return { b = b, st = st, vp = vp, idx = idx, cat = cat, nm = nm, cnt = cnt, bar = bar, item = nil, wait = false }
  end
  for i, slot in ipairs(SLOTS) do
    local c = newCard(kitPage, SW, SH)
    c.b.AnchorPoint = Vector2.new(0, 1)
    c.b.Position = UDim2.new(0, M0 + (i - 1) * (SW + GAP), 1, slotY)
    c.slot = slot
    cards[i] = c
  end
  -- 主按钮：选择生成点
  local CW, CH = mobile and 200 or 270, mobile and 48 or 62
  local goSpawn, goSpawnT, goSpawnK = mainButton(kitPage, UDim2.fromOffset(CW, CH), UDim2.new(1, -M0, 1, slotY), Vector2.new(1, 1))
  local phaseText = txt(deploy, "", UDim2.fromOffset(360, 16), UDim2.new(1, -M0, 1, slotY - CH - 12), 12, DIM, Enum.Font.GothamMedium, Vector2.new(1, 1), Enum.TextXAlignment.Right)

  -- 数量（消耗品：弹匣 + 备弹）
  local function countOf(id)
    local w = Config.Weapons[id]
    if not w or w.kind == "gun" or w.kind == "heal" or w.kind == "repair" or w.kind == "breach" or w.kind == "spot" then return nil end
    return (w.mag or 1) + (w.reserve or 0)
  end
  -- 数据条：枪看伤害 / 射速 / 射程 / 精度；炸的看伤害 / 杀伤半径 / 射程 / 弹药；工具不显示
  local function statRows(id)
    local w = Config.Weapons[id]
    if not w then return {} end
    local m = function(studs) return math.floor((studs or 0) / 2.8 + 0.5) end
    if w.kind == "gun" then
      return {
        { T("deploy.stat.dmg"), math.clamp(w.dmg / 100, 0, 1), tostring(w.dmg) },
        { T("deploy.stat.rate"), math.clamp((60 / w.rate) / 800, 0, 1), T("deploy.rpm", math.floor(60 / w.rate + 0.5)) },
        { T("deploy.stat.range"), math.clamp(m(w.range) / 550, 0, 1), T("deploy.m", m(w.range)) },
        { T("deploy.stat.acc"), math.clamp(1 - (w.spread or 0) * (w.adsK or 1) / 0.8, 0.05, 1), string.format("±%.2f°", (w.spread or 0) * (w.adsK or 1)) },   -- 开镜的精度（spread 是腰射）
      }
    elseif w.dmg then
      local rows = {
        { T("deploy.stat.dmg"), math.clamp(w.dmg / 260, 0, 1), tostring(w.dmg) },
        { T("deploy.stat.blast"), math.clamp((w.splash or 0) / 20, 0, 1), T("deploy.m", m(w.splash)) },
      }
      if w.range or w.maxR then table.insert(rows, { T("deploy.stat.range"), math.clamp(m(w.range or w.maxR) / 500, 0, 1), T("deploy.m", m(w.range or w.maxR)) }) end
      local n = countOf(id)
      if n then table.insert(rows, { T("deploy.stat.ammo"), math.clamp(n / 12, 0, 1), "×" .. n }) end
      return rows
    end
    return {}
  end

  local focus = 1   -- 大图、标题看的是哪一格
  local bigItem, bigWait = nil, false
  local function itemName(id) return id and T("weapon." .. id) or T("deploy.none") end
  local function setModel(vp, id, team)
    if not G.gearModel or not G.viewFit then return id ~= nil end   -- GearView 还没起来：等一会儿再画
    if not id then
      G.viewFit(vp, nil)
      return false
    end
    local m, wait, real = G.gearModel(id, team)
    if m and not real then   -- 零件拼的方块不放（粗糙）：等真模型
      m:Destroy()
      m = nil
    end
    G.viewFit(vp, m, 1.12)
    return wait
  end

  ------------------------------------ 生成点页
  local listW = mobile and 230 or 340
  local listY = topY + (mobile and 40 or 66)
  local listHead = txt(spawnPage, "", UDim2.fromOffset(listW, 16), UDim2.fromOffset(M0, listY), 12, DIM, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  local list = Instance.new("ScrollingFrame")
  list.Size = UDim2.new(0, listW, 1, -(listY + 24) - (mobile and 80 or 150))
  list.Position = UDim2.fromOffset(M0, listY + 24)
  list.BackgroundTransparency = 1
  list.BorderSizePixel = 0
  list.ScrollBarThickness = 2
  list.ScrollBarImageColor3 = WHITE
  list.CanvasSize = UDim2.new()
  list.AutomaticCanvasSize = Enum.AutomaticSize.Y
  list.Parent = spawnPage
  local listLayout = Instance.new("UIListLayout")
  listLayout.Padding = UDim.new(0, 4)
  listLayout.SortOrder = Enum.SortOrder.LayoutOrder
  listLayout.Parent = list
  -- 地图：右边一个正方形
  local mapBox = frame(spawnPage, mobile and UDim2.new(1, -(M0 * 2 + listW + 16), 1, -(listY + 80)) or UDim2.new(1, -(M0 * 2 + listW + 40), 1, -(listY + 150)),
    UDim2.new(1, -M0, 0, listY), RGB(0, 0, 0), 1, Vector2.new(1, 0))
  local mapHolder = frame(mapBox, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0), RGB(0, 0, 0), 1, Vector2.new(0.5, 0))
  local aspect = Instance.new("UIAspectRatioConstraint")
  aspect.AspectRatio = 1
  aspect.Parent = mapHolder
  local spawnLayer = nil
  local spawnBtns = {}
  -- 装备一行 + 改装备
  local kitLine = txt(spawnPage, "", UDim2.fromOffset(mobile and 300 or 520, 16), UDim2.new(0, M0, 1, slotY - 44), 12, DIM, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local editKit = link(spawnPage, "", UDim2.fromOffset(160, 18), UDim2.new(0, M0, 1, slotY), 12, Vector2.new(0, 1))
  editKit.TextColor3 = WHITE
  editKit.Font = Enum.Font.GothamBold
  -- 主按钮：出击
  local deployBtn, deployBtnT, deployBtnK = mainButton(spawnPage, UDim2.fromOffset(CW, CH), UDim2.new(1, -M0, 1, slotY), Vector2.new(1, 1))

  -- 键位说明放在部署界面最下面（战斗里第一人称不显示键位）
  local deployHelp = label(deploy, "", UDim2.new(1, -40, 0, 14), UDim2.new(0.5, 0, 1, -16), 11, FAINT, Enum.Font.Gotham, Vector2.new(0.5, 0))
  deployHelp.Visible = not G.mobile
  -- 开着菜单（挂载编辑器、部署界面）：鼠标要放出来点东西
  function G.menuOpen()
    return (G.hangarOpen ~= nil and G.hangarOpen()) or (G.pickerOpen ~= nil and G.pickerOpen()) or deploy.Visible
      or (G.tacOpen ~= nil and G.tacOpen())   -- 战术平板开着：鼠标放出来点地图、不开枪
  end

  local function doDeploy()
    local S = G.S
    if not S or S.alive or (S.wait or 0) > 0 then return end
    if not sel.spawn then G.toast(T("ui.needPick"), "bad") return end
    G.R.Act:FireServer("deploy", sel.role or sel.kit, sel.spawn)
  end
  deployBtn.Activated:Connect(doDeploy)
  local function setPage(pg, user)
    sel.page = pg
    if user then sel.pageUser = pg end
    sel.slot = nil
    G.refreshDeploy()
  end
  goSpawn.Activated:Connect(function() setPage("spawn", true) end)
  editKit.Activated:Connect(function() setPage("kit", true) end)
  tabs.kit.b.Activated:Connect(function() setPage("kit", true) end)
  tabs.spawn.b.Activated:Connect(function() setPage("spawn", true) end)
  -- 回车：装备页 → 生成点 → 出击；退格：回装备页
  UIS.InputBegan:Connect(function(io, gp)
    if gp or not deploy.Visible then return end
    if io.KeyCode == Enum.KeyCode.Return then
      if sel.page == "spawn" then doDeploy() else setPage("spawn", true) end
    elseif io.KeyCode == Enum.KeyCode.Backspace and sel.page == "spawn" then
      setPage("kit", true)
    end
  end)

  local function spawnName(s)
    if s.kind == "beach" then return T("beach." .. s.beach) end
    if s.kind == "point" then return T("point." .. s.point) end
    if s.kind == "rally" then return T("spawn.rally", T("point." .. s.point)) end   -- 守方前线集结点（据点后方）
    if s.kind == "staging" then return T("spawn.staging", T("point." .. s.point)) end   -- 攻方攻击出发阵地（据点前面）
    if s.kind == "camp" then return T("spawn.camp") end
    if s.kind == "afield" then return T("spawn.afield") end
    if s.kind == "fleet" then return T("spawn.fleet") end
    if s.kind == "para" then return T("spawn.para") end
    if s.kind == "cv" then return T("spawn.cv") end
    if s.kind == "barge" then return T("spawn.barge") end
    if s.kind == "af2" then return T("spawn.af2") end
    return s.id
  end

  -- 推荐的出生点（服务器标 rec：离当前目标最近的）：没选过、选的不能用了、换了阶段 / 新一局，就自动选上它——进来按一下出击就上战场
  local function autoSpawn(S)
    local ids, rec = {}, nil
    for _, s in ipairs(S.spawns or {}) do
      ids[s.id] = s
      if s.rec then rec = s end
    end
    local cur = sel.spawn and ids[sel.spawn]
    local stale = not cur or not cur.ok or sel.spawnStage ~= (S.stage or 1) or sel.spawnRound ~= S.round
    if stale and rec then
      sel.spawn = rec.id
      sel.spawnStage, sel.spawnRound = S.stage or 1, S.round
    end
  end
  -- 出生点：左边一列（名字、能不能去），地图上一个个小点
  local function buildSpawns(S)
    for _, b in ipairs(spawnBtns) do b:Destroy() end
    spawnBtns = {}
    local ids = {}
    for i, s in ipairs(S.spawns or {}) do
      ids[s.id] = s
      local chosen = sel.spawn == s.id
      local function pick()
        if not s.ok then G.toast(T("ui.spawnBlocked"), "bad") return end
        sel.spawn = s.id
        sel.spawnStage, sel.spawnRound = S.stage or 1, S.round   -- 自己挑的：这一阶段里一直用它
        G.refreshDeploy()
      end
      -- 列表里一行
      local row = Instance.new("TextButton")
      row.LayoutOrder = i
      row.Size = UDim2.new(1, -6, 0, mobile and 30 or 38)
      row.BackgroundColor3 = chosen and RGB(255, 255, 255) or RGB(12, 14, 16)
      row.BackgroundTransparency = chosen and 0.9 or 0.45
      row.BorderSizePixel = 0
      row.AutoButtonColor = false
      row.Text = ""
      row.Parent = list
      frame(row, UDim2.new(0, 2, 1, 0), nil, WHITE, chosen and 0 or 1)
      txt(row, spawnName(s), UDim2.new(1, -110, 1, 0), UDim2.fromOffset(14, 0), mobile and 12 or 14, s.ok and WHITE or FAINT, chosen and Enum.Font.GothamBold or Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
      local tag = txt(row, s.ok and (s.rec and T("deploy.rec") or "") or T("deploy.blocked"), UDim2.fromOffset(90, 16), UDim2.new(1, -12, 0.5, 0), 11, FAINT, Enum.Font.GothamBold, Vector2.new(1, 0.5), Enum.TextXAlignment.Right)
      if s.ok and s.rec then tag.TextColor3 = teamColor(S.team or "atk"):Lerp(WHITE, 0.3) end   -- 推荐：离当前目标最近
      row.Activated:Connect(pick)
      table.insert(spawnBtns, row)
      -- 地图上的点
      if s.x and spawnLayer then
        local u, v = G.mapUV(s.x, s.z)
        local b = Instance.new("TextButton")
        b.AnchorPoint = Vector2.new(0.5, 0.5)
        b.Position = UDim2.fromScale(u, v)
        b.Size = UDim2.fromOffset(chosen and 16 or 11, chosen and 16 or 11)
        b.Rotation = 45
        b.BackgroundColor3 = s.ok and WHITE or RGB(110, 110, 110)
        b.BackgroundTransparency = chosen and 0 or 0.25
        b.BorderSizePixel = 0
        b.Text = ""
        b.ZIndex = 8
        b.Parent = spawnLayer
        local st = Instance.new("UIStroke")
        st.Color = RGB(0, 0, 0)
        st.Thickness = 1
        st.Transparency = 0.3
        st.Parent = b
        if chosen then
          local tip = label(spawnLayer, spawnName(s), UDim2.fromOffset(160, 16), UDim2.new(u, 0, v, 12), 12, WHITE, Enum.Font.GothamBold, Vector2.new(0.5, 0))
          tip.ZIndex = 8
          tip.TextStrokeTransparency = 0.4
          table.insert(spawnBtns, tip)
        end
        b.Activated:Connect(pick)
        table.insert(spawnBtns, b)
      end
    end
    if sel.spawn and (not ids[sel.spawn] or not ids[sel.spawn].ok) then sel.spawn = nil end
  end

  -- 装备格：上面弹出这一格能换的
  local function openPicker(i)
    for _, c in ipairs(pickCards) do c.b:Destroy() end
    pickCards = {}
    if sel.slot == i or not SLOTS[i] then sel.slot = nil picker.Visible = false return end
    sel.slot = i
    focus = i
    local slot = SLOTS[i]
    local opts = table.clone(slot.opts)
    if slot.none then table.insert(opts, false) end
    local S = G.S or {}
    local pw, ph = mobile and 112 or 168, mobile and 70 or 104
    local x0 = math.max(M0, M0 + (i - 1) * (SW + GAP))
    pickHead.Text = T("deploy.choose", T("deploy.slot." .. slot.id))
    pickHead.Position = UDim2.new(0, x0, 1, slotY - SH - 14 - ph - 22)
    for k, id in ipairs(opts) do
      local c = newCard(picker, pw, ph)
      c.b.AnchorPoint = Vector2.new(0, 1)
      c.b.Position = UDim2.new(0, x0 + (k - 1) * (pw + 6), 1, slotY - SH - 14)
      c.idx.Text = ""
      local on = (sel.kit[slot.id] or false) == id
      local pass = id and G.passFor(id)
      local locked = pass and not passOk(pass)
      c.cat.Text = locked and T("pass.lockTag", Config.Passes[pass].price) or (on and T("deploy.current") or "")
      c.cat.TextColor3 = locked and RGB(255, 196, 92) or FAINT
      c.nm.Text = itemName(id or nil)
      local n = id and countOf(id)
      c.cnt.Text = n and ("×" .. n) or ""
      c.st.Transparency = on and 0.2 or 0.86
      if id then c.wait = setModel(c.vp, id, S.team) c.item = id end
      c.b.Activated:Connect(function()
        if locked then G.buyPass(pass) return end   -- 没解锁：弹出 Roblox 的购买框（买成了属性一变，这里自动刷新）
        sel.kit[slot.id] = id or nil
        sel.slot = nil
        picker.Visible = false
        for _, cc in ipairs(pickCards) do cc.b:Destroy() end
        pickCards = {}
        G.refreshDeploy()
      end)
      table.insert(pickCards, c)
    end
    picker.Visible = true
  end
  for i, c in ipairs(cards) do
    c.b.Activated:Connect(function()
      openPicker(i)
      G.refreshDeploy()
    end)
  end
  G.deployPick = openPicker   -- 测试、截图用：点开 / 收起第 i 格

  local lastTeam = nil
  function G.refreshDeploy()
    local S = G.S
    if not S then return end
    local team = S.team or "atk"
    local tc = teamColor(team)
    autoSpawn(S)
    -- 页：选好了出生点（推荐的自动选上）就先给生成点页，装备用默认的，按一下出击就上战场；想改装备点「改装备」
    local page = sel.pageUser or (sel.spawn and "spawn" or "kit")
    sel.page = page
    kitPage.Visible = page == "kit"
    spawnPage.Visible = page == "spawn"
    for pg, t in pairs(tabs) do
      t.b.Text = T("deploy.tab." .. pg)
      t.b.TextColor3 = (pg == page) and WHITE or DIM
      t.u.BackgroundTransparency = (pg == page) and 0 or 1
      t.u.BackgroundColor3 = WHITE
    end
    langBtn.Text = T("ui.lang")
    sideBtn.Text = T("ui.switchSide")
    menuBtn.Text = T("menu.open")
    -- 阵营一行
    facDot.BackgroundColor3 = tc
    facLine.Text = T("faction." .. team .. ".name") .. "   ·   " .. T((team == "def") and "ui.goalDef" or "ui.goalAtk")
    -- 换了阵营：装备格的样子（两边的模型不一样）重画
    if lastTeam ~= team then
      lastTeam = team
      for _, c in ipairs(cards) do c.item = "?" end
      bigItem = "?"
    end
    -- 装备格
    for i, c in ipairs(cards) do
      local slot = c.slot
      local id = sel.kit[slot.id]
      if not id and not slot.none then id = slot.opts[1] sel.kit[slot.id] = id end
      if id and G.passFor(id) and not passOk(G.passFor(id)) then id = nil sel.kit[slot.id] = nil end   -- 没解锁的（比如通行证刚上架）不带
      c.idx.Text = tostring(i)
      c.cat.Text = T("deploy.slot." .. slot.id)
      c.nm.Text = itemName(id)
      c.nm.TextColor3 = id and WHITE or FAINT
      local n = id and countOf(id)
      c.cnt.Text = n and ("×" .. n) or ""
      local on = (sel.slot == i) or (sel.slot == nil and focus == i)
      c.st.Transparency = on and 0.35 or 0.86
      c.bar.BackgroundTransparency = (sel.slot == i) and 0 or 1
      c.b.BackgroundTransparency = on and 0.25 or 0.4
      if c.item ~= (id or false) then
        c.item = id or false
        c.wait = setModel(c.vp, id, team)
      end
    end
    picker.Visible = sel.slot ~= nil
    -- 标题、说明、数据、大图：看的那一格
    local fs = SLOTS[focus] or SLOTS[1]
    local fid = sel.kit[fs.id]
    bigName.Text = fid and itemName(fid) or T("deploy.none")
    bigDesc.Text = T("deploy.slot." .. fs.id) .. "   ·   " .. (fid and T("gear." .. fid .. ".desc") or T("deploy.noneDesc"))
    local rows = fid and statRows(fid) or {}
    for k, r in ipairs(stats) do
      local d = rows[k]
      local show = d ~= nil and not mobile
      r.a.Visible, r.bg.Visible, r.v.Visible = show, show, show
      if d then
        r.a.Text = d[1]
        r.fill.Size = UDim2.fromScale(d[2], 1)
        r.v.Text = d[3]
      end
    end
    if bigItem ~= (fid or false) then
      bigItem = fid or false
      bigWait = setModel(big, fid, team)
    end
    -- 主按钮
    goSpawnT.Text = T("deploy.pickSpawn")
    goSpawnK.Text = mobile and "" or T("deploy.enter")
    buildSpawns(S)
    listHead.Text = T("deploy.tab.spawn")
    local names = {}
    for _, slot in ipairs(SLOTS) do
      local id = sel.kit[slot.id]
      if id then table.insert(names, itemName(id)) end
    end
    kitLine.Text = T("deploy.kitLine", table.concat(names, " · "))
    editKit.Text = T("deploy.editKit")
    if (S.wait or 0) > 0 then
      deployBtnT.Text = T("ui.waitRespawn", S.wait)
      deployBtn.BackgroundColor3 = RGB(46, 48, 52)
      deployBtnT.TextColor3 = DIM
      deployBtn.AutoButtonColor = false
    else
      deployBtnT.Text = T("ui.deployBtn")
      deployBtn.BackgroundColor3 = WHITE
      deployBtnT.TextColor3 = sel.spawn and RGB(10, 10, 12) or RGB(120, 120, 124)
      deployBtn.AutoButtonColor = true
    end
    deployBtnK.Text = mobile and "" or T("deploy.enter")
  end

  -- 真模型还在生成：隔两秒再要一次（最多等半分钟）
  task.spawn(function()
    for _ = 1, 15 do
      task.wait(2)
      if deploy.Visible and G.S then
        local any = false
        for _, c in ipairs(cards) do if c.wait then c.item = "?" any = true end end
        if bigWait then bigItem = "?" any = true end
        if any then G.refreshDeploy() end
      end
    end
  end)
  -- 大图慢慢左右转（绕模型中心：G.viewFit 记在属性 C 里）
  G.frameConn("UI2", function()
    if not deploy.Visible or not kitPage.Visible then return end
    local m = big:FindFirstChildOfClass("Model")
    local c = m and m:GetAttribute("C")
    if c then pcall(function() m:PivotTo(CFrame.new(c) * CFrame.Angles(0, math.sin(os.clock() * 0.5) * 0.3, 0)) end) end
  end)

  langBtn.Activated:Connect(function()
    G.lang = (G.lang == "zh") and "en" or "zh"
    G.refresh()
  end)

  ---------------------------------------------------------------- 顶栏：时间、据点

  local hud = frame(gui, UDim2.fromScale(1, 1), nil, PANEL, 1)
  hud.Name = "Hud"
  local topBar = frame(hud, UDim2.fromOffset(460, 74), UDim2.new(0.5, 0, 0, 8), PANEL, 0.35, Vector2.new(0.5, 0))
  round(topBar, 10)
  local timer = label(topBar, "", UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, 4), 20, TEXT, Enum.Font.GothamBlack)
  local chips = {}
  for i, p in ipairs(Map.POINTS) do
    local c = frame(topBar, UDim2.fromOffset(80, 38), UDim2.fromOffset(10 + (i - 1) * 89, 30), RGB(30, 40, 60), 0.05)
    round(c, 6)
    local l = label(c, p.id, UDim2.new(0, 26, 1, 0), UDim2.fromOffset(4, 0), 20, Color3.new(1, 1, 1), Enum.Font.GothamBlack)
    local n = label(c, "", UDim2.new(1, -32, 0, 18), UDim2.fromOffset(30, 3), 12, Color3.new(1, 1, 1), Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
    local barBg = frame(c, UDim2.new(1, -36, 0, 5), UDim2.new(0, 30, 1, -10), RGB(0, 0, 0), 0.5)
    local bar = frame(barBg, UDim2.fromScale(0, 1), nil, Config.Teams.atk.color, 0)
    chips[p.id] = { f = c, l = l, n = n, bar = bar }
  end
  local counts = label(hud, "", UDim2.fromOffset(240, 20), UDim2.new(0.5, 0, 0, 84), 14, TEXT, Enum.Font.GothamBold, Vector2.new(0.5, 0))
  counts.TextStrokeTransparency = 0.5

  -- 血条
  local hpBg = frame(hud, UDim2.fromOffset(260, 14), UDim2.new(0, 20, 1, -40), RGB(0, 0, 0), 0.45)
  round(hpBg, 4)
  local hpBar = frame(hpBg, UDim2.fromScale(1, 1), nil, RGB(90, 210, 110), 0)
  round(hpBar, 4)
  local hpText = label(hpBg, "", UDim2.fromScale(1, 1), nil, 12, Color3.new(1, 1, 1), Enum.Font.GothamBold)
  local roleText = label(hud, "", UDim2.fromOffset(260, 18), UDim2.new(0, 20, 1, -62), 14, TEXT, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  roleText.TextStrokeTransparency = 0.5
  local help = label(hud, "", UDim2.new(0.6, 0, 0, 16), UDim2.new(0.5, 0, 1, -18), 12, MUTE, Enum.Font.Gotham, Vector2.new(0.5, 0))
  help.TextStrokeTransparency = 0.6

  -- 小地图容器（Hud.lua 摆到右上、画成方形雷达小地图）：CanvasGroup 才能把里面的地图、亮点按框裁掉
  local miniBox = Instance.new("CanvasGroup")
  miniBox.Name = "Radar"
  miniBox.Size, miniBox.Position, miniBox.AnchorPoint = UDim2.fromOffset(230, 230), UDim2.new(1, -16, 1, -16), Vector2.new(1, 1)
  miniBox.BackgroundColor3, miniBox.BackgroundTransparency, miniBox.BorderSizePixel = PANEL, 1, 0
  miniBox.Parent = hud
  -- 战斗中的界面换成《坠落》那种风格（Hud.lua）：旧的顶栏、血条、兵种字交给它收起来，小地图框挪到左下
  G.hudParts = { hud = hud, topBar = topBar, counts = counts, hpBg = hpBg, roleText = roleText, miniBox = miniBox, help = help }

  ---------------------------------------------------------------- 消息

  local center = label(gui, "", UDim2.new(0.8, 0, 0, 40), UDim2.new(0.5, 0, 0.44, 0), 24, Color3.new(1, 1, 1), Enum.Font.GothamBold, Vector2.new(0.5, 0.5))
  center.TextStrokeTransparency = 0.3
  center.ZIndex = 30
  local centerT = 0
  local feed = frame(gui, UDim2.fromOffset(340, 160), UDim2.new(1, -16, 0, 120), PANEL, 1, Vector2.new(1, 0))
  G.hudParts.feed = feed   -- 击杀信息：Hud.lua 把小地图放到右上后挪到它下面
  local feedList = Instance.new("UIListLayout")
  feedList.HorizontalAlignment = Enum.HorizontalAlignment.Right
  feedList.SortOrder = Enum.SortOrder.LayoutOrder
  feedList.Parent = feed
  local toasts = frame(gui, UDim2.fromOffset(440, 200), UDim2.new(0.5, 0, 1, -110), PANEL, 1, Vector2.new(0.5, 1))
  local toastList = Instance.new("UIListLayout")
  toastList.VerticalAlignment = Enum.VerticalAlignment.Bottom
  toastList.HorizontalAlignment = Enum.HorizontalAlignment.Center
  toastList.Padding = UDim.new(0, 4)
  toastList.SortOrder = Enum.SortOrder.LayoutOrder
  toastList.Parent = toasts
  local order = 0
  -- 跟新界面一个样子（深色、直角、细线）：底是深色，左边一道颜色细条分好消息、坏消息、击杀
  local KIND_COL = { good = RGB(96, 200, 124), bad = RGB(232, 84, 72), info = RGB(160, 170, 166), kill = RGB(232, 184, 76) }
  function G.toast(text, kind)
    order += 1
    local l = label(toasts, text, UDim2.fromOffset(420, 28), nil, 14, TEXT, Enum.Font.GothamMedium)
    l.BackgroundColor3 = RGB(6, 8, 10)
    l.BackgroundTransparency = 0.2
    l.LayoutOrder = order
    stroke(l, LINE, 1, 0.9)
    frame(l, UDim2.new(0, 3, 1, 0), nil, KIND_COL[kind or "info"] or KIND_COL.info, 0)
    task.delay(4, function() l:Destroy() end)
  end
  function G.centerMsg(text)
    center.Text = text
    center.TextTransparency = 0
    centerT = os.clock()
  end
  local function feedAdd(text)
    order += 1
    local l = label(feed, text, UDim2.fromOffset(340, 22), nil, 14, Color3.new(1, 1, 1), Enum.Font.GothamBold, nil, Enum.TextXAlignment.Right)
    l.TextStrokeTransparency = 0.4
    l.LayoutOrder = order
    local kids = {}
    for _, c in ipairs(feed:GetChildren()) do if c:IsA("TextLabel") then table.insert(kids, c) end end
    if #kids > 6 then table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end) kids[1]:Destroy() end
    task.delay(8, function() l:Destroy() end)
  end

  -- 服务器发来的文字：kind、编号、参数（参数里的 { k = 编号 } 也翻译）
  function G.onMsg(kind, key, ...)
    if kind == "hit" then
      if G.hitMarker then G.hitMarker(key) end
      return
    end
    if kind == "hurt" then   -- 挨打：伤害从哪来（Juice.lua 在准星周围画红弧），key 是位置
      if G.juiceHurt and typeof(key) == "Vector3" then G.juiceHurt(key) end
      return
    end
    if key == "ui.capturedYou" and G.juiceScore then G.juiceScore(G.Config.Score.capture, T("juice.cap")) end
    if kind == "ric" then   -- 跳弹（服务器 Ents.lua）：准星下面弹一行黄字（打出去的跳了 / 打过来的被弹开）
      if G.pop then G.pop(T(key, ...), key == "hit.ricIn" and "ricIn" or "ric") end
      return
    end
    if kind == "refill" then   -- 战术平板的补给箱：本地弹药也补满（Play.lua）
      if G.refillAmmo then G.refillAmmo() end
      return
    end
    if kind == "stage" then   -- Operation.lua 直接从战况读阶段，中途入场也会显示简报。
      if not G.stepOperation then G.centerMsg(T(key)) end
      return
    end
    local text = T(key, ...)
    -- 击杀、自己占下据点：准星下面弹一行（Hud.lua G.pop），右上角照样留一条
    if G.pop and (kind == "kill" or key == "ui.capturedYou") then G.pop(text, kind) end
    if kind == "center" then G.centerMsg(text)
    elseif kind == "feed" then feedAdd(text)
    else G.toast(text, kind) end
  end

  ---------------------------------------------------------------- 战况表（按住 Tab）

  -- 跟新界面一个样子：深色、直角、细线（用户：要精致简洁，不要卡通）
  local board = frame(gui, UDim2.fromOffset(780, 520), UDim2.fromScale(0.5, 0.52), RGB(6, 8, 10), 0.08, Vector2.new(0.5, 0.5))
  board.Visible = false
  board.ZIndex = 20
  stroke(board, LINE, 1, 0.88)
  local boardTitle = label(board, "", UDim2.new(1, -48, 0, 40), UDim2.fromOffset(24, 8), 16, TEXT, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  boardTitle.ZIndex = 21
  local cols = {}
  for i, t in ipairs({ "atk", "def" }) do
    local c = frame(board, UDim2.new(0.5, -36, 1, -64), UDim2.new((i - 1) * 0.5, 24, 0, 52), RGB(0, 0, 0), 1)
    c.ZIndex = 21
    local tl = frame(c, UDim2.new(1, 0, 0, 2), nil, teamColor(t), 0)   -- 顶上一道队色细线
    tl.ZIndex = 22
    local h = label(c, "", UDim2.new(1, 0, 0, 28), UDim2.fromOffset(0, 6), 14, TEXT, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
    h.ZIndex = 22
    local list = Instance.new("Frame")
    list.BackgroundTransparency = 1
    list.Size = UDim2.new(1, -8, 1, -32)
    list.Position = UDim2.fromOffset(4, 30)
    list.ZIndex = 22
    list.Parent = c
    local ll = Instance.new("UIListLayout")
    ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Parent = list
    cols[t] = { head = h, list = list }
  end
  local boardData = {}
  function G.onBoard(d) boardData = d or {} if board.Visible then G.drawBoard() end end
  function G.drawBoard()
    boardTitle.Text = T("ui.scoreboard")
    for t, c in pairs(cols) do
      for _, k in ipairs(c.list:GetChildren()) do if k:IsA("Frame") then k:Destroy() end end
      local rows = {}
      for _, e in ipairs(boardData) do if e.t == t then table.insert(rows, e) end end
      table.sort(rows, function(a, b) return (a.s or 0) > (b.s or 0) end)
      c.head.Text = T("hud." .. t) .. "   ·   " .. T("team." .. t) .. "   " .. #rows
      local hdr = frame(c.list, UDim2.new(1, 0, 0, 18), nil, PANEL, 1)
      hdr.LayoutOrder = 0
      hdr.ZIndex = 22
      for k, txt in ipairs({ "", T("ui.kills"), T("ui.deaths"), T("ui.captures"), T("ui.score") }) do
        local l = label(hdr, txt, UDim2.new(k == 1 and 0.44 or 0.14, 0, 1, 0), UDim2.new(k == 1 and 0 or (0.44 + (k - 2) * 0.14), 0, 0, 0), 10, MUTE, Enum.Font.GothamMedium)
        l.ZIndex = 23
      end
      for i, e in ipairs(rows) do
        if i > 22 then break end
        local r = frame(c.list, UDim2.new(1, 0, 0, 20), nil, RGB(255, 255, 255), (e.id == player.UserId) and 0.9 or 1)
        r.LayoutOrder = i
        r.ZIndex = 22
        local nm = e.n .. (e.bot and (" " .. T("ui.bot")) or "")
        for k, txt in ipairs({ nm, tostring(e.k or 0), tostring(e.d or 0), tostring(e.c or 0), tostring(e.s or 0) }) do
          local l = label(r, txt, UDim2.new(k == 1 and 0.44 or 0.14, 0, 1, 0), UDim2.new(k == 1 and 0 or (0.44 + (k - 2) * 0.14), 0, 0, 0), 12, TEXT,
            Enum.Font.GothamMedium, nil, k == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center)
          l.ZIndex = 23
          l.TextTruncate = Enum.TextTruncate.AtEnd
        end
      end
    end
  end
  UIS.InputBegan:Connect(function(io, gp)
    if io.KeyCode == Enum.KeyCode.Tab then
      board.Visible = true
      G.drawBoard()
    end
    G.boardShown = function() return board.Visible end
  end)
  UIS.InputEnded:Connect(function(io)
    if io.KeyCode == Enum.KeyCode.Tab then board.Visible = false end
  end)
  local boardBtn = button(hud, "≡", UDim2.fromOffset(36, 36), UDim2.new(0, 16, 0, 70), RGB(8, 10, 12))   -- 顶栏下面：左上角是 Roblox 自带的菜单、聊天按钮
  boardBtn.BackgroundTransparency = 0.5
  boardBtn.TextColor3 = RGB(200, 206, 210)
  for _, c in ipairs(boardBtn:GetChildren()) do if c:IsA("UICorner") then c:Destroy() end end   -- 直角，跟新界面一样
  boardBtn.TextSize = 22
  boardBtn.Activated:Connect(function()
    board.Visible = not board.Visible
    if board.Visible then G.drawBoard() end
  end)

  ---------------------------------------------------------------- 结算

  -- 跟战况表一个样子：深色、直角、细线；顶上一道胜方的队色细线，四个大数字，经验、军衔，下一局倒计时
  local results = frame(gui, UDim2.fromOffset(640, 286), UDim2.fromScale(0.5, 0.46), RGB(6, 8, 10), 0.08, Vector2.new(0.5, 0.5))
  results.Visible = false
  results.ZIndex = 25
  stroke(results, LINE, 1, 0.88)
  local resLine = frame(results, UDim2.new(1, 0, 0, 2), nil, LINE, 0)
  local resCap = label(results, "", UDim2.new(1, -56, 0, 16), UDim2.fromOffset(28, 22), 11, MUTE, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local resTitle = label(results, "", UDim2.new(1, -56, 0, 42), UDim2.fromOffset(28, 40), 34, TEXT, Enum.Font.GothamBold, nil, Enum.TextXAlignment.Left)
  local resSub = label(results, "", UDim2.new(1, -56, 0, 20), UDim2.fromOffset(28, 86), 14, MUTE, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local resNums = {}
  for i, k in ipairs({ "ui.kills", "ui.deaths", "ui.captures", "ui.score" }) do
    local x = 28 + (i - 1) * 146
    resNums[i] = {
      k = k,
      n = label(results, "0", UDim2.fromOffset(130, 38), UDim2.fromOffset(x, 124), 30, TEXT, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left),
      c = label(results, "", UDim2.fromOffset(130, 14), UDim2.fromOffset(x, 164), 11, MUTE, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left),
    }
  end
  local resSep = frame(results, UDim2.new(1, -56, 0, 1), UDim2.fromOffset(28, 196), LINE, 0.88)
  local resXp = label(results, "", UDim2.new(1, -56, 0, 20), UDim2.fromOffset(28, 208), 14, TEXT, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  local resNext = label(results, "", UDim2.new(1, -56, 0, 18), UDim2.new(0, 28, 1, -40), 12, MUTE, Enum.Font.GothamMedium, nil, Enum.TextXAlignment.Left)
  for _, x in ipairs({ resLine, resCap, resTitle, resSub, resSep, resXp, resNext }) do x.ZIndex = 26 end
  for _, r in ipairs(resNums) do r.n.ZIndex, r.c.ZIndex = 26, 26 end
  if mobile then   -- 手机横屏（844 × 390）：缩一点，别盖住触屏按钮
    local sc = Instance.new("UIScale")
    sc.Scale = 0.8
    sc.Parent = results
  end

  ---------------------------------------------------------------- 刷新（收到服务器状态时）

  local mapMountedIn = nil
  function G.refresh()
    local S = G.S
    if not S then return end
    if (S.progress or 1) < 1 then
      loading.Visible = true
      loadText.Text = T("ui.serverStarting", math.floor((S.progress or 0) * 100))
      return
    end
    loading.Visible = false
    if G.refreshMenu then G.refreshMenu(S) end         -- 主菜单（Menu.lua）：进服先到这里
    if G.refreshFaction then G.refreshFaction(S) end   -- 选阵营界面（Faction.lua）：主菜单点了「进入战斗」还没选、或者点了「换阵营」
    local showDeploy = not S.alive and S.phase ~= "end"
    if S.alive then sel.pageUser, sel.slot = nil, nil end   -- 下次阵亡：上次出击过就先给生成点页
    deploy.Visible = showDeploy and not (G.menuShown and G.menuShown())   -- 主菜单开着（背景是透明的 3D 场景）：部署界面先不画
    hud.Visible = not showDeploy
    results.Visible = S.phase == "end"
    -- 地图放在部署界面或小地图里
    local want = showDeploy and mapHolder or miniBox
    if mapMountedIn ~= want then
      mapMountedIn = want
      local _, marks = G.mapMount(want, UDim2.fromScale(1, 1))
      spawnLayer = marks
    end
    if G.mapRefresh then G.mapRefresh(S) end
    if showDeploy then
      G.refreshDeploy()
      if S.phase == "prep" then phaseText.Text = T("ui.prep", S.left) else phaseText.Text = T("ui.timeLeft") .. "  " .. fmtTime(S.left) end
    else
      for _, b in ipairs(spawnBtns) do b:Destroy() end
      spawnBtns = {}
    end
    -- 顶栏
    if S.phase == "prep" then
      timer.Text = T("ui.prep", S.left)
    elseif S.ot then
      timer.Text = T("ui.overtime") .. "  " .. fmtTime(S.ot)
    else
      timer.Text = fmtTime(S.left)
    end
    for _, s in ipairs(S.points or {}) do
      local c = chips[s.id]
      if c then
        c.f.BackgroundColor3 = teamColor(s.owner):Lerp(Color3.new(0, 0, 0), 0.25)
        c.bar.Size = UDim2.fromScale(s.locked and 1 or s.prog, 1)
        c.n.Text = s.locked and "" or ((s.atk > 0 or s.def > 0) and (T("team.atk.short") .. s.atk .. " " .. T("team.def.short") .. s.def) or "")
      end
    end
    counts.Text = T("team.atk") .. " " .. (S.nAtk or 0) .. "   ·   " .. T("team.def") .. " " .. (S.nDef or 0)
    roleText.Text = (S.role and T("role." .. S.role) or "") .. "  ·  " .. T("team." .. (S.team or "atk"))
    roleText.TextColor3 = teamColor(S.team)
    if S.phase == "end" then
      local won = S.winner == S.team
      resLine.BackgroundColor3 = teamColor(S.winner)
      resCap.Text = T("ui.roundOver")
      resTitle.Text = T(won and "ui.youWon" or "ui.youLost")
      resTitle.TextColor3 = won and TEXT or RGB(236, 120, 108)
      resSub.Text = T((S.winner == "atk") and "ui.win.atk" or "ui.win.def") .. (S.mvp and ("   ·   MVP  " .. S.mvp) or "")
      local me = S.me or {}
      local vals = { me.k or 0, me.d or 0, me.c or 0, me.s or 0 }
      for i, r in ipairs(resNums) do
        r.n.Text = tostring(vals[i])
        r.c.Text = T(r.k)
      end
      resXp.Text = T("ui.xp", me.gain or 0) .. "   ·   " .. Lang.rank(G.lang, me.rank or 1)
      resNext.Text = T("ui.nextRound", S.left)
    end
  end

  function G.stepUI(dt)
    -- 开着载具 / 飞机 / 火炮：血条、兵种看载具面板；最下面一行换成载具的操作说明（面板里放不下一整行）
    local drv = G.drive
    hpBg.Visible, roleText.Visible = not drv, not drv
    help.Text = T(drv and (drv.help or "ui.vehHelp") or "ui.help")
    -- 手机上是触屏按钮，不显示键盘说明；步行第一人称也不显示（用户：持枪第一视角不要显示鼠标、键位；键位说明在部署界面最下面）
    help.Visible = not G.coachOn and not G.mobile and not (G.fpActive and not drv)   -- Coach.lua 换成按当前状态的几个键（全文在 F1）
    deployHelp.Text = T("ui.help")
    -- 鼠标指针：游戏里锁在屏幕中间时（第一人称、肩后瞄准、开车开飞机开船、操作工事）不画——准星是自己画的；开着菜单时画出来
    if not G.mobile then
      local menu = G.menuOpen()
      local locked = not menu and (UIS.MouseBehavior == Enum.MouseBehavior.LockCenter or (G.fpActive and not drv) or drv ~= nil)
      if UIS.MouseIconEnabled == locked then UIS.MouseIconEnabled = not locked end
      if menu and UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then UIS.MouseBehavior = Enum.MouseBehavior.Default end
    end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
      local k = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
      hpBar.Size = UDim2.fromScale(k, 1)
      hpBar.BackgroundColor3 = RGB(230, 70, 60):Lerp(RGB(90, 210, 110), k)
      hpText.Text = math.ceil(hum.Health) .. " / " .. math.ceil(hum.MaxHealth)
    end
    local a = os.clock() - centerT
    local fade = results.Visible and 1 or math.clamp((a - 3) / 1, 0, 1)   -- 结算面板开着：中间那行大字（胜负原因）面板上有了，不叠着画
    center.TextTransparency = fade
    center.TextStrokeTransparency = 0.3 + 0.7 * fade
  end
end

return UI
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">VehHud</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——载具驾驶界面。用户 11-18：「坦克驾驶界面、操作系统观感不够惊艳，舰船也是……放开了做，作出一款震撼的作品」
--   照战雷、战地的样子重做坦克（Drive.lua 的 G.myVeh）和舰艇（Sail.lua 的 G.sail）的驾驶界面；
--   有了这个模块（G.vehHudOn），Drive.lua、Sail.lua 原来那块小面板、圆圈、黄十字不画了（瞄准镜、望远镜、导弹锁定框照旧归它们）。
--   · 电脑右下两块，触屏用紧凑读数面板给方向键留位置：
--     「车况 / 舰况」：名字；俯视轮廓（车体 / 舰体按相对镜头的朝向转，炮塔、炮管按各自的朝向转；外圈上方两道短线是镜头看的方向），
--       描边按血量变色、挨打闪红；十格血条和百分比；坦克：速度（大数字）、挡位 D / R / N、航向、油门条；
--       舰艇：航速（节）、车钟（后退二 … 全速前进 一格格的梯子，亮的是现在这一档）、舵角条（左右 35°）、航向
--     「武器」：每一种武器一行（按键、名字、弹药），选中的那行亮、左边一道琥珀色；右边装填环（24 颗点：装填时一颗颗亮起琥珀色，装好全绿、写「就绪」）；
--       坦克的烟幕弹、舰艇的防空导弹、近防炮
--   · 电脑罗盘放在计分栏左侧或下方，触屏只在面板显示航向；琥珀色小三角是炮管（坦克）/ 舰首（舰艇）的朝向
--   · 中间：镜头看的地方一个小圈；炮现在指的地方一个准星——坦克、舰艇两套不一样（用户 11-19：参考 MWT 和《现代战舰》）：
--     坦克（MWT）：四段弧 + 三道刻度 + 中心点，装填时弧顺时针一段段亮；颜色 = 打不打得穿（照服务器的跳弹算法：绿可击穿、黄可能跳弹、
--       红会跳弹 / 打不穿），下面写出来；右边测距、左边装填秒数；炮塔还没转过来时一个小箭头指着镜头准心
--     舰艇（《现代战舰》）：主炮落点一个细的大圈、四根长线（横线有刻度）、中间菱形，外圈 40 段装填；距离、炮弹飞多久、炮名；
--       瞄着的敌人上方目标卡（名字、距离、血条）和提前量（它照现在的航速、炮弹落下时开到哪）；导弹：四个角框住，锁定中琥珀、已锁定红
--   · 四周一圈很淡的暗角；开炮：瞄准圈一涨一缩、画面一亮
local VehHud = {}

function VehHud.init(G)
  local Players = game:GetService("Players")
  local GuiService = game:GetService("GuiService")
  local Lighting = game:GetService("Lighting")
  local RS = game:GetService("ReplicatedStorage")
  local UIS = game:GetService("UserInputService")
  local V2, V3, UD2, UD = Vector2.new, Vector3.new, UDim2.new, UDim.new
  local RGB = Color3.fromRGB
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local VD = require(RS:WaitForChild("VehDefs"))
  local SD = require(RS:WaitForChild("ShipDefs"))
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local reducedMotion = false
  pcall(function()
    local function updateMotion() reducedMotion = GuiService.ReducedMotionEnabled end
    updateMotion()
    GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(updateMotion)
  end)

  local INK, TXT, MUTE = RGB(6, 9, 12), RGB(232, 238, 236), RGB(174, 187, 186)
  local AMBER, OK, BAD, CYAN = RGB(255, 184, 72), RGB(110, 228, 150), RGB(240, 82, 66), RGB(128, 214, 255)
  local MONO, BOLD, MED = Enum.Font.RobotoMono, Enum.Font.GothamBold, Enum.Font.GothamMedium
  local WHITE = Color3.new(1, 1, 1)

  local function frame(parent, size, pos, color, alpha, anchor)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.AnchorPoint = size, pos or UD2(), anchor or V2()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = color or INK, alpha or 0, 0
    f.Parent = parent
    return f
  end
  local function label(parent, text, size, pos, ts, color, font, anchor, align)
    local l = Instance.new("TextLabel")
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.BackgroundTransparency = 1
    l.Text, l.TextSize, l.TextColor3, l.Font = text or "", ts or 14, color or TXT, font or MED
    l.TextXAlignment = align or Enum.TextXAlignment.Center
    l.Parent = parent
    return l
  end
  local function stroke(f, color, th, alpha)
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = color or WHITE, th or 1, alpha or 0.82
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
  end
  local function roundf(f, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = r or UD(0.5, 0)
    c.Parent = f
    return f
  end
  local function grad(f, rot, seq)
    local g = Instance.new("UIGradient")
    g.Rotation = rot
    g.Transparency = seq
    g.Parent = f
    return g
  end
  local function nseq(...)
    local a, kp = { ... }, {}
    for i = 1, #a, 2 do kp[#kp + 1] = NumberSequenceKeypoint.new(a[i], a[i + 1]) end
    return NumberSequence.new(kp)
  end
  local LEFT, RIGHT = Enum.TextXAlignment.Left, Enum.TextXAlignment.Right
  -- 面板：深色半透明、细白边、左上角刻一道短的亮线
  local function panel(parent, size, pos, anchor)
    local p = frame(parent, size, pos, INK, 0.16, anchor)
    stroke(p, WHITE, 1, 0.86)
    frame(p, UD2(0, 26, 0, 2), UD2(0, -1, 0, -1), TXT, 0.1)
    frame(p, UD2(0, 2, 0, 14), UD2(0, -1, 0, -1), TXT, 0.1)
    return p
  end
  -- 十格血条 + 百分比（左上角 x, y）
  local function hpBlock(p, x, y)
    local o = {}
    o.lab = label(p, "", UD2(0, 70, 0, 14), UD2(0, x, 0, y), 11, MUTE, MED, nil, LEFT)
    o.pct = label(p, "100%", UD2(0, 60, 0, 14), UD2(0, x + 132, 0, y), 12, TXT, MONO, V2(1, 0), RIGHT)
    o.seg = {}
    for i = 1, 10 do o.seg[i] = frame(p, UD2(0, 11, 0, 6), UD2(0, x + (i - 1) * 13.2, 0, y + 18), OK, 0.05) end
    return o
  end
  local function setHp(o, k, col)
    o.pct.Text = string.format("%d%%", math.floor(k * 100 + 0.5))
    o.pct.TextColor3 = col
    for i, s in ipairs(o.seg) do
      local on = k * 10 >= i - 0.5
      s.BackgroundColor3 = on and col or TXT
      s.BackgroundTransparency = on and 0.05 or 0.86
    end
  end
  -- 武器行：n 行（按键、名字、弹药、选中的左边一道琥珀色）
  local function weaponRows(p, n)
    local rows = {}
    for i = 1, n do
      local y = 12 + (i - 1) * 28
      local r = {}
      r.bar = frame(p, UD2(0, 3, 0, 22), UD2(0, 10, 0, y), AMBER, 0)
      r.key = label(p, "", UD2(0, 22, 0, 22), UD2(0, 18, 0, y), 12, TXT, BOLD)
      r.keyStroke = stroke(r.key, WHITE, 1, 0.7)
      r.name = label(p, "", UD2(0, 112, 0, 22), UD2(0, 48, 0, y), 13, TXT, MED, nil, LEFT)
      r.name.TextTruncate = Enum.TextTruncate.AtEnd
      r.ammo = label(p, "", UD2(0, 60, 0, 22), UD2(0, 226, 0, y), 13, TXT, MONO, V2(1, 0), RIGHT)
      r.name.Name, r.ammo.Name = "WName" .. i, "WAmmo" .. i
      rows[i] = r
    end
    return rows
  end
  local function setRow(r, key, name, ammo, sel, empty)
    local vis = name ~= nil
    r.bar.Visible, r.key.Visible, r.name.Visible, r.ammo.Visible = vis and sel, vis and key ~= nil, vis, vis
    if not vis then return end
    r.key.Text = key or ""
    r.name.Text = name
    r.ammo.Text = ammo or ""
    r.name.TextColor3 = sel and TXT or MUTE
    r.ammo.TextColor3 = empty and BAD or (sel and TXT or MUTE)
  end
  -- 装填环：24 颗点 + 中间的字
  local function reloadRing(p, cx, cy)
    local o = { dots = {} }
    o.box = frame(p, UD2(0, 64, 0, 64), UD2(0, cx, 0, cy), INK, 1, V2(0.5, 0.5))
    o.box.Name = "Reload"
    for i = 1, 24 do
      local a = (i - 0.5) / 24 * 2 * math.pi
      o.dots[i] = roundf(frame(o.box, UD2(0, 4, 0, 4), UD2(0.5, math.sin(a) * 27, 0.5, -math.cos(a) * 27), TXT, 0.75, V2(0.5, 0.5)))
    end
    o.txt = label(o.box, "", UD2(0, 60, 0, 20), UD2(0.5, 0, 0.5, -2), 14, OK, BOLD, V2(0.5, 0.5))
    o.txt.Name = "ReloadText"
    o.sub = label(o.box, "", UD2(0, 60, 0, 12), UD2(0.5, 0, 0.5, 13), 9, MUTE, MED, V2(0.5, 0.5))
    return o
  end
  local function setRing(o, relK, ready, left)
    local lit = math.floor(relK * 24 + 0.001)
    for i, d in ipairs(o.dots) do
      d.BackgroundColor3 = ready and OK or (i <= lit and AMBER or TXT)
      d.BackgroundTransparency = ready and 0.1 or (i <= lit and 0.05 or 0.8)
    end
    o.txt.Text = ready and T("vh.ready") or string.format("%.1f", left)
    o.txt.TextColor3 = ready and OK or AMBER
    o.sub.Text = ready and "" or T("vh.reload")
  end
  -- 俯视轮廓的底：一个圈 + 上方两道短线（镜头看的方向）
  local function silBase(p, cx, cy)
    local sil = frame(p, UD2(0, 104, 0, 104), UD2(0, cx, 0, cy), INK, 1, V2(0.5, 0.5))
    sil.Name = "Silhouette"
    stroke(roundf(frame(sil, UD2(1, 0, 1, 0), nil, INK, 1)), WHITE, 1, 0.85)
    for _, a in ipairs({ -32, 32 }) do
      local l = frame(sil, UD2(0, 1, 0, 30), UD2(0.5, math.sin(math.rad(a)) * 22, 0.5, -math.cos(math.rad(a)) * 22), TXT, 0.55, V2(0.5, 1))
      l.Rotation = a
    end
    for i = 0, 11 do   -- 外圈每 30° 一个刻度
      local a = i * 30
      local t = frame(sil, UD2(0, 1, 0, (i % 3 == 0) and 6 or 3), UD2(0.5, math.sin(math.rad(a)) * 50, 0.5, -math.cos(math.rad(a)) * 50), TXT, 0.5, V2(0.5, 0.5))
      t.Rotation = a
    end
    return sil
  end

  local gui = Instance.new("ScreenGui")
  gui.Name = "VehHud"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 6
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")
  G.vehHudOn = true

  for _, e in ipairs({ { UD2(1, 0, 0.16, 0), UD2(0, 0, 0, 0), 90 }, { UD2(1, 0, 0.16, 0), UD2(0, 0, 0.84, 0), 270 },
    { UD2(0.1, 0, 1, 0), UD2(0, 0, 0, 0), 0 }, { UD2(0.1, 0, 1, 0), UD2(0.9, 0, 0, 0), 180 } }) do
    local f = frame(gui, e[1], e[2], RGB(0, 0, 0), 0)
    grad(f, e[3], nseq(0, 0.45, 1, 1))
    f.Name = "Vignette"
  end
  local hud = frame(gui, UD2(1, 0, 1, 0), nil, INK, 1)
  hud.Name = "Panels"
  -- 面板缩放：每块面板自己一个 UIScale（绕自己的锚点缩，贴着角落不动）——原来整层一起缩，小屏幕上面板往左上角跑到屏幕中间
  local ret = frame(gui, UD2(1, 0, 1, 0), nil, INK, 1)
  ret.Name = "Reticles"

  ---------------------------------------------------------------- 坦克：车况、武器
  local TK = {}
  TK.car = panel(hud, UD2(0, 270, 0, 156), UD2(1, -334, 1, -40), V2(1, 1))
  TK.car.Name = "Vehicle"
  TK.name = label(TK.car, "", UD2(1, -20, 0, 18), UD2(0, 12, 0, 8), 14, TXT, MED, nil, LEFT)
  TK.name.Name = "VehName"
  local sil = silBase(TK.car, 60, 94)
  TK.hull = frame(sil, UD2(0, 70, 0, 70), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  TK.hull.Name = "Hull"
  TK.hullStroke = stroke(frame(TK.hull, UD2(0, 26, 0, 50), UD2(0.5, 0, 0.5, 0), RGB(30, 36, 40), 0.15, V2(0.5, 0.5)), OK, 1.5, 0)
  frame(TK.hull, UD2(0, 6, 0, 56), UD2(0.5, -17, 0.5, 0), RGB(200, 206, 204), 0.55, V2(0.5, 0.5))   -- 两条履带
  frame(TK.hull, UD2(0, 6, 0, 56), UD2(0.5, 17, 0.5, 0), RGB(200, 206, 204), 0.55, V2(0.5, 0.5))
  frame(TK.hull, UD2(0, 10, 0, 2), UD2(0.5, 0, 0.5, -27), TXT, 0.2, V2(0.5, 0.5))   -- 车头
  TK.tur = frame(sil, UD2(0, 70, 0, 70), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  TK.tur.Name = "Turret"
  stroke(roundf(frame(TK.tur, UD2(0, 20, 0, 20), UD2(0.5, 0, 0.5, 2), RGB(46, 54, 58), 0.05, V2(0.5, 0.5))), CYAN, 1.5, 0)
  frame(TK.tur, UD2(0, 3, 0, 34), UD2(0.5, 0, 0.5, 0), CYAN, 0, V2(0.5, 1)).Name = "Barrel"
  TK.hp = hpBlock(TK.car, 124, 34)
  TK.spd = label(TK.car, "0", UD2(0, 80, 0, 40), UD2(0, 124, 0, 66), 36, TXT, BOLD, nil, LEFT)
  TK.spd.Name = "Speed"
  label(TK.car, "km/h", UD2(0, 40, 0, 14), UD2(0, 124, 0, 104), 11, MUTE, MED, nil, LEFT)
  local gearBox = frame(TK.car, UD2(0, 30, 0, 30), UD2(1, -46, 0, 72), INK, 0.2)
  stroke(gearBox, WHITE, 1, 0.6)
  TK.gear = label(gearBox, "N", UD2(1, 0, 1, 0), nil, 18, TXT, BOLD)
  TK.gear.Name = "Gear"
  TK.hdg = label(TK.car, "000°", UD2(0, 90, 0, 14), UD2(1, -14, 0, 112), 12, MUTE, MONO, V2(1, 0), RIGHT)
  local thrBg = frame(TK.car, UD2(0, 132, 0, 3), UD2(0, 124, 0, 136), TXT, 0.86)
  TK.thr = frame(thrBg, UD2(0, 0, 1, 0), nil, AMBER, 0)
  TK.arm = panel(hud, UD2(0, 300, 0, 156), UD2(1, -24, 1, -40), V2(1, 1))
  TK.arm.Name = "Weapons"
  TK.rows = weaponRows(TK.arm, 3)
  TK.smoke = label(TK.arm, "", UD2(0, 200, 0, 18), UD2(0, 18, 1, -30), 12, MUTE, MED, nil, LEFT)
  TK.smoke.Name = "Smoke"
  TK.ring = reloadRing(TK.arm, 258, 66)
  -- 坦克的两块面板换成青色全息（用户 11-19 给的截图那样）：边框、角上的亮线、选中那一行、油门条；血量写「当前 / 满」
  for _, pnl in ipairs({ TK.car, TK.arm }) do
    pnl.BackgroundTransparency = 0.32
    for _, c in ipairs(pnl:GetChildren()) do
      if c:IsA("UIStroke") then c.Color, c.Transparency = CYAN, 0.5
      elseif c:IsA("Frame") and c.BackgroundColor3 == TXT and (c.Size.Y.Offset == 2 or c.Size.X.Offset == 2) then c.BackgroundColor3 = CYAN end
    end
  end
  for _, r in ipairs(TK.rows) do r.bar.BackgroundColor3 = CYAN end
  TK.thr.BackgroundColor3 = CYAN
  TK.hp.pct.Size = UD2(0, 110, 0, 14)

  ---------------------------------------------------------------- 坦克（电脑）：MWT 那套（用户 11-19 又发了一遍截图：「确保我开坦克是这个驾驶 ui」）
  --   右下：车名、青色的侧面剪影（挨打闪红、血少变黄 / 红）、血量「当前/满」（当前青色）；最右下：每种武器一个六边形按钮
  --   （弹种缩写 + 炮弹图标，选中的青色发光）；正下方偏右：烟幕弹的青色全息图标（X、剩几发）；
  --   准星（下面 placeTank）：镜头准心一个小圈里「+」、左右两道短刻度；准心左边弹药数、下面「已就绪 / 装填」，右边测距；
  --   炮现在指的地方一个「∧」（颜色 = 打不打得穿）。电脑上开坦克时原来右下两块面板、顶上的罗盘收起（触屏照旧用紧凑读数面板）
  local MW = {}
  local HOLO = RGB(110, 226, 240)
  MW.root = frame(hud, UD2(1, 0, 1, 0), nil, INK, 1)
  MW.root.Name = "MWT"
  MW.root.Visible = false
  -- 右下一块（自己一个 UIScale，贴着右下角缩放）
  MW.br = frame(MW.root, UD2(0, 460, 0, 124), UD2(1, -18, 1, -14), INK, 1, V2(1, 1))
  MW.br.Name = "MwtVehicle"
  MW.brScale = Instance.new("UIScale")
  MW.brScale.Parent = MW.br
  -- 六边形（尖朝上）：外接圆半径 R——三块转 0 / 60 / 120° 的长方形拼成实心的底（放在 CanvasGroup 里统一调透明，叠的地方不发黑），六条边描边
  local function hexagon(parent, cx, cy, R)
    local o = {}
    o.box = frame(parent, UD2(0, R * 2, 0, R * 2), UD2(0, cx, 0, cy), INK, 1, V2(0.5, 0.5))
    local cg = Instance.new("CanvasGroup")
    cg.Size, cg.BackgroundTransparency = UD2(1, 0, 1, 0), 1
    cg.Parent = o.box
    o.fillGroup = cg
    o.fills = {}
    for i, a in ipairs({ 0, 60, 120 }) do
      local f = frame(cg, UD2(0, R * 1.732, 0, R), UD2(0.5, 0, 0.5, 0), INK, 0, V2(0.5, 0.5))
      f.Rotation = a
      o.fills[i] = f
    end
    o.edges = {}
    for k = 0, 5 do
      local a0, a1 = math.rad(90 + k * 60), math.rad(150 + k * 60)
      local x0, y0, x1, y1 = math.cos(a0) * R, -math.sin(a0) * R, math.cos(a1) * R, -math.sin(a1) * R
      local e = frame(o.box, UD2(0, R + 1, 0, 2), UD2(0.5, (x0 + x1) / 2, 0.5, (y0 + y1) / 2), TXT, 0, V2(0.5, 0.5))
      e.Rotation = math.deg(math.atan2(y1 - y0, x1 - x0))
      o.edges[k + 1] = e
    end
    return o
  end
  -- 炮弹图标：斜着的弹体 + 弹头
  local function shellIcon(parent, cx, cy, len)
    local o = {}
    o.body = roundf(frame(parent, UD2(0, 6, 0, len), UD2(0, cx, 0, cy), TXT, 0, V2(0.5, 0.5)), UD(0, 2))
    o.body.Rotation = 40
    local rad = math.rad(40)
    o.tip = roundf(frame(parent, UD2(0, 6, 0, 8), UD2(0, cx + math.sin(rad) * (len / 2 + 3), 0, cy - math.cos(rad) * (len / 2 + 3)), TXT, 0, V2(0.5, 0.5)))
    o.tip.Rotation = 40
    return o
  end
  MW.hex = {}
  local HEX_R = 32
  for i = 1, 3 do
    local R = HEX_R
    local h = hexagon(MW.br, 460 - R, 124 - R - 2, R)   -- 横着摆在哪：stepTank 按这辆车有几种武器靠右排
    h.box.Name = "Ammo" .. i
    h.icon = shellIcon(h.box, R, R - 4, 22)
    h.key = label(h.box, "", UD2(0, 16, 0, 14), UD2(0.5, -R * 0.5, 0.5, -R * 0.62), 11, MUTE, BOLD)
    h.tag = label(h.box, "", UD2(0, R * 1.6, 0, 12), UD2(0.5, 4, 0.5, R * 0.5), 10, MUTE, BOLD, V2(0.5, 0.5))
    h.tag.Rotation = -20
    MW.hex[i] = h
  end
  -- 车名、剪影、血量（六边形左边）
  MW.veh = frame(MW.br, UD2(0, 190, 0, 112), UD2(0, 0, 0, 6), INK, 1)
  MW.veh.Name = "MwtHull"
  MW.name = label(MW.veh, "", UD2(1, 0, 0, 20), UD2(0, 0, 0, 0), 16, TXT, BOLD)
  MW.name.Name = "VehName"
  MW.name.TextStrokeTransparency = 0.6
  MW.sil = frame(MW.veh, UD2(0, 170, 0, 50), UD2(0.5, 0, 0, 24), INK, 1, V2(0.5, 0))
  MW.sil.Name = "Silhouette"
  MW.silParts = {}
  -- 侧面剪影（炮口朝右）：负重轮那一条、车体、首上斜面、炮塔、炮塔尾舱、车长塔、炮管、炮口
  for _, b in ipairs({ { 14, 31, 112, 14, 7, 0 }, { 6, 24, 124, 10, 2, 0 }, { 118, 21, 20, 9, 2, -24 }, { 44, 12, 52, 13, 3, 0 },
    { 34, 14, 14, 9, 2, 0 }, { 54, 6, 12, 7, 2, 0 }, { 94, 16, 70, 3, 1, 0 }, { 160, 14, 8, 6, 1, 0 } }) do
    local f = roundf(frame(MW.sil, UD2(0, b[3], 0, b[4]), UD2(0, b[1], 0, b[2]), HOLO, 0.08), UD(0, b[5]))
    f.Rotation = b[6]
    table.insert(MW.silParts, f)
  end
  for i = 0, 5 do   -- 负重轮：深色小圆点压在那一条上
    table.insert(MW.silParts, roundf(frame(MW.sil, UD2(0, 9, 0, 9), UD2(0, 26 + i * 18, 0, 33.5), INK, 0.35)))
  end
  MW.hp = label(MW.veh, "", UD2(1, 0, 0, 22), UD2(0, 0, 0, 80), 17, TXT, BOLD)
  MW.hp.Name = "HullHp"
  MW.hp.RichText = true
  MW.hp.TextStrokeTransparency = 0.6
  -- 正下方偏右：烟幕弹的全息图标
  MW.sm = frame(MW.root, UD2(0, 60, 0, 70), UD2(0.5, 70, 1, -16), INK, 1, V2(0.5, 1))
  MW.sm.Name = "MwtSmoke"
  MW.smScale = Instance.new("UIScale")
  MW.smScale.Parent = MW.sm
  MW.smCan = roundf(frame(MW.sm, UD2(0, 24, 0, 34), UD2(0.5, 0, 0, 16), INK, 0.6, V2(0.5, 0)), UD(0, 5))
  MW.smCan.Rotation = -16
  MW.smStroke = stroke(MW.smCan, HOLO, 2, 0)
  MW.smCap = frame(MW.smCan, UD2(0, 10, 0, 7), UD2(0.5, 0, 0, -6), HOLO, 0, V2(0.5, 0))
  MW.smPin = frame(MW.smCan, UD2(0, 2, 0, 12), UD2(0.5, 5, 0, -14), HOLO, 0, V2(0.5, 0))
  MW.smWin = frame(MW.smCan, UD2(0, 10, 0, 12), UD2(0.5, 0, 0.5, 2), HOLO, 0.55, V2(0.5, 0.5))
  MW.smTxt = label(MW.sm, "", UD2(1, 20, 0, 14), UD2(0.5, 0, 1, -2), 12, HOLO, BOLD, V2(0.5, 1))
  MW.smTxt.Name = "SmokeLeft"
  MW.smTxt.TextStrokeTransparency = 0.6
  ---------------------------------------------------------------- 3A：抗锯齿的图（HudArt 解的 HudIcons，用户 11-19：「像素感太强，我要 3A 级别的 UI」）
  --   车：原模型正侧面拍的全息图（带柔光晕），按车型换；六边形的底 / 边 / 光晕、炮弹 / 机枪弹、烟幕弹都是 4 倍超采样画的图。
  --   用不了 EditableImage 时（游戏设置 → 安全里没打开 Mesh / Image API）退回上面方块拼的
  local function img(parent, name, size, pos, anchor, color, tr)
    local l = Instance.new("ImageLabel")
    l.Name = name
    l.BackgroundTransparency = 1
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.ImageColor3 = color or WHITE
    l.ImageTransparency = tr or 0
    l.Parent = parent
    return l
  end
  local function art(label, name) return G.hudIconOn ~= nil and G.hudIconOn(label, name) == true end
  MW.icon = img(MW.veh, "HoloIcon", UD2(0, 156, 0, 54), UD2(0.5, 0, 0, 24), V2(0.5, 0), HOLO)
  MW.icon.Visible = false
  for _, h in ipairs(MW.hex) do
    local R2 = HEX_R * 2
    h.iFill = img(h.box, "HexFill", UD2(0, R2, 0, R2 * 80 / 72), UD2(0.5, 0, 0.5, 0), V2(0.5, 0.5), INK, 0.35)
    h.iGlow = img(h.box, "HexGlow", UD2(0, R2, 0, R2 * 80 / 72), UD2(0.5, 0, 0.5, 0), V2(0.5, 0.5), HOLO, 0.15)
    h.iEdge = img(h.box, "HexEdge", UD2(0, R2, 0, R2 * 80 / 72), UD2(0.5, 0, 0.5, 0), V2(0.5, 0.5), MUTE, 0)
    h.iIcon = img(h.box, "AmmoIcon", UD2(0, 30, 0, 30), UD2(0.5, 0, 0.5, -6), V2(0.5, 0.5), MUTE, 0)
    h.art = art(h.iFill, "hexFill") and art(h.iGlow, "hexGlow") and art(h.iEdge, "hexEdge")
    h.iFill.ZIndex, h.iGlow.ZIndex, h.iEdge.ZIndex, h.iIcon.ZIndex = 1, 2, 3, 4
    h.key.ZIndex, h.tag.ZIndex = 5, 5
    h.fillGroup.Visible = not h.art
    for _, e in ipairs(h.edges) do e.Visible = not h.art end
    h.icon.body.Visible, h.icon.tip.Visible = not h.art, not h.art
    h.iFill.Visible, h.iGlow.Visible, h.iEdge.Visible, h.iIcon.Visible = h.art, h.art, h.art, h.art
  end
  MW.smImg = img(MW.sm, "SmokeIcon", UD2(0, 46, 0, 52), UD2(0.5, 0, 0, 2), V2(0.5, 0), HOLO, 0)
  MW.smArt = art(MW.smImg, "smoke")
  MW.smImg.Visible = MW.smArt
  MW.smCan.Visible = not MW.smArt
  -- 弹种缩写（六边形里）：主炮穿甲弹 APFSDS、机炮 HEI、机枪 MG、火炮 HE
  local function ammoTag(w)
    if not w then return "" end
    if w.kind == "shell" then return ((w.dmg or 0) >= 300) and "APFSDS" or "HEI" end
    if w.kind == "gun" then return "MG" end
    if w.kind == "arty" then return "HE" end
    return string.upper(string.sub(w.kind or "", 1, 3))
  end

  ---------------------------------------------------------------- 舰艇：舰况、武器
  local SH = {}
  SH.car = panel(hud, UD2(0, 296, 0, 156), UD2(1, -334, 1, -40), V2(1, 1))   -- 比坦克的宽一点：右边放车钟梯子
  SH.car.Name = "Ship"
  SH.name = label(SH.car, "", UD2(1, -20, 0, 18), UD2(0, 12, 0, 8), 14, TXT, MED, nil, LEFT)
  SH.name.Name = "ShipName"
  local ssil = silBase(SH.car, 60, 94)
  SH.hull = frame(ssil, UD2(0, 90, 0, 90), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SH.hull.Name = "Hull"
  SH.body = frame(SH.hull, UD2(0, 12, 0, 70), UD2(0.5, 0, 0.5, 4), RGB(30, 36, 40), 0.15, V2(0.5, 0.5))
  SH.bodyStroke = stroke(SH.body, OK, 1.5, 0)
  SH.bow = frame(SH.hull, UD2(0, 9, 0, 9), UD2(0.5, 0, 0.5, -31), RGB(30, 36, 40), 0.15, V2(0.5, 0.5))   -- 舰首：转 45° 的小方块
  SH.bow.Rotation = 45
  SH.bowStroke = stroke(SH.bow, OK, 1.5, 0)
  SH.turrets = {}
  SH.hp = hpBlock(SH.car, 124, 34)
  SH.kn = label(SH.car, "0", UD2(0, 70, 0, 40), UD2(0, 124, 0, 62), 36, TXT, BOLD, nil, LEFT)
  SH.kn.Name = "Knots"
  label(SH.car, "kn", UD2(0, 20, 0, 14), UD2(0, 124, 0, 100), 11, MUTE, MED, nil, LEFT)
  SH.order = label(SH.car, "", UD2(0, 90, 0, 14), UD2(0, 150, 0, 100), 11, AMBER, MED, nil, LEFT)
  SH.order.Name = "Order"
  -- 车钟梯子：−2 … 5 八格（上面是前进），亮的是现在这一档；「停」那一格白框
  SH.ladder = {}
  for o = -2, 5 do
    local y = 34 + (5 - o) * 11
    local c = frame(SH.car, UD2(0, 18, 0, 8), UD2(1, -30, 0, y), TXT, 0.85)
    if o == 0 then stroke(c, WHITE, 1, 0.3) end
    SH.ladder[o] = c
  end
  -- 舵角条：左右 35°
  local rBg = frame(SH.car, UD2(0, 132, 0, 3), UD2(0, 124, 0, 136), TXT, 0.86)
  frame(rBg, UD2(0, 1, 0, 9), UD2(0.5, 0, 0.5, 0), TXT, 0.3, V2(0.5, 0.5))
  SH.rud = frame(rBg, UD2(0, 4, 0, 11), UD2(0.5, 0, 0.5, 0), AMBER, 0, V2(0.5, 0.5))
  SH.rud.Name = "Rudder"
  SH.rudTxt = label(SH.car, "", UD2(0, 90, 0, 14), UD2(0, 124, 0, 118), 11, MUTE, MED, nil, LEFT)
  SH.hdg = label(SH.car, "", UD2(0, 70, 0, 14), UD2(1, -38, 0, 118), 11, MUTE, MONO, V2(1, 0), RIGHT)
  SH.arm = panel(hud, UD2(0, 300, 0, 156), UD2(1, -24, 1, -40), V2(1, 1))
  SH.arm.Name = "ShipWeapons"
  SH.rows = weaponRows(SH.arm, 4)
  SH.ring = reloadRing(SH.arm, 258, 66)
  SH.def = nil

  -- 小屏读数单独排版，避免把固定面板的字一起缩小。
  local MS = {}
  MS.box = panel(hud, UD2(0, 330, 0, 72), nil)
  MS.box.Name = "CompactInstruments"
  MS.box.Visible = false
  MS.speed = label(MS.box, "", UD2(0, 90, 0, 28), UD2(0, 10, 0, 3), 20, TXT, BOLD, nil, LEFT)
  MS.motion = label(MS.box, "", UD2(0, 90, 0, 16), UD2(0, 10, 0, 32), 12, TXT, MED, nil, LEFT)
  MS.heading = label(MS.box, "", UD2(0, 90, 0, 14), UD2(0, 10, 0, 50), 11, MUTE, MONO, nil, LEFT)
  MS.split = frame(MS.box, UD2(0, 1, 1, -16), nil, TXT, 0.82)
  MS.selection = label(MS.box, "", UD2(), nil, 13, TXT, BOLD, nil, LEFT)
  MS.count = label(MS.box, "", UD2(), nil, 12, TXT, MONO, nil, LEFT)
  MS.status = label(MS.box, "", UD2(0, 54, 0, 16), UD2(1, -8, 0, 24), 12, OK, BOLD, V2(1, 0), RIGHT)
  MS.health = label(MS.box, "", UD2(), nil, 11, MUTE, MED, nil, LEFT)
  MS.track = frame(MS.box, UD2(), nil, TXT, 0.82)
  MS.fill = frame(MS.track, UD2(0, 0, 1, 0), nil, OK, 0)
  MS.speed.Name, MS.motion.Name, MS.heading.Name = "Speed", "DriveState", "Heading"
  MS.selection.Name, MS.status.Name, MS.health.Name = "Selection", "Readiness", "Hull"
  MS.count.Name = "Ammo"
  for _, l in ipairs({ MS.speed, MS.motion, MS.selection, MS.count, MS.health }) do
    l.TextTruncate = Enum.TextTruncate.AtEnd
  end

  local function updateCompact(name, speed, motion, heading, hp, k, col, row, relK, ready, left)
    if not MS.box.Visible then return end
    local selected = row and row.name.Visible
    MS.speed.Text, MS.motion.Text, MS.heading.Text = speed, motion, heading
    MS.selection.Text = selected and row.name.Text or name
    MS.count.Text = selected and (string.gsub(row.ammo.Text, " / ", "/")) or ""
    MS.count.TextColor3 = selected and row.ammo.TextColor3 or TXT
    MS.status.Text = selected and (ready and T("vh.ready") or string.format("%.1fs", left)) or ""
    MS.status.TextColor3 = ready and OK or AMBER
    MS.health.Text, MS.health.TextColor3 = hp .. "  " .. string.format("%d%%", math.floor(k * 100 + 0.5)), col
    MS.track.Visible = selected == true
    MS.fill.BackgroundColor3 = ready and OK or AMBER
    MS.fill.Size = UD2(relK, 0, 1, 0)
  end

  local function buildShip(d)   -- 换船了：舰体长宽、炮塔的位置
    SH.def = d
    for _, t in ipairs(SH.turrets) do t.box:Destroy() end
    SH.turrets = {}
    local L, Wd = d.L or 200, d.W or 30
    local len = 70
    local wid = math.clamp(len * Wd / L * 1.6, 8, 22)   -- 窄长的舰体看着太细：宽度放大一点
    SH.body.Size = UD2(0, wid, 0, len)
    SH.bow.Size = UD2(0, wid * 0.72, 0, wid * 0.72)
    SH.bow.Position = UD2(0.5, 0, 0.5, 4 - len / 2)
    for gi, g in ipairs(d.guns or {}) do
      local z = g.pos and g.pos.Z or 0
      local x = g.pos and g.pos.X or 0
      local box = frame(SH.hull, UD2(0, 30, 0, 30), UD2(0.5, x / Wd * wid, 0.5, 4 + z / L * len), INK, 1, V2(0.5, 0.5))
      stroke(roundf(frame(box, UD2(0, 7, 0, 7), UD2(0.5, 0, 0.5, 0), RGB(46, 54, 58), 0, V2(0.5, 0.5))), CYAN, 1.2, 0)
      frame(box, UD2(0, 2, 0, 12), UD2(0.5, 0, 0.5, 0), CYAN, 0, V2(0.5, 1))
      SH.turrets[gi] = { box = box }
    end
  end

  ---------------------------------------------------------------- 顶上：罗盘（坦克、舰艇共用）
  local compGroup = frame(hud, UD2(0, 560, 0, 51), nil, INK, 1)
  compGroup.Name = "Compass"
  local comp = frame(compGroup, UD2(1, 0, 0, 38), nil, INK, 1)
  comp.ClipsDescendants = true
  local compBg = frame(comp, UD2(1, 0, 0, 22), UD2(0, 0, 0, 0), INK, 0.55)
  grad(compBg, 0, nseq(0, 1, 0.18, 0.45, 0.82, 0.45, 1, 1))
  local PX, CW = 4, 560   -- 每度几个像素、罗盘宽
  local ticks = {}
  for i = 1, 40 do
    ticks[i] = { t = frame(comp, UD2(0, 1, 0, 6), UD2(0, 0, 0, 0), TXT, 0.35), l = label(comp, "", UD2(0, 30, 0, 14), UD2(0, 0, 0, 7), 11, TXT, MONO, V2(0.5, 0)) }
  end
  label(compGroup, "▼", UD2(0, 16, 0, 12), UD2(0.5, 0, 0, 18), 11, TXT, BOLD, V2(0.5, 0))
  local compHdg = label(compGroup, "000", UD2(0, 60, 0, 18), UD2(0.5, 0, 0, 32), 15, TXT, MONO, V2(0.5, 0))
  compHdg.Name = "Heading"
  local compMark = label(comp, "▲", UD2(0, 14, 0, 10), UD2(0.5, 0, 0, 24), 10, AMBER, BOLD, V2(0.5, 0))
  compMark.Name = "MarkHeading"
  local DIR = { [0] = "N", [45] = "NE", [90] = "E", [135] = "SE", [180] = "S", [225] = "SW", [270] = "W", [315] = "NW" }
  local function deg360(r) return (math.deg(r) % 360 + 360) % 360 end
  local function hdgOf(yaw) return (360 - deg360(yaw or 0)) % 360 end   -- 偏航（逆时针、从 −Z 起）→ 航向（顺时针从北）
  local function stepCompass(camHdg, markHdg)
    if not compGroup.Visible then return end
    local first = math.floor((camHdg - CW / 2 / PX) / 5) * 5
    for i, tk in ipairs(ticks) do
      local a = first + (i - 1) * 5
      local x = CW / 2 + (a - camHdg) * PX
      local aa = a % 360
      local major = aa % 15 == 0
      tk.t.Position = UD2(0, x, 0, 0)
      tk.t.Size = UD2(0, 1, 0, major and 8 or 4)
      tk.l.Position = UD2(0, x, 0, 8)
      tk.l.Text = major and (DIR[aa] or string.format("%03d", aa)) or ""
      tk.l.TextColor3 = DIR[aa] and TXT or MUTE
    end
    compHdg.Text = string.format("%03d", math.floor(camHdg + 0.5) % 360)
    local dg = (markHdg - camHdg + 540) % 360 - 180
    compMark.Position = UD2(0, CW / 2 + math.clamp(dg, -CW / 2 / PX, CW / 2 / PX) * PX, 0, 24)
  end

  ---------------------------------------------------------------- 中间：准星——坦克照 MWT（现代战争坦克）、舰艇照《现代战舰》，两套样子
  --   用户 11-19：「船、坦克的准心可以不一样，参考 MWT 和现代战舰」
  local camAim = roundf(frame(ret, UD2(0, 14, 0, 14), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5)))
  stroke(camAim, WHITE, 1.5, 0.35)
  camAim.Name = "CamAim"
  local Config = require(RS:WaitForChild("Config"))
  -- 圆上一圈小短条（Roblox 没有弧线）：from / to 度数（0 正上、顺时针），每条切着圆
  local function arcSegs(parent, n, r, w, h, from, to, col)
    local segs = {}
    for i = 1, n do
      local a = from + (to - from) * (i - 0.5) / n
      local rad = math.rad(a)
      local sg0 = frame(parent, UD2(0, w, 0, h), UD2(0.5, math.sin(rad) * r, 0.5, -math.cos(rad) * r), col or TXT, 0, V2(0.5, 0.5))
      sg0.Rotation = a
      segs[i] = sg0
    end
    return segs
  end
  local PEN_OK, PEN_MAYBE, PEN_NO = RGB(96, 236, 128), RGB(255, 214, 72), RGB(255, 72, 60)

  -- 坦克（MWT）：四段弧（对角留缺口）围着炮指的点，装填时顺时针一段段亮起来；弧的颜色 = 打不打得穿（绿 / 黄 / 红，没瞄着车是白的）；
  --   左、右、下三道刻度，中心一个点；下面一行「可击穿 / 可能跳弹 / 跳弹 / 打不穿」，右边测距、左边装填秒数
  local mwtOn = false   -- 电脑上开坦克：MWT 那套（帧函数里按 compact 定）
  local TR = {}
  TR.root = frame(ret, UD2(0, 120, 0, 120), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  TR.root.Name = "TankReticle"
  TR.scale = Instance.new("UIScale")
  TR.scale.Parent = TR.root
  TR.segs = {}
  for q = 0, 3 do
    for _, sgx in ipairs(arcSegs(TR.root, 9, 22, 3.4, 2, q * 90 - 33, q * 90 + 33)) do table.insert(TR.segs, sgx) end
  end
  TR.ticks = {}
  for _, a in ipairs({ 90, 180, 270 }) do
    local rad = math.rad(a)
    local tk = frame(TR.root, UD2(0, 2, 0, 9), UD2(0.5, math.sin(rad) * 32, 0.5, -math.cos(rad) * 32), TXT, 0, V2(0.5, 0.5))
    tk.Rotation = a
    table.insert(TR.ticks, tk)
  end
  TR.dot = roundf(frame(TR.root, UD2(0, 3, 0, 3), UD2(0.5, 0, 0.5, 0), TXT, 0, V2(0.5, 0.5)))
  TR.pen = label(TR.root, "", UD2(0, 160, 0, 14), UD2(0.5, 0, 0.5, 46), 12, TXT, BOLD, V2(0.5, 0.5))
  TR.pen.Name = "PenState"
  TR.pen.TextStrokeTransparency = 0.55
  TR.rng = label(TR.root, "", UD2(0, 80, 0, 14), UD2(0.5, 42, 0.5, 0), 12, TXT, MONO, V2(0, 0.5), LEFT)
  TR.rng.Name = "Range"
  TR.rng.TextStrokeTransparency = 0.6
  TR.rel = label(TR.root, "", UD2(0, 60, 0, 14), UD2(0.5, -42, 0.5, 0), 12, AMBER, MONO, V2(1, 0.5), RIGHT)
  TR.rel.Name = "ReloadLeft"
  TR.rel.TextStrokeTransparency = 0.6
  TR.rel.Visible = false   -- 用户 11-19（截图）：左边改成弹药数 + 状态（下面两行）
  -- 准星左边：弹药数（大）、状态（已就绪 / 装填 x.x 秒）；青色全息（用户 11-19 给的手机坦克游戏截图那样）
  TR.ammo = label(TR.root, "", UD2(0, 90, 0, 22), UD2(0.5, -46, 0.5, -9), 20, TXT, MONO, V2(1, 0.5), RIGHT)
  TR.ammo.Name = "AmmoLeft"
  TR.ammo.TextStrokeTransparency = 0.55
  TR.state = label(TR.root, "", UD2(0, 110, 0, 16), UD2(0.5, -46, 0.5, 11), 13, CYAN, BOLD, V2(1, 0.5), RIGHT)
  TR.state.Name = "ReadyState"
  TR.state.TextStrokeTransparency = 0.6
  TR.chev = {   -- MWT：炮指的地方一个「∧」（两道斜线，顶点在这一点上方一点）
    frame(TR.root, UD2(0, 11, 0, 2), UD2(0.5, -3.6, 0.5, 2.2), TXT, 0, V2(0.5, 0.5)),
    frame(TR.root, UD2(0, 11, 0, 2), UD2(0.5, 3.6, 0.5, 2.2), TXT, 0, V2(0.5, 0.5)),
  }
  TR.chev[1].Rotation, TR.chev[2].Rotation = -52, 52
  do   -- 有抗锯齿的图就用图（转了角度的细方块边缘有锯齿）
    local l = Instance.new("ImageLabel")
    l.Name = "Chevron"
    l.BackgroundTransparency = 1
    l.Size, l.Position, l.AnchorPoint = UD2(0, 24, 0, 16), UD2(0.5, 0, 0.5, 1), V2(0.5, 0.5)
    l.Parent = TR.root
    if G.hudIconOn and G.hudIconOn(l, "chevron") then TR.chevImg = l else l:Destroy() end
  end
  local lagArrow = label(ret, "▶", UD2(0, 16, 0, 16), UD2(0, 0, 0, 0), 13, AMBER, BOLD, V2(0.5, 0.5))
  lagArrow.Name = "TurretLag"
  -- MWT（电脑开坦克）：镜头准心小圈里一个「+」、左右两道短刻度；准心左边弹药数（前面一颗小炮弹）、下面「已就绪 / 装填」，右边测距；
  --   炮现在指的地方一个「∧」（TR.root 的位置，颜色 = 打不打得穿）。触屏照旧用上面那套
  local MR = {}
  MR.plus = {
    frame(camAim, UD2(0, 8, 0, 1.5), UD2(0.5, 0, 0.5, 0), WHITE, 0.15, V2(0.5, 0.5)),
    frame(camAim, UD2(0, 1.5, 0, 8), UD2(0.5, 0, 0.5, 0), WHITE, 0.15, V2(0.5, 0.5)),
  }
  MR.ticks = {
    frame(ret, UD2(0, 2, 0, 8), UD2(0.5, -54, 0.5, 0), WHITE, 0.3, V2(0.5, 0.5)),
    frame(ret, UD2(0, 2, 0, 8), UD2(0.5, 54, 0.5, 0), WHITE, 0.3, V2(0.5, 0.5)),
  }
  MR.ammo = label(ret, "", UD2(0, 80, 0, 22), UD2(0.5, -76, 0.5, -14), 19, TXT, BOLD, V2(1, 0.5), RIGHT)
  MR.ammo.Name = "MwtAmmo"
  MR.ammo.TextStrokeTransparency = 0.55
  MR.bullet = roundf(frame(ret, UD2(0, 4, 0, 11), UD2(0.5, -120, 0.5, -14), TXT, 0.05, V2(0.5, 0.5)), UD(0, 2))   -- 弹药数前面的小炮弹（stepTank 按位数挪）
  MR.state = label(ret, "", UD2(0, 140, 0, 24), UD2(0.5, -76, 0.5, 12), 20, CYAN, BOLD, V2(1, 0.5), RIGHT)
  MR.state.Name = "MwtState"
  MR.state.TextStrokeTransparency = 0.55
  MR.rng = label(ret, "", UD2(0, 120, 0, 22), UD2(0.5, 86, 0.5, -14), 19, TXT, BOLD, V2(0, 0.5), LEFT)
  MR.rng.Name = "MwtRange"
  MR.rng.TextStrokeTransparency = 0.55
  do
    local l = Instance.new("ImageLabel")
    l.Name = "BulletIcon"
    l.BackgroundTransparency = 1
    l.Size, l.Position, l.AnchorPoint = UD2(0, 7, 0, 16), MR.bullet.Position, V2(0.5, 0.5)
    l.ImageColor3 = TXT
    l.Parent = ret
    if G.hudIconOn and G.hudIconOn(l, "bullet") then
      MR.bullet:Destroy()
      MR.bullet = l
    else l:Destroy() end
  end
  MR.all = { MR.ticks[1], MR.ticks[2], MR.ammo, MR.bullet, MR.state, MR.rng }

  -- 舰艇（《现代战舰》）：主炮落点一个细的大圈、四根长线（横线上有刻度）、中间菱形；外圈 40 段装填；右下距离、炮弹飞多久，左下炮名；
  --   瞄着的敌人：上方一张卡（名字、距离、血条），照它的航速和炮弹飞的时间算提前量（琥珀色小圈 + 一串点连过去）；
  --   导弹：四个角框住目标，刚框上从大往小收，框住琥珀、锁定红，下面写距离和导弹飞过去要多久
  local SR = {}
  SR.root = frame(ret, UD2(0, 240, 0, 240), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SR.root.Name = "ShipReticle"
  SR.scale = Instance.new("UIScale")
  SR.scale.Parent = SR.root
  SR.ring = roundf(frame(SR.root, UD2(0, 76, 0, 76), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5)))
  SR.ringStroke = stroke(SR.ring, CYAN, 1.2, 0.1)
  SR.lines = {}
  for _, e in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
    local hz = e[1] ~= 0
    local L0, L = 46, 40
    table.insert(SR.lines, frame(SR.root, hz and UD2(0, L, 0, 1) or UD2(0, 1, 0, L), UD2(0.5, e[1] * (L0 + L / 2), 0.5, e[2] * (L0 + L / 2)), CYAN, 0.15, V2(0.5, 0.5)))
    if hz then
      for k = 1, 4 do table.insert(SR.lines, frame(SR.root, UD2(0, 1, 0, (k % 2 == 0) and 7 or 4), UD2(0.5, e[1] * (L0 + k * 9), 0.5, 0), CYAN, 0.2, V2(0.5, 0.5))) end
    end
  end
  SR.dia = frame(SR.root, UD2(0, 9, 0, 9), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SR.dia.Rotation = 45
  SR.diaStroke = stroke(SR.dia, WHITE, 1.5, 0)
  frame(SR.root, UD2(0, 2, 0, 2), UD2(0.5, 0, 0.5, 0), WHITE, 0, V2(0.5, 0.5))
  SR.segs = arcSegs(SR.root, 40, 47, 5.4, 2, 0, 360, CYAN)
  SR.rng = label(SR.root, "", UD2(0, 90, 0, 14), UD2(0.5, 50, 0.5, 30), 12, TXT, MONO, V2(0, 0.5), LEFT)
  SR.rng.Name = "Range"
  SR.tof = label(SR.root, "", UD2(0, 90, 0, 14), UD2(0.5, 50, 0.5, 44), 11, CYAN, MONO, V2(0, 0.5), LEFT)
  SR.tof.Name = "FlightTime"
  SR.wpn = label(SR.root, "", UD2(0, 120, 0, 14), UD2(0.5, -50, 0.5, 30), 11, MUTE, MED, V2(1, 0.5), RIGHT)
  for _, l in ipairs({ SR.rng, SR.tof, SR.wpn }) do l.TextStrokeTransparency = 0.6 end
  SR.lead = roundf(frame(ret, UD2(0, 14, 0, 14), nil, INK, 1, V2(0.5, 0.5)))
  SR.lead.Name = "LeadMark"
  stroke(SR.lead, AMBER, 1.6, 0)
  SR.leadDots = {}
  for i = 1, 6 do SR.leadDots[i] = roundf(frame(ret, UD2(0, 3, 0, 3), nil, AMBER, 0.25, V2(0.5, 0.5))) end
  SR.card = frame(ret, UD2(0, 160, 0, 30), nil, INK, 1, V2(0.5, 1))
  SR.card.Name = "TargetCard"
  SR.cardName = label(SR.card, "", UD2(1, 0, 0, 14), UD2(0, 0, 0, 0), 12, TXT, BOLD)
  SR.cardName.TextStrokeTransparency = 0.55
  SR.cardBg = frame(SR.card, UD2(0, 110, 0, 4), UD2(0.5, 0, 0, 18), INK, 0.35, V2(0.5, 0))
  SR.cardHp = frame(SR.cardBg, UD2(1, 0, 1, 0), nil, BAD, 0)
  SR.lock = frame(ret, UD2(0, 60, 0, 60), nil, INK, 1, V2(0.5, 0.5))
  SR.lock.Name = "MissileLock"
  SR.corners = {}
  for _, c in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
    local h = frame(SR.lock, UD2(0, 14, 0, 2), UD2(c[1], 0, c[2], 0), PEN_MAYBE, 0, V2(c[1], c[2]))
    local v = frame(SR.lock, UD2(0, 2, 0, 14), UD2(c[1], 0, c[2], 0), PEN_MAYBE, 0, V2(c[1], c[2]))
    table.insert(SR.corners, h)
    table.insert(SR.corners, v)
  end
  SR.lockTxt = label(ret, "", UD2(0, 260, 0, 16), nil, 12, PEN_MAYBE, BOLD, V2(0.5, 0))
  SR.lockTxt.Name = "LockText"
  SR.lockTxt.TextStrokeTransparency = 0.5

  local fireCC = Instance.new("ColorCorrectionEffect")
  fireCC.Name = "VehFireFlash"
  fireCC.Brightness = 0
  fireCC.Parent = Lighting
  local kickT = -9

  ---------------------------------------------------------------- 瞄着谁：实体（workspace.Ents 下的模型）、它的航速
  local rayP = RaycastParams.new()
  rayP.FilterType = Enum.RaycastFilterType.Exclude
  local function entOf(inst)
    local ents = workspace:FindFirstChild("Ents")
    while inst and inst.Parent and inst.Parent ~= ents do inst = inst.Parent end
    return (inst and inst.Parent == ents) and inst or nil
  end
  local vel = setmetatable({}, { __mode = "k" })   -- [实体模型] = { p 上次位置, t 时间, v 平滑后的速度 }
  local function velOf(em)
    local r = em:FindFirstChild("Root")
    if not r then return V3(0, 0, 0) end
    local p, t = r.CFrame.Position, os.clock()
    local s = vel[em]
    if not s then
      vel[em] = { p = p, t = t, v = V3(0, 0, 0) }
      return V3(0, 0, 0)
    end
    local dt = t - s.t
    if dt > 0.05 then
      local raw = (p - s.p) / dt
      if raw.Magnitude > 600 then raw = s.v end   -- 瞬移（重生、拉回）不算
      s.v = s.v:Lerp(raw, math.min(1, dt * 4))
      s.p, s.t = p, t
    end
    return s.v
  end
  local function enemyEnt(em)
    if not em or em:GetAttribute("Wreck") or (em:GetAttribute("Hp") or 1) <= 0 then return false end
    local tm = em:GetAttribute("Team")
    return tm ~= nil and tm ~= me:GetAttribute("Side")
  end
  -- 屏幕上离 (x, y) 最近的敌方水面目标 / 地面车辆（R 像素以内）
  local nearT, nearEm = 0, nil
  local function enemyNear(x, y, R)
    if os.clock() - nearT < 0.12 then return nearEm end
    nearT, nearEm = os.clock(), nil
    local ents = workspace:FindFirstChild("Ents")
    local best = R
    for _, em in ipairs(ents and ents:GetChildren() or {}) do
      local cat = em:GetAttribute("Cat")
      if (cat == "ship" or cat == "armor" or cat == "light") and enemyEnt(em) then
        local r = em:FindFirstChild("Root")
        if r then
          local sp, on = cam:WorldToViewportPoint(r.CFrame.Position)
          if on then
            local dd = (V2(sp.X, sp.Y) - V2(x, y)).Magnitude
            if dd < best then best, nearEm = dd, em end
          end
        end
      end
    end
    return nearEm
  end

  -- 坦克炮打过去打不打得穿：照服务器（Ents.lua）的跳弹算法——入射方向和装甲面法线的夹角、目标是重甲（armor）还是轻甲（light）
  --   返回 颜色、字（没瞄着敌方车辆返回 nil）
  local function penState(w, o, p, own)
    local dir = p - o
    if dir.Magnitude < 1 then return nil end
    local ex = { own }
    if me.Character then table.insert(ex, me.Character) end
    if G.viewFolder then table.insert(ex, G.viewFolder) end
    rayP.FilterDescendantsInstances = ex
    local res = workspace:Raycast(o, dir.Unit * (dir.Magnitude + 6), rayP)
    local em = res and entOf(res.Instance)
    if not em or not enemyEnt(em) then return nil end
    local cat = em:GetAttribute("Cat")
    local RIC = Config.Ricochet
    local k = (w.vs and w.vs[cat]) or 1
    if k < 0.35 then return PEN_NO, T("vh.penNo") end   -- 机枪、小口径打重甲
    if w.kind ~= "shell" or not (RIC and RIC.a0[cat]) then return PEN_OK, T("vh.penOk") end
    local ang = math.deg(math.acos(math.clamp(math.abs(dir.Unit:Dot(res.Normal)), 0, 1)))
    local pr = math.clamp((ang - RIC.a0[cat]) / math.max(1, RIC.a1[cat] - RIC.a0[cat]), 0, 1)
    if pr >= 0.75 then return PEN_NO, T("vh.penRic") end
    if pr > 0.04 or ang > RIC.a0[cat] - 6 then return PEN_MAYBE, T("vh.penMaybe", math.floor(pr * 100 + 0.5)) end
    return (k < 0.7) and PEN_MAYBE or PEN_OK, T((k < 0.7) and "vh.penWeak" or "vh.penOk")
  end

  -- 坦克的准星摆到屏幕上：p 炮指着的点、o 炮口、relK / ready / left 装填、pen 颜色和字
  local function placeTank(p, o, relK, ready, left, lag, penC, penT, ammoTxt)
    SR.root.Visible, SR.lead.Visible, SR.card.Visible, SR.lock.Visible, SR.lockTxt.Visible = false, false, false, false, false
    for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
    local sp, on = cam:WorldToViewportPoint(p)
    local vp = cam.ViewportSize
    TR.root.Visible = on
    local kick = reducedMotion and 0 or math.clamp(1 - (os.clock() - kickT) / 0.35, 0, 1)
    TR.scale.Scale = 1 + 0.4 * kick
    TR.root.Position = UD2(0, sp.X, 0, sp.Y)
    local col = penC or CYAN   -- 没瞄着车：青色（全息的感觉）
    local lit = ready and #TR.segs or math.floor(relK * #TR.segs + 0.001)
    for i, sgx in ipairs(TR.segs) do
      local onSeg = i <= lit
      sgx.BackgroundColor3 = onSeg and (ready and col or AMBER) or TXT
      sgx.BackgroundTransparency = onSeg and 0.02 or 0.72
    end
    for _, tk in ipairs(TR.ticks) do tk.BackgroundColor3 = col end
    TR.dot.BackgroundColor3 = col
    TR.pen.Text = penT or ""
    TR.pen.TextColor3 = col
    TR.rng.Text = T("vh.m", math.floor((p - o).Magnitude / 2.8 / 5 + 0.5) * 5)
    TR.rel.Text = ready and "" or string.format("%.1f", left)
    TR.ammo.Text = ammoTxt or ""
    TR.state.Text = ready and T("vh.rdy") or T("vh.loading", string.format("%.1f", left))
    TR.state.TextColor3 = ready and CYAN or AMBER
    -- MWT（电脑）：炮指的地方只留「∧」，数字挪到镜头准心两边
    local mw = mwtOn
    for _, sgx in ipairs(TR.segs) do sgx.Visible = not mw end
    for _, tk in ipairs(TR.ticks) do tk.Visible = not mw end
    TR.dot.Visible, TR.pen.Visible, TR.rng.Visible, TR.ammo.Visible, TR.state.Visible = not mw, not mw, not mw, not mw, not mw
    local chevCol = penC or (ready and WHITE or AMBER)
    for _, c in ipairs(TR.chev) do
      c.Visible = mw and TR.chevImg == nil
      c.BackgroundColor3 = chevCol
    end
    if TR.chevImg then
      TR.chevImg.Visible = mw
      TR.chevImg.ImageColor3 = chevCol
    end
    for _, x in ipairs(MR.all) do x.Visible = mw end
    for _, x in ipairs(MR.plus) do x.Visible = mw end
    if mw then
      MR.ammo.Text = ammoTxt or ""
      MR.bullet.Position = UD2(0.5, -76 - #(ammoTxt or "") * 11 - 9, 0.5, -14)
      MR.bullet.Visible = (ammoTxt or "") ~= ""
      MR.state.Text = ready and T("vh.rdy") or T("vh.loading", string.format("%.1f", left))
      MR.state.TextColor3 = ready and CYAN or AMBER
      MR.rng.Text = TR.rng.Text
    end
    local off = V2(vp.X / 2, vp.Y / 2) - V2(sp.X, sp.Y)
    lagArrow.Visible = lag and on and off.Magnitude > 30
    if lagArrow.Visible then
      local u = off.Unit
      lagArrow.Position = UD2(0, sp.X + u.X * 40, 0, sp.Y + u.Y * 40)
      lagArrow.Rotation = math.deg(math.atan2(u.Y, u.X))
    end
    fireCC.Brightness = 0.12 * kick * kick
  end
  G.tankPen = penState   -- 测试用

  local function hideReticles()
    TR.root.Visible, SR.root.Visible, lagArrow.Visible = false, false, false
    for _, x in ipairs(MR.all) do x.Visible = false end
    for _, x in ipairs(MR.plus) do x.Visible = false end
    SR.lead.Visible, SR.card.Visible, SR.lock.Visible, SR.lockTxt.Visible = false, false, false, false
    for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
    fireCC.Brightness = 0
  end

  ---------------------------------------------------------------- 每帧：坦克
  local lastNext, hp0, hurtT = {}, nil, -9
  local function hpColor(em)
    local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
    local k = math.clamp(hp / math.max(mx, 1), 0, 1)
    if hp0 and hp < hp0 - 0.5 then hurtT = os.clock() end
    hp0 = hp
    local col = (k > 0.6) and OK or ((k > 0.3) and AMBER or BAD)
    if os.clock() - hurtT < 0.6 and (reducedMotion or (os.clock() * 10) % 2 < 1) then col = BAD end
    return k, col
  end

  local function stepTank(st)
    local d = st.d
    local vs = G.S and G.S.veh
    TK.name.Text = T("veh." .. d.id)
    TK.hp.lab.Text = T("vh.hull")
    local k, col = hpColor(st.em)
    TK.hullStroke.Color = col
    setHp(TK.hp, k, col)
    TK.hp.pct.Text = string.format("%d / %d", math.floor(st.em:GetAttribute("Hp") or 0), math.floor(st.em:GetAttribute("MaxHp") or 0))
    local camY = math.deg(st.camYaw or 0)
    local hullY = math.deg(st.yaw or 0)
    TK.hull.Rotation = -(hullY - camY)
    TK.tur.Rotation = -(hullY - (st.ty or 0) - camY)
    TK.tur.Visible = d.turret ~= nil
    TK.spd.Text = string.format("%d", math.floor(math.abs(st.speed or 0) / 2.8 * 3.6 + 0.5))
    local back = (st.speed or 0) < -0.4
    local gn = st.gearN or 0   -- Drive 的变速箱：1～5 档、R、N（战雷那样显示档位数字）
    TK.gear.Text = st.locked and "-" or ((gn >= 1) and tostring(gn) or (back and "R" or "N"))
    TK.gear.TextColor3 = back and AMBER or TXT
    TK.hdg.Text = string.format("%03d°  HDG", math.floor(hdgOf(st.yaw) + 0.5) % 360)
    TK.thr.Size = UD2(math.clamp(math.abs(st.speed or 0) / math.max(d.speed or 1, 1), 0, 1), 0, 1, 0)
    local relK, ready, left = 1, true, 0
    local selAmmo = nil
    for i, r in ipairs(TK.rows) do
      local wid = d.weapons[i]
      if wid then
        local w = VD.W[wid]
        local ammo = vs and vs.ammo and vs.ammo[wid]
        setRow(r, tostring(i), T("vw." .. wid), ammo and string.format("%d / %d", ammo[1], ammo[2]) or "∞", i == st.wi, ammo and ammo[1] + ammo[2] == 0)
        if i == st.wi and w then
          selAmmo = ammo and tostring(ammo[1] + ammo[2]) or "∞"
          local l = (st.next[wid] or 0) - os.clock()
          local full = (ammo and ammo[1] == w.mag and l > w.rate) and (w.reload or w.rate) or w.rate
          relK = 1 - math.clamp(l / math.max(full, 0.01), 0, 1)
          ready, left = l <= 0, math.max(0, l)
          if lastNext[wid] and (st.next[wid] or 0) > lastNext[wid] + 0.05 and (w.dmg or 0) > 150 then kickT = os.clock() end
        end
        lastNext[wid] = st.next[wid] or 0
      else
        setRow(r, nil, nil)
      end
    end
    TK.smoke.Text = string.format("X   %s ×%d", T("vh.smoke"), vs and vs.smoke or 0)
    setRing(TK.ring, relK, ready, left)
    if mwtOn then
      -- MWT 右下：车名、剪影（挨打闪红、血少变色）、血量「当前/满」；六边形弹种按钮靠右排；烟幕弹图标
      MW.name.Text = TK.name.Text
      local silCol = (k > 0.6 and col == OK) and HOLO or col
      if MW.iconId ~= d.id then   -- 换了车：换全息图（这辆车拍过的侧面图）；没有就用方块拼的剪影
        MW.iconId = d.id
        local ok = art(MW.icon, "veh_" .. d.id)
        local ic = ok and G.hudIcon("veh_" .. d.id)
        if ic then MW.icon.Size = UD2(0, math.floor(ic.w * 0.62 + 0.5), 0, math.floor(ic.h * 0.62 + 0.5)) end
        MW.icon.Visible = ok
        MW.sil.Visible = not ok
        MW.hp.Position = UD2(0, 0, 0, ok and (24 + (ic and ic.h * 0.62 or 54) - 2) or 80)
      end
      MW.icon.ImageColor3 = silCol
      for i, f in ipairs(MW.silParts) do
        if i <= 8 then f.BackgroundColor3 = silCol end
      end
      local hp, mx = math.floor(st.em:GetAttribute("Hp") or 0), math.floor(st.em:GetAttribute("MaxHp") or 0)
      local hc = (k > 0.6) and HOLO or col
      MW.hp.Text = string.format('<font color="#%02X%02X%02X">%d</font>/%d', math.floor(hc.R * 255), math.floor(hc.G * 255), math.floor(hc.B * 255), hp, mx)
      local n = 0
      for i = 1, #MW.hex do if d.weapons[i] then n = i end end
      if MW.nHex ~= n then
        MW.nHex = n
        for i, h in ipairs(MW.hex) do
          h.box.Visible = i <= n
          h.box.Position = UD2(0, 460 - HEX_R - (n - i) * (HEX_R * 1.732 + 8), 0, 124 - HEX_R - 2)
        end
        local left0 = 460 - HEX_R - (n - 1) * (HEX_R * 1.732 + 8) - HEX_R
        MW.veh.Position = UD2(0, math.max(0, left0 - 200), 0, 6)
      end
      for i = 1, n do
        local h = MW.hex[i]
        local wid = d.weapons[i]
        local w = VD.W[wid]
        local ammo = vs and vs.ammo and vs.ammo[wid]
        local empty = ammo ~= nil and ammo[1] + ammo[2] == 0
        local sel = i == st.wi
        local edge = empty and BAD or (sel and HOLO or MUTE)
        for _, e in ipairs(h.edges) do
          e.BackgroundColor3 = edge
          e.BackgroundTransparency = sel and 0 or 0.35
        end
        for _, f in ipairs(h.fills) do f.BackgroundColor3 = sel and RGB(16, 58, 66) or INK end
        h.fillGroup.GroupTransparency = sel and 0.25 or 0.45
        h.icon.body.BackgroundColor3, h.icon.tip.BackgroundColor3 = sel and HOLO or MUTE, sel and WHITE or MUTE
        h.key.Text = tostring(i)
        h.key.TextColor3 = sel and TXT or MUTE
        h.tag.Text = ammoTag(w)
        h.tag.TextColor3 = sel and HOLO or MUTE
        if h.art then
          h.iFill.ImageColor3, h.iFill.ImageTransparency = sel and RGB(14, 52, 60) or INK, sel and 0.22 or 0.4
          h.iGlow.Visible = sel and not empty
          h.iEdge.ImageColor3, h.iEdge.ImageTransparency = edge, sel and 0 or 0.3
          local ic = (w and w.kind == "gun") and "mg" or "shell"
          if h.iconName ~= ic then h.iconName = ic art(h.iIcon, ic) end
          h.iIcon.ImageColor3 = sel and Color3.new(1, 1, 1):Lerp(HOLO, 0.35) or MUTE
        end
      end
      local sm = vs and vs.smoke or 0
      MW.smTxt.Text = string.format("X  ×%d", sm)
      local dim = sm <= 0
      MW.smStroke.Transparency = dim and 0.65 or 0
      MW.smCap.BackgroundTransparency = dim and 0.65 or 0
      MW.smPin.BackgroundTransparency = dim and 0.65 or 0
      MW.smWin.BackgroundTransparency = dim and 0.85 or 0.55
      MW.smTxt.TextTransparency = dim and 0.5 or 0
      MW.smImg.ImageTransparency = dim and 0.62 or 0
    end
    local gear = TK.gear.Text
    updateCompact(TK.name.Text, TK.spd.Text .. " km/h", tonumber(gear) and ("D" .. gear) or gear, TK.hdg.Text,
      TK.hp.lab.Text, k, col, TK.rows[st.wi], relK, ready, left)
    stepCompass(hdgOf(st.camYaw), hdgOf((st.yaw or 0) - math.rad(st.ty or 0)))
    local hasGun = d.turret ~= nil and d.gun ~= nil and d.weapons[1] ~= nil
    if not hasGun then
      hideReticles()
      return
    end
    local base = st.root * CFrame.new(0, -d.H / 2, 0)
    local gcf = VD.gunCF(d, base, st.ty or 0, st.gp or 0)
    local aim = st.aimPt or (gcf.Position + gcf.LookVector * 200)
    local pt = gcf.Position + gcf.LookVector * math.max(30, (aim - gcf.Position).Magnitude)
    local wid = d.weapons[st.wi]
    local w = wid and VD.W[wid]
    local penC, penT = nil, nil
    if w then penC, penT = penState(w, gcf.Position, pt, st.em) end
    placeTank(pt, gcf.Position, relK, ready, left, true, penC, penT, selAmmo)
    if G.tankHudExtra then G.tankHudExtra(st, k) end   -- 敌人头顶的名字和距离、「被发现」、爆反 / 主动防御的状态（TankHud.lua）
  end

  -- 舰艇主炮的准星：p 落点、o 炮口、tof 炮弹飞多久；瞄着的敌人：目标卡 + 提前量
  local function placeShip(p, o, relK, ready, left, tof, wname)
    local sp, on = cam:WorldToViewportPoint(p)
    SR.root.Visible = on
    local kick = reducedMotion and 0 or math.clamp(1 - (os.clock() - kickT) / 0.35, 0, 1)
    SR.scale.Scale = 1 + 0.25 * kick
    SR.root.Position = UD2(0, sp.X, 0, sp.Y)
    local col = ready and CYAN or AMBER
    SR.ringStroke.Color = col
    for _, l in ipairs(SR.lines) do l.BackgroundColor3 = col end
    local lit = ready and #SR.segs or math.floor(relK * #SR.segs + 0.001)
    for i, sgx in ipairs(SR.segs) do
      sgx.BackgroundColor3 = ready and CYAN or AMBER
      sgx.BackgroundTransparency = (i <= lit) and (ready and 0.35 or 0.02) or 0.8
    end
    local km = (p - o).Magnitude / 2.8 / 1000
    SR.rng.Text = (km >= 1) and string.format("%.1f km", km) or string.format("%d m", math.floor(km * 1000 / 5 + 0.5) * 5)
    SR.tof.Text = ready and string.format("T %.1f s", tof or 0) or string.format("%s %.1f", T("vh.reload"), left)
    SR.tof.TextColor3 = ready and CYAN or AMBER
    SR.wpn.Text = wname or ""
    fireCC.Brightness = 0.1 * kick * kick
    -- 瞄着的敌人（落点附近 90 像素内最近的）
    local em = on and enemyNear(sp.X, sp.Y, 90) or nil
    local r = em and em:FindFirstChild("Root")
    if not r then
      SR.card.Visible, SR.lead.Visible = false, false
      for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
      return
    end
    local tp = r.CFrame.Position
    local tsp, ton = cam:WorldToViewportPoint(tp)
    local size = r.Size.Magnitude
    local top = cam:WorldToViewportPoint(tp + V3(0, r.Size.Y * 0.5 + size * 0.06, 0))
    SR.card.Visible = ton
    SR.card.Position = UD2(0, tsp.X, 0, top.Y - 8)
    local key = "veh." .. tostring(em:GetAttribute("Model") or em:GetAttribute("Kind") or "")
    SR.cardName.Text = string.format("%s   %.1f km", T(key), (tp - o).Magnitude / 2800)
    local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
    SR.cardHp.Size = UD2(math.clamp(hp / math.max(1, mx), 0, 1), 0, 1, 0)
    -- 提前量：炮弹落下去的时候它开到哪
    local v = velOf(em)
    local fut = tp + V3(v.X, 0, v.Z) * (tof or 0)
    local lsp, lon = cam:WorldToViewportPoint(fut)
    local show = ton and lon and V3(v.X, 0, v.Z).Magnitude > 2
    SR.lead.Visible = show
    if show then
      SR.lead.Position = UD2(0, lsp.X, 0, lsp.Y)
      for i, dd in ipairs(SR.leadDots) do
        local k = i / (#SR.leadDots + 1)
        dd.Visible = true
        dd.Position = UD2(0, tsp.X + (lsp.X - tsp.X) * k, 0, tsp.Y + (lsp.Y - tsp.Y) * k)
      end
    else
      for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
    end
  end
  G.shipLead = function() return SR.lead.Visible and SR.lead.Position or nil end   -- 测试用

  -- 导弹锁定（《现代战舰》）：四个角框住目标；刚框上 0.5 秒从两倍大收到贴着目标（琥珀「锁定中」），收好了 / 按了锁定键变红
  local lockEm, lockT0 = nil, 0
  local function placeLock(st)
    local lk = (st.wi == 2) and st.lock or nil
    local r = lk and lk.root
    if not r or not r.Parent then
      SR.lock.Visible = false
      SR.lockTxt.Visible = st.wi == 2
      SR.lockTxt.Text = T("ship.noLock")
      SR.lockTxt.TextColor3 = MUTE
      SR.lockTxt.Position = UD2(0.5, 0, 0.5, 46)
      lockEm = nil
      return
    end
    if lk.em ~= lockEm then lockEm, lockT0 = lk.em, os.clock() end
    local tp = r.CFrame.Position
    local sp, on = cam:WorldToViewportPoint(tp)
    local dist = (tp - cam.CFrame.Position).Magnitude
    local px = math.clamp(r.Size.Magnitude / math.max(dist, 1) * cam.ViewportSize.Y * 0.9, 34, 170)
    local a = math.clamp((os.clock() - lockT0) / 0.5, 0, 1)
    local locked = a >= 1 or st.sticky
    local sz = px * (1 + (1 - a) * (1 - a) * 1.2)
    SR.lock.Visible = on
    SR.lock.Position = UD2(0, sp.X, 0, sp.Y)
    SR.lock.Size = UD2(0, sz, 0, sz)
    local col = locked and PEN_NO or PEN_MAYBE
    for _, c in ipairs(SR.corners) do c.BackgroundColor3 = col end
    local key = (lk.kind == "fort") and ("fort." .. tostring(lk.em:GetAttribute("Model") or "bunker"))
      or ("veh." .. ((lk.d and lk.d.id) or (lk.def and lk.def.id) or lk.kind or ""))
    local own = st.em and st.em:FindFirstChild("Root")
    local km = own and (tp - own.CFrame.Position).Magnitude or dist
    local msp = (SD.W.asm and SD.W.asm.speed) or 320
    SR.lockTxt.Visible = on
    SR.lockTxt.Position = UD2(0, sp.X, 0, sp.Y + sz / 2 + 8)
    SR.lockTxt.TextColor3 = col
    SR.lockTxt.Text = string.format("%s  %s   %.1f km   ETA %.0f s", locked and T("ship.locked") or T("ship.locking"), T(key), km / 2800, km / (msp * 0.85) + 1)
  end
  G.shipLockState = function() return SR.lock.Visible, SR.corners[1].BackgroundColor3 end   -- 测试用

  ---------------------------------------------------------------- 每帧：舰艇
  local function stepShip(st)
    local d = st.d
    local vs = G.S and G.S.veh
    if SH.def ~= d then buildShip(d) end
    SH.name.Text = T("veh." .. d.id) .. ((vs and vs.rest and vs.rest > 0) and ("   " .. T("ship.rest")) or "")
    SH.hp.lab.Text = T("vh.hullShip")
    local k, col = hpColor(st.em)
    SH.bodyStroke.Color, SH.bowStroke.Color = col, col
    setHp(SH.hp, k, col)
    local camY = math.deg(st.camYaw or 0)
    local hullY = math.deg(st.yaw or 0)
    SH.hull.Rotation = -(hullY - camY)
    for gi, t in ipairs(SH.turrets) do t.box.Rotation = st.ty[gi] or 0 end
    SH.kn.Text = string.format("%d", math.floor(math.abs(st.speed or 0) / 2.8 * 1.944 + 0.5))
    SH.order.Text = T("ship.order." .. (st.order or 0))
    for o, c in pairs(SH.ladder) do
      local on = o == st.order
      c.BackgroundColor3 = on and ((o < 0) and AMBER or ((o == 0) and TXT or OK)) or TXT
      c.BackgroundTransparency = on and 0.02 or 0.85
    end
    local rd = math.floor(math.abs(st.rudder or 0) * 35 + 0.5)
    SH.rud.Position = UD2(0.5, (st.rudder or 0) * 64, 0.5, 0)
    SH.rudTxt.Text = (rd == 0) and T("ship.mid") or T(((st.rudder or 0) > 0) and "ship.right" or "ship.left", rd)
    SH.hdg.Text = string.format("%03d°", math.floor(hdgOf(st.yaw) + 0.5) % 360)
    -- 武器：主炮、反舰导弹、防空导弹、近防炮
    local t = os.clock()
    local relK, ready, left = 1, true, 0
    local g1 = d.guns and d.guns[1]
    if g1 then
      setRow(SH.rows[1], "1", T("sw." .. g1.w) .. ((#d.guns > 1) and (" ×" .. #d.guns) or ""), "∞", st.wi == 1)
      if st.wi == 1 then
        local w = SD.W[g1.w]
        local l = (st.next[1] or 0) - t
        relK, ready, left = 1 - math.clamp(l / math.max(w and w.rate or 1, 0.01), 0, 1), l <= 0, math.max(0, l)
        if lastNext.s1 and (st.next[1] or 0) > lastNext.s1 + 0.05 then kickT = t end
        lastNext.s1 = st.next[1] or 0
      end
    else
      setRow(SH.rows[1], nil, nil)
    end
    if d.missiles then
      local n = vs and vs.msl or 0
      setRow(SH.rows[2], "2", T("sw." .. (d.missiles.name or "yj83")), tostring(n), st.wi == 2, n == 0)
      if st.wi == 2 then
        local l = (st.mslT or 0) - t
        relK, ready, left = 1 - math.clamp(l / 1.3, 0, 1), l <= 0, math.max(0, l)
      end
    else
      setRow(SH.rows[2], nil, nil)
    end
    if d.sam then setRow(SH.rows[3], nil, T("vh.sam"), tostring(vs and vs.sam or 0), false) else setRow(SH.rows[3], nil, nil) end
    if d.ciws and #d.ciws > 0 then setRow(SH.rows[4], nil, T("vh.ciws"), T("vh.auto"), false) else setRow(SH.rows[4], nil, nil) end
    setRing(SH.ring, relK, ready, left)
    updateCompact(SH.name.Text, T("ship.kn", SH.kn.Text), SH.order.Text, SH.hdg.Text,
      SH.hp.lab.Text, k, col, SH.rows[st.wi], relK, ready, left)
    stepCompass(hdgOf(st.camYaw), hdgOf(st.yaw))
    -- 准星：主炮的落点（《现代战舰》的大圈）、导弹的锁定框
    TR.root.Visible, lagArrow.Visible = false, false
    local fp = (st.wi == 1 and G.sailFall and g1) and G.sailFall(1) or nil
    if fp then
      local w = SD.W[g1.w]
      local mz = SD.muzzle(d, st.cf, 1, st.ty[1] or 0, st.gp[1] or 0)
      local h = V3(fp.X - mz.Position.X, 0, fp.Z - mz.Position.Z).Magnitude
      local lv = mz.LookVector
      local tof = (w.kind == "gun") and ((fp - mz.Position).Magnitude / 1500) or (h / math.max(1, w.speed * math.sqrt(lv.X * lv.X + lv.Z * lv.Z)))
      placeShip(fp, mz.Position, relK, ready and (st.onT and st.onT[1]) ~= false, left, tof, T("sw." .. g1.w))
    else
      SR.root.Visible, SR.lead.Visible, SR.card.Visible = false, false, false
      for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
      fireCC.Brightness = 0
    end
    placeLock(st)
  end

  ---------------------------------------------------------------- 坦克瞄准镜里（Drive.lua 画目镜、分划、测距数字；这里在镜里补战雷那一套仪表）
  -- 分划外一圈 32 颗点的装填环（装好变绿）；左边竖着的测距尺（0～2000 米，每 200 米一格、每 400 米一个数，小三角指着现在测到的距离）；
  --   下面一行：选中的弹、弹药、装填状态；上面一条小罗盘（炮管朝向）
  local sg = Instance.new("ScreenGui")
  sg.Name = "VehSight"
  sg.ResetOnSpawn = false
  sg.IgnoreGuiInset = true
  sg.DisplayOrder = 7
  sg.Enabled = false
  sg.Parent = me:WaitForChild("PlayerGui")
  local SG = { dots = {}, ticks = {} }
  -- 开炮后镜里一阵炮口烟、土（战雷那样前面一下子看不清，一秒多散掉）：颜色跟着光电模式（夜视绿、热成像灰）
  SG.haze = Instance.new("Frame")
  SG.haze.Name = "MuzzleHaze"
  SG.haze.Size = UDim2.fromScale(0.9, 0.9)   -- 跟 Drive 的目镜一样大的圆：烟只在镜片里，外面的黑边不染色
  SG.haze.AnchorPoint = V2(0.5, 0.5)
  SG.haze.Position = UDim2.fromScale(0.5, 0.5)
  SG.haze.BorderSizePixel = 0
  do
    local a = Instance.new("UIAspectRatioConstraint")
    a.AspectRatio = 1
    a.Parent = SG.haze
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0.5, 0)
    c.Parent = SG.haze
  end
  SG.haze.BackgroundTransparency = 1
  SG.haze.ZIndex = 0
  SG.haze.Parent = sg
  do
    local gr = Instance.new("UIGradient")
    gr.Rotation = 90
    gr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(0.55, 0), NumberSequenceKeypoint.new(1, 0.15) })
    gr.Parent = SG.haze
  end
  SG.ring = frame(sg, UD2(0, 180, 0, 180), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SG.ring.Name = "SightReload"
  -- 装填环：原来 32 颗 4 像素的小点（用户 11-19：像素感太强）——换成一道平滑的细圆环（圆角 + 描边，抗锯齿），
  --   装填中琥珀色、越装越亮，装好变绿（剩几秒写在右边的状态框里）
  SG.ringLine = roundf(frame(SG.ring, UD2(0, 172, 0, 172), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5)))
  SG.ringLine.Name = "ReloadRing"
  SG.ringStroke = stroke(SG.ringLine, TXT, 1.6, 0.6)
  SG.scale = frame(sg, UD2(0, 60, 0, 220), UD2(0.5, -250, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SG.scale.Name = "RangeScale"
  frame(SG.scale, UD2(0, 2, 1, 0), UD2(0, 30, 0, 0), TXT, 0.35)
  for i = 0, 10 do
    local y = 220 - i * 22
    local major = i % 2 == 0
    frame(SG.scale, UD2(0, major and 12 or 7, 0, 2), UD2(0, 32, 0, y - 1), TXT, 0.3)
    if major then label(SG.scale, tostring(i * 2), UD2(0, 26, 0, 14), UD2(0, 0, 0, y - 7), 12, TXT, MONO, nil, RIGHT) end
  end
  SG.ptr = label(SG.scale, "◀", UD2(0, 14, 0, 14), UD2(0, 46, 0, 0), 12, AMBER, BOLD, V2(0, 0.5))
  SG.ptr.Name = "RangePointer"
  label(SG.scale, "×100m", UD2(0, 60, 0, 12), UD2(0, 0, 1, 6), 10, MUTE, MONO)
  -- 右边跟左边测距尺对称：选中的弹 / 弹药 / 装填（下面 Drive 的测距数字和倍率不挡）
  SG.info = frame(sg, UD2(0, 184, 0, 43), nil, INK, 0.19)
  SG.info.Name = "SightStatus"
  stroke(SG.info, WHITE, 1, 0.79)
  SG.ammo = label(SG.info, "", UD2(1, -74, 0, 18), UD2(0, 10, 0, 4), 13, TXT, MED, nil, LEFT)
  SG.ammo.Name = "SightAmmo"
  SG.ammo.TextTruncate = Enum.TextTruncate.AtEnd
  SG.count = label(SG.info, "", UD2(0, 50, 0, 18), UD2(1, -8, 0, 4), 12, TXT, MONO, V2(1, 0), RIGHT)
  SG.state = label(SG.info, "", UD2(1, -20, 0, 16), UD2(0, 10, 0, 23), 12, OK, BOLD, nil, LEFT)
  SG.comp = frame(sg, UD2(0, 300, 0, 22), UD2(0.5, 0, 0.5, -215), INK, 1, V2(0.5, 0))
  SG.comp.ClipsDescendants = true
  for i = 1, 24 do
    SG.ticks[i] = { t = frame(SG.comp, UD2(0, 1, 0, 5), UD2(0, 0, 0, 0), TXT, 0.4), l = label(SG.comp, "", UD2(0, 28, 0, 12), UD2(0, 0, 0, 6), 10, TXT, MONO, V2(0.5, 0)) }
  end
  SG.marker = label(sg, "▼", UD2(0, 14, 0, 10), UD2(0.5, 0, 0.5, -226), 9, AMBER, BOLD, V2(0.5, 0))
  local sightRingScale = Instance.new("UIScale")
  sightRingScale.Parent = SG.ring

  -- 触屏左下的方向键最右到 x=250，右侧操作键最下到离底部 120 px。
  local function compactDock(vp, mobile, width, height)
    local margin = 14
    local left = mobile and 262 or margin
    local room = vp.X - left - margin
    local top = vp.Y - height - margin
    if mobile and room < 185 then
      -- 竖屏保留左上小地图的 122 px 宽度。
      left, room = 150, vp.X - 150 - margin
      top = math.min(100, top)
    end
    width = math.max(1, math.min(width, room))
    return math.max(left, (vp.X - width) / 2), math.max(0, top), width
  end

  local PAIRS = { { TK.car, TK.arm }, { SH.car, SH.arm } }
  for _, pr in ipairs(PAIRS) do
    pr[3], pr[4] = Instance.new("UIScale"), Instance.new("UIScale")
    pr[3].Parent, pr[4].Parent = pr[1], pr[2]
  end
  local lastVp, lastMob = nil, nil
  local compact, compassSide = false, false
  local function layoutPanels()
    local vp = cam.ViewportSize
    local mob = G.mobile == true or UIS.TouchEnabled
    if lastVp == vp and lastMob == mob then return end
    lastVp, lastMob = vp, mob
    compact = mob or vp.X < 760 or vp.Y < 480
    -- 计分栏左边：左上角是 Roblox 自己的菜单、聊天按钮（约 125 px 宽），罗盘从它们右边起，到计分栏左边留 12 px（1280 宽也放得下：约 160 px）
    local SIDE_X = 132
    local sideWidth = vp.X / 2 - 330 - SIDE_X - 12
    compassSide = sideWidth >= 150
    CW = compassSide and math.min(420, math.floor(sideWidth)) or math.clamp(math.floor(vp.X - 32), 1, 420)
    compGroup.Size = UD2(0, CW, 0, 51)
    compGroup.Position = compassSide and UD2(0, SIDE_X, 0, 16) or UD2(0.5, -CW / 2, 0, 118)

    local s = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.74, 1.25)
    for _, pr in ipairs(PAIRS) do
      pr[3].Scale, pr[4].Scale = s, s
      pr[1].Position, pr[2].Position = UD2(1, -334 * s, 1, -40 * s), UD2(1, -24 * s, 1, -40 * s)
    end
    MW.brScale.Scale, MW.smScale.Scale = s, s
    MW.br.Position = UD2(1, -18 * s, 1, -14 * s)
    MW.sm.Position = UD2(0.5, 70 * s, 1, -16 * s)

    local x, y, width = compactDock(vp, mob, 342, 72)
    local split = width >= 232 and 108 or 88
    MS.box.Position, MS.box.Size = UD2(0, x, 0, y), UD2(0, width, 0, 72)
    MS.speed.Size, MS.motion.Size = UD2(0, split - 15, 0, 28), UD2(0, split - 15, 0, 16)
    MS.speed.TextSize = width >= 232 and 20 or 16
    MS.split.Position = UD2(0, split, 0, 8)
    MS.selection.Position, MS.selection.Size = UD2(0, split + 10, 0, 6), UD2(1, -split - 18, 0, 16)
    MS.count.Position, MS.count.Size = UD2(0, split + 10, 0, 24), UD2(1, -split - 74, 0, 16)
    MS.health.Position, MS.health.Size = UD2(0, split + 10, 0, 42), UD2(1, -split - 18, 0, 16)
    MS.track.Position, MS.track.Size = UD2(0, split + 10, 1, -10), UD2(1, -split - 18, 0, 2)

    local simpleSight = compact or vp.X < 900 or vp.Y < 520
    SG.scale.Visible, SG.comp.Visible, SG.marker.Visible = not simpleSight, not simpleSight, not simpleSight
    sightRingScale.Scale = simpleSight and 0.78 or 1
    if simpleSight then
      local sx, sy, sw = compactDock(vp, mob, 184, 43)
      if mob and vp.X >= 600 then sx = vp.X - sw - 14 end
      SG.info.Position, SG.info.Size = UD2(0, sx, 0, sy), UD2(0, sw, 0, 43)
    else
      SG.info.Position, SG.info.Size = UD2(0.5, 206, 0.5, -26), UD2(0, 184, 0, 43)
    end
  end

  local function stepSight(st)
    local d = st.d
    local vs = G.S and G.S.veh
    local wid = d.weapons[st.wi]
    local w = wid and VD.W[wid]
    local ammo = vs and vs.ammo and wid and vs.ammo[wid]
    local relK, ready, left = 1, true, 0
    if w then
      local l = (st.next[wid] or 0) - os.clock()
      local full = (ammo and ammo[1] == w.mag and l > w.rate) and (w.reload or w.rate) or w.rate
      relK, ready, left = 1 - math.clamp(l / math.max(full, 0.01), 0, 1), l <= 0, math.max(0, l)
    end
    -- 炮口烟：开炮后 0.06 秒涌上来，一秒多散掉
    local age = os.clock() - (st.fireT or -99)
    local hz = (not reducedMotion and age < 2.2) and math.clamp(age / 0.06, 0, 1) * 0.62 * math.exp(-math.max(0, age - 0.06) * 2.1) or 0
    SG.haze.BackgroundTransparency = 1 - hz
    if hz > 0 then
      local cc = G.sightCC
      local tint = (cc and cc.Enabled) and cc.TintColor or Color3.fromRGB(255, 255, 255)
      SG.haze.BackgroundColor3 = Color3.fromRGB(168, 156, 136):Lerp(tint, 0.55)
    end
    SG.ringStroke.Color = ready and OK or AMBER
    SG.ringStroke.Transparency = ready and 0.3 or (0.8 - 0.5 * relK)
    SG.ammo.Text = wid and T("vw." .. wid) or ""
    SG.count.Text = wid and (ammo and string.format("%d/%d", ammo[1], ammo[2]) or "∞") or ""
    SG.state.Text = ready and T("vh.loaded") or string.format("%s  %.1f", T("vh.reload"), left)
    SG.state.TextColor3 = ready and OK or AMBER
    if not SG.scale.Visible then return end
    local dist = st.aimPt and (st.aimPt - cam.CFrame.Position).Magnitude / 2.8 or 0
    SG.ptr.Position = UD2(0, 46, 0, 220 - math.clamp(dist / 2000, 0, 1) * 220)
    -- 小罗盘：炮管朝向
    local h = hdgOf((st.yaw or 0) - math.rad(st.ty or 0))
    local first = math.floor((h - 150 / 3) / 5) * 5
    for i, tk in ipairs(SG.ticks) do
      local a = first + (i - 1) * 5
      local x = 150 + (a - h) * 3
      local aa = a % 360
      tk.t.Position = UD2(0, x, 0, 0)
      tk.t.Size = UD2(0, 1, 0, (aa % 15 == 0) and 7 or 4)
      tk.l.Position = UD2(0, x, 0, 8)
      tk.l.Text = (aa % 30 == 0) and (DIR[aa] or string.format("%03d", aa)) or ""
    end
  end

  G.frameConn("VehHud", function()
    local covered = (G.boardShown and G.boardShown()) or (G.menuOpen and G.menuOpen())
      or (G.menuShown and G.menuShown()) or (G.coachPanel and G.coachPanel())
    local tank, ship = G.myVeh, G.sail
    local driving = not covered and tank ~= nil and tank == G.drive and tank.d ~= nil
    local sailing = not covered and ship ~= nil and ship == G.drive and ship.d ~= nil and ship.bino ~= true
    local inSight = driving and tank.sight == true
    local showTank = driving and not inSight
    gui.Enabled, sg.Enabled = showTank or sailing, inSight
    if not gui.Enabled then
      if fireCC.Brightness ~= 0 then fireCC.Brightness = 0 end
      hp0 = nil
      mwtOn = false
      G.tankHudActive = false
    end
    if not gui.Enabled and not inSight then return end
    layoutPanels()
    if inSight then
      local ok, err = pcall(stepSight, tank)
      if not ok and G.showError then G.showError("瞄准镜：" .. tostring(err)) end
      return
    end
    mwtOn = showTank and not compact
    G.tankHudActive = mwtOn
    MW.root.Visible = mwtOn
    compGroup.Visible = not compact and not showTank and (compassSide or not (G.operationHudVisible and G.operationHudVisible()))
    TK.car.Visible, TK.arm.Visible = false, false   -- 电脑开坦克是 MWT 那套（MW），触屏是紧凑读数面板（MS）
    SH.car.Visible, SH.arm.Visible = sailing and not compact, sailing and not compact
    MS.box.Visible = compact
    local ok, err = pcall(showTank and stepTank or stepShip, showTank and tank or ship)
    if not ok and G.showError then G.showError("驾驶界面：" .. tostring(err)) end
  end)
end

return VehHud
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">VehModels</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——地面载具的样子：导入了原模型就用原模型（见下），没有就按 VehDefs 的尺寸用零件拼——车体（首上装甲、侧裙、发动机舱、反应装甲块）、
--   履带车的负重轮 / 主动轮 / 诱导轮 / 履带（下面一段段跟着负重轮上下）、轮式车的车轮（带轮毂、挡泥板，前轴转向）、
--   各式炮塔（楔形、圆形、艾布拉姆斯、步战车、遥控武器站、自行高炮、火神炮、自行榴弹炮、发射箱）、炮管（抽烟装置、炮口制退器）、
--   烟幕弹发射筒（就装在 VehDefs 规定的位置、朝规定的方向）
--   返回 { model, parts = { { 零件, 组, 相对位置 } }, wheels = { … } }：组是 hull（车体）/ turret / gun / wheel（第几个轮）/ seg（履带段）
--   每帧由 View 按车体、炮塔、炮、各轮的姿态算出零件位置（BulkMoveTo）
local VehModels = {}

-- 原模型（网页版装备模型原样转的 models/veh/<模型键>.glb，Studio 里导入后由 Imports.lua 收进 ReplicatedStorage.Imported.Veh.<模型键>）：
--   有就整辆换成它（真实尺寸，不缩放；车体、炮塔、炮、各个车轮照元数据 ImportedMeta 摆、按各自的转轴动），没有就用下面零件拼的
local RS = game:GetService("ReplicatedStorage")
local Tint = require(script.Parent:WaitForChild("Tint"))   -- 导入的贴图没出来时的底色（原贴图的平均色）
local TURN = require(RS:WaitForChild("ImportTurn")).TURN   -- 导入的每块网格被 Roblox 转了半圈（ImportTurn.lua）：摆的时候转回来
local TM = require(RS:WaitForChild("TankMods"))   -- 坦克改装：爆反块、主动防御、车顶加特林（用户 11-19）
local IM = nil
do
  local ok, r = pcall(function() return require(RS:WaitForChild("ImportedMeta", 3)) end)
  if ok and type(r) == "table" then IM = r end
end
local function importedFor(d)
  if not IM then return nil end
  local key = IM.alias and IM.alias[d.id]
  local info = key and IM.m[key]
  if not info then return nil end
  local imp = RS:FindFirstChild("Imported")
  local veh = imp and imp:FindFirstChild("Veh")
  local f = veh and veh:FindFirstChild(key)
  if not f then return nil end
  local n = f:GetAttribute("N")   -- 服务器记的块数：还没全复制过来就先不用（View 等块齐了再重建）
  if n and #f:GetChildren() < n then return nil end
  return key, info, f
end
VehModels.importedFor = importedFor

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local MAT = Enum.Material
local CYL, BALL = Enum.PartType.Cylinder, Enum.PartType.Ball
local ALONG_Z = CFrame.Angles(0, math.pi / 2, 0)   -- 圆柱的轴（X）转到 Z（炮管、烟幕弹管）
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)  -- 圆柱的轴转到 Y（竖着的圆盘、舱盖）

local CAMO = {
  atk = { base = RGB(86, 100, 68), dark = RGB(60, 70, 48), light = RGB(118, 126, 90) },   -- 解放军：林地绿
  def = { base = RGB(176, 158, 116), dark = RGB(128, 114, 84), light = RGB(198, 184, 146) },   -- 美军：沙色
}
local TRACK, RUBBER, STEEL, GLASS = RGB(44, 44, 46), RGB(28, 28, 30), RGB(70, 72, 74), RGB(40, 54, 62)

function VehModels.build(d, team, mods)
  local C = CAMO[team] or CAMO.atk
  local m = Instance.new("Model")
  m.Name = d.id
  local parts, wheels = {}, {}
  local rng = Random.new(#d.id * 7919 + (team == "def" and 1 or 0))

  local function add(group, size, off, color, mat, shape, idx)
    local p = Instance.new((shape == "wedge") and "WedgePart" or "Part")
    if shape and shape ~= "wedge" then p.Shape = shape end
    p.Size = size
    p.Color = color
    p.Material = mat or MAT.SmoothPlastic
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.CFrame = off
    p.Parent = m
    table.insert(parts, { p, group, off, idx })
    return p
  end
  local function hull(size, off, color, mat, shape) return add("hull", size, off, color or C.base, mat or MAT.Metal, shape) end
  local function tur(size, off, color, mat, shape) return add("turret", size, off, color or C.base, mat or MAT.Metal, shape) end
  local function gun(size, off, color, mat, shape) return add("gun", size, off, color or C.base, mat or MAT.Metal, shape) end
  -- 一根沿 −Z 的圆管：从 z0 到 z1（z1 更靠前），直径 dia
  local function tube(fn, x, y, z0, z1, dia, color, mat)
    local L = math.abs(z1 - z0)
    return fn(V(L, dia, dia), CF(x, y, (z0 + z1) / 2) * ALONG_Z, color, mat, CYL)
  end
  -- 零件拼的车顶遥控武器站（原模型上没有机枪、或者机枪和炮塔分不开的坦克：99A2、15 式、零件拼的 M10；用户 11-19：坦克的机枪要能转，开火位置要在机枪）：
  --   座圈、武器站的罩子、光电盒子跟着底座转（rws，原点在座圈中心），12.7 毫米机枪（机匣、散热套筒、枪管、弹箱）跟着俯仰（rwg，原点在俯仰轴）；
  --   gunOff 俯仰轴相对座圈中心，muz 枪口在俯仰轴前面多远——枪口正好在服务器算的枪口上（VehDefs.muzzle 的 rws）
  local function rwsMg(gunOff, muz)
    local GM, BL = RGB(54, 56, 52), RGB(30, 31, 30)
    local function rw(size, off, color, mat, shape) return add("rws", size, off, color or C.base, mat or MAT.Metal, shape) end
    local function rg(size, off, color, mat, shape) return add("rwg", size, off, color or GM, mat or MAT.Metal, shape) end
    local gy, gz = gunOff.Y, gunOff.Z
    rw(V(0.22, 1.7, 1.7), CF(0, 0.11, 0) * UPRIGHT, C.dark, MAT.Metal, CYL)   -- 座圈
    rw(V(1.0, math.max(0.3, gy - 0.25), 1.1), CF(0, 0.22 + math.max(0.3, gy - 0.25) / 2, gz * 0.45), C.base)   -- 武器站的罩子（底座）
    rw(V(0.2, 0.55, 0.5), CF(0.42, gy - 0.12, gz), C.base)   -- 枪架右侧板
    rw(V(0.2, 0.55, 0.5), CF(-0.42, gy - 0.12, gz), C.base)   -- 枪架左侧板
    rw(V(0.5, 0.42, 0.58), CF(-0.78, gy + 0.05, gz + 0.05), GM)   -- 光电盒子（左边）
    rw(V(0.22, 0.2, 0.06), CF(-0.78, gy + 0.08, gz - 0.25), RGB(18, 22, 26), MAT.Glass)   -- 镜头
    rg(V(0.42, 0.44, 1.35), CF(0, 0, 0.35), GM)   -- 机匣
    rg(V(0.16, 0.3, 0.26), CF(0, -0.08, 1.12), BL)   -- 后部握把
    tube(rg, 0, 0.04, -0.32, -1.25, 0.26, BL)   -- 散热套筒
    tube(rg, 0, 0.04, -1.25, -muz, 0.14, BL)   -- 枪管
    rg(V(0.11, 0.2, 0.2), CF(0, 0.04, -muz + 0.08), BL)   -- 枪口制退器
    rg(V(0.36, 0.44, 0.62), CF(0.44, -0.04, 0.3), C.base)   -- 弹箱（右边供弹）
  end
  -- 一组迷彩斑块（贴在一个面上的薄片）
  local function blotches(fn, cx, cy, cz, w, h, axis, n)
    for _ = 1, n do
      local u, v = (rng:NextNumber() - 0.5) * w, (rng:NextNumber() - 0.5) * h
      local sw, sh = rng:NextNumber(1.2, 3.2), rng:NextNumber(0.6, 1.6)
      if axis == "x" then fn(V(0.06, sh, sw), CF(cx, cy + v, cz + u), C.dark, MAT.SmoothPlastic)
      elseif axis == "y" then fn(V(sw, 0.06, sh), CF(cx + u, cy, cz + v), C.dark, MAT.SmoothPlastic) end
    end
  end

  local W, L, H, hh, clear = d.W, d.L, d.H, d.hullH, d.clear
  local extra = {}   -- 原模型的炮塔 / 炮转轴、悬架行程（View 用）

  ---------------------------------------------------------------- 原模型
  local ikey, info, folder = importedFor(d)
  if ikey then
    local function v3(t) return V(t[1], t[2], t[3]) end
    local tpiv = info.tur and v3(info.tur) or d.turret.pivot
    local gpiv = info.gun and v3(info.gun) or (tpiv + d.gun.pivot)
    -- 遥控武器站（M1A2 的 CROWS）：底座转轴、M2 俯仰轴（用户：机枪也要能转动）
    local rpiv = info.rws and info.rws.p and v3(info.rws.p) or nil
    local rgpiv = info.rws and info.rws.g and v3(info.rws.g) or nil
    -- 车轮：每个轮一个弹簧（中心、半径照原模型）；轮式车最前面 d.steer 排转向
    local wix, names = {}, {}
    for g in pairs(info.wheels or {}) do table.insert(names, g) end
    table.sort(names)
    local zs = {}
    for _, g in ipairs(names) do
      local w = info.wheels[g]
      local c = v3(w.c)
      local wi = #wheels + 1
      wheels[wi] = { x = c.X, z = c.Z, r = c.Y, rad = math.max(w.r, 0.3), side = (c.X < 0) and -1 or 1, dy = 0, vy = 0, spin = 0, steer = false }
      wix[g] = wi
      table.insert(zs, c.Z)
    end
    if #wheels == 0 then
      -- 原模型的车轮和车身是一整块（JLTV、M270、M1150、M1A1、96 式……）：照型号表的轮位（按原模型的长宽缩放）放几个看不见的弹簧，
      --   车身照样随地面起伏、俯仰、侧倾
      local hb = info.hull or { info.w, info.h, info.len }   -- 车身的宽、高、长
      local kz, kx = hb[3] / math.max(d.L, 1), hb[1] / math.max(d.W, 1)
      local function spring(x, z, r) wheels[#wheels + 1] = { x = x * kx, z = z * kz, r = r, rad = r, side = (x < 0) and -1 or 1, dy = 0, vy = 0, spin = 0, steer = false } end
      if d.arch == "tracked" and d.rw then
        local R = d.rw
        for s = -1, 1, 2 do
          for i = 1, R.n do spring(s * R.x, R.z0 + (i - 1) * (R.z1 - R.z0) / math.max(R.n - 1, 1), R.r) end
        end
      elseif d.axles then
        for _, z in ipairs(d.axles) do
          for s = -1, 1, 2 do spring(s * d.wx, z, d.wr) end
        end
      end
    end
    if d.arch == "wheeled" and #zs > 0 then
      table.sort(zs)
      local axles = {}
      for _, z in ipairs(zs) do
        if #axles == 0 or z - axles[#axles] > 1.5 then table.insert(axles, z) end
      end
      local lim = axles[math.min(#axles, d.steer or 1)] + 0.75
      for _, w in ipairs(wheels) do w.steer = w.z <= lim end
    end
    for name, p in pairs(info.parts) do
      local src = folder:FindFirstChild("V_" .. ikey .. "__" .. name)
      if src and src:IsA("BasePart") then
        local mp = Tint.fix(src:Clone(), src)
        mp.Anchored, mp.CanCollide, mp.CanQuery, mp.CanTouch = true, false, false, false
        mp.Size = v3(p.s)
        -- 原模型里这块本来就没贴图（JLTV、M270 整车都是）：照原材质的颜色上色——Studio 导入时不一定把材质颜色带过来
        local okT, tid = pcall(function() return mp.TextureID end)   -- 不是 MeshPart 的没有这个属性
        if p.col and not mp:FindFirstChildOfClass("SurfaceAppearance") and (not okT or (tid or "") == "") then
          mp.Color = Color3.fromRGB(p.col[1], p.col[2], p.col[3])
          mp.Material = p.met and Enum.Material.Metal or Enum.Material.SmoothPlastic
          if p.a then mp.Transparency = 1 - p.a end
        end
        local c = v3(p.c)
        local grp, off, wi = "hull", CF(c), nil
        if p.g == "Turret" then grp, off = "turret", CF(c - tpiv)
        elseif p.g == "Gun" then grp, off = "gun", CF(c - gpiv)
        elseif p.g == "Rws" and rpiv then grp, off = "rws", CF(c - rpiv)
        elseif p.g == "RwsGun" and rgpiv then grp, off = "rwg", CF(c - rgpiv)
        elseif wix[p.g] then
          wi = wix[p.g]
          local w = wheels[wi]
          grp, off = "wheel", CF(c - V(w.x, w.r, w.z))
        end
        off = off * TURN   -- 绕这块自己的中心补回导入时转掉的半圈
        mp.CFrame = off
        mp.Parent = m
        table.insert(parts, { mp, grp, off, wi })
      end
    end
    -- 原模型没有机枪的（悍马 M998 软篷）：篷顶上补一挺零件拼的 M2——座圈、枪盾、枪架跟着炮塔转，枪身跟着俯仰，
    --   枪口正好在服务器算的炮口上（耳轴前 d.gun.len；用户：很多载具的机枪塔没法旋转、开火位置要对）
    if info.mg == "m2" then
      local GM, BL, OD = RGB(46, 48, 46), RGB(28, 29, 28), RGB(74, 80, 58)
      local gy = (gpiv - tpiv).Y   -- 枪架高
      tur(V(0.3, 3.0, 3.0), CF(0, 0.15, 0) * UPRIGHT, C.dark, MAT.Metal, CYL)   -- 座圈
      for sx = -1, 1, 2 do   -- 正面枪盾：左右两块，中间留出枪管的缝
        tur(V(1.05, 1.25, 0.12), CF(sx * 0.66, 0.95, -1.3), C.base)
        tur(V(0.12, 1.1, 0.8), CF(sx * 1.22, 0.9, -0.95) * CFrame.Angles(0, sx * 0.45, 0), C.base)   -- 侧翼
      end
      tur(V(0.24, gy, 0.24), CF(0, gy / 2, 0.1), GM)   -- 枪架立柱
      gun(V(0.5, 0.58, 1.7), CF(0, 0.1, 0.1), GM)   -- 机匣
      gun(V(0.14, 0.36, 0.26), CF(0, 0.05, 1.05), BL)   -- 握把
      tube(gun, 0, 0.12, -0.75, -1.85, 0.3, BL)   -- 散热套筒
      tube(gun, 0, 0.12, -1.85, -d.gun.len, 0.17, BL)   -- 枪管
      gun(V(0.4, 0.5, 0.78), CF(-0.48, -0.06, 0.05), OD)   -- 弹箱（M2 从左边供弹）
    end
    -- 原模型上没有机枪（或者去掉了）的坦克：元数据的 rws.mk——在座圈上拼一个遥控武器站（tools/models/vehrws.py）
    if info.rws and info.rws.mk and rpiv and rgpiv then rwsMg(rgpiv - rpiv, info.rws.muz or 2.45) end
    extra = { imported = ikey, tpiv = tpiv, gpiv = gpiv - tpiv, travel = (d.arch == "tracked") and 0.12 or d.travel,
      rpiv = rpiv and (rpiv - tpiv) or nil, rgpiv = (rpiv and rgpiv) and (rgpiv - rpiv) or nil }
  end

  if not ikey then
  -- 零件拼的：炮塔、炮按型号表原来的转轴摆（VehDefs 的转轴照原模型改过，给导入了原模型的用；服务器的炮口照原模型，差一两格）
  extra.tpiv, extra.gpiv = d.turret and d.turret.pivot0, d.gun and d.gun.pivot0
  ---------------------------------------------------------------- 行走部分

  if d.arch == "tracked" then
    local R = d.rw
    local tw = math.max(1.2, W * 0.16)   -- 履带宽
    local spacing = (R.z1 - R.z0) / (R.n - 1)
    for s = -1, 1, 2 do
      local x = s * R.x
      for i = 1, R.n do
        local z = R.z0 + (i - 1) * spacing
        local wi = #wheels + 1
        wheels[wi] = { x = x, z = z, r = R.r, side = s, dy = 0, vy = 0, spin = 0, steer = false }
        add("wheel", V(tw * 0.8, R.r * 2, R.r * 2), CF(), RUBBER, MAT.SmoothPlastic, CYL, wi)
        add("wheel", V(tw * 0.84, R.r * 1.2, R.r * 1.2), CF(), C.dark, MAT.Metal, CYL, wi)
        add("wheel", V(tw * 0.86, R.r * 1.5, 0.25), CF(), STEEL, MAT.Metal, nil, wi)   -- 辐条（看得出在转）
        add("seg", V(tw, 0.32, spacing * 1.04), CF(x, 0.16, z), TRACK, MAT.DiamondPlate, nil, wi)   -- 下面这一段履带跟着轮
      end
      -- 上面一段履带、主动轮（前）、诱导轮（后）、前后斜着的两段
      local ytop = R.r * 2 + 0.18
      local zf, zb = R.z0 - R.r * 1.35, R.z1 + R.r * 1.25
      hull(V(tw, 0.32, R.z1 - R.z0 + R.r * 1.6), CF(x, ytop, (R.z0 + R.z1) / 2), TRACK, MAT.DiamondPlate)
      hull(V(tw * 0.9, R.r * 1.7, R.r * 1.7), CF(x, R.r * 1.35, zf), STEEL, MAT.Metal, CYL)
      hull(V(tw * 0.9, R.r * 1.6, R.r * 1.6), CF(x, R.r * 1.3, zb), STEEL, MAT.Metal, CYL)
      for _, e in ipairs({ { R.z0, zf, -1 }, { R.z1, zb, 1 } }) do
        local a = V(x, 0.2, e[1] + e[3] * R.r * 0.3)
        local b = V(x, ytop, e[2] + e[3] * R.r * 0.2)
        local mid, len = (a + b) / 2, (b - a).Magnitude
        hull(V(tw, 0.32, len), CFrame.lookAt(mid, b), TRACK, MAT.DiamondPlate)
      end
      if d.skirt then   -- 侧裙板：盖住负重轮上半截
        hull(V(0.3, R.r * 1.25, R.z1 - R.z0 + R.r * 2.4), CF(s * (W / 2 - 0.15), R.r * 1.75, (R.z0 + R.z1) / 2 - R.r * 0.3), C.base, MAT.Metal)
        blotches(hull, s * (W / 2), R.r * 1.75, (R.z0 + R.z1) / 2, R.z1 - R.z0, R.r, "x", 3)
      end
    end
  else
    local wx, wr, ww = d.wx, d.wr, d.ww
    for ai, z in ipairs(d.axles) do
      for s = -1, 1, 2 do
        local wi = #wheels + 1
        wheels[wi] = { x = s * wx, z = z, r = wr, side = s, dy = 0, vy = 0, spin = 0, steer = ai <= (d.steer or 1) }
        add("wheel", V(ww, wr * 2, wr * 2), CF(), RUBBER, MAT.SmoothPlastic, CYL, wi)
        add("wheel", V(ww + 0.06, wr * 1.1, wr * 1.1), CF(), C.dark, MAT.Metal, CYL, wi)
        add("wheel", V(ww + 0.1, wr * 0.45, wr * 0.45), CF(), STEEL, MAT.Metal, CYL, wi)
        add("wheel", V(ww + 0.08, wr * 1.6, 0.22), CF(), RUBBER, MAT.SmoothPlastic, nil, wi)   -- 胎面花纹（看得出在转）
        -- 挡泥板（跟车体）
        hull(V(ww + 0.5, 0.25, wr * 2.3), CF(s * wx, wr * 2 + 0.55, z), C.dark, MAT.Metal)
      end
    end
  end

  ---------------------------------------------------------------- 车体

  if d.arch == "tracked" then
    local tw = math.max(1.2, W * 0.16)
    local inner = W - 2 * tw - 0.3
    hull(V(inner, hh - clear - 0.7, L * 0.94), CF(0, clear + (hh - clear - 0.7) / 2, 0), C.base)   -- 下车体
    hull(V(W, 0.75, L * 0.9), CF(0, hh - 0.375, L * 0.03), C.base)   -- 上车体（翼子板一直伸到履带上面）
    -- 首上（斜面朝前上）、首下（斜面朝前下）
    hull(V(W * 0.96, 1.5, 3.2), CF(0, hh - 0.75 - 0.75 + 0.75, -L / 2 + 1.0), C.base, MAT.Metal, "wedge")
    hull(V(inner, hh - clear - 1.2, 2.0), CF(0, clear + (hh - clear - 1.2) / 2, -L / 2 + 0.2) * CFrame.Angles(0, 0, math.pi), C.dark, MAT.Metal, "wedge")
    -- 发动机舱：散热格栅、排气口
    for i = 0, 3 do hull(V(W * 0.62, 0.12, 0.5), CF(0, hh + 0.06, L * 0.18 + i * 1.1), C.dark, MAT.DiamondPlate) end
    hull(V(W * 0.7, 0.9, 0.35), CF(0, hh - 0.9, L / 2 - 0.1), C.dark)
    hull(V(1.2, 0.5, 0.4), CF(W * 0.28, hh - 0.6, L / 2 + 0.1), RGB(36, 36, 36))
    -- 车灯、牵引钩、工具箱
    for s = -1, 1, 2 do
      hull(V(0.5, 0.35, 0.3), CF(s * W * 0.36, hh - 0.5, -L / 2 + 0.3), RGB(220, 220, 200), MAT.Glass)
      hull(V(0.5, 0.5, 0.6), CF(s * W * 0.22, clear + 0.5, -L / 2 - 0.1), STEEL)
      hull(V(0.9, 0.7, 3.2), CF(s * (W / 2 - 0.5), hh + 0.35, L * 0.22), C.dark)
    end
    if d.era then   -- 首上的反应装甲块
      for i = -3, 3 do
        for j = 0, 1 do hull(V(0.95, 0.35, 0.9), CF(i * 1.05, hh - 0.35 + j * 0.15, -L / 2 + 1.9 + j * 1.0), C.light, MAT.Metal) end
      end
    end
    if d.plow then   -- 扫雷犁
      hull(V(W * 0.92, 1.4, 0.4), CF(0, 0.9, -L / 2 - 1.6) * CFrame.Angles(math.rad(-25), 0, 0), STEEL, MAT.DiamondPlate)
      for i = -3, 3 do hull(V(0.28, 1.0, 1.2), CF(i * 1.3, 0.45, -L / 2 - 2.1), STEEL) end
    end
    if d.boat then   -- 两栖车：前面的防浪板
      hull(V(W * 0.9, 1.8, 0.3), CF(0, hh - 0.3, -L / 2 - 0.3) * CFrame.Angles(math.rad(35), 0, 0), C.dark)
    end
    if d.cab then   -- M270：前面的驾驶室
      hull(V(W * 0.86, 2.6, 5.6), CF(0, hh + 1.3, -L / 2 + 3.2), C.base)
      hull(V(W * 0.8, 1.0, 0.1), CF(0, hh + 1.9, -L / 2 + 0.38), GLASS, MAT.Glass)
    end
    blotches(hull, 0, hh + 0.01, 0, W * 0.8, L * 0.6, "y", 4)
  else
    local bw = W * 0.9
    if d.light then   -- 悍马、JLTV：低车身 + 发动机罩 + 乘员舱
      hull(V(bw, hh * 0.38, L * 0.96), CF(0, clear + hh * 0.19 + 0.3, 0), C.base)
      hull(V(bw * 0.96, 1.2, L * 0.36), CF(0, clear + hh * 0.38 + 0.9, -L * 0.3), C.base, MAT.Metal, "wedge")
      hull(V(bw, hh * 0.42, L * 0.56), CF(0, clear + hh * 0.38 + hh * 0.21 + 0.3, L * 0.14), C.base)
      for s = -1, 1, 2 do
        hull(V(0.08, hh * 0.24, L * 0.36), CF(s * (bw / 2 + 0.02), clear + hh * 0.66, L * 0.12), GLASS, MAT.Glass)
      end
      hull(V(bw * 0.86, hh * 0.24, 0.1), CF(0, clear + hh * 0.66, -L * 0.15), GLASS, MAT.Glass)
    elseif d.truck then   -- 卡车底盘：驾驶室在前、后面平板上装家伙
      hull(V(bw, 0.9, L * 0.96), CF(0, clear + 0.45, 0), C.dark)
      hull(V(bw, 3.4, 5.4), CF(0, clear + 0.9 + 1.7, -L / 2 + 2.8), C.base)
      hull(V(bw * 0.9, 1.2, 0.1), CF(0, clear + 3.0, -L / 2 + 0.06), GLASS, MAT.Glass)
      hull(V(bw, 0.5, L - 6), CF(0, hh - 0.25, 3.0), C.base)
      for s = -1, 1, 2 do hull(V(0.6, 0.35, 0.25), CF(s * bw * 0.36, clear + 1.4, -L / 2 + 0.05), RGB(220, 220, 200), MAT.Glass) end
    else   -- 装甲车：车身 + 前面的斜板 + 车顶
      hull(V(bw, hh - clear - 0.9, L * 0.94), CF(0, clear + (hh - clear - 0.9) / 2, 0.2), C.base)
      hull(V(bw, 1.8, 3.4), CF(0, hh - 0.9 - 0.9 + 0.9, -L / 2 + 1.5), C.base, MAT.Metal, "wedge")
      hull(V(bw, hh - clear - 2.6, 1.6), CF(0, clear + (hh - clear - 2.6) / 2, -L / 2 + 0.7) * CFrame.Angles(0, 0, math.pi), C.dark, MAT.Metal, "wedge")
      hull(V(bw * 0.96, 0.9, L * 0.78), CF(0, hh - 0.45, L * 0.08), C.base)
      hull(V(bw * 0.5, hh - clear - 1.4, 0.3), CF(0, clear + (hh - clear - 1.4) / 2 + 0.3, L / 2 + 0.05), C.dark)   -- 后门
      for s = -1, 1, 2 do
        hull(V(0.5, 0.3, 0.25), CF(s * bw * 0.34, hh - 1.4, -L / 2 + 0.25), RGB(220, 220, 200), MAT.Glass)
        hull(V(0.9, 0.8, 3.0), CF(s * (bw / 2 + 0.2), hh - 1.3, L * 0.2), C.dark)
      end
      if d.boat then hull(V(bw, 1.6, 0.3), CF(0, hh - 0.6, -L / 2 - 0.4) * CFrame.Angles(math.rad(35), 0, 0), C.dark) end
    end
    blotches(hull, 0, hh + 0.01, 0, bw * 0.7, L * 0.5, "y", 3)
  end

  ---------------------------------------------------------------- 炮塔（坐标系：转轴在原点，−Z 朝前）

  local T = d.turret
  local s = T.size
  local st = T.style
  if st == "wedge" or st == "round" or st == "abrams" then
    if st == "round" then
      tur(V(s.Y, s.X * 0.95, s.X * 0.95), CF(0, s.Y / 2, s.Z * 0.02) * UPRIGHT, C.base, MAT.Metal, CYL)
    else
      tur(V(s.X * 0.86, s.Y, s.Z * 0.66), CF(0, s.Y / 2, s.Z * 0.1), C.base)
    end
    -- 前面两块斜的（楔形装甲 / 反应装甲）
    for sx = -1, 1, 2 do
      local blk = tur(V(s.X * 0.36, s.Y * 0.92, s.Z * 0.42), CF(sx * s.X * 0.24, s.Y * 0.47, -s.Z * 0.33) * CFrame.Angles(0, sx * math.rad(st == "abrams" and 12 or 26), 0),
        (d.era and C.light) or C.base)
      if d.era then
        for i = 0, 2 do tur(V(s.X * 0.37, 0.12, 0.9), CF(sx * s.X * 0.24, s.Y * 0.95, -s.Z * 0.2 - i * 1.0), C.dark, MAT.SmoothPlastic) end
      end
    end
    if T.bustle then tur(V(s.X * 0.72, s.Y * 0.78, T.bustle), CF(0, s.Y * 0.45, s.Z / 2 + T.bustle / 2 - 0.4), C.base) end
    -- 舱盖、观瞄、天线
    tur(V(0.25, 1.4, 1.4), CF(d.cupola and d.cupola.X or 1.4, s.Y + 0.12, d.cupola and d.cupola.Z or 0.2) * UPRIGHT, C.dark, MAT.Metal, CYL)
    tur(V(0.25, 1.2, 1.2), CF(-1.2, s.Y + 0.12, 0.6) * UPRIGHT, C.dark, MAT.Metal, CYL)
    tur(V(0.9, 0.8, 1.1), CF(d.sight.X, s.Y + 0.4, d.sight.Z), C.dark)   -- 炮长镜
    tur(V(0.15, 0.15, 1.4), CF(d.sight.X, s.Y + 0.4, d.sight.Z - 0.6) * CFrame.Angles(0, 0, 0), GLASS, MAT.Glass)
    if d.citv then tur(V(1.0, 1.2, 1.0), CF(d.citv.X, s.Y + 0.6, d.citv.Z), C.dark) end
    if not d.rws then   -- 车长机枪（有遥控武器站的换成会转的，下面拼）
      tur(V(0.6, 0.6, 1.4), CF((d.cupola and d.cupola.X or 1.4), s.Y + 0.6, (d.cupola and d.cupola.Z or 0.2) - 0.6), RGB(40, 42, 44))
    end
    for sx = -1, 1, 2 do tur(V(0.1, 7, 0.1), CF(sx * s.X * 0.32, s.Y + 3.5, s.Z * 0.42), RGB(30, 30, 30), MAT.Metal, CYL) end
    blotches(tur, 0, s.Y + 0.01, 0, s.X * 0.6, s.Z * 0.6, "y", 3)
  elseif st == "ifv" then
    tur(V(s.X, s.Y, s.Z * 0.8), CF(0, s.Y / 2, s.Z * 0.1), C.base)
    tur(V(s.X * 0.9, s.Y * 0.9, s.Z * 0.3), CF(0, s.Y * 0.45, -s.Z * 0.45), C.base, MAT.Metal, "wedge")
    tur(V(0.8, 0.7, 0.9), CF(d.sight.X, s.Y + 0.35, d.sight.Z), C.dark)
    tur(V(0.25, 1.1, 1.1), CF(0.9, s.Y + 0.12, 0.6) * UPRIGHT, C.dark, MAT.Metal, CYL)
    if T.tow then tur(V(1.2, 1.4, 3.0), CF(s.X / 2 + 0.6, s.Y * 0.6, 0.4), C.dark) end   -- 布雷德利的陶式发射箱
    if T.pods then
      for sx = -1, 1, 2 do tur(V(1.0, 1.4, 2.4), CF(sx * (s.X / 2 + 0.55), s.Y * 0.6, 0.2), C.dark) end
    end
    tur(V(0.1, 6, 0.1), CF(-s.X * 0.35, s.Y + 3, s.Z * 0.4), RGB(30, 30, 30), MAT.Metal, CYL)
  elseif st == "rws" or st == "ring" then
    if st == "ring" then
      tur(V(0.4, s.X, s.X), CF(0, 0.2, 0) * UPRIGHT, C.dark, MAT.Metal, CYL)
      tur(V(1.8, 1.2, 0.15), CF(0, 1.0, -0.9), C.base)   -- 枪盾
      for sx = -1, 1, 2 do tur(V(0.15, 1.0, 1.0), CF(sx * 0.95, 0.9, -0.5) * CFrame.Angles(0, sx * 0.5, 0), C.base) end
    else
      tur(V(1.3, 0.7, 1.3), CF(0, 0.35, 0), C.dark)
      tur(V(0.7, 0.6, 0.7), CF(0.75, 1.0, -0.2), C.dark)   -- 光电
    end
  elseif st == "spaag" then
    tur(V(s.X * 0.7, s.Y, s.Z), CF(0, s.Y / 2, 0), C.base)
    tur(V(s.X * 0.66, s.Y * 0.7, s.Z * 0.3), CF(0, s.Y * 0.35, -s.Z * 0.55), C.base, MAT.Metal, "wedge")
    -- 后上方的搜索雷达（一直转：标记 Radar）、前面的跟踪雷达
    local rd = tur(V(0.25, 3.4, 1.4), CF(0, s.Y + 1.6, s.Z * 0.3), STEEL, MAT.Metal)
    rd:SetAttribute("Radar", true)
    tur(V(0.3, 0.3, 1.4), CF(0, s.Y + 0.7, s.Z * 0.3), STEEL, MAT.Metal, CYL)
    tur(V(0.6, 1.1, 1.1), CF(0, s.Y + 0.5, -s.Z * 0.3) * ALONG_Z, C.dark, MAT.Metal, CYL)
  elseif st == "vulcan" then
    tur(V(s.X, s.Y * 0.7, s.Z), CF(0, s.Y * 0.35, 0), C.base)
    if T.dome then   -- C-RAM：白色雷达罩
      tur(V(1.8, 1.8, 1.8), CF(0, s.Y + 0.6, 0.8), RGB(230, 230, 225), MAT.SmoothPlastic, BALL)
      tur(V(1.0, 1.8, 1.8), CF(0, s.Y - 0.1, 0.8) * UPRIGHT, RGB(230, 230, 225), MAT.SmoothPlastic, CYL)
    elseif T.radar then
      local rd = tur(V(0.2, 2.4, 1.2), CF(0, s.Y + 1.2, s.Z * 0.35), STEEL)
      rd:SetAttribute("Radar", true)
    else
      tur(V(1.2, 1.0, 0.8), CF(s.X * 0.35, s.Y * 0.85, s.Z * 0.2), C.dark)   -- 测距雷达
    end
  elseif st == "sph" then
    tur(V(s.X, s.Y, s.Z), CF(0, s.Y / 2, 0), C.base)
    tur(V(s.X * 0.96, s.Y * 0.5, 1.6), CF(0, s.Y * 0.75, -s.Z / 2 - 0.4), C.base, MAT.Metal, "wedge")
    for sx = -1, 1, 2 do tur(V(0.1, s.Y * 0.6, 2.2), CF(sx * (s.X / 2 + 0.03), s.Y * 0.45, 0.6), C.dark) end   -- 侧门
    tur(V(0.25, 1.4, 1.4), CF(s.X * 0.28, s.Y + 0.12, s.Z * 0.15) * UPRIGHT, C.dark, MAT.Metal, CYL)
    tur(V(0.6, 0.6, 1.4), CF(s.X * 0.28, s.Y + 0.6, s.Z * 0.15 - 0.6), RGB(40, 42, 44))
    blotches(tur, 0, s.Y + 0.01, 0, s.X * 0.6, s.Z * 0.6, "y", 3)
  elseif st == "launcher" then
    tur(V(s.X * 0.8, 0.8, s.Z * 0.5), CF(0, 0.4, 0), C.dark)
  end

  ---------------------------------------------------------------- 炮（坐标系：耳轴在原点，−Z 朝前，跟着俯仰）

  local Gd = setmetatable({ len = d.gun.len0 or d.gun.len, pivot = d.gun.pivot0 or d.gun.pivot }, { __index = d.gun })   -- 炮管长、耳轴也照型号表原来的
  if st == "launcher" then   -- 发射箱整个跟着起竖：前端一格格的管口
    gun(V(s.X, s.Y, s.Z), CF(0, s.Y / 2 + 0.4, 0), C.base)
    local nx, ny = 3, 2
    for i = 0, nx - 1 do
      for j = 0, ny - 1 do
        gun(V(s.X / nx * 0.8, s.Y / ny * 0.8, 0.1), CF((i - (nx - 1) / 2) * s.X / nx, 0.4 + (j + 0.5) * s.Y / ny, -s.Z / 2 - 0.02), RGB(26, 26, 28))
      end
    end
  elseif Gd.len > 0 then
    if st ~= "rws" and st ~= "ring" then gun(V(math.min(s.X * 0.4, 3.0), Gd.cal * 3.6 + 0.6, 1.6), CF(0, 0, -0.4), C.base) end   -- 防盾
    if Gd.gatling then
      for k = 0, 5 do
        local a = k * math.pi / 3
        tube(gun, math.cos(a) * Gd.cal * 0.55, math.sin(a) * Gd.cal * 0.55, -0.6, -Gd.len, Gd.cal * 0.32, RGB(40, 40, 42))
      end
      tube(gun, 0, 0, -0.6, -1.6, Gd.cal * 1.7, RGB(50, 50, 52))
    elseif T.twin then   -- 双管高炮：炮塔两侧各一门
      for sx = -1, 1, 2 do
        gun(V(1.1, 1.3, 3.0), CF(sx * T.twin / 2, 0, -0.6), C.dark)
        tube(gun, sx * T.twin / 2, 0, -2.0, -Gd.len, Gd.cal, RGB(46, 48, 50))
        tube(gun, sx * T.twin / 2, 0, -Gd.len + 0.6, -Gd.len, Gd.cal * 1.6, RGB(46, 48, 50))
      end
    else
      tube(gun, 0, 0, -0.6, -Gd.len, Gd.cal, RGB(52, 54, 52))
      tube(gun, 0, 0, -0.9, -Gd.len * 0.5, Gd.cal * 1.18, C.base)   -- 热护套
      if Gd.fume then tube(gun, 0, 0, -Gd.len * 0.42, -Gd.len * 0.55, Gd.cal * 1.7, C.base) end
      if Gd.brake then gun(V(Gd.cal * 2.4, Gd.cal * 1.5, Gd.cal * 2.8), CF(0, 0, -Gd.len), RGB(48, 50, 50)) end
    end
    if d.coax then   -- 并列机枪口
      local c = d.coax - Gd.pivot
      tube(gun, c.X, c.Y, -0.2, -1.4, 0.2, RGB(30, 30, 30))
    end
  end

  ---------------------------------------------------------------- 烟幕弹发射筒（和 VehDefs.smokeTubes 一样的位置、朝向）

  local S = d.smoke
  if S then
    for _, b in ipairs(S.banks) do
      local fn = b.hull and hull or tur
      local frame = b.hull and (CF(0, hh, 0) * CF(b.at)) or CF(b.at)
      fn(V(1.1, 0.5, 0.9), frame * CF(0, -0.3, 0.1), C.dark)   -- 发射架
      for i = 1, S.n do
        local fan = (S.n > 1) and ((i - 1) / (S.n - 1) - 0.5) or 0
        local yaw2 = math.rad(b.yaw + fan * 40 * (b.yaw >= 0 and 1 or -1))
        local cf = frame * CF(fan * 0.9, (i % 2) * 0.35, 0) * CFrame.Angles(0, -yaw2, 0) * CFrame.Angles(math.rad(35), 0, 0)
        fn(V(0.85, 0.34, 0.34), cf * CF(0, 0, -0.3) * ALONG_Z, RGB(54, 58, 50), MAT.Metal, CYL)
        fn(V(0.05, 0.26, 0.26), cf * CF(0, 0, -0.74) * ALONG_Z, RGB(20, 20, 20), MAT.SmoothPlastic, CYL)   -- 管口
      end
    end
  end

  -- 零件拼的坦克（M10；还有没导入原模型时的退路）：车长位上拼一个会转的遥控武器站（VehDefs 给的 d.rws）
  if d.rws and d.rws.gun then
    rwsMg(d.rws.gun, d.rws.len or 2.45)
    extra.rpiv, extra.rgpiv = d.rws.pivot, d.rws.gun
  end
  end   -- 零件拼的（没有原模型时）

  -- 扬尘：后轮那里两个隐形发射点
  local dust = {}
  for _, s2 in ipairs({ -1, 1 }) do
    local p = hull(V(0.2, 0.2, 0.2), CF(s2 * W * 0.4, 0.4, L * 0.45), C.base)
    p.Transparency = 1
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
    pe.Rate = 0
    -- 尘柱：一团团往后、往上慢慢胀开、飘好几秒（Arma 里车后那一长条黄土），颜色和浓淡按脚下的地面在 View.lua 里换
    pe.Lifetime = NumberRange.new(2.6, 5.2)
    pe.Speed = NumberRange.new(3, 8)
    pe.SpreadAngle = Vector2.new(40, 25)
    pe.Acceleration = V(0, 1.6, 0)
    pe.Drag = 0.9
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-12, 12)
    pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(0.35, 10), NumberSequenceKeypoint.new(1, 19) })
    pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(0.4, 0.62), NumberSequenceKeypoint.new(1, 1) })
    pe.Color = ColorSequence.new(RGB(170, 146, 110))
    pe.EmissionDirection = Enum.NormalId.Back
    pe.LightInfluence = 1
    pe.Parent = p
    table.insert(dust, pe)
  end

  -- 被毁后的火、黑烟（平时关着）
  local fireP = hull(V(0.2, 0.2, 0.2), CF(0, hh + 0.5, 0), C.base)
  fireP.Transparency = 1
  local fire = Instance.new("ParticleEmitter")
  fire.Texture = "rbxasset://textures/particles/fire_main.dds"
  fire.Rate = 0
  fire.Lifetime = NumberRange.new(0.6, 1.2)
  fire.Speed = NumberRange.new(4, 8)
  fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 1) })
  fire.Color = ColorSequence.new(RGB(255, 170, 60), RGB(255, 80, 30))
  fire.LightEmission = 1
  fire.Parent = fireP
  local black = Instance.new("ParticleEmitter")
  black.Texture = "rbxasset://textures/particles/smoke_main.dds"
  black.Rate = 0
  black.Lifetime = NumberRange.new(4, 7)
  black.Speed = NumberRange.new(6, 10)
  black.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 18) })
  black.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
  black.Color = ColorSequence.new(RGB(30, 30, 30))
  black.Parent = fireP

  -- 夜里的车灯：前面两盏（轮式车是大灯，射灯照前面的路；履带车是暗的灯火管制灯）、后面两盏红尾灯；有人开才亮（View.lua）
  local lamps = {}
  local function lampPart(off, color, size)
    local p = add("hull", V(size, size * 0.7, 0.15), off, color, MAT.Neon)
    p.CastShadow = false
    table.insert(lamps, p)
    return p
  end
  local wheeled = d.arch == "wheeled"
  for sd = -1, 1, 2 do
    local fl = lampPart(CF(sd * d.W * 0.36, d.hullH * 0.62, -d.L / 2 - 0.05), wheeled and RGB(255, 244, 214) or RGB(255, 186, 120), wheeled and 0.55 or 0.3)
    if wheeled then
      local sl = Instance.new("SpotLight")
      sl.Face, sl.Angle, sl.Range, sl.Brightness, sl.Color, sl.Shadows = Enum.NormalId.Front, 55, 70, 3.2, RGB(255, 240, 210), false   -- 自己开的才投影子（View.lua）
      sl.Parent = fl
    end
    local tl = lampPart(CF(sd * d.W * 0.4, d.hullH * 0.55, d.L / 2 + 0.05), RGB(255, 40, 30), 0.32)
    local pl = Instance.new("PointLight")
    pl.Range, pl.Brightness, pl.Color, pl.Shadows = 6, 0.8, RGB(255, 40, 30), false
    pl.Parent = tl
  end

  ---------------------------------------------------------------- 改装（TankMods / EraMeta）
  --   爆反块：原模型上本来就有的区（own）平时不画，只记位置（被炸掉时 View 补焦黑的空位）；没有的（99A 炮塔正面）照 EraMeta 贴上做旧的砖
  --   主动防御：两侧发射器、四角雷达板；车顶加特林（kit 组：跟着炮塔转、跟着炮俯仰，转轴 kpiv）
  local era, kpiv = {}, nil
  local mm = TM.applyDef(d, mods)
  mm = mm and mm.mods
  local L = TM.eraOf(d.id)
  local tp = extra.tpiv or (d.turret and d.turret.pivot) or V()
  if L then
    local kit = RS:FindFirstChild("Imported") and RS.Imported:FindFirstChild("Veh") and RS.Imported.Veh:FindFirstChild("kitera")
    local brickMesh = kit and kit:FindFirstChild("V_kitera__Body_1")
    local function rel(g, cf) if g == "t" then return CF(-tp) * cf end return cf end
    for i, b in ipairs(L.b) do
      local cf, w, h, t = TM.blockCF(L, b, CF(), 0)
      local g = (b[1] == "t") and "turret" or "hull"
      local own = TM.own(L, b)
      local e = { g = g, off = rel(b[1], cf), w = w, h = h, t = t, own = own, parts = {} }
      if not own and extra.imported then
        local col = RGB(b[14], b[15], b[16])
        local base = rel(b[1], cf)
        local function put(size, o, color, mat, shape, tr)
          local p = add(g, size, base * o, color, mat, shape)
          if tr then p.Transparency = tr end
          p.CastShadow = size.Z > 0.1
          table.insert(e.parts, p)
          return p
        end
        if brickMesh and brickMesh:IsA("MeshPart") then   -- 导入了砖的模型（models/veh/kitera.glb：Kontakt-1，evt22，CC-BY；贴图做旧过）
          local mp = Tint.fix(brickMesh:Clone(), brickMesh)
          mp.Anchored, mp.CanCollide, mp.CanQuery, mp.CanTouch = true, false, false, false
          mp.Size = V(w, h, t)
          local off = base * TURN
          mp.CFrame = off
          mp.Parent = m
          table.insert(parts, { mp, g, off })
          table.insert(e.parts, mp)
        else
          -- 零件拼的做旧砖：漆面（比车身暗一点、金属纹理）、底下三成积灰、上沿一道掉漆露出的钢、一两道锈迹、两颗螺栓
          put(V(w, h, t), CF(), col:Lerp(RGB(40, 44, 34), 0.18), MAT.Metal)
          put(V(w * 1.004, h * 0.36, t * 1.02), CF(0, -h * 0.32, 0), RGB(92, 80, 60), MAT.Sand, nil, 0.5)
          put(V(w * 0.94, 0.05, 0.05), CF(0, h / 2 - 0.03, t / 2), RGB(150, 148, 136), MAT.Metal)
          for k = 1, (i % 3 == 0) and 2 or 1 do
            local x = ((i * 37 + k * 53) % 100 / 100 - 0.5) * w * 0.7
            put(V(0.07, h * (0.35 + (k * 0.1)), 0.02), CF(x, h * 0.05, t / 2 + 0.006), RGB(112, 60, 30), MAT.SmoothPlastic, nil, 0.3)
          end
          for sx = -1, 1, 2 do
            put(V(0.07, 0.17, 0.17), CF(sx * (w / 2 - 0.2), h / 2 - 0.17, t / 2 + 0.03) * CFrame.Angles(0, math.pi / 2, 0), RGB(48, 46, 40), MAT.Metal, CYL)
          end
        end
      end
      era[i] = e
    end
    -- 主动防御：发射器（炮塔两侧中段）、雷达板（四角）
    if mm and mm.aps == "hk" and L.aps then
      local dark, olive = RGB(34, 36, 34), C.base:Lerp(RGB(50, 54, 44), 0.35)
      local function frameAt(c, n)
        local up = V(0, 1, 0)
        local rt = up:Cross(n)
        if rt.Magnitude < 0.1 then rt = V(1, 0, 0) end
        rt = rt.Unit
        return CFrame.fromMatrix(c, rt, n:Cross(rt).Unit, n)   -- Z 朝外
      end
      for _, a in ipairs(L.aps.l or {}) do
        local f = CF(-tp) * frameAt(V(a[1], a[2], a[3]), V(a[4], a[5], a[6]).Unit)
        tur(V(0.5, 0.42, 1.0), f * CF(0, 0, 0.2), dark)   -- 支架
        tur(V(1.2, 0.95, 1.55), f * CF(0, 0.05, 0.95), olive)   -- 发射器
        tur(V(1.1, 0.48, 1.45), f * CF(0, 0.52, 0.95), olive:Lerp(RGB(0, 0, 0), 0.15), MAT.Metal, BALL)   -- 圆顶盖
        for k = -1, 1, 2 do   -- 两个发射管（朝外上斜）
          tur(V(0.62, 0.34, 0.34), f * CF(k * 0.3, 0.2, 1.75) * CFrame.Angles(math.rad(-30), math.pi / 2, 0), dark, MAT.Metal, CYL)
        end
        tur(V(0.5, 0.22, 0.04), f * CF(0, -0.18, 1.74), RGB(10, 12, 14), MAT.Glass)   -- 探测窗
      end
      for _, a in ipairs(L.aps.r or {}) do
        local f = CF(-tp) * frameAt(V(a[1], a[2], a[3]), V(a[4], a[5], a[6]).Unit)
        tur(V(1.4, 1.0, 0.2), f * CF(0, 0, 0.12), olive)   -- 雷达板外框
        tur(V(1.18, 0.8, 0.05), f * CF(0, 0, 0.24), RGB(20, 22, 24), MAT.SmoothPlastic)   -- 天线面
        tur(V(0.3, 0.3, 0.5), f * CF(0, -0.6, -0.05), dark)   -- 托架
      end
    end
    -- 车顶 GAU-8 加特林炮塔附件：转轴在炮塔顶左侧（装填手那边），跟着炮俯仰
    if mm and mm.roof == "gau8" then
      kpiv = TM.kitPivot(L)
      local kp = kpiv - tp
      local GM, BL, OD = RGB(52, 54, 50), RGB(28, 29, 28), C.base
      tur(V(0.3, 2.7, 2.7), CF(kp.X, kp.Y - 0.85, kp.Z) * UPRIGHT, BL, MAT.Metal, CYL)   -- 座圈
      tur(V(1.6, 0.7, 1.9), CF(kp.X, kp.Y - 0.45, kp.Z + 0.2), OD)   -- 底座
      local function kg(size, off, color, mat, shape) return add("kit", size, off, color or GM, mat or MAT.Metal, shape) end
      kg(V(1.1, 1.0, 2.5), CF(0, 0, 0.3), OD)   -- 机匣
      kg(V(0.12, 1.2, 2.2), CF(0.62, 0.05, 0.2), OD)   -- 侧护板
      kg(V(0.12, 1.2, 2.2), CF(-0.62, 0.05, 0.2), OD)
      kg(V(0.5, 0.36, 0.6), CF(0.25, 0.68, 0.1), BL)   -- 遥控瞄具
      kg(V(0.3, 0.2, 0.04), CF(0.25, 0.68, -0.21), RGB(14, 16, 20), MAT.Glass)
      for k = 0, 6 do   -- 七根炮管
        local a = k / 7 * math.pi * 2
        local x, y = math.cos(a) * 0.27, math.sin(a) * 0.27
        tube(kg, x, y, -0.95, -TM.KIT_MUZ, 0.16, BL)
      end
      for _, z in ipairs({ -1.25, -3.4, -TM.KIT_MUZ + 0.25 }) do kg(V(0.14, 0.82, 0.82), CF(0, 0, z) * CFrame.Angles(0, math.pi / 2, 0), GM, MAT.Metal, CYL) end   -- 箍
      -- 两个弹鼓（炮塔左侧的架子上）、输弹槽
      local tb = L.tb
      local dx = tb[1] - 0.95 - tp.X
      for _, z in ipairs({ 2.2, 4.6 }) do
        tur(V(2.6, 1.7, 1.7), CF(dx, kp.Y - 1.6, kp.Z + z) * CFrame.Angles(0, 0, 0), RGB(60, 64, 58), MAT.Metal, CYL)
        tur(V(0.12, 1.85, 1.85), CF(dx + 1.3, kp.Y - 1.6, kp.Z + z), BL, MAT.Metal, CYL)
      end
      tur(V(2.6, 0.18, 4.2), CF(dx, kp.Y - 2.5, kp.Z + 3.4), BL)   -- 架子
      tur(V(0.5, 0.35, 2.8), CF((dx + kp.X) / 2, kp.Y - 0.75, kp.Z + 1.6) * CFrame.Angles(0, math.atan2(kp.X - dx, 2.8) * 0.5, 0), GM)   -- 输弹槽
    end
  end

  return { model = m, parts = parts, wheels = wheels, dust = dust, fire = fire, black = black, def = d, lamps = lamps,
    imported = extra.imported, tpiv = extra.tpiv, gpiv = extra.gpiv, travel = extra.travel, rpiv = extra.rpiv, rgpiv = extra.rgpiv,
    era = era, eraL = L, kpiv = kpiv and (kpiv - tp) or nil, mods = mm }
end

-- 爆反块被炸掉的样子（View 调）：砖藏起来，原地一块焦黑的底板、几片翻卷的钢皮、一圈熏黑——返回新加的零件 { 零件, 组, 相对位置 }
function VehModels.eraBlown(M, i)
  local e = M.era and M.era[i]
  if not e or e.blown then return {} end
  e.blown = true
  for _, p in ipairs(e.parts) do p.Transparency = 1 end
  local out = {}
  local function put(size, o, color, mat, tr)
    local p = Instance.new("Part")
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Size, p.Color, p.Material = size, color, mat
    p.Transparency = tr or 0
    p.CastShadow = false
    local off = e.off * o
    p.CFrame = off
    p.Parent = M.model
    table.insert(out, { p, e.g, off })
    return p
  end
  local w, h, t = e.w, e.h, e.t
  -- 砖底下（贴着车身那一面）：焦黑的底板、熏黑的一圈
  put(V(w * 1.25, h * 1.25, 0.05), CF(0, 0, -t / 2 + 0.03), RGB(24, 22, 20), Enum.Material.Slate, 0.15)
  put(V(w * 0.92, h * 0.88, 0.09), CF(0, 0, -t / 2 + 0.07), RGB(40, 37, 33), Enum.Material.CorrodedMetal)
  -- 翻卷的钢皮（几片歪着的薄板）、两颗剩下的螺栓
  for k = 1, 3 do
    local a = (i * 13 + k * 29) % 17 / 17
    put(V(w * 0.22, h * 0.18, 0.04), CF((a - 0.5) * w * 0.8, ((k % 2) - 0.5) * h * 0.6, -t / 2 + 0.16) * CFrame.Angles(math.rad(35 + 30 * a), math.rad(20 * k), 0),
      RGB(70, 66, 58), Enum.Material.CorrodedMetal)
  end
  for sx = -1, 1, 2 do
    put(V(0.12, 0.15, 0.15), CF(sx * (w / 2 - 0.2), h / 2 - 0.17, -t / 2 + 0.12), RGB(44, 42, 38), Enum.Material.Metal)
  end
  return out
end

return VehModels
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">View</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——实体的样子：服务器上只有一个隐形的 Root（位置）和属性（Kind 种类、Team 队伍、Hp 血量……），
--   这里按种类拼一个本地模型，每帧平滑地跟着 Root 走（服务器 10～15 次 / 秒地挪，直接跟会一顿一顿的）；头顶血条
--   机器人步兵（摆腿走路、倒地）、登陆艇（放跳板、被打沉往下沉）、气垫艇、炸药包、地雷
--   地面载具（VehModels 拼的）：每个车轮 / 负重轮各自一个弹簧阻尼（按脚下的地面高度 + 细碎的颠簸，过坡上下抖），
--     车体跟着轮子上下、前后俯仰、左右侧倾（也带弹簧，刹车点头、起步抬头）；炮塔、炮按属性 Ty / Gp 转（自己开的车用本地的），
--     开炮后坐、车轮按走的路转、前轮转向、雷达转、扬尘、被毁冒火冒黑烟；零件一次 BulkMoveTo
--   别的模块能登记自己的样子：G.viewKind[种类] = { build(v, em, team), step(v, dt, camPos), recoil(v), remove(v) }（工事在 FortView）
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local View = {}

function View.init(G)
  local Config = G.Config
  local Map = require(RS:WaitForChild("Map"))
  local Debris = game:GetService("Debris")
  local VD = require(RS:WaitForChild("VehDefs"))
  local VM = require(script.Parent:WaitForChild("VehModels"))
  local V = Vector3.new
  local CF = CFrame.new
  local RGB = Color3.fromRGB
  local me = Players.LocalPlayer

  -- 一个 Model 装所有实体的样子：热成像时整个打一个高亮（Highlight 有数量上限）
  local VF = Instance.new("Model")
  VF.Name = "EntView"
  VF.Parent = workspace
  G.viewFolder = VF

  local function p(m, size, cf, color, mat, shape)
    local x = Instance.new("Part")
    if shape then x.Shape = shape end
    x.Size, x.CFrame, x.Color = size, cf, color
    x.Material = mat or Enum.Material.SmoothPlastic
    x.Anchored, x.CanCollide, x.CanQuery, x.CanTouch = true, false, false, false
    x.TopSurface, x.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    x.Parent = m
    return x
  end

  -- 每种实体：拼零件（相对 Root 的偏移记在 parts 里），每帧额外动（腿、跳板）
  local UNIFORM = { atk = { RGB(150, 128, 92), RGB(110, 96, 70) }, def = { RGB(84, 104, 70), RGB(64, 78, 54) } }
  local KINDS = {}
  -- 机器人：服务器的命中盒高 5.6 格、中心在脚底上 2.8 格
  KINDS.bot = function(m, team)
    local U = UNIFORM[team] or UNIFORM.atk
    local L = {}
    L.torso = { p(m, V(2, 2, 1), CF(), U[1]), CF(0, 0.4, 0) }
    L.vest = { p(m, V(2.15, 1.3, 1.25), CF(), U[2]), CF(0, 0.55, 0) }
    L.head = { p(m, V(1.2, 1.2, 1.2), CF(), RGB(230, 190, 150)), CF(0, 2.0, 0) }
    L.helmet = { p(m, V(1.45, 0.65, 1.45), CF(), U[2], Enum.Material.SmoothPlastic), CF(0, 2.55, 0) }
    -- 夜视仪：头盔前面的支架和双筒（机器人夜里一直戴着、翻下来）
    L.nvg = { p(m, V(0.62, 0.24, 0.3), CF(), RGB(28, 30, 32), Enum.Material.Metal), CF(0, 2.22, -0.78) }
    for sx = -1, 1, 2 do
      L["nvgTube" .. sx] = { p(m, V(0.42, 0.24, 0.24), CF(), RGB(22, 24, 26), Enum.Material.Metal, Enum.PartType.Cylinder),
        CF(sx * 0.17, 2.12, -1.0) * CFrame.Angles(0, math.pi / 2, 0) }
    end
    L.lleg = { p(m, V(0.9, 2, 0.9), CF(), U[2]), CF(-0.5, -1.6, 0), "leg", 1 }
    L.rleg = { p(m, V(0.9, 2, 0.9), CF(), U[2]), CF(0.5, -1.6, 0), "leg", -1 }
    L.larm = { p(m, V(0.8, 1.9, 0.8), CF(), U[1]), CF(-1.2, 0.5, -0.5) * CFrame.Angles(-1.2, 0.35, 0) }
    L.rarm = { p(m, V(0.8, 1.9, 0.8), CF(), U[1]), CF(1.3, 0.5, -0.4) * CFrame.Angles(-1.2, 0, 0) }
    L.gun = { p(m, V(0.35, 0.45, 3.2), CF(), RGB(45, 47, 50), Enum.Material.Metal), CF(0.35, 0.75, -1.7) }
    L.band = { p(m, V(0.85, 0.35, 0.85), CF(), Config.Teams[team or "atk"].color, Enum.Material.Neon), CF(1.3, 1.0, -0.3) }
    return L
  end
  KINDS.lcm = function(m, team)
    local L = {}
    local hull = RGB(96, 104, 98)
    L.bottom = { p(m, V(16, 2, 34), CF(), hull, Enum.Material.Metal), CF(0, -2, 0) }
    L.lwall = { p(m, V(1, 6, 34), CF(), hull, Enum.Material.Metal), CF(-7.5, 1, 0) }
    L.rwall = { p(m, V(1, 6, 34), CF(), hull, Enum.Material.Metal), CF(7.5, 1, 0) }
    L.back = { p(m, V(16, 7, 1), CF(), hull, Enum.Material.Metal), CF(0, 1.5, 16.5) }
    L.cab = { p(m, V(6, 4, 4), CF(), RGB(120, 128, 120), Enum.Material.Metal), CF(0, 5, 14) }
    L.ramp = { p(m, V(15, 6, 0.8), CF(), hull, Enum.Material.Metal), CF(0, 1, -17), "ramp" }
    return L
  end
  -- 726 型气垫艇：黑色气垫围裙、甲板、两侧上层建筑、尾部两个大风扇
  KINDS.lcac = function(m)
    local L = {}
    local grey = RGB(112, 120, 116)
    L.skirt = { p(m, V(28, 3, 48), CF(), RGB(30, 30, 32), Enum.Material.Fabric), CF(0, -1.6, 0) }
    L.deck = { p(m, V(24, 1, 44), CF(), grey, Enum.Material.DiamondPlate), CF(0, 0.2, 0) }
    for s = -1, 1, 2 do
      L["side" .. s] = { p(m, V(3, 4, 40), CF(), grey, Enum.Material.Metal), CF(s * 12.5, 2.3, 0) }
      L["fan" .. s] = { p(m, V(2, 9, 9), CF(), RGB(70, 74, 72), Enum.Material.Metal, Enum.PartType.Cylinder), CF(s * 6, 6, 20) * CFrame.Angles(0, math.pi / 2, 0) }
      L["fin" .. s] = { p(m, V(0.4, 6, 3), CF(), grey, Enum.Material.Metal), CF(s * 6, 6, 23.5) }
    end
    L.bridge = { p(m, V(4, 4, 6), CF(), grey, Enum.Material.Metal), CF(10.5, 6.2, -14) }
    return L
  end
  KINDS.c4 = function(m) return { b = { p(m, V(1.1, 0.5, 0.7), CF(), RGB(176, 156, 112)), CF() }, l = { p(m, V(0.2, 0.2, 0.2), CF(), RGB(255, 40, 40), Enum.Material.Neon), CF(0, 0.3, 0) } } end
  KINDS.mine = function(m) return { b = { p(m, V(0.4, 1.4, 1.4), CF(), RGB(86, 96, 64), Enum.Material.Metal, Enum.PartType.Cylinder), CFrame.Angles(0, 0, math.pi / 2) } } end

  local views = {}   -- [entModel] = { model, parts, cf, kind, t, … }
  G.views = views
  local byId = {}    -- [实体编号] = view（开炮后坐要按编号找）
  G.viewById = function(id) return byId[id] end
  local function bar(m, adornee, h)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(46, 6)
    bb.StudsOffsetWorldSpace = V(0, h or 5, 0)
    bb.MaxDistance = 260
    bb.Adornee = adornee
    bb.Parent = m
    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = RGB(0, 0, 0)
    bg.BackgroundTransparency = 0.4
    bg.BorderSizePixel = 0
    bg.Parent = bb
    local f = Instance.new("Frame")
    f.Size = UDim2.fromScale(1, 1)
    f.BorderSizePixel = 0
    f.Parent = bg
    return bb, f
  end

  local function add(em)
    if views[em] then return end
    local kind = em:GetAttribute("Kind")
    local root = em:FindFirstChild("Root")
    if not root then return end
    local team = em:GetAttribute("Team")
    local v = { cf = root.CFrame, root = root, kind = kind, t = 0, team = team, id = em:GetAttribute("EntId"), em = em }
    local ext = G.viewKind and G.viewKind[kind]   -- 别的模块登记的样子（工事 FortView……）：build 设好 v.model、v.anchor（血条挂点）
    if kind == "veh" then
      local d = VD.get(em:GetAttribute("Model") or "")
      if not d then return end
      local M = VM.build(d, team, em:GetAttribute("Mods"))   -- 坦克改装：发射器、雷达板、加特林、补贴的爆反块（TankMods）
      M.model.Parent = VF
      v.modsAttr = em:GetAttribute("Mods")
      v.M, v.def, v.model = M, d, M.model
      v.ty, v.gp, v.recoil = em:GetAttribute("Ty") or 0, em:GetAttribute("Gp") or 0, 0
      v.bob, v.bobV, v.pitch, v.pitchV, v.roll, v.rollV = 0, 0, 0, 0, 0, 0
      v.speed, v.steer, v.lastPos, v.lastYaw = 0, 0, root.CFrame.Position, 0
      v.plist, v.clist = {}, {}
      for i, it in ipairs(M.parts) do v.plist[i] = it[1] end
      local anchor = Instance.new("Part")   -- 血条挂的点（在车顶上）
      anchor.Size, anchor.Transparency, anchor.Anchored = V(0.2, 0.2, 0.2), 1, true
      anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = false, false, false
      anchor.Parent = M.model
      v.anchor = anchor
      v.bb, v.fill = bar(M.model, anchor, 2)
      v.bb.MaxDistance = 600
    elseif ext then
      if not ext.build(v, em, team) or not v.model then return end
      v.ext = ext
      v.model.Parent = VF
      v.bb, v.fill = bar(v.model, v.anchor, 2)
      v.bb.MaxDistance = 600
    else
      local mk = KINDS[kind]
      if not mk then return end
      local m = Instance.new("Model")
      m.Name = kind
      v.parts = mk(m, team)
      v.model = m
      m.Parent = VF
      v.bb, v.fill = bar(m, v.parts[next(v.parts)][1])
    end
    v.fill.BackgroundColor3 = Config.Teams[team or "atk"].color
    views[em] = v
    if v.id then byId[v.id] = v end
  end

  -- 实体没了：被打死的步兵倒地几秒、被打沉的艇往下沉，其余直接删
  local dying = {}
  local function remove(em)
    local v = views[em]
    if not v then return end
    views[em] = nil
    if v.id then byId[v.id] = nil end
    local hp = em:GetAttribute("Hp") or 1
    if v.ext and v.ext.remove then
      local ok, keep = pcall(v.ext.remove, v)
      if not ok and G.showError then G.showError("local view: " .. tostring(keep)) end
      if ok and keep == true then return end   -- 自己收尾（机器人倒地，Soldier.lua）
    end
    if hp <= 0 and v.kind ~= "veh" and not v.ext then
      v.t0 = os.clock()
      if v.bb then v.bb:Destroy() end
      table.insert(dying, v)
    else
      v.model:Destroy()
    end
  end
  local function stepDying()
    local t = os.clock()
    for i = #dying, 1, -1 do
      local v = dying[i]
      local a = t - v.t0
      if a > ((v.kind == "bot") and 6 or 5) then
        v.model:Destroy()
        table.remove(dying, i)
      else
        local cf
        if v.kind == "bot" then   -- 绕脚底往后倒
          local k = math.clamp(a / 0.45, 0, 1)
          cf = v.cf * CF(0, -2.8, 0) * CFrame.Angles(k * k * 1.45, 0, 0) * CF(0, 2.8 - 0.4 * k, 0)
        else
          cf = v.cf * CF(0, -a * 2.2, 0) * CFrame.Angles(0, 0, a * 0.12)
        end
        for _, L in pairs(v.parts) do L[1].CFrame = cf * L[2] end
      end
    end
  end

  -- 开炮：这辆车的炮往后坐一下；坦克、自行火炮的车体还被后坐力推得一晃（炮朝前开就抬头、朝侧面开就往另一边歪，弹簧摆两下才停——战雷那样）
  function G.vehRecoil(id, g)   -- g：第几门炮（舰艇有前后两门的）
    local v = byId[id]
    if v and v.kind == "veh" then
      local big = v.def.cat == "tank" or v.def.cat == "arty"
      v.recoil = big and 1.7 or 0.35
      if big and not v.wrecked then
        local a = math.rad(v.ty or 0)
        local k = (v.def.cat == "arty") and 0.95 or 0.8
        v.pitchV = (v.pitchV or 0) + k * math.cos(a)
        v.rollV = (v.rollV or 0) + k * math.sin(a)
        v.bobV = (v.bobV or 0) - 2.5
      end
    elseif v and v.ext and v.ext.recoil then v.ext.recoil(v, g) end
  end

  ---------------------------------------------------------------- 弹药殉爆：炮塔连炮整个掀飞（用户：坦克被打爆盖子可以飞起来，动画逼真一点）
  -- 被毁的那一下，座圈里先喷一柱火，炮塔带着炮转着往上飞一两层楼高，落地砸起土、迸火星，弹一两下歪着停住；车体接着烧、殉爆的小炸响几声。
  -- 随机数按车的编号定：每个人看到的是同一个样子
  local TOSS_G = 9.81 * 2.8 * 1.25   -- 重力（格/秒²，略重一点，落得干脆）
  local trackMark   -- 履带印（下面定义）
  local function tossFx(p, big)
    if not G.fxPart then return end
    local part = G.fxPart
    -- 一柱火：从座圈直冲上去
    local h = part(nil, V(0.4, 0.4, 0.4), CFrame.lookAt(p, p + V(0, 1, 0)), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    local fire = Instance.new("ParticleEmitter")
    fire.Texture = "rbxasset://textures/particles/fire_main.dds"
    fire.Rate = 0
    fire.Lifetime = NumberRange.new(0.35, 0.8)
    fire.Speed = NumberRange.new(28, 60)
    fire.SpreadAngle = Vector2.new(14, 14)
    fire.Drag = 1.5
    fire.LightEmission = 1
    fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3.5), NumberSequenceKeypoint.new(0.5, 7), NumberSequenceKeypoint.new(1, 2) })
    fire.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.05), NumberSequenceKeypoint.new(1, 1) })
    fire.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, RGB(255, 246, 200)), ColorSequenceKeypoint.new(0.4, RGB(255, 160, 60)), ColorSequenceKeypoint.new(1, RGB(120, 40, 20)) })
    fire.EmissionDirection = Enum.NormalId.Front
    fire.Parent = h
    fire:Emit(big and 70 or 40)
    -- 火星：往四周上方撒，带重力落下来
    local sp = Instance.new("ParticleEmitter")
    sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    sp.Rate = 0
    sp.Lifetime = NumberRange.new(0.8, 1.8)
    sp.Speed = NumberRange.new(30, 70)
    sp.SpreadAngle = Vector2.new(60, 60)
    sp.Acceleration = V(0, -60, 0)
    sp.LightEmission = 1
    sp.Size = NumberSequence.new(0.35)
    sp.Color = ColorSequence.new(RGB(255, 210, 120))
    sp.EmissionDirection = Enum.NormalId.Front
    sp.Parent = h
    sp:Emit(big and 90 or 50)
    -- 黑烟蘑菇云
    local sm = Instance.new("ParticleEmitter")
    sm.Texture = "rbxasset://textures/particles/smoke_main.dds"
    sm.Rate = 0
    sm.Lifetime = NumberRange.new(2.5, 4.5)
    sm.Speed = NumberRange.new(14, 30)
    sm.SpreadAngle = Vector2.new(30, 30)
    sm.Drag = 1.2
    sm.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 5), NumberSequenceKeypoint.new(1, 20) })
    sm.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
    sm.Color = ColorSequence.new(RGB(34, 30, 28))
    sm.EmissionDirection = Enum.NormalId.Front
    sm.Parent = h
    sm:Emit(big and 26 or 14)
    Debris:AddItem(h, 6)
    if G.flash then G.flash(p + V(0, 6, 0), RGB(255, 170, 80), 70, 14, 0.9) end
    if G.playSound then
      G.playSound("boom", p, 0.5)
      for i = 1, 4 do   -- 车里的炮弹接着一发发殉爆：闷闷的几声
        task.delay(0.5 + i * 0.45 + math.random() * 0.3, function()
          G.playSound("mortar", p, 0.7 + math.random() * 0.3)
          if G.flash then G.flash(p + V(0, 2, 0), RGB(255, 150, 70), 30, 5, 0.25) end
        end)
      end
    end
    if G.shake then
      local cam = workspace.CurrentCamera
      local dd = cam and (cam.CFrame.Position - p).Magnitude or 999
      if dd < 220 then G.shake(0.5 * (1 - dd / 220)) end
    end
  end
  local function landFx(p)
    if not G.fxPart then return end
    local part, tween = G.fxPart, G.tween
    local ring = part(Enum.PartType.Cylinder, V(0.5, 6, 6), CFrame.new(p) * CFrame.Angles(0, 0, math.pi / 2), RGB(120, 106, 84), Enum.Material.SmoothPlastic, 0.35)
    tween(ring, 0.6, { Size = V(0.5, 26, 26), Transparency = 1 })
    Debris:AddItem(ring, 0.65)
    local h = part(nil, V(0.4, 0.4, 0.4), CFrame.lookAt(p, p + V(0, 1, 0)), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    local du = Instance.new("ParticleEmitter")
    du.Texture = "rbxasset://textures/particles/smoke_main.dds"
    du.Rate = 0
    du.Lifetime = NumberRange.new(1, 2.2)
    du.Speed = NumberRange.new(8, 22)
    du.SpreadAngle = Vector2.new(75, 75)
    du.Drag = 2.5
    du.Acceleration = V(0, -4, 0)
    du.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(1, 11) })
    du.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
    du.Color = ColorSequence.new(RGB(140, 124, 98))
    du.EmissionDirection = Enum.NormalId.Front
    du.Parent = h
    du:Emit(22)
    local sp = Instance.new("ParticleEmitter")
    sp.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    sp.Rate = 0
    sp.Lifetime = NumberRange.new(0.3, 0.7)
    sp.Speed = NumberRange.new(20, 40)
    sp.SpreadAngle = Vector2.new(80, 80)
    sp.Acceleration = V(0, -70, 0)
    sp.LightEmission = 1
    sp.Size = NumberSequence.new(0.3)
    sp.Color = ColorSequence.new(RGB(255, 200, 120))
    sp.EmissionDirection = Enum.NormalId.Front
    sp.Parent = h
    sp:Emit(24)
    Debris:AddItem(h, 3)
    if G.playSound then G.playSound("splash", p, 0.35) G.playSound("boom", p, 1.6) end
  end
  G.tossCount = 0   -- 测试用
  local function startToss(v)
    local tF = v.tF
    if not tF then return end
    local seed = tonumber(v.id) or 0
    if seed == 0 then for c in tostring(v.id):gmatch(".") do seed += string.byte(c) end end
    local rng = Random.new(seed * 7919 + 17)
    local ang = rng:NextNumber() * 2 * math.pi
    local hv = V(math.cos(ang), 0, math.sin(ang)) * (5 + rng:NextNumber() * 10)
    v.toss = {
      cf = tF, vel = V(hv.X, 36 + rng:NextNumber() * 18, hv.Z),
      w = V((rng:NextNumber() - 0.5) * 5, (rng:NextNumber() - 0.5) * 7, (rng:NextNumber() - 0.5) * 5),   -- 角速度（弧度/秒，世界坐标）
      bounce = 0, rest = false,
      restTilt = CFrame.Angles((rng:NextNumber() - 0.5) * 0.5, 0, (rng:NextNumber() - 0.5) * 0.6),
    }
    G.tossCount += 1
    tossFx(tF.Position, v.def.cat == "tank")
  end
  local function stepToss(v, dt)
    local T = v.toss
    if not T or T.rest then return end
    dt = math.min(dt, 1 / 20)
    T.vel += V(0, -TOSS_G, 0) * dt
    local p = T.cf.Position + T.vel * dt
    local wm = T.w.Magnitude
    local rot = (wm > 1e-4) and CFrame.fromAxisAngle(T.w.Unit, wm * dt) or CFrame.new()
    local gy = math.max(Map.height(p.X, p.Z), -0.5)
    if p.Y < gy + 0.4 and T.vel.Y < 0 then   -- 砸到地上：弹一下（越弹越低），转得慢下来
      p = V(p.X, gy + 0.4, p.Z)
      T.bounce += 1
      landFx(p)
      if T.bounce >= 3 or math.abs(T.vel.Y) < 9 then
        T.rest = true
        -- 停住：保留水平朝向，歪一点躺着（随机的倾角）
        local look = T.cf.LookVector
        local flat = V(look.X, 0, look.Z)
        flat = flat.Magnitude > 0.05 and flat.Unit or V(0, 0, -1)
        T.cf = CFrame.lookAt(p, p + flat) * T.restTilt
        return
      end
      T.vel = V(T.vel.X * 0.45, -T.vel.Y * 0.32, T.vel.Z * 0.45)
      T.w = T.w * 0.5
    end
    T.cf = CFrame.new(p) * rot * (T.cf - T.cf.Position)
  end
  G.stepToss = stepToss

  -- 履带印：薄薄一片深色的方块贴在地上，淡出后回收（对象池，最多 MAX_MARK 段）
  local MAX_MARK = 360
  local marks, markI = {}, 0
  local markFolder = Instance.new("Folder")
  markFolder.Name = "TrackMarks"
  markFolder.Parent = workspace
  local TweenService = game:GetService("TweenService")
  local markInfo = TweenInfo.new(14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
  function trackMark(cf, w, len)
    markI = markI % MAX_MARK + 1
    local m = marks[markI]
    if not m then
      m = Instance.new("Part")
      m.Anchored, m.CanCollide, m.CanQuery, m.CanTouch, m.CastShadow = true, false, false, false, false
      m.Material = Enum.Material.Ground
      m.Color = Color3.fromRGB(46, 40, 32)
      m.Parent = markFolder
      marks[markI] = m
    end
    if m:GetAttribute("Tw") then m:SetAttribute("Tw", nil) end
    m.Size = V(w, 0.1, len)
    m.CFrame = cf
    m.Transparency = 0.35
    TweenService:Create(m, markInfo, { Transparency = 1 }):Play()
  end
  G.trackMarkCount = function() return #marks end   -- 测试用

  ---------------------------------------------------------------- 载具：悬架

  -- 细碎的颠簸（土路、草地上轮子一跳一跳）：两层噪声，约 ±0.35 格
  local function bump(x, z)
    return 0.22 * math.noise(x / 5.3, z / 5.3, 0.37) + 0.12 * math.noise(x / 2.1, z / 2.1, 4.1)
  end
  local function angDiff(a, b) return (b - a + 180) % 360 - 180 end
  -- 两个 CFrame 差不多一样（位置差不到 0.0005 格、朝向差不到约 0.04°）；有一个是 nil 时两个都得是 nil
  local function sameCF(a, b)
    if a == nil or b == nil then return a == b end
    local dp = a.Position - b.Position
    if dp:Dot(dp) > 2.5e-7 then return false end
    return a.LookVector:Dot(b.LookVector) > 0.9999998 and a.UpVector:Dot(b.UpVector) > 0.9999998
  end

  local function stepVeh(v, dt, camPos)
    local em, d, M = v.em, v.def, v.M
    -- 车灯：有人开、没被打爆才亮
    local lit = (em:GetAttribute("Driver") or 0) ~= 0 and not v.wrecked
    if v.lit ~= lit and M.lamps then
      v.lit = lit
      for _, p in ipairs(M.lamps) do
        p.Transparency = lit and 0 or 0.75
        for _, L in ipairs(p:GetChildren()) do if L:IsA("Light") then L.Enabled = lit end end
      end
    end
    -- 大灯投影子很费（每盏灯每帧画一遍阴影图）：只有自己开的这辆的大灯投影子，别人的照样亮、不投影子
    local mineV = G.myVeh ~= nil and G.myVeh.em == em
    if v.lampShadow ~= mineV and M.lamps then
      v.lampShadow = mineV
      for _, p in ipairs(M.lamps) do
        for _, L in ipairs(p:GetChildren()) do if L:IsA("SpotLight") then L.Shadows = mineV end end
      end
    end
    local own = G.myVeh and G.myVeh.em == em and G.myVeh
    local target = own and own.root or v.root.CFrame
    -- 位置：自己开的直接用本地算的；别人的平滑跟
    if own then v.cf = target else v.cf = G.follow(v, target) end
    local base = v.cf * CF(0, -d.H / 2, 0)
    -- 速度、转弯（别人的车按位置变化估）
    local pos = base.Position
    if own then
      v.speed, v.steer, v.accel = own.speed, own.steer, own.accel or 0
    else
      local delta = pos - v.lastPos
      local sp = delta:Dot(base.LookVector) / math.max(dt, 1e-3)
      v.accel = (sp - v.speed) / math.max(dt, 1e-3)
      v.speed = v.speed + (sp - v.speed) * math.min(1, dt * 6)
      local _, yaw = base:ToEulerAnglesYXZ()
      local yr = angDiff(math.deg(v.lastYaw), math.deg(yaw)) / math.max(dt, 1e-3)
      v.steer = v.steer + (math.clamp(-yr / math.max(d.turn, 1), -1, 1) - v.steer) * math.min(1, dt * 6)
      v.lastYaw = yaw
    end
    v.lastPos = pos
    -- 炮塔、炮
    local ty, gp = em:GetAttribute("Ty") or 0, em:GetAttribute("Gp") or 0
    if own then ty, gp = own.ty, own.gp end
    if own then v.ty, v.gp = ty, gp else
      v.ty = v.ty + angDiff(v.ty, ty) * math.min(1, dt * 10)
      v.gp = v.gp + (gp - v.gp) * math.min(1, dt * 10)
    end
    v.recoil = math.max(0, v.recoil - dt * 2.6)
    -- 遥控武器站：自己开的用本地算的转角，别人的读属性再平滑跟（用户：机枪也要能转动）
    if M.rpiv then
      local my, mp = em:GetAttribute("My") or 0, em:GetAttribute("Mp") or 0
      if own then v.my, v.mp = own.my or 0, own.mp or 0 else
        v.my = (v.my or 0) + angDiff(v.my or 0, my) * math.min(1, dt * 10)
        v.mp = (v.mp or 0) + (mp - (v.mp or 0)) * math.min(1, dt * 10)
      end
    end
    local far = (pos - camPos).Magnitude > 420
    -- 轮子：每个一个弹簧阻尼；远了不算（省事）
    local W = M.wheels
    local rough = 1
    local onWater = Map.height(pos.X, pos.Z) < -1.5
    local sF, nF, sB, nB, sL, nL, sR, nR, sum = 0, 0, 0, 0, 0, 0, 0, 0, 0
    if not far then
      for _, w in ipairs(W) do
        local wp = (base * CF(w.x, 0, w.z)).Position
        local gy = Map.height(wp.X, wp.Z)
        local tgt
        local trv = M.travel or d.travel   -- 原模型的履带车：履带是死的，负重轮只能动一点
        if gy < -0.5 and onWater then tgt = -trv   -- 在水里：轮子垂下去
        else tgt = math.clamp(math.max(gy, -0.5) + bump(wp.X, wp.Z) * rough - wp.Y, -trv, trv) end
        local a = (tgt - w.dy) * 420 - w.vy * 26
        w.vy += a * dt
        w.dy = math.clamp(w.dy + w.vy * dt, -trv * 1.2, trv * 1.2)
        w.spin -= v.speed * dt / (w.rad or w.r)
        sum += w.dy
        if w.z < 0 then sF += w.dy nF += 1 else sB += w.dy nB += 1 end
        if w.x < 0 then sL += w.dy nL += 1 else sR += w.dy nR += 1 end
      end
    end
    local n = math.max(1, #W)
    local wb = math.max(4, (W[#W] and math.abs(W[#W].z - W[1].z)) or d.L * 0.7)
    local trk = math.max(3, d.W * 0.8)
    -- 车体：跟着轮子上下、俯仰、侧倾（弹簧）；起步抬头、刹车点头
    local tBob = sum / n * 0.55
    -- 起步抬头、刹车点头（战雷那样明显一点）
    local tPitch = ((nF > 0 and sF / nF or 0) - (nB > 0 and sB / nB or 0)) / wb * 0.7 + math.clamp((v.accel or 0) * 0.0022, -0.06, 0.06)
    local tRoll = ((nR > 0 and sR / nR or 0) - (nL > 0 and sL / nL or 0)) / trk * 0.7 + math.clamp(v.steer * v.speed * 0.0006, -0.04, 0.04)
    v.bobV += ((tBob - v.bob) * 160 - v.bobV * 14) * dt
    v.bob += v.bobV * dt
    v.pitchV += ((tPitch - v.pitch) * 120 - v.pitchV * 12) * dt
    v.pitch += v.pitchV * dt
    v.rollV += ((tRoll - v.roll) * 120 - v.rollV * 12) * dt
    v.roll += v.rollV * dt
    local hh = d.hullH
    local hullF = base * CF(0, v.bob, 0) * CF(0, hh / 2, 0) * CFrame.Angles(v.pitch, 0, v.roll) * CF(0, -hh / 2, 0)
    local tF = hullF * CF(M.tpiv or d.turret.pivot) * CFrame.Angles(0, -math.rad(v.ty), 0)
    if v.toss then   -- 掀飞了的炮塔自己飞（炮、机枪塔跟着它）
      stepToss(v, dt)
      tF = v.toss.cf
    end
    local gF = tF * CF(M.gpiv or d.gun.pivot) * CFrame.Angles(math.rad(v.gp), 0, 0) * CF(0, 0, v.recoil)
    local rF = M.rpiv and (tF * CF(M.rpiv) * CFrame.Angles(0, -math.rad(v.my or 0), 0)) or nil
    local rgF = (rF and M.rgpiv) and (rF * CF(M.rgpiv) * CFrame.Angles(math.rad(v.mp or 0), 0, 0)) or nil
    v.hullF, v.tF, v.gF, v.rF, v.rgF = hullF, tF, gF, rF, rgF
    local steerA = math.rad(28) * math.clamp(v.steer, -1, 1)
    local now = os.clock()
    -- 爆反块被炸掉（服务器写 EraX："3,7,12"）：那一块换成焦黑的空位（VehModels.eraBlown 新加的零件接到零件表后面）
    local ex = em:GetAttribute("EraX")
    if ex ~= v.eraX then
      v.eraX = ex
      v.putH = nil   -- 新接了零件：这一帧一定要摆
      for i in string.gmatch(ex or "", "%d+") do
        for _, it in ipairs(VM.eraBlown(M, tonumber(i))) do
          table.insert(M.parts, it)
          v.plist[#v.plist + 1] = it[1]
        end
      end
    end
    -- 省事（用户 11-19：游戏非常卡顿）：一辆车一两百个零件，原来每帧全部重摆。停着没动的（停车场、残骸、没人开的、
    --   自己停着没转炮塔）摆好一次就不再挪；420 格外的三帧挪一次（远处看不出来）
    if v.radar == nil then
      v.radar = {}
      for _, it in ipairs(M.parts) do if it[1]:GetAttribute("Radar") then v.radar[it[1]] = true end end
      v.hasRadar = next(v.radar) ~= nil
    end
    local still = not v.hasRadar and not (v.toss and not v.toss.rest) and v.recoil <= 0 and math.abs(v.speed) < 0.01
      and math.abs(v.steer - (v.putSteer or 1e9)) < 1e-4
      and sameCF(hullF, v.putH) and sameCF(tF, v.putT) and sameCF(gF, v.putG) and sameCF(rF, v.putR) and sameCF(rgF, v.putRG)
    if still then
      for _, w in ipairs(W) do if math.abs(w.vy) > 0.003 then still = false break end end
    end
    v.farN = (v.farN or 0) + 1
    if not still and (not far or own or v.farN % 3 == 0) then
      v.putH, v.putT, v.putG, v.putR, v.putRG, v.putSteer = hullF, tF, gF, rF, rgF, v.steer
      local plist, clist = v.plist, v.clist
      for i, it in ipairs(M.parts) do
        local grp, off = it[2], it[3]
        local cf
        if grp == "hull" then cf = hullF * off
        elseif grp == "turret" then
          cf = tF * off
          if v.radar[it[1]] then cf = cf * CFrame.Angles(0, now * 3, 0) end
        elseif grp == "gun" then cf = gF * off
        elseif grp == "rws" then cf = (rF or tF) * off
        elseif grp == "rwg" then cf = (rgF or rF or tF) * off
        elseif grp == "kit" then cf = (M.kpiv and (tF * CF(M.kpiv) * CFrame.Angles(math.rad(v.gp), 0, 0)) or tF) * off   -- 车顶加特林：跟着炮俯仰
        elseif grp == "wheel" then
          local w = W[it[4]]
          local wcf = base * CF(w.x, w.r + w.dy, w.z)
          if w.steer then wcf = wcf * CFrame.Angles(0, -steerA, 0) end
          cf = wcf * CFrame.Angles(w.spin, 0, 0) * off
        elseif grp == "seg" then
          local w = W[it[4]]
          cf = base * CF(0, w.dy, 0) * off
        else cf = hullF * off end
        clist[i] = cf
      end
      workspace:BulkMoveTo(plist, clist, Enum.BulkMoveMode.FireCFrameChanged)
      v.anchor.CFrame = hullF * CF(0, d.H + 1, 0)
      G.viewPuts = (G.viewPuts or 0) + #plist   -- 测试、性能面板用：一共摆了多少个零件
    end
    -- 扬尘：在陆地上开得快才有
    local land = not onWater
    if v.fireLight then v.fireLight.Brightness = 2.2 + math.random() * 1.8 end
    -- 扬尘按脚下的地面：土路、沙地最浓，草地淡一半，石头上更淡（每 0.3 秒看一次地面）
    v.dustT = (v.dustT or 0) - dt
    if v.dustT <= 0 then
      v.dustT = 0.3
      local mat = land and Map.material(pos.X, pos.Z, Map.height(pos.X, pos.Z), Map.slope(pos.X, pos.Z)) or nil
      local k, col = 0.5, nil
      if mat == Enum.Material.Ground then k, col = 1, Color3.fromRGB(168, 142, 104)
      elseif mat == Enum.Material.Sand then k, col = 1, Color3.fromRGB(206, 190, 150)
      elseif mat == Enum.Material.Rock or mat == Enum.Material.Slate then k, col = 0.3, Color3.fromRGB(150, 146, 138)
      else k, col = 0.45, Color3.fromRGB(150, 140, 112) end
      v.dustK = k
      if col and v.dustCol ~= col then
        v.dustCol = col
        for _, pe in ipairs(M.dust) do pe.Color = ColorSequence.new(col) end
      end
    end
    local rate = land and math.clamp((math.abs(v.speed) - 5) * 1.6, 0, 60) * (v.dustK or 0.5) or 0
    for _, pe in ipairs(M.dust) do if math.abs(pe.Rate - rate) > 0.5 then pe.Rate = rate end end
    -- 履带印（用户：坦克驾驶参考战雷）：履带车在地上开过去，两条履带底下每走 3.6 格留一段深色的印子，十几秒慢慢淡掉；
    --   离镜头 260 格以外、在水里、被毁了不留；全部车一共最多 MAX_MARK 段（旧的先收）
    if d.arch == "tracked" and land and not v.wrecked and not far and (pos - camPos).Magnitude < 260 then
      local lp = v.markPos
      if not lp then v.markPos = pos
      elseif (pos - lp).Magnitude >= 3.6 then
        local mid = (pos + lp) / 2
        local dir = pos - lp
        local L = dir.Magnitude
        local trackX = (d.rw and d.rw.x) or d.W * 0.36
        local tw = math.max(1.2, d.W * 0.16)
        for sgn = -1, 1, 2 do
          local o = base.RightVector * (sgn * trackX)
          local p = mid + o
          local gy = Map.height(p.X, p.Z)
          trackMark(CFrame.lookAt(V(p.X, gy + 0.06, p.Z), V(p.X + dir.X, gy + 0.06, p.Z + dir.Z)), tw, L + 0.15)
        end
        v.markPos = pos
      end
    else
      v.markPos = nil
    end
    -- 被毁：烧
    if em:GetAttribute("Wreck") and not v.wrecked then
      v.wrecked = true
      -- 坦克被打爆：炮塔掀飞；别的有炮塔的车四成会（按编号定，大家看到的一样）
      if d.turret and not v.toss then
        local seed = tonumber(v.id) or 0
        if d.cat == "tank" or Random.new(seed * 31 + 7):NextNumber() < 0.4 then startToss(v) end
      end
      M.fire.Rate, M.black.Rate = 30, 12
      if M.fire.Parent then   -- 夜里残骸的火光照亮周围（每帧闪一闪）
        local pl = Instance.new("PointLight")
        pl.Color, pl.Range, pl.Brightness, pl.Shadows = Color3.fromRGB(255, 140, 60), 28, 3, false   -- 投影子的只留最近的一处（stepFireShadows）
        pl.Parent = M.fire.Parent
        v.fireLight = pl
      end
      for _, it in ipairs(M.parts) do
        local part = it[1]
        if part:IsA("MeshPart") then   -- 原模型：贴图盖住颜色，烧黑要先把贴图去掉
          for _, sa in ipairs(part:GetChildren()) do if sa:IsA("SurfaceAppearance") then sa:Destroy() end end
          pcall(function() part.TextureID = "" end)
          part.Color = Color3.fromRGB(40, 38, 36)
        elseif part:IsA("BasePart") then part.Color = part.Color:Lerp(Color3.new(0.05, 0.05, 0.05), 0.65) end
      end
      for _, pe in ipairs(M.dust) do pe.Enabled = false end
    end
  end

  ---------------------------------------------------------------- 跟着实体文件夹

  local function watch(folder)
    for _, em in ipairs(folder:GetChildren()) do task.defer(add, em) end
    folder.ChildAdded:Connect(function(em) task.defer(add, em) end)
    folder.ChildRemoved:Connect(remove)
  end
  task.spawn(function()
    local f = workspace:WaitForChild("Ents", 60)
    if f then watch(f) end
  end)

  local cam = workspace.CurrentCamera
  -- 原模型是进服后陆续复制过来的：先用零件拼的样子建起来的，两秒看一次原模型齐了没有，齐了就重建（用户：很多飞机找不到建模）
  local function rebuild(em)
    local v = views[em]
    if not v then return end
    views[em] = nil
    if v.id then byId[v.id] = nil end
    if v.ext and v.ext.remove then G.try_(v.ext.remove, v) end
    if v.model then v.model:Destroy() end
    add(em)   -- 新建的 solidOn 是空的：下一帧离得近就重新挑实心零件
  end
  local impT = 0
  local function checkImports(dt)
    impT += dt
    if impT < 2 then return end
    impT = 0
    local list = {}
    for em, v in pairs(views) do
      local ok = false
      if v.kind == "veh" then
        ok = v.M ~= nil and not v.M.imported and v.def ~= nil and VM.importedFor(v.def) ~= nil
        if em:GetAttribute("Mods") ~= v.modsAttr then ok = true end   -- 改装属性晚到了（或者换了）：按新的重建
      elseif v.ext and v.ext.importReady then ok = v.ext.importReady(v) == true end
      if ok and em.Parent then table.insert(list, em) end
    end
    for _, em in ipairs(list) do G.try_(rebuild, em) end
  end
  -- 实体对得上模型（用户：模型的实体和模型对不上）：服务器上的实体只有一个方盒（按型号表的长宽高），坦克是炮塔那么高一整块、
  --   飞机连翼尖都框不全、船连桅杆那么高——碰撞改在本机做：离自己的人近的车、飞机、船、工事、气垫艇，把看得见的零件设成实心
  --   （人的物理本来就在本机算，挡人按真正的外形；服务器的方盒只管挨打，不挡人）。很小的、几乎透明的、发光的、转的（旋翼、螺旋桨）、尾焰不算；
  --   自己正开着的那辆不算（人在里面）
  local SOLID_KIND = { veh = true, air = true, ship = true, fort = true, lcac = true }
  -- 一卡一卡（用户 11-18）：原来 280 格内的车、飞机、船全开着碰撞，这些零件每帧都在挪，物理引擎每帧都要重算——
  --   只在步行时、70 格内才开（走路撞得上的就这么近），一帧最多新开一辆（一下子来一群也不顿）
  local SOLID_IN, SOLID_OUT = 70, 95
  local solidBudget = 0
  local function solidSet(v, on)
    if (v.solidOn == true) == on then return end
    v.solidOn = on
    if on then
      local skip = {}
      local M = v.M
      if M then
        for _, key in ipairs({ "blades", "discs", "flames", "strobes", "lamps", "tvc" }) do
          for _, it in ipairs(M[key] or {}) do
            local p = (typeof(it) == "Instance") and it or (type(it) == "table" and (it.p or it[1])) or nil
            if typeof(p) == "Instance" then skip[p] = true end
          end
        end
      end
      local list = {}
      for _, p in ipairs(v.model:GetDescendants()) do
        if p:IsA("BasePart") and not skip[p] and p ~= v.anchor and p.Transparency < 0.9 and p.Material ~= Enum.Material.Neon
          and math.max(p.Size.X, p.Size.Y, p.Size.Z) >= 0.8 then
          p.CanQuery = true   -- 实心的零件 CanQuery 得开着（Roblox 的规定）
          p.CanCollide = true
          list[#list + 1] = p
        end
      end
      v.solidList = list
    else
      for _, p in ipairs(v.solidList or {}) do
        if p.Parent then
          p.CanCollide = false
          p.CanQuery = false
        end
      end
      v.solidList = nil
    end
  end
  G.viewSolid = solidSet
  local function stepSolid(v, here)
    if not SOLID_KIND[v.kind] or not v.model or not v.model.Parent then return end
    local mine = (G.drive and G.drive.em == v.em) or (G.fly and G.fly.em == v.em)
    local onFoot = not G.drive and not G.fly
    local p = (v.cf and v.cf.Position) or v.root.Position
    local d = here and (p - here).Magnitude or math.huge
    local want = onFoot and (not mine) and ((v.solidOn and d < SOLID_OUT) or (not v.solidOn and d < SOLID_IN))
    if want and not v.solidOn then
      if solidBudget <= 0 then return end   -- 这一帧已经开过一辆了：下一帧再开
      solidBudget -= 1
    end
    solidSet(v, want and true or false)
  end

  -- 残骸的火光（点光源）投影子很费（每盏灯每帧画一遍六面的阴影图）：只让离镜头最近、220 格内的那一处投影子，半秒挑一次
  local fireT = 0
  local function stepFireShadows(dt, camPos)
    fireT += dt
    if fireT < 0.5 then return end
    fireT = 0
    local best, bd = nil, 220 * 220
    for _, v in pairs(views) do
      local pl = v.fireLight
      if pl and pl.Parent then
        local dv = pl.Parent.Position - camPos
        local dd = dv:Dot(dv)
        if dd < bd then best, bd = pl, dd end
      end
    end
    for _, v in pairs(views) do
      local pl = v.fireLight
      if pl then
        local want = pl == best and (G.perfK or 1) >= 0.8
        if pl.Shadows ~= want then pl.Shadows = want end
      end
    end
  end

  function G.stepView(dt)
    solidBudget = 1
    stepDying()
    G.try_(stepFireShadows, dt, cam.CFrame.Position)
    G.try_(checkImports, dt)
    local myTeam = me:GetAttribute("Side")
    local camPos = cam.CFrame.Position
    local ch = me.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local here = hrp and hrp.Position or nil
    for em, v in pairs(views) do
      if not em.Parent then
        remove(em)
      else
        local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
        if hp ~= v.hpSeen or mx ~= v.mxSeen then
          v.hpSeen, v.mxSeen = hp, mx
          v.fill.Size = UDim2.fromScale(math.clamp(hp / math.max(1, mx), 0, 1), 1)
        end
        -- 自己开的车、船不挂血条：右下的载具面板有车体血量；坐进瞄准镜（第一人称）时镜头前也不会飘着自己的血条
        local mine = (G.myVeh ~= nil and G.myVeh.em == em) or (G.sail ~= nil and G.sail.em == em)
        local bbOn = hp < mx and hp > 0 and not mine
        if v.bb.Enabled ~= bbOn then v.bb.Enabled = bbOn end
        G.try_(stepSolid, v, here)
        if v.kind == "veh" then
          G.try_(stepVeh, v, dt, camPos)
        elseif v.ext then
          G.try_(v.ext.step, v, dt, camPos)
        else
          local target = v.root.CFrame
          v.cf = G.follow(v, target)
          local moved = v.fl.vel.Magnitude * 0.1   -- 走多快（腿、跳板的动画快慢）：按快照算的速度，一个更新间隔挪多远
          if v.kind == "lcac" and G.lcacUnderMine then   -- 自己正开着的这条气垫艇：按本地算的车底摆（不等服务器，和甲板上的车贴死）
            local mine = G.lcacUnderMine(em:GetAttribute("Carry"))
            if mine then v.cf = mine end
          end
          v.t += dt * math.clamp(moved * 2, 0, 12)
          for _, L in pairs(v.parts) do
            local off = L[2]
            if L[3] == "leg" then off = off * CFrame.Angles(math.sin(v.t * 1.2) * 0.7 * L[4], 0, 0)
            elseif L[3] == "ramp" and em:GetAttribute("Ramp") then off = off * CFrame.Angles(-1.3, 0, 0) end
            L[1].CFrame = v.cf * off
          end
        end
      end
    end
  end
  -- 跟服务器位置（用户 11-18：一卡一卡的）：服务器一秒只挪十来次（飞机按驾驶的人每秒报 15 次），原来每帧往「最新收到的位置」指数逼近——
  --   目标一跳一跳，跟的速度就一阵快一阵慢（十赫兹的顿挫，别人的车、飞机、船、士兵全是）。改成快照插值：记下最近几次收到的位置和收到的时刻，
  --   画面晚一点点（约 1.3 个更新间隔，按实际收到的间隔自己调），在前后两次之间按时间匀速插；跳得太远（传送、重生）直接过去；
  --   停了很久又动：先补一个「上一刻还在原地」的快照，从静止起步，不一下窜出去。返回插好的 CFrame；fl.vel 是按快照算的速度（格 / 秒）
  local FL_N = 6
  function G.follow(v, target, jump)
    local now = os.clock()
    local f = v.fl
    if not f then
      f = { n = 1, t = { now }, c = { target }, gap = 0.1, vel = Vector3.zero }
      v.fl = f
      return target
    end
    local n = f.n
    local last = f.c[n]
    if target ~= last then
      local g = now - f.t[n]
      if (target.Position - last.Position).Magnitude > (jump or 250) then   -- 传送、重生：清空、直接过去
        f.n, f.t, f.c, f.vel = 1, { now }, { target }, Vector3.zero
        return target
      end
      if g < 0.5 then
        f.gap += (math.clamp(g, 0.03, 0.3) - f.gap) * 0.2
      else   -- 停了很久才又动：补一个刚才还在原地的快照
        if n >= FL_N then table.remove(f.t, 1) table.remove(f.c, 1) n -= 1 end
        n += 1
        f.t[n], f.c[n] = now - f.gap, last
      end
      if n >= FL_N then table.remove(f.t, 1) table.remove(f.c, 1) n -= 1 end
      n += 1
      f.t[n], f.c[n] = now, target
      f.n = n
      local dtS = f.t[n] - f.t[n - 1]
      if dtS > 1e-3 then f.vel = f.vel:Lerp((f.c[n].Position - f.c[n - 1].Position) / dtS, 0.5) end
    elseif now - f.t[n] > 0.6 then
      f.vel = Vector3.zero   -- 好一阵没动了：停了
    end
    local rt = now - math.clamp(f.gap * 1.3, 0.06, 0.3)
    if rt >= f.t[n] then return f.c[n] end
    for i = n, 2, -1 do
      local t0 = f.t[i - 1]
      if t0 <= rt then
        return f.c[i - 1]:Lerp(f.c[i], (rt - t0) / math.max(1e-3, f.t[i] - t0))
      end
    end
    return f.c[1]
  end

  -- 准星射线打在「看得见的」实体上（评估后的修改：命中判定）：画面上的小兵、车是 G.follow 插值过的，比服务器的命中盒晚一截，
  --   原来准星射线打的是隐形命中盒，瞄着跑动的小兵身体开枪，射线从命中盒后面擦过去、曳光弹穿过人打在地上；
  --   现在按画面上的位置算（小兵用随姿势变的 Hit 盒，别的用 Root 盒），服务器那边按开枪的人看到的那一刻判定（Rewind.lua）。
  --   返回最近的交点、实体模型、距离；maxLen 以内没有就返回 nil
  local function slab(p, d, h, tmin, tmax)
    if math.abs(d) < 1e-9 then
      if p < -h or p > h then return nil end
      return tmin, tmax
    end
    local t1, t2 = (-h - p) / d, (h - p) / d
    if t1 > t2 then t1, t2 = t2, t1 end
    if t1 > tmin then tmin = t1 end
    if t2 < tmax then tmax = t2 end
    if tmin > tmax then return nil end
    return tmin, tmax
  end
  function G.viewRay(o, dir, maxLen)
    local u = dir.Unit
    local best, bestEm, bestT = nil, nil, maxLen
    for em, v in pairs(views) do
      local root = v.root
      if root and root.Parent and em.Parent and em:GetAttribute("Driver") ~= me.UserId then
        local hb = em:FindFirstChild("Hit") or root
        local cf = ((v.fl and v.cf) or root.CFrame) * root.CFrame:ToObjectSpace(hb.CFrame)   -- 有快照插值的按画面上的位置
        local size = hb.Size
        local rel = cf.Position - o
        local along = rel:Dot(u)
        local r = size.Magnitude / 2
        if along > -r and along < bestT + r and (rel - u * along).Magnitude <= r then
          local lo, ld = cf:PointToObjectSpace(o), cf:VectorToObjectSpace(u)
          local a, b = slab(lo.X, ld.X, size.X / 2, 0, bestT)
          if a then a, b = slab(lo.Y, ld.Y, size.Y / 2, a, b) end
          if a then a, b = slab(lo.Z, ld.Z, size.Z / 2, a, b) end
          if a and a < bestT then best, bestEm, bestT = o + u * a, em, a end
        end
      end
    end
    if best then return best, bestEm, bestT end
    return nil
  end

  -- 一辆车出错不影响别的
  function G.try_(f, ...)
    local ok, err = pcall(f, ...)
    if not ok and G.showError then G.showError("local view: " .. tostring(err)) end
  end
end

return View
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">Warfx</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——战场氛围。用户 11-18：「按照 3A 游戏的标准把这款游戏做到惊艳，自由发挥，参考战雷、战地」（夜晚照旧锁定）
--   1. 照明弹（服务器 Battle.lua 打的，特效 k = "illum"）：按服务器时间算——
--      发射：从舰炮 / 迫击炮那里一颗拖着短尾巴的亮点抛物线飞上去（离镜头远的不画）；炸开：一闪、一小团烟、「噗」一声（按距离晚到）；
--      挂着降落伞慢慢落、随风飘，往上冒烟、往下掉火星，最后几秒逐渐熄灭。
--      照亮：Roblox 的点光源最远 60 格，照明弹在一百多格高——光源放在照明弹正下方离地 40 格的地方跟着走（离镜头最近的那发投影子：
--      影子跟着照明弹慢慢挪），DayNight.lua 按 G.illum 平滑提高附近环境光与曝光。
--   2. 夜空：一层低云；守方要地的对空探照灯慢慢扫；远处时不时的闷炮声（只有声音）
--   3. 房子着火、塌（服务器 Battle.lua）：着火的房子冒火、冒烟、火光一闪一闪；塌的时候扬起一大团尘土、碎块乱飞、轰隆一声；废墟冒一阵烟
--   4. 暴风雨（服务器给强度 StormK）：雨、闪电、雷声，云变厚、浪变大、风变大、雾变近
--   5. 阵亡镜头：死了以后镜头转向凶手、拉近，去色、景深，红色标记
local Warfx = {}

function Warfx.init(G)
  local RunService = game:GetService("RunService")
  local Debris = game:GetService("Debris")
  local Lighting = game:GetService("Lighting")
  local Players = game:GetService("Players")
  local GuiService = game:GetService("GuiService")
  local reducedMotion = false
  pcall(function()
    local function readMotion() reducedMotion = GuiService.ReducedMotionEnabled == true end
    readMotion()
    GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(readMotion)
  end)
  local V = Vector3.new
  local RGB = Color3.fromRGB
  local NSK, CSK = NumberSequenceKeypoint.new, ColorSequenceKeypoint.new
  local MapM = G.Map
  local FXF = G.fxFolder or workspace
  local function camPos() local c = workspace.CurrentCamera return c and c.CFrame.Position or V() end
  local function serverNow()
    local ok, t = pcall(function() return workspace:GetServerTimeNow() end)
    return ok and t or os.clock()
  end
  local TX = {
    glow = "rbxasset://textures/particles/explosion01_implosion_main.dds",
    smoke = "rbxasset://textures/particles/smoke_main.dds",
  }
  local EXP = "rbxasset://sounds/impact_explosion_03.mp3"
  local WIND = "rbxasset://sounds/action_falling.ogg"
  local WARM = RGB(255, 238, 208)

  local function part(shape, size, cf, color, mat, tr)
    local p = Instance.new("Part")
    p.Shape = shape or Enum.PartType.Block
    p.Size = size
    p.CFrame = cf
    p.Color = color
    p.Material = mat or Enum.Material.SmoothPlastic
    p.Transparency = tr or 0
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Parent = FXF
    return p
  end
  local function emitter(h, o)
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = o.tex
    pe.Rate = o.rate or 0
    pe.Lifetime = NumberRange.new(o.life[1], o.life[2])
    pe.Speed = NumberRange.new(o.spd[1], o.spd[2])
    pe.SpreadAngle = Vector2.new(o.spread or 180, o.spread or 180)
    pe.Size = o.size
    pe.Transparency = o.tr
    pe.Color = o.col
    pe.Acceleration = o.acc or V()
    pe.Drag = o.drag or 0
    pe.LightEmission = o.le or 0
    pe.LightInfluence = (o.le or 0) > 0.5 and 0 or 1
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-(o.rot or 20), o.rot or 20)
    pe.ZOffset = o.z or 0
    pe.EmissionDirection = o.dir or Enum.NormalId.Top
    pe.Parent = h
    return pe
  end
  local function nseq(...)
    local a, kp = { ... }, {}
    for i = 1, #a, 2 do kp[#kp + 1] = NSK(a[i], a[i + 1]) end
    return NumberSequence.new(kp)
  end
  local function cseq(a, b) return ColorSequence.new({ CSK(0, a), CSK(1, b) }) end

  ---------------------------------------------------------------- 照明弹

  local GR = V(0, -60, 0)   -- 上升段的「重力」（看着像一发炮弹抛上去，不按真实重力：几秒就到）
  local flares = {}         -- 正在飞 / 烧的
  G.flares = flares         -- 测试用
  local illumK = 0

  -- 照明弹在本地时刻 t（os.clock）的位置：上升段抛物线，炸开后随风飘、慢慢落、轻轻摆
  --   收到时按服务器时间算出它已经飞了多久，换成本地时钟的起点 f.t0（以后只看本地时钟：不受服务器时间抖动影响）
  local function flarePos(f, t)
    local e = f.e
    local u = t - f.t0
    if u < e.fl then
      local v0 = (e.p - e.o - GR * (0.5 * e.fl * e.fl)) / e.fl
      return e.o + v0 * u + GR * (0.5 * u * u), "rise"
    end
    local b = u - e.fl
    local fall = e.fall * b
    if b > e.burn then fall = e.fall * e.burn + (b - e.burn) * e.fall * 4 end   -- 烧完了伞兜不住，掉得快
    local sway = V(math.sin(b * 0.9 + f.ph) * 1.6, 0, math.cos(b * 0.7 + f.ph) * 1.2)
    return e.p + (e.w or V()) * b - V(0, fall, 0) + sway, (b <= e.burn) and "burn" or "out"
  end

  -- 柔和升降亮度，避免把高频闪烁传给整个夜间调色。
  local function flareI(f, b, burn)
    if b < 0 or b > burn then return 0 end
    local up = math.clamp(b / 0.75, 0, 1)
    local tail = math.clamp((burn - b) / 4, 0, 1)
    local glow = reducedMotion and 0.95 or (0.95 + 0.05 * math.sin(b * 2.4 + f.ph))
    return up * glow * tail
  end

  local function popSound(p, d)
    if not G.sfx or d > 3200 then return end
    G.sfx({ { id = EXP, vol = 0.55, s = { 1.9, 2.15 }, reg = { 0.02, 0.28 }, eq = { -6, 0, 0 } },
      { id = EXP, vol = 0.25, s = { 0.9, 1 }, reg = { 0.04, 0.6 }, eq = { 6, -4, -14 }, delay = 0.03 } },
      p, { delay = d / 960, rmin = 120, rmax = 3200, hiCut = -10 * math.clamp((d - 400) / 2000, 0, 1) })
  end

  local function ignite(f, pos, age)
    local d = (pos - camPos()).Magnitude
    if age < 0.65 then
      if not reducedMotion and G.flash and d < 2400 then G.flash(pos, WARM, 50, 2.7, 0.3) end
      popSound(pos, d)
    end
    local core = part(Enum.PartType.Ball, V(0.9, 0.9, 0.9), CFrame.new(pos), RGB(255, 246, 228), Enum.Material.Neon, 0)
    core.Name = "Illum"
    f.core = core
    -- 刺眼的一团光晕（一闪一闪）
    f.halo = emitter(core, { tex = TX.glow, rate = 22, life = { 0.12, 0.2 }, spd = { 0, 0 }, size = nseq(0, 6.5, 1, 9), tr = nseq(0, 0.2, 1, 0.65),
      col = cseq(RGB(255, 250, 236), WARM), le = 1, z = 1 })
    -- 往下掉的火星
    f.sparks = emitter(core, { tex = TX.glow, rate = 7, life = { 0.6, 1.4 }, spd = { 2, 6 }, spread = 35, dir = Enum.NormalId.Bottom, acc = V(0, -40, 0),
      size = nseq(0, 0.4, 1, 0), tr = nseq(0, 0, 1, 0.4), col = cseq(RGB(255, 236, 190), RGB(255, 150, 70)), le = 1 })
    -- 往上飘的白烟柱：被照明弹自己照亮（受光），一条留在半空慢慢散开
    local pk = G.perfK or 1
    if d < 6000 then
      f.smoke = emitter(core, { tex = TX.smoke, rate = (pk < 0.75) and 4 or 9, life = { 9, 15 }, spd = { 0.5, 1.5 }, spread = 25,
        acc = V(0, 0.8, 0) + (f.e.w or V()) * 0.3, drag = 0.3, size = nseq(0, 1.6, 0.3, 4.5, 1, 10), tr = nseq(0, 0.3, 0.6, 0.6, 1, 1),
        col = cseq(RGB(228, 224, 216), RGB(150, 150, 158)), rot = 15 })
    end
    -- 降落伞：一顶白伞 + 一根吊绳
    f.chute = part(Enum.PartType.Ball, V(5.2, 2, 5.2), CFrame.new(pos + V(0, 5.5, 0)), RGB(226, 226, 220), Enum.Material.Fabric, 0)
    f.cord = part(Enum.PartType.Block, V(0.06, 5, 0.06), CFrame.new(pos + V(0, 2.6, 0)), RGB(60, 60, 60), Enum.Material.SmoothPlastic, 0)
    -- 照亮自己周围（烟、伞）的小灯
    local pl = Instance.new("PointLight")
    pl.Range, pl.Brightness, pl.Color, pl.Shadows = 30, 2, WARM, false
    pl.Parent = core
    f.selfLight = pl
    -- 照地面的灯：在照明弹正下方离地 40 格（最远 60 格）
    local anchor = part(Enum.PartType.Block, V(0.2, 0.2, 0.2), CFrame.new(pos), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    local gl = Instance.new("PointLight")
    gl.Range, gl.Brightness, gl.Color, gl.Shadows = 60, 4, WARM, false
    gl.Parent = anchor
    f.anchor, f.groundLight = anchor, gl
    -- 烧着的嘶嘶声
    if G.makeSound and d < 600 then
      f.hiss = G.makeSound({ id = WIND, vol = 2.2, s = { 1.6, 1.8 }, loop = { 0.5, 9.5 }, eq = { -16, 0, 4 } }, core, { rmin = 20, rmax = 260 })
    end
  end

  local function extinguish(f)
    if f.out then return end
    f.out = true
    for _, k in ipairs({ "halo", "sparks", "smoke" }) do if f[k] then f[k].Enabled = false end end
    if f.selfLight then f.selfLight.Enabled = false end
    if f.groundLight then f.groundLight.Enabled = false end
    if f.core then f.core.Transparency = 1 end
    if f.hiss then f.hiss:Stop() end
    if f.core then Debris:AddItem(f.core, 16) end   -- 烟柱的粒子还要飘一会儿
    if f.anchor then Debris:AddItem(f.anchor, 0.1) end
    if f.chute then
      if G.tween then
        G.tween(f.chute, 5, { Transparency = 1 })
        G.tween(f.cord, 5, { Transparency = 1 })
      end
      Debris:AddItem(f.chute, 5.2)
      Debris:AddItem(f.cord, 5.2)
    end
  end

  local function newIllum(e)
    if typeof(e.o) ~= "Vector3" or typeof(e.p) ~= "Vector3" or type(e.t) ~= "number" then return end
    e.fl, e.burn, e.fall = e.fl or 3, e.burn or 30, e.fall or 2.6
    local u = math.max(0, serverNow() - e.t)
    if u > e.fl + e.burn then return end   -- 进服前就烧完了
    local f = { e = e, ph = math.random() * 6.28, t0 = os.clock() - u }
    -- 上升段：一颗拖着短尾巴的亮点（发射点、炸开点都离镜头远的不画）
    local cp = camPos()
    if u < e.fl and math.min((e.o - cp).Magnitude, (e.p - cp).Magnitude) < 2500 then
      local sh = part(Enum.PartType.Ball, V(0.5, 0.5, 0.5), CFrame.new(e.o), RGB(255, 214, 160), Enum.Material.Neon, 0)
      local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
      a0.Position, a1.Position = V(0, 0.25, 0), V(0, -0.25, 0)
      a0.Parent, a1.Parent = sh, sh
      local tr = Instance.new("Trail")
      tr.Attachment0, tr.Attachment1 = a0, a1
      tr.Lifetime, tr.LightEmission, tr.FaceCamera = 0.35, 1, true
      tr.Color = cseq(RGB(255, 226, 180), RGB(255, 150, 80))
      tr.Transparency = nseq(0, 0.2, 1, 1)
      tr.Parent = sh
      f.shell = sh
      if (e.o - cp).Magnitude < 1800 then
        if e.by == "def" then
          if G.playSound then G.playSound("mortar", e.o) end
        elseif G.sfx then
          G.sfx({ { id = EXP, vol = 0.9, s = { 0.62, 0.7 }, reg = { 0, 1.4 }, eq = { 8, 0, -10 } } }, e.o, { delay = (e.o - cp).Magnitude / 960, rmin = 150, rmax = 6000 })
        end
      end
    end
    table.insert(flares, f)
  end

  local function stepFlares()
    if #flares == 0 then
      illumK = 0
      return
    end
    local t = os.clock()
    local cp = camPos()
    local k, nearest, nd = 0, nil, math.huge
    for i = #flares, 1, -1 do
      local f = flares[i]
      local e = f.e
      local pos, ph = flarePos(f, t)
      local b = t - f.t0 - e.fl
      if ph == "rise" then
        if f.shell then f.shell.CFrame = CFrame.new(pos) end
      else
        if f.shell then
          f.shell:Destroy()
          f.shell = nil
        end
        if not f.core and ph == "burn" then ignite(f, pos, b) end
        if not f.groundAt or t >= f.groundAt then
          f.ground = math.max(0, MapM.ground(pos.X, pos.Z))
          f.groundAt = t + 1 / 20
        end
        local gy = f.ground
        local alt = pos.Y - gy
        if f.core and not f.out and (ph == "out" or alt < 3) then extinguish(f) end
        if f.out then
          -- 已熄灭：伞还在掉（落到地上就停）
          if f.chute and f.chute.Parent and alt > 2 then
            f.chute.CFrame = CFrame.new(pos + V(0, 5.5, 0))
            f.cord.CFrame = CFrame.new(pos + V(0, 2.6, 0))
          end
        elseif f.core then
          local I = flareI(f, b, e.burn)
          f.core.CFrame = CFrame.new(pos)
          if f.chute then
            local tilt = CFrame.Angles(math.sin(b * 0.9 + f.ph) * 0.12, 0, math.cos(b * 0.7 + f.ph) * 0.12)
            f.chute.CFrame = CFrame.new(pos + V(0, 5.5, 0)) * tilt
            f.cord.CFrame = CFrame.new(pos + V(0, 2.6, 0)) * tilt
          end
          f.halo.Rate = 22 * math.max(0.2, I)
          f.selfLight.Brightness = 2.4 * I
          f.anchor.CFrame = CFrame.new(pos.X, gy + math.min(alt, 40), pos.Z)
          f.groundLight.Brightness = 4.5 * I
          local d = (pos - cp).Magnitude
          if d < nd then nearest, nd = f, d end
          -- 整片地亮起来：离照明弹 140 格内最亮，700 格外没有
          k += I * math.clamp(1 - (d - 140) / 560, 0, 1)
        end
        if b > e.burn + 6 then table.remove(flares, i) end
      end
    end
    -- 只有离镜头最近的那发投影子（点光源投影子很贵）
    for _, f in ipairs(flares) do
      if f.groundLight then
        local shadows = f == nearest and nd < 900 and not reducedMotion and (G.perfK or 1) >= 0.8
        if f.groundLight.Shadows ~= shadows then f.groundLight.Shadows = shadows end
      end
    end
    illumK = math.min(1.2, k)
  end

  G.illum = { k = 0, col = WARM }
  G.fxExtra = G.fxExtra or {}
  G.fxExtra.illum = newIllum

  ---------------------------------------------------------------- 夜空：低云
  -- Roblox 地形的云（Terrain.Clouds）：一层压得低的深灰蓝的云，月光照着边、遮住一半星星，开飞机能钻进去；机器跟不上（G.perfK 低）就关掉
  local clouds
  pcall(function()
    local T = workspace.Terrain
    clouds = T:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
    clouds.Cover, clouds.Density, clouds.Color = 0.6, 0.5, RGB(66, 72, 88)
    clouds.Parent = T
  end)
  G.nightClouds = clouds   -- 测试用

  ---------------------------------------------------------------- 探照灯
  -- 守方几处要地（指挥部、机场、港口、营地）各两盏对空探照灯：灰绿色的灯筒架在矮杆上，一道淡蓝白的光柱斜着照上天，慢慢来回扫
  --   （二战登陆夜战那种画面）。只是画面：每个客户端自己画，扫的角度按服务器时间算（大家看到的差不多同步）；离镜头 9000 格外的不更新、不画
  local LIGHTS = {}
  G.searchlights = LIGHTS   -- 测试用
  local slFolder = Instance.new("Folder")
  slFolder.Name = "Searchlights"
  slFolder.Parent = FXF
  local function addLight(x, z, ph, az0)
    local gy = math.max(0, MapM.ground(x, z))
    local base = V(x, gy, z)
    local pole = part(Enum.PartType.Block, V(0.8, 7, 0.8), CFrame.new(base + V(0, 3.5, 0)), RGB(48, 52, 46), Enum.Material.Metal, 0)
    pole.Parent = slFolder
    local head = part(Enum.PartType.Cylinder, V(3.2, 3.6, 3.6), CFrame.new(base + V(0, 8.5, 0)), RGB(66, 74, 60), Enum.Material.Metal, 0)
    head.Parent = slFolder
    local lens = part(Enum.PartType.Cylinder, V(0.2, 3.1, 3.1), CFrame.new(base + V(0, 8.5, 0)), RGB(230, 238, 255), Enum.Material.Neon, 0)
    lens.Parent = slFolder
    local a0 = Instance.new("Attachment")
    a0.Parent = lens
    local beams = {}
    for _, spec in ipairs({ { len = 1100, w0 = 3, w1 = 60, a = 0.84 }, { len = 650, w0 = 1.6, w1 = 18, a = 0.7 } }) do
      local a1 = Instance.new("Attachment")
      a1.Position = V(spec.len, 0, 0)   -- 圆柱的轴是 X：灯头朝 +X 照（下面摆灯头时把 +X 转到光的方向）
      a1.Parent = lens
      local b = Instance.new("Beam")
      b.Attachment0, b.Attachment1 = a0, a1
      b.Width0, b.Width1 = spec.w0, spec.w1
      b.FaceCamera, b.LightEmission, b.LightInfluence, b.Segments = true, 1, 0, 1
      b.Color = ColorSequence.new(RGB(226, 234, 255), RGB(190, 206, 240))
      b.Transparency = nseq(0, spec.a, 0.12, spec.a + 0.03, 1, 1)
      b.Parent = lens
      table.insert(beams, b)
    end
    table.insert(LIGHTS, { base = base, head = head, lens = lens, beams = beams, ph = ph, az0 = az0 })
  end
  pcall(function()
    local sites = {}
    if MapM.COMMAND then table.insert(sites, { MapM.COMMAND.x, MapM.COMMAND.z }) end
    if MapM.AIRFIELD then table.insert(sites, { MapM.AIRFIELD.x, MapM.AIRFIELD.z - 160 }) end
    if MapM.PORT then table.insert(sites, { MapM.PORT.x, MapM.PORT.z - 60 }) end
    if MapM.CAMP then table.insert(sites, { MapM.CAMP.x, MapM.CAMP.z }) end
    for i, s in ipairs(sites) do
      -- 朝海（南边，攻方来的方向）照：两盏一左一右、相位错开
      addLight(s[1] - 55, s[2] + 30, i * 1.7, math.rad(160))
      addLight(s[1] + 55, s[2] + 30, i * 1.7 + 2.4, math.rad(200))
    end
  end)

  local function stepLights()
    if #LIGHTS == 0 then return end
    local t = reducedMotion and 0 or serverNow()
    local cp = camPos()
    for _, L in ipairs(LIGHTS) do
      local near = (L.base - cp).Magnitude < 9000
      if L.near ~= near then
        L.near = near
        for _, b in ipairs(L.beams) do b.Enabled = near end
      end
      if near and L.time ~= t then
        L.time = t
        -- 方位角在朝海方向左右各 50° 里慢慢来回，仰角 35°～72°
        local az = L.az0 + math.rad(50) * math.sin(t * 0.11 + L.ph)
        local el = math.rad(53) + math.rad(19) * math.sin(t * 0.17 + L.ph * 1.3)
        local dir = V(math.sin(az) * math.cos(el), math.sin(el), math.cos(az) * math.cos(el))
        local p = L.base + V(0, 8.5, 0)
        local cf = CFrame.lookAt(p, p + dir) * CFrame.Angles(0, math.pi / 2, 0)   -- lookAt 的 −Z 朝 dir；绕 Y 转 90° 以后 +X 朝 dir（圆柱的轴）
        L.head.CFrame = cf
        L.lens.CFrame = cf * CFrame.new(1.65, 0, 0)
      end
    end
  end

  ---------------------------------------------------------------- 远处的炮声
  -- 战地那种「远处还在打」的底噪：每隔 7～16 秒，镜头外三四千格（作战区外、海那边）随机一个方向一声低沉的闷响（放慢、只留低音、长回声），
  --   有时候连着两三声（一轮齐射）。只有声音：不画东西（画了会让人以为那边有人）
  local rumbleAt = os.clock() + 8
  local rumbles = 0
  G.rumbleCount = function() return rumbles end   -- 测试用
  local function stepRumble()
    local t = os.clock()
    if t < rumbleAt then return end
    rumbleAt = t + 7 + math.random() * 9
    if not G.sfx then return end
    local a = math.random() * 2 * math.pi
    local p = camPos() + V(math.cos(a), 0, math.sin(a)) * (3200 + math.random() * 1800)
    local n = (math.random() < 0.35) and math.random(2, 3) or 1
    for i = 1, n do
      G.sfx({ { id = EXP, vol = 0.55, s = { 0.4, 0.48 }, reg = { 0, 2.2 }, eq = { 10, -6, -26 }, echo = { 0.42, 0.45, -8 }, delay = (i - 1) * (0.5 + math.random() * 0.6) } },
        p, { rmin = 2500, rmax = 9000 })
    end
    rumbles += 1
  end

  ---------------------------------------------------------------- 房子着火、塌（服务器 Battle.lua）
  -- 着火：房子模型的属性 Burning（被炸掉一半血）——屋顶那一层冒火、往上冒黑烟、橙色的火光一闪一闪（夜里很远就看得到）；
  --   效果挂在房子模型底下（本地的）：房子塌了被服务器挪走，效果跟着没。每秒查一次属性；房子列表 15 秒重扫一次（新一局复原的房子是新的副本）
  -- 塌：特效 collapse——扬起一大团尘土（往外冲的一圈 + 往上翻的一大团）、十几块碎块真的飞出去落地、轰隆一声（按距离晚到）、近处镜头震
  -- 废墟（Ruins 文件夹里的 Ruin_ 模型）：冒一阵烟、几点余火（90 秒后烟停）
  local FIRE = "rbxasset://textures/particles/fire_main.dds"
  local THUD = "rbxasset://sounds/action_jump_land.mp3"
  local bldList, scanAt = {}, 0
  local burning = {}   -- [模型] = { h, light, ph }
  local ruinFx = {}    -- [模型] = true
  local collapses = 0
  G.collapseCount = function() return collapses end   -- 测试用

  local function decorateFire(m)
    local base, size = m:GetAttribute("BldBase"), m:GetAttribute("BldSize")
    if typeof(base) ~= "CFrame" or typeof(size) ~= "Vector3" then return end
    local h = part(Enum.PartType.Block, V(math.min(size.X, 14) * 0.6, 1, math.min(size.Z, 14) * 0.6), base * CFrame.new(0, size.Y * 0.7, 0), RGB(0, 0, 0), nil, 1)
    h.Name = "BldFire"
    h.Parent = m
    emitter(h, { tex = FIRE, rate = 16, life = { 0.6, 1.2 }, spd = { 3, 7 }, spread = 25, acc = V(0, 8, 0), size = nseq(0, 4.5, 1, 1),
      tr = nseq(0, 0.15, 1, 1), col = cseq(RGB(255, 204, 128), RGB(255, 92, 40)), le = 0.9 })
    emitter(h, { tex = TX.smoke, rate = 4, life = { 7, 11 }, spd = { 4, 8 }, spread = 15, acc = V(1.5, 4, 0.8), size = nseq(0, 4, 1, 18),
      tr = nseq(0, 0.35, 1, 1), col = cseq(RGB(38, 34, 32), RGB(96, 92, 88)), rot = 10 })
    local pl = Instance.new("PointLight")
    pl.Range, pl.Brightness, pl.Color, pl.Shadows = 44, 3, RGB(255, 150, 80), false
    pl.Parent = h
    burning[m] = { h = h, light = pl, ph = math.random() * 6.28 }
  end

  local function decorateRuin(m)
    ruinFx[m] = true
    local ok, cf, size = pcall(function() return m:GetBoundingBox() end)
    if not ok or typeof(cf) ~= "CFrame" then
      local p0 = m:FindFirstChildWhichIsA("BasePart")
      if not p0 then return end
      cf, size = p0.CFrame, V(12, 4, 12)
    end
    local h = part(Enum.PartType.Block, V(math.max(4, size.X * 0.5), 1, math.max(4, size.Z * 0.5)), CFrame.new(cf.Position), RGB(0, 0, 0), nil, 1)
    h.Name = "RuinSmoke"
    h.Parent = m
    local sm = emitter(h, { tex = TX.smoke, rate = 3, life = { 8, 13 }, spd = { 2, 5 }, spread = 25, acc = V(1.2, 2.5, 0.6), size = nseq(0, 5, 1, 16),
      tr = nseq(0, 0.45, 1, 1), col = cseq(RGB(70, 66, 62), RGB(120, 116, 110)), rot = 8 })
    local em = emitter(h, { tex = TX.glow, rate = 4, life = { 0.8, 1.6 }, spd = { 1, 4 }, spread = 40, acc = V(0, 3, 0), size = nseq(0, 0.35, 1, 0),
      tr = nseq(0, 0, 1, 0.5), col = cseq(RGB(255, 190, 110), RGB(255, 110, 50)), le = 1 })
    task.delay(90, function() sm.Enabled = false em.Enabled = false end)
  end

  local function stepBlds()
    local t = os.clock()
    if t >= scanAt then
      scanAt = t + 15
      table.clear(bldList)
      local map = workspace:FindFirstChild("Map")
      local scenery = map and map:FindFirstChild("Scenery")
      if scenery then
        for _, d in ipairs(scenery:GetDescendants()) do
          if d:IsA("Model") and d:GetAttribute("Bld") then table.insert(bldList, d) end
        end
      end
    end
    for _, m in ipairs(bldList) do
      local on = m.Parent ~= nil and m:GetAttribute("Burning") == true
      if on and not burning[m] then
        decorateFire(m)
      elseif not on and burning[m] then
        if burning[m].h.Parent then burning[m].h:Destroy() end
        burning[m] = nil
      end
    end
    for m in pairs(burning) do
      if not m.Parent then burning[m] = nil end
    end
    local rf = workspace:FindFirstChild("Ruins")
    if rf then
      for _, m in ipairs(rf:GetChildren()) do
        if m:IsA("Model") and not ruinFx[m] then decorateRuin(m) end
      end
    end
    for m in pairs(ruinFx) do
      if not m.Parent then ruinFx[m] = nil end
    end
  end

  local function stepBurn()
    local cp = camPos()
    local t = os.clock()
    for _, b in pairs(burning) do
      if b.h.Parent and (b.h.CFrame.Position - cp).Magnitude < 1500 then
        local brightness = reducedMotion and 2.6 or (2.6 + 0.32 * math.sin(t * 3.1 + b.ph))
        if math.abs(b.light.Brightness - brightness) > 0.025 then b.light.Brightness = brightness end
      end
    end
  end

  G.fxExtra.collapse = function(e)
    if typeof(e.p) ~= "Vector3" or typeof(e.s) ~= "Vector3" then return end
    collapses += 1
    local p, s = e.p, e.s
    local gy = (typeof(e.cf) == "CFrame") and e.cf.Position.Y or (p.Y - s.Y / 2)
    local cp = camPos()
    local d = (p - cp).Magnitude
    if G.sfx and d < 5000 then
      G.sfx({ { id = EXP, vol = 1.3, s = { 0.36, 0.42 }, reg = { 0, 2.4 }, eq = { 10, -2, -16 }, echo = { 0.3, 0.35, -8 } },
        { id = THUD, vol = 1.2, s = { 0.32, 0.36 }, eq = { 8, 0, -12 }, delay = 0.25 },
        { id = THUD, vol = 0.9, s = { 0.4, 0.45 }, eq = { 6, 0, -10 }, delay = 0.6 } },
        p, { delay = d / 960, rmin = 80, rmax = 4500, must = true })
    end
    if d < 400 and G.shake and not reducedMotion then G.shake(0.55 * (1 - d / 400)) end
    if d > 4000 then return end
    local w = math.max(s.X, s.Z)
    local h = part(Enum.PartType.Block, V(1, 1, 1), CFrame.new(p.X, gy + 1.5, p.Z), RGB(0, 0, 0), nil, 1)
    -- 往外冲的一圈尘浪：零件绕竖轴转着一颗一颗往前发
    local ring = emitter(h, { tex = TX.smoke, life = { 2.5, 4.5 }, spd = { w * 0.6, w * 1.2 }, spread = 8, drag = 1.6, dir = Enum.NormalId.Front,
      acc = V(0, 1.5, 0), size = nseq(0, w * 0.18, 1, w * 0.55), tr = nseq(0, 0.25, 1, 1), col = cseq(RGB(164, 152, 134), RGB(140, 132, 120)), rot = 20 })
    local base = h.CFrame
    for i = 1, 18 do
      h.CFrame = base * CFrame.Angles(0, (i + math.random() * 0.6) * 2 * math.pi / 18, 0)
      ring:Emit(1)
    end
    h.CFrame = base
    -- 往上翻的一大团
    local col = emitter(h, { tex = TX.smoke, life = { 5, 9 }, spd = { w * 0.25, w * 0.7 }, spread = 50, drag = 1.2, acc = V(1, 3.5, 0.5),
      size = nseq(0, w * 0.3, 0.4, w * 0.75, 1, w * 1.1), tr = nseq(0, 0.12, 0.6, 0.45, 1, 1), col = cseq(RGB(150, 140, 124), RGB(104, 98, 90)), rot = 12 })
    col:Emit(math.floor(10 + w / 3))
    Debris:AddItem(h, 10)
    -- 碎块：真的零件往外飞、落地弹几下（本地物理）
    local n = math.clamp(math.floor(w / 2), 8, 18)
    if (G.perfK or 1) < 0.8 then n = math.floor(n / 2) end
    for i = 1, n do
      local c = Instance.new("Part")
      c.Size = V(0.6 + math.random() * 1.8, 0.5 + math.random() * 1.2, 0.6 + math.random() * 1.8)
      c.Color = (i % 3 == 0) and RGB(64, 58, 52) or RGB(108, 100, 90)
      c.Material = Enum.Material.Concrete
      c.CFrame = CFrame.new(p + V((math.random() - 0.5) * s.X * 0.6, (math.random() - 0.2) * s.Y * 0.4, (math.random() - 0.5) * s.Z * 0.6))
      c.Anchored, c.CanCollide, c.CanQuery, c.CanTouch, c.CastShadow = false, true, false, false, true
      c.Parent = FXF
      local dir = V(math.random() - 0.5, 0, math.random() - 0.5)
      dir = dir.Magnitude > 0.05 and dir.Unit or V(1, 0, 0)
      pcall(function()
        c.AssemblyLinearVelocity = dir * (8 + math.random() * 18) + V(0, 10 + math.random() * 22, 0)
        c.AssemblyAngularVelocity = V(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 12
      end)
      Debris:AddItem(c, 4 + math.random())
    end
  end

  ---------------------------------------------------------------- 暴风雨（服务器 Battle.lua 给强度：workspace 的属性 StormK）
  -- 雨：镜头上方一块看不见的板子往下撒细长的雨丝（顺着速度方向拉长；受光：照明弹、火光、探照灯附近的雨亮晶晶，黑处几乎看不见）；
  --   开飞机飞到云上面（700 格以上）不下。闪电保留远处的短光与雷声，减少动态效果时只保留雷声；
  --   云变厚变黑、海浪变大、风把草吹得乱晃、雾变近（DayNight.lua 读 G.weather.k）；雨声的「沙——」跟着强度
  local stormK = 0
  local rainPart, rainPE, rainSnd
  local rainActive, rainSoundOn = false, false
  local weatherAcc, lastLook = 0, 0
  local nextBolt = 0
  local bolts = 0
  G.boltCount = function() return bolts end   -- 测试用
  G.weather = { k = 0 }
  local stormCloud = RGB(40, 44, 54)
  local T0 = { cover = clouds and clouds.Cover or 0.6, dens = clouds and clouds.Density or 0.5, color = clouds and clouds.Color or RGB(66, 72, 88) }
  local terr = workspace:FindFirstChildOfClass("Terrain")
  local waterSize, waterSpeed, wind

  local function ensureRain()
    if rainPart then return end
    rainPart = part(Enum.PartType.Block, V(86, 1, 86), CFrame.new(0, -500, 0), RGB(0, 0, 0), nil, 1)
    rainPart.Name = "Rain"
    rainPE = emitter(rainPart, { tex = "rbxasset://textures/particles/SquareParticle.png", rate = 0, life = { 0.45, 0.6 }, spd = { 140, 175 }, spread = 6,
      dir = Enum.NormalId.Bottom, size = nseq(0, 0.07, 1, 0.07), tr = nseq(0, 0.45, 1, 0.55), col = cseq(RGB(206, 214, 228), RGB(190, 200, 216)), rot = 0 })
    rainPE.LightEmission, rainPE.LightInfluence = 0.15, 0.85
    rainPE.RotSpeed = NumberRange.new(0, 0)
    rainPE.Rotation = NumberRange.new(0, 0)
    pcall(function() rainPE.Orientation = Enum.ParticleOrientation.VelocityParallel end)
    pcall(function() rainPE.Squash = NumberSequence.new(3) end)   -- 拉成细长的雨丝
  end

  local function drawBolt(x, gy, z)
    local y = math.max(800, gy + 140)
    local pts = { V(x, y, z) }
    while y > gy + 1 do
      y = math.max(gy, y - (60 + math.random() * 70))
      local last = pts[#pts]
      table.insert(pts, V(last.X + (math.random() - 0.5) * 70, y, last.Z + (math.random() - 0.5) * 70))
    end
    local function seg(p0, p1, wdt)
      local L = (p1 - p0).Magnitude
      local s = part(Enum.PartType.Block, V(wdt, wdt, L), CFrame.lookAt((p0 + p1) / 2, p1), RGB(190, 207, 235), Enum.Material.Neon, 0.25)
      if G.tween then G.tween(s, 0.28, { Transparency = 1 }) end
      Debris:AddItem(s, 0.3)
    end
    for i = 1, #pts - 1 do seg(pts[i], pts[i + 1], 1.6) end
    local k0 = math.random(2, math.max(2, #pts - 2))   -- 分叉
    local bp = pts[k0]
    for i = 1, 3 do
      local nb = bp + V((math.random() - 0.5) * 120, -(50 + math.random() * 60), (math.random() - 0.5) * 120)
      seg(bp, nb, 0.9)
      bp = nb
    end
  end

  local function bolt(cp)
    local a = math.random() * 2 * math.pi
    local dist = 1200 + math.random() * 3800
    local x, z = cp.X + math.cos(a) * dist, cp.Z + math.sin(a) * dist
    local gy = math.max(0, MapM.ground(x, z))
    if not reducedMotion then drawBolt(x, gy, z) end
    local d = (V(x, gy, z) - cp).Magnitude
    if G.sfx then
      G.sfx({ { id = EXP, vol = 1.5, s = { 0.3, 0.36 }, reg = { 0, 2.5 }, eq = { 8, -2, -18 }, echo = { 0.5, 0.5, -6 } },
        { id = EXP, vol = 0.9, s = { 0.25, 0.28 }, reg = { 0, 2.5 }, eq = { 10, -4, -24 }, delay = 0.4 } },
        V(x, gy + 50, z), { delay = d / 960, rmin = 4000, rmax = 12000, must = true })
    end
    bolts += 1
  end

  local function stepRain(k, cp, look)
    if k > 0.01 then ensureRain() end
    if not rainPE then return end
    local active = k > 0.01 and cp.Y <= 700
    if active then
      local target = cp + V(look.X * 20, 38, look.Z * 20)
      if (rainPart.CFrame.Position - target).Magnitude >= 0.5 then rainPart.CFrame = CFrame.new(target) end
    elseif rainActive then
      pcall(function() rainPE:Clear() end)
    end
    rainActive = active
    local budget = G.mobile and 100 or 400
    if reducedMotion then budget = G.mobile and 68 or 120 end
    local rate = active and math.floor(budget * k * math.clamp(G.perfK or 1, 0.4, 1)) or 0
    if rainPE.Rate ~= rate then rainPE.Rate = rate end

    if active then
      if not rainSnd and G.makeSound then
        rainSnd = G.makeSound({ id = WIND, vol = 0.01, s = { 1.25, 1.3 }, loop = { 0.5, 9.5 }, eq = { -24, -4, 5 } }, game:GetService("SoundService"), {})
        rainSoundOn = rainSnd ~= nil
      end
      if rainSnd then
        local volume = k * 1.4
        if math.abs(rainSnd.Volume - volume) >= 0.015 then rainSnd.Volume = volume end
        if not rainSoundOn then rainSnd:Play() rainSoundOn = true end
      end
    elseif rainSoundOn then
      rainSnd:Stop()
      rainSoundOn = false
    end
  end

  local function setWeatherLook(k)
    if k == lastLook or (k > 0 and math.abs(k - lastLook) < 0.012) then return end
    if lastLook == 0 then
      if terr then waterSize, waterSpeed = terr.WaterWaveSize, terr.WaterWaveSpeed end
      pcall(function() wind = workspace.GlobalWind end)
    end
    lastLook = k
    if clouds then
      clouds.Cover = T0.cover + (0.9 - T0.cover) * k
      clouds.Density = T0.dens + (0.82 - T0.dens) * k
      clouds.Color = T0.color:Lerp(stormCloud, k)
    end
    if terr then
      terr.WaterWaveSize = waterSize + (0.55 - waterSize) * k
      terr.WaterWaveSpeed = waterSpeed + (18 - waterSpeed) * k
    end
    if wind then pcall(function() workspace.GlobalWind = wind:Lerp(V(20, 0, 10), k) end) end
  end

  local function stepStorm(dt)
    local target = workspace:GetAttribute("StormK")
    target = type(target) == "number" and math.clamp(target, 0, 1) or 0
    stormK += (target - stormK) * (1 - math.exp(-dt * 0.8))
    if math.abs(target - stormK) < 0.005 then stormK = target end
    G.weather.k = stormK
    local cam = workspace.CurrentCamera
    if cam and (stormK > 0 or rainActive) then
      local cf = cam.CFrame
      stepRain(stormK, cf.Position, cf.LookVector)
      if stormK > 0.4 and os.clock() >= nextBolt then
        nextBolt = os.clock() + (5 + math.random() * 9) / stormK
        bolt(cf.Position)
      end
    elseif rainActive then
      stepRain(0, V(), V())
    end
    weatherAcc += dt
    if weatherAcc >= 0.12 then
      weatherAcc %= 0.12
      setWeatherLook(stormK)
    end
  end

  ---------------------------------------------------------------- 阵亡镜头（服务器 Battle.lua 的 G.killcam 发来 killcam）
  -- 阵亡后短暂转向事件来源。减少动态效果、重新部署、主菜单和镜头切换均优先接管。
  local player = Players.LocalPlayer
  local kc = nil
  local kcN = 0
  G.killcamCount = function() return kcN end   -- 测试用
  G.killcamOn = function() return kc ~= nil end
  local function smooth(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end

  local function endKillcam()
    if not kc then return end
    local shot = kc
    kc = nil
    pcall(function() RunService:UnbindFromRenderStep("Killcam") end)
    if workspace.CurrentCamera == shot.cam then shot.cam.FieldOfView = shot.fov0 end
    for _, o in ipairs(shot.objs) do if o.Parent then o:Destroy() end end
  end

  local function stepKillcam()
    if not kc then return end
    local u = os.clock() - kc.t0
    local cam = workspace.CurrentCamera
    local character = player.Character
    local round = G.S and G.S.round
    if u > 3.2 or reducedMotion or cam ~= kc.cam or (character and character ~= kc.character)
      or (kc.round and round and kc.round ~= round) or (G.menuShown and G.menuShown()) then
      endKillcam()
      return
    end
    local angle = smooth(u / 0.85)
    cam.CFrame = kc.fromView:Lerp(kc.focusView, angle)
    cam.FieldOfView = kc.fov0 + (kc.fovZ - kc.fov0) * smooth((u - 0.45) / 1.1)
  end

  local function startKillcam(e)
    if reducedMotion or (G.menuShown and G.menuShown()) or type(e) ~= "table" or typeof(e.p) ~= "Vector3" then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local from = (typeof(e.from) == "Vector3") and e.from or cam.CFrame.Position
    local d = (e.p - from).Magnitude
    if d < 3 or d > 2500 then return end
    endKillcam()
    kcN += 1
    -- 视野收到凶手周围约 14 格（远的拉得多），最窄 8°
    local fov = cam.FieldOfView
    local fovZ = math.clamp(math.deg(2 * math.atan(14 / d)), math.min(8, fov), fov)
    local eye = from + V(0, 0.4, 0)
    kc = { t0 = os.clock(), cam = cam, character = player.Character, round = G.S and G.S.round,
      fromView = CFrame.new(eye) * cam.CFrame.Rotation, focusView = CFrame.lookAt(eye, e.p),
      fov0 = fov, fovZ = fovZ, objs = {} }
    -- 凶手头顶的标记
    local anchor = part(Enum.PartType.Block, V(0.2, 0.2, 0.2), CFrame.new(e.p + V(0, 4.5, 0)), RGB(0, 0, 0), nil, 1)
    anchor.Name = "KillcamTag"
    table.insert(kc.objs, anchor)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(240, 64)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Adornee = anchor
    bb.Parent = anchor
    local mark = Instance.new("Frame")
    mark.Size = UDim2.fromOffset(16, 16)
    mark.AnchorPoint = Vector2.new(0.5, 0.5)
    mark.Position = UDim2.new(0.5, 0, 1, -10)
    mark.Rotation = 45
    mark.BackgroundColor3 = RGB(230, 52, 46)
    mark.BorderSizePixel = 0
    mark.Parent = bb
    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.new(1, 0, 0, 36)
    lab.BackgroundTransparency = 1
    lab.Font = Enum.Font.GothamBold
    lab.TextSize = 18
    lab.TextColor3 = RGB(255, 236, 232)
    lab.TextStrokeTransparency = 0.4
    lab.Text = string.format("%s  ·  %d m", tostring(e.name or "?"), math.floor(d / 2.8 + 0.5))
    lab.Parent = bb
    -- 真人：一圈红色描边
    if type(e.uid) == "number" then
      local pl = Players:GetPlayerByUserId(e.uid)
      local ch = pl and pl.Character
      if ch then
        local hl = Instance.new("Highlight")
        hl.FillColor, hl.OutlineColor = RGB(230, 52, 46), RGB(255, 90, 80)
        hl.FillTransparency, hl.OutlineTransparency = 0.8, 0
        hl.Adornee = ch
        hl.Parent = ch
        table.insert(kc.objs, hl)
      end
    end
    -- 去色 + 景深（对准凶手）
    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "KillcamGrade"
    cc.Saturation, cc.Contrast, cc.TintColor = -0.55, 0.12, RGB(255, 228, 222)
    cc.Parent = Lighting
    table.insert(kc.objs, cc)
    pcall(function()
      local dof = Instance.new("DepthOfFieldEffect")
      dof.Name = "KillcamFocus"
      dof.FocusDistance, dof.InFocusRadius, dof.FarIntensity, dof.NearIntensity = d, math.max(8, d * 0.15), 0.55, 0.75
      dof.Parent = Lighting
      table.insert(kc.objs, dof)
    end)
    RunService:BindToRenderStep("Killcam", Enum.RenderPriority.Camera.Value + 20, function()
      local ok, err = pcall(stepKillcam)
      if not ok then
        endKillcam()
        if G.showError then G.showError("阵亡镜头：" .. tostring(err)) end
      end
    end)
  end
  local prevMsg = G.onMsg
  G.onMsg = function(kind, key, ...)
    if kind == "killcam" then
      local ok, err = pcall(startKillcam, key)
      if not ok then
        endKillcam()
        if G.showError then G.showError("阵亡镜头：" .. tostring(err)) end
      end
      return
    end
    if prevMsg then return prevMsg(kind, key, ...) end
  end

  local acc, bAcc = 0, 0
  G.frameConn("Warfx", function(dt)
    local okS, errS = pcall(stepStorm, dt or 1 / 60)
    if not okS and G.showError then G.showError("暴风雨：" .. tostring(errS)) end
    local ok, err = pcall(stepFlares)
    if not ok and G.showError then G.showError("照明弹：" .. tostring(err)) end
    G.illum.k = illumK
    acc += dt or 1 / 60
    if acc >= 1 / 30 then   -- 探照灯、远处的炮声：一秒 30 次就够
      acc = 0
      local ok2, err2 = pcall(function()
        stepLights()
        stepRumble()
        stepBurn()
        if clouds then
          local enabled = (G.perfK or 1) >= 0.7
          if clouds.Enabled ~= enabled then clouds.Enabled = enabled end
        end
      end)
      if not ok2 and G.showError then G.showError("战场氛围：" .. tostring(err2)) end
    end
    bAcc += dt or 1 / 60
    if bAcc >= 1 then   -- 房子着火、废墟：一秒查一次
      bAcc = 0
      local ok3, err3 = pcall(stepBlds)
      if not ok3 and G.showError then G.showError("房子：" .. tostring(err3)) end
    end
  end)
end

return Warfx
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="117">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
  <Item class="Lighting" referent="118">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="Brightness">2.2</float>
      <float name="ClockTime">2.3</float>
      <float name="EnvironmentDiffuseScale">1</float>
      <float name="EnvironmentSpecularScale">1</float>
      <bool name="GlobalShadows">true</bool>
      <token name="Technology">4</token>
    </Properties>
  </Item>
</roblox>
