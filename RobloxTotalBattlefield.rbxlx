  TG.box = ui.frame(disp, UDim2.fromOffset(52, 52), UDim2.fromScale(0.5, 0.5), RGB(0, 0, 0), 1, Vector2.new(0.5, 0.5))
  TG.box.Name = "TrackBox"
  TG.box.ZIndex = 12
  TG.boxStroke = ui.stroke(TG.box, MFD, 1.5, 0)
