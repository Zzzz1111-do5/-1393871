    ["faction.sub"] = "НОЧНАЯ ОПЕРАЦИЯ · ДЕСАНТ НА АРХИПЕЛАГ",
    ["faction.sub@city"] = "СТАЛЬНОЙ ГОРОД · ГОРОДСКОЙ ТАНКОВЫЙ БОЙ",
    ["faction.sub@sands"] = "МОРЕ ПЕСКА · ТАНКОВЫЙ ШТУРМ",
