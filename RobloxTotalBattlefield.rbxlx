    ["coach.brake"] = "剎車",
    ["coach.card.arty.1"] = "滑鼠指向要打的地方，旁邊寫著距離和射程",
    ["coach.card.arty.2"] = "左鍵開炮，炮彈要飛幾秒才落地",
    ["coach.card.arty.3"] = "右鍵放大看落點，空格離開",
    ["coach.card.fort.1"] = "滑鼠瞄準，左鍵開火",
    ["coach.card.fort.2"] = "右鍵 / V 瞄準鏡，滾輪調倍率",
    ["coach.card.fort.3"] = "空格離開炮位",
    ["coach.card.heli.1"] = "先等旋翼轉起來（平顯上的轉速到 100%）",
    ["coach.card.heli.2"] = "按住 W 升、S 降（同戰雷）；準心往下機頭前傾往前飛，準心往上往後仰減速；A / D 側飛、Q / E 轉機頭",
    ["coach.card.heli.3"] = "速度有慣性：不會馬上停，準心往上一抬機頭後仰剎車。左鍵機炮，F 火箭 / 導彈，空格下飛機",
    ["coach.card.jet.1"] = "Shift 推油門（推滿進加力），A / D 在跑道上轉向，油門收到底按住 Ctrl 倒退",
    ["coach.card.jet.2"] = "速度到 {1} km/h 按住 S 抬頭離地，起落架會自動收起；W 低頭、S 抬頭、A / D 滾轉，壓坡度再拉 S 就轉彎",
    ["coach.card.jet.3"] = "左鍵機炮（打機頭標記那裡），F 導彈（1–6 換掛載，先鎖定），X 熱誘彈；回去降落：G 放起落架、Ctrl 收油門、機頭對著跑道，停穩就補彈修理",
    ["coach.card.lcac.1"] = "W / S 油門，A / D 轉向：越快越靈，轉彎會甩尾",
    ["coach.card.lcac.2"] = "開到海灘、衝上沙灘，車會自動放下來",
    ["coach.card.lcac.3"] = "接著開車從艇首開下去；空格下車",
    ["coach.card.ship.1"] = "W / S 調車鍾，一檔一檔加減速；A / D 轉舵——船大，轉得慢",
    ["coach.card.ship.2"] = "滑鼠瞄準、左鍵開火：1 艦炮，2 反艦導彈（R 鎖定）",
    ["coach.card.ship.3"] = "右鍵 / V 望遠鏡，N 夜視，空格下船",
    ["coach.card.uav.1"] = "你端著平板遙控無人機，人還站在原地——當心被打",
    ["coach.card.uav.2"] = "滑鼠管方向，W / S 加速減速，A / D 滾轉",
    ["coach.card.uav.3"] = "右鍵 / V 切鏡頭、Z 變焦，F 發導彈，空格收起平板",
    ["coach.card.veh.1"] = "W / S 前進後退，A / D 轉向（履帶車能原地打轉）",
    ["coach.card.veh.2"] = "滑鼠轉炮塔瞄準，左鍵開火，數字鍵選彈種 / 武器（看底下的彈藥欄）",
    ["coach.card.veh.3"] = "Shift 進瞄準鏡（V 切夜視 / 熱成像），M 放煙幕，空格下車",
