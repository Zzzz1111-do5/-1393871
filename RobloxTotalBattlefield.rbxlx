  intake = "dsi", intakeZ = -8, intakeW = 2.4,
  wing = { xr = 3.0, zr0 = -4, zr1 = 20, xt = 18, zt0 = 12.5, zt1 = 16.5, y = 0.2 }, elevon = true,
