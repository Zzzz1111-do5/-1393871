  cshrub = { kind = "bush", h = 15.35, r = 9.22, o = { 8.65, 0, 107.04 }, tris = 6199, parts = { { name = "Bark", c = { 0, 6.76, 0 }, s = { 11.91, 12.68, 12.59 } }, { name = "Leaves", c = { -0.24, 7.68, -0.4 }, s = { 16.82, 15.35, 17.62 } } } },
  sapling = { kind = "bush", h = 8.59, r = 2.68, o = { 39.41, 0, 100.26 }, tris = 729, parts = { { name = "Bark", c = { 0, 3.24, 0 }, s = { 2.35, 6.48, 2.1 } }, { name = "Leaves", c = { -0.18, 4.45, 0.12 }, s = { 4.83, 8.28, 5.12 } } } },
  deadfir = { kind = "dead", h = 45.07, r = 11.43, o = { 72.74, 0, 109.25 }, tris = 900, parts = { { name = "Bark", c = { 0, 22.54, 0 }, s = { 22.19, 45.07, 22.86 } } } },
  log = { kind = "log", h = 2.18, r = 8.23, o = { 112.07, 0, 105.21 }, tris = 320, parts = { { name = "Bark", c = { 0, 1.09, 0 }, s = { 16.46, 2.18, 14.77 } } } },
  rock1 = { kind = "rock", h = 8.08, r = 4.76, o = { 145.06, 0, 102.52 }, tris = 768, parts = { { name = "Body", c = { 0, 4.04, 0 }, s = { 9.51, 8.08, 9.4 } } } },
  rock2 = { kind = "rock", h = 8.08, r = 5.01, o = { 174.82, 0, 102.69 }, tris = 768, parts = { { name = "Body", c = { 0, 4.04, 0 }, s = { 10.02, 8.08, 9.72 } } } },
  rock3 = { kind = "outcrop", h = 10.46, r = 8.22, o = { 207.14, 0, 106.05 }, tris = 1400, parts = { { name = "Body", c = { 0, 5.23, 0 }, s = { 14.62, 10.46, 16.45 } } } },
  birch1 = { kind = "broad", h = 48.12, r = 14.2, o = { 246.83, 0, 110.81 }, tris = 2548, parts = { { name = "Bark", c = { 0, 21.05, 0 }, s = { 13.75, 42.09, 14.7 } }, { name = "Leaves", c = { 0.42, 28.27, 0.6 }, s = { 25.59, 39.7, 27.19 } } } },
  birch2 = { kind = "broad", h = 55.82, r = 13.15, o = { 12.37, 0, 158.16 }, tris = 2944, parts = { { name = "Bark", c = { 0, 25.18, 0 }, s = { 13.15, 50.36, 15.11 } }, { name = "Leaves", c = { -0.02, 34.67, -0.37 }, s = { 24.69, 42.31, 25.56 } } } },
  oak = { kind = "broad", h = 47.7, r = 25.8, o = { 70.5, 0, 169.27 }, tris = 3150, parts = { { name = "Bark", c = { 0, 18.51, 0 }, s = { 33, 37.03, 27.93 } }, { name = "Leaves", c = { -2.19, 27.06, 0.08 }, s = { 47.22, 41.29, 48.67 } } } },
  maple = { kind = "broad", h = 49.62, r = 23, o = { 133.42, 0, 166.88 }, tris = 3438, parts = { { name = "Bark", c = { 0, 19.83, 0 }, s = { 22.55, 39.67, 21.67 } }, { name = "Leaves", c = { 0.75, 27.95, -0.1 }, s = { 44.5, 43.34, 43.53 } } } },
  dshrub = { kind = "bush", h = 10.82, r = 7.35, o = { 182.56, 0, 152.2 }, tris = 3421, parts = { { name = "Bark", c = { 0, 4.03, 0 }, s = { 10.17, 7.46, 9.99 } }, { name = "Leaves", c = { 0.6, 5.41, -0.02 }, s = { 13.49, 10.82, 14.33 } } } },
