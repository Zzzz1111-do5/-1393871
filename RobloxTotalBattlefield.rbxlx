  old = { a10c = { "a10_v3", "a10_v2", "a10" }, ah64e = { "ah64" }, b2 = { "b2_v3", "b2_v2", "b2" }, f16 = { "f16_v2", "f16" }, f22 = { "f22a", "f22_v3", "f22_v2", "f22" }, f35 = { "f35_v3", "f35_v2", "f35" }, gj11 = { "x47b_v3~", "x47b_v2~", "x47b~" }, gj2 = { "mq9_v4~", "mq9_v3~", "mq9_v2~", "mq9~" }, h6k = { "h6k_v3", "h6k_v2", "h6k" }, j10 = { "j10" }, j11 = { "j11" }, j15t = { "j15t", "j15_v3", "j15_v2", "j15" }, j16 = { "j16_v3", "j16_v2", "j16" }, j20 = { "j20_v5", "j20_v4", "j20_v3", "j20_v2", "j20" }, j35 = { "j31_v3", "j31_v2", "j31" }, j36 = { "j36_v2", "j36" }, j6 = { "j6" }, j8 = { "j8" }, mq9 = { "mq9_v4", "mq9_v3", "mq9_v2", "mq9" } },
