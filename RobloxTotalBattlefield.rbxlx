add("coach.cardTitle", "第一次{1}", "FIRST TIME: {1}")
add("coach.cardSub", "三步上手 · 回车关上", "Three steps · Enter to close")
add("coach.gotIt", "知道了", "GOT IT")
add("coach.moreKeys", "F1 全部按键", "F1 all keys")
add("coach.card.veh.1", "W / S 前进后退，A / D 转向（履带车能原地打转）", "W / S to drive, A / D to steer (tracked vehicles can pivot in place)")
add("coach.card.veh.2", "鼠标转炮塔瞄准，左键开火，数字键选弹种 / 武器（看底下的弹药栏）", "The mouse aims the turret, LMB fires, number keys pick the shell / weapon (see the ammo bar)")
add("coach.card.veh.3", "Shift 进瞄准镜（V 切夜视 / 热成像），M 放烟幕，空格下车", "Shift for the gunner sight (V: night / thermal), M smoke, Space to get out")
add("coach.card.lcac.1", "W / S 油门，A / D 转向：越快越灵，转弯会甩尾", "W / S throttle, A / D steer: sharper at speed, the stern slides out")
add("coach.card.lcac.2", "开到海滩、冲上沙滩，车会自动放下来", "Run up onto a beach and the vehicle is set down automatically")
add("coach.card.lcac.3", "接着开车从艇首开下去；空格下车", "Then drive off over the bow; Space to get out")
add("coach.card.jet.1", "Shift 推油门（推满进加力），A / D 在跑道上转向，油门收到底按住 Ctrl 倒退", "Shift throttle up (full = afterburner); A / D steer on the runway; hold Ctrl at idle to back up")
add("coach.card.jet.2", "速度到 {1} km/h 按住 S 抬头离地，起落架会自动收起；W 低头、S 抬头、A / D 滚转，压坡度再拉 S 就转弯", "At {1} km/h hold S to lift off — the gear retracts by itself. W nose down, S nose up, A / D roll; bank and pull S to turn")
add("coach.card.jet.3", "左键机炮（打机头标记那里），F 导弹（1–6 换挂载，先锁定），X 热诱弹；回去降落：G 放起落架、Ctrl 收油门、机头对着跑道，停稳就补弹修理", "LMB gun (fires at the nose marker; sticks to enemy vehicles within 6° and leads them), F missile (1–6 stores, lock first), X flares. To land: G gear down, Ctrl throttle down, point the nose at the runway, stop to rearm and repair")
add("coach.card.heli.1", "先等旋翼转起来（平显上的转速到 100%）", "Wait for the rotor to spin up (RPM 100% on the HUD)")
add("coach.card.heli.2", "按住 W 升、S 降（同战雷）；准心往下机头前倾往前飞，准心往上往后仰减速；A / D 侧飞、Q / E 转机头", "Hold W to climb, S to descend (like War Thunder); aim lower to dip the nose and fly ahead, aim higher to pitch back and slow; A / D sidestep, Q / E turn")
add("coach.card.heli.3", "速度有惯性：不会马上停，准心往上一抬机头后仰刹车。左键机炮，F 火箭 / 导弹，空格下飞机", "It keeps its momentum: aim higher to flare and brake. LMB gun, F rockets / missiles, Space to get out")
add("coach.card.uav.1", "你端着平板遥控无人机，人还站在原地——当心被打", "You fly the drone from a tablet while standing where you are — stay covered")
add("coach.card.uav.2", "鼠标管方向，W / S 加速减速，A / D 滚转", "The mouse steers, W / S speed, A / D roll")
add("coach.card.uav.3", "右键 / V 切镜头、Z 变焦，F 发导弹，空格收起平板", "RMB / V camera, Z zoom, F missile, Space to put the tablet away")
add("coach.card.ship.1", "W / S 调车钟，一档一档加减速；A / D 转舵——船大，转得慢", "W / S set the engine order step by step; A / D rudder — big ships turn slowly")
add("coach.card.ship.2", "鼠标瞄准、左键开火：1 舰炮，2 反舰导弹（R 锁定）", "Mouse aims, LMB fires: 1 guns, 2 anti-ship missiles (R to lock)")
add("coach.card.ship.3", "右键 / V 望远镜，N 夜视，空格下船", "RMB / V binoculars, N night vision, Space to leave the ship")
add("coach.card.fort.1", "鼠标瞄准，左键开火", "Mouse to aim, LMB to fire")
add("coach.card.fort.2", "右键 / V 瞄准镜，滚轮调倍率", "RMB / V sight, wheel to zoom")
add("coach.card.fort.3", "空格离开炮位", "Space to leave the position")
add("coach.card.arty.1", "鼠标指向要打的地方，旁边写着距离和射程", "Point the mouse at the target; distance and range are shown")
add("coach.card.arty.2", "左键开炮，炮弹要飞几秒才落地", "LMB fires — shells take a few seconds to land")
add("coach.card.arty.3", "右键放大看落点，空格离开", "RMB to zoom in, Space to leave")
add("coach.gearAuto", "起落架已自动收起", "Gear retracted")
