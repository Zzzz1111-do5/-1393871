  panel9 = { credit = "九层板楼：LOW POLY - SOVIET APARTMENT BUILDING 8K，作者 Colin.Greenall（https://sketchfab.com/models/05229ac1d1f94e6c8cacaad91110c602），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真高缩放、换成 Roblox 的格、按材质切块、贴图缩到 1024", d = 46.642, h = 78.4, name = "九层板楼", o = { 0, 0, 0 }, parts = { Body_1 = { c = { 0, 39.2, -0 }, s = { 113.41, 78.4, 46.642 } } }, tris = 10392, w = 113.41 },
