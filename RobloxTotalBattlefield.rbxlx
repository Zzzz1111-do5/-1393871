    ["pve.allClear"] = "Alle Missionen abgeschlossen",
    ["pve.b1"] = "Ein verstärkter Feindzug hält den Grenzposten, keine Panzer. Überquert den Wall und den Panzergraben und nehmt Ziel A.",
    ["pve.b10"] = "Feindliche Elite-Infanterie ohne Fahrzeuge; offenes Gelände und viele Scharfschützen. Nehmt die ersten drei Ziele des Sandmeers.",
    ["pve.b11"] = "Eine Grenzverteidigungslinie mit M1A2, Bradleys und M1150-Räumpanzern. T-90M und BMP-3 decken die Infanterie bei drei Zielen.",
    ["pve.b12"] = "Nutzt den Durchbruch: Feindliche Panzer und SPz greifen gemeinsam an. Nehmt die Ziele von vier Abschnitten hintereinander.",
    ["pve.b13"] = "Nächtliche Panzerschlacht im Sandmeer: fünf M1A2/M1A1 gegen unsere vier T-90M, Typ 99A und Typ 96. Nutzt die Wärmebildsicht und schießt zuerst. Nehmt die Ziele von vier Abschnitten.",
    ["pve.b14"] = "Generalangriff: 30 Feinde und 4 Panzerfahrzeuge halten stand. Nehmt alle fünf Ziele.",
    ["pve.b15"] = "Die letzte Panzerreserve des Feindes aus M1A2, M1A1 und Bradleys. Brecht durch alle fünf Abschnitte des Sandmeers.",
    ["pve.b16"] = "Alles, was der Feind noch hat: 36 Soldaten und 5 Panzerfahrzeuge. Brecht durch alle fünf Abschnitte des Sandmeers und nehmt den Gefechtsstand auf dem Kamm.",
    ["pve.b2"] = "Zwei Feindzüge mit MG-Nestern halten Grenzposten und Ölfeld. Nehmt beide Ziele.",
    ["pve.b3"] = "Eine mechanisierte Kompanie mit Bradleys, Strykers und JLTVs hält die Linie bis zur Stadt. Nehmt im Schutz der Nacht drei Ziele; nehmt Panzerabwehrwaffen mit.",
    ["pve.b4"] = "Begegnungsgefecht im Sandmeer, wenige Panzer und SPz auf beiden Seiten. Durchbrecht den Grenzwall und nehmt das Ölfeld: zwei Ziele.",
    ["pve.b5"] = "M1A1-Panzer und Bradleys verteidigen in der Tiefe. Nehmt vier Ziele hintereinander und reißt die Linie auf.",
    ["pve.b6"] = "Panzerduell: eine M1A1/M1A2-Kompanie gegen unsere T-90M und Typ 99A. Nehmt drei Ziele hintereinander im Sandmeer.",
    ["pve.b7"] = "Die feindliche Hauptmacht zieht sich auf den Kamm zurück, fünf Ziele in gestaffelter Verteidigung. Brecht durch alle fünf Abschnitte.",
    ["pve.b8"] = "Schwere Feindgruppe aus M1A2, M1A1 und Bradleys; unsere T-90M, Typ 99A und BMP-3 greifen gemeinsam an. Brecht durch alle fünf Abschnitte des Sandmeers.",
    ["pve.b9"] = "Front im Sandmeer: eine motorisierte Kompanie mit Bradleys, Strykers und einigen M1A1. Unser BMP-3-Bataillon durchbricht zwei Wall-Linien.",
    ["pve.botTeam"] = "PvE: Alle Spieler sind auf der Angreiferseite",
