    <Item class="ModuleScript" referent="39">
      <Properties>
        <string name="Name">LightLooks</string>
        <ProtectedString name="Source"><![CDATA[-- 全面大战场——各张图白天 / 黄昏 / 清晨 / 夜里的光照（服务器、客户端共用一份数）
--   用户 11-27：光影照战雷（Eagle's Shadow 那版）做——黄昏侧光暖、阴影软硬合适、远处有空气透视、雪地反光不过曝、夜里月光冷；
--   要在 Apple M3 上丝滑（后期效果只在用得上的时候开，见 DayNight.lua）。数照调研给的规格（2026-11-27「坦克对战：特效和光影改法规格」第 5 节）：
--   · 钢城（训练场、岛图照它）、沙海、雪山各一套，训练场白天大气淡一点；每套 day / dusk / dawn / night 四份，所有字段都参与混合：
--     先按 dayK（DayClock：0 夜里 ～ 1 白天）在 night、day 之间插，再按黄昏权重（twW，日落前后那一段）往 dusk（下午）/ dawn（上午）插
--   · 为什么这么调（规格 5.0）：
--     - 太阳硬、天光冷、Ambient 低：原来白天 OutdoorAmbient 104 加 EnvironmentDiffuseScale 1，天光算了两份，背光面、车底不够暗，画面平
--       （官方文档：调高 EnvironmentDiffuseScale 时要相应调低 Ambient、OutdoorAmbient）
--     - 大气：用户 11-22「视野给我改成无限远好了」压到 0.07～0.085（原来 0.17～0.21 几公里外就灰成一片）——这是用户要过的，不能悄悄推翻：
--       规格建议的白天 0.14～0.15、黄昏 0.18～0.19、霾 1.7～2.0（浓一倍）审查时退回来了：白天 0.07～0.09、黄昏 0.1、夜里照原来 0.085。
--       霾 Haze（文档：远处、地平线上都起作用，一样挡视线）11-22 那次也减了半（白天 0.7 → 0.3、夜里 1.1 → 0.5，a03a290 的 DayNight）——
--       复核时也退回那个量级：钢城白天 0.35、训练场 0.3、各图夜里 0.5；黄昏 / 清晨 0.6～0.8（原来没有单独一份，按昼夜混合约 0.4～0.75；
--       Haze > 0 太阳周围那圈金光 Glare 才有效）；沙海、雪山白天 0.8（用户 11-25 / 11-26 调过的是 0.9 / 1.0，没超）。
--       远处一层层淡下去（空气透视）就靠这点大气 + 地面上的远处景深（FarBlur 0.06，用户 11-22「远处模糊这样」、11-25 压淡，DayNight.lua）；
--       Offset 留住远处的轮廓（雪山 0.24：远山的山脊线不糊进天里）。颜色、Decay、Glare 照规格（各图一套）。
--       tools/mock/lightreal.lua 查着：每张图白天 Density ≤ 0.1；钢城、训练场白天霾 ≤ 0.4，各图夜里 ≤ 0.5，一天里任何时候 ≤ 0.8
--     - Glare 要 Haze > 0 才有效，Decay 要 Haze、Glare 都 > 0（夜里 Glare 0：Decay 不起作用，照样写一份免得插值跳）
--     - 泛光门槛白天不低于 1.2：只让亮度推过 2 的火球、闪光起光晕（太阳照着的墙、雪地不泛白）
--     - 阴影白天 0.14～0.18：战雷新阴影边缘平滑不抖，原来 0.12 太硬、会闪；黄昏 0.22～0.26、夜里 0.35～0.4（月光、灯光软）
--     - 曝光 +1 是两倍；雪地白天 −0.35（雪反照率 0.8 以上：压一档多才不过曝），夜里 +0.35～0.45
--   · 清晨（dawn）：规格只给了钢城（用黄昏那套，Top、大气颜色偏粉、Glare 0.7、Haze 2.0 晨雾、饱和 0.06）；沙海、雪山照同样的改法推的
--   · 纬度 LAT、全局风 WIND：服务器 World.lighting 按战场设，客户端 DayNight 按镜头在哪块（训练场 / 战场）再设一遍
local RGB = Color3.fromRGB

local L = {}

-- 参与混合的字段（DayNight 每次更新都按这张表插值）
L.KEYS = { "bright", "amb", "oamb", "top", "bot", "diff", "spec", "exp", "shadow", "dens", "off", "acol", "adec", "glare", "haze",
  "bloomI", "bloomS", "bloomT", "rays", "raysSpread", "ccB", "ccC", "ccS", "ccTint" }
-- 字段 → 设到哪（文档、测试用）
L.PROP = { bright = "Lighting.Brightness", amb = "Lighting.Ambient", oamb = "Lighting.OutdoorAmbient", top = "Lighting.ColorShift_Top",
  bot = "Lighting.ColorShift_Bottom", diff = "Lighting.EnvironmentDiffuseScale", spec = "Lighting.EnvironmentSpecularScale",
  exp = "Lighting.ExposureCompensation", shadow = "Lighting.ShadowSoftness", dens = "Atmosphere.Density", off = "Atmosphere.Offset",
  acol = "Atmosphere.Color", adec = "Atmosphere.Decay", glare = "Atmosphere.Glare", haze = "Atmosphere.Haze",
  bloomI = "NightBloom.Intensity", bloomS = "NightBloom.Size", bloomT = "NightBloom.Threshold", rays = "SunShafts.Intensity",
  raysSpread = "SunShafts.Spread", ccB = "NightGrade.Brightness", ccC = "NightGrade.Contrast", ccS = "NightGrade.Saturation",
  ccTint = "NightGrade.TintColor" }

local function with(base, over)
  local t = {}
  for k, v in pairs(base) do t[k] = v end
  for k, v in pairs(over) do t[k] = v end
  return t
end

---------------------------------------------------------------- 钢城（规格 5.1；训练场、岛图也照它）
local CITY = {}
CITY.day = { bright = 3.0, amb = RGB(22, 24, 28), oamb = RGB(86, 92, 104), top = RGB(255, 243, 224), bot = RGB(44, 42, 38),
  diff = 0.75, spec = 0.8, exp = 0, shadow = 0.18, dens = 0.08, off = 0.14, acol = RGB(198, 210, 226), adec = RGB(104, 120, 148),
  glare = 0.25, haze = 0.35, bloomI = 0.5, bloomS = 24, bloomT = 1.25, rays = 0.04, raysSpread = 0.45,
  ccB = 0, ccC = 0.1, ccS = 0.05, ccTint = RGB(255, 251, 246) }
-- 黄昏：低太阳的暖侧光（Top 橙）、天光偏紫红、影子软一点，空气比白天浓一点（0.1）、太阳周围一大片金色（Glare 0.95、Haze 0.6），光束最明显
CITY.dusk = { bright = 2.2, amb = RGB(24, 20, 22), oamb = RGB(96, 80, 78), top = RGB(255, 158, 90), bot = RGB(50, 40, 48),
  diff = 0.55, spec = 0.7, exp = 0.12, shadow = 0.26, dens = 0.1, off = 0.1, acol = RGB(240, 166, 112), adec = RGB(128, 74, 82),
  glare = 0.95, haze = 0.6, bloomI = 0.75, bloomS = 30, bloomT = 1.05, rays = 0.14, raysSpread = 0.8,
  ccB = 0.01, ccC = 0.12, ccS = 0.12, ccTint = RGB(255, 238, 222) }
-- 夜里：冷蓝的月光（Top 138,156,206）、环境光压得很低，泛光门槛低（灯、火、曳光起光晕），调色去饱和、偏冷
CITY.night = { bright = 2.0, amb = RGB(8, 10, 14), oamb = RGB(34, 40, 56), top = RGB(138, 156, 206), bot = RGB(6, 8, 14),
  diff = 0.25, spec = 0.55, exp = 0.45, shadow = 0.4, dens = 0.085, off = 0.1, acol = RGB(42, 52, 74), adec = RGB(12, 14, 24),
  glare = 0, haze = 0.5, bloomI = 1.15, bloomS = 34, bloomT = 0.95, rays = 0, raysSpread = 0.45,
  ccB = 0, ccC = 0.12, ccS = -0.16, ccTint = RGB(214, 226, 255) }
-- 清晨：黄昏那套，太阳偏粉、天偏淡粉，一点晨雾（Haze 0.7，比黄昏多一点），颜色没黄昏那么浓
CITY.dawn = with(CITY.dusk, { top = RGB(255, 190, 150), acol = RGB(220, 180, 166), adec = RGB(120, 90, 100), glare = 0.7, haze = 0.7, ccS = 0.06 })

---------------------------------------------------------------- 训练场：白天大气淡一点、地面反光偏暖土色；黄昏、夜里同钢城
local RANGE = {
  day = with(CITY.day, { dens = 0.07, haze = 0.3, bot = RGB(52, 46, 38) }),
  dusk = CITY.dusk, dawn = CITY.dawn, night = CITY.night,
}

---------------------------------------------------------------- 沙海（规格 5.2）：沙地把光反上来（Bottom 暖）、太阳刺眼一点；坦克一两公里对射，大气不要比这再浓
local SANDS = {}
SANDS.day = { bright = 3.4, amb = RGB(30, 26, 22), oamb = RGB(112, 100, 84), top = RGB(255, 240, 212), bot = RGB(96, 76, 54),
  diff = 0.55, spec = 0.7, exp = -0.12, shadow = 0.15, dens = 0.085, off = 0.12, acol = RGB(224, 206, 174), adec = RGB(178, 146, 106),
  glare = 0.45, haze = 0.8, bloomI = 0.45, bloomS = 24, bloomT = 1.3, rays = 0.05, raysSpread = 0.5,
  ccB = 0, ccC = 0.1, ccS = 0, ccTint = RGB(255, 246, 232) }
SANDS.dusk = { bright = 2.5, amb = RGB(28, 22, 20), oamb = RGB(112, 84, 70), top = RGB(255, 150, 78), bot = RGB(96, 62, 44),
  diff = 0.45, spec = 0.65, exp = 0.05, shadow = 0.24, dens = 0.1, off = 0.08, acol = RGB(242, 152, 92), adec = RGB(152, 72, 52),
  glare = 1.0, haze = 0.8, bloomI = 0.7, bloomS = 30, bloomT = 1.05, rays = 0.16, raysSpread = 0.85,
  ccB = 0.01, ccC = 0.12, ccS = 0.1, ccTint = RGB(255, 234, 214) }
SANDS.night = { bright = 1.9, amb = RGB(10, 9, 8), oamb = RGB(42, 40, 42), top = RGB(176, 178, 204), bot = RGB(12, 10, 10),
  diff = 0.25, spec = 0.5, exp = 0.35, shadow = 0.38, dens = 0.085, off = 0.1, acol = RGB(66, 58, 54), adec = RGB(22, 17, 14),
  glare = 0, haze = 0.5, bloomI = 1.1, bloomS = 34, bloomT = 0.95, rays = 0, raysSpread = 0.5,
  ccB = 0, ccC = 0.1, ccS = -0.14, ccTint = RGB(238, 232, 240) }
-- 清晨（照钢城的改法推）：沙漠的早上干冷、霾比傍晚少一点
SANDS.dawn = with(SANDS.dusk, { top = RGB(255, 186, 140), acol = RGB(228, 182, 150), adec = RGB(136, 96, 88), glare = 0.75, haze = 0.75, ccS = 0.05 })

---------------------------------------------------------------- 雪山（规格 5.3）：雪把天光反上来（Bottom 冷蓝、影子里不发黑）；白天压一档曝光；夜里月光照雪、冷蓝
local SNOW = {}
SNOW.day = { bright = 3.1, amb = RGB(28, 32, 40), oamb = RGB(96, 110, 134), top = RGB(255, 250, 242), bot = RGB(92, 106, 130),
  diff = 0.9, spec = 0.95, exp = -0.35, shadow = 0.14, dens = 0.09, off = 0.24, acol = RGB(210, 224, 242), adec = RGB(112, 136, 172),
  glare = 0.4, haze = 0.8, bloomI = 0.55, bloomS = 24, bloomT = 1.2, rays = 0.07, raysSpread = 0.5,
  ccB = 0, ccC = 0.14, ccS = 0, ccTint = RGB(244, 249, 255) }
-- 高山晚霞：雪坡染成橙粉、背阴的一面冷紫
SNOW.dusk = { bright = 2.3, amb = RGB(26, 26, 36), oamb = RGB(118, 106, 136), top = RGB(255, 172, 124), bot = RGB(84, 86, 124),
  diff = 0.7, spec = 0.85, exp = -0.1, shadow = 0.22, dens = 0.1, off = 0.18, acol = RGB(242, 178, 152), adec = RGB(112, 100, 152),
  glare = 0.85, haze = 0.8, bloomI = 0.7, bloomS = 30, bloomT = 1.05, rays = 0.16, raysSpread = 0.8,
  ccB = 0.01, ccC = 0.14, ccS = 0.1, ccTint = RGB(255, 240, 236) }
SNOW.night = { bright = 2.0, amb = RGB(16, 20, 30), oamb = RGB(52, 62, 90), top = RGB(176, 196, 240), bot = RGB(20, 24, 38),
  diff = 0.3, spec = 0.6, exp = 0.45, shadow = 0.35, dens = 0.085, off = 0.16, acol = RGB(54, 66, 96), adec = RGB(14, 18, 30),
  glare = 0, haze = 0.5, bloomI = 1.0, bloomS = 32, bloomT = 0.95, rays = 0, raysSpread = 0.5,
  ccB = 0, ccC = 0.12, ccS = -0.1, ccTint = RGB(210, 224, 255) }
-- 清晨（照钢城的改法推）：日出前后的粉色高山（alpenglow）
SNOW.dawn = with(SNOW.dusk, { top = RGB(255, 198, 172), acol = RGB(228, 192, 192), adec = RGB(112, 106, 156), glare = 0.7, haze = 0.8, ccS = 0.06 })

L.LOOK = { city = CITY, range = RANGE, sands = SANDS, snow = SNOW }

-- 纬度（规格 5.0，可选）：太阳更低、影子更长，更像战雷的侧光；原来全图 23 度（中午太阳几乎在头顶，影子短、画面平）。
--   客户端 DayNight 先在 6 点、18 点各看一眼太阳高度：Roblox 换纬度要是连日出日落也挪了（昼夜按 6 点日出、18 点日落算），退回 LAT0
L.LAT = { city = 48, sands = 29, snow = 58, range = 40 }
L.LAT0 = 23
-- 全局风（格/秒，约 2～4 米/秒）：烟、尘、草跟着一个方向飘（粒子开 WindAffectsDrag 的才吃这个）；暴风雨（Warfx.lua）在这个基础上加大
L.WIND = { city = Vector3.new(5, 0, 2), sands = Vector3.new(9, 0, 3), snow = Vector3.new(11, 0, -5), range = Vector3.new(4, 0, 2) }

-- 哪一套：p（镜头位置）在训练场那块（Zones.RANGE）是训练场，别处是这一局的战场（岛图、大厅照战场那张）
function L.keyFor(Map, p)
  local Z = Map and Map.Zones
  if p and Z and Z.inRange and Z.inRange(p.X, p.Z) then return "range" end
  if Map and (Map.SNOW or Map.NAME == "snow") then return "snow" end
  if Map and (Map.DESERT or Map.NAME == "sands") then return "sands" end
  return "city"
end

local function smooth(a, b, v)
  local t = math.clamp((v - a) / (b - a), 0, 1)
  return t * t * (3 - 2 * t)
end
-- 黄昏 / 清晨的权重（太阳高度 alt：−1 半夜 ～ 1 正午）：日落前后（alt 0.05，约 17:48）最浓 0.85，alt 0.3（16:50）和 −0.2（18:46）是 0；
--   同 Warfx 云的颜色那一段（原来 alt −0.18 那里一刀切掉，插值跳一下：去掉）
function L.twW(alt)
  return math.clamp(1 - math.abs(alt - 0.05) / 0.25, 0, 1) * 0.85
end
-- 太阳本身的颜色（ColorShift_Top 照的是太阳或月亮）、光束：太阳落下去以后（alt < 0）就没有暖色的直射光了，
--   这两项的黄昏权重跟着太阳落山收掉（alt −0.12，约 18:28 收完）；不然日落后月亮从东边升起来照成橙色
function L.twTop(alt)
  return L.twW(alt) * smooth(-0.12, 0.02, alt)
end
-- 钟点 → 混合用的几个权重（DC = DayClock）
function L.weights(clock, DC)
  local alt = DC.sunAlt(clock)
  return DC.dayK(clock), L.twW(alt), L.twTop(alt), clock < 12
end

local function mix(a, b, t)
  if type(a) == "number" then return a + (b - a) * t end
  return a:Lerp(b, t)
end
-- 混合好的一套：key 哪张图，dayK 0 夜里 ～ 1 白天，tw 黄昏权重，twTop 太阳颜色、光束用的黄昏权重，dawn 上午（用清晨那份）；out 复用的表
function L.at(key, dayK, tw, twTop, dawn, out)
  local P = L.LOOK[key] or CITY
  local T = dawn and P.dawn or P.dusk
  local N, D = P.night, P.day
  out = out or {}
  for _, k in ipairs(L.KEYS) do
    local v = mix(N[k], D[k], dayK)
    local w = (k == "top" or k == "rays") and twTop or tw
    if w > 0 then v = mix(v, T[k], w) end
    out[k] = v
  end
  return out
end

return L
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="40">
      <Properties>
        <string name="Name">Map</string>
        <ProtectedString name="Source"><![CDATA[-- 全面大战场地图（ReplicatedStorage.Map）：纯数学，服务器、客户端算出来一样（地形、小地图、出生点、据点都用它）
--   坐标：X 东西（东为正），Z 南北（北是 −Z），海平面 Y = 0；地形范围 ±Map.R 格，再往外的远海是客户端跟着镜头铺的平面（Scenery.lua）
--   整张图按 K 放大（用户：地图还有海洋过于小了；放大 1.5 倍后又说不够大、海洋也太小 → 3 倍）：下面的数都是放大前的「设计尺寸」，水平方向的位置、大小、起伏的波长都乘 K，高度乘 HK；
--     房子、工事、车场这些人的尺度的东西不放大，只是摆的位置跟着锚点（据点、海滩、机场……）走
--   主岛「棕榈岛」照网页版《暗剑》js/isle.js 的虚构热带岛：南岸宽而平缓（四处海滩）、东西两个岬角、西南向南开口的 U 形港湾（湾底港口镇）、
--   中央山脊（偏东一个山口）、西北主峰、东部沿海平原上的机场；网页版只有岛的南半边，这里补出北岸，改成四面环海的完整岛，尺寸按 0.5 缩
--   另有前哨岛（据点 A）、灯塔岛（据点 B）、西礁岛（岸防炮台，没有据点）、攻方机场岛；攻方舰队在南边 Z 2000～2400
local Map = {}
Map.NAME = "island"
-- 地形长 Roblox 会动的草叶（用户 11-24 发了截图：「这个 roblox 的这种草你给海岛地图加上吧」）：World.lua 写地形时草地照写 Grass（草叶只长在 Grass 上）；
--   草叶开关 Terrain.Decoration、草长 GrassLength 脚本改不了，写在地点文件的 Terrain 上（tools/build.luau）
Map.GRASS = true
local exp, abs, sin, cos, sqrt, max, min, floor = math.exp, math.abs, math.sin, math.cos, math.sqrt, math.max, math.min, math.floor
local noise = math.noise

local function clamp(v, a, b) return v < a and a or (v > b and b or v) end
local function smooth(a, b, v) local t = clamp((v - a) / (b - a), 0, 1) return t * t * (3 - 2 * t) end
local function lerp(a, b, t) return a + (b - a) * t end
Map.clamp, Map.smooth, Map.lerp = clamp, smooth, lerp

local K, HK = 3, 2      -- 水平放大、高度放大（坡度变成原来的 HK / K）：主岛东西约 9000 格（3.2 公里），主峰约 500 格
Map.K, Map.HK = K, HK
Map.R = 12288          -- 地形（含海水）范围 ±R（2048 的倍数：海水按 2048 一块灌）；攻方机场岛最南到 10300 左右
Map.PLAY = 36864       -- 飞机的作战区 ±PLAY（再往外自动掉头）：约 ±13 公里
Map.SEA_R = 24576      -- 地形海水再往外铺一圈薄的（±SEA_R，约 ±8.8 公里）：用户要「一望无际的海」，远海那圈平面和地形水面接不上、有割裂感
Map.SEA_LIM = 28672    -- 船能开到 ±SEA_LIM：约 ±10 公里（地形海水外面是客户端铺的远海平面）
Map.SEA_DEPTH = 110    -- 远海水深（格，约 40 米；用户：海太浅了不真实——原来 12 格，四米多）
Map.SHELF = 14         -- 近岸浅滩最深多少格（海滩外缓坡：登陆艇、两栖车照样冲得上滩），再往外陡降到 SEA_DEPTH
Map.MAXH = 290 * HK    -- 高度系数 1 对应多少格（主峰约 500）
Map.RES = 4            -- 地形体素边长

---------------------------------------------------------------- 主岛

local MI = { x = 0, z = -1500 * K, hs = 1500 * K, S = 800 * K, N = 760 * K }   -- 中心、东西半宽、南岸 / 北岸离中线最远多少
Map.MAIN = MI
local PH = { 0.7, 2.1, 4.0, 1.3, 5.2, 3.3, 0.4, 2.8, 4.6, 1.9, 3.7, 5.9 }   -- 起伏的相位（网页版按种子随机，这里定死：每局一样）
local BAY = { x = -495 * K, w = 120 * K, d = 320 * K }   -- 港湾：中心、半宽、伸进岛里多深
local CAPES = { { x = -1110 * K, ext = 150 * K, w = 105 * K }, { x = 1200 * K, ext = 130 * K, w = 95 * K } }   -- 南岸东西两个岬角：伸出多远、半宽
Map.BAY = BAY
Map.CAPES = CAPES

local function southRaw(x)
  local u = (x - MI.x) / MI.hs
  if abs(u) >= 1 then return nil end
  local f = (1 - abs(u) ^ 3.5) ^ 0.45   -- 南岸正面宽而平缓（能登陆的岸段长），东西两头陡收
  local c = MI.S * f + f * K * (35 * sin(x / (155 * K) + PH[1]) + 14 * sin(x / (48 * K) + PH[2]) + 6 * sin(x / (21 * K) + PH[3]))
  for _, k in ipairs(CAPES) do c += k.ext * f * exp(-((x - k.x) / k.w) ^ 2) end
  local q = (x - BAY.x) / BAY.w
  c -= BAY.d * exp(-((q * q) ^ 1.6))   -- U 形湾：湾底平、湾口不收窄
  return MI.z + c
end
local function northRaw(x)
  local u = (x - MI.x) / MI.hs
  if abs(u) >= 1 then return nil end
  local g = (1 - abs(u) ^ 3) ^ 0.5
  local c = MI.N * g + g * K * (30 * sin(x / (140 * K) + PH[4]) + 16 * sin(x / (53 * K) + PH[5]) + 7 * sin(x / (19 * K) + PH[6]))
  return MI.z - c
end

-- 岸线先算好存表（每 2 格一个），查的时候线性插值
local CX0, CSTEP = -MI.hs, 2
local CN = floor(2 * MI.hs / CSTEP)
local cS, cN = table.create(CN + 1), table.create(CN + 1)
for i = 0, CN do
  local x = CX0 + i * CSTEP
  cS[i + 1] = southRaw(x) or MI.z
  cN[i + 1] = northRaw(x) or MI.z
end
local function coastLookup(t, x)
  local f = (x - CX0) / CSTEP
  if f <= 0 or f >= CN then return nil end
  local i = floor(f)
  local a = f - i
  return t[i + 1] * (1 - a) + t[i + 2] * a
end
function Map.coastS(x) return coastLookup(cS, x) end   -- 主岛南岸线在 x 处的 z（岛外返回 nil）
function Map.coastN(x) return coastLookup(cN, x) end   -- 北岸线

---------------------------------------------------------------- 海滩、据点、营地

-- 南岸四处海滩（避开港湾、岬角）；东北岸一处侧翼海滩
Map.BEACHES = {
  { id = "red", x0 = -980 * K, x1 = -820 * K, color = Color3.fromRGB(215, 70, 60) },
  { id = "white", x0 = -200 * K, x1 = -40 * K, color = Color3.fromRGB(235, 235, 235) },
  { id = "blue", x0 = 250 * K, x1 = 410 * K, color = Color3.fromRGB(80, 196, 100) },   -- 显示名「绿滩」（用户 11-21：蓝色全部改成绿色；编号还叫 blue，代码里按它找）
  { id = "gold", x0 = 690 * K, x1 = 850 * K, color = Color3.fromRGB(235, 190, 60) },
  { id = "flank", x0 = 820 * K, x1 = 960 * K, north = true, color = Color3.fromRGB(150, 110, 220) },
}
for _, b in ipairs(Map.BEACHES) do
  b.cx = (b.x0 + b.x1) / 2
  b.z = (b.north and Map.coastN or Map.coastS)(b.cx)
  b.dir = b.north and -1 or 1   -- 朝海的方向（Z）：南岸的海在南（+Z），北岸的海在北
end
local function beachAt(x, north)
  for _, b in ipairs(Map.BEACHES) do
    if (b.north == true) == (north == true) and x >= b.x0 - 25 * K and x <= b.x1 + 25 * K then return b end
  end
  return nil
end
Map.beachAt = beachAt

local function ridgeZ(x) return MI.z + K * (-230 + 65 * sin(x / (260 * K) + PH[7]) + 30 * sin(x / (85 * K) + PH[8])) end
Map.ridgeZ = ridgeZ
local HILLS = {
  { x = -420 * K, z = MI.z - 450 * K, r = 300 * K, h = 0.95 },   -- 西北主峰
  { x = -760 * K, z = MI.z - 90 * K, r = 250 * K, h = 0.5 },
  { x = 470 * K, z = MI.z - 200 * K, r = 270 * K, h = 0.5 },
  { x = 1060 * K, z = MI.z - 330 * K, r = 190 * K, h = 0.4 },
}

-- 机场（守方，东部沿海平原，跑道东西向）、指挥所（山脊北面）、后方营地（北岸，不能占）、港口镇（湾底）
local afX = 780 * K
-- 跑道 3600 格（约 1.3 公里）、宽 90 格（用户：机场太小、跑道非常短）：不跟着 K 放大，按真飞机滑跑要的长度定（Fly.lua 地面加速度、抬头速度）
Map.AIRFIELD = { x = afX, z = (Map.coastS(afX) or 0) - 470 * K, len = 3600, wid = 90, rot = 0 }
local AFP = { x = afX, z = Map.AIRFIELD.z - 40 * K }   -- 机场一带是一片低平的沿海平原（mainNatural 里压低）
Map.COMMAND = { x = 260 * K, z = ridgeZ(260 * K) - 230 * K }
Map.CAMP = { x = 140 * K, z = (Map.coastN(140 * K) or 0) + 120 * K }
Map.PORT = { x = BAY.x, z = (Map.coastS(BAY.x) or 0) - 70 * K }

---------------------------------------------------------------- 小岛

local ISLES = {
  { id = "outpost", x = 150 * K, z = 500 * K, a = 230 * K, b = 170 * K, h = 34 * HK, ph = 1.1 },   -- 前哨岛：离攻方舰队最近
  { id = "lighthouse", x = 2500 * K, z = -300 * K, a = 300 * K, b = 230 * K, h = 62 * HK, ph = 2.7 },   -- 灯塔岛（东）
  { id = "westreef", x = -2500 * K, z = -200 * K, a = 270 * K, b = 220 * K, h = 46 * HK, ph = 4.2 },   -- 西礁岛：岸防炮台
  { id = "afield", x = 0, z = 3200 * K, a = 620 * K, b = 230 * K, h = 6, ph = 0.3, flat = true },   -- 攻方机场岛：平的
}
Map.ISLES = ISLES
for _, I in ipairs(ISLES) do Map[string.upper(I.id)] = I end

local function isleRad(I, th)   -- 椭圆半径按方位起伏
  local c, s = cos(th), sin(th)
  local r = I.a * I.b / sqrt((I.b * c) ^ 2 + (I.a * s) ^ 2)
  return r * (1 + 0.07 * sin(3 * th + I.ph) + 0.04 * sin(5 * th + 2 * I.ph) + 0.02 * sin(9 * th + 3 * I.ph))
end
Map.isleRad = isleRad
-- 离这个小岛的岸多远（正 = 岛上，负 = 海里）
local function isleD(I, x, z)
  local dx, dz = x - I.x, z - I.z
  local rho = sqrt(dx * dx + dz * dz)
  if rho > I.a * 1.3 + 400 * K then return -1e9, 1, rho end
  local R = isleRad(I, math.atan2(dz, dx))
  return R - rho, R, rho
end

-- 5 个据点：A 前哨岛、B 灯塔岛、C 港口镇、D 机场、E 指挥所（开局都归守方）
Map.POINTS = {
  { id = "A", x = 150 * K, z = 500 * K, isle = "outpost" },
  { id = "B", x = 2480 * K, z = -320 * K, isle = "lighthouse" },
  { id = "C", x = Map.PORT.x, z = Map.PORT.z },
  { id = "D", x = Map.AIRFIELD.x, z = Map.AIRFIELD.z - 80 * K },   -- 机场北面的停机坪、塔台一带
  { id = "E", x = Map.COMMAND.x, z = Map.COMMAND.z },
}
Map.POINT_R = 80   -- 据点半径

-- 登陆点：主岛的 5 处海滩 + 前哨岛、灯塔岛的南岸（登陆艇从南边冲上去）；攻方选「抢滩」出生、机器人坐艇都按它
Map.LANDINGS = {}
for _, b in ipairs(Map.BEACHES) do table.insert(Map.LANDINGS, b) end
for _, id in ipairs({ "outpost", "lighthouse" }) do
  local I = Map[string.upper(id)]
  table.insert(Map.LANDINGS, { id = id, cx = I.x, z = I.z + isleRad(I, math.pi / 2), dir = 1, isle = id, color = Color3.fromRGB(240, 240, 200) })
end
-- 港湾里：从湾口一直冲到湾底的港口码头
table.insert(Map.LANDINGS, { id = "port", cx = BAY.x, z = Map.coastS(BAY.x), dir = 1, color = Color3.fromRGB(200, 200, 210) })
function Map.landingOf(id)
  for _, b in ipairs(Map.LANDINGS) do if b.id == id then return b end end
  return nil
end
-- 这一点在哪块陆地上：小岛编号，或者 "main"（主岛；海里也算主岛）
function Map.landOf(x, z)
  for _, I in ipairs(ISLES) do
    if (isleD(I, x, z)) > -80 * K then return I.id end
  end
  return "main"
end
for _, p in ipairs(Map.POINTS) do p.land = p.isle or "main" end

-- 攻方舰队（固定平台，打不掉）、机场岛跑道
Map.FLEET = {
  { kind = "carrier", x = -420 * K, z = 2250 * K, rot = 0 },   -- 航母（福建舰）
  { kind = "lhd", x = 330 * K, z = 2150 * K, rot = 0 },   -- 两栖攻击舰（075）
  { kind = "lst", x = -1000 * K, z = 2050 * K, rot = 0 },   -- 登陆舰（072A）
  { kind = "lst", x = 950 * K, z = 2050 * K, rot = 0 },
}
Map.AFIELD2 = { x = 0, z = 3200 * K, len = 3300, wid = 90, rot = 0 }   -- 攻方机场岛的跑道（岛东西 3700 来格，跑道 3300、宽 90）
-- 登陆平台：舰队前面一块浮在海上的大平台（攻方地面载具的生成点在两侧水面：车站在气垫艇上，自己开去哪个海滩都行，冲上岸艇自己回去）
--   摆在前哨岛南边 700 格（不跟着 K 放大到舰队那么远：气垫艇 75 格 / 秒，到海滩一分钟上下）
Map.BARGE = { x = -40 * K, z = ISLES[1].z + ISLES[1].b + 700, W = 120, L = 360, top = 3.5 }

---------------------------------------------------------------- 压平的场地

-- 据点、机场、营地、港口：在自然高度上压平一块（圆：r 以内完全压平，r2 以外不变；矩形：hx × hz 以内压平，往外 m 格过渡）；只压陆地，不把海抬起来
local FLAT = {}
local function addFlat(x, z, r, r2, y) table.insert(FLAT, { x = x, z = z, r = r, r2 = r2, y = y }) end
local function addRect(x, z, hx, hz, m, y) table.insert(FLAT, { x = x, z = z, hx = hx, hz = hz, m = m, y = y, rect = true }) end
Map.FLAT = FLAT

---------------------------------------------------------------- 高度

local function mainNatural(x, z)
  local zs, zn = Map.coastS(x), Map.coastN(x)
  if not zs then return nil, -1e9 end
  local dS, dN = zs - z, z - zn
  local d = min(dS, dN)   -- 离岸（南北方向量；岛东西两头偏小一点，没关系）
  if d <= 0 then return nil, d, dS, dN end
  local u = (x - MI.x) / MI.hs
  local e = 0.06 + min(0.18, d / (1500 * K))
  e += 0.3 * exp(-((z - ridgeZ(x)) ^ 2) / (22500 * K * K)) * smooth(0, 0.5, 1 - abs(u)) * (1 - 0.75 * exp(-((x - 180 * K) / (110 * K)) ^ 2))   -- 中央山脊，偏东一个山口
  for _, h in ipairs(HILLS) do e += h.h * exp(-((x - h.x) ^ 2 + (z - h.z) ^ 2) / (2 * h.r * h.r)) end
  local bS = beachAt(x, false)
  local headland = not bS and not (abs(x - BAY.x) < BAY.w + 60 * K) and (abs(x - CAPES[1].x) < CAPES[1].w * 1.2 or abs(x - CAPES[2].x) < CAPES[2].w * 1.2)
  if headland then e += 0.14 * exp(-((dS - 35 * K) ^ 2) / (2250 * K * K)) end   -- 岬角：岸边陡起的崖顶
  e += noise(x / (300 * K), z / (300 * K), 1.37) * 0.16 + noise(x / (110 * K), z / (110 * K), 7.1) * 0.06   -- 起伏
  e *= lerp(0.4, 1, smooth(20 * K, 325 * K, d))   -- 沿海平原
  do   -- 东部沿海平原（机场）：一大片低平地（往一个平的高度抹），往外慢慢抬起来
    local qx, qz = max(0, abs(x - AFP.x) - 330 * K), max(0, abs(z - AFP.z) - 160 * K)
    e = lerp(0.075, e, smooth(40 * K, 520 * K, sqrt(qx * qx + qz * qz)))
  end
  if bS and dS < 160 * K then e *= lerp(0.35, 1, smooth(15 * K, 120 * K, dS)) end   -- 海滩后方平缓
  local bN = beachAt(x, true)
  if bN and dN < 160 * K then e *= lerp(0.35, 1, smooth(15 * K, 120 * K, dN)) end
  e = clamp(1 - exp(-1.35 * max(0, e)), 0, 1)   -- 软压缩：高处越来越缓，不会削成平顶台地
  local y = e * Map.MAXH
  local edge = (((bS and dS < dN) or (bN and dN <= dS)) and 70 or (headland and dS < dN and 18 or 45)) * K
  return y * smooth(0, edge, d) + 0.6, d, dS, dN
end

local function isleNatural(I, x, z)
  local d, R, rho = isleD(I, x, z)
  if d <= 0 then return nil, d end
  local y
  if I.flat then
    y = I.h * smooth(0, 60 * K, d)
  else
    local k = clamp(rho / R, 0, 1)
    y = I.h * (1 - k * k) ^ 0.8 + (noise(x / (90 * K), z / (90 * K), I.ph * 3) * 0.5) * I.h * 0.25 * smooth(0, 80 * K, d)
    y *= smooth(0, 40 * K, d)
  end
  return max(y, 0) + 0.6, d
end

-- 自然高度（压平之前）；海里返回负数（海底）
local function natural(x, z)
  local y, d, dS, dN = mainNatural(x, z)
  if y then return y, d end
  local off, k = 1e9, 0.16
  if d and d > -1e8 then   -- 主岛南北两岸外：海滩外是缓坡浅滩
    off = -d
    local b = (dS and dN and dS < dN) and beachAt(x, false) or beachAt(x, true)
    if b and ((b.north and dN and dN < 0) or (not b.north and dS and dS < 0)) then k = 0.06 end
  end
  for _, I in ipairs(ISLES) do
    local yi, di = isleNatural(I, x, z)
    if yi then return yi, di end
    if -di < off then off, k = -di, 0.12 end
  end
  -- 岸线外头几格从陆地边上的 +0.6 平滑降到 −1.2（原来在岸线上直接断开 1.8 格：车开到水线就是一道坎）；海滩的缓些
  --   近岸是缓坡浅滩（最深 SHELF 格），离岸 150 格以外大陆坡往下陡降（每格降 0.28），四百多格外就是远海的深度
  local lip = 1.8 * smooth(0, (k < 0.1) and 10 or 6, off)
  local shelf = min(Map.SHELF, lip - 0.6 + off * k)
  local slope = max(0, off - 50 * K) * 0.28
  return -min(Map.SEA_DEPTH, shelf + slope), -off
end

-- 压平之后、压路之前的高度；第三个返回值是压平的权重（0～1，路在压平的场地里不再改高度）
local function flatHeight(x, z)
  local y, d = natural(x, z)
  if y <= 0.3 then return y, d, 0 end
  local wmax = 0
  for _, F in ipairs(FLAT) do
    local dx, dz = x - F.x, z - F.z
    local w = 0
    if F.rect then
      local qx, qz = max(0, abs(dx) - F.hx), max(0, abs(dz) - F.hz)
      if qx < F.m and qz < F.m then w = 1 - smooth(0, F.m, sqrt(qx * qx + qz * qz)) end
    else
      local q = dx * dx + dz * dz
      if q < F.r2 * F.r2 then w = 1 - smooth(F.r, F.r2, sqrt(q)) end
    end
    if w > 0 then
      y = lerp(y, max(F.y, 0.8), w * smooth(0, 25, d))   -- 岸边那一点不压（不改岸线）
      if w > wmax then wmax = w end
    end
  end
  return y, d, wmax
end

-- 地面（站人、放车）：海上是海面
function Map.ground(x, z)
  local y = Map.height(x, z)
  return max(y, 0)
end
function Map.isLand(x, z) return (Map.height(x, z)) > 0.3 end
function Map.slope(x, z)
  local e = 4
  local a, b = Map.height(x + e, z), Map.height(x - e, z)
  local c, d = Map.height(x, z + e), Map.height(x, z - e)
  return sqrt(((a - b) / (2 * e)) ^ 2 + ((c - d) / (2 * e)) ^ 2)
end

-- 压平的场地：高度取这一圈自然高度的平均（一半挖一半填，四周不会是一圈陡壁；不低于 3 格）
local function avgNatural(x, z, r)
  local sum, n = natural(x, z), 1
  for k = 0, 11 do
    local a = k * math.pi / 6
    for _, rr in ipairs({ r * 0.5, r }) do
      local y = natural(x + cos(a) * rr, z + sin(a) * rr)
      if y > 0 then sum += y; n += 1 end
    end
  end
  return sum / n
end
local function flatHere(x, z, r, r2, yMin)
  addFlat(x, z, r, r2, max(yMin or 3, avgNatural(x, z, r)))
end
for _, p in ipairs(Map.POINTS) do flatHere(p.x, p.z, 55 * K, 110 * K) end
do local A = Map.AIRFIELD addRect(A.x, A.z - 40 * K, A.len / 2 + 50, 120 * K, 170 * K, max(4, avgNatural(A.x, A.z - 40 * K, 200 * K))) end   -- 跑道 + 北面停机坪
do local C = Map.CAMP addRect(C.x, C.z + 15 * K, 200 * K, 85 * K, 120 * K, max(3, avgNatural(C.x, C.z, 70 * K))) end   -- 营地：帐篷、营房，南面一排车场、北面直升机停机坪（Depots.lua）
flatHere(Map.PORT.x, Map.PORT.z, 80 * K, 190 * K)   -- 压平的场地都跟着放大：路网是按放大前的地图（连这些场地）算的
addRect(Map.AFIELD2.x, Map.AFIELD2.z, Map.AFIELD2.len / 2 + 20, 70 * K, 60 * K, 6)
---------------------------------------------------------------- 路网（tools/map/roads.lua 离线算好的路线；这里按沿路平滑过的高度压平路面）

-- 线段：起点、终点、两头的路面高度、路宽；按 48 格的格子登记（查的时候只看这一格里的线段）
local SX0, SZ0, SX1, SZ1, SY0, SY1, SW = {}, {}, {}, {}, {}, {}, {}
local RCELL = 48
local rgrid = {}
local ROADS = {}
Map.ROADS = ROADS
do
  local ok, data = false, nil
  local mod = script and script.Parent and script.Parent:FindFirstChild("MapRoads")
  -- 客户端要等它复制过来（用户 11-22：无数个 AI 修不好坦克半截身子卡在地里）：客户端一进游戏头一件事就 require Map，
  --   这时 ReplicatedStorage 里几千块导入的网格还在往下传，MapRoads 常常还没到——原来 FindFirstChild 查一下没有就当没有路，
  --   这个客户端的地面高度就少了路的挖填（路堤、路堑最多差 6 格），可地形是服务器按有路写的：自己开的车按客户端的高度摆，
  --   路堤上整车矮下去半截、陷在看得见的路面里（位置再报给服务器，别人看着也陷着）。服务器开服时什么都在，等不着
  if not mod and script and script.Parent and script.Parent.WaitForChild then
    mod = script.Parent:WaitForChild("MapRoads", 60)
    if not mod then warn("[地图] 等了 60 秒还没有 ReplicatedStorage.MapRoads：这边的地面高度没有路，车会和地形对不上（脚本没换全？）") end
  end
  if mod then ok, data = pcall(require, mod) end
  if ok and type(data) == "table" then
    for _, r in ipairs(data) do
      local n = #r.p // 2
      if n >= 2 then
        local xs, zs, ys = table.create(n), table.create(n), table.create(n)
        for i = 1, n do
          xs[i], zs[i] = r.p[2 * i - 1] * K, r.p[2 * i] * K   -- tools/map/roads.lua 按放大前的地图算的：坐标乘 K（路宽不变）
          ys[i] = max(1.2, (flatHeight(xs[i], zs[i])))
        end
        -- 路面高度沿路平滑（坑坑洼洼的地形上路是顺的）；挖填不超过 5 格
        local base = table.clone(ys)
        for _ = 1, 6 do
          local nys = table.clone(ys)
          for i = 2, n - 1 do nys[i] = ys[i - 1] * 0.25 + ys[i] * 0.5 + ys[i + 1] * 0.25 end
          ys = nys
        end
        for i = 1, n do ys[i] = clamp(ys[i], base[i] - 5, base[i] + 5) end
        table.insert(ROADS, { name = r.name, w = r.w, x = xs, z = zs, y = ys })
        for i = 1, n - 1 do
          local k = #SX0 + 1
          SX0[k], SZ0[k], SX1[k], SZ1[k], SY0[k], SY1[k], SW[k] = xs[i], zs[i], xs[i + 1], zs[i + 1], ys[i], ys[i + 1], r.w
          local pad = r.w * 0.5 + 12
          for gx = floor((min(xs[i], xs[i + 1]) - pad) / RCELL), floor((max(xs[i], xs[i + 1]) + pad) / RCELL) do
            for gz = floor((min(zs[i], zs[i + 1]) - pad) / RCELL), floor((max(zs[i], zs[i + 1]) + pad) / RCELL) do
              local key = gx * 4096 + gz
              local list = rgrid[key]
              if not list then list = {} rgrid[key] = list end
              table.insert(list, k)
            end
          end
        end
      end
    end
  end
end
-- 离最近的路多远、这里的路面高度、路宽（附近没路返回 nil）
--   路面高度按附近各条线段加权（越近越重）：两条路交汇处各自平滑出来的高度不一样，只取最近那条会在交界处突然跳一截
local function roadNear(x, z)
  local list = rgrid[floor(x / RCELL) * 4096 + floor(z / RCELL)]
  if not list then return nil end
  local best, bw = 1e18, 0
  local sw, sy = 0, 0
  for _, k in ipairs(list) do
    local ax, az = SX0[k], SZ0[k]
    local dx, dz = SX1[k] - ax, SZ1[k] - az
    local L2 = dx * dx + dz * dz
    local t = (L2 > 0) and clamp(((x - ax) * dx + (z - az) * dz) / L2, 0, 1) or 0
    local px, pz = ax + dx * t - x, az + dz * t - z
    local dd = px * px + pz * pz
    if dd < best then best, bw = dd, SW[k] end
    local reach = SW[k] * 0.5 + 12
    if dd < reach * reach then
      local d = sqrt(dd)
      local w = (1 - d / reach) ^ 2 / (1 + d)
      sw += w
      sy += w * (SY0[k] + (SY1[k] - SY0[k]) * t)
    end
  end
  if best >= 1e18 then return nil end
  return sqrt(best), (sw > 0) and sy / sw or 0, bw
end
Map.roadNear = roadNear
function Map.roadDist(x, z)
  local d = roadNear(x, z)
  return d or 1e9
end

-- 港口（用户 11-20：地图有 bug——湾底的码头在 70 多格高的直崖底下，上不去；攻方从湾口冲到码头登陆也卡在崖底）：
--   湾底沿岸压出一条离水面 4 格的码头平地（码头根上的库房落在上面，靠山的三面是挡土墙，World.lua 贴水泥墙面），
--   码头北边贴着挡土墙挖一条坡道：西头跟码头一样高，往东爬 350 格、28 格宽、11° 上下，到东头接回崖顶（港口镇东南角）；
--   不往北挖：往北会把镇子东边那条路（港口镇—白滩）切出一道 30 格深的沟
local HARBOR = (function()
  local P = Map.PORT
  local zs = Map.coastS(P.x) or (P.z + 210)
  local H = { x = P.x, zs = zs, qx = 210, qd = 70, y = 4.2, rw = 14, deck = 4.6 }   -- deck：木码头面多高（比码头平地高一点）
  H.a = { x = P.x - 170, z = zs - 84 }   -- 坡道底（码头西北角，跟码头平地一样高）
  H.b = { x = P.x + 180, z = zs - 84 }   -- 坡道顶（东头，崖顶上）
  return H
end)()
Map.HARBOR = HARBOR
-- 坡道：离坡道中线多远、走到第几成（0 底～1 顶）
local function harborRamp(x, z)
  local H = HARBOR
  local ax, az, bx, bz = H.a.x, H.a.z, H.b.x, H.b.z
  local vx, vz = bx - ax, bz - az
  local L2 = vx * vx + vz * vz
  local t = ((x - ax) * vx + (z - az) * vz) / L2
  local cx, cz = ax + vx * t, az + vz * t
  return math.sqrt((x - cx) ^ 2 + (z - cz) ^ 2), t
end
Map.harborRamp = harborRamp
-- 在不在港口码头那个坑里（码头平地、坡道；m：往外多算几格）：攻击出发阵地、AI 车的出生点别选在这里——离港口镇 70 格高的崖底，机器人的寻路绕不上来
function Map.inHarbor(x, z, m)
  local H = HARBOR
  m = m or 0
  if math.abs(x - H.x) <= H.qx + m and z >= H.zs - H.qd - 30 - m and z <= H.zs + 40 + m then return true end
  local d, t = harborRamp(x, z)
  return d <= H.rw + m and t >= -0.12 and t <= 1.05
end
local function harborCut(x, z, y)
  local H = HARBOR
  if math.abs(x - H.x) <= H.qx and z >= H.zs - H.qd and z <= H.zs + 40 then   -- 码头平地（只往下削，不把海填起来）
    return math.min(y, H.y)
  end
  local d, t = harborRamp(x, z)
  if d <= H.rw and t >= -0.1 and t <= 1 then   -- 坡道：挖到坡面的高度（坡顶接上镇子的高度）；西头往外多挖 35 格平的（车从码头拐进来的地方）
    local top = H.townY or y
    return math.min(y, H.y + (top - H.y) * math.clamp(t, 0, 1))
  end
  return y
end

function Map.height(x, z)
  local y, d, wf = flatHeight(x, z)
  if y <= 0.3 then return y, d end
  local rd, ry, rw = roadNear(x, z)
  if rd then
    local half = rw * 0.5
    local w = 1 - smooth(half, half + 10, rd)   -- 路面完全压平，两边 10 格慢慢接回地形
    if w > 0 then y = lerp(y, ry, w * (1 - wf) * smooth(0, 20, d)) end
  end
  y = harborCut(x, z, y)
  return y, d
end
-- 这一点在压平的场地（据点、机场、营地、港口）里有多深：0 外面～1 完全压平（摆树、花草时避开）
function Map.flatW(x, z)
  local _, _, w = flatHeight(x, z)
  return w or 0
end
for _, p in ipairs(Map.POINTS) do p.y = Map.ground(p.x, p.z) end
HARBOR.townY = select(1, flatHeight(HARBOR.b.x, HARBOR.b.z))   -- 坡道顶接港口镇东北角那里的地面
for _, k in ipairs({ "AIRFIELD", "COMMAND", "CAMP", "PORT", "AFIELD2" }) do Map[k].y = Map.ground(Map[k].x, Map[k].z) end

---------------------------------------------------------------- 材质

function Map.material(x, z, y, slope)
  if y <= 0.4 then
    return (y > -3.5) and Enum.Material.Sand or Enum.Material.Sand
  end
  do   -- 港口的码头平地：水泥；坡道：柏油
    local H = HARBOR
    if math.abs(x - H.x) <= H.qx and z >= H.zs - H.qd and z <= H.zs + 40 and y <= H.y + 0.5 then return Enum.Material.Concrete end
    local hd, ht = harborRamp(x, z)
    if hd <= H.rw + 1 and ht >= -0.11 and ht <= 1.02 then return Enum.Material.Asphalt end
  end
  local rd, _, rw = roadNear(x, z)
  if rd and rd < rw * 0.5 + 1.2 * noise(x / 9, z / 9, 3.3) then return Enum.Material.Ground end   -- 土路（边上毛一点）
  local zs, zn = Map.coastS(x), Map.coastN(x)
  local nearBeach = y < 8 and zs and ((beachAt(x, false) and zs - z > -10 and zs - z < 90) or (beachAt(x, true) and z - zn > -10 and z - zn < 90))
  if nearBeach or y < 2.2 then return Enum.Material.Sand end
  if slope > 1.15 * HK / K then return (y > 120 * HK) and Enum.Material.Slate or Enum.Material.Rock end
  if y > 232 * HK then return Enum.Material.Rock end
  if slope > 0.92 * HK / K then return Enum.Material.Ground end   -- 陡一点的坡才露土（原来 0.75：用户 11-19 草多一点）
  local n = noise(x / (85 * K), z / (85 * K), 11.3)
  if y < 9 and n > 0.42 then return Enum.Material.Ground end   -- 海边低处零星的土地块（少一点）
  -- 大片草地，深色 LeafyGrass 只留很少几块（小地图、瞄准镜画中画、开车的路面按这个分）；
  --   Grass 上长 Roblox 会动的草叶（Map.GRASS，用户 11-24 要回来的；11-21 时嫌草叶盖住车、人的下半截，写地形时换成过 LeafyGrass）
  return (n > 0.62) and Enum.Material.LeafyGrass or Enum.Material.Grass
end

---------------------------------------------------------------- 有陆地的范围（开服生成地形只写这些块）

-- 返回 { x0, z0, x1, z1 } 若干个：主岛、各小岛，外扩一圈浅滩
function Map.landBoxes()
  local pad = 120
  local boxes = { { MI.x - MI.hs - pad, MI.z - MI.N - 140 * K - pad, MI.x + MI.hs + pad, MI.z + MI.S + 200 * K + pad } }
  for _, I in ipairs(ISLES) do
    local r = max(I.a, I.b) * 1.15 + pad
    table.insert(boxes, { I.x - r, I.z - r, I.x + r, I.z + r })
  end
  return boxes
end

-- 两点之间的直线有没有被地形挡住（AI 视线用；每 step 格取一点）
function Map.lineClear(a, b, step)
  step = step or 12
  local d = b - a
  local L = d.Magnitude
  local n = max(1, floor(L / step))
  for i = 1, n - 1 do
    local p = a + d * (i / n)
    if Map.height(p.X, p.Z) > p.Y then return false end
  end
  return true
end

-- 射线 o → o + v 第一次碰到地面（Map.height 的地形；有海的图还有海面 y = 0）的地方：返回落点、离 o 多远，碰不到返回 nil。
--   用户 11-24 晚要 streaming 优化（大地图流式加载）：开了以后客户端只有身边一片地形，远处的地形没加载，激光测距、瞄准、标点的射线打空——
--   地形本来就是按 Map.height 写的，算出来的落点和真地形一样。只在射线低于最高地形（MAXH）的那一段里一步步走，碰到了再二分 10 次
function Map.rayGround(o, v, step)
  local L = v.Magnitude
  if L < 1e-6 then return nil end
  local d = v / L
  local inf = Map.info and Map.info[Map.id]
  local sea = not inf or inf.sea ~= false
  local top = (Map.MAXH or 600) + 60
  local t0, t1 = 0, L
  if o.Y > top then
    if d.Y >= -1e-6 then return nil end   -- 在最高地形上面、还朝上或水平：碰不到
    t0 = (top - o.Y) / d.Y
  end
  if d.Y > 1e-6 then t1 = math.min(L, (top - o.Y) / d.Y) end
  if t0 >= t1 then return nil end
  step = step or math.clamp((t1 - t0) / 160, 6, 60)
  local function below(t)
    local p = o + d * t
    local h = (Map.height(p.X, p.Z))
    if sea and h < 0 then h = 0 end
    return p.Y <= h, h, p
  end
  if below(t0) then return o + d * t0, t0 end
  local t = t0
  while t < t1 do
    local tn = math.min(t1, t + step)
    if below(tn) then
      local a, b = t, tn
      for _ = 1, 10 do
        local m = (a + b) / 2
        if below(m) then b = m else a = m end
      end
      local _, h, p = below(b)
      return Vector3.new(p.X, h, p.Z), b
    end
    t = tn
  end
  return nil
end

---------------------------------------------------------------- 几张地图（用户 11-22：「加一个沙漠地图」「进入界面点地图」）
-- 上面算的是「岛屿突击」；沙漠「沙海」在 MapSands（同一套接口：height / ground / material / POINTS / CAMP / AIRFIELD ……，岛上才有的海滩、舰队、港口是空的）。
--   Map.use(id)：把那张图的字段、函数就地换进 Map 表（各模块手里拿着的 Map 表不用重新 require）；服务器开服时定一张（init.server.lua 等第一个玩家选），
--   客户端看 ReplicatedStorage 的 MapId 属性跟着换（init.client.lua）
Map.id = "island"
-- 用户 11-24：「沙漠风暴删掉」「全部默认沙海地图吧，登岛那个也删了」——只剩沙海；11-26：「改地图……这个图不适合对抗」「做一个两边带机场的城市地图吧」——
--   换成「钢城」（MapCity）：开服直接建（只有一张就不用投票），沙海留着（extra：Studio、测试台给 Workspace 设 MapName = "sands" 还能开）
-- 用户 11-26 晚：「我要求你做一个雪山地图 一定要做到极高质量」——加「雪山」（MapSnow），两张一起投票
Map.ids = { "city", "snow" }
Map.extra = { "sands" }
-- 选地图界面（MapPick.lua）用的：尺寸（公里）、模式
Map.info = {
  city = { km = 6.2, mode = "assault", sea = false },    -- 「钢城」（MapCity）：两边基地带跑道，中间一座城，据点 A～E
  sands = { km = 27.8, mode = "assault", sea = false },   -- 「沙海」（MapSands）：海湾战争式，五个阶段一个一个打
  snow = { km = 24.6, mode = "assault", sea = false },    -- 「雪山」（MapSnow）：高山河谷，两头主基地带跑道，谷外 Sketchfab 的雪峰望不到头
}
local KEEP = { use = true, profile = true, ids = true, extra = true, id = true, info = true, clamp = true, smooth = true, lerp = true, rayGround = true,
  Zones = true, Range = true, zoneOf = true }
local PROFILES = { island = {} }
for k, v in pairs(Map) do
  if not KEEP[k] then PROFILES.island[k] = v end
end
function Map.profile(id)
  if not table.find(Map.ids, id) and not table.find(Map.extra or {}, id) then return nil end   -- 不在列表里的不载（删掉的岛、沙漠风暴：只换脚本的地点里 MapDesert 模块可能还在）
  if PROFILES[id] == nil then
    local ok, mod = pcall(function()
      local name = "Map" .. string.upper(string.sub(id, 1, 1)) .. string.sub(id, 2)
      -- 客户端一进游戏就 require Map（同上面 MapRoads）：ReplicatedStorage 里几千块导入的网格还在往下传，MapSands 可能还没到——等久一点
      local mod = script.Parent:WaitForChild(name, 60)
      if not mod then error("等了 60 秒还没有 ReplicatedStorage." .. name) end
      return require(mod)
    end)
    -- 没载上不记死（下次 Map.use 还会再试：客户端照 MapId 属性再换一次时就到了）
    if ok and type(mod) == "table" then PROFILES[id] = mod end
    if not ok then warn("[地图] " .. tostring(id) .. " 加载不了：" .. tostring(mod)) end
  end
  return PROFILES[id] or nil
end
-- 地图分区（Zones.lua，用户 11-26 晚「每个地图单独一个区块」）：训练场那一块（Zones.RANGE）里的点问训练场自己的图（MapRange），
--   别处照旧问战场那张——高度、地面、坡度、材质、视线这些函数按坐标分派。换图（Map.use）以后重新包一遍
local okZ, Zones = pcall(function() return require(script.Parent:WaitForChild("Zones", 30)) end)
local okR, Range = pcall(function() return require(script.Parent:WaitForChild("MapRange", 30)) end)
if okZ and okR and type(Zones) == "table" and type(Range) == "table" then
  Map.Zones, Map.Range = Zones, Range
  function Map.zoneOf(x, z) return Zones.of(x, z) end
else
  warn("[地图] 分区模块没载上：训练场照战场的图算")
end
local function zoneWrap()
  if not Map.Zones then return end
  local inR = Zones.inRange
  for _, k in ipairs({ "height", "ground", "isLand", "slope", "flatW", "material", "navBlocked", "roadDist" }) do
    local f, g = Map[k], Range[k]
    if type(f) == "function" and type(g) == "function" then
      Map[k] = function(x, z, ...)
        if type(x) == "number" and type(z) == "number" and inR(x, z) then return g(x, z, ...) end
        return f(x, z, ...)
      end
    end
  end
  local fs = Map.segBlocked
  if type(fs) == "function" then
    Map.segBlocked = function(ax, az, ...)
      if type(ax) == "number" and type(az) == "number" and inR(ax, az) then return false end
      return fs(ax, az, ...)
    end
  end
  local fl = Map.lineClear
  if type(fl) == "function" then
    Map.lineClear = function(a, b, step)
      if typeof(a) == "Vector3" and inR(a.X, a.Z) then return Range.lineClear(a, b, step) end
      return fl(a, b, step)
    end
  end
end

function Map.use(id)
  if Map.id == id then return true end
  local P = Map.profile(id)
  if not P then return false end
  for k in pairs(Map) do
    if not KEEP[k] then Map[k] = nil end
  end
  for k, v in pairs(P) do
    if not KEEP[k] then Map[k] = v end
  end
  Map.id = id
  zoneWrap()
  return true
end

-- 一载入就换成默认那张（11-26 起是钢城）——各模块 require 到的 Map 一开始就是它（上面岛图的数学还在 PROFILES.island 里，不再用）
Map.use("city")

return Map
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="41">
      <Properties>
        <string name="Name">MapCity</string>
        <ProtectedString name="Source"><![CDATA[--!native
-- 全面大战场地图「钢城」（ReplicatedStorage.MapCity，地图 id "city"）：两边各一座带机场的主基地，中间一座城——纯数学，服务器、客户端算出来一样
--   用户 11-26：「改地图，你去 sketchfab 找一个地图加进来吧，这个图不适合对抗」→「做一个两边带机场的城市地图吧」→「要有可以撞倒的树，也可以被打倒」。
--   沙海的地形照真实的海湾战争（二十多公里的平沙、一道岭）：坦克开十几分钟才碰到人，找不到掩护，不适合对着打。这张图：
--   · 南北两头各一座主基地（营区 + 车场 + 直升机坪 + 跑道，FOB.lua 建，同沙海那套），离城边两公里左右——出车一分钟开到城边，飞机就在自家跑道起飞
--   · 中间的城 12 × 12 个街区（一格 512 格 ≈ 180 米，含街道），街道是铺在地面上的零件（柏油），地形整块平地（开服铺地形快）；
--     中央广场（据点 C）、西边公园（B，树多）、东边火车站（D，铁轨、站台、货车厢）、南边工厂（A）、北边电视塔（E）；
--     老城区五到七层的周边式街坊（中间有院子）、中心四座高楼、外圈板楼和低层铺面、几处停车场、工地、被炸过的废墟（坦克的掩护）
--   · 城外一圈郊区小楼（带院子和树）、再往外是农田（一块块不同颜色的地、田埂上一排排树、林子、农舍）；两侧、基地后面是丘陵（只是远景）
--   · 树（Map.TREES）：行道树、公园、院子、田埂、林子——坦克撞上就倒、炮弹炸倒、机枪多打几下也打断（服务器 Trees.lua 记谁倒了，客户端 Scenery.lua 画）
--   · 楼（Map.BLD）：World 开服按这张表盖（CityBuild.lua），能挡车、挡子弹，炸多了会塌（Battle.lua 的房子炸塌）；电脑车寻路、看得见看不见都算楼
--   同沙海一样的接口（height / ground / material / POINTS / BASES / FOB / chunkKind / ……），Map.use("city") 换进 Map 表
local Map = {}
local exp, abs, sin, cos, sqrt, max, min, floor = math.exp, math.abs, math.sin, math.cos, math.sqrt, math.max, math.min, math.floor
local noise = math.noise

local function clamp(v, a, b) return v < a and a or (v > b and b or v) end
local function smooth(a, b, v) local t = clamp((v - a) / (b - a), 0, 1) return t * t * (3 - 2 * t) end
local function lerp(a, b, t) return a + (b - a) * t end
Map.clamp, Map.smooth, Map.lerp = clamp, smooth, lerp

Map.NAME = "city"
Map.CITY = true
Map.LANDONLY = true    -- 没有海：舰艇、登陆艇、海滩那一套都不用（各模块按它跳过）
Map.GRASS = true       -- 草地写 Grass（长 Roblox 会动的草叶，同岛图）
Map.NOMIDAF = true     -- 两边基地各有跑道，中间没有要打的那座机场（沙海的据点 D 是机场）
local K, HK = 3, 2
Map.K, Map.HK = K, HK
Map.R = 12288          -- 地形范围 ±R（城外丘陵、基地后面都写到这）
Map.PLAY = 24576       -- 飞机的作战区（再往外自动掉头）
Map.SEA_R = 16384      -- 再往外一圈平地（只是远景）
Map.SEA_LIM = 0
Map.SEA_DEPTH = 0
Map.SHELF = 0
Map.MAXH = 260
Map.RES = 4
Map.HALF = 13500       -- 试驾场（Tech.lua testSpot）：东边丘陵上一块（离城一公里多，靶车在丘陵和农田交界那一带）
local PLAIN = 12       -- 平地的高度（4 的倍数：FillBlock 填出来和逐列写的一样高）
Map.PLAIN = PLAIN
local MAT = Enum.Material
-- 地形颜色（World.lua 写地形前 SetMaterialColor）：温带的绿地、灰的人行道和水泥、深灰的柏油
Map.COLORS = {
  Grass = Color3.fromRGB(86, 116, 58), LeafyGrass = Color3.fromRGB(66, 96, 46), Ground = Color3.fromRGB(110, 94, 72),
  Pavement = Color3.fromRGB(146, 144, 138), Concrete = Color3.fromRGB(158, 156, 150), Asphalt = Color3.fromRGB(52, 54, 58),
  Rock = Color3.fromRGB(112, 110, 104), Slate = Color3.fromRGB(92, 94, 96), Mud = Color3.fromRGB(80, 68, 52), Sand = Color3.fromRGB(184, 168, 128),
  Cobblestone = Color3.fromRGB(128, 122, 114), Limestone = Color3.fromRGB(176, 170, 156), Sandstone = Color3.fromRGB(150, 120, 92),
}
-- 地图外面那一圈远景平面（Scenery.lua）：草地的颜色，顶面和平地一样高
Map.FAR = { color = Color3.fromRGB(78, 106, 54), mat = "Grass", y = PLAIN - 0.5 }

local function rng(seed)
  local s = seed % 2147483647
  if s <= 0 then s += 2147483646 end
  return function()
    s = (s * 48271) % 2147483647
    return s / 2147483647
  end
end

---------------------------------------------------------------- 两边的主基地（同沙海：FOB.lua 建营区 + 车场 + 直升机坪 + 跑道）

local FOB = {
  camp = { x0 = -560, x1 = 560, z0 = -420, z1 = 420 },
  runway = { lz = 1150, len = 3600, wid = 90 },
  motor = { lx = -300, lz = -330 },
  heli = { lx = 400, lz = -250 },
  spawn = { lx = 0, lz = -300 },
  air = { lx = -49, lz = 1010 },
  rect = { x0 = -2200, x1 = 2200, z0 = -680, z1 = 1500 },
}
Map.FOB = FOB
local BZ = 6656   -- 基地中心离城中心多远（南北）：基地前沿（围墙外的土堤）在 5976，城的郊区到 3584，中间两公里多是农田
Map.BASES = {
  atk = { x = 0, z = BZ, yaw = 0 },              -- 攻方：南边，朝北打
  def = { x = 0, z = -BZ, yaw = math.pi },       -- 守方：北边，朝南打
}
local function baseW(B, lx, lz)
  local c, s = cos(B.yaw), sin(B.yaw)
  return B.x + lx * c + lz * s, B.z - lx * s + lz * c
end
Map.baseW = baseW
for side, B in pairs(Map.BASES) do
  B.side = side
  B.face = (side == "atk") and -1 or 1
  local function at(lx, lz) local x, z = baseW(B, lx, lz) return { x = x, z = z } end
  B.camp = at(0, 0)
  B.motor = at(FOB.motor.lx, FOB.motor.lz)
  B.heli = at(FOB.heli.lx, FOB.heli.lz)
  B.spawn = at(FOB.spawn.lx, FOB.spawn.lz)
  B.spawns = {}
  for i = 0, 3 do
    for k = 0, 3 do table.insert(B.spawns, at(FOB.spawn.lx + (i - 1.5) * 12, FOB.spawn.lz + (k - 1.5) * 12)) end
  end
  B.airSpawn = at(FOB.air.lx, FOB.air.lz)
  B.airSpawns = {}
  for i = 0, 7 do table.insert(B.airSpawns, at(FOB.air.lx + i * 14, FOB.air.lz)) end
  local rx, rz = baseW(B, 0, FOB.runway.lz)
  B.airfield = { x = rx, z = rz, len = FOB.runway.len, wid = FOB.runway.wid, rot = 0, team = side }
  local xs, zs = {}, {}
  for _, c in ipairs({ { FOB.rect.x0, FOB.rect.z0 }, { FOB.rect.x1, FOB.rect.z0 }, { FOB.rect.x0, FOB.rect.z1 }, { FOB.rect.x1, FOB.rect.z1 } }) do
    local x, z = baseW(B, c[1], c[2])
    table.insert(xs, x) table.insert(zs, z)
  end
  B.rect = { x0 = min(table.unpack(xs)), x1 = max(table.unpack(xs)), z0 = min(table.unpack(zs)), z1 = max(table.unpack(zs)) }
end
Map.REDBASE = Map.BASES.atk.camp
Map.AFIELD2 = Map.BASES.atk.airfield
Map.CAMP = Map.BASES.def.camp
Map.AFIELD3 = Map.BASES.def.airfield
Map.AIRFIELD = Map.AFIELD3   -- 别的模块按沙海那套读「机场」：这张图没有中间那座（NOMIDAF），指向守方自己的跑道，不会单独再建一座

---------------------------------------------------------------- 街道网（城区 12 × 12 个街区；郊区一圈；去两边基地的公路、田间小路）

local GRID, C0, SUB = 512, 3072, 3584   -- 一格多宽、城区 ±C0、郊区外沿 ±SUB
Map.GRID, Map.C0, Map.SUB = GRID, C0, SUB
local FX, FZ = 4608, 8704                -- 平地的范围 ±FX × ±FZ（城、郊区、农田、两边基地；256 的倍数，整块地形都是平的）
Map.FLATX, Map.FLATZ = FX, FZ
local function lineAt(i) return -C0 + i * GRID end
-- 街道宽（格）：中央大道 x = 0、和平大街 z = 0 宽 64（双向四车道），±1536 的大街和环城路（±C0）宽 44，别的 36
local function lineW(v)
  local a = abs(v)
  if a < 1 then return 64 end
  if abs(a - 1536) < 1 or abs(a - C0) < 1 then return 44 end
  return 36
end
Map.lineW = lineW

-- 街坊的种类（i、j：从西往东、从北往南第几个，0～11）
local OPEN = {   -- 几处不盖楼的街坊（坦克的掩护、视野）：停车场、工地、废墟、球场、街心花园
  ["2,3"] = "parking", ["9,8"] = "parking", ["3,6"] = "ruins", ["8,5"] = "ruins", ["5,9"] = "works", ["6,2"] = "works",
  ["1,9"] = "sports", ["10,9"] = nil, ["9,3"] = "garden", ["2,8"] = "garden", ["7,10"] = "parking", ["4,1"] = "parking",
}
local function blockType(i, j)
  if (i == 0 or i == 1) and (j == 5 or j == 6) then return "park" end          -- 西边的公园（据点 B）
  if i == 10 then return (j == 5 or j == 6) and "station" or "rail" end         -- 东边一条铁路（南北穿城），中间是火车站（据点 D）
  if (i == 3 or i == 4) and (j == 9 or j == 10) then return "factory" end       -- 南边的工厂（据点 A）
  if (i == 7 or i == 8) and (j == 1 or j == 2) then return "tv" end             -- 北边的电视塔（据点 E）
  if (i == 5 or i == 6) and (j == 5 or j == 6) then return "square" end         -- 中央广场（据点 C）
  return OPEN[i .. "," .. j] or "city"
end
Map.blockType = blockType

-- 去掉的街段（院子、公园、厂区里不过车行道）：南北向 { x, z0, z1 }、东西向 { z, x0, x1 }
local CUT_NS = { { -2560, -512 + 20, 512 - 20 }, { -1024, 1536 + 20, 2560 - 20 }, { 1024, -2560 + 20, -1536 - 20 } }
local CUT_EW = { { 2048, -1536 + 24, -512 - 20 }, { -2048, 512 + 20, 1536 - 24 }, { 0, 2048 + 18, 2560 - 18 } }   -- 最后一段：和平大街到火车站就断了（站房、站台在那）
local PLAZA = 300   -- 中央广场 |x|, |z| < PLAZA：铺石头，不是柏油
Map.PLAZA = PLAZA

-- 路段（零件铺的）：{ ax, az, bx, bz, w, k, yo }；k：street 柏油街、hw 公路、hw2 斜着的公路、lane 田间土路；
--   yo：路面比平地高多少（互相压着的路段高低错开一点，免得重叠的那一块闪：斜的公路压在直的上面、土路在最底下）
local SEGS = {}
local YO = { street = 0.10, hw = 0.10, hw2 = 0.16, lane = 0.05, lane2 = 0.07 }
local function seg(ax, az, bx, bz, w, k) k = k or "street" table.insert(SEGS, { ax, az, bx, bz, w, k, YO[k] or 0.1 }) end
do
  -- 南北向的街：每条整条铺（东西向的在路口断开，不重叠）
  for i = 0, 12 do
    local x = lineAt(i)
    local w = lineW(x)
    local z0, z1 = -C0 - lineW(C0) / 2, C0 + lineW(C0) / 2
    local cuts = {}
    for _, c in ipairs(CUT_NS) do if abs(c[1] - x) < 1 then table.insert(cuts, c) end end
    if abs(x) < 1 then table.insert(cuts, { 0, -PLAZA, PLAZA, plaza = true }) end
    table.sort(cuts, function(a, b) return a[2] < b[2] end)
    local z = z0
    for _, c in ipairs(cuts) do
      if c[2] > z then seg(x, z, x, c[2], w) end
      z = c[3]
    end
    if z1 > z then seg(x, z, x, z1, w) end
  end
  -- 东西向：两条南北街之间一段
  for j = 0, 12 do
    local z = lineAt(j)
    local w = lineW(z)
    for i = 0, 11 do
      local xa, xb = lineAt(i) + lineW(lineAt(i)) / 2, lineAt(i + 1) - lineW(lineAt(i + 1)) / 2
      local cut = nil
      for _, c in ipairs(CUT_EW) do if abs(c[1] - z) < 1 and c[2] < xb and c[3] > xa then cut = c end end
      if abs(z) < 1 and xa < PLAZA and xb > -PLAZA then   -- 和平大街过广场：广场那一段不铺柏油
        if xa < -PLAZA then seg(xa, z, -PLAZA, z, w) end
        if xb > PLAZA then seg(PLAZA, z, xb, z, w) end
      elseif cut then
        if cut[2] > xa then seg(xa, z, cut[2], z, w) end
        if xb > cut[3] then seg(cut[3], z, xb, z, w) end
      else
        seg(xa, z, xb, z, w)
      end
    end
  end
  -- 郊区：城区的街往外接到郊区外沿（±SUB），外沿一圈路
  local SW = 30
  for i = 0, 12 do
    local x = lineAt(i)
    local w = (abs(x) < 1) and 64 or ((x > 2047 and x < 2561) and 0 or SW)   -- 铁路那两条街：郊区里不接（铁路从中间过）
    if w > 0 and abs(x) < C0 - 1 then   -- 环城路两条（±C0）本身就是郊区的东西两边，不往外接
      seg(x, -SUB + SW / 2, x, -C0 - lineW(C0) / 2, w)
      seg(x, C0 + lineW(C0) / 2, x, SUB - SW / 2, w)
    end
  end
  for j = 0, 12 do
    local z = lineAt(j)
    if abs(z) < C0 - 1 then
      seg(-SUB + SW / 2, z, -C0 - lineW(C0) / 2, z, (abs(z) < 1) and 64 or SW)
      seg(C0 + lineW(C0) / 2, z, SUB - SW / 2, z, (abs(z) < 1) and 64 or SW)
    end
  end
  for _, s in ipairs({ -1, 1 }) do
    seg(-SUB - SW / 2, s * SUB, SUB + SW / 2, s * SUB, SW)           -- 郊区外沿（东西向）
    seg(s * SUB, -SUB + SW / 2, s * SUB, SUB - SW / 2, SW)            -- 郊区外沿（南北向）
  end
  -- 去两边基地的公路：中央大道一直通到基地正门；两条斜着的公路从基地正门外去郊区的两个角
  for _, s in ipairs({ -1, 1 }) do
    local gz = s * (BZ - 640)   -- 基地正门外（FOB 的路从营区南门往外修到 BZ − 620，接上不重叠）
    seg(0, s * (SUB + SW / 2), 0, gz, 64, "hw")
    seg(0, s * (BZ - 700), -1536, s * (SUB + SW / 2), 34, "hw2")
    seg(0, s * (BZ - 700), 1536, s * (SUB + SW / 2), 34, "hw2")
    -- 田间土路：东西两条、南北几条
    for _, zz in ipairs({ 4352, 5120 }) do seg(-FX + 40, s * zz, FX - 40, s * zz, 18, "lane") end
    for _, xx in ipairs({ -3584, -2560, 2560, 3584 }) do seg(xx, s * (SUB + SW / 2), xx, s * 5600, 18, "lane2") end
  end
end
Map.SEGS = SEGS

-- 路段按 64 格的格子登记（查离路多远只看这一格里的）
local RCELL = 64
local rgrid = {}
local function rkey(gx, gz) return (gx + 2048) * 4096 + gz + 2048 end
for k, s in ipairs(SEGS) do
  local pad = s[5] * 0.5 + 12
  for gx = floor((min(s[1], s[3]) - pad) / RCELL), floor((max(s[1], s[3]) + pad) / RCELL) do
    for gz = floor((min(s[2], s[4]) - pad) / RCELL), floor((max(s[2], s[4]) + pad) / RCELL) do
      local key = rkey(gx, gz)
      local l = rgrid[key]
      if not l then l = {} rgrid[key] = l end
      table.insert(l, k)
    end
  end
end
-- 离最近的路多远、那条路的路面高度、路宽（附近没路返回 nil）——路都铺在平地上，路面高度就是平地
local function roadNear(x, z)
  local l = rgrid[rkey(floor(x / RCELL), floor(z / RCELL))]
  if not l then return nil end
  local best, bw, bk = 1e18, 0, nil
  for _, k in ipairs(l) do
    local s = SEGS[k]
    local ax, az = s[1], s[2]
    local dx, dz = s[3] - ax, s[4] - az
    local L2 = dx * dx + dz * dz
    local t = (L2 > 0) and clamp(((x - ax) * dx + (z - az) * dz) / L2, 0, 1) or 0
    local px, pz = ax + dx * t - x, az + dz * t - z
    local d = px * px + pz * pz
    if d < best then best, bw, bk = d, s[5], s[6] end
  end
  if best >= 1e18 then return nil end
  return sqrt(best), PLAIN, bw, bk
end
Map.roadNear = roadNear
function Map.roadDist(x, z)
  local d = roadNear(x, z)
  return d or 1e9
end
local function onRoad(x, z, pad)
  local d, _, w, k = roadNear(x, z)
  if d and d < w * 0.5 + (pad or 0) then return true, k end
  return false
end
Map.onRoad = onRoad
-- 小地图（MapUI.lua）、电线杆一类按路线画：每段一条两点的折线
Map.ROADS = {}
for _, s in ipairs(SEGS) do
  if s[5] > 0 then table.insert(Map.ROADS, { name = s[6], w = s[5], x = { s[1], s[3] }, z = { s[2], s[4] }, y = { PLAIN, PLAIN } }) end
end
-- 中央广场也画一块（小地图）
table.insert(Map.ROADS, { name = "plaza", w = 60, x = { -PLAZA, PLAZA }, z = { 0, 0 }, y = { PLAIN, PLAIN } })

-- 铁路：南北一条（四股道），城里走 x 2048～2560 那一列，出了郊区往东拐，绕开攻守两边的基地，一直通到地图边上
local RAIL = { x = 2304, tracks = { -72, -40, 40, 72 } }
RAIL.path = { { 4300, -12000 }, { 4300, -6200 }, { 2304, -4200 }, { 2304, 4200 }, { 4300, 6200 }, { 4300, 12000 } }
Map.RAIL = RAIL
local function railNear(x, z)
  local best = 1e18
  local p = RAIL.path
  for i = 1, #p - 1 do
    local ax, az, bx, bz = p[i][1], p[i][2], p[i + 1][1], p[i + 1][2]
    local dx, dz = bx - ax, bz - az
    local L2 = dx * dx + dz * dz
    local t = clamp(((x - ax) * dx + (z - az) * dz) / L2, 0, 1)
    local qx, qz = ax + dx * t - x, az + dz * t - z
    local d = qx * qx + qz * qz
    if d < best then best = d end
  end
  return sqrt(best)
end
Map.railNear = railNear

---------------------------------------------------------------- 据点

local P_A = { id = "A", x = -1024, z = 2048 }    -- 南边：钢厂（攻方先打的）
local P_B = { id = "B", x = -2560, z = 0 }       -- 西边：公园
local P_C = { id = "C", x = 0, z = 0 }           -- 中央广场
local P_D = { id = "D", x = 2304, z = 0 }        -- 东边：火车站（站台、货车厢）
local P_E = { id = "E", x = 1024, z = -2048 }    -- 北边：电视塔（守方最后一道）
Map.POINTS = { P_A, P_B, P_C, P_D, P_E }
Map.POINT_R = 90
for _, p in ipairs(Map.POINTS) do p.land = "main" p.y = PLAIN end
Map.TOWN = { x = 0, z = 0, y = PLAIN }
Map.PORT = Map.TOWN
Map.COMMAND = { x = P_E.x, z = P_E.z, y = PLAIN }
-- 岛图的海上那一套：这张图没有
Map.FLEET, Map.BEACHES, Map.LANDINGS, Map.ISLES, Map.CAPES = {}, {}, {}, {}, {}
Map.BARGE = nil
function Map.landingOf() return nil end
function Map.landOf() return "main" end
function Map.beachAt() return nil end
function Map.coastS() return nil end
function Map.coastN() return nil end
function Map.inHarbor() return false end
Map.STARTS = {}
for i, x in ipairs({ -2560, -1024, 1024, 2560 }) do table.insert(Map.STARTS, { id = "s" .. i, x = x, z = SUB + 600, y = PLAIN }) end

---------------------------------------------------------------- 楼（Map.BLD）：{ x, z 中心, w 东西宽, d 南北深, h 高, fl 层数, st 样式, k 种类, sd 种子, id }
--   都是正南正北摆的方盒子（转 0°）：碰撞、寻路、视线都按外接矩形算。World 开服照这张表盖（CityBuild.lua）
--   样式 st：1 灰板楼、2 米黄抹灰、3 红砖、4 浅色石头（老城）、5 玻璃写字楼、6 深色砖（厂房）、7 白色新楼、8 赭黄（老城）

local BLD = {}
Map.BLD = BLD
local FH = 9   -- 一层多高（格，约 3.2 米）
Map.FH = FH
local function addB(x, z, w, d, fl, st, k, sd, extra)
  if w < 12 or d < 12 then return nil end
  local b = { x = x, z = z, w = w, d = d, fl = fl, h = fl * FH + 2, st = st, k = k or "block", sd = sd or (#BLD * 7919 % 100003) }
  if extra then for kk, v in pairs(extra) do b[kk] = v end end
  b.id = #BLD + 1
  BLD[b.id] = b
  return b
end
-- 一块矩形 [x0, x1] × [z0, z1] 里放一座
local function addRect(x0, x1, z0, z1, fl, st, k, sd, extra)
  return addB((x0 + x1) / 2, (z0 + z1) / 2, x1 - x0, z1 - z0, fl, st, k, sd, extra)
end

local SIDE = 10   -- 人行道（楼离路边多远）
-- 街坊里能盖楼的范围（扣掉四边的半条街、人行道）
local function interior(i, j)
  local bx0, bx1, bz0, bz1 = lineAt(i), lineAt(i + 1), lineAt(j), lineAt(j + 1)
  return bx0 + lineW(bx0) / 2 + SIDE, bx1 - lineW(bx1) / 2 - SIDE, bz0 + lineW(bz0) / 2 + SIDE, bz1 - lineW(bz1) / 2 - SIDE
end
Map.blockInterior = interior

local STYLE_OLD = { 4, 8, 2, 3, 4, 8 }
local STYLE_MID = { 1, 2, 3, 7, 1, 2 }
local STYLE_OUT = { 1, 1, 7, 2, 3 }
local function pick(t, r) return t[floor(r * #t) + 1] end

-- 周边式街坊（老城、内圈）：四边沿街一圈楼，中间院子；有的一边留个门洞（坦克钻得进院子）
local function perimeter(i, j, R, flo, fhi, styles)
  local x0, x1, z0, z1 = interior(i, j)
  local D = 58 + floor(R() * 4) * 8   -- 进深
  local function run(ax0, ax1, az0, az1, alongX, gap)
    -- 沿一边分成两三座（高矮、样式不同）；gap：中间留一个门洞
    local L = alongX and (ax1 - ax0) or (az1 - az0)
    local n = (L > 360) and 2 or 1   -- 一边一两座（零件少：一座十来块）
    local cuts = { 0 }
    for q = 1, n - 1 do table.insert(cuts, L * (q / n) + (R() - 0.5) * L * 0.12) end
    table.insert(cuts, L)
    local gi = gap and (1 + floor(R() * n)) or nil
    if n == 1 then cuts = { 0, L } end
    for q = 1, n do
      local a, b2 = cuts[q], cuts[q + 1]
      if gi == q then   -- 这一段中间开个 34 格的口
        local m = (a + b2) / 2
        local function put(s0, s1)
          if s1 - s0 < 24 then return end
          if alongX then addRect(ax0 + s0, ax0 + s1, az0, az1, flo + floor(R() * (fhi - flo + 1)), pick(styles, R()), "block", floor(R() * 1e6))
          else addRect(ax0, ax1, az0 + s0, az0 + s1, flo + floor(R() * (fhi - flo + 1)), pick(styles, R()), "block", floor(R() * 1e6)) end
        end
        put(a, m - 17)
        put(m + 17, b2)
      else
        local fl = flo + floor(R() * (fhi - flo + 1))
        if alongX then addRect(ax0 + a, ax0 + b2, az0, az1, fl, pick(styles, R()), "block", floor(R() * 1e6))
        else addRect(ax0, ax1, az0 + a, az0 + b2, fl, pick(styles, R()), "block", floor(R() * 1e6)) end
      end
    end
  end
  local gapSide = floor(R() * 4)
  run(x0, x1, z0, z0 + D, true, gapSide == 0)            -- 北边
  run(x0, x1, z1 - D, z1, true, gapSide == 1)            -- 南边
  run(x0, x0 + D, z0 + D + 6, z1 - D - 6, false, gapSide == 2)   -- 西边
  run(x1 - D, x1, z0 + D + 6, z1 - D - 6, false, gapSide == 3)   -- 东边
end

-- 2 × 2 座、中间十字小巷（坦克能从街坊里穿过去）
local function grid2(i, j, R, flo, fhi, styles)
  local x0, x1, z0, z1 = interior(i, j)
  local a = 30 + floor(R() * 3) * 6   -- 巷宽
  local mx, mz = (x0 + x1) / 2 + (R() - 0.5) * 60, (z0 + z1) / 2 + (R() - 0.5) * 60
  for _, q in ipairs({ { x0, mx - a / 2, z0, mz - a / 2 }, { mx + a / 2, x1, z0, mz - a / 2 }, { x0, mx - a / 2, mz + a / 2, z1 }, { mx + a / 2, x1, mz + a / 2, z1 } }) do
    if R() < 0.9 then
      local m = 4 + R() * 14   -- 每座四周再收进去一点（楼和楼之间有空）
      addRect(q[1] + m, q[2] - m, q[3] + m, q[4] - m, flo + floor(R() * (fhi - flo + 1)), pick(styles, R()), "block", floor(R() * 1e6))
    end
  end
end

-- 两三排平行的长条板楼（外圈住宅区），排和排之间是绿地、停车的空地
local function slabs(i, j, R, flo, fhi)
  local x0, x1, z0, z1 = interior(i, j)
  local alongX = R() < 0.5
  local n = (R() < 0.55) and 2 or 3
  local D = 42 + floor(R() * 3) * 4
  local span = alongX and (z1 - z0) or (x1 - x0)
  local gapL = (span - n * D) / (n - 1)
  for q = 0, n - 1 do
    local o = q * (D + gapL)
    local cut = (R() < 0.35) and (60 + R() * 120) or nil   -- 有的一排中间断开（过车）
    local fl = flo + floor(R() * (fhi - flo + 1))
    local st = (R() < 0.6) and 1 or pick(STYLE_OUT, R())
    if alongX then
      if cut then
        addRect(x0 + 8, cut + x0, z0 + o, z0 + o + D, fl, st, "slab", floor(R() * 1e6))
        addRect(cut + x0 + 36, x1 - 8, z0 + o, z0 + o + D, fl, st, "slab", floor(R() * 1e6))
      else
        addRect(x0 + 8, x1 - 8, z0 + o, z0 + o + D, fl, st, "slab", floor(R() * 1e6))
      end
    else
      if cut then
        addRect(x0 + o, x0 + o + D, z0 + 8, cut + z0, fl, st, "slab", floor(R() * 1e6))
        addRect(x0 + o, x0 + o + D, cut + z0 + 36, z1 - 8, fl, st, "slab", floor(R() * 1e6))
      else
        addRect(x0 + o, x0 + o + D, z0 + 8, z1 - 8, fl, st, "slab", floor(R() * 1e6))
      end
    end
  end
end

-- 高楼：两层的裙楼、上面一座塔楼（中心四个街坊）
local function towers(i, j, R)
  local x0, x1, z0, z1 = interior(i, j)
  local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
  local tw = 74 + floor(R() * 3) * 10
  local fl = 16 + floor(R() * 10)
  addB(cx + (R() - 0.5) * 80, cz + (R() - 0.5) * 80, tw, tw, fl, 5, "tower", floor(R() * 1e6))
  -- 裙楼：塔楼四周四座矮的（两三层），中间留出路
  for _, q in ipairs({ { x0, cx - 70, z0, z0 + 90 }, { cx + 70, x1, z1 - 90, z1 }, { x0, x0 + 90, cz + 70, z1 }, { x1 - 90, x1, z0, cz - 70 } }) do
    if R() < 0.85 then addRect(q[1] + 6, q[2] - 6, q[3] + 6, q[4] - 6, 2 + floor(R() * 3), pick({ 7, 5, 1 }, R()), "low", floor(R() * 1e6)) end
  end
end

-- 低层铺面（外圈）：三乘三小块，两三层，空着几块
local function lowrise(i, j, R)
  local x0, x1, z0, z1 = interior(i, j)
  local nx, nz = 3, 3
  local cw, cd = (x1 - x0) / nx, (z1 - z0) / nz
  for a = 0, nx - 1 do
    for b = 0, nz - 1 do
      if not (a == 1 and b == 1) and R() < 0.8 then
        local m = 8 + R() * 10
        addRect(x0 + a * cw + m, x0 + (a + 1) * cw - m, z0 + b * cd + m, z0 + (b + 1) * cd - m, 2 + floor(R() * 2), pick({ 2, 3, 7, 8 }, R()), "low", floor(R() * 1e6))
      end
    end
  end
end

-- 被炸过的废墟：几座矮的残楼（坦克躲在后面）
local function ruins(i, j, R)
  local x0, x1, z0, z1 = interior(i, j)
  for _ = 1, 4 + floor(R() * 3) do
    local w, d = 50 + R() * 70, 40 + R() * 60
    local x, z = x0 + w / 2 + R() * (x1 - x0 - w), z0 + d / 2 + R() * (z1 - z0 - d)
    addB(x, z, w, d, 1 + floor(R() * 2), pick({ 2, 3, 4 }, R()), "ruin", floor(R() * 1e6))
  end
end

-- 城区：每个街坊按圈数定楼的样子（越靠中间越高越密）
do
  for i = 0, 11 do
    for j = 0, 11 do
      local t = blockType(i, j)
      local R = rng(7001 + i * 131 + j * 977)
      local rr = max(abs(i - 5.5), abs(j - 5.5))   -- 0.5 中心 ～ 5.5 城边
      if t == "city" then
        if rr <= 1.5 then
          if (i == 4 or i == 7) and (j == 4 or j == 7) then towers(i, j, R)
          else perimeter(i, j, R, 5, 7, STYLE_OLD) end
        elseif rr <= 3.5 then
          local r = R()
          if r < 0.4 then perimeter(i, j, R, 4, 6, STYLE_MID)
          elseif r < 0.7 then grid2(i, j, R, 4, 8, STYLE_MID)
          elseif r < 0.88 then slabs(i, j, R, 6, 9)
          else towers(i, j, R) end
        else
          local r = R()
          if r < 0.45 then slabs(i, j, R, 5, 9)
          elseif r < 0.75 then grid2(i, j, R, 3, 6, STYLE_OUT)
          else lowrise(i, j, R) end
        end
      elseif t == "ruins" then
        ruins(i, j, R)
      elseif t == "square" then
        -- 中央广场四周：每个街坊扣掉靠广场的那一角，剩下 L 形两座；西北那座是市政厅（中间一座钟楼），东南是教堂
        local x0, x1, z0, z1 = interior(i, j)
        local east, south = (i == 6), (j == 6)
        -- 竖条：离广场远的那一边（东边的街坊在东、西边的在西），南北全长
        local vx0, vx1 = (PLAZA + 10), x1
        if not east then vx0, vx1 = x0, -(PLAZA + 10) end
        addRect(vx0, vx1, z0, z1, 6, pick(STYLE_OLD, R()), "block", floor(R() * 1e6))
        -- 横条：广场那一角南边（北边）剩下的：东西从街坊靠广场的边到广场边，南北离广场远的那一边
        local hx0, hx1 = x0, PLAZA
        if not east then hx0, hx1 = -PLAZA, x1 end
        local hz0, hz1 = PLAZA + 10, z1
        if not south then hz0, hz1 = z0, -(PLAZA + 10) end
        if i == 5 and j == 5 then
          addRect(hx0, hx1, hz0, hz1, 6, 4, "hall", 5501, { tower = true })   -- 市政厅：朝着广场，顶上一座钟楼
        elseif i == 6 and j == 6 then
          addRect(hx0, hx1, hz0, hz1, 5, 4, "church", 6601, { tower = true })   -- 教堂：一座尖顶钟楼
        else
          addRect(hx0, hx1, hz0, hz1, 6, pick(STYLE_OLD, R()), "block", floor(R() * 1e6))
        end
      end
    end
  end
  -- 钢厂（据点 A，四个街坊连成一个厂区，中间的街去掉了）：四角四座锯齿顶厂房，中间空场（据点），边上办公楼、仓库
  do
    local R = rng(31013)
    local ax, az = P_A.x, P_A.z
    addRect(ax - 470, ax - 190, az - 470, az - 210, 4, 6, "shed", 101)
    addRect(ax + 190, ax + 470, az - 470, az - 210, 4, 6, "shed", 102)
    addRect(ax - 470, ax - 190, az + 210, az + 470, 4, 6, "shed", 103)
    addRect(ax + 190, ax + 470, az + 210, az + 470, 4, 6, "shed", 104)
    addRect(ax - 120, ax + 120, az - 470, az - 370, 4, 3, "block", 105)   -- 厂部办公楼（北边）
    addRect(ax - 140, ax + 140, az + 380, az + 470, 2, 6, "shed", 106)    -- 仓库（南边）
    addRect(ax - 470, ax - 360, az - 120, az + 120, 3, 6, "shed", 107)    -- 西边的车间
    local _ = R
  end
  -- 电视塔（据点 E，四个街坊连成一片）：塔在东南角、广播大楼在西北、东北一座、西南一座演播楼
  do
    local ex, ez = P_E.x, P_E.z
    addB(ex + 300, ez - 300, 44, 44, 40, 7, "tvtower", 201)     -- 塔身（40 层高 ≈ 130 米；画的时候是圆柱 + 塔楼 + 天线）
    addRect(ex - 470, ex - 160, ez - 470, ez - 280, 7, 7, "block", 202)   -- 广播大楼
    addRect(ex + 160, ex + 470, ez + 280, ez + 470, 4, 5, "block", 203)   -- 演播楼（玻璃）
    addRect(ex - 470, ex - 300, ez + 180, ez + 470, 3, 1, "low", 204)
    addRect(ex + 140, ex + 260, ez - 470, ez - 360, 2, 1, "low", 205)
  end
  -- 火车站（据点 D）：站房在铁轨东边，长长一座拱顶大厅
  addRect(2410, 2534, -300, 300, 5, 4, "station", 301)
  -- 公园（据点 B）：西北角一座玻璃温室（博物馆），别的都是树
  addRect(-3036, -2860, -480, -370, 3, 5, "low", 401)
  addRect(-2240, -2084, 380, 480, 2, 2, "low", 402)
end

-- 铁路沿线（城里那一列，除了车站）：几座小仓库；股道上停着一列列货车厢（挡车、挡子弹的掩护；不算房子、炸不塌）
do
  local R = rng(55501)
  for j = 0, 11 do
    if j ~= 5 and j ~= 6 then
      local _, _, z0, z1 = interior(10, j)
      -- 股道上的货车厢：每格两三节一串，停在随机的股道上
      for _ = 1, 2 do
        local tx = RAIL.x + RAIL.tracks[1 + floor(R() * 4)]
        local n = 2 + floor(R() * 3)
        local zz = z0 + 20 + R() * max(0, (z1 - z0) - n * 46 - 40)
        for q = 0, n - 1 do addB(tx, zz + q * 46 + 21, 11, 42, 1, 6, "wagon", floor(R() * 1e6), { h = 14 }) end
      end
      if R() < 0.5 then addRect(2460, 2530, z0 + 40, z0 + 160, 2, 6, "shed", floor(R() * 1e6)) end
    end
  end
  -- 车站两头的股道上也停几节
  for _, q in ipairs({ { RAIL.x - 72, -460 }, { RAIL.x + 40, 330 }, { RAIL.x - 40, 380 } }) do
    addB(q[1], q[2], 11, 42, 1, 6, "wagon", 900 + q[2], { h = 14 })
  end
end
for _, b in ipairs(BLD) do if b.k == "wagon" then b.h = 14 end end

-- 郊区：一圈独栋小楼（坡屋顶、院子），每个郊区街坊两排三座，空着一些当院子、菜地
local BM = nil
pcall(function()
  local RS = game:GetService("ReplicatedStorage")
  local m = RS:FindFirstChild("BuildingMeta")
  if m then BM = require(m) end
end)
local HOUSES = { "jph1", "jph2", "jph3", "house" }
local function houseDims(k)
  local m = BM and BM[k]
  if m then return m.w, m.d, m.h end
  return 26, 23, 20
end
do
  local R = rng(66607)
  local function suburbBlock(x0, x1, z0, z1)
    -- 扣掉半条街和人行道
    x0, x1, z0, z1 = x0 + 25, x1 - 25, z0 + 25, z1 - 25
    if x1 - x0 < 80 or z1 - z0 < 80 then return end
    local alongX = (x1 - x0) >= (z1 - z0)
    local n = 3
    for row = 0, 1 do
      for q = 0, n - 1 do
        if R() < 0.72 then
          local k = HOUSES[1 + floor(R() * #HOUSES)]
          local w, d, h = houseDims(k)
          local cx, cz
          if alongX then
            cx = x0 + (q + 0.5) * (x1 - x0) / n + (R() - 0.5) * 30
            cz = (row == 0) and (z0 + d / 2 + 14 + R() * 10) or (z1 - d / 2 - 14 - R() * 10)
          else
            cz = z0 + (q + 0.5) * (z1 - z0) / n + (R() - 0.5) * 30
            cx = (row == 0) and (x0 + d / 2 + 14 + R() * 10) or (x1 - d / 2 - 14 - R() * 10)
          end
          -- 朝着外面那条街（只转 0° / 90° / 180° / 270°，外接矩形照转过的算）
          local rot = alongX and ((row == 0) and math.pi or 0) or ((row == 0) and (math.pi / 2) or (-math.pi / 2))
          local fw, fd = w, d
          if not alongX then fw, fd = d, w end
          addB(cx, cz, fw, fd, 2, pick({ 2, 7, 3, 8 }, R()), "house", floor(R() * 1e6), { model = k, rot = rot, h = h })
        end
      end
    end
  end
  for _, s in ipairs({ -1, 1 }) do
    -- 北 / 南两排郊区（x 方向 14 个街坊）
    for i = -1, 12 do
      local xa = (i == -1) and -SUB or lineAt(i)
      local xb = (i == 12) and SUB or lineAt(i + 1)
      if not (xa >= 2047 and xb <= 2561) then   -- 铁路过的那一列不盖
        local za, zb = (s < 0) and -SUB or C0, (s < 0) and -C0 or SUB
        suburbBlock(xa, xb, za, zb)
      end
    end
    -- 东 / 西两列（z 方向 12 个街坊）
    for j = 0, 11 do
      local za, zb = lineAt(j), lineAt(j + 1)
      local xa, xb = (s < 0) and -SUB or C0, (s < 0) and -C0 or SUB
      suburbBlock(xa, xb, za, zb)
    end
  end
  -- 农田里的农舍：一座住房、一座谷仓
  local FARMS = { { -3000, 4700 }, { 3300, 4000 }, { -1900, 5500 }, { 1700, 4500 }, { 3300, -4000 }, { -2900, -4800 }, { 1900, -5500 }, { -1700, -4500 } }
  for fi, f in ipairs(FARMS) do
    local k = HOUSES[1 + (fi % #HOUSES)]
    local w, d, h = houseDims(k)
    addB(f[1], f[2], w, d, 2, 2, "house", 7000 + fi, { model = k, rot = 0, h = h })
    addB(f[1] + 70, f[2] + 10, 44, 64, 2, 6, "barn", 7100 + fi, { h = 26 })
  end
end

---------------------------------------------------------------- 写实楼
-- 用户 11-26「地图建模要精细 3a」：城里的楼换成 Sketchfab 上 CC-BY 的写实楼房（CityMeta / models/bld/city.glb，tools/models/sfbld.py 转的）——
--   沿街的楼（block）、板楼（slab）、塔楼（tower）、铺面（low）、废墟（ruin）这几种：在那块地的长边上一座挨一座排，
--   每座按地块的进深整体缩放（0.85～1.15 倍；塔楼、废墟 0.72～1.2），正面朝最近的那条街、贴着街那一侧（街面整齐，后面留院子）；
--   排到头剩下的一截照旧零件拼一座；塔楼地块小，原大放得下（不压别的楼、不压路）就按原大。
--   换成模型的楼按模型转过、缩放过的外接矩形登记（k = "model"：碰撞、寻路、视线、炸塌都照它）；没导入 city.glb 时 CityBuild 照同样的长宽高用零件拼，
--   所以服务器、客户端、导没导入，地图上哪里能走、哪里挡视线都一样
local CM = nil
pcall(function()
  local RS = game:GetService("ReplicatedStorage")
  local m = RS:FindFirstChild("CityMeta")
  if m then CM = require(m) end
end)
Map.CITY_META = CM
if CM then
  local POOL = {
    old = { "stalin", "office1", "shop1", "brick3", "stalin", "office1" },   -- 老城：老式住宅楼、砖面写字楼、街角铺面、砖楼
    mid = { "stalin", "panel5", "brick3", "office2", "shop1", "office1" },
    out = { "panel9", "panel5", "stalin", "brick3", "panel9" },               -- 外圈：板楼为主
    slab = { "panel9", "panel5", "panel9" },
    tower = { "tower1", "office2", "tower1" },
    low = { "shop1", "khrush", "shop1", "brick3" },
    ruin = { "ruin1" },
  }
  local KINDS = { block = true, slab = true, tower = true, low = true, ruin = true }
  local function poolOf(b)
    if b.k == "slab" then return POOL.slab, 0.85, 1.15, 10 end
    if b.k == "tower" then return POOL.tower, 0.72, 1.2, 0 end
    if b.k == "low" then return POOL.low, 0.85, 1.15, 8 end
    if b.k == "ruin" then return POOL.ruin, 0.72, 1.2, 0 end
    local r = max(abs(b.x), abs(b.z))
    if r < 1100 then return POOL.old, 0.85, 1.15, 0 end   -- 老城沿街一座挨一座（连着的街面）
    if r < 2100 then return POOL.mid, 0.85, 1.15, 3 end
    return POOL.out, 0.85, 1.15, 8
  end
  local OUT = {}   -- 新的楼表（换完以后重新编号）
  local function put(b) OUT[#OUT + 1] = b end
  -- 一块矩形 [x, z, w, d] 有没有压到别的楼（除了 skip）、压到路
  local function free(x, z, w, d, skip)
    for _, o in ipairs(BLD) do
      if o ~= skip and abs(o.x - x) < (o.w + w) / 2 + 4 and abs(o.z - z) < (o.d + d) / 2 + 4 then return false end
    end
    for _, c in ipairs({ { -0.5, -0.5 }, { 0.5, -0.5 }, { -0.5, 0.5 }, { 0.5, 0.5 }, { 0, -0.5 }, { 0, 0.5 }, { -0.5, 0 }, { 0.5, 0 } }) do
      if onRoad(x + c[1] * w, z + c[2] * d, 4) then return false end
    end
    return true
  end
  local function model(b, key, s, cx, cz, alongX, front)
    local m = CM[key]
    local lm, dm = m.w * s, m.d * s
    -- 正面（模型的 −Z）朝 front：沿 x 排的朝 −z（0）/ +z（π）；沿 z 排的朝 −x（π/2）/ +x（−π/2）
    local rot = alongX and ((front < 0) and 0 or math.pi) or ((front < 0) and (math.pi / 2) or (-math.pi / 2))
    local h = m.h * s
    put({ x = cx, z = cz, w = alongX and lm or dm, d = alongX and dm or lm, h = h, fl = max(1, floor((h - 2) / FH)), st = b.st, k = "model",
      model = key, rot = rot, scale = s, sd = b.sd + #OUT * 13 })
  end
  local function fill(b)
    local pool, smin, smax, gap = poolOf(b)
    local R = rng(b.sd + 911)
    local alongX = b.w >= b.d
    local L, D = alongX and b.w or b.d, alongX and b.d or b.w
    -- 正面朝长边两侧里离路近的那边
    local o = D / 2 + 30
    local d1 = alongX and Map.roadDist(b.x, b.z - o) or Map.roadDist(b.x - o, b.z)
    local d2 = alongX and Map.roadDist(b.x, b.z + o) or Map.roadDist(b.x + o, b.z)
    local front = (d1 <= d2) and -1 or 1
    -- 塔楼：原大放得下就原大
    if b.k == "tower" then
      for _ = 1, 4 do
        local key = pool[1 + floor(R() * #pool)]
        local m = CM[key]
        if m and free(b.x, b.z, m.w, m.d, b) then
          model(b, key, 1, b.x, b.z, true, front)
          return true
        end
      end
    end
    local pos = -L / 2
    local n0 = #OUT
    while true do
      local rem = L / 2 - pos
      local pick1 = nil
      for _ = 1, #pool * 2 do
        local key = pool[1 + floor(R() * #pool)]
        local m = CM[key]
        if m then
          local s = math.min(smax, D / m.d)
          if m.w * s > rem then s = rem / m.w end   -- 长度放不下：缩到正好
          if s >= smin and m.d * s <= D + 0.01 then pick1 = { key = key, s = s, m = m } break end
        end
      end
      if not pick1 then break end
      local lm, dm = pick1.m.w * pick1.s, pick1.m.d * pick1.s
      local along = pos + lm / 2
      local across = front * (D / 2 - dm / 2)
      local cx, cz
      if alongX then cx, cz = b.x + along, b.z + across else cx, cz = b.x + across, b.z + along end
      model(b, pick1.key, pick1.s, cx, cz, alongX, front)
      pos = pos + lm + gap
    end
    if #OUT == n0 then return false end
    -- 排到头剩下的一截：够宽就照旧零件拼一座（进深跟街面那排差不多）
    local rem = L / 2 - pos
    if rem >= 30 and (b.k == "block" or b.k == "low") then
      local dd = math.min(D, 60)
      local along = pos + rem / 2
      local across = front * (D / 2 - dd / 2)
      local cx, cz
      if alongX then cx, cz = b.x + along, b.z + across else cx, cz = b.x + across, b.z + along end
      put({ x = cx, z = cz, w = alongX and rem or dd, d = alongX and dd or rem, h = b.h, fl = b.fl, st = b.st, k = b.k, sd = b.sd + 17 })
    end
    return true
  end
  for _, b in ipairs(BLD) do
    if not (KINDS[b.k] and fill(b)) then put(b) end
  end
  table.clear(BLD)
  for i, b in ipairs(OUT) do
    b.id = i
    BLD[i] = b
  end
end

-- 楼按 128 格的格子登记
local BCELL = 128
local bgrid = {}
local function bkey(gx, gz) return (gx + 512) * 1024 + (gz + 512) end
for _, b in ipairs(BLD) do
  local pad = 24
  for gx = floor((b.x - b.w / 2 - pad) / BCELL), floor((b.x + b.w / 2 + pad) / BCELL) do
    for gz = floor((b.z - b.d / 2 - pad) / BCELL), floor((b.z + b.d / 2 + pad) / BCELL) do
      local key = bkey(gx, gz)
      local l = bgrid[key]
      if not l then l = {} bgrid[key] = l end
      table.insert(l, b)
    end
  end
end
-- 塌了的楼（Battle.lua 炸塌时记；新一局清空）：视线、站位不再算它（寻路网格开服时算好，不跟着变）
Map.BLD_DOWN = {}
-- (x, z) 在哪座楼里（外接矩形四边外扩 pad）；没有返回 nil
local function bldAt(x, z, pad)
  local l = bgrid[bkey(floor(x / BCELL), floor(z / BCELL))]
  if not l then return nil end
  pad = pad or 0
  for _, b in ipairs(l) do
    if abs(x - b.x) <= b.w / 2 + pad and abs(z - b.z) <= b.d / 2 + pad then return b end
  end
  return nil
end
Map.bldAt = bldAt
-- 机器人寻路（Nav.lua）：楼、车厢外扩 12 格（车身半宽 + 余量）的地方不能走
function Map.navBlocked(x, z) return bldAt(x, z, 12) ~= nil end
-- 两点之间平着走过去会不会撞楼（寻路往前看几格、找停车位用）
function Map.segBlocked(ax, az, bx, bz, pad)
  local dx, dz = bx - ax, bz - az
  local L = sqrt(dx * dx + dz * dz)
  local n = max(1, floor(L / 10))
  for q = 0, n do
    local t = q / n
    if bldAt(ax + dx * t, az + dz * t, pad or 10) then return true end
  end
  return false
end

---------------------------------------------------------------- 地形高度

-- 平地（城、郊区、农田、两边基地）以外是丘陵：东西两侧一道岭，远处起伏；离平地越近越平（接得上）
local function hills(x, z)
  local qx, qz = max(0, abs(x) - FX), max(0, abs(z) - FZ)
  if qx <= 0 and qz <= 0 then return 0 end
  local k = smooth(0, 1800, sqrt(qx * qx + qz * qz))
  local n = noise(x / 2900, z / 2900, 4.2) * 0.6 + noise(x / 1150, z / 1150, 8.1) * 0.28 + noise(x / 430, z / 430, 2.7) * 0.1
  local ridge = exp(-((abs(x) - 8200) / 1700) ^ 2) * (110 + 40 * noise(z / 2400, 3.3, 1.7))
  return (max(0, n + 0.3) * 70 + ridge) * k
end
function Map.height(x, z) return PLAIN + hills(x, z), 1e9 end
function Map.ground(x, z) return PLAIN + hills(x, z) end
function Map.isLand() return true end
function Map.slope(x, z)
  if abs(x) < FX and abs(z) < FZ then return 0 end
  local e = 4
  local a, b = Map.height(x + e, z), Map.height(x - e, z)
  local c, d = Map.height(x, z + e), Map.height(x, z - e)
  return sqrt(((a - b) / (2 * e)) ^ 2 + ((c - d) / (2 * e)) ^ 2)
end
-- 在不在两边基地的场子里（0～1）：摆树、灌木时避开
local function inBase(x, z, m)
  m = m or 0
  for _, B in pairs(Map.BASES) do
    local r = B.rect
    if x > r.x0 - m and x < r.x1 + m and z > r.z0 - m and z < r.z1 + m then return true end
  end
  return false
end
Map.inBase = inBase
function Map.flatW(x, z) return inBase(x, z, 0) and 1 or 0 end
Map.FLAT = {}

---------------------------------------------------------------- 材质

-- 平地这一块（256 格见方，按块中心）是什么地面：城里人行道（灰）、公园草地、铁路碎石、厂区水泥；郊区草地；农田一块块（草、翻过的土、深一点的草）；基地压实的土
local function flatMat(cx, cz)
  if inBase(cx, cz, 200) then return MAT.Ground end
  local ax, az = abs(cx), abs(cz)
  if ax < C0 and az < C0 then
    if cx > -C0 and cx < -2048 and az < 512 then return MAT.Grass end     -- 公园
    if cx > 2048 and cx < 2560 then return MAT.Ground end                 -- 铁路那一列
    if abs(cx - P_A.x) < 512 and abs(cz - P_A.z) < 512 then return MAT.Concrete end   -- 钢厂
    return MAT.Pavement
  end
  if ax < SUB and az < SUB then return MAT.Grass end   -- 郊区：院子里的草
  -- 农田：512 × 256 一块，按块号定种（翻过的地、草、深色的草）
  local fx, fz = floor(cx / 512), floor(cz / 256)
  local h = (fx * 73856093 + fz * 19349663) % 100   -- Luau 没有 ~（异或）：加起来取余一样散
  if h < 28 then return MAT.Ground end
  if h < 46 then return MAT.LeafyGrass end
  return MAT.Grass
end
Map.flatMat = flatMat

function Map.material(x, z, y, slope)
  if abs(x) < FX and abs(z) < FZ then
    local on, k = onRoad(x, z, 0)
    if on then return (k == "lane" or k == "lane2") and MAT.Ground or MAT.Asphalt end   -- 路（零件铺的，地形底下是人行道 / 草）
    if abs(x) < PLAZA and abs(z) < PLAZA then return MAT.Cobblestone end   -- 中央广场
    if bldAt(x, z, 0) then return MAT.Concrete end
    if railNear(x, z) < 90 then return MAT.Slate end
    return flatMat(x, z)
  end
  slope = slope or 0
  if slope > 0.9 then return MAT.Rock end
  if slope > 0.55 then return MAT.Ground end
  if (y or 0) > 170 and noise(x / 160, z / 160, 3.3) > 0.15 then return MAT.Rock end
  return (noise(x / 700, z / 700, 5.5) > 0.3) and MAT.LeafyGrass or MAT.Grass
end
function Map.colCache() end   -- 沙海的列缓存：这张图的高度、材质都便宜，不用缓存
function Map.underMat(top)
  if top == MAT.Rock or top == MAT.Slate then return MAT.Rock end
  return MAT.Ground
end
function Map.farSeaOk() return false end

---------------------------------------------------------------- 写地形（World.lua 用）

local CH = 256
-- 一块 256 × 256 格：整块在平地里就是 "flat"（一次 FillBlock：高度 PLAIN、材质按这一块），别的（丘陵）"relief" 逐列写
function Map.chunkKind(x0, z0)
  local x1, z1 = x0 + CH, z0 + CH
  if x0 >= -FX and x1 <= FX and z0 >= -FZ and z1 <= FZ then
    return "flat", PLAIN, flatMat(x0 + CH / 2, z0 + CH / 2)
  end
  -- 平地外面一圈：丘陵从平地边上慢慢抬起来——9 × 9 个点都还是平的（还没抬起来）就照平地铺
  local step = CH / 8
  for i = 0, 8 do
    for k = 0, 8 do
      if hills(x0 + i * step, z0 + k * step) > 0.01 then return "relief" end
    end
  end
  return "flat", PLAIN, MAT.Grass
end
-- 写地形的顺序：开服先写两边基地一带（出生只在自己基地），再据点一带、城区，别的在后台
Map.CORE = { x = 0, z = 0, r = 4000 }
Map.CORES = {}
for _, B in pairs(Map.BASES) do table.insert(Map.CORES, { x = (B.rect.x0 + B.rect.x1) / 2, z = (B.rect.z0 + B.rect.z1) / 2, r = 2700 }) end
Map.HOTS = {}
for _, c in ipairs(Map.CORES) do table.insert(Map.HOTS, c) end
table.insert(Map.HOTS, { x = 0, z = 0, r = 4300 })   -- 整座城（平地，铺得快）

-- 画中画瞄准镜的远景网格、小地图、寻路
function Map.landBoxes() return { { -FX, -FZ, FX, FZ } } end
Map.UIBOX = { x0 = -5200, z0 = -9200, x1 = 5200, z1 = 9200 }
-- 寻路网格（Nav.lua）：64 格一格，格子中心正好落在每条街的中线上（街都在 512 的倍数上）——顺着街走的边整条在路上
Map.NAVBOX = { x0 = -4640, z0 = -8352, x1 = 4640, z1 = 8352 }
Map.NAVCELL = 64

-- 两点之间的视线：地形（城外丘陵）、楼（塌了的不算）挡不挡（AI 车看人、工事看人）
function Map.lineClear(a, b, step)
  step = step or 12
  local dv = b - a
  local L = dv.Magnitude
  local n = max(1, floor(L / step))
  for i = 1, n - 1 do
    local p = a + dv * (i / n)
    if Map.height(p.X, p.Z) > p.Y then return false end
    local bd = bldAt(p.X, p.Z, 0)
    if bd and not Map.BLD_DOWN[bd.id] and p.Y < PLAIN + bd.h then return false end
  end
  return true
end

---------------------------------------------------------------- 树（Map.TREES）：撞得倒、炸得倒、打得断（服务器 Trees.lua 记谁倒了；客户端 Scenery.lua 按距离画）
--   { id, x, y, z, k 模型键（SceneryMeta）, s 缩放, yaw, r 树干半径（格）, h 高 }；按 64 格的格子登记（Map.treesNear / Map.treesInCell）

local TREES = {}
Map.TREES = TREES
local TCELL = 64
Map.TREE_CELL = TCELL
local tgrid = {}
local function tkey(gx, gz) return (gx + 1024) * 4096 + (gz + 1024) end
local BROAD = { "oak", "maple", "birch1", "birch2", "maple", "oak" }
local CONIFER = { "fir1", "fir2", "fir3", "fir4", "pine" }
local TH = { oak = 47.7, maple = 49.6, birch1 = 48.1, birch2 = 55.8, fir1 = 49.5, fir2 = 49.2, fir3 = 43.1, fir4 = 37.0, pine = 49.4 }
local function treeOk(x, z, clear)
  if abs(x) > FX - 20 or abs(z) > FZ - 20 then return false end
  if inBase(x, z, 120) then return false end
  if onRoad(x, z, 4) then return false end
  if bldAt(x, z, clear or 8) then return false end
  if railNear(x, z) < 96 then return false end
  if abs(x) < PLAZA + 4 and abs(z) < PLAZA + 4 then return false end
  for _, p in ipairs(Map.POINTS) do
    local dx, dz = x - p.x, z - p.z
    if dx * dx + dz * dz < (Map.POINT_R + 14) ^ 2 then return false end
  end
  return true
end
local function addTree(x, z, k, s, yaw)
  local id = #TREES + 1
  local h = (TH[k] or 45) * s
  local t = { id = id, x = x, y = PLAIN - 0.3, z = z, k = k, s = s, yaw = yaw, h = h, r = 1.1 * s + 0.4 }
  TREES[id] = t
  local key = tkey(floor(x / TCELL), floor(z / TCELL))
  local l = tgrid[key]
  if not l then l = {} tgrid[key] = l end
  table.insert(l, t)
  return t
end
local function nearTree(x, z, r)
  local g0, g1 = floor((x - r) / TCELL), floor((x + r) / TCELL)
  local h0, h1 = floor((z - r) / TCELL), floor((z + r) / TCELL)
  for gx = g0, g1 do
    for gz = h0, h1 do
      local l = tgrid[tkey(gx, gz)]
      if l then
        for _, t in ipairs(l) do
          if (t.x - x) ^ 2 + (t.z - z) ^ 2 < r * r then return true end
        end
      end
    end
  end
  return false
end
do
  local R = rng(88801)
  -- 行道树：中央大道、和平大街两边每 40 格一棵，±1536 的大街两边每 56 格；路口、广场、据点附近空着
  local function avenue(alongX, v, w, gap, s0)
    local off = w / 2 + 5
    for _, sd in ipairs({ -1, 1 }) do
      local u = -C0 + 30
      while u < C0 - 30 do
        local x, z
        if alongX then x, z = u, v + sd * off else x, z = v + sd * off, u end
        -- 离横着的街口远一点
        local cross = alongX and x or z
        local li = floor((cross + C0) / GRID + 0.5)
        local lc = lineAt(clamp(li, 0, 12))
        if abs(cross - lc) > lineW(lc) / 2 + 22 and treeOk(x, z, 6) then
          addTree(x, z, BROAD[1 + floor(R() * #BROAD)], s0 + R() * 0.12, R() * 6.283)
        end
        u += gap
      end
    end
  end
  avenue(false, 0, 64, 40, 0.5)
  avenue(true, 0, 64, 40, 0.5)
  for _, v in ipairs({ -1536, 1536 }) do
    avenue(false, v, 44, 56, 0.48)
    avenue(true, v, 44, 56, 0.48)
  end
  -- 公园（据点 B 一带）：一大片阔叶林，中间据点那一圈和几条小路空着
  do
    local x0, x1, z0, z1 = -C0 + 36, -2048 - 30, -512 + 30, 512 - 30
    for gx = x0, x1, 30 do
      for gz = z0, z1, 30 do
        local x, z = gx + (R() - 0.5) * 18, gz + (R() - 0.5) * 18
        local dB = sqrt((x - P_B.x) ^ 2 + (z - P_B.z) ^ 2)
        local path = abs(dB - 300) < 14 or abs(x - P_B.x) < 12   -- 绕着据点一圈的小路、南北一条
        if R() < 0.62 and not path and dB > Map.POINT_R + 40 and treeOk(x, z, 10) then
          addTree(x, z, BROAD[1 + floor(R() * #BROAD)], 0.62 + R() * 0.3, R() * 6.283)
        end
      end
    end
  end
  -- 广场四周的树池、街心花园、球场边、停车场边
  for i = 0, 11 do
    for j = 0, 11 do
      local t = blockType(i, j)
      if t == "garden" or t == "sports" or t == "parking" or t == "works" then
        local x0, x1, z0, z1 = interior(i, j)
        local step = (t == "garden") and 30 or 46
        for gx = x0 + 10, x1 - 10, step do
          for gz = z0 + 10, z1 - 10, step do
            local edge = (gx < x0 + 40 or gx > x1 - 40 or gz < z0 + 40 or gz > z1 - 40)
            if (t == "garden" and R() < 0.55) or (t ~= "garden" and edge and R() < 0.5) then
              local x, z = gx + (R() - 0.5) * 12, gz + (R() - 0.5) * 12
              if treeOk(x, z, 8) then addTree(x, z, BROAD[1 + floor(R() * #BROAD)], 0.55 + R() * 0.25, R() * 6.283) end
            end
          end
        end
      elseif t == "city" and R() < 0.5 then   -- 有的街坊院子里一两棵
        local x0, x1, z0, z1 = interior(i, j)
        for _ = 1, 3 do
          local x, z = lerp(x0, x1, 0.3 + R() * 0.4), lerp(z0, z1, 0.3 + R() * 0.4)
          if treeOk(x, z, 12) then addTree(x, z, BROAD[1 + floor(R() * #BROAD)], 0.5 + R() * 0.2, R() * 6.283) end
        end
      end
    end
  end
  -- 郊区：每座小楼院子里一两棵
  for _, b in ipairs(BLD) do
    if b.k == "house" then
      for _ = 1, 1 + floor(R() * 2) do
        local a = R() * 6.283
        local rr = max(b.w, b.d) * 0.5 + 14 + R() * 16
        local x, z = b.x + cos(a) * rr, b.z + sin(a) * rr
        if treeOk(x, z, 6) and not nearTree(x, z, 14) then addTree(x, z, BROAD[1 + floor(R() * #BROAD)], 0.55 + R() * 0.3, R() * 6.283) end
      end
    end
  end
  -- 农田：田埂上一排排树（东西向，每 256 格一道，断断续续），两侧和城边几片林子（针叶多）
  for _, s in ipairs({ -1, 1 }) do
    for zz = SUB + 384, 5800, 512 do
      local z = s * zz
      local x = -FX + 60
      while x < FX - 60 do
        local run = noise(x / 400, z / 400, 9.1) > -0.05
        if run and R() < 0.8 then
          local xx, zz2 = x + (R() - 0.5) * 8, z + (R() - 0.5) * 8
          if treeOk(xx, zz2, 8) and not nearTree(xx, zz2, 14) then addTree(xx, zz2, BROAD[1 + floor(R() * #BROAD)], 0.6 + R() * 0.3, R() * 6.283) end
        end
        x += 30 + R() * 12
      end
    end
  end
  local woods = {
    { -3950, 4800, 420 }, { 3900, 5300, 380 }, { -3900, -4900, 420 }, { 3950, -5200, 380 },   -- 农田四角
    { -4100, 1300, 320 }, { 4100, -1300, 320 },                                                -- 城两侧（郊区外）
    { -1300, 4300, 220 }, { 1300, -4300, 220 },
  }
  for wi, w in ipairs(woods) do
    local cx, cz, r = w[1], w[2], w[3]
    for gx = cx - r, cx + r, 28 do
      for gz = cz - r, cz + r, 28 do
        local x, z = gx + (R() - 0.5) * 18, gz + (R() - 0.5) * 18
        local q = ((x - cx) ^ 2 + (z - cz) ^ 2) / (r * r) + 0.35 * noise(x / 160, z / 160, wi * 1.7)
        if q < 1 and R() < 0.58 and treeOk(x, z, 8) then
          local k = (R() < 0.6) and CONIFER[1 + floor(R() * #CONIFER)] or BROAD[1 + floor(R() * #BROAD)]
          addTree(x, z, k, 0.7 + R() * 0.35, R() * 6.283)
        end
      end
    end
  end
end
Map.TREE_N = #TREES
-- (x, z) 方圆 r 以内的树（倒没倒由调用的人自己看）
function Map.treesNear(x, z, r, out)
  out = out or {}
  table.clear(out)
  local g0, g1 = floor((x - r) / TCELL), floor((x + r) / TCELL)
  local h0, h1 = floor((z - r) / TCELL), floor((z + r) / TCELL)
  for gx = g0, g1 do
    for gz = h0, h1 do
      local l = tgrid[tkey(gx, gz)]
      if l then
        for _, t in ipairs(l) do
          if (t.x - x) ^ 2 + (t.z - z) ^ 2 < (r + t.r) ^ 2 then table.insert(out, t) end
        end
      end
    end
  end
  return out
end
-- 这一格（Flora 的 64 格格子，同 TREE_CELL）里的树：Scenery.lua 按格子摆
function Map.treesInCell(cx, cz) return tgrid[tkey(cx, cz)] or {} end

return Map
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="42">
      <Properties>
        <string name="Name">MapPaint</string>
        <ProtectedString name="Source"><![CDATA[-- 全面大战场——地图的「卫星图」：按 Map.lua 的高度、材质一个像素一个像素算颜色（客户端 MapUI 用 EditableImage 画小地图、部署地图）
--   用户 11-19：右上角小地图显示内容更精细、颜色更暗淡、更拟真（原来是按高度分几档的色块，110 × 110 格）
--   · 海：按水深从浅滩的灰绿到深海的墨蓝，海底的起伏也带一点阴影；岸边一圈浅色的浪
--   · 陆地：按地形材质（沙滩、草地、深色草、土路、岩石、板岩）上色，高处偏灰；山体阴影（光从西北来，坡朝东南的暗）；
--     压平的场地（据点、营地、港口、停机坪）是夯过的土色；跑道是沥青
--   · 整体压暗、去饱和；加两层噪声的斑驳（不然一块块平涂，像卡通）
--   画法：paint(Map, P, r0, r1, buf) 把第 r0～r1−1 行算进 buf（RGBA，每行 P.w 个像素；buf 从第 r0 行开始放）；
--     P = { x0, z0 世界坐标左上角, step 每像素几格, w, h 像素, detail 要不要按材质（细节块要，整张底图只按高度、坡度估） }
--     分几次画（每帧画几行）时 P 记着上一行的高度（算阴影用）
local MapPaint = {}

local floor, sqrt, max, min = math.floor, math.sqrt, math.max, math.min
local noise = math.noise

local function clamp(v, a, b) return v < a and a or (v > b and b or v) end
local function smooth(a, b, v)
  local t = clamp((v - a) / (b - a), 0, 1)
  return t * t * (3 - 2 * t)
end

-- 材质的底色（暗、灰一点：夜里的地图、卫星图那样）
local COL = {
  Sand = { 146, 136, 110 },
  Grass = { 76, 90, 58 },
  LeafyGrass = { 60, 74, 48 },
  Ground = { 104, 92, 74 },
  Rock = { 100, 98, 92 },
  Slate = { 82, 82, 80 },
  Mud = { 84, 72, 58 },
  Concrete = { 118, 116, 110 },   -- 港口码头平地
  Asphalt = { 70, 72, 74 },       -- 港口坡道
  Sandstone = { 150, 118, 86 },   -- 沙漠：台地、古城
  Salt = { 170, 166, 154 },       -- 沙漠：盐碱地
}
MapPaint.COL = COL
local HIGH = { 96, 98, 88 }                  -- 高处的草偏灰绿
local PAD = { 88, 86, 78 }                   -- 压平的场地：夯土、水泥地
local TARMAC = { 48, 50, 52 }                -- 跑道
local SHALLOW, MID, DEEP = { 82, 100, 96 }, { 42, 62, 74 }, { 19, 30, 43 }
local SURF = { 128, 134, 126 }
-- 光从西北上方来（北是 −Z、西是 −X）
local LX, LY, LZ = -0.62, 0.62, -0.48
do
  local l = sqrt(LX * LX + LY * LY + LZ * LZ)
  LX, LY, LZ = LX / l, LY / l, LZ / l
end

local function runwayAt(Map, x, z)
  for _, k in ipairs({ "AIRFIELD", "AFIELD2" }) do
    local A = Map[k]
    if A and A.len and math.abs(x - A.x) <= A.len / 2 and math.abs(z - A.z) <= (A.wid or 90) / 2 then return true end
  end
  return false
end

-- 沙漠图（沙海）：底色照它的 Map.COLORS 压暗（卫星图那样）；没有的材质用沙色
local DCOL = {}
local function desertCol(Map, m)
  local c = DCOL[m]
  if c then return c end
  local c3 = Map.COLORS and (Map.COLORS[m] or Map.COLORS.Sand)
  c = c3 and { c3.R * 255 * 0.74, c3.G * 255 * 0.74, c3.B * 255 * 0.74 } or COL.Sand
  DCOL[m] = c
  return c
end

-- 底图（没按材质）：按高度、坡度估一个材质（跟 Map.material 的规则差不多）
local function guessMat(Map, y, slope)
  local K, HK = Map.K or 1, Map.HK or 1
  if Map.DESERT then   -- 沙漠：低洼的盐滩、平原的沙、台地的石灰岩、陡坡的岩石
    if slope > 0.9 then return "Rock" end
    if y > 60 then return "Limestone" end
    if y < 10 then return "Salt" end
    return "Sand"
  end
  if y < 2.2 then return "Sand" end
  if slope > 1.15 * HK / K then return (y > 120 * HK) and "Slate" or "Rock" end
  if y > 232 * HK then return "Rock" end
  if slope > 0.92 * HK / K then return "Ground" end
  return "Grass"
end

function MapPaint.paint(Map, P, r0, r1, buf)
  local w, step = P.w, P.step
  local x0, z0 = P.x0, P.z0
  local ex = P.exag or 1.5   -- 阴影夸张一点（地图上看得出山）
  local prev = P.prev
  if not prev or P.prevRow ~= r0 - 1 then   -- 上一行的高度（第一行往上多算一行）
    prev = table.create(w)
    local zp = z0 + (r0 - 0.5) * step
    for i = 0, w - 1 do prev[i + 1] = (Map.height(x0 + (i + 0.5) * step, zp)) end
  end
  local cur = table.create(w)
  for r = r0, r1 - 1 do
    local z = z0 + (r + 0.5) * step
    for i = 0, w - 1 do cur[i + 1] = (Map.height(x0 + (i + 0.5) * step, z)) end
    local base = (r - r0) * w * 4
    for i = 1, w do
      local x = x0 + (i - 0.5) * step
      local y = cur[i]
      local gx = (cur[min(w, i + 1)] - cur[max(1, i - 1)]) / (step * ((i > 1 and i < w) and 2 or 1))   -- 左右两边的差（单边差会把地形里的小台阶画成一道道竖线）
      local gz = (y - prev[i]) / step
      -- 法线 (−gx·ex, 1, −gz·ex) 和光的点积：平地 = 1，朝西北的坡亮、朝东南的暗
      local nx, nz = -gx * ex, -gz * ex
      local nl = sqrt(nx * nx + 1 + nz * nz)
      local lit = (nx * LX + LY + nz * LZ) / nl / LY
      local R, Gc, B
      if y <= 0.3 then
        local d = -y
        local t1, t2 = smooth(0, 12, d), smooth(12, 100, d)
        R = SHALLOW[1] + (MID[1] - SHALLOW[1]) * t1
        Gc = SHALLOW[2] + (MID[2] - SHALLOW[2]) * t1
        B = SHALLOW[3] + (MID[3] - SHALLOW[3]) * t1
        R, Gc, B = R + (DEEP[1] - R) * t2, Gc + (DEEP[2] - Gc) * t2, B + (DEEP[3] - B) * t2
        if d < 1.6 then   -- 岸边的浪
          local k = (1 - d / 1.6) * 0.45
          R, Gc, B = R + (SURF[1] - R) * k, Gc + (SURF[2] - Gc) * k, B + (SURF[3] - B) * k
        end
        local sh = 1 + (clamp(lit, 0.5, 1.4) - 1) * 0.35 * (1 - t2)   -- 浅海底的起伏
        local nn = 1 + noise(x / 70, z / 70, 4.4) * 0.03
        R, Gc, B = R * sh * nn, Gc * sh * nn, B * sh * nn
      else
        local slope = sqrt(gx * gx + gz * gz)
        local c
        if runwayAt(Map, x, z) then
          c = TARMAC
        else
          local m
          if P.detail then
            local ok, mat = pcall(Map.material, x, z, y, slope)
            m = ok and mat and mat.Name or guessMat(Map, y, slope)
          else
            m = guessMat(Map, y, slope)
          end
          if Map.DESERT then c = desertCol(Map, m) else c = COL[m] or COL.Grass end
          if P.detail and Map.flatW and m ~= "Sand" and not Map.DESERT and Map.flatW(x, z) > 0.92 then c = PAD end
        end
        R, Gc, B = c[1], c[2], c[3]
        if c == COL.Grass or c == COL.LeafyGrass then   -- 高处的草偏灰
          local k = smooth(60, 420, y) * 0.4
          R, Gc, B = R + (HIGH[1] - R) * k, Gc + (HIGH[2] - Gc) * k, B + (HIGH[3] - B) * k
        end
        local sh = clamp(lit, 0.55, 1.25)
        local nn = 1 + noise(x / 46, z / 46, 5.1) * 0.05 + noise(x / 11, z / 11, 2.7) * 0.03
        R, Gc, B = R * sh * nn, Gc * sh * nn, B * sh * nn
      end
      -- 去饱和一点、整体压暗
      local L = (R * 0.3 + Gc * 0.59 + B * 0.11)
      R, Gc, B = (L + (R - L) * 0.86) * 0.94, (L + (Gc - L) * 0.86) * 0.94, (L + (B - L) * 0.86) * 0.94
      local o = base + (i - 1) * 4
      buffer.writeu8(buf, o, clamp(floor(R + 0.5), 0, 255))
      buffer.writeu8(buf, o + 1, clamp(floor(Gc + 0.5), 0, 255))
      buffer.writeu8(buf, o + 2, clamp(floor(B + 0.5), 0, 255))
      buffer.writeu8(buf, o + 3, 255)
    end
    prev, cur = cur, prev
  end
  P.prev, P.prevRow = prev, r1 - 1
end

-- 这一块（世界坐标 x0, z0 起、边长 size 格）有没有陆地 / 浅滩（全是深海的细节块不用画：底图就够了）
function MapPaint.hasLand(Map, x0, z0, size)
  for j = 0, 6 do
    for i = 0, 6 do
      if (Map.height(x0 + i / 6 * size, z0 + j / 6 * size)) > -16 then return true end
    end
  end
  return false
end

return MapPaint
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="43">
      <Properties>
        <string name="Name">MapRange</string>
        <ProtectedString name="Source"><![CDATA[--!native
-- 全面大战场——训练场（ReplicatedStorage.MapRange）：自己的一张图，在区块 Zones.RANGE（中心 (0, 0, 100352)），纯数学，服务器、客户端算出来一样
--   用户 11-26 晚：「把训练场单独做一张地图吧」——原来试驾在战场边上打靶（钢城东边丘陵），开出去就进了战场。这张图（区块里的相对坐标：u 往东、w 往南）：
--   · 射击线（w = 3000）上一排 8 条靶道，每条 960 格宽，车停在线上朝北打；靶车在 300 / 500 / 700 / 1000 / 1300 / 1600 / 2000 米，
--     靶道是压实的土路（一路打到 2000 米的位置），尽头一道八十格高的挡弹土墙（炮弹不往远处飞）；靶道两边每 100 米一块距离牌（Range.lua 建）
--   · 西边一条 3600 格（约 1.3 公里）的跑道（东西向），北边停机坪、机库、塔台：试飞的飞机停在跑道东头，朝西起飞
--   · 挡弹墙北面是空中靶区：对地的靶车、靶机绕着它飞
--   · 射击线东头直升机坪
--   · 四周几座丘陵（远景，也挡一挡视线），再往外一圈平地铺到 ±12288，更外面是客户端跟着镜头的平地（Scenery.lua）
--   地形不比战场：大部分是平地（开服时 FillBlock 一大块一大块铺，几秒钟），只有挡弹墙、丘陵按高度逐列写体素
local Zones = require(script.Parent:WaitForChild("Zones"))

local R = {}
local abs, sqrt, exp, max, min, floor = math.abs, math.sqrt, math.exp, math.max, math.min, math.floor
local noise = math.noise
local function clamp(v, a, b) return v < a and a or (v > b and b or v) end
local function smooth(a, b, v) local t = clamp((v - a) / (b - a), 0, 1) return t * t * (3 - 2 * t) end

local RX, RZ = Zones.RANGE.x, Zones.RANGE.z
R.X, R.Z = RX, RZ
R.R = Zones.RANGE.R
R.PLAY = Zones.RANGE.PLAY
local PLAIN = 12   -- 平地高度（同钢城：4 的倍数，FillBlock 铺出来和逐列写的一样高）
R.PLAIN = PLAIN
local M = 2.8      -- 一米多少格

---------------------------------------------------------------- 布局（区块里的相对坐标）

R.FIRE_W = 3000                 -- 射击线
R.LANES = 8
R.LANE_W = 960                 -- 一条靶道 960 格（约 340 米）宽：最远那几辆靶车横着来回开也不出自己的靶道
local LANE_U0 = -(R.LANES - 1) * R.LANE_W / 2
R.DIST = { 300, 500, 700, 1000, 1300, 1600, 2000 }   -- 靶车的距离（米）
local TRACK_HALF = 34           -- 靶道土路半宽
local TRACK_END = R.FIRE_W - 2000 * M - 260   -- 土路一直铺到 2000 米靶位再往前一点
R.BERM_W, R.BERM_H, R.BERM_HALF = -3300, 84, 4300   -- 挡弹土墙：中线、高、半长
R.RWY = { u0 = -11200, u1 = -7600, w = 700, wid = 90 }   -- 跑道（东西向，同战场的机场：World.airfield 建，北边停机坪、机库、塔台）
R.HELI = { u = 3950, w = 3150 } -- 直升机坪
R.AIRTGT = { u = 0, w = -6600 } -- 空中靶区中心
-- 开服先铺的那片平地（Range.lua；2048 的倍数，客户端那圈远处平地在这片里沉下去：Scenery.lua）
R.CORE = { u0 = -12288, u1 = 8192, w0 = -8192, w1 = 6144 }

-- 丘陵：u、w、半径、高（格）
local HILLS = {   -- 八座（逐列写体素的块只在它们和挡弹墙上：开服后台写，一两分钟写完，靶场那片开服就有）
  { -9600, -3000, 2200, 165 }, { -7800, -8600, 1800, 120 },
  { 8200, -1800, 2100, 150 }, { 7600, -7600, 1900, 140 },
  { -3200, -10400, 2000, 160 }, { 3600, -10600, 2100, 180 },
  { -2800, 9600, 1900, 100 }, { 4400, 9800, 2100, 125 },
}
R.HILLS = HILLS

function R.toLocal(x, z) return x - RX, z - RZ end
function R.toWorld(u, w) return u + RX, w + RZ end

---------------------------------------------------------------- 高度

local function bump(d2, r) -- (1 − x²)²，x = d / r：只在半径以内有，边上平滑接到平地
  local x2 = d2 / (r * r)
  if x2 >= 1 then return 0 end
  local a = 1 - x2
  return a * a
end
local function relief(u, w)
  local h = 0
  -- 挡弹土墙：横在靶道尽头，两头收进地里
  local dw = (w - R.BERM_W) / 300
  if dw * dw < 9 then
    local ends = 1 - smooth(R.BERM_HALF - 700, R.BERM_HALF, abs(u))
    h += R.BERM_H * exp(-dw * dw) * ends * (0.92 + 0.08 * noise(u / 400, w / 400, 3.7))
  end
  -- 丘陵：每座一个平滑的鼓包，上面叠两层起伏（看着像真山包，不是馒头）
  for i = 1, #HILLS do
    local hl = HILLS[i]
    local du, dv = u - hl[1], w - hl[2]
    local b = bump(du * du + dv * dv, hl[3])
    if b > 0 then
      local n1 = noise(u / 1300 + i * 7.1, w / 1300, 1.3)
      local n2 = noise(u / 420, w / 420 + i * 3.3, 2.9)
      h += hl[4] * b * (0.78 + 0.32 * n1 + 0.12 * n2)
    end
  end
  return max(h, 0)
end
-- 平地就是平的（开服时整片 FillBlock 铺在 PLAIN，按高度函数逐列写的只有挡弹墙和丘陵：高度函数要和真地形对得上，车、靶子摆得平）
function R.heightLocal(u, w)
  return PLAIN + relief(u, w)
end
function R.height(x, z) return R.heightLocal(x - RX, z - RZ), 1e9 end
function R.ground(x, z) return R.heightLocal(x - RX, z - RZ) end
function R.isLand() return true end
function R.slope(x, z)
  local e = 4
  local hx = R.ground(x + e, z) - R.ground(x - e, z)
  local hz = R.ground(x, z + e) - R.ground(x, z - e)
  return sqrt(hx * hx + hz * hz) / (2 * e)
end
function R.flatW() return 0 end

-- 有没有起伏（地形按块写：没起伏的整块 FillBlock，有的逐列写体素）：这一块（世界坐标 x0..x1, z0..z1）碰不碰得到挡弹墙、丘陵
function R.reliefIn(x0, z0, x1, z1)
  local u0, w0, u1, w1 = x0 - RX, z0 - RZ, x1 - RX, z1 - RZ
  if u1 > -R.BERM_HALF - 50 and u0 < R.BERM_HALF + 50 and w1 > R.BERM_W - 1000 and w0 < R.BERM_W + 1000 then return true end
  for i = 1, #HILLS do
    local hl = HILLS[i]
    local cu, cw = clamp(hl[1], u0, u1), clamp(hl[2], w0, w1)
    local du, dv = cu - hl[1], cw - hl[2]
    if du * du + dv * dv < hl[3] * hl[3] then return true end
  end
  return false
end

---------------------------------------------------------------- 材质

local MAT = Enum.Material
local function onTrack(u, w)
  if w > R.FIRE_W + 120 or w < TRACK_END then return false end
  local i = floor((u - LANE_U0) / R.LANE_W + 0.5)
  if i < 0 or i >= R.LANES then return false end
  return abs(u - (LANE_U0 + i * R.LANE_W)) < TRACK_HALF + noise(u / 30, w / 30) * 6
end
function R.material(x, z, y, slope)
  local u, w = x - RX, z - RZ
  slope = slope or 0
  if onTrack(u, w) then return MAT.Ground end
  -- 射击线后面压出来的一条土路（各靶道的车开上开下）、跑道两边的土
  if abs(w - (R.FIRE_W + 160)) < 40 and abs(u) < -LANE_U0 + R.LANE_W / 2 then return MAT.Ground end
  if abs(w - R.RWY.w) < R.RWY.wid / 2 + 30 and u > R.RWY.u0 - 60 and u < R.RWY.u1 + 60 then return MAT.Ground end
  if slope > 0.75 then return MAT.Rock end
  if slope > 0.42 then return MAT.Ground end
  -- 挡弹墙：被炮弹翻过的土
  local dw = abs(w - R.BERM_W)
  if dw < 520 and abs(u) < R.BERM_HALF then return (slope > 0.18 or noise(u / 60, w / 60, 1.1) > 0.2) and MAT.Ground or MAT.Grass end
  -- 草地里几片深一点的（LeafyGrass）、几块裸土
  local n = noise(u / 700, w / 700, 4.4)
  if n > 0.42 then return MAT.LeafyGrass end
  if n < -0.5 and slope < 0.2 then return MAT.Ground end
  return MAT.Grass
end
function R.underMat(top) return (top == MAT.Rock) and MAT.Rock or MAT.Ground end

-- 视线（地形挡不挡）：沿线段取样高度
function R.lineClear(a, b, step)
  local d = b - a
  local L = d.Magnitude
  if L < 1 then return true end
  local n = math.ceil(L / (step or 24))
  for i = 1, n - 1 do
    local p = a + d * (i / n)
    if R.ground(p.X, p.Z) > p.Y then return false end
  end
  return true
end
function R.navBlocked() return false end
function R.segBlocked() return false end
function R.roadDist() return 1e9 end

-- 客户端跟着镜头铺的远处平地（Scenery.lua）：草地，顶面和平地一样高
R.FAR = { color = Color3.fromRGB(80, 108, 56), mat = "Grass", y = PLAIN - 0.5 }

---------------------------------------------------------------- 试驾用的位置（世界坐标）

-- 第 i 条靶道（1 ~ LANES）射击线上的车位：位置、朝向（朝北）
function R.lane(i)
  i = ((i - 1) % R.LANES) + 1
  local u = LANE_U0 + (i - 1) * R.LANE_W
  local x, z = R.toWorld(u, R.FIRE_W)
  return Vector3.new(x, R.ground(x, z), z), Vector3.new(0, 0, -1)
end
-- 靶道正中线上离射击线 dist 米、往右偏 side 米的那一点（Tech.lua 摆靶车）
function R.laneAt(i, dist, side)
  local p = R.lane(i)
  local x, z = p.X + (side or 0) * M, p.Z - dist * M
  return Vector3.new(x, R.ground(x, z), z)
end
-- 跑道东头（起飞位，第 k 架往后排）：位置、朝向（朝西）
local function startU(k) return R.RWY.u1 - 160 - floor(k / 2) * 110 end
function R.runwayStart(k)
  k = k or 0
  local x, z = R.toWorld(startU(k), R.RWY.w + ((k % 2 == 0) and -18 or 18))
  return Vector3.new(x, R.ground(x, z), z), Vector3.new(-1, 0, 0)
end
-- 第 k 个起飞位朝西到跑道西头还剩多长（格；第 0 个 3440）：试驾按它挑在跑道上起飞还是空中出生（Tech.lua，AirDefs.takeoffRun 估的滑跑距离）
function R.runwayLeft(k) return startU(k or 0) - R.RWY.u0 end
-- 第 k 个起飞位旁边、跑道南边离跑道边 60 格的草地上：试驾无人机的操作员站这儿拿平板遥控（Tech.lua）——
--   站在起飞位上挡着前面几个起飞位的滑跑线；跑道北边是停机坪、机库、塔台。并排的两个起飞位（k、k + 1 同一个 startU）左右错开 16 格
function R.runwaySide(k)
  k = k or 0
  local x, z = R.toWorld(startU(k) + ((k % 2 == 0) and -8 or 8), R.RWY.w + R.RWY.wid / 2 + 60)
  return Vector3.new(x, R.ground(x, z), z)
end
function R.heliPad(k)
  local x, z = R.toWorld(R.HELI.u + ((k or 0) % 3 - 1) * 70, R.HELI.w + floor((k or 0) / 3) * 70)
  return Vector3.new(x, R.ground(x, z), z), Vector3.new(0, 0, -1)
end
function R.airTarget()
  local x, z = R.toWorld(R.AIRTGT.u, R.AIRTGT.w)
  return Vector3.new(x, R.ground(x, z), z)
end
-- 跑道（World.airfield 照它建：中心、长、宽；东西向）
function R.airfield()
  local x, z = R.toWorld((R.RWY.u0 + R.RWY.u1) / 2, R.RWY.w)
  return { x = x, z = z, len = R.RWY.u1 - R.RWY.u0, wid = R.RWY.wid, rot = 0, team = "range" }
end

return R
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="44">
      <Properties>
        <string name="Name">MapRoads</string>
        <ProtectedString name="Source"><![CDATA[-- 路网（tools/map/roads.lua 离线算好的，别手改：改了地形重跑一遍）：Map.lua 开服时按它压平路面、换土路材质；客户端摆树、花草时避开
--   每条路：name 名字、w 路面宽（格）、p 路线上的点 { x1, z1, x2, z2, … }（每 ≤ 20 格一个）
return {
  { name = "营地—指挥所", w = 11, p = { 140,-2076,129,-2076,118,-2076,107,-2076,91,-2076,74,-2076,59,-2076,45,-2076,30,-2076,17,-2079,3,-2081,-10,-2084,-29,-2091,-47,-2099,-59,-2106,-70,-2114,-81,-2121,-91,-2131,-101,-2141,-111,-2151,-126,-2162,-140,-2173,-154,-2181,-169,-2188,-183,-2192,-196,-2196,-210,-2196,-223,-2196,-234,-2195,-245,-2194,-262,-2191,-273,-2187,-279,-2181,-283,-2176,-284,-2173,-283,-2172,-280,-2172,-279,-2171,-279,-2170,-280,-2167,-283,-2164,-284,-2162,-283,-2161,-279,-2160,-273,-2160,-269,-2159,-268,-2158,-268,-2155,-271,-2152,-268,-2150,-257,-2149,-240,-2148,-228,-2148,-216,-2148,-197,-2147,-184,-2146,-175,-2143,-172,-2140,-171,-2138,-171,-2137,-172,-2136,-175,-2136,-177,-2135,-177,-2134,-175,-2131,-172,-2128,-171,-2126,-171,-2125,-172,-2124,-175,-2124,-177,-2123,-177,-2122,-175,-2119,-172,-2116,-171,-2114,-171,-2113,-172,-2112,-175,-2112,-177,-2111,-177,-2110,-175,-2107,-172,-2104,-171,-2102,-171,-2101,-172,-2100,-175,-2100,-177,-2099,-177,-2098,-175,-2095,-172,-2092,-172,-2090,-173,-2089,-177,-2088,-183,-2088,-187,-2087,-188,-2086,-187,-2083,-184,-2080,-183,-2078,-183,-2077,-184,-2076,-187,-2076,-181,-2068,-174,-2059,-166,-2051,-154,-2039,-142,-2026,-131,-2015,-120,-2004,-109,-1993,-96,-1981,-82,-1969,-72,-1960,-61,-1952,-46,-1944,-37,-1944,-27,-1940,-15,-1933,-1,-1921,6,-1914,14,-1906,28,-1895,41,-1888,54,-1884,66,-1884,77,-1885,86,-1888,93,-1893,99,-1899,104,-1903,109,-1906,113,-1908,116,-1908,121,-1911,128,-1917,138,-1926,150,-1938,160,-1946,167,-1951,173,-1951,176,-1948,182,-1945,191,-1942,203,-1939,218,-1936,230,-1933,240,-1928,248,-1923,253,-1917,256,-1913,259,-1910,260,-1908 } },
  { name = "指挥所—港口镇", w = 11, p = { 260,-1908,260,-1898,261,-1887,261,-1877,261,-1861,262,-1845,262,-1831,262,-1817,263,-1803,261,-1785,259,-1767,255,-1752,250,-1737,244,-1725,237,-1713,228,-1704,219,-1695,206,-1681,199,-1672,197,-1668,200,-1668,201,-1667,201,-1666,200,-1663,197,-1660,196,-1658,197,-1657,201,-1656,207,-1656,199,-1643,188,-1630,176,-1618,164,-1605,152,-1592,140,-1579,127,-1567,114,-1554,101,-1541,89,-1528,76,-1516,64,-1503,51,-1490,39,-1477,27,-1465,17,-1452,20,-1452,21,-1451,21,-1450,20,-1447,17,-1444,15,-1442,15,-1441,17,-1440,20,-1440,21,-1439,21,-1438,20,-1435,17,-1432,14,-1430,11,-1429,8,-1428,5,-1428,3,-1427,3,-1426,5,-1423,8,-1420,9,-1418,9,-1417,8,-1416,5,-1416,3,-1415,3,-1414,5,-1411,8,-1408,9,-1406,9,-1405,8,-1404,5,-1404,3,-1403,3,-1402,5,-1399,8,-1396,1,-1385,-7,-1375,-16,-1366,-29,-1352,-42,-1338,-54,-1326,-66,-1314,-78,-1302,-93,-1288,-107,-1275,-118,-1266,-130,-1257,-145,-1248,-154,-1248,-163,-1246,-172,-1241,-181,-1234,-190,-1225,-198,-1219,-204,-1214,-208,-1212,-211,-1212,-221,-1204,-229,-1197,-238,-1189,-249,-1178,-261,-1167,-271,-1157,-281,-1147,-291,-1137,-302,-1126,-313,-1115,-321,-1108,-328,-1102,-336,-1096,-336,-1099,-337,-1101,-338,-1101,-340,-1099,-343,-1096,-346,-1096,-347,-1097,-348,-1101,-348,-1107,-349,-1111,-350,-1112,-352,-1111,-355,-1108,-358,-1109,-359,-1114,-360,-1122,-360,-1134,-361,-1144,-364,-1153,-369,-1161,-375,-1167,-379,-1170,-382,-1170,-384,-1167,-384,-1161,-385,-1157,-386,-1156,-388,-1156,-391,-1159,-394,-1161,-395,-1161,-396,-1159,-396,-1156,-397,-1153,-398,-1150,-400,-1147,-403,-1144,-407,-1142,-412,-1141,-417,-1140,-423,-1140,-431,-1143,-442,-1150,-456,-1161,-463,-1168,-471,-1175,-483,-1185,-491,-1192,-495,-1195 } },
  { name = "指挥所—机场", w = 11, p = { 260,-1908,260,-1898,261,-1887,261,-1877,261,-1861,262,-1845,262,-1831,262,-1817,263,-1803,261,-1785,259,-1767,255,-1752,250,-1737,244,-1725,237,-1713,228,-1704,219,-1695,206,-1681,199,-1672,197,-1668,200,-1668,201,-1667,201,-1666,200,-1663,197,-1660,196,-1658,197,-1657,201,-1656,207,-1656,199,-1643,188,-1630,176,-1618,164,-1605,152,-1592,140,-1579,127,-1567,114,-1554,101,-1541,89,-1528,76,-1516,64,-1503,51,-1490,39,-1477,27,-1465,17,-1452,20,-1452,21,-1451,21,-1450,20,-1447,17,-1444,15,-1442,15,-1441,17,-1440,20,-1440,21,-1439,21,-1438,20,-1435,17,-1432,14,-1430,11,-1429,8,-1428,5,-1428,3,-1427,3,-1426,5,-1423,8,-1420,9,-1418,9,-1417,8,-1416,5,-1416,3,-1415,3,-1414,5,-1411,8,-1408,9,-1406,9,-1405,8,-1404,5,-1404,3,-1403,3,-1402,5,-1399,8,-1396,2,-1386,-6,-1377,-13,-1368,-25,-1355,-37,-1342,-48,-1331,-59,-1320,-70,-1309,-83,-1296,-95,-1282,-103,-1272,-112,-1261,-120,-1246,-120,-1237,-115,-1226,-106,-1213,-100,-1205,-93,-1197,-84,-1188,-75,-1179,-66,-1174,-57,-1169,-39,-1168,-21,-1174,-12,-1182,-3,-1189,11,-1200,22,-1206,29,-1207,32,-1204,34,-1198,35,-1189,36,-1177,36,-1162,37,-1150,38,-1141,41,-1135,44,-1132,51,-1130,63,-1129,80,-1128,90,-1128,101,-1128,111,-1130,121,-1132,131,-1137,140,-1141,150,-1148,159,-1155,168,-1164,177,-1173,185,-1180,192,-1186,204,-1195,213,-1200,219,-1200,224,-1199,229,-1198,233,-1195,236,-1192,245,-1198,254,-1204,262,-1211,273,-1222,285,-1233,295,-1243,305,-1253,315,-1263,329,-1274,344,-1285,358,-1292,371,-1300,384,-1303,398,-1306,410,-1306,423,-1305,441,-1304,454,-1303,460,-1303 } },
  { name = "红滩—港口镇", w = 10, p = { -900,-831,-898,-830,-895,-830,-891,-830,-885,-829,-881,-829,-880,-830,-880,-832,-883,-835,-874,-838,-862,-838,-851,-839,-834,-840,-816,-840,-800,-840,-784,-840,-768,-840,-754,-842,-739,-844,-725,-847,-706,-853,-688,-860,-672,-870,-655,-880,-642,-894,-628,-907,-618,-922,-608,-937,-601,-952,-595,-968,-591,-985,-588,-1002,-588,-1020,-588,-1038,-588,-1052,-587,-1066,-586,-1085,-583,-1096,-580,-1099,-578,-1102,-577,-1105,-576,-1108,-576,-1111,-571,-1119,-561,-1130,-553,-1138,-546,-1146,-535,-1156,-525,-1166,-518,-1173,-510,-1180,-500,-1190,-495,-1195 } },
  { name = "港口镇—白滩", w = 10, p = { -495,-1195,-491,-1192,-483,-1185,-471,-1175,-463,-1168,-456,-1161,-442,-1150,-431,-1143,-423,-1140,-417,-1140,-412,-1141,-407,-1142,-403,-1144,-400,-1147,-398,-1150,-397,-1153,-396,-1156,-396,-1159,-395,-1161,-394,-1161,-391,-1159,-388,-1156,-386,-1156,-385,-1157,-384,-1161,-384,-1167,-382,-1170,-379,-1170,-375,-1167,-369,-1161,-364,-1153,-361,-1144,-360,-1134,-360,-1122,-359,-1114,-358,-1109,-355,-1108,-352,-1111,-350,-1112,-349,-1111,-348,-1107,-348,-1101,-347,-1097,-346,-1096,-343,-1096,-340,-1099,-338,-1101,-337,-1101,-336,-1099,-336,-1096,-335,-1095,-334,-1095,-331,-1096,-328,-1099,-326,-1096,-325,-1085,-324,-1068,-324,-1056,-324,-1044,-323,-1026,-322,-1014,-319,-1008,-316,-1008,-314,-1007,-313,-1006,-312,-1003,-312,-1000,-310,-1000,-307,-1001,-303,-1005,-297,-1011,-292,-1015,-287,-1016,-283,-1015,-280,-1012,-276,-1010,-270,-1009,-262,-1008,-253,-1008,-247,-1007,-244,-1006,-244,-1003,-247,-1000,-244,-998,-235,-997,-220,-996,-210,-996,-199,-996,-184,-995,-175,-994,-172,-991,-175,-988,-177,-985,-177,-982,-175,-979,-172,-976,-171,-974,-171,-973,-172,-972,-175,-972,-177,-971,-177,-970,-175,-967,-172,-964,-171,-962,-171,-961,-172,-960,-175,-960,-177,-959,-177,-958,-175,-955,-172,-952,-172,-950,-173,-949,-177,-948,-183,-948,-187,-947,-188,-946,-187,-943,-184,-940,-183,-938,-183,-937,-184,-936,-187,-936,-186,-932,-180,-925,-169,-913,-162,-906,-154,-898,-143,-884,-136,-871,-132,-858,-132,-846,-131,-836,-130,-829,-127,-825,-124,-822,-122,-821,-121,-820,-120,-819 } },
  { name = "白滩—绿滩", w = 10, p = { -120,-819,-121,-820,-122,-821,-124,-822,-127,-825,-130,-829,-131,-834,-132,-841,-132,-850,-130,-855,-125,-855,-118,-850,-109,-841,-96,-835,-78,-830,-67,-829,-55,-828,-42,-828,-28,-828,-17,-829,-6,-830,12,-835,26,-841,35,-850,50,-857,60,-859,71,-862,84,-863,98,-864,114,-864,131,-864,145,-862,159,-860,171,-856,183,-853,193,-847,203,-841,210,-834,218,-826,233,-815,248,-808,263,-804,278,-804,290,-802,301,-799,309,-795,315,-789,320,-785,324,-783,326,-782,328,-783,329,-784,330,-785,330,-785 } },
