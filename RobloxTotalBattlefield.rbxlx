  local goSpawn, goSpawnT, goSpawnK = mainButton(kitPage, UDim2.fromOffset(CW, CH), UDim2.new(1, -M0, 1, slotY), Vector2.new(1, 1))
  local phaseText = txt(deploy, "", UDim2.fromOffset(360, 16), UDim2.new(1, -M0, 1, slotY - CH - 12), 12, DIM, Enum.Font.BuilderSans, Vector2.new(1, 1), Enum.TextXAlignment.Right)

  -- 数量（消耗品：弹匣 + 备弹）
  local function countOf(id)
    local w = Config.Weapons[id]
    if not w or w.kind == "gun" or w.kind == "heal" or w.kind == "repair" or w.kind == "breach" or w.kind == "spot" then return nil end
    return (w.mag or 1) + (w.reserve or 0)
  end
  -- 数据条：枪看伤害 / 射速 / 射程 / 精度；炸的看伤害 / 杀伤半径 / 射程 / 弹药；工具不显示
  local function statRows(id)
    local w = (G.W and G.W[id]) or Config.Weapons[id]   -- 枪按装的配件算（改枪；GunKit.lua）
    if not w then return {} end
    local m = function(studs) return math.floor((studs or 0) / 2.8 + 0.5) end
    if w.kind == "gun" then
      return {
        { T("deploy.stat.dmg"), math.clamp(w.dmg / 100, 0, 1), tostring(w.dmg) },
        { T("deploy.stat.rate"), math.clamp((60 / w.rate) / 800, 0, 1), T("deploy.rpm", math.floor(60 / w.rate + 0.5)) },
        { T("deploy.stat.range"), math.clamp(m(w.range) / 550, 0, 1), T("deploy.m", m(w.range)) },
        { T("deploy.stat.acc"), math.clamp(1 - (w.spread or 0) * (w.adsK or 1) / 0.8, 0.05, 1), string.format("±%.2f°", (w.spread or 0) * (w.adsK or 1)) },   -- 开镜的精度（spread 是腰射）
      }
    elseif w.dmg then
      local rows = {
        { T("deploy.stat.dmg"), math.clamp(w.dmg / 260, 0, 1), tostring(w.dmg) },
        { T("deploy.stat.blast"), math.clamp((w.splash or 0) / 20, 0, 1), T("deploy.m", m(w.splash)) },
      }
      if w.range or w.maxR then table.insert(rows, { T("deploy.stat.range"), math.clamp(m(w.range or w.maxR) / 500, 0, 1), T("deploy.m", m(w.range or w.maxR)) }) end
      local n = countOf(id)
      if n then table.insert(rows, { T("deploy.stat.ammo"), math.clamp(n / 12, 0, 1), "×" .. n }) end
      return rows
    end
    return {}
  end

  local focus = 1   -- 大图、标题看的是哪一格
  local bigItem, bigWait = nil, false
  -- 各兵种的枪两边是不同的制式（GearDefs.BY）：有「weapon.<枪>.<阵营>」的按自己这边的写（机枪：QJY-88 / M249）
  local function itemName(id)
    if not id then return T("deploy.none") end
    local team = (G.S and G.S.team) or "atk"
    local k2 = "weapon." .. id .. "." .. team
    local v = T(k2)
    if v ~= k2 then return v end
    return T("weapon." .. id)
  end
  local function setModel(vp, id, team)
    if not G.gearModel or not G.viewFit then return id ~= nil end   -- GearView 还没起来：等一会儿再画
    if not id then
      G.viewFit(vp, nil)
      return false
    end
    local m, wait, real
    if G.gunModel and GMods.has(id) and G.myBuild then   -- 改枪：装着现在这一套配件的枪
      m, wait = G.gunModel(id, team, G.myBuild(id))
      real = m ~= nil
      if not m then m, wait, real = G.gearModel(id, team) end
    else
      m, wait, real = G.gearModel(id, team)
    end
    if m and not real then   -- 零件拼的方块不放（粗糙）：等真模型
      m:Destroy()
      m = nil
    end
    G.viewFit(vp, m, 1.12)
    return wait
  end

  ------------------------------------ 生成点页
  local listW = mobile and 230 or 340
  local listY = topY + (mobile and 40 or 66)
  local listHead = txt(spawnPage, "", UDim2.fromOffset(listW, 16), UDim2.fromOffset(M0, listY), 12, DIM, Enum.Font.BuilderSansMedium, nil, Enum.TextXAlignment.Left)
  local list = Instance.new("ScrollingFrame")
  list.Size = UDim2.new(0, listW, 1, -(listY + 24) - (mobile and 80 or 150))
  list.Position = UDim2.fromOffset(M0, listY + 24)
  list.BackgroundTransparency = 1
  list.BorderSizePixel = 0
  list.ScrollBarThickness = 2
  list.ScrollBarImageColor3 = WHITE
  list.CanvasSize = UDim2.new()
  list.AutomaticCanvasSize = Enum.AutomaticSize.Y
  list.Parent = spawnPage
  local listLayout = Instance.new("UIListLayout")
  listLayout.Padding = UDim.new(0, 4)
  listLayout.SortOrder = Enum.SortOrder.LayoutOrder
  listLayout.Parent = list
  -- 地图：右边一个正方形
  local mapBox = frame(spawnPage, mobile and UDim2.new(1, -(M0 * 2 + listW + 16), 1, -(listY + 80)) or UDim2.new(1, -(M0 * 2 + listW + 40), 1, -(listY + 150)),
    UDim2.new(1, -M0, 0, listY), RGB(0, 0, 0), 1, Vector2.new(1, 0))
  local mapHolder = frame(mapBox, UDim2.fromScale(1, 1), UDim2.fromScale(0.5, 0), RGB(0, 0, 0), 1, Vector2.new(0.5, 0))
  local aspect = Instance.new("UIAspectRatioConstraint")
  aspect.AspectRatio = 1
  aspect.Parent = mapHolder
  local spawnLayer = nil
  local spawnBtns = {}
  -- 装备一行 + 改装备
  local kitLine = txt(spawnPage, "", UDim2.fromOffset(mobile and 300 or 520, 16), UDim2.new(0, M0, 1, slotY - 44), 12, DIM, Enum.Font.BuilderSans, nil, Enum.TextXAlignment.Left)
  local editKit = link(spawnPage, "", UDim2.fromOffset(160, 18), UDim2.new(0, M0, 1, slotY), 12, Vector2.new(0, 1))
  editKit.TextColor3 = WHITE
  editKit.Font = Enum.Font.BuilderSansMedium
  -- 主按钮：出击
  local deployBtn, deployBtnT, deployBtnK = mainButton(spawnPage, UDim2.fromOffset(CW, CH), UDim2.new(1, -M0, 1, slotY), Vector2.new(1, 1))

  -- 键位说明放在部署界面最下面（战斗里第一人称不显示键位）
  local deployHelp = label(deploy, "", UDim2.new(1, -40, 0, 14), UDim2.new(0.5, 0, 1, -16), 11, FAINT, Enum.Font.BuilderSans, Vector2.new(0.5, 0))
  deployHelp.Visible = not G.mobile
  -- 开着菜单（挂载编辑器、部署界面）：鼠标要放出来点东西
  function G.menuOpen()
    return (G.hangarOpen ~= nil and G.hangarOpen()) or (G.pickerOpen ~= nil and G.pickerOpen()) or deploy.Visible
      or (G.tacOpen ~= nil and G.tacOpen())   -- 战术平板开着：鼠标放出来点地图、不开枪
      or (G.gunsmithOpen ~= nil and G.gunsmithOpen())   -- 改枪界面
      or (G.garageOpen ~= nil and G.garageOpen())   -- 坦克改装界面（用户 11-21：鼠标不显示——没算进来，步行第一人称时 stepUI 把鼠标图标藏了）
  end

  local function doDeploy()
    local S = G.S
    if not S or S.alive or (S.wait or 0) > 0 then return end
    if not sel.spawn then G.toast(T("ui.needPick"), "bad") return end
    G.R.Act:FireServer("deploy", sel.role or sel.kit, sel.spawn)
  end
  deployBtn.Activated:Connect(doDeploy)
  local function setPage(pg, user)
    sel.page = pg
    if user then sel.pageUser = pg end
    sel.slot = nil
    G.refreshDeploy()
  end
  goSpawn.Activated:Connect(function() setPage("spawn", true) end)
  editKit.Activated:Connect(function() setPage("kit", true) end)
  tabs.kit.b.Activated:Connect(function() setPage("kit", true) end)
  tabs.spawn.b.Activated:Connect(function() setPage("spawn", true) end)
  -- 回车：装备页 → 生成点 → 出击；退格：回装备页
  UIS.InputBegan:Connect(function(io, gp)
    if gp or not deploy.Visible then return end
    if io.KeyCode == Enum.KeyCode.Return then
      if sel.page == "spawn" then doDeploy() else setPage("spawn", true) end
    elseif io.KeyCode == Enum.KeyCode.Backspace and sel.page == "spawn" then
      setPage("kit", true)
    end
  end)

  local function spawnName(s)
    if s.kind == "beach" then return T("beach." .. s.beach) end
    if s.kind == "point" then return T("point." .. s.point) end
    if s.kind == "rally" then return T("spawn.rally", T("point." .. s.point)) end   -- 守方前线集结点（据点后方）
    if s.kind == "staging" then return T("spawn.staging", T("point." .. s.point)) end   -- 攻方攻击出发阵地（据点前面）
    if s.kind == "camp" then return T("spawn.camp") end
    if s.kind == "afield" then return T("spawn.afield") end
    if s.kind == "fleet" then return T("spawn.fleet") end
    if s.kind == "para" then return T("spawn.para") end
    if s.kind == "cv" then return T("spawn.cv") end
    if s.kind == "barge" then return T("spawn.barge") end
    if s.kind == "af2" then return T("spawn.af2") end
    if s.kind == "af3" then return T("spawn.af3") end   -- 沙海：守方主基地的机场
    if s.kind == "redbase" then return T("spawn.redbase") end   -- 沙漠图：红方前进基地
    if s.kind == "squad" then return T("spawn.squad", s.name or "?") end   -- 小队队友身边（Squads.lua）
    return s.id
  end

  -- 推荐的出生点（服务器标 rec：离当前目标最近的）：没选过、选的不能用了、换了阶段 / 新一局，就自动选上它——进来按一下出击就上战场
  local function autoSpawn(S)
    local ids, rec = {}, nil
    for _, s in ipairs(S.spawns or {}) do
      ids[s.id] = s
      if s.rec then rec = s end
    end
    local cur = sel.spawn and ids[sel.spawn]
    local stale = not cur or not cur.ok or sel.spawnStage ~= (S.stage or 1) or sel.spawnRound ~= S.round
    if stale and rec then
      sel.spawn = rec.id
      sel.spawnStage, sel.spawnRound = S.stage or 1, S.round
    end
  end
  -- 出生点：左边一列（名字、能不能去），地图上一个个小点
  local function buildSpawns(S)
    for _, b in ipairs(spawnBtns) do b:Destroy() end
    spawnBtns = {}
    local ids = {}
    for i, s in ipairs(S.spawns or {}) do
      ids[s.id] = s
      local chosen = sel.spawn == s.id
      local function pick()
        if not s.ok then G.toast(T("ui.spawnBlocked"), "bad") return end
        sel.spawn = s.id
        sel.spawnStage, sel.spawnRound = S.stage or 1, S.round   -- 自己挑的：这一阶段里一直用它
        G.refreshDeploy()
      end
      -- 列表里一行
      local row = Instance.new("TextButton")
      row.LayoutOrder = i
      row.Size = UDim2.new(1, -6, 0, mobile and 30 or 38)
      row.BackgroundColor3 = chosen and RGB(255, 255, 255) or RGB(12, 14, 16)
      row.BackgroundTransparency = chosen and 0.9 or 0.45
      row.BorderSizePixel = 0
      row.AutoButtonColor = false
      row.Text = ""
      row.Parent = list
      frame(row, UDim2.new(0, 2, 1, 0), nil, WHITE, chosen and 0 or 1)
      txt(row, spawnName(s), UDim2.new(1, -110, 1, 0), UDim2.fromOffset(14, 0), mobile and 12 or 14, s.ok and WHITE or FAINT, chosen and Enum.Font.BuilderSansMedium or Enum.Font.BuilderSans, nil, Enum.TextXAlignment.Left)
      local tag = txt(row, s.ok and (s.rec and T("deploy.rec") or "") or T("deploy.blocked"), UDim2.fromOffset(90, 16), UDim2.new(1, -12, 0.5, 0), 11, FAINT, Enum.Font.BuilderSansMedium, Vector2.new(1, 0.5), Enum.TextXAlignment.Right)
      if s.ok and s.rec then tag.TextColor3 = teamColor(S.team or "atk"):Lerp(WHITE, 0.3) end   -- 推荐：离当前目标最近
      row.Activated:Connect(pick)
      table.insert(spawnBtns, row)
      -- 地图上的点
      if s.x and spawnLayer then
        local u, v = G.mapUV(s.x, s.z)
        local b = Instance.new("TextButton")
        b.AnchorPoint = Vector2.new(0.5, 0.5)
        b.Position = UDim2.fromScale(u, v)
        b.Size = UDim2.fromOffset(chosen and 16 or 11, chosen and 16 or 11)
        b.Rotation = 45
        b.BackgroundColor3 = s.ok and WHITE or RGB(110, 110, 110)
        b.BackgroundTransparency = chosen and 0 or 0.25
        b.BorderSizePixel = 0
        b.Text = ""
        b.ZIndex = 8
        b.Parent = spawnLayer
        local st = Instance.new("UIStroke")
        st.Color = RGB(0, 0, 0)
        st.Thickness = 1
        st.Transparency = 0.3
        st.Parent = b
        if chosen then
          local tip = label(spawnLayer, spawnName(s), UDim2.fromOffset(160, 16), UDim2.new(u, 0, v, 12), 12, WHITE, Enum.Font.BuilderSansMedium, Vector2.new(0.5, 0))
          tip.ZIndex = 8
          tip.TextStrokeTransparency = 0.4
          table.insert(spawnBtns, tip)
        end
        b.Activated:Connect(pick)
        table.insert(spawnBtns, b)
      end
    end
    if sel.spawn and (not ids[sel.spawn] or not ids[sel.spawn].ok) then sel.spawn = nil end
  end

  -- 装备格：上面弹出这一格能换的
  local function openPicker(i)
    for _, c in ipairs(pickCards) do c.b:Destroy() end
    pickCards = {}
    if sel.slot == i or not SLOTS[i] then sel.slot = nil picker.Visible = false return end
    sel.slot = i
    focus = i
    local slot = SLOTS[i]
    local opts = table.clone(slot.opts)
    if slot.none then table.insert(opts, false) end
    local S = G.S or {}
    local pw, ph = mobile and 112 or 168, mobile and 70 or 104
    local x0 = math.max(M0, M0 + (i - 1) * (SW + GAP))
    pickHead.Text = T("deploy.choose", T("deploy.slot." .. slot.id))
    pickHead.Position = UDim2.new(0, x0, 1, slotY - SH - 14 - ph - 22)
    for k, id in ipairs(opts) do
      local c = newCard(picker, pw, ph)
      c.b.AnchorPoint = Vector2.new(0, 1)
      c.b.Position = UDim2.new(0, x0 + (k - 1) * (pw + 6), 1, slotY - SH - 14)
      c.idx.Text = ""
      local on = (sel.kit[slot.id] or false) == id
      local pass = id and G.passFor(id)
      local locked = pass and not passOk(pass)
      c.cat.Text = locked and T("pass.lockTag", Config.Passes[pass].price) or (on and T("deploy.current") or "")
      c.cat.TextColor3 = locked and RGB(255, 196, 92) or FAINT
      c.nm.Text = itemName(id or nil)
      local n = id and countOf(id)
      c.cnt.Text = n and ("×" .. n) or ""
      c.st.Transparency = on and 0.2 or 0.86
      if id then c.wait = setModel(c.vp, id, S.team) c.item = id end
      c.b.Activated:Connect(function()
        if locked then G.buyPass(pass) return end   -- 没解锁：弹出 Roblox 的购买框（买成了属性一变，这里自动刷新）
        sel.kit[slot.id] = id or nil
        sel.slot = nil
        picker.Visible = false
        for _, cc in ipairs(pickCards) do cc.b:Destroy() end
        pickCards = {}
        G.refreshDeploy()
      end)
      table.insert(pickCards, c)
    end
    picker.Visible = true
  end
  for i, c in ipairs(cards) do
    c.b.Activated:Connect(function()
      openPicker(i)
      G.refreshDeploy()
    end)
  end
  G.deployPick = openPicker   -- 测试、截图用：点开 / 收起第 i 格

  local lastTeam = nil
  function G.refreshDeploy()
    local S = G.S
    if not S then return end
    local team = S.team or "atk"
    local tc = teamColor(team)
    autoSpawn(S)
    -- 页：选好了出生点（推荐的自动选上）就先给生成点页，装备用默认的，按一下出击就上战场；想改装备点「改装备」
    local page = sel.pageUser or (sel.spawn and "spawn" or "kit")
    sel.page = page
    kitPage.Visible = page == "kit"
    spawnPage.Visible = page == "spawn"
    for pg, t in pairs(tabs) do
      t.b.Text = T("deploy.tab." .. pg)
      t.b.TextColor3 = (pg == page) and WHITE or DIM
      t.u.BackgroundTransparency = (pg == page) and 0 or 1
      t.u.BackgroundColor3 = WHITE
    end
    langBtn.Text = G.Lang.nameOf(G.lang) .. "  ▸"
    sideBtn.Text = T("ui.switchSide")
    menuBtn.Text = T("menu.open")
    -- 阵营一行
    facDot.BackgroundColor3 = tc
    facLine.Text = T("faction." .. team .. ".name") .. "   ·   " .. T((team == "def") and "ui.goalDef" or "ui.goalAtk")
    -- 换了阵营：装备格的样子（两边的模型不一样）重画
    if lastTeam ~= team then
      lastTeam = team
      for _, c in ipairs(cards) do c.item = "?" end
      bigItem = "?"
    end
    -- 装备格
    for i, c in ipairs(cards) do
      local slot = c.slot
      local id = sel.kit[slot.id]
      if not id and not slot.none then id = slot.opts[1] sel.kit[slot.id] = id end
      if id and G.passFor(id) and not passOk(G.passFor(id)) then id = nil sel.kit[slot.id] = nil end   -- 没解锁的（比如通行证刚上架）不带
      c.idx.Text = tostring(i)
      c.cat.Text = T("deploy.slot." .. slot.id)
      c.nm.Text = itemName(id)
      c.nm.TextColor3 = id and WHITE or FAINT
      local n = id and countOf(id)
      c.cnt.Text = n and ("×" .. n) or ""
      local on = (sel.slot == i) or (sel.slot == nil and focus == i)
      c.st.Transparency = on and 0.35 or 0.86
      c.bar.BackgroundTransparency = (sel.slot == i) and 0 or 1
      c.b.BackgroundTransparency = on and 0.25 or 0.4
      if c.item ~= (id or false) then
        c.item = id or false
        c.wait = setModel(c.vp, id, team)
      end
    end
    picker.Visible = sel.slot ~= nil
    -- 兵种那一排：现在这一套正好是哪个兵种的就点亮它（自己改了哪格就都不亮）
    roleRow.Visible = sel.slot == nil
    roleHead.Text = T("deploy.roles")
    local cur = nil
    for _, r in ipairs(Config.RoleKits or {}) do
      local k = Config.roleKit(r.id, team)
      local same = true
      for _, slot in ipairs(SLOTS) do
        if (k[slot.id] or false) ~= (sel.kit[slot.id] or false) then same = false break end
      end
      if same and (cur == nil or sel.kitRole == r.id) then cur = r.id end
    end
    for id, rb in pairs(roleBtns) do
      rb.b.Text = T("kitrole." .. id)
      rb.b.TextColor3 = (id == cur) and WHITE or DIM
      rb.b.Font = (id == cur) and Enum.Font.BuilderSansMedium or Enum.Font.BuilderSans
      rb.u.BackgroundTransparency = (id == cur) and 0 or 1
    end
    -- 标题、说明、数据、大图：看的那一格
    local fs = SLOTS[focus] or SLOTS[1]
    local fid = sel.kit[fs.id]
    bigName.Text = fid and itemName(fid) or T("deploy.none")
    bigDesc.Text = T("deploy.slot." .. fs.id) .. "   ·   " .. (fid and T("gear." .. fid .. ".desc") or T("deploy.noneDesc"))
    local rows = fid and statRows(fid) or {}
    for k, r in ipairs(stats) do
      local d = rows[k]
      local show = d ~= nil and not mobile
      r.a.Visible, r.bg.Visible, r.v.Visible = show, show, show
      if d then
        r.a.Text = d[1]
        r.fill.Size = UDim2.fromScale(d[2], 1)
        r.v.Text = d[3]
      end
    end
    local bkey = fid and (fid .. ((GMods.has(fid) and player:GetAttribute("Gun_" .. fid)) or "")) or false   -- 换了配件也重画大图
    if bigItem ~= bkey then
      bigItem = bkey
      bigWait = setModel(big, fid, team)
    end
    -- 改枪按钮：看的是装得了配件的枪
    local canMod = fid ~= nil and GMods.has(fid) and G.openGunsmith ~= nil
    sel.gsId = canMod and fid or nil
    gsBtn.Visible, gsLine.Visible, gsLv.Visible = canMod, canMod and not mobile, canMod
    if canMod then
      gsBtn.Text = T("gm.open")
      local b = G.myBuild and G.myBuild(fid) or GMods.default(fid)
      local names = {}
      for _, slot in ipairs(GMods.SLOTS) do
        local it = b[slot] and GMods.ITEM[b[slot]]
        if it and it.model then table.insert(names, T("gm.item." .. b[slot])) end
      end
      gsLine.Text = (#names > 0) and table.concat(names, " · ") or T("gm.stock")
      local lv, a, nx = GMods.level(fid, player:GetAttribute("GunXp_" .. fid) or 0)
      gsLv.Text = T("gm.lv", lv) .. (nx and "" or ("  " .. T("gm.max")))
    end
    -- 主按钮
    goSpawnT.Text = T("deploy.pickSpawn")
    goSpawnK.Text = mobile and "" or T("deploy.enter")
    buildSpawns(S)
    listHead.Text = T("deploy.tab.spawn")
    local names = {}
    for _, slot in ipairs(SLOTS) do
      local id = sel.kit[slot.id]
      if id then table.insert(names, itemName(id)) end
    end
    kitLine.Text = T("deploy.kitLine", table.concat(names, " · "))
    editKit.Text = T("deploy.editKit")
    if (S.wait or 0) > 0 then
      deployBtnT.Text = T("ui.waitRespawn", S.wait)
      deployBtn.BackgroundColor3 = RGB(46, 48, 52)
      deployBtnT.TextColor3 = DIM
      deployBtn.AutoButtonColor = false
    else
      deployBtnT.Text = T("ui.deployBtn")
      deployBtn.BackgroundColor3 = WHITE
      deployBtnT.TextColor3 = sel.spawn and RGB(10, 10, 12) or RGB(120, 120, 124)
      deployBtn.AutoButtonColor = true
    end
    deployBtnK.Text = mobile and "" or T("deploy.enter")
  end

  -- 真模型还在生成：隔两秒再要一次（最多等半分钟）
  task.spawn(function()
    for _ = 1, 15 do
      task.wait(2)
      if deploy.Visible and G.S then
        local any = false
        for _, c in ipairs(cards) do if c.wait then c.item = "?" any = true end end
        if bigWait then bigItem = "?" any = true end
        if any then G.refreshDeploy() end
      end
    end
  end)
  -- 大图慢慢左右转（绕模型中心：G.viewFit 记在属性 C 里）
  G.frameConn("UI2", function()
    if not deploy.Visible or not kitPage.Visible then return end
    local m = big:FindFirstChildOfClass("Model")
    local c = m and m:GetAttribute("C")
    if c then pcall(function() m:PivotTo(CFrame.new(c) * CFrame.Angles(0, math.sin(os.clock() * 0.5) * 0.3, 0)) end) end
  end)

  langBtn.Activated:Connect(function()   -- 11-28 多语言：按 Lang.LIST 的顺序换下一种（十种）
    G.lang = G.Lang.nextOf(G.lang)
    if G.setPref then G.setPref("lang", G.lang) end   -- 记进设置（存档；设置页的下拉框也跟着）
    G.refresh()
  end)

  ---------------------------------------------------------------- 顶栏：时间、据点

  local hud = frame(gui, UDim2.fromScale(1, 1), nil, PANEL, 1)
  hud.Name = "Hud"
  local topBar = frame(hud, UDim2.fromOffset(460, 74), UDim2.new(0.5, 0, 0, 8), PANEL, 0.35, Vector2.new(0.5, 0))
  round(topBar, 10)
  local timer = label(topBar, "", UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, 4), 20, TEXT, Enum.Font.BuilderSansBold)
  local chips = {}
  for i, p in ipairs(Map.POINTS) do
    local c = frame(topBar, UDim2.fromOffset(80, 38), UDim2.fromOffset(10 + (i - 1) * 89, 30), RGB(30, 40, 60), 0.05)
    round(c, 6)
    local l = label(c, p.id, UDim2.new(0, 26, 1, 0), UDim2.fromOffset(4, 0), 20, Color3.new(1, 1, 1), Enum.Font.BuilderSansBold)
    local n = label(c, "", UDim2.new(1, -32, 0, 18), UDim2.fromOffset(30, 3), 12, Color3.new(1, 1, 1), Enum.Font.BuilderSansMedium, nil, Enum.TextXAlignment.Left)
    local barBg = frame(c, UDim2.new(1, -36, 0, 5), UDim2.new(0, 30, 1, -10), RGB(0, 0, 0), 0.5)
    local bar = frame(barBg, UDim2.fromScale(0, 1), nil, Config.Teams.atk.color, 0)
    chips[p.id] = { f = c, l = l, n = n, bar = bar }
  end
  local counts = label(hud, "", UDim2.fromOffset(240, 20), UDim2.new(0.5, 0, 0, 84), 14, TEXT, Enum.Font.BuilderSansMedium, Vector2.new(0.5, 0))
  counts.TextStrokeTransparency = 0.5

  -- 血条
  local hpBg = frame(hud, UDim2.fromOffset(260, 14), UDim2.new(0, 20, 1, -40), RGB(0, 0, 0), 0.45)
  round(hpBg, 4)
  local hpBar = frame(hpBg, UDim2.fromScale(1, 1), nil, RGB(90, 210, 110), 0)
  round(hpBar, 4)
  local hpText = label(hpBg, "", UDim2.fromScale(1, 1), nil, 12, Color3.new(1, 1, 1), Enum.Font.BuilderSansMedium)
  local roleText = label(hud, "", UDim2.fromOffset(260, 18), UDim2.new(0, 20, 1, -62), 14, TEXT, Enum.Font.BuilderSansMedium, nil, Enum.TextXAlignment.Left)
  roleText.TextStrokeTransparency = 0.5
  local help = label(hud, "", UDim2.new(0.6, 0, 0, 16), UDim2.new(0.5, 0, 1, -18), 12, MUTE, Enum.Font.BuilderSans, Vector2.new(0.5, 0))
  help.TextStrokeTransparency = 0.6

  -- 小地图容器（Hud.lua 摆到右上、画成方形雷达小地图）：CanvasGroup 才能把里面的地图、亮点按框裁掉
  local miniBox = Instance.new("CanvasGroup")
  miniBox.Name = "Radar"
  miniBox.Size, miniBox.Position, miniBox.AnchorPoint = UDim2.fromOffset(230, 230), UDim2.new(1, -16, 1, -16), Vector2.new(1, 1)
  miniBox.BackgroundColor3, miniBox.BackgroundTransparency, miniBox.BorderSizePixel = PANEL, 1, 0
  miniBox.Parent = hud
  -- 地图真正挂在框里这一层（ClipsDescendants 的普通 Frame）：CanvasGroup 的裁边有时不起作用（用户 11-24 截图：开坦克瞄准镜、
  --   小地图挪到 RadarTop 那层以后，2000 多像素的整张图没裁、深蓝的海盖住半个镜子）——这一层再按方框裁一次，怎么都不会漏出来
  local miniClip = Instance.new("Frame")
  miniClip.Name = "MapClip"
  miniClip.Size = UDim2.fromScale(1, 1)
  miniClip.BackgroundTransparency = 1
  miniClip.BorderSizePixel = 0
  miniClip.ClipsDescendants = true
  miniClip.Parent = miniBox
  -- 战斗中的界面换成《坠落》那种风格（Hud.lua）：旧的顶栏、血条、兵种字交给它收起来，小地图框挪到左下
  G.hudParts = { hud = hud, topBar = topBar, counts = counts, hpBg = hpBg, roleText = roleText, miniBox = miniBox, miniClip = miniClip, help = help }

  ---------------------------------------------------------------- 消息

  local center = label(gui, "", UDim2.new(0.8, 0, 0, 40), UDim2.new(0.5, 0, 0.44, 0), 24, Color3.new(1, 1, 1), Enum.Font.BuilderSansMedium, Vector2.new(0.5, 0.5))
  center.TextStrokeTransparency = 0.3
  center.ZIndex = 30
  local centerT = 0
  local feed = frame(gui, UDim2.fromOffset(340, 160), UDim2.new(1, -16, 0, 120), PANEL, 1, Vector2.new(1, 0))
  G.hudParts.feed = feed   -- 击杀信息：Hud.lua 把小地图放到右上后挪到它下面
  local feedList = Instance.new("UIListLayout")
  feedList.HorizontalAlignment = Enum.HorizontalAlignment.Right
  feedList.SortOrder = Enum.SortOrder.LayoutOrder
  feedList.Parent = feed
  local toasts = frame(gui, UDim2.fromOffset(440, 200), UDim2.new(0.5, 0, 1, -110), PANEL, 1, Vector2.new(0.5, 1))
  local toastList = Instance.new("UIListLayout")
  toastList.VerticalAlignment = Enum.VerticalAlignment.Bottom
  toastList.HorizontalAlignment = Enum.HorizontalAlignment.Center
  toastList.Padding = UDim.new(0, 4)
  toastList.SortOrder = Enum.SortOrder.LayoutOrder
  toastList.Parent = toasts
  local order = 0
  -- 跟新界面一个样子（深色、直角、细线）：底是深色，左边一道颜色细条分好消息、坏消息、击杀
  local KIND_COL = { good = TH.C.GOOD, bad = TH.C.BAD, info = TH.C.MUTE, kill = TH.C.WARN }
  function G.toast(text, kind)
    order += 1
    local l = label(toasts, text, UDim2.fromOffset(420, 28), nil, 14, TEXT, Enum.Font.BuilderSans)
    l.BackgroundColor3 = RGB(6, 8, 10)
    l.BackgroundTransparency = 0.2
    l.LayoutOrder = order
    stroke(l, LINE, 1, 0.9)
    frame(l, UDim2.new(0, 3, 1, 0), nil, KIND_COL[kind or "info"] or KIND_COL.info, 0)
    task.delay(4, function() l:Destroy() end)
  end
  function G.centerMsg(text)
    center.Text = text
    center.TextTransparency = 0
    centerT = os.clock()
  end
  local function feedAdd(text)
    order += 1
    local l = label(feed, text, UDim2.fromOffset(340, 22), nil, 14, Color3.new(1, 1, 1), Enum.Font.BuilderSansMedium, nil, Enum.TextXAlignment.Right)
    l.TextStrokeTransparency = 0.4
    l.LayoutOrder = order
    local kids = {}
    for _, c in ipairs(feed:GetChildren()) do if c:IsA("TextLabel") then table.insert(kids, c) end end
    if #kids > 6 then table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end) kids[1]:Destroy() end
    task.delay(8, function() l:Destroy() end)
  end

  -- 服务器发来的文字：kind、编号、参数（参数里的 { k = 编号 } 也翻译）
  function G.onMsg(kind, key, ...)
    if kind == "hit" then
      if G.hitMarker then G.hitMarker(key) end
      return
    end
    if kind == "hurt" then   -- 挨打：伤害从哪来（Juice.lua 在准星周围画红弧），key 是位置
      if G.juiceHurt and typeof(key) == "Vector3" then G.juiceHurt(key) end
      return
    end
    -- 试驾场里不报主战场的事（用户 11-25 晚「训练场为什么会有missionfailed 还有一堆乱七八糟的据点占领啥的」）：
    --   占点、阶段、兵力、胜负、任务、击杀栏都不弹；试驾自己的提示（Tech.lua 发的 tech.* / wt.*）照常
    if G.inTestDrive and G.inTestDrive() then
      local k = type(key) == "string" and key or ""
      if kind == "center" or kind == "stage" or kind == "feed" or k:find("^ui%.captur") or k:find("^ui%.flank") or k:find("^ui%.lost")
        or k:find("^ui%.tickets") or k:find("^ui%.win") or k:find("^ui%.conquest") or k:find("^wtm%.") or k:find("^pve%.") or k:find("^stage%.") then
        return
      end
    end
    if key == "ui.capturedYou" and G.juiceScore then G.juiceScore(G.Config.Score.capture, T("juice.cap")) end
    if kind == "ric" then   -- 跳弹（服务器 Ents.lua）：准星下面弹一行黄字（打出去的跳了 / 打过来的被弹开）
      if G.pop then G.pop(T(key, ...), key == "hit.ricIn" and "ricIn" or "ric") end
      return
    end
    if kind == "refill" then   -- 战术平板的补给箱：本地弹药也补满（Play.lua）
      if G.refillAmmo then G.refillAmmo() end
      return
    end
    if kind == "stage" then   -- Operation.lua 直接从战况读阶段，中途入场也会显示简报。
      if not G.stepOperation then G.centerMsg(T(key)) end
      return
    end
    local text = T(key, ...)
    -- 击杀、自己占下据点：准星下面弹一行（Hud.lua G.pop），右上角照样留一条
    if G.pop and (kind == "kill" or key == "ui.capturedYou") then G.pop(text, kind) end
    if kind == "center" then G.centerMsg(text)
    elseif kind == "feed" then feedAdd(text)
    elseif kind == "kill" then   -- 击杀：准星下面那一行（或开车时命中结果的「已击毁」）+ 左边击杀栏已经有了，不再在下面弹第三条（统一外观：一件事只报一处）
    else G.toast(text, kind) end
  end

  ---------------------------------------------------------------- 战况表（按住 Tab）

  -- 跟新界面一个样子：深色、直角、细线（用户：要精致简洁，不要卡通）
  local board = frame(gui, UDim2.fromOffset(780, 520), UDim2.fromScale(0.5, 0.52), RGB(6, 8, 10), 0.08, Vector2.new(0.5, 0.5))
  board.Visible = false
  board.ZIndex = 20
  stroke(board, LINE, 1, 0.88)
  local boardTitle = label(board, "", UDim2.new(1, -48, 0, 40), UDim2.fromOffset(24, 8), 16, TEXT, Enum.Font.BuilderSansMedium, nil, Enum.TextXAlignment.Left)
  boardTitle.ZIndex = 21
  local cols = {}
  for i, t in ipairs({ "atk", "def" }) do
    local c = frame(board, UDim2.new(0.5, -36, 1, -64), UDim2.new((i - 1) * 0.5, 24, 0, 52), RGB(0, 0, 0), 1)
    c.ZIndex = 21
    local tl = frame(c, UDim2.new(1, 0, 0, 2), nil, teamColor(t), 0)   -- 顶上一道队色细线
    tl.ZIndex = 22
    local h = label(c, "", UDim2.new(1, 0, 0, 28), UDim2.fromOffset(0, 6), 14, TEXT, Enum.Font.BuilderSansMedium, nil, Enum.TextXAlignment.Left)
    h.ZIndex = 22
    local list = Instance.new("Frame")
    list.BackgroundTransparency = 1
    list.Size = UDim2.new(1, -8, 1, -32)
    list.Position = UDim2.fromOffset(4, 30)
    list.ZIndex = 22
    list.Parent = c
    local ll = Instance.new("UIListLayout")
    ll.SortOrder = Enum.SortOrder.LayoutOrder
    ll.Parent = list
    cols[t] = { head = h, list = list }
  end
  local boardData = {}
  local drawnData, drawnLang = nil, nil   -- 上次画的是哪一份数据、哪种语言：按 Tab 打开时数据没变就不再整张重建（几十行、上百个字）
  function G.onBoard(d) boardData = d or {} if board.Visible then G.drawBoard() end end
  function G.drawBoard()
    if drawnData == boardData and drawnLang == G.lang then return end
    drawnData, drawnLang = boardData, G.lang
    boardTitle.Text = T("ui.scoreboard")
    for t, c in pairs(cols) do
      for _, k in ipairs(c.list:GetChildren()) do if k:IsA("Frame") then k:Destroy() end end
      local rows = {}
      for _, e in ipairs(boardData) do if e.t == t then table.insert(rows, e) end end
      table.sort(rows, function(a, b) return (a.s or 0) > (b.s or 0) end)
      c.head.Text = T("hud." .. t) .. "   ·   " .. T("team." .. t) .. "   " .. #rows
      local hdr = frame(c.list, UDim2.new(1, 0, 0, 18), nil, PANEL, 1)
      hdr.LayoutOrder = 0
      hdr.ZIndex = 22
      for k, txt in ipairs({ "", T("ui.kills"), T("ui.deaths"), T("ui.captures"), T("ui.score") }) do
        local l = label(hdr, txt, UDim2.new(k == 1 and 0.44 or 0.14, 0, 1, 0), UDim2.new(k == 1 and 0 or (0.44 + (k - 2) * 0.14), 0, 0, 0), 10, MUTE, Enum.Font.BuilderSans)
        l.ZIndex = 23
      end
      for i, e in ipairs(rows) do
        if i > 22 then break end
        local r = frame(c.list, UDim2.new(1, 0, 0, 20), nil, RGB(255, 255, 255), (e.id == player.UserId) and 0.9 or 1)
        r.LayoutOrder = i
        r.ZIndex = 22
        local nm = e.n .. (e.bot and (" " .. T("ui.bot")) or "")
        for k, txt in ipairs({ nm, tostring(e.k or 0), tostring(e.d or 0), tostring(e.c or 0), tostring(e.s or 0) }) do
          local l = label(r, txt, UDim2.new(k == 1 and 0.44 or 0.14, 0, 1, 0), UDim2.new(k == 1 and 0 or (0.44 + (k - 2) * 0.14), 0, 0, 0), 12, TEXT,
            Enum.Font.BuilderSans, nil, k == 1 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center)
          l.ZIndex = 23
          l.TextTruncate = Enum.TextTruncate.AtEnd
        end
      end
    end
  end
  UIS.InputBegan:Connect(function(io, gp)
    if io.KeyCode == Enum.KeyCode.Tab then
      G.drawBoard()   -- 先画好再弹出来（同一帧）
      G.uiShow(board, true)
    end
    G.boardShown = function() return board.Visible end
  end)
  UIS.InputEnded:Connect(function(io)
    if io.KeyCode == Enum.KeyCode.Tab then G.uiShow(board, false) end
  end)
  local boardBtn = button(hud, "≡", UDim2.fromOffset(36, 36), UDim2.new(0, 16, 0, 70), RGB(8, 10, 12))   -- 顶栏下面：左上角是 Roblox 自带的菜单、聊天按钮
  boardBtn.BackgroundTransparency = 0.5
  boardBtn.TextColor3 = RGB(200, 206, 210)
  for _, c in ipairs(boardBtn:GetChildren()) do if c:IsA("UICorner") then c:Destroy() end end   -- 直角，跟新界面一样
  boardBtn.TextSize = 22
  -- 开 / 关战况表（v 不给就是切换）：左上「≡」、局内出击页的「数据统计」（WtSpawn.lua）
  function G.boardToggle(v)
    if v == nil then v = not board.Visible end
    if v then G.drawBoard() end
    G.uiShow(board, v)
  end
  boardBtn.Activated:Connect(function() G.boardToggle() end)

  ---------------------------------------------------------------- 结算

  -- 跟战况表一个样子：深色、直角、细线；顶上一道胜方的队色细线，四个大数字，经验、军衔，下一局倒计时
  local results = frame(gui, UDim2.fromOffset(640, 286), UDim2.fromScale(0.5, 0.46), RGB(6, 8, 10), 0.08, Vector2.new(0.5, 0.5))
  results.Visible = false
  results.ZIndex = 25
  stroke(results, LINE, 1, 0.88)
  local resLine = frame(results, UDim2.new(1, 0, 0, 2), nil, LINE, 0)
  local resCap = label(results, "", UDim2.new(1, -56, 0, 16), UDim2.fromOffset(28, 22), 11, MUTE, Enum.Font.BuilderSans, nil, Enum.TextXAlignment.Left)
  local resTitle = label(results, "", UDim2.new(1, -56, 0, 42), UDim2.fromOffset(28, 40), 34, TEXT, Enum.Font.BuilderSansMedium, nil, Enum.TextXAlignment.Left)
  local resSub = label(results, "", UDim2.new(1, -56, 0, 20), UDim2.fromOffset(28, 86), 14, MUTE, Enum.Font.BuilderSans, nil, Enum.TextXAlignment.Left)
  local resNums = {}
  for i, k in ipairs({ "ui.kills", "ui.deaths", "ui.captures", "ui.score" }) do
    local x = 28 + (i - 1) * 146
    resNums[i] = {
      k = k,
      n = label(results, "0", UDim2.fromOffset(130, 38), UDim2.fromOffset(x, 124), 30, TEXT, Enum.Font.BuilderSans, nil, Enum.TextXAlignment.Left),
      c = label(results, "", UDim2.fromOffset(130, 14), UDim2.fromOffset(x, 164), 11, MUTE, Enum.Font.BuilderSans, nil, Enum.TextXAlignment.Left),
    }
  end
  local resSep = frame(results, UDim2.new(1, -56, 0, 1), UDim2.fromOffset(28, 196), LINE, 0.88)
  local resXp = label(results, "", UDim2.new(1, -56, 0, 20), UDim2.fromOffset(28, 208), 14, TEXT, Enum.Font.BuilderSans, nil, Enum.TextXAlignment.Left)
  local resNext = label(results, "", UDim2.new(1, -56, 0, 18), UDim2.new(0, 28, 1, -40), 12, MUTE, Enum.Font.BuilderSans, nil, Enum.TextXAlignment.Left)
  for _, x in ipairs({ resLine, resCap, resTitle, resSub, resSep, resXp, resNext }) do x.ZIndex = 26 end
  for _, r in ipairs(resNums) do r.n.ZIndex, r.c.ZIndex = 26, 26 end
  if mobile then   -- 手机横屏（844 × 390）：缩一点，别盖住触屏按钮
    local sc = Instance.new("UIScale")
    sc.Scale = 0.8
    sc.Parent = results
  end

  ---------------------------------------------------------------- 刷新（收到服务器状态时）

  local mapMountedIn = nil
  function G.refresh()
    local S = G.S
    if not S then return end
    if G.refreshMapPick then G.refreshMapPick(S) end   -- 选地图界面（MapPick.lua）：生成地图时也要刷进度、生成好了快速加入
    if (S.progress or 1) < 1 then
      loading.Visible = true
      loadText.Text = T("ui.serverStarting", math.floor((S.progress or 0) * 100))
      return
    end
    loading.Visible = false
    if G.refreshMenu then G.refreshMenu(S) end         -- 主菜单（Menu.lua）：进服先到这里
    if G.refreshFaction then G.refreshFaction(S) end   -- 选阵营界面（Faction.lua）：主菜单点了「进入战斗」还没选、或者点了「换阵营」
    -- 阵亡效果（DeathFx.lua，用户 11-23：死亡不要瞬间切到部署画面）放着的时候部署界面、平显都先不出来
    local dying = G.deathFxOn ~= nil and G.deathFxOn() == true
    local showDeploy = not S.alive and S.phase ~= "end" and not dying
    if S.alive then sel.pageUser, sel.slot = nil, nil end   -- 下次阵亡：上次出击过就先给生成点页
    local menuOn = G.menuShown and G.menuShown()
    -- 机库（TechUI.lua，用户 11-25「就跟战雷完全一样 不要让玩家作为个体活动」）：开着 Config.Wt.noInfantry 时盖住步兵部署页，从出击阵容里挑车出击
    if G.hangarSet then G.hangarSet(showDeploy and not menuOn) end   -- 局内选车也是这一页（TechUI.lua：服务器 S.pick 时主按钮「出击」）
    deploy.Visible = showDeploy and not menuOn and not (G.hangarActive and G.hangarActive())   -- 主菜单开着（背景是透明的 3D 场景）：部署界面先不画
    hud.Visible = not showDeploy and not dying
    results.Visible = S.phase == "end" and not (G.wtResultsOn and G.wtResultsOn())   -- 战雷式结算页（WtBattle.lua）开着就不画这张
      and not (G.inTestDrive and G.inTestDrive())   -- 还在试驾场里：这一局的结算都不弹
    -- 地图放在部署界面或小地图里
    local want = showDeploy and mapHolder or miniClip
    if mapMountedIn ~= want then
      mapMountedIn = want
      local _, marks = G.mapMount(want, UDim2.fromScale(1, 1))
      spawnLayer = marks
    end
    if G.mapRefresh then G.mapRefresh(S) end
    if showDeploy then
      G.refreshDeploy()
      if S.phase == "prep" then phaseText.Text = T("ui.prep", S.left) else phaseText.Text = T("ui.timeLeft") .. "  " .. fmtTime(S.left) end
    else
      for _, b in ipairs(spawnBtns) do b:Destroy() end
      spawnBtns = {}
    end
    -- 顶栏
    if S.phase == "prep" then
      timer.Text = T("ui.prep", S.left)
    elseif S.ot then
      timer.Text = T("ui.overtime") .. "  " .. fmtTime(S.ot)
    else
      timer.Text = fmtTime(S.left)
    end
    for _, s in ipairs(S.points or {}) do
      local c = chips[s.id]
      if c then
        c.f.BackgroundColor3 = teamColor(s.owner):Lerp(Color3.new(0, 0, 0), 0.25)
        c.bar.Size = UDim2.fromScale(s.locked and 1 or s.prog, 1)
        c.n.Text = s.locked and "" or ((s.atk > 0 or s.def > 0) and (T("team.atk.short") .. s.atk .. " " .. T("team.def.short") .. s.def) or "")
      end
    end
    counts.Text = T("team.atk") .. " " .. (S.nAtk or 0) .. "   ·   " .. T("team.def") .. " " .. (S.nDef or 0)
    roleText.Text = (S.role and T("role." .. S.role) or "") .. "  ·  " .. T("team." .. (S.team or "atk"))
    roleText.TextColor3 = teamColor(S.team)
    if S.phase == "end" then
      local won = S.winner == S.team
      resLine.BackgroundColor3 = teamColor(S.winner)
      resCap.Text = T("ui.roundOver")
      resTitle.Text = T(won and "ui.youWon" or "ui.youLost")
      resTitle.TextColor3 = won and TEXT or RGB(236, 120, 108)
      resSub.Text = T((S.winner == "atk") and "ui.win.atk" or "ui.win.def") .. (S.mvp and ("   ·   MVP  " .. S.mvp) or "")
      local me = S.me or {}
      local vals = { me.k or 0, me.d or 0, me.c or 0, me.s or 0 }
      for i, r in ipairs(resNums) do
        r.n.Text = tostring(vals[i])
        r.c.Text = T(r.k)
      end
      resXp.Text = T("ui.xp", me.gain or 0) .. "   ·   " .. Lang.rank(G.lang, me.rank or 1)
      resNext.Text = T("ui.nextRound", S.left)
    end
  end

  function G.stepUI(dt)
    -- 开着载具 / 飞机 / 火炮：血条、兵种看载具面板；最下面一行换成载具的操作说明（面板里放不下一整行）
    local drv = G.drive
    hpBg.Visible, roleText.Visible = not drv, not drv
    help.Text = T(drv and (drv.help or "ui.vehHelp") or "ui.help")
    -- 手机上是触屏按钮，不显示键盘说明；步行第一人称也不显示（用户：持枪第一视角不要显示鼠标、键位；键位说明在部署界面最下面）
    help.Visible = not G.coachOn and not G.mobile and not (G.fpActive and not drv)   -- Coach.lua 换成按当前状态的几个键（全文在 F1）
    deployHelp.Text = T("ui.help")
    -- 鼠标指针：游戏里锁在屏幕中间时（第一人称、肩后瞄准、开车开飞机开船、操作工事）不画——准星是自己画的；开着菜单时画出来
    if not G.mobile then
      local menu = G.menuOpen()
      local xr = G.ownXrayOn ~= nil and G.ownXrayOn() and G.ownXrayPtr == true   -- 按住 X 透视自己的车、再按住 Alt：鼠标放开了（Drive.lua），画出指针去指部件
      local locked = not menu and not xr and (UIS.MouseBehavior == Enum.MouseBehavior.LockCenter or (G.fpActive and not drv) or drv ~= nil)
      if UIS.MouseIconEnabled == locked then UIS.MouseIconEnabled = not locked end
      if menu and UIS.MouseBehavior == Enum.MouseBehavior.LockCenter then UIS.MouseBehavior = Enum.MouseBehavior.Default end
    end
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
      local k = math.clamp(hum.Health / math.max(1, hum.MaxHealth), 0, 1)
      hpBar.Size = UDim2.fromScale(k, 1)
      hpBar.BackgroundColor3 = RGB(230, 70, 60):Lerp(RGB(90, 210, 110), k)
      hpText.Text = math.ceil(hum.Health) .. " / " .. math.ceil(hum.MaxHealth)
    end
    local a = os.clock() - centerT
    local fade = results.Visible and 1 or math.clamp((a - 3) / 1, 0, 1)   -- 结算面板开着：中间那行大字（胜负原因）面板上有了，不叠着画
    center.TextTransparency = fade
    center.TextStrokeTransparency = 0.3 + 0.7 * fade
  end
end

return UI
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="275">
          <Properties>
            <string name="Name">VehCam</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——载具的追尾镜头（用户 11-20：「这个游戏目前所有的载具操控都不够 3A，你用虚幻引擎 5 的水平全面升级」）
--   照 UE5 的弹簧臂（SpringArm：CameraLag / CameraRotationLag / 碰撞探测）做，开车、开船、开直升机共用：
--   · 跟随点有惯性：车身上下颠、急停急转时，镜头不是死钉在车上——用车速预测、再用临界阻尼弹簧追上，
--     匀速开时不落后，颠簸、刹车、撞停时车在画面里先晃出去一点再被镜头接住（有重量感）
--   · 加速度推拉：起步镜头往后坠、刹车往前冲、转弯往外甩、落地往下沉（有上限、平滑）
--   · 臂长碰到山坡、房子：一下缩近、慢慢放回（不跳）
--   · 路面颠簸的细抖（速度 × 路面粗糙程度）、发动机的细微震动；大的冲击（落地、撞车、开炮）走 G.shake
--   · 镜头跟着车身侧倾歪一点（两成）；越快视野越宽
--   G.vehCam(o) → 镜头 CFrame（没加细抖的，用来算准星）、细抖（乘在后面）、视野
local VehCam = {}

function VehCam.init(G)
  local V = Vector3.new
  local S = {}   -- 每个用的地方一份（key）

  -- 临界阻尼弹簧：x 往 target 走（w 越大越快）
  local function spring(x, v, target, w, dt)
    local n = math.max(1, math.ceil(dt / (1 / 120)))
    local h = dt / n
    for _ = 1, n do
      local a = (target - x) * (w * w) - v * (2 * w)
      v += a * h
      x += v * h
    end
    return x, v
  end

  function G.vehCamReset(key) S[key] = nil end

  -- o：key, pivot（镜头绕着转的点）, dir（镜头朝向，只取旋转）, dist（臂长）, up（往上抬）, vel（车的速度 Vector3）, dt,
  --   rough（路面颠簸 0～2）, speedK（速度比例 0～1.3）, up3（车身的「上」，镜头跟着歪两成；不给就不歪）, params（镜头不能钻进去的东西）,
  --   fov0（基础视野）, fovK（全速多加几度）, pushK（加速度推镜头的比例）, maxPush, follow（跟随弹簧快慢）, minDist
  function G.vehCam(o)
    local dt = math.clamp(o.dt or 1 / 60, 1 / 240, 0.1)
    local s = S[o.key]
    local pivot = o.pivot
    local vel = o.vel or V()
    if not s or (s.p - pivot).Magnitude > 60 then   -- 第一次 / 被挪走了：直接到位
      s = { p = pivot, pv = V(), lv = vel, acc = V(), push = V(), len = o.dist, fov = o.fov0 or 70, t = 0 }
      S[o.key] = s
    end
    s.t += dt
    -- 跟随点：先按车速往前挪（匀速时不落后），再用弹簧追真正的位置（颠簸、急停时有一点惯性）
    s.p += vel * dt
    local w = o.follow or 9
    local px, pvx = spring(s.p.X, s.pv.X, pivot.X, w * 1.4, dt)
    local py, pvy = spring(s.p.Y, s.pv.Y, pivot.Y, w, dt)
    local pz, pvz = spring(s.p.Z, s.pv.Z, pivot.Z, w * 1.4, dt)
    s.p, s.pv = V(px, py, pz), V(pvx, pvy, pvz)
    local lag = s.p - pivot
    local maxLag = o.maxLag or 2.5
    if lag.Magnitude > maxLag then s.p = pivot + lag.Unit * maxLag end
    -- 加速度推拉：起步往后坠、刹车往前冲、转弯往外甩、落地往下沉
    local acc = (vel - s.lv) / dt
    s.lv = vel
    if acc.Magnitude > 400 then acc = acc.Unit * 400 end   -- 瞬移、刚上车那一下不算
    s.acc = s.acc:Lerp(acc, 1 - math.exp(-dt * 6))
    local push = -s.acc * (o.pushK or 0.02)
    local mp = o.maxPush or 2.2
    if push.Magnitude > mp then push = push.Unit * mp end
    s.push = s.push:Lerp(push, 1 - math.exp(-dt * 5))
    -- 臂：从跟随点往后、往上；碰到东西一下缩近、慢慢放回
    local dir = o.dir
    local want = dir:VectorToWorldSpace(V(0, 0, o.dist)) + V(0, o.up or 0, 0)
    local base = s.p + s.push * 0.6
    local len = o.dist
    if o.params and want.Magnitude > 1 then
      local hit = workspace:Raycast(base, want, o.params)
      if hit then len = math.max(o.minDist or 4, (hit.Position - base).Magnitude - 1.5) * o.dist / want.Magnitude end
    end
    if len < s.len then s.len += (len - s.len) * (1 - math.exp(-dt * 22)) else s.len += (len - s.len) * (1 - math.exp(-dt * 2.5)) end
    local camPos = base + want * (s.len / o.dist) + s.push * 0.4
    -- 歪：世界的「上」往车身的「上」靠两成
    local upV = V(0, 1, 0)
    if o.up3 then
      local u = V(0, 1, 0):Lerp(o.up3, 0.2)
      if u.Magnitude > 0.1 then upV = u.Unit end
    end
    local look = dir.LookVector
    local cf = CFrame.lookAt(camPos, camPos + look, upV)
    -- 细抖：路面颠簸（低频的晃 + 高频的抖）、发动机的细微震动
    local sk = math.clamp(o.speedK or 0, 0, 1.3)
    local r = (o.rough or 0.6) * sk
    local t = s.t
    local aLo = 0.0016 * r
    local aHi = 0.0011 * r + 0.00025
    local shake = CFrame.Angles(math.noise(t * 5.3, 1.7) * aLo + math.noise(t * 23, 4.4) * aHi, math.noise(t * 4.7, 8.1) * aLo * 0.6 + math.noise(t * 21, 2.2) * aHi * 0.6,
      math.noise(t * 6.1, 5.5) * aLo * 0.8)
    -- 视野：越快越宽
    local fovT = (o.fov0 or 70) + (o.fovK or 6) * math.clamp(sk, 0, 1.2)
    s.fov += (fovT - s.fov) * (1 - math.exp(-dt * 3))
    s.cf = cf
    return cf, shake, s.fov
  end
  G.vehCamState = function(key) return S[key] end   -- 测试用
end

return VehCam
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="276">
          <Properties>
            <string name="Name">VehHud</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——载具驾驶界面。用户 11-18：「坦克驾驶界面、操作系统观感不够惊艳，舰船也是……放开了做，作出一款震撼的作品」
--   照战雷、战地的样子重做坦克（Drive.lua 的 G.myVeh）和舰艇（Sail.lua 的 G.sail）的驾驶界面；
--   有了这个模块（G.vehHudOn），Drive.lua、Sail.lua 原来那块小面板、圆圈、黄十字不画了（瞄准镜、望远镜、导弹锁定框照旧归它们）。
--   · 电脑右下两块，触屏用紧凑读数面板给方向键留位置：
--     「车况 / 舰况」：名字；俯视轮廓（车体 / 舰体按相对镜头的朝向转，炮塔、炮管按各自的朝向转；外圈上方两道短线是镜头看的方向），
--       描边按血量变色、挨打闪红；十格血条和百分比；坦克：速度（大数字）、挡位 D / R / N、航向、油门条；
--       舰艇：航速（节）、车钟（后退二 … 全速前进 一格格的梯子，亮的是现在这一档）、舵角条（左右 35°）、航向
--     「武器」：每一种武器一行（按键、名字、弹药），选中的那行亮、左边一道琥珀色；右边装填环（24 颗点：装填时一颗颗亮起琥珀色，装好全绿、写「就绪」）；
--       坦克的烟幕弹、舰艇的防空导弹、近防炮
--   · 电脑罗盘放在计分栏左侧或下方，触屏只在面板显示航向；琥珀色小三角是炮管（坦克）/ 舰首（舰艇）的朝向
--   · 中间：镜头看的地方一个小圈；炮现在指的地方一个准星——坦克、舰艇两套不一样（用户 11-19：参考 MWT 和《现代战舰》）：
--     坦克（MWT）：四段弧 + 三道刻度 + 中心点，装填时弧顺时针一段段亮；颜色 = 打不打得穿（照服务器的跳弹算法：绿可击穿、黄可能跳弹、
--       红会跳弹 / 打不穿），下面写出来；右边测距、左边装填秒数；炮塔还没转过来时一个小箭头指着镜头准心
--     舰艇（《现代战舰》）：主炮落点一个细的大圈、四根长线（横线有刻度）、中间菱形，外圈 40 段装填；距离、炮弹飞多久、炮名；
--       瞄着的敌人上方目标卡（名字、距离、血条）和提前量（它照现在的航速、炮弹落下时开到哪）；导弹：四个角框住，锁定中琥珀、已锁定红
--   · 四周一圈很淡的暗角；开炮：瞄准圈一涨一缩、画面一亮
local VehHud = {}

function VehHud.init(G)
  local Players = game:GetService("Players")
  local GuiService = game:GetService("GuiService")
  local Lighting = game:GetService("Lighting")
  local RS = game:GetService("ReplicatedStorage")
  local UIS = game:GetService("UserInputService")
  local V2, V3, UD2, UD = Vector2.new, Vector3.new, UDim2.new, UDim.new
  local RGB = Color3.fromRGB
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local VD = require(RS:WaitForChild("VehDefs"))
  local SD = require(RS:WaitForChild("ShipDefs"))
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local reducedMotion = false
  pcall(function()
    local function updateMotion() reducedMotion = GuiService.ReducedMotionEnabled end
    updateMotion()
    GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(updateMotion)
  end)

  local TH = G.Theme   -- 统一外观（docs/style.md）
  local INK, TXT, MUTE = TH.C.BG, TH.C.TEXT, TH.C.MUTE
  local AMBER, OK, BAD, CYAN = TH.C.WARN, TH.C.GOOD, TH.C.BAD, TH.C.HUD
  local MONO, BOLD, MED = Enum.Font.RobotoMono, Enum.Font.BuilderSansMedium, Enum.Font.BuilderSans
  local WHITE = Color3.new(1, 1, 1)

  local function frame(parent, size, pos, color, alpha, anchor)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.AnchorPoint = size, pos or UD2(), anchor or V2()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = color or INK, alpha or 0, 0
    f.Parent = parent
    return f
  end
  local function label(parent, text, size, pos, ts, color, font, anchor, align)
    local l = Instance.new("TextLabel")
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.BackgroundTransparency = 1
    l.Text, l.TextSize, l.TextColor3, l.Font = text or "", ts or 14, color or TXT, font or MED
    l.TextXAlignment = align or Enum.TextXAlignment.Center
    l.Parent = parent
    return l
  end
  local function stroke(f, color, th, alpha)
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = color or WHITE, th or 1, alpha or 0.82
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
  end
  local function roundf(f, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = r or UD(0.5, 0)
    c.Parent = f
    return f
  end
  local function grad(f, rot, seq)
    local g = Instance.new("UIGradient")
    g.Rotation = rot
    g.Transparency = seq
    g.Parent = f
    return g
  end
  local function nseq(...)
    local a, kp = { ... }, {}
    for i = 1, #a, 2 do kp[#kp + 1] = NumberSequenceKeypoint.new(a[i], a[i + 1]) end
    return NumberSequence.new(kp)
  end
  local LEFT, RIGHT = Enum.TextXAlignment.Left, Enum.TextXAlignment.Right
  -- 面板：深色半透明、细白边、左上角刻一道短的亮线
  local function panel(parent, size, pos, anchor)
    local p = frame(parent, size, pos, INK, 0.16, anchor)
    stroke(p, WHITE, 1, 0.86)
    frame(p, UD2(0, 26, 0, 2), UD2(0, -1, 0, -1), TXT, 0.1)
    frame(p, UD2(0, 2, 0, 14), UD2(0, -1, 0, -1), TXT, 0.1)
    return p
  end
  -- 十格血条 + 百分比（左上角 x, y）
  local function hpBlock(p, x, y)
    local o = {}
    o.lab = label(p, "", UD2(0, 70, 0, 14), UD2(0, x, 0, y), 11, MUTE, MED, nil, LEFT)
    o.pct = label(p, "100%", UD2(0, 60, 0, 14), UD2(0, x + 132, 0, y), 12, TXT, MONO, V2(1, 0), RIGHT)
    o.seg = {}
    for i = 1, 10 do o.seg[i] = frame(p, UD2(0, 11, 0, 6), UD2(0, x + (i - 1) * 13.2, 0, y + 18), OK, 0.05) end
    return o
  end
  local function setHp(o, k, col)
    o.pct.Text = string.format("%d%%", math.floor(k * 100 + 0.5))
    o.pct.TextColor3 = col
    for i, s in ipairs(o.seg) do
      local on = k * 10 >= i - 0.5
      s.BackgroundColor3 = on and col or TXT
      s.BackgroundTransparency = on and 0.05 or 0.86
    end
  end
  -- 武器行：n 行（按键、名字、弹药、选中的左边一道琥珀色）
  local function weaponRows(p, n)
    local rows = {}
    for i = 1, n do
      local y = 12 + (i - 1) * 28
      local r = {}
      r.bar = frame(p, UD2(0, 3, 0, 22), UD2(0, 10, 0, y), AMBER, 0)
      r.key = label(p, "", UD2(0, 22, 0, 22), UD2(0, 18, 0, y), 12, TXT, BOLD)
      r.keyStroke = stroke(r.key, WHITE, 1, 0.7)
      r.name = label(p, "", UD2(0, 112, 0, 22), UD2(0, 48, 0, y), 13, TXT, MED, nil, LEFT)
      r.name.TextTruncate = Enum.TextTruncate.AtEnd
      r.ammo = label(p, "", UD2(0, 60, 0, 22), UD2(0, 226, 0, y), 13, TXT, MONO, V2(1, 0), RIGHT)
      r.name.Name, r.ammo.Name = "WName" .. i, "WAmmo" .. i
      rows[i] = r
    end
    return rows
  end
  local function setRow(r, key, name, ammo, sel, empty)
    local vis = name ~= nil
    r.bar.Visible, r.key.Visible, r.name.Visible, r.ammo.Visible = vis and sel, vis and key ~= nil, vis, vis
    if not vis then return end
    r.key.Text = key or ""
    r.name.Text = name
    r.ammo.Text = ammo or ""
    r.name.TextColor3 = sel and TXT or MUTE
    r.ammo.TextColor3 = empty and BAD or (sel and TXT or MUTE)
  end
  -- 装填环：24 颗点 + 中间的字
  local function reloadRing(p, cx, cy)
    local o = { dots = {} }
    o.box = frame(p, UD2(0, 64, 0, 64), UD2(0, cx, 0, cy), INK, 1, V2(0.5, 0.5))
    o.box.Name = "Reload"
    for i = 1, 24 do
      local a = (i - 0.5) / 24 * 2 * math.pi
      o.dots[i] = roundf(frame(o.box, UD2(0, 4, 0, 4), UD2(0.5, math.sin(a) * 27, 0.5, -math.cos(a) * 27), TXT, 0.75, V2(0.5, 0.5)))
    end
    o.txt = label(o.box, "", UD2(0, 60, 0, 20), UD2(0.5, 0, 0.5, -2), 14, OK, BOLD, V2(0.5, 0.5))
    o.txt.Name = "ReloadText"
    o.sub = label(o.box, "", UD2(0, 60, 0, 12), UD2(0.5, 0, 0.5, 13), 9, MUTE, MED, V2(0.5, 0.5))
    return o
  end
  local function setRing(o, relK, ready, left)
    local lit = math.floor(relK * 24 + 0.001)
    for i, d in ipairs(o.dots) do
      d.BackgroundColor3 = ready and OK or (i <= lit and AMBER or TXT)
      d.BackgroundTransparency = ready and 0.1 or (i <= lit and 0.05 or 0.8)
    end
    o.txt.Text = ready and T("vh.ready") or string.format("%.1f", left)
    o.txt.TextColor3 = ready and OK or AMBER
    o.sub.Text = ready and "" or T("vh.reload")
  end
  -- 俯视轮廓的底：一个圈 + 上方两道短线（镜头看的方向）
  local function silBase(p, cx, cy)
    local sil = frame(p, UD2(0, 104, 0, 104), UD2(0, cx, 0, cy), INK, 1, V2(0.5, 0.5))
    sil.Name = "Silhouette"
    stroke(roundf(frame(sil, UD2(1, 0, 1, 0), nil, INK, 1)), WHITE, 1, 0.85)
    for _, a in ipairs({ -32, 32 }) do
      local l = frame(sil, UD2(0, 1, 0, 30), UD2(0.5, math.sin(math.rad(a)) * 22, 0.5, -math.cos(math.rad(a)) * 22), TXT, 0.55, V2(0.5, 1))
      l.Rotation = a
    end
    for i = 0, 11 do   -- 外圈每 30° 一个刻度
      local a = i * 30
      local t = frame(sil, UD2(0, 1, 0, (i % 3 == 0) and 6 or 3), UD2(0.5, math.sin(math.rad(a)) * 50, 0.5, -math.cos(math.rad(a)) * 50), TXT, 0.5, V2(0.5, 0.5))
      t.Rotation = a
    end
    return sil
  end

  local gui = Instance.new("ScreenGui")
  gui.Name = "VehHud"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 6
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")
  G.vehHudOn = true

  for _, e in ipairs({ { UD2(1, 0, 0.16, 0), UD2(0, 0, 0, 0), 90 }, { UD2(1, 0, 0.16, 0), UD2(0, 0, 0.84, 0), 270 },
    { UD2(0.1, 0, 1, 0), UD2(0, 0, 0, 0), 0 }, { UD2(0.1, 0, 1, 0), UD2(0.9, 0, 0, 0), 180 } }) do
    local f = frame(gui, e[1], e[2], RGB(0, 0, 0), 0)
    grad(f, e[3], nseq(0, 0.45, 1, 1))
    f.Name = "Vignette"
  end
  local hud = frame(gui, UD2(1, 0, 1, 0), nil, INK, 1)
  hud.Name = "Panels"
  -- 面板缩放：每块面板自己一个 UIScale（绕自己的锚点缩，贴着角落不动）——原来整层一起缩，小屏幕上面板往左上角跑到屏幕中间
  local ret = frame(gui, UD2(1, 0, 1, 0), nil, INK, 1)
  ret.Name = "Reticles"

  ---------------------------------------------------------------- 坦克：车况、武器
  local TK = {}
  TK.car = panel(hud, UD2(0, 270, 0, 156), UD2(1, -334, 1, -40), V2(1, 1))
  TK.car.Name = "Vehicle"
  TK.name = label(TK.car, "", UD2(1, -20, 0, 18), UD2(0, 12, 0, 8), 14, TXT, MED, nil, LEFT)
  TK.name.Name = "VehName"
  local sil = silBase(TK.car, 60, 94)
  TK.hull = frame(sil, UD2(0, 70, 0, 70), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  TK.hull.Name = "Hull"
  TK.hullStroke = stroke(frame(TK.hull, UD2(0, 26, 0, 50), UD2(0.5, 0, 0.5, 0), RGB(30, 36, 40), 0.15, V2(0.5, 0.5)), OK, 1.5, 0)
  frame(TK.hull, UD2(0, 6, 0, 56), UD2(0.5, -17, 0.5, 0), RGB(200, 206, 204), 0.55, V2(0.5, 0.5))   -- 两条履带
  frame(TK.hull, UD2(0, 6, 0, 56), UD2(0.5, 17, 0.5, 0), RGB(200, 206, 204), 0.55, V2(0.5, 0.5))
  frame(TK.hull, UD2(0, 10, 0, 2), UD2(0.5, 0, 0.5, -27), TXT, 0.2, V2(0.5, 0.5))   -- 车头
  TK.tur = frame(sil, UD2(0, 70, 0, 70), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  TK.tur.Name = "Turret"
  stroke(roundf(frame(TK.tur, UD2(0, 20, 0, 20), UD2(0.5, 0, 0.5, 2), RGB(46, 54, 58), 0.05, V2(0.5, 0.5))), CYAN, 1.5, 0)
  frame(TK.tur, UD2(0, 3, 0, 34), UD2(0.5, 0, 0.5, 0), CYAN, 0, V2(0.5, 1)).Name = "Barrel"
  TK.hp = hpBlock(TK.car, 124, 34)
  TK.spd = label(TK.car, "0", UD2(0, 80, 0, 40), UD2(0, 124, 0, 66), 36, TXT, BOLD, nil, LEFT)
  TK.spd.Name = "Speed"
  label(TK.car, "km/h", UD2(0, 40, 0, 14), UD2(0, 124, 0, 104), 11, MUTE, MED, nil, LEFT)
  local gearBox = frame(TK.car, UD2(0, 30, 0, 30), UD2(1, -46, 0, 72), INK, 0.2)
  stroke(gearBox, WHITE, 1, 0.6)
  TK.gear = label(gearBox, "N", UD2(1, 0, 1, 0), nil, 18, TXT, BOLD)
  TK.gear.Name = "Gear"
  TK.hdg = label(TK.car, "000°", UD2(0, 90, 0, 14), UD2(1, -14, 0, 112), 12, MUTE, MONO, V2(1, 0), RIGHT)
  local thrBg = frame(TK.car, UD2(0, 132, 0, 3), UD2(0, 124, 0, 136), TXT, 0.86)
  TK.thr = frame(thrBg, UD2(0, 0, 1, 0), nil, AMBER, 0)
  TK.arm = panel(hud, UD2(0, 300, 0, 156), UD2(1, -24, 1, -40), V2(1, 1))
  TK.arm.Name = "Weapons"
  TK.rows = weaponRows(TK.arm, 3)
  TK.smoke = label(TK.arm, "", UD2(0, 200, 0, 18), UD2(0, 18, 1, -30), 12, MUTE, MED, nil, LEFT)
  TK.smoke.Name = "Smoke"
  TK.ring = reloadRing(TK.arm, 258, 66)
  -- 坦克的两块面板换成绿色全息（用户 11-19 给的截图那样）：边框、角上的亮线、选中那一行、油门条；血量写「当前 / 满」
  for _, pnl in ipairs({ TK.car, TK.arm }) do
    pnl.BackgroundTransparency = 0.32
    for _, c in ipairs(pnl:GetChildren()) do
      if c:IsA("UIStroke") then c.Color, c.Transparency = CYAN, 0.5
      elseif c:IsA("Frame") and c.BackgroundColor3 == TXT and (c.Size.Y.Offset == 2 or c.Size.X.Offset == 2) then c.BackgroundColor3 = CYAN end
    end
  end
  for _, r in ipairs(TK.rows) do r.bar.BackgroundColor3 = CYAN end
  TK.thr.BackgroundColor3 = CYAN
  TK.hp.pct.Size = UD2(0, 110, 0, 14)

  ---------------------------------------------------------------- 坦克（电脑）：MWT 那套（用户 11-19 又发了一遍截图：「确保我开坦克是这个驾驶 ui」）
  --   右下：车名、绿色的侧面剪影（挨打闪红、血少变黄 / 红）、血量「当前/满」（当前绿色）；最右下：每种武器一个六边形按钮
  --   （弹种缩写 + 炮弹图标，选中的绿色发光）；正下方偏右：烟幕弹的绿色全息图标（X、剩几发）；
  --   准星（下面 placeTank）：镜头准心一个小圈里「+」、左右两道短刻度；准心左边弹药数、下面「已就绪 / 装填」，右边测距；
  --   炮现在指的地方一个「∧」（颜色 = 打不打得穿）。电脑上开坦克时原来右下两块面板、顶上的罗盘收起（触屏照旧用紧凑读数面板）
  local MW = {}
  local HOLO = TH.C.HUD
  MW.root = frame(hud, UD2(1, 0, 1, 0), nil, INK, 1)
  MW.root.Name = "MWT"
  MW.root.Visible = false
  -- 右下一块（自己一个 UIScale，贴着右下角缩放）
  MW.br = frame(MW.root, UD2(0, 460, 0, 124), UD2(1, -18, 1, -14), INK, 1, V2(1, 1))
  MW.br.Name = "MwtVehicle"
  MW.brScale = Instance.new("UIScale")
  MW.brScale.Parent = MW.br
  -- 六边形（尖朝上）：外接圆半径 R——三块转 0 / 60 / 120° 的长方形拼成实心的底（放在 CanvasGroup 里统一调透明，叠的地方不发黑），六条边描边
  local function hexagon(parent, cx, cy, R)
    local o = {}
    o.box = frame(parent, UD2(0, R * 2, 0, R * 2), UD2(0, cx, 0, cy), INK, 1, V2(0.5, 0.5))
    local cg = Instance.new("CanvasGroup")
    cg.Size, cg.BackgroundTransparency = UD2(1, 0, 1, 0), 1
    cg.Parent = o.box
    o.fillGroup = cg
    o.fills = {}
    for i, a in ipairs({ 0, 60, 120 }) do
      local f = frame(cg, UD2(0, R * 1.732, 0, R), UD2(0.5, 0, 0.5, 0), INK, 0, V2(0.5, 0.5))
      f.Rotation = a
      o.fills[i] = f
    end
    o.edges = {}
    for k = 0, 5 do
      local a0, a1 = math.rad(90 + k * 60), math.rad(150 + k * 60)
      local x0, y0, x1, y1 = math.cos(a0) * R, -math.sin(a0) * R, math.cos(a1) * R, -math.sin(a1) * R
      local e = frame(o.box, UD2(0, R + 1, 0, 2), UD2(0.5, (x0 + x1) / 2, 0.5, (y0 + y1) / 2), TXT, 0, V2(0.5, 0.5))
      e.Rotation = math.deg(math.atan2(y1 - y0, x1 - x0))
      o.edges[k + 1] = e
    end
    return o
  end
  -- 炮弹图标：斜着的弹体 + 弹头
  local function shellIcon(parent, cx, cy, len)
    local o = {}
    o.body = roundf(frame(parent, UD2(0, 6, 0, len), UD2(0, cx, 0, cy), TXT, 0, V2(0.5, 0.5)), UD(0, 2))
    o.body.Rotation = 40
    local rad = math.rad(40)
    o.tip = roundf(frame(parent, UD2(0, 6, 0, 8), UD2(0, cx + math.sin(rad) * (len / 2 + 3), 0, cy - math.cos(rad) * (len / 2 + 3)), TXT, 0, V2(0.5, 0.5)))
    o.tip.Rotation = 40
    return o
  end
  MW.hex = {}
  local HEX_R = 32
  for i = 1, 3 do
    local R = HEX_R
    local h = hexagon(MW.br, 460 - R, 124 - R - 2, R)   -- 横着摆在哪：stepTank 按这辆车有几种武器靠右排
    h.box.Name = "Ammo" .. i
    h.icon = shellIcon(h.box, R, R - 4, 22)
    h.key = label(h.box, "", UD2(0, 14, 0, 12), UD2(0.5, -R * 0.5, 0.5, -R * 0.62), 9, MUTE, BOLD)
    h.tag = label(h.box, "", UD2(0, R * 1.6, 0, 10), UD2(0.5, 4, 0.5, R * 0.5), 8, MUTE, BOLD, V2(0.5, 0.5))
    h.tag.Rotation = -20
    MW.hex[i] = h
  end
  -- 车名、剪影、血量（六边形左边）
  MW.veh = frame(MW.br, UD2(0, 190, 0, 112), UD2(0, 0, 0, 6), INK, 1)
  MW.veh.Name = "MwtHull"
  MW.name = label(MW.veh, "", UD2(1, 0, 0, 16), UD2(0, 0, 0, 2), 13, TXT, BOLD)
  MW.name.Name = "VehName"
  MW.name.TextStrokeTransparency = 0.6
  MW.sil = frame(MW.veh, UD2(0, 170, 0, 50), UD2(0.5, 0, 0, 24), INK, 1, V2(0.5, 0))
  MW.sil.Name = "Silhouette"
  MW.silParts = {}
  -- 侧面剪影（炮口朝右）：负重轮那一条、车体、首上斜面、炮塔、炮塔尾舱、车长塔、炮管、炮口
  for _, b in ipairs({ { 14, 31, 112, 14, 7, 0 }, { 6, 24, 124, 10, 2, 0 }, { 118, 21, 20, 9, 2, -24 }, { 44, 12, 52, 13, 3, 0 },
    { 34, 14, 14, 9, 2, 0 }, { 54, 6, 12, 7, 2, 0 }, { 94, 16, 70, 3, 1, 0 }, { 160, 14, 8, 6, 1, 0 } }) do
    local f = roundf(frame(MW.sil, UD2(0, b[3], 0, b[4]), UD2(0, b[1], 0, b[2]), HOLO, 0.08), UD(0, b[5]))
    f.Rotation = b[6]
    table.insert(MW.silParts, f)
  end
  for i = 0, 5 do   -- 负重轮：深色小圆点压在那一条上
    table.insert(MW.silParts, roundf(frame(MW.sil, UD2(0, 9, 0, 9), UD2(0, 26 + i * 18, 0, 33.5), INK, 0.35)))
  end
  MW.hp = label(MW.veh, "", UD2(1, 0, 0, 18), UD2(0, 0, 0, 80), 14, TXT, BOLD)
  MW.hp.Name = "HullHp"
  MW.hp.RichText = true
  MW.hp.TextStrokeTransparency = 0.6
  -- 正下方偏右：烟幕弹的全息图标
  MW.sm = frame(MW.root, UD2(0, 60, 0, 70), UD2(0.5, 104, 1, -16), INK, 1, V2(0.5, 1))   -- 正下方让给视角图，烟幕弹往右挪
  MW.sm.Visible = false   -- 用户 11-19：烟幕弹也不要显示了（X 键照样放）
  MW.sm.Name = "MwtSmoke"
  MW.smScale = Instance.new("UIScale")
  MW.smScale.Parent = MW.sm
  MW.smCan = roundf(frame(MW.sm, UD2(0, 24, 0, 34), UD2(0.5, 0, 0, 16), INK, 0.6, V2(0.5, 0)), UD(0, 5))
  MW.smCan.Rotation = -16
  MW.smStroke = stroke(MW.smCan, HOLO, 2, 0)
  MW.smCap = frame(MW.smCan, UD2(0, 10, 0, 7), UD2(0.5, 0, 0, -6), HOLO, 0, V2(0.5, 0))
  MW.smPin = frame(MW.smCan, UD2(0, 2, 0, 12), UD2(0.5, 5, 0, -14), HOLO, 0, V2(0.5, 0))
  MW.smWin = frame(MW.smCan, UD2(0, 10, 0, 12), UD2(0.5, 0, 0.5, 2), HOLO, 0.55, V2(0.5, 0.5))
  MW.smTxt = label(MW.sm, "", UD2(1, 20, 0, 12), UD2(0.5, 0, 1, -2), 10, HOLO, BOLD, V2(0.5, 1))
  MW.smTxt.Name = "SmokeLeft"
  MW.smTxt.TextStrokeTransparency = 0.6
  ---------------------------------------------------------------- 3A：抗锯齿的图（HudArt 解的 HudIcons，用户 11-19：「像素感太强，我要 3A 级别的 UI」）
  --   车：原模型正侧面拍的全息图（带柔光晕），按车型换；六边形的底 / 边 / 光晕、炮弹 / 机枪弹、烟幕弹都是 4 倍超采样画的图。
  --   用不了 EditableImage 时（游戏设置 → 安全里没打开 Mesh / Image API）退回上面方块拼的
  local function img(parent, name, size, pos, anchor, color, tr)
    local l = Instance.new("ImageLabel")
    l.Name = name
    l.BackgroundTransparency = 1
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.ImageColor3 = color or WHITE
    l.ImageTransparency = tr or 0
    l.Parent = parent
    return l
  end
  local function art(label, name) return G.hudIconOn ~= nil and G.hudIconOn(label, name) == true end
  MW.icon = img(MW.veh, "HoloIcon", UD2(0, 156, 0, 54), UD2(0.5, 0, 0, 24), V2(0.5, 0), HOLO)
  MW.icon.Visible = false
  for _, h in ipairs(MW.hex) do
    local R2 = HEX_R * 2
    h.iFill = img(h.box, "HexFill", UD2(0, R2, 0, R2 * 80 / 72), UD2(0.5, 0, 0.5, 0), V2(0.5, 0.5), INK, 0.35)
    h.iGlow = img(h.box, "HexGlow", UD2(0, R2, 0, R2 * 80 / 72), UD2(0.5, 0, 0.5, 0), V2(0.5, 0.5), HOLO, 0.15)
    h.iEdge = img(h.box, "HexEdge", UD2(0, R2, 0, R2 * 80 / 72), UD2(0.5, 0, 0.5, 0), V2(0.5, 0.5), MUTE, 0)
    h.iIcon = img(h.box, "AmmoIcon", UD2(0, 30, 0, 30), UD2(0.5, 0, 0.5, -6), V2(0.5, 0.5), MUTE, 0)
    h.art = art(h.iFill, "hexFill") and art(h.iGlow, "hexGlow") and art(h.iEdge, "hexEdge")
    h.iFill.ZIndex, h.iGlow.ZIndex, h.iEdge.ZIndex, h.iIcon.ZIndex = 1, 2, 3, 4
    h.key.ZIndex, h.tag.ZIndex = 5, 5
    h.fillGroup.Visible = not h.art
    for _, e in ipairs(h.edges) do e.Visible = not h.art end
    h.icon.body.Visible, h.icon.tip.Visible = not h.art, not h.art
    h.iFill.Visible, h.iGlow.Visible, h.iEdge.Visible, h.iIcon.Visible = h.art, h.art, h.art, h.art
  end
  -- 正下方中间：视角图（用户 11-19：屏幕下面中心放带着光晕的视角图，照 MWT）——俯视的车：车体按相对镜头的朝向转，
  --   炮塔、炮管按炮塔的朝向转，上方淡淡的两条线是镜头看的方向（视野）；绿色全息，车体外面两圈越来越淡的描边当光晕
  MW.view = frame(MW.root, UD2(0, 100, 0, 100), UD2(0.5, 0, 1, -8), INK, 1, V2(0.5, 1))
  MW.view.Name = "MwtView"
  MW.viewScale = Instance.new("UIScale")
  MW.viewScale.Parent = MW.view
  for _, a in ipairs({ -30, 30 }) do   -- 视野：从车中心往上张开 ±30°（GUI 绕自己的中心转：按中点摆）
    local L = 46
    local r = math.rad(a)
    local ln = frame(MW.view, UD2(0, 1.5, 0, L), UD2(0.5, math.sin(r) * L / 2, 0.5, 2 - math.cos(r) * L / 2), HOLO, 0.35, V2(0.5, 0.5))
    ln.Rotation = a
    grad(ln, 90, nseq(0, 1, 0.3, 0.75, 1, 0.3))   -- 越往外越淡
  end
  -- 视角图的车（用户 11-19：坦克图标有点难看 → 4 倍超采样画的全息图；坦克宽一点、不要履带、四个角直角；不要涂色，就车体边框、炮塔边框、炮管，
  --   剩下都镂空；用很薄的一个个长方形显示爆反，哪块没了就空一块）
  --   车体、炮塔各一个转的框（跟 HudIcons 的 topHull / topTurret 一样大：72 × 120 的图缩成 50 × 84），框里是全息图（用不了 EditableImage 时是
  --   方块拼的轮廓）和这辆车的爆反块（EraMeta：每块从上往下看的位置、朝向；叠在同一处的几层并成一条）；车体框绕车中心转、炮塔框绕座圈转
  local VK, VWD, VHT = 50 / 72, 50, 84
  MW.vHullBox = frame(MW.view, UD2(0, VWD, 0, VHT), UD2(0.5, 0, 0.5, 2), INK, 1, V2(0.5, 0.5))
  MW.vHullBox.Name = "ViewHull"
  MW.vTurBox = frame(MW.view, UD2(0, VWD, 0, VHT), UD2(0.5, 0, 0.5, 2), INK, 1, V2(0.5, 0.5))
  MW.vTurBox.Name = "ViewTurret"
  MW.vHullImg = img(MW.vHullBox, "ViewHullArt", UD2(1, 0, 1, 0), nil, nil, HOLO, 0)
  MW.vTurImg = img(MW.vTurBox, "ViewTurretArt", UD2(1, 0, 1, 0), nil, nil, HOLO, 0)
  MW.vArt = art(MW.vHullImg, "topHull") and art(MW.vTurImg, "topTurret")
  MW.vHullImg.Visible, MW.vTurImg.Visible = MW.vArt, MW.vArt
  MW.vFall = {}   -- 方块拼的（染色用）
  if not MW.vArt then
    local hb = frame(MW.vHullBox, UD2(0, 44 * VK, 0, 90 * VK), UD2(0.5, 0, 69 / 120, 0), HOLO, 1, V2(0.5, 0.5))   -- 直角，只有边框（镂空）
    local tc = roundf(frame(MW.vTurBox, UD2(0, 36 * VK, 0, 34 * VK), UD2(0.5, 0, 0.5, 2 * VK), HOLO, 1, V2(0.5, 0.5)), UD(0, 3))
    local gn = frame(MW.vTurBox, UD2(0, 3, 0, 44 * VK), UD2(0.5, 0, 0.5, -11 * VK), HOLO, 0.05, V2(0.5, 1))
    table.insert(MW.vFall, { f = hb, s = stroke(hb, HOLO, 1.6, 0) })
    table.insert(MW.vFall, { f = tc, s = stroke(tc, HOLO, 1.4, 0) })
    table.insert(MW.vFall, { f = gn })
  end
  -- 爆反块：这辆车 EraMeta 里的每块投到俯视图上（车体的按车体图摆：车宽、车长对上图里车体的半宽 22、半长 45；炮塔上的按座圈摆）
  local TMods = require(RS:WaitForChild("TankMods"))
  MW.era = {}
  local function buildEra(d)
    for _, e in ipairs(MW.era) do e.f:Destroy() end
    MW.era = {}
    local ok, L = pcall(function() return TMods.eraOf and TMods.eraOf(d.id) end)
    if not ok or not L or not L.b then return end
    -- 只画贴了的格（用户 11-22 晚：「坦克要能自己选位置贴爆反」；自己开的车 d 是按改装改过的那份，d.mods.ep 是一格格选的）
    local onCell = TMods.cellsOn and TMods.cellsOn(d.id, d.mods) or {}
    local sx, sz = 22 * VK / ((d.W or 10) / 2), 45 * VK / ((d.L or 20) / 2)   -- 车的格 → 框里的像素
    local tur = L.tur or { 0, 0, 0 }
    local cols, order = {}, {}
    for i, b in ipairs(L.b) do
      if not onCell[i] then b = nil end   -- 这一格没贴
      if b then
      local turret = b[1] == "t"
      local x, z = b[2], b[4]
      local nx, nz = b[5], b[7]
      local ux, uy, uz = b[8], b[9], b[10]
      local vx, vz = b[6] * uz - b[7] * uy, b[5] * uy - b[6] * ux   -- 高的方向 v = n × u（只要水平分量）
      vx, vz = -vx, -vz
      local nl = math.sqrt(nx * nx + nz * nz)
      local tx, tz
      if nl > 0.3 then tx, tz = -nz / nl, nx / nl
      else
        local ul = math.sqrt(ux * ux + uz * uz)
        tx, tz = (ul > 0.1) and ux / ul or 1, (ul > 0.1) and uz / ul or 0
      end
      local len = math.max(math.abs(ux * tx + uz * tz) * b[11], math.abs(vx * tx + vz * tz) * b[12])
      local oct = (nl > 0.3) and math.floor((math.deg(math.atan2(nz, nx)) + 382.5) / 45) % 8 or 9
      local along = math.floor((x * tx + z * tz) / 0.9 + 0.5)
      local key = (turret and "t" or "h") .. oct .. ":" .. along
      local c = cols[key]
      local depth = (nl > 0.3) and (x * nx + z * nz) / nl or 0
      if not c then
        c = { turret = turret, tx = tx, tz = tz, len = len, idx = {}, depth = -1e9 }
        cols[key] = c
        table.insert(order, c)
      end
      table.insert(c.idx, i)
      c.len = math.max(c.len, len)
      if depth > c.depth then   -- 最外面那一层的位置（贴着车体轮廓外边）
        c.depth = depth
        if turret then c.px, c.py = VWD / 2 + (x - tur[1]) * sx, 60 * VK + (z - tur[3]) * sz
        else c.px, c.py = VWD / 2 + x * sx, 69 * VK + z * sz end
        if nl > 0.3 then c.px, c.py = c.px + nx / nl * 1.4, c.py + nz / nl * 1.4 end
      end
      end
    end
    for _, c in ipairs(order) do
      local k = math.abs(c.tx) * sx + math.abs(c.tz) * sz
      local f = frame(c.turret and MW.vTurBox or MW.vHullBox, UD2(0, math.max(2, c.len * k - 1.2), 0, 1.6), UD2(0, c.px, 0, c.py), HOLO, 0, V2(0.5, 0.5))
      f.Rotation = math.deg(math.atan2(c.tz, c.tx))   -- 块和块之间留一道细缝
      f.Name = "Era"
      f.ZIndex = 3
      table.insert(MW.era, { f = f, idx = c.idx })
    end
  end
  G.viewEraBars = function() return MW.era end   -- 测试用
  MW.smImg = img(MW.sm, "SmokeIcon", UD2(0, 46, 0, 52), UD2(0.5, 0, 0, 2), V2(0.5, 0), HOLO, 0)
  MW.smArt = art(MW.smImg, "smoke")
  MW.smImg.Visible = MW.smArt
  MW.smCan.Visible = not MW.smArt
  -- 弹种缩写（六边形里）：主炮穿甲弹 APFSDS、机炮 HEI、机枪 MG、火炮 HE
  local function ammoTag(w)
    if not w then return "" end
    if w.kind == "shell" then return ((w.dmg or 0) >= 300) and "APFSDS" or "HEI" end
    if w.kind == "gun" then return "MG" end
    if w.kind == "arty" then return "HE" end
    return string.upper(string.sub(w.kind or "", 1, 3))
  end

  ---------------------------------------------------------------- 舰艇：舰况、武器
  local SH = {}
  SH.car = panel(hud, UD2(0, 296, 0, 156), UD2(1, -334, 1, -40), V2(1, 1))   -- 比坦克的宽一点：右边放车钟梯子
  SH.car.Name = "Ship"
  SH.name = label(SH.car, "", UD2(1, -20, 0, 18), UD2(0, 12, 0, 8), 14, TXT, MED, nil, LEFT)
  SH.name.Name = "ShipName"
  local ssil = silBase(SH.car, 60, 94)
  SH.hull = frame(ssil, UD2(0, 90, 0, 90), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SH.hull.Name = "Hull"
  SH.body = frame(SH.hull, UD2(0, 12, 0, 70), UD2(0.5, 0, 0.5, 4), RGB(30, 36, 40), 0.15, V2(0.5, 0.5))
  SH.bodyStroke = stroke(SH.body, OK, 1.5, 0)
  SH.bow = frame(SH.hull, UD2(0, 9, 0, 9), UD2(0.5, 0, 0.5, -31), RGB(30, 36, 40), 0.15, V2(0.5, 0.5))   -- 舰首：转 45° 的小方块
  SH.bow.Rotation = 45
  SH.bowStroke = stroke(SH.bow, OK, 1.5, 0)
  SH.turrets = {}
  SH.hp = hpBlock(SH.car, 124, 34)
  SH.kn = label(SH.car, "0", UD2(0, 70, 0, 40), UD2(0, 124, 0, 62), 36, TXT, BOLD, nil, LEFT)
  SH.kn.Name = "Knots"
  label(SH.car, "kn", UD2(0, 20, 0, 14), UD2(0, 124, 0, 100), 11, MUTE, MED, nil, LEFT)
  SH.order = label(SH.car, "", UD2(0, 90, 0, 14), UD2(0, 150, 0, 100), 11, AMBER, MED, nil, LEFT)
  SH.order.Name = "Order"
  -- 车钟梯子：−2 … 5 八格（上面是前进），亮的是现在这一档；「停」那一格白框
  SH.ladder = {}
  for o = -2, 5 do
    local y = 34 + (5 - o) * 11
    local c = frame(SH.car, UD2(0, 18, 0, 8), UD2(1, -30, 0, y), TXT, 0.85)
    if o == 0 then stroke(c, WHITE, 1, 0.3) end
    SH.ladder[o] = c
  end
  -- 舵角条：左右 35°
  local rBg = frame(SH.car, UD2(0, 132, 0, 3), UD2(0, 124, 0, 136), TXT, 0.86)
  frame(rBg, UD2(0, 1, 0, 9), UD2(0.5, 0, 0.5, 0), TXT, 0.3, V2(0.5, 0.5))
  SH.rud = frame(rBg, UD2(0, 4, 0, 11), UD2(0.5, 0, 0.5, 0), AMBER, 0, V2(0.5, 0.5))
  SH.rud.Name = "Rudder"
  SH.rudTxt = label(SH.car, "", UD2(0, 90, 0, 14), UD2(0, 124, 0, 118), 11, MUTE, MED, nil, LEFT)
  SH.hdg = label(SH.car, "", UD2(0, 70, 0, 14), UD2(1, -38, 0, 118), 11, MUTE, MONO, V2(1, 0), RIGHT)
  SH.arm = panel(hud, UD2(0, 300, 0, 156), UD2(1, -24, 1, -40), V2(1, 1))
  SH.arm.Name = "ShipWeapons"
  SH.rows = weaponRows(SH.arm, 4)
  SH.ring = reloadRing(SH.arm, 258, 66)
  SH.def = nil

  -- 小屏读数单独排版，避免把固定面板的字一起缩小。
  local MS = {}
  MS.box = panel(hud, UD2(0, 330, 0, 72), nil)
  MS.box.Name = "CompactInstruments"
  MS.box.Visible = false
  MS.speed = label(MS.box, "", UD2(0, 90, 0, 28), UD2(0, 10, 0, 3), 20, TXT, BOLD, nil, LEFT)
  MS.motion = label(MS.box, "", UD2(0, 90, 0, 16), UD2(0, 10, 0, 32), 12, TXT, MED, nil, LEFT)
  MS.heading = label(MS.box, "", UD2(0, 90, 0, 14), UD2(0, 10, 0, 50), 11, MUTE, MONO, nil, LEFT)
  MS.split = frame(MS.box, UD2(0, 1, 1, -16), nil, TXT, 0.82)
  MS.selection = label(MS.box, "", UD2(), nil, 13, TXT, BOLD, nil, LEFT)
  MS.count = label(MS.box, "", UD2(), nil, 12, TXT, MONO, nil, LEFT)
  MS.status = label(MS.box, "", UD2(0, 54, 0, 16), UD2(1, -8, 0, 24), 12, OK, BOLD, V2(1, 0), RIGHT)
  MS.health = label(MS.box, "", UD2(), nil, 11, MUTE, MED, nil, LEFT)
  MS.track = frame(MS.box, UD2(), nil, TXT, 0.82)
  MS.fill = frame(MS.track, UD2(0, 0, 1, 0), nil, OK, 0)
  MS.speed.Name, MS.motion.Name, MS.heading.Name = "Speed", "DriveState", "Heading"
  MS.selection.Name, MS.status.Name, MS.health.Name = "Selection", "Readiness", "Hull"
  MS.count.Name = "Ammo"
  for _, l in ipairs({ MS.speed, MS.motion, MS.selection, MS.count, MS.health }) do
    l.TextTruncate = Enum.TextTruncate.AtEnd
  end

  local function updateCompact(name, speed, motion, heading, hp, k, col, row, relK, ready, left)
    if not MS.box.Visible then return end
    local selected = row and row.name.Visible
    MS.speed.Text, MS.motion.Text, MS.heading.Text = speed, motion, heading
    MS.selection.Text = selected and row.name.Text or name
    MS.count.Text = selected and (string.gsub(row.ammo.Text, " / ", "/")) or ""
    MS.count.TextColor3 = selected and row.ammo.TextColor3 or TXT
    MS.status.Text = selected and (ready and T("vh.ready") or string.format("%.1fs", left)) or ""
    MS.status.TextColor3 = ready and OK or AMBER
    MS.health.Text, MS.health.TextColor3 = hp .. "  " .. string.format("%d%%", math.floor(k * 100 + 0.5)), col
    MS.track.Visible = selected == true
    MS.fill.BackgroundColor3 = ready and OK or AMBER
    MS.fill.Size = UD2(relK, 0, 1, 0)
  end

  local function buildShip(d)   -- 换船了：舰体长宽、炮塔的位置
    SH.def = d
    for _, t in ipairs(SH.turrets) do t.box:Destroy() end
    SH.turrets = {}
    local L, Wd = d.L or 200, d.W or 30
    local len = 70
    local wid = math.clamp(len * Wd / L * 1.6, 8, 22)   -- 窄长的舰体看着太细：宽度放大一点
    SH.body.Size = UD2(0, wid, 0, len)
    SH.bow.Size = UD2(0, wid * 0.72, 0, wid * 0.72)
    SH.bow.Position = UD2(0.5, 0, 0.5, 4 - len / 2)
    for gi, g in ipairs(d.guns or {}) do
      local z = g.pos and g.pos.Z or 0
      local x = g.pos and g.pos.X or 0
      local box = frame(SH.hull, UD2(0, 30, 0, 30), UD2(0.5, x / Wd * wid, 0.5, 4 + z / L * len), INK, 1, V2(0.5, 0.5))
      stroke(roundf(frame(box, UD2(0, 7, 0, 7), UD2(0.5, 0, 0.5, 0), RGB(46, 54, 58), 0, V2(0.5, 0.5))), CYAN, 1.2, 0)
      frame(box, UD2(0, 2, 0, 12), UD2(0.5, 0, 0.5, 0), CYAN, 0, V2(0.5, 1))
      SH.turrets[gi] = { box = box }
    end
  end

  ---------------------------------------------------------------- 顶上：罗盘（坦克、舰艇共用）
  local compGroup = frame(hud, UD2(0, 560, 0, 51), nil, INK, 1)
  compGroup.Name = "Compass"
  local comp = frame(compGroup, UD2(1, 0, 0, 38), nil, INK, 1)
  comp.ClipsDescendants = true
  local compBg = frame(comp, UD2(1, 0, 0, 22), UD2(0, 0, 0, 0), INK, 0.55)
  grad(compBg, 0, nseq(0, 1, 0.18, 0.45, 0.82, 0.45, 1, 1))
  local PX, CW = 4, 560   -- 每度几个像素、罗盘宽
  local ticks = {}
  for i = 1, 40 do
    ticks[i] = { t = frame(comp, UD2(0, 1, 0, 6), UD2(0, 0, 0, 0), TXT, 0.35), l = label(comp, "", UD2(0, 30, 0, 14), UD2(0, 0, 0, 7), 11, TXT, MONO, V2(0.5, 0)) }
  end
  label(compGroup, "▼", UD2(0, 16, 0, 12), UD2(0.5, 0, 0, 18), 11, TXT, BOLD, V2(0.5, 0))
  local compHdg = label(compGroup, "000", UD2(0, 60, 0, 18), UD2(0.5, 0, 0, 32), 15, TXT, MONO, V2(0.5, 0))
  compHdg.Name = "Heading"
  local compMark = label(comp, "▲", UD2(0, 14, 0, 10), UD2(0.5, 0, 0, 24), 10, AMBER, BOLD, V2(0.5, 0))
  compMark.Name = "MarkHeading"
  local DIR = { [0] = "N", [45] = "NE", [90] = "E", [135] = "SE", [180] = "S", [225] = "SW", [270] = "W", [315] = "NW" }
  local function deg360(r) return (math.deg(r) % 360 + 360) % 360 end
  local function hdgOf(yaw) return (360 - deg360(yaw or 0)) % 360 end   -- 偏航（逆时针、从 −Z 起）→ 航向（顺时针从北）
  -- 11-27 M3 丝滑：镜头没转就不重摆；转了只挪刻度的位置，刻度长短、字只在换了一格（5°）时重写（原来每帧 40 格 × 5 个属性）。
  --   罗盘宽 CW 也算在里面（layoutPanels 跟着窗口宽度改它：舵回正直行、鼠标不动时切全屏，刻度和 ▲ 原来还按旧宽度摆，跟居中的 ▼ 对不上）
  local cmpCam, cmpMark, cmpFirst, cmpW = nil, nil, nil, nil
  local function stepCompass(camHdg, markHdg)
    if not compGroup.Visible then cmpCam = nil return end
    if camHdg == cmpCam and markHdg == cmpMark and CW == cmpW then return end
    if CW ~= cmpW then cmpFirst = nil end
    cmpCam, cmpMark, cmpW = camHdg, markHdg, CW
    local first = math.floor((camHdg - CW / 2 / PX) / 5) * 5
    local relabel = first ~= cmpFirst
    cmpFirst = first
    for i, tk in ipairs(ticks) do
      local a = first + (i - 1) * 5
      local x = CW / 2 + (a - camHdg) * PX
      tk.t.Position = UD2(0, x, 0, 0)
      tk.l.Position = UD2(0, x, 0, 8)
      if relabel then
        local aa = a % 360
        local major = aa % 15 == 0
        tk.t.Size = UD2(0, 1, 0, major and 8 or 4)
        tk.l.Text = major and (DIR[aa] or string.format("%03d", aa)) or ""
        tk.l.TextColor3 = DIR[aa] and TXT or MUTE
      end
    end
    compHdg.Text = string.format("%03d", math.floor(camHdg + 0.5) % 360)
    local dg = (markHdg - camHdg + 540) % 360 - 180
    compMark.Position = UD2(0, CW / 2 + math.clamp(dg, -CW / 2 / PX, CW / 2 / PX) * PX, 0, 24)
  end
  -- 测试用：直接走一拍罗盘、看罗盘宽和刻度、▲ 摆在哪；setCW 照 layoutPanels 换罗盘宽（模拟器的窗口大小改不了）
  G.vehCompass = { group = compGroup, step = function(h, m) stepCompass(h, m) end,
    setCW = function(w) CW = w compGroup.Size = UD2(0, CW, 0, 51) end,
    state = function() return { cw = CW, px = PX, ticks = ticks, mark = compMark.Position.X.Offset } end }

  ---------------------------------------------------------------- 中间：准星——坦克照 MWT（现代战争坦克）、舰艇照《现代战舰》，两套样子
  --   用户 11-19：「船、坦克的准心可以不一样，参考 MWT 和现代战舰」
  local camAim = roundf(frame(ret, UD2(0, 14, 0, 14), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5)))
  stroke(camAim, WHITE, 1.5, 0.35)
  camAim.Name = "CamAim"
  local Config = require(RS:WaitForChild("Config"))
  -- 圆上一圈小短条（Roblox 没有弧线）：from / to 度数（0 正上、顺时针），每条切着圆
  local function arcSegs(parent, n, r, w, h, from, to, col)
    local segs = {}
    for i = 1, n do
      local a = from + (to - from) * (i - 0.5) / n
      local rad = math.rad(a)
      local sg0 = frame(parent, UD2(0, w, 0, h), UD2(0.5, math.sin(rad) * r, 0.5, -math.cos(rad) * r), col or TXT, 0, V2(0.5, 0.5))
      sg0.Rotation = a
      segs[i] = sg0
    end
    return segs
  end
  local PEN_OK, PEN_MAYBE, PEN_NO = TH.C.GOOD, TH.C.WARN, TH.C.BAD   -- 能击穿：黄绿（界面整体改成绿以后，跟没瞄着车的绿分得开）

  -- 坦克（MWT）：四段弧（对角留缺口）围着炮指的点，装填时顺时针一段段亮起来；弧的颜色 = 打不打得穿（绿 / 黄 / 红，没瞄着车是白的）；
  --   左、右、下三道刻度，中心一个点；下面一行「可击穿 / 可能跳弹 / 跳弹 / 打不穿」，右边测距、左边装填秒数
  local mwtOn = false   -- 电脑上开坦克：MWT 那套（帧函数里按 compact 定）
  local wtMode = false  -- 电脑上开坦克：战雷那套（WtTank.lua，用户 11-24 夜「把整个游戏做成战雷」）——有它就不画 MWT 那套
  local TR = {}
  TR.root = frame(ret, UD2(0, 120, 0, 120), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  TR.root.Name = "TankReticle"
  TR.scale = Instance.new("UIScale")
  TR.scale.Parent = TR.root
  TR.segs = {}
  for q = 0, 3 do
    for _, sgx in ipairs(arcSegs(TR.root, 9, 22, 3.4, 2, q * 90 - 33, q * 90 + 33)) do table.insert(TR.segs, sgx) end
  end
  TR.ticks = {}
  for _, a in ipairs({ 90, 180, 270 }) do
    local rad = math.rad(a)
    local tk = frame(TR.root, UD2(0, 2, 0, 9), UD2(0.5, math.sin(rad) * 32, 0.5, -math.cos(rad) * 32), TXT, 0, V2(0.5, 0.5))
    tk.Rotation = a
    table.insert(TR.ticks, tk)
  end
  TR.dot = roundf(frame(TR.root, UD2(0, 3, 0, 3), UD2(0.5, 0, 0.5, 0), TXT, 0, V2(0.5, 0.5)))
  TR.pen = label(TR.root, "", UD2(0, 160, 0, 14), UD2(0.5, 0, 0.5, 46), 12, TXT, BOLD, V2(0.5, 0.5))
  TR.pen.Name = "PenState"
  TR.pen.TextStrokeTransparency = 0.55
  TR.rng = label(TR.root, "", UD2(0, 80, 0, 14), UD2(0.5, 42, 0.5, 0), 12, TXT, MONO, V2(0, 0.5), LEFT)
  TR.rng.Name = "Range"
  TR.rng.TextStrokeTransparency = 0.6
  TR.rel = label(TR.root, "", UD2(0, 60, 0, 14), UD2(0.5, -42, 0.5, 0), 12, AMBER, MONO, V2(1, 0.5), RIGHT)
  TR.rel.Name = "ReloadLeft"
  TR.rel.TextStrokeTransparency = 0.6
  TR.rel.Visible = false   -- 用户 11-19（截图）：左边改成弹药数 + 状态（下面两行）
  -- 准星左边：弹药数（大）、状态（已就绪 / 装填 x.x 秒）；绿色全息（用户 11-19 给的手机坦克游戏截图那样）
  TR.ammo = label(TR.root, "", UD2(0, 90, 0, 22), UD2(0.5, -46, 0.5, -9), 20, TXT, MONO, V2(1, 0.5), RIGHT)
  TR.ammo.Name = "AmmoLeft"
  TR.ammo.TextStrokeTransparency = 0.55
  TR.state = label(TR.root, "", UD2(0, 110, 0, 16), UD2(0.5, -46, 0.5, 11), 13, CYAN, BOLD, V2(1, 0.5), RIGHT)
  TR.state.Name = "ReadyState"
  TR.state.TextStrokeTransparency = 0.6
  TR.chev = {   -- MWT：炮指的地方一个「∧」（两道斜线，顶点在这一点上方一点）
    frame(TR.root, UD2(0, 11, 0, 2), UD2(0.5, -3.6, 0.5, 2.2), TXT, 0, V2(0.5, 0.5)),
    frame(TR.root, UD2(0, 11, 0, 2), UD2(0.5, 3.6, 0.5, 2.2), TXT, 0, V2(0.5, 0.5)),
  }
  TR.chev[1].Rotation, TR.chev[2].Rotation = -52, 52
  do   -- 有抗锯齿的图就用图（转了角度的细方块边缘有锯齿）
    local l = Instance.new("ImageLabel")
    l.Name = "Chevron"
    l.BackgroundTransparency = 1
    l.Size, l.Position, l.AnchorPoint = UD2(0, 24, 0, 16), UD2(0.5, 0, 0.5, 1), V2(0.5, 0.5)
    l.Parent = TR.root
    if G.hudIconOn and G.hudIconOn(l, "chevron") then TR.chevImg = l else l:Destroy() end
  end
  local lagArrow = label(ret, "▶", UD2(0, 16, 0, 16), UD2(0, 0, 0, 0), 13, AMBER, BOLD, V2(0.5, 0.5))
  lagArrow.Name = "TurretLag"
  -- MWT（电脑开坦克）：镜头准心小圈里一个「+」、左右两道短刻度；准心左边弹药数（前面一颗小炮弹）、下面「已就绪 / 装填」，右边测距；
  --   炮现在指的地方一个「∧」（TR.root 的位置，颜色 = 打不打得穿）。触屏照旧用上面那套
  local MR = {}
  MR.plus = {
    frame(camAim, UD2(0, 8, 0, 1.5), UD2(0.5, 0, 0.5, 0), WHITE, 0.15, V2(0.5, 0.5)),
    frame(camAim, UD2(0, 1.5, 0, 8), UD2(0.5, 0, 0.5, 0), WHITE, 0.15, V2(0.5, 0.5)),
  }
  MR.ticks = {
    frame(ret, UD2(0, 2, 0, 8), UD2(0.5, -54, 0.5, 0), WHITE, 0.3, V2(0.5, 0.5)),
    frame(ret, UD2(0, 2, 0, 8), UD2(0.5, 54, 0.5, 0), WHITE, 0.3, V2(0.5, 0.5)),
  }
  -- 字号照 MWT 截图（用户 11-19：文字精简一下、小一点）：弹药数、测距 14，已就绪 15
  MR.ammo = label(ret, "", UD2(0, 80, 0, 18), UD2(0.5, -70, 0.5, -12), 14, TXT, BOLD, V2(1, 0.5), RIGHT)
  MR.ammo.Name = "MwtAmmo"
  MR.ammo.TextStrokeTransparency = 0.55
  MR.bullet = roundf(frame(ret, UD2(0, 3, 0, 9), UD2(0.5, -110, 0.5, -12), TXT, 0.05, V2(0.5, 0.5)), UD(0, 2))   -- 弹药数前面的小炮弹（stepTank 按位数挪）
  MR.state = label(ret, "", UD2(0, 120, 0, 18), UD2(0.5, -70, 0.5, 7), 15, CYAN, BOLD, V2(1, 0.5), RIGHT)
  MR.state.Name = "MwtState"
  MR.state.TextStrokeTransparency = 0.55
  MR.rng = label(ret, "", UD2(0, 100, 0, 18), UD2(0.5, 76, 0.5, -12), 14, TXT, BOLD, V2(0, 0.5), LEFT)
  MR.rng.Name = "MwtRange"
  MR.rng.TextStrokeTransparency = 0.55
  do
    local l = Instance.new("ImageLabel")
    l.Name = "BulletIcon"
    l.BackgroundTransparency = 1
    l.Size, l.Position, l.AnchorPoint = UD2(0, 5, 0, 12), MR.bullet.Position, V2(0.5, 0.5)
    l.ImageColor3 = TXT
    l.Parent = ret
    if G.hudIconOn and G.hudIconOn(l, "bullet") then
      MR.bullet:Destroy()
      MR.bullet = l
    else l:Destroy() end
  end
  MR.all = { MR.ticks[1], MR.ticks[2], MR.ammo, MR.bullet, MR.state, MR.rng }

  -- 舰艇（《现代战舰》）：主炮落点一个细的大圈、四根长线（横线上有刻度）、中间菱形；外圈 40 段装填；右下距离、炮弹飞多久，左下炮名；
  --   瞄着的敌人：上方一张卡（名字、距离、血条），照它的航速和炮弹飞的时间算提前量（琥珀色小圈 + 一串点连过去）；
  --   导弹：四个角框住目标，刚框上从大往小收，框住琥珀、锁定红，下面写距离和导弹飞过去要多久
  local SR = {}
  SR.root = frame(ret, UD2(0, 240, 0, 240), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SR.root.Name = "ShipReticle"
  SR.scale = Instance.new("UIScale")
  SR.scale.Parent = SR.root
  SR.ring = roundf(frame(SR.root, UD2(0, 76, 0, 76), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5)))
  SR.ringStroke = stroke(SR.ring, CYAN, 1.2, 0.1)
  SR.lines = {}
  for _, e in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
    local hz = e[1] ~= 0
    local L0, L = 46, 40
    table.insert(SR.lines, frame(SR.root, hz and UD2(0, L, 0, 1) or UD2(0, 1, 0, L), UD2(0.5, e[1] * (L0 + L / 2), 0.5, e[2] * (L0 + L / 2)), CYAN, 0.15, V2(0.5, 0.5)))
    if hz then
      for k = 1, 4 do table.insert(SR.lines, frame(SR.root, UD2(0, 1, 0, (k % 2 == 0) and 7 or 4), UD2(0.5, e[1] * (L0 + k * 9), 0.5, 0), CYAN, 0.2, V2(0.5, 0.5))) end
    end
  end
  SR.dia = frame(SR.root, UD2(0, 9, 0, 9), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SR.dia.Rotation = 45
  SR.diaStroke = stroke(SR.dia, WHITE, 1.5, 0)
  frame(SR.root, UD2(0, 2, 0, 2), UD2(0.5, 0, 0.5, 0), WHITE, 0, V2(0.5, 0.5))
  SR.segs = arcSegs(SR.root, 40, 47, 5.4, 2, 0, 360, CYAN)
  SR.rng = label(SR.root, "", UD2(0, 90, 0, 14), UD2(0.5, 50, 0.5, 30), 12, TXT, MONO, V2(0, 0.5), LEFT)
  SR.rng.Name = "Range"
  SR.tof = label(SR.root, "", UD2(0, 90, 0, 14), UD2(0.5, 50, 0.5, 44), 11, CYAN, MONO, V2(0, 0.5), LEFT)
  SR.tof.Name = "FlightTime"
  SR.wpn = label(SR.root, "", UD2(0, 120, 0, 14), UD2(0.5, -50, 0.5, 30), 11, MUTE, MED, V2(1, 0.5), RIGHT)
  for _, l in ipairs({ SR.rng, SR.tof, SR.wpn }) do l.TextStrokeTransparency = 0.6 end
  SR.lead = roundf(frame(ret, UD2(0, 14, 0, 14), nil, INK, 1, V2(0.5, 0.5)))
  SR.lead.Name = "LeadMark"
  stroke(SR.lead, AMBER, 1.6, 0)
  SR.leadDots = {}
  for i = 1, 6 do SR.leadDots[i] = roundf(frame(ret, UD2(0, 3, 0, 3), nil, AMBER, 0.25, V2(0.5, 0.5))) end
  SR.card = frame(ret, UD2(0, 160, 0, 30), nil, INK, 1, V2(0.5, 1))
  SR.card.Name = "TargetCard"
  SR.cardName = label(SR.card, "", UD2(1, 0, 0, 14), UD2(0, 0, 0, 0), 12, TXT, BOLD)
  SR.cardName.TextStrokeTransparency = 0.55
  SR.cardBg = frame(SR.card, UD2(0, 110, 0, 4), UD2(0.5, 0, 0, 18), INK, 0.35, V2(0.5, 0))
  SR.cardHp = frame(SR.cardBg, UD2(1, 0, 1, 0), nil, BAD, 0)
  SR.lock = frame(ret, UD2(0, 60, 0, 60), nil, INK, 1, V2(0.5, 0.5))
  SR.lock.Name = "MissileLock"
  SR.corners = {}
  for _, c in ipairs({ { 0, 0 }, { 1, 0 }, { 0, 1 }, { 1, 1 } }) do
    local h = frame(SR.lock, UD2(0, 14, 0, 2), UD2(c[1], 0, c[2], 0), PEN_MAYBE, 0, V2(c[1], c[2]))
    local v = frame(SR.lock, UD2(0, 2, 0, 14), UD2(c[1], 0, c[2], 0), PEN_MAYBE, 0, V2(c[1], c[2]))
    table.insert(SR.corners, h)
    table.insert(SR.corners, v)
  end
  SR.lockTxt = label(ret, "", UD2(0, 260, 0, 16), nil, 12, PEN_MAYBE, BOLD, V2(0.5, 0))
  SR.lockTxt.Name = "LockText"
  SR.lockTxt.TextStrokeTransparency = 0.5

  local fireCC = Instance.new("ColorCorrectionEffect")
  fireCC.Name = "VehFireFlash"
  fireCC.Brightness = 0
  fireCC.Enabled = false   -- 只在开炮那一亮时开着（11-27：亮度 0 也开着是白画一遍全屏后期）
  fireCC.Parent = Lighting
  local function setFlash(b)
    if fireCC.Brightness ~= b then fireCC.Brightness = b end
    local on = b > 1e-4
    if fireCC.Enabled ~= on then fireCC.Enabled = on end
  end
  local kickT = -9

  ---------------------------------------------------------------- 瞄着谁：实体（workspace.Ents 下的模型）、它的航速
  local rayP = RaycastParams.new()
  rayP.FilterType = Enum.RaycastFilterType.Exclude
  local function entOf(inst)
    local ents = workspace:FindFirstChild("Ents")
    while inst and inst.Parent and inst.Parent ~= ents do inst = inst.Parent end
    return (inst and inst.Parent == ents) and inst or nil
  end
  local vel = setmetatable({}, { __mode = "k" })   -- [实体模型] = { p 上次位置, t 时间, v 平滑后的速度 }
  local function velOf(em)
    local r = em:FindFirstChild("Root")
    if not r then return V3(0, 0, 0) end
    local p, t = r.CFrame.Position, os.clock()
    local s = vel[em]
    if not s then
      vel[em] = { p = p, t = t, v = V3(0, 0, 0) }
      return V3(0, 0, 0)
    end
    local dt = t - s.t
    if dt > 0.05 then
      local raw = (p - s.p) / dt
      if raw.Magnitude > 600 then raw = s.v end   -- 瞬移（重生、拉回）不算
      s.v = s.v:Lerp(raw, math.min(1, dt * 4))
      s.p, s.t = p, t
    end
    return s.v
  end
  local function enemyEnt(em)
    if not em or em:GetAttribute("Wreck") or (em:GetAttribute("Hp") or 1) <= 0 then return false end
    local tm = em:GetAttribute("Team")
    return tm ~= nil and tm ~= me:GetAttribute("Side")
  end
  -- 屏幕上离 (x, y) 最近的敌方水面目标 / 地面车辆（R 像素以内）
  local nearT, nearEm = 0, nil
  local function enemyNear(x, y, R)
    if os.clock() - nearT < 0.12 then return nearEm end
    nearT, nearEm = os.clock(), nil
    local ents = workspace:FindFirstChild("Ents")
    local best = R
    for _, em in ipairs(ents and ents:GetChildren() or {}) do
      local cat = em:GetAttribute("Cat")
      if (cat == "ship" or cat == "armor" or cat == "light") and enemyEnt(em) then
        local r = em:FindFirstChild("Root")
        if r then
          local sp, on = cam:WorldToViewportPoint(r.CFrame.Position)
          if on then
            local dd = (V2(sp.X, sp.Y) - V2(x, y)).Magnitude
            if dd < best then best, nearEm = dd, em end
          end
        end
      end
    end
    return nearEm
  end

  -- 坦克炮打过去打不打得穿：照服务器（Ents.lua）的跳弹算法——入射方向和装甲面法线的夹角、目标是重甲（armor）还是轻甲（light）
  --   返回 颜色、字（没瞄着敌方车辆返回 nil）
  local function penState(w, o, p, own)
    local dir = p - o
    if dir.Magnitude < 1 then return nil end
    local ex = { own }
    if me.Character then table.insert(ex, me.Character) end
    if G.viewFolder then table.insert(ex, G.viewFolder) end
    rayP.FilterDescendantsInstances = ex
    local res = workspace:Raycast(o, dir.Unit * (dir.Magnitude + 6), rayP)
    local em = res and entOf(res.Instance)
    if not em or not enemyEnt(em) then return nil end
    local cat = em:GetAttribute("Cat")
    local RIC = Config.Ricochet
    local k = (w.vs and w.vs[cat]) or 1
    if k < 0.35 then return PEN_NO, T("vh.penNo") end   -- 机枪、小口径打重甲
    if w.kind ~= "shell" or not (RIC and RIC.a0[cat]) then return PEN_OK, T("vh.penOk") end
    local ang = math.deg(math.acos(math.clamp(math.abs(dir.Unit:Dot(res.Normal)), 0, 1)))
    local pr = math.clamp((ang - RIC.a0[cat]) / math.max(1, RIC.a1[cat] - RIC.a0[cat]), 0, 1)
    if pr >= 0.75 then return PEN_NO, T("vh.penRic") end
    if pr > 0.04 or ang > RIC.a0[cat] - 6 then return PEN_MAYBE, T("vh.penMaybe", math.floor(pr * 100 + 0.5)) end
    return (k < 0.7) and PEN_MAYBE or PEN_OK, T((k < 0.7) and "vh.penWeak" or "vh.penOk")
  end

  -- 坦克的准星摆到屏幕上：p 炮指着的点、o 炮口、relK / ready / left 装填、pen 颜色和字
  local function placeTank(p, o, relK, ready, left, lag, penC, penT, ammoTxt)
    SR.root.Visible, SR.lead.Visible, SR.card.Visible, SR.lock.Visible, SR.lockTxt.Visible = false, false, false, false, false
    for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
    local sp, on = cam:WorldToViewportPoint(p)
    local vp = cam.ViewportSize
    TR.root.Visible = on
    local kick = reducedMotion and 0 or math.clamp(1 - (os.clock() - kickT) / 0.35, 0, 1)
    TR.scale.Scale = 1 + 0.4 * kick
    TR.root.Position = UD2(0, sp.X, 0, sp.Y)
    local col = penC or CYAN   -- 没瞄着车：绿色（全息的感觉）
    local lit = ready and #TR.segs or math.floor(relK * #TR.segs + 0.001)
    for i, sgx in ipairs(TR.segs) do
      local onSeg = i <= lit
      sgx.BackgroundColor3 = onSeg and (ready and col or AMBER) or TXT
      sgx.BackgroundTransparency = onSeg and 0.02 or 0.72
    end
    for _, tk in ipairs(TR.ticks) do tk.BackgroundColor3 = col end
    TR.dot.BackgroundColor3 = col
    TR.pen.Text = penT or ""
    TR.pen.TextColor3 = col
    TR.rng.Text = T("vh.m", math.floor((p - o).Magnitude / 2.8 / 5 + 0.5) * 5)
    TR.rel.Text = ready and "" or string.format("%.1f", left)
    TR.ammo.Text = ammoTxt or ""
    TR.state.Text = ready and T("vh.rdy") or T("vh.loading", string.format("%.1f", left))
    TR.state.TextColor3 = ready and CYAN or AMBER
    -- MWT（电脑）：炮指的地方只留「∧」，数字挪到镜头准心两边
    local mw = mwtOn
    for _, sgx in ipairs(TR.segs) do sgx.Visible = not mw end
    for _, tk in ipairs(TR.ticks) do tk.Visible = not mw end
    TR.dot.Visible, TR.pen.Visible, TR.rng.Visible, TR.ammo.Visible, TR.state.Visible = not mw, not mw, not mw, not mw, not mw
    local chevCol = penC or (ready and WHITE or AMBER)
    for _, c in ipairs(TR.chev) do
      c.Visible = mw and TR.chevImg == nil
      c.BackgroundColor3 = chevCol
    end
    if TR.chevImg then
      TR.chevImg.Visible = mw
      TR.chevImg.ImageColor3 = chevCol
    end
    for _, x in ipairs(MR.all) do x.Visible = mw end
    for _, x in ipairs(MR.plus) do x.Visible = mw end
    if mw then
      MR.ammo.Text = ammoTxt or ""
      MR.bullet.Position = UD2(0.5, -70 - #(ammoTxt or "") * 8.5 - 7, 0.5, -12)
      MR.bullet.Visible = (ammoTxt or "") ~= ""
      MR.state.Text = ready and T("vh.rdy") or string.format("%.1fs", left)
      MR.state.TextColor3 = ready and CYAN or AMBER
      MR.rng.Text = TR.rng.Text
    end
    local off = V2(vp.X / 2, vp.Y / 2) - V2(sp.X, sp.Y)
    lagArrow.Visible = lag and on and off.Magnitude > 30
    if lagArrow.Visible then
      local u = off.Unit
      lagArrow.Position = UD2(0, sp.X + u.X * 40, 0, sp.Y + u.Y * 40)
      lagArrow.Rotation = math.deg(math.atan2(u.Y, u.X))
    end
    setFlash(0.12 * kick * kick)
  end
  G.tankPen = penState   -- 测试用

  local function hideReticles()
    TR.root.Visible, SR.root.Visible, lagArrow.Visible = false, false, false
    for _, x in ipairs(MR.all) do x.Visible = false end
    for _, x in ipairs(MR.plus) do x.Visible = false end
    SR.lead.Visible, SR.card.Visible, SR.lock.Visible, SR.lockTxt.Visible = false, false, false, false
    for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
    setFlash(0)
  end

  ---------------------------------------------------------------- 每帧：坦克
  local lastNext, hp0, hurtT = {}, nil, -9
  local function hpColor(em)
    local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
    local k = math.clamp(hp / math.max(mx, 1), 0, 1)
    if hp0 and hp < hp0 - 0.5 then hurtT = os.clock() end
    hp0 = hp
    local col = (k > 0.6) and OK or ((k > 0.3) and AMBER or BAD)
    if os.clock() - hurtT < 0.6 and (reducedMotion or (os.clock() * 10) % 2 < 1) then col = BAD end
    return k, col
  end

  local function stepTank(st)
    local d = st.d
    local vs = G.S and G.S.veh
    -- 老的坦克读数面板（TK）电脑、触屏都不显示（下面每帧设成隐藏：电脑是 MWT 那套、触屏是紧凑面板）——
    --   只留给它们读的几样（车名、车体 / 炮塔转角、车速、档位、航向、选中那一行），其余（血条十格、装填环 24 颗点、弹药行……）
    --   看不见就不写（11-27 M3 丝滑：开坦克每帧少写一百来个界面属性、少拼六七个字符串）
    local tkOn = TK.car.Visible or TK.arm.Visible
    local rowsOn = tkOn or MS.box.Visible   -- 紧凑面板读选中那一行的名字、弹数
    TK.name.Text = T("veh." .. d.id)
    TK.hp.lab.Text = T("vh.hull")
    local k, col = hpColor(st.em)
    if tkOn then
      TK.hullStroke.Color = col
      setHp(TK.hp, k, col)
      TK.hp.pct.Text = string.format("%d / %d", math.floor(st.em:GetAttribute("Hp") or 0), math.floor(st.em:GetAttribute("MaxHp") or 0))
    end
    local camY = math.deg(st.camYaw or 0)
    local hullY = math.deg(st.yaw or 0)
    TK.hull.Rotation = -(hullY - camY)
    TK.tur.Rotation = -(hullY - (st.ty or 0) - camY)
    if tkOn then TK.tur.Visible = d.turret ~= nil end
    TK.spd.Text = string.format("%d", math.floor(math.abs(st.speed or 0) / 2.8 * 3.6 + 0.5))
    local back = (st.speed or 0) < -0.4
    local gn = st.gearN or 0   -- Drive 的变速箱：1～5 档、R、N（战雷那样显示档位数字）
    TK.gear.Text = st.locked and "-" or ((gn >= 1) and tostring(gn) or ((gn <= -1 or back) and ((st.gb and st.gb.nr > 1 and gn <= -1) and ("R" .. tostring(-gn)) or "R") or "N"))   -- 倒挡两档：R1 / R2
    TK.hdg.Text = string.format("%03d°  HDG", math.floor(hdgOf(st.yaw) + 0.5) % 360)
    if tkOn then
      TK.gear.TextColor3 = back and AMBER or TXT
      TK.thr.Size = UD2(math.clamp(math.abs(st.speed or 0) / math.max(d.speed or 1, 1), 0, 1), 0, 1, 0)
    end
    local relK, ready, left = 1, true, 0
    local selAmmo = nil
    for i, r in ipairs(TK.rows) do
      local wid = d.weapons[i]
      if wid then
        local w = VD.W[wid]
        local ammo = vs and vs.ammo and vs.ammo[wid]
        if rowsOn then setRow(r, tostring(i), T("vw." .. wid), ammo and string.format("%d / %d", ammo[1], ammo[2]) or "∞", i == st.wi, ammo and ammo[1] + ammo[2] == 0) end
        if i == st.wi and w then
          selAmmo = ammo and tostring(ammo[1] + ammo[2]) or "∞"
          local l = (st.next[wid] or 0) - os.clock()
          local full = (ammo and ammo[1] == w.mag and l > w.rate) and (w.reload or w.rate) or w.rate
          relK = 1 - math.clamp(l / math.max(full, 0.01), 0, 1)
          ready, left = l <= 0, math.max(0, l)
          if lastNext[wid] and (st.next[wid] or 0) > lastNext[wid] + 0.05 and (w.dmg or 0) > 150 then kickT = os.clock() end
        end
        lastNext[wid] = st.next[wid] or 0
      elseif rowsOn then
        setRow(r, nil, nil)
      end
    end
    if tkOn then
      TK.smoke.Text = string.format("X   %s ×%d", T("vh.smoke"), vs and vs.smoke or 0)
      setRing(TK.ring, relK, ready, left)
    end
    if mwtOn then
      -- MWT 右下：车名、剪影（挨打闪红、血少变色）、血量「当前/满」；六边形弹种按钮靠右排；烟幕弹图标
      MW.name.Text = string.match(TK.name.Text, "^(%S+)") or TK.name.Text   -- 只写型号（「ZTZ-96 主战坦克」→「ZTZ-96」，MWT 那样）
      -- 车的图标（全息图、视角图）、血量数字的颜色只看车况（用户 11-19：被打到状态一般改成黄色，状态很差改成红色）：
      --   六成以上绿色、三到六成黄色、三成以下红色（挨打那一下不再闪红：红色只表示车况很差）
      local silCol = (k > 0.6) and HOLO or ((k > 0.3) and RGB(255, 214, 64) or RGB(255, 64, 52))
      if MW.iconId ~= d.id then   -- 换了车：换全息图（这辆车拍过的侧面图）；没有就用方块拼的剪影
        MW.iconId = d.id
        -- 拆出来的同族变型（11-27：M1、IPM1、M1A2 SEP……HudIcons 是拍图生成的，没拍过它们）：查不到自己的就用 like 那一型的（同一个模型）
        local icName = nil
        for _, k in ipairs({ d.id, d.like }) do
          if icName == nil and k and art(MW.icon, "veh_" .. k) then icName = "veh_" .. k end
        end
        local ok = icName ~= nil
        local ic = ok and G.hudIcon(icName)
        if ic then MW.icon.Size = UD2(0, math.floor(ic.w * 0.62 + 0.5), 0, math.floor(ic.h * 0.62 + 0.5)) end
        MW.icon.Visible = ok
        MW.sil.Visible = not ok
        MW.hp.Position = UD2(0, 0, 0, ok and (24 + (ic and ic.h * 0.62 or 54) - 2) or 80)
      end
      MW.icon.ImageColor3 = silCol
      -- 视角图：车体框、炮塔框按相对镜头的朝向转（跟原来面板里的俯视轮廓一样算），颜色跟着车况；爆反哪块没了就空一块
      MW.vHullBox.Rotation, MW.vTurBox.Rotation = TK.hull.Rotation, TK.tur.Rotation
      MW.vTurBox.Visible = d.turret ~= nil
      MW.vHullImg.ImageColor3, MW.vTurImg.ImageColor3 = silCol, silCol
      for _, q in ipairs(MW.vFall) do
        if q.s then q.s.Color = silCol else q.f.BackgroundColor3 = silCol end   -- 边框染色；炮管是实心的细条
      end
      local eraKey = d.id .. ":" .. tostring(d.mods and d.mods.era or "")
      if MW.eraId ~= eraKey then
        MW.eraId = eraKey
        buildEra(d)
      end
      if #MW.era > 0 then
        local dead = {}
        for k2 in string.gmatch(st.em:GetAttribute("EraX") or "", "%d+") do dead[tonumber(k2)] = true end
        local ec = silCol:Lerp(WHITE, 0.3)
        for _, e in ipairs(MW.era) do
          local alive = 0
          for _, i2 in ipairs(e.idx) do if not dead[i2] then alive += 1 end end
          e.f.Visible = alive > 0
          e.f.BackgroundColor3 = ec
          e.f.BackgroundTransparency = (alive == #e.idx) and 0 or 0.55   -- 叠着的几层炸掉一部分：淡一点
        end
      end
      MW.viewScale.Scale = MW.brScale.Scale
      for i, f in ipairs(MW.silParts) do
        if i <= 8 then f.BackgroundColor3 = silCol end
      end
      local hp, mx = math.floor(st.em:GetAttribute("Hp") or 0), math.floor(st.em:GetAttribute("MaxHp") or 0)
      local hc = silCol
      MW.hp.Text = string.format('<font color="#%02X%02X%02X">%d</font>/%d', math.floor(hc.R * 255), math.floor(hc.G * 255), math.floor(hc.B * 255), hp, mx)
      local n = 0
      for i = 1, #MW.hex do if d.weapons[i] then n = i end end
      if MW.nHex ~= n then
        MW.nHex = n
        for i, h in ipairs(MW.hex) do
          h.box.Visible = i <= n
          h.box.Position = UD2(0, 460 - HEX_R - (n - i) * (HEX_R * 1.732 + 8), 0, 124 - HEX_R - 2)
        end
        local left0 = 460 - HEX_R - (n - 1) * (HEX_R * 1.732 + 8) - HEX_R
        MW.veh.Position = UD2(0, math.max(0, left0 - 200), 0, 6)
      end
      for i = 1, n do
        local h = MW.hex[i]
        local wid = d.weapons[i]
        local w = VD.W[wid]
        local ammo = vs and vs.ammo and vs.ammo[wid]
        local empty = ammo ~= nil and ammo[1] + ammo[2] == 0
        local sel = i == st.wi
        local edge = empty and BAD or (sel and HOLO or MUTE)
        for _, e in ipairs(h.edges) do
          e.BackgroundColor3 = edge
          e.BackgroundTransparency = sel and 0 or 0.35
        end
        for _, f in ipairs(h.fills) do f.BackgroundColor3 = sel and RGB(18, 64, 30) or INK end
        h.fillGroup.GroupTransparency = sel and 0.25 or 0.45
        h.icon.body.BackgroundColor3, h.icon.tip.BackgroundColor3 = sel and HOLO or MUTE, sel and WHITE or MUTE
        h.key.Text = tostring(i)
        h.key.TextColor3 = sel and TXT or MUTE
        h.tag.Text = ammoTag(w)
        h.tag.TextColor3 = sel and HOLO or MUTE
        if h.art then
          h.iFill.ImageColor3, h.iFill.ImageTransparency = sel and RGB(16, 58, 26) or INK, sel and 0.22 or 0.4
          h.iGlow.Visible = sel and not empty
          h.iEdge.ImageColor3, h.iEdge.ImageTransparency = edge, sel and 0 or 0.3
          local ic = (w and w.kind == "gun") and "mg" or "shell"
          if h.iconName ~= ic then h.iconName = ic art(h.iIcon, ic) end
          h.iIcon.ImageColor3 = sel and Color3.new(1, 1, 1):Lerp(HOLO, 0.35) or MUTE
        end
      end
      local sm = vs and vs.smoke or 0
      MW.smTxt.Text = string.format("X ×%d", sm)
      local dim = sm <= 0
      MW.smStroke.Transparency = dim and 0.65 or 0
      MW.smCap.BackgroundTransparency = dim and 0.65 or 0
      MW.smPin.BackgroundTransparency = dim and 0.65 or 0
      MW.smWin.BackgroundTransparency = dim and 0.85 or 0.55
      MW.smTxt.TextTransparency = dim and 0.5 or 0
      MW.smImg.ImageTransparency = dim and 0.62 or 0
    end
    local gear = TK.gear.Text
    updateCompact(TK.name.Text, TK.spd.Text .. " km/h", tonumber(gear) and ("D" .. gear) or gear, TK.hdg.Text,
      TK.hp.lab.Text, k, col, TK.rows[st.wi], relK, ready, left)
    stepCompass(hdgOf(st.camYaw), hdgOf((st.yaw or 0) - math.rad(st.ty or 0)))
    local hasGun = d.turret ~= nil and d.gun ~= nil and d.weapons[1] ~= nil
    if not hasGun then
      hideReticles()
      if wtMode then G.wtTankStep(st, nil) end   -- 没有炮塔的车（悍马的机枪……）：战雷界面只画弹药栏、损伤图
      return
    end
    local base = st.root * CFrame.new(0, -d.H / 2, 0)
    local gcf = VD.gunCF(d, base, st.ty or 0, st.gp or 0)
    local aim = st.aimPt or (gcf.Position + gcf.LookVector * 200)
    local pt = gcf.Position + gcf.LookVector * math.max(30, (aim - gcf.Position).Magnitude)
    local wid = d.weapons[st.wi]
    local w = wid and VD.W[wid]
    local penC, penT = nil, nil
    if wtMode then
      -- 战雷那套：准星（穿深指示按毫米算）、底部弹药栏、左下损伤图都在 WtTank.lua
      hideReticles()
      -- 炮管标记画在这一刻开炮的真落点（Drive gunImpact，用户 11-27「坦克准心对标战雷」）；炮口被挡时 WtTank 画叉
      local gh = st.gunHit
      G.wtTankStep(st, { p = gh and gh.p or pt, o = gh and gh.o or gcf.Position, blocked = gh and gh.blocked or false,
        relK = relK, ready = ready, left = left, wid = wid, w = w, am = st.fcs and st.fcs.am })
    else
      if w then penC, penT = penState(w, gcf.Position, pt, st.em) end
      placeTank(pt, gcf.Position, relK, ready, left, true, penC, penT, selAmmo)
    end
    if G.tankHudExtra then G.tankHudExtra(st, k) end   -- 敌人头顶的名字和距离、「被发现」、爆反 / 主动防御的状态（TankHud.lua）
  end

  -- 舰艇主炮的准星：p 落点、o 炮口、tof 炮弹飞多久；瞄着的敌人：目标卡 + 提前量
  local function placeShip(p, o, relK, ready, left, tof, wname)
    local sp, on = cam:WorldToViewportPoint(p)
    SR.root.Visible = on
    local kick = reducedMotion and 0 or math.clamp(1 - (os.clock() - kickT) / 0.35, 0, 1)
    SR.scale.Scale = 1 + 0.25 * kick
    SR.root.Position = UD2(0, sp.X, 0, sp.Y)
    local col = ready and CYAN or AMBER
    SR.ringStroke.Color = col
    for _, l in ipairs(SR.lines) do l.BackgroundColor3 = col end
    local lit = ready and #SR.segs or math.floor(relK * #SR.segs + 0.001)
    for i, sgx in ipairs(SR.segs) do
      sgx.BackgroundColor3 = ready and CYAN or AMBER
      sgx.BackgroundTransparency = (i <= lit) and (ready and 0.35 or 0.02) or 0.8
    end
    local km = (p - o).Magnitude / 2.8 / 1000
    SR.rng.Text = (km >= 1) and string.format("%.1f km", km) or string.format("%d m", math.floor(km * 1000 / 5 + 0.5) * 5)
    SR.tof.Text = ready and string.format("T %.1f s", tof or 0) or string.format("%s %.1f", T("vh.reload"), left)
    SR.tof.TextColor3 = ready and CYAN or AMBER
    SR.wpn.Text = wname or ""
    setFlash(0.1 * kick * kick)
    -- 瞄着的敌人（落点附近 90 像素内最近的）
    local em = on and enemyNear(sp.X, sp.Y, 90) or nil
    local r = em and em:FindFirstChild("Root")
    if not r then
      SR.card.Visible, SR.lead.Visible = false, false
      for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
      return
    end
    local tp = r.CFrame.Position
    local tsp, ton = cam:WorldToViewportPoint(tp)
    local size = r.Size.Magnitude
    local top = cam:WorldToViewportPoint(tp + V3(0, r.Size.Y * 0.5 + size * 0.06, 0))
    SR.card.Visible = ton
    SR.card.Position = UD2(0, tsp.X, 0, top.Y - 8)
    local key = "veh." .. tostring(em:GetAttribute("Model") or em:GetAttribute("Kind") or "")
    SR.cardName.Text = string.format("%s   %.1f km", T(key), (tp - o).Magnitude / 2800)
    local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
    SR.cardHp.Size = UD2(math.clamp(hp / math.max(1, mx), 0, 1), 0, 1, 0)
    -- 提前量：炮弹落下去的时候它开到哪
    local v = velOf(em)
    local fut = tp + V3(v.X, 0, v.Z) * (tof or 0)
    local lsp, lon = cam:WorldToViewportPoint(fut)
    local show = ton and lon and V3(v.X, 0, v.Z).Magnitude > 2
    SR.lead.Visible = show
    if show then
      SR.lead.Position = UD2(0, lsp.X, 0, lsp.Y)
      for i, dd in ipairs(SR.leadDots) do
        local k = i / (#SR.leadDots + 1)
        dd.Visible = true
        dd.Position = UD2(0, tsp.X + (lsp.X - tsp.X) * k, 0, tsp.Y + (lsp.Y - tsp.Y) * k)
      end
    else
      for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
    end
  end
  G.shipLead = function() return SR.lead.Visible and SR.lead.Position or nil end   -- 测试用

  -- 导弹锁定（《现代战舰》）：四个角框住目标；刚框上 0.5 秒从两倍大收到贴着目标（琥珀「锁定中」），收好了 / 按了锁定键变红
  local lockEm, lockT0 = nil, 0
  local function placeLock(st)
    local lk = (st.wi == 2) and st.lock or nil
    local r = lk and lk.root
    if not r or not r.Parent then
      SR.lock.Visible = false
      SR.lockTxt.Visible = st.wi == 2
      SR.lockTxt.Text = T("ship.noLock")
      SR.lockTxt.TextColor3 = MUTE
      SR.lockTxt.Position = UD2(0.5, 0, 0.5, 46)
      lockEm = nil
      return
    end
    if lk.em ~= lockEm then lockEm, lockT0 = lk.em, os.clock() end
    local tp = r.CFrame.Position
    local sp, on = cam:WorldToViewportPoint(tp)
    local dist = (tp - cam.CFrame.Position).Magnitude
    local px = math.clamp(r.Size.Magnitude / math.max(dist, 1) * cam.ViewportSize.Y * 0.9, 34, 170)
    local a = math.clamp((os.clock() - lockT0) / 0.5, 0, 1)
    local locked = a >= 1 or st.sticky
    local sz = px * (1 + (1 - a) * (1 - a) * 1.2)
    SR.lock.Visible = on
    SR.lock.Position = UD2(0, sp.X, 0, sp.Y)
    SR.lock.Size = UD2(0, sz, 0, sz)
    local col = locked and PEN_NO or PEN_MAYBE
    for _, c in ipairs(SR.corners) do c.BackgroundColor3 = col end
    local key = (lk.kind == "fort") and ("fort." .. tostring(lk.em:GetAttribute("Model") or "bunker"))
      or ("veh." .. ((lk.d and lk.d.id) or (lk.def and lk.def.id) or lk.kind or ""))
    local own = st.em and st.em:FindFirstChild("Root")
    local km = own and (tp - own.CFrame.Position).Magnitude or dist
    local msp = (SD.W.asm and SD.W.asm.speed) or 320
    SR.lockTxt.Visible = on
    SR.lockTxt.Position = UD2(0, sp.X, 0, sp.Y + sz / 2 + 8)
    SR.lockTxt.TextColor3 = col
    SR.lockTxt.Text = string.format("%s  %s   %.1f km   ETA %.0f s", locked and T("ship.locked") or T("ship.locking"), T(key), km / 2800, km / (msp * 0.85) + 1)
  end
  G.shipLockState = function() return SR.lock.Visible, SR.corners[1].BackgroundColor3 end   -- 测试用

  ---------------------------------------------------------------- 每帧：舰艇
  local function stepShip(st)
    local d = st.d
    local vs = G.S and G.S.veh
    if SH.def ~= d then buildShip(d) end
    SH.name.Text = T("veh." .. d.id) .. ((vs and vs.rest and vs.rest > 0) and ("   " .. T("ship.rest")) or "")
    SH.hp.lab.Text = T("vh.hullShip")
    local k, col = hpColor(st.em)
    SH.bodyStroke.Color, SH.bowStroke.Color = col, col
    setHp(SH.hp, k, col)
    local camY = math.deg(st.camYaw or 0)
    local hullY = math.deg(st.yaw or 0)
    SH.hull.Rotation = -(hullY - camY)
    for gi, t in ipairs(SH.turrets) do t.box.Rotation = st.ty[gi] or 0 end
    SH.kn.Text = string.format("%d", math.floor(math.abs(st.speed or 0) / 2.8 * 1.944 + 0.5))
    SH.order.Text = T("ship.order." .. (st.order or 0))
    for o, c in pairs(SH.ladder) do
      local on = o == st.order
      c.BackgroundColor3 = on and ((o < 0) and AMBER or ((o == 0) and TXT or OK)) or TXT
      c.BackgroundTransparency = on and 0.02 or 0.85
    end
    local rd = math.floor(math.abs(st.rudder or 0) * 35 + 0.5)
    SH.rud.Position = UD2(0.5, (st.rudder or 0) * 64, 0.5, 0)
    SH.rudTxt.Text = (rd == 0) and T("ship.mid") or T(((st.rudder or 0) > 0) and "ship.right" or "ship.left", rd)
    SH.hdg.Text = string.format("%03d°", math.floor(hdgOf(st.yaw) + 0.5) % 360)
    -- 武器：主炮、反舰导弹、防空导弹、近防炮
    local t = os.clock()
    local relK, ready, left = 1, true, 0
    local g1 = d.guns and d.guns[1]
    if g1 then
      setRow(SH.rows[1], "1", T("sw." .. g1.w) .. ((#d.guns > 1) and (" ×" .. #d.guns) or ""), "∞", st.wi == 1)
      if st.wi == 1 then
        local w = SD.W[g1.w]
        local l = (st.next[1] or 0) - t
        relK, ready, left = 1 - math.clamp(l / math.max(w and w.rate or 1, 0.01), 0, 1), l <= 0, math.max(0, l)
        if lastNext.s1 and (st.next[1] or 0) > lastNext.s1 + 0.05 then kickT = t end
        lastNext.s1 = st.next[1] or 0
      end
    else
      setRow(SH.rows[1], nil, nil)
    end
    if d.missiles then
      local n = vs and vs.msl or 0
      setRow(SH.rows[2], "2", T("sw." .. (d.missiles.name or "yj83")), tostring(n), st.wi == 2, n == 0)
      if st.wi == 2 then
        local l = (st.mslT or 0) - t
        relK, ready, left = 1 - math.clamp(l / 1.3, 0, 1), l <= 0, math.max(0, l)
      end
    else
      setRow(SH.rows[2], nil, nil)
    end
    if d.sam then setRow(SH.rows[3], nil, T("vh.sam"), tostring(vs and vs.sam or 0), false) else setRow(SH.rows[3], nil, nil) end
    if d.ciws and #d.ciws > 0 then setRow(SH.rows[4], nil, T("vh.ciws"), T("vh.auto"), false) else setRow(SH.rows[4], nil, nil) end
    setRing(SH.ring, relK, ready, left)
    updateCompact(SH.name.Text, T("ship.kn", SH.kn.Text), SH.order.Text, SH.hdg.Text,
      SH.hp.lab.Text, k, col, SH.rows[st.wi], relK, ready, left)
    stepCompass(hdgOf(st.camYaw), hdgOf(st.yaw))
    -- 准星：主炮的落点（《现代战舰》的大圈）、导弹的锁定框
    TR.root.Visible, lagArrow.Visible = false, false
    local fp = (st.wi == 1 and G.sailFall and g1) and G.sailFall(1) or nil
    if fp then
      local w = SD.W[g1.w]
      local mz = SD.muzzle(d, st.cf, 1, st.ty[1] or 0, st.gp[1] or 0)
      local h = V3(fp.X - mz.Position.X, 0, fp.Z - mz.Position.Z).Magnitude
      local lv = mz.LookVector
      local tof = (w.kind == "gun") and ((fp - mz.Position).Magnitude / 1500) or (h / math.max(1, w.speed * math.sqrt(lv.X * lv.X + lv.Z * lv.Z)))
      placeShip(fp, mz.Position, relK, ready and (st.onT and st.onT[1]) ~= false, left, tof, T("sw." .. g1.w))
    else
      SR.root.Visible, SR.lead.Visible, SR.card.Visible = false, false, false
      for _, dd in ipairs(SR.leadDots) do dd.Visible = false end
      setFlash(0)
    end
    placeLock(st)
  end

  ---------------------------------------------------------------- 坦克瞄准镜里（Drive.lua 画目镜、分划、测距数字；这里在镜里补战雷那一套仪表）
  -- 分划外一圈 32 颗点的装填环（装好变绿）；左边竖着的测距尺（0～2000 米，每 200 米一格、每 400 米一个数，小三角指着现在测到的距离）；
  --   下面一行：选中的弹、弹药、装填状态；上面一条小罗盘（炮管朝向）
  local sg = Instance.new("ScreenGui")
  sg.Name = "VehSight"
  sg.ResetOnSpawn = false
  sg.IgnoreGuiInset = true
  sg.DisplayOrder = 7
  sg.Enabled = false
  sg.Parent = me:WaitForChild("PlayerGui")
  local SG = { dots = {}, ticks = {} }
  -- 开炮后镜里一阵炮口烟、土（战雷那样前面一下子看不清，一秒多散掉）：颜色跟着光电模式（夜视绿、热成像灰）
  SG.haze = Instance.new("Frame")
  SG.haze.Name = "MuzzleHaze"
  SG.haze.Size = UDim2.fromScale(0.9, 0.9)   -- 跟 Drive 的目镜一样大的圆：烟只在镜片里，外面的黑边不染色
  SG.haze.AnchorPoint = V2(0.5, 0.5)
  SG.haze.Position = UDim2.fromScale(0.5, 0.5)
  SG.haze.BorderSizePixel = 0
  do
    local a = Instance.new("UIAspectRatioConstraint")
    a.AspectRatio = 1
    a.Parent = SG.haze
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0.5, 0)
    c.Parent = SG.haze
  end
  SG.haze.BackgroundTransparency = 1
  SG.haze.ZIndex = 0
  SG.haze.Parent = sg
  do
    local gr = Instance.new("UIGradient")
    gr.Rotation = 90
    gr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(0.55, 0), NumberSequenceKeypoint.new(1, 0.15) })
    gr.Parent = SG.haze
  end
  SG.ring = frame(sg, UD2(0, 180, 0, 180), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SG.ring.Name = "SightReload"
  -- 装填环：原来 32 颗 4 像素的小点（用户 11-19：像素感太强）——换成一道平滑的细圆环（圆角 + 描边，抗锯齿），
  --   装填中琥珀色、越装越亮，装好变绿（剩几秒写在右边的状态框里）
  SG.ringLine = roundf(frame(SG.ring, UD2(0, 172, 0, 172), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5)))
  SG.ringLine.Name = "ReloadRing"
  SG.ringStroke = stroke(SG.ringLine, TXT, 1.6, 0.6)
  SG.scale = frame(sg, UD2(0, 60, 0, 220), UD2(0.5, -250, 0.5, 0), INK, 1, V2(0.5, 0.5))
  SG.scale.Name = "RangeScale"
  frame(SG.scale, UD2(0, 2, 1, 0), UD2(0, 30, 0, 0), TXT, 0.35)
  for i = 0, 10 do
    local y = 220 - i * 22
    local major = i % 2 == 0
    frame(SG.scale, UD2(0, major and 12 or 7, 0, 2), UD2(0, 32, 0, y - 1), TXT, 0.3)
    if major then label(SG.scale, tostring(i * 2), UD2(0, 26, 0, 14), UD2(0, 0, 0, y - 7), 12, TXT, MONO, nil, RIGHT) end
  end
  SG.ptr = label(SG.scale, "◀", UD2(0, 14, 0, 14), UD2(0, 46, 0, 0), 12, AMBER, BOLD, V2(0, 0.5))
  SG.ptr.Name = "RangePointer"
  label(SG.scale, "×100m", UD2(0, 60, 0, 12), UD2(0, 0, 1, 6), 10, MUTE, MONO)
  -- 右边跟左边测距尺对称：选中的弹 / 弹药 / 装填（下面 Drive 的测距数字和倍率不挡）
  SG.info = frame(sg, UD2(0, 184, 0, 43), nil, INK, 0.19)
  SG.info.Name = "SightStatus"
  stroke(SG.info, WHITE, 1, 0.79)
  SG.ammo = label(SG.info, "", UD2(1, -74, 0, 18), UD2(0, 10, 0, 4), 13, TXT, MED, nil, LEFT)
  SG.ammo.Name = "SightAmmo"
  SG.ammo.TextTruncate = Enum.TextTruncate.AtEnd
  SG.count = label(SG.info, "", UD2(0, 50, 0, 18), UD2(1, -8, 0, 4), 12, TXT, MONO, V2(1, 0), RIGHT)
  SG.state = label(SG.info, "", UD2(1, -20, 0, 16), UD2(0, 10, 0, 23), 12, OK, BOLD, nil, LEFT)
  SG.comp = frame(sg, UD2(0, 300, 0, 22), UD2(0.5, 0, 0.5, -215), INK, 1, V2(0.5, 0))
  SG.comp.ClipsDescendants = true
  for i = 1, 24 do
    SG.ticks[i] = { t = frame(SG.comp, UD2(0, 1, 0, 5), UD2(0, 0, 0, 0), TXT, 0.4), l = label(SG.comp, "", UD2(0, 28, 0, 12), UD2(0, 0, 0, 6), 10, TXT, MONO, V2(0.5, 0)) }
  end
  SG.marker = label(sg, "▼", UD2(0, 14, 0, 10), UD2(0.5, 0, 0.5, -226), 9, AMBER, BOLD, V2(0.5, 0))
  local sightRingScale = Instance.new("UIScale")
  sightRingScale.Parent = SG.ring

  -- 触屏左下的方向键最右到 x=250，右侧操作键最下到离底部 120 px。
  local function compactDock(vp, mobile, width, height)
    local margin = 14
    local left = mobile and 262 or margin
    local room = vp.X - left - margin
    local top = vp.Y - height - margin
    if mobile and room < 185 then
      -- 竖屏保留左上小地图的 122 px 宽度。
      left, room = 150, vp.X - 150 - margin
      top = math.min(100, top)
    end
    width = math.max(1, math.min(width, room))
    return math.max(left, (vp.X - width) / 2), math.max(0, top), width
  end

  local PAIRS = { { TK.car, TK.arm }, { SH.car, SH.arm } }
  for _, pr in ipairs(PAIRS) do
    pr[3], pr[4] = Instance.new("UIScale"), Instance.new("UIScale")
    pr[3].Parent, pr[4].Parent = pr[1], pr[2]
  end
  local lastVp, lastMob = nil, nil
  local compact, compassSide = false, false
  local function layoutPanels()
    local vp = cam.ViewportSize
    local mob = G.mobile == true or UIS.TouchEnabled
    if lastVp == vp and lastMob == mob then return end
    lastVp, lastMob = vp, mob
    compact = mob or vp.X < 760 or vp.Y < 480
    -- 计分栏左边：左上角是 Roblox 自己的菜单、聊天按钮（约 125 px 宽），罗盘从它们右边起，到计分栏左边留 12 px（1280 宽也放得下：约 160 px）
    local SIDE_X = 132
    local sideWidth = vp.X / 2 - 330 - SIDE_X - 12
    compassSide = sideWidth >= 150
    CW = compassSide and math.min(420, math.floor(sideWidth)) or math.clamp(math.floor(vp.X - 32), 1, 420)
    compGroup.Size = UD2(0, CW, 0, 51)
    compGroup.Position = compassSide and UD2(0, SIDE_X, 0, 16) or UD2(0.5, -CW / 2, 0, 118)

    local s = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.74, 1.25)
    for _, pr in ipairs(PAIRS) do
      pr[3].Scale, pr[4].Scale = s, s
      pr[1].Position, pr[2].Position = UD2(1, -334 * s, 1, -40 * s), UD2(1, -24 * s, 1, -40 * s)
    end
    MW.brScale.Scale, MW.smScale.Scale = s, s
    MW.br.Position = UD2(1, -18 * s, 1, -14 * s)
    MW.sm.Position = UD2(0.5, 70 * s, 1, -16 * s)

    local x, y, width = compactDock(vp, mob, 342, 72)
    local split = width >= 232 and 108 or 88
    MS.box.Position, MS.box.Size = UD2(0, x, 0, y), UD2(0, width, 0, 72)
    MS.speed.Size, MS.motion.Size = UD2(0, split - 15, 0, 28), UD2(0, split - 15, 0, 16)
    MS.speed.TextSize = width >= 232 and 20 or 16
    MS.split.Position = UD2(0, split, 0, 8)
    MS.selection.Position, MS.selection.Size = UD2(0, split + 10, 0, 6), UD2(1, -split - 18, 0, 16)
    MS.count.Position, MS.count.Size = UD2(0, split + 10, 0, 24), UD2(1, -split - 74, 0, 16)
    MS.health.Position, MS.health.Size = UD2(0, split + 10, 0, 42), UD2(1, -split - 18, 0, 16)
    MS.track.Position, MS.track.Size = UD2(0, split + 10, 1, -10), UD2(1, -split - 18, 0, 2)

    local simpleSight = compact or vp.X < 900 or vp.Y < 520
    -- 用户 11-27（照战雷的开镜截图）：镜里的距离标尺、小罗盘、装填圈、弹药读数框不要了——方位刻度、表尺在 GunSight（Drive），
    --   弹药栏、装填、左下损伤图在 WtTank（下面 wtBarOnly）；手机的紧凑布局没有 WtTank，读数框照旧留着
    SG.scale.Visible, SG.comp.Visible, SG.marker.Visible = false, false, false
    SG.ring.Visible = false
    SG.info.Visible = compact
    sightRingScale.Scale = simpleSight and 0.78 or 1
    if simpleSight then
      local sx, sy, sw = compactDock(vp, mob, 184, 43)
      if mob and vp.X >= 600 then sx = vp.X - sw - 14 end
      SG.info.Position, SG.info.Size = UD2(0, sx, 0, sy), UD2(0, sw, 0, 43)
    else
      SG.info.Position, SG.info.Size = UD2(0.5, 206, 0.5, -26), UD2(0, 184, 0, 43)
    end
  end
  G.vehCompass.layout = function() layoutPanels() end   -- 测试用

  local function stepSight(st)
    local d = st.d
    local vs = G.S and G.S.veh
    local wid = d.weapons[st.wi]
    local w = wid and VD.W[wid]
    local ammo = vs and vs.ammo and wid and vs.ammo[wid]
    local relK, ready, left = 1, true, 0
    if w then
      local l = (st.next[wid] or 0) - os.clock()
      local full = (ammo and ammo[1] == w.mag and l > w.rate) and (w.reload or w.rate) or w.rate
      relK, ready, left = 1 - math.clamp(l / math.max(full, 0.01), 0, 1), l <= 0, math.max(0, l)
    end
    -- 炮口烟：开炮后 0.06 秒涌上来，一秒多散掉
    local age = os.clock() - (st.fireT or -99)
    local hz = (not reducedMotion and age < 2.2) and math.clamp(age / 0.06, 0, 1) * 0.62 * math.exp(-math.max(0, age - 0.06) * 2.1) or 0
    SG.haze.BackgroundTransparency = 1 - hz
    if hz > 0 then
      local cc = G.sightCC
      local tint = (cc and cc.Enabled) and cc.TintColor or Color3.fromRGB(255, 255, 255)
      SG.haze.BackgroundColor3 = Color3.fromRGB(168, 156, 136):Lerp(tint, 0.55)
    end
    -- 装填（用户 11-25「装弹是顺时针从红色变成绿色」）：颜色跟着进度红 → 琥珀 → 绿
    local rk = math.clamp(relK, 0, 1)
    SG.ringStroke.Color = ready and OK or ((rk < 0.5) and TH.C.BAD:Lerp(AMBER, rk / 0.5) or AMBER:Lerp(OK, (rk - 0.5) / 0.5))
    SG.ringStroke.Transparency = ready and 0.3 or (0.8 - 0.5 * relK)
    SG.ammo.Text = wid and T("vw." .. wid) or ""
    SG.count.Text = wid and (ammo and string.format("%d/%d", ammo[1], ammo[2]) or "∞") or ""
    SG.state.Text = ready and T("vh.loaded") or string.format("%s  %.1f", T("vh.reload"), left)
    SG.state.TextColor3 = ready and OK or AMBER
    if not SG.scale.Visible then return end
    local dist = st.aimPt and (st.aimPt - cam.CFrame.Position).Magnitude / 2.8 or 0
    SG.ptr.Position = UD2(0, 46, 0, 220 - math.clamp(dist / 2000, 0, 1) * 220)
    -- 小罗盘：炮管朝向（11-27：炮管没转就不重摆；转了只挪位置，刻度长短、字换了一格才重写）
    local h = hdgOf((st.yaw or 0) - math.rad(st.ty or 0))
    if h == SG.cmpH then return end
    SG.cmpH = h
    local first = math.floor((h - 150 / 3) / 5) * 5
    local relabel = first ~= SG.cmpFirst
    SG.cmpFirst = first
    for i, tk in ipairs(SG.ticks) do
      local a = first + (i - 1) * 5
      local x = 150 + (a - h) * 3
      tk.t.Position = UD2(0, x, 0, 0)
      tk.l.Position = UD2(0, x, 0, 8)
      if relabel then
        local aa = a % 360
        tk.t.Size = UD2(0, 1, 0, (aa % 15 == 0) and 7 or 4)
        tk.l.Text = (aa % 30 == 0) and (DIR[aa] or string.format("%03d", aa)) or ""
      end
    end
  end

  -- 开镜、望远镜里也画战雷式的弹药栏和左下损伤图（用户 11-27 截图：镜里底下一排弹药、左下自己车的损伤图和档位速度）；车外那个准星圈不画（I.p = nil）
  local function wtBarOnly(st)
    if not G.wtTankStep then return end
    local d = st.d
    local wid = d.weapons[st.wi]
    local w = wid and VD.W[wid]
    local vs = G.S and G.S.veh
    local ammo = vs and vs.ammo and wid and vs.ammo[wid]
    local relK, ready, left = 1, true, 0
    if w then
      local l = (st.next[wid] or 0) - os.clock()
      local full = (ammo and ammo[1] == w.mag and l > w.rate) and (w.reload or w.rate) or w.rate
      relK, ready, left = 1 - math.clamp(l / math.max(full, 0.01), 0, 1), l <= 0, math.max(0, l)
    end
    G.wtTankStep(st, { relK = relK, ready = ready, left = left, wid = wid, w = w, am = st.fcs and st.fcs.am })
  end

  G.frameConn("VehHud", function()
    local covered = (G.boardShown and G.boardShown()) or (G.menuOpen and G.menuOpen())
      or (G.menuShown and G.menuShown()) or (G.coachPanel and G.coachPanel())
    local tank, ship = G.myVeh, G.sail
    local driving = not covered and tank ~= nil and tank == G.drive and tank.d ~= nil
    local sailing = not covered and ship ~= nil and ship == G.drive and ship.d ~= nil and ship.bino ~= true
    local inSight = driving and tank.sight == true
    local inBino = driving and tank.binoc == true   -- 车长望远镜（Drive / GunSight，用户 11-27）
    local showTank = driving and not inSight and not inBino and not (G.interiorOn and G.interiorOn())   -- 坐在车里看（Interior.lua）：车里的屏幕就是仪表
    gui.Enabled, sg.Enabled = showTank or sailing, inSight and not G.interiorOptic
    if not gui.Enabled then
      setFlash(0)
      hp0 = nil
      mwtOn, wtMode = false, false
      G.tankHudActive = false
    end
    if not gui.Enabled and not inSight and not inBino then return end
    layoutPanels()
    if inSight or inBino then
      if inSight then
        local ok, err = pcall(stepSight, tank)
        if not ok and G.showError then G.showError("瞄准镜：" .. tostring(err)) end
      end
      if not compact and not G.interiorOptic then
        local ok, err = pcall(wtBarOnly, tank)
        if not ok and G.showError then G.showError("瞄准镜弹药栏：" .. tostring(err)) end
      end
      return
    end
    wtMode = showTank and not compact and G.wtTankStep ~= nil
    mwtOn = showTank and not compact and not wtMode
    camAim.Visible = not wtMode   -- 战雷那套：镜头瞄的地方是 WtTank 的大圈（用户 11-28「较大那个环改成鼠标光标的位置」），这个小圈收起
    G.tankHudActive = showTank and not compact   -- 屏幕上只留这一套（Coach 的三步卡、Hud 的提示让开）
    MW.root.Visible = mwtOn
    compGroup.Visible = not compact and not showTank and (compassSide or not (G.operationHudVisible and G.operationHudVisible()))
    TK.car.Visible, TK.arm.Visible = false, false   -- 电脑开坦克是 MWT 那套（MW），触屏是紧凑读数面板（MS）
    SH.car.Visible, SH.arm.Visible = sailing and not compact, sailing and not compact
    MS.box.Visible = compact
    local ok, err = pcall(showTank and stepTank or stepShip, showTank and tank or ship)
    if not ok and G.showError then G.showError("驾驶界面：" .. tostring(err)) end
  end)
end

return VehHud
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="277">
          <Properties>
            <string name="Name">VehModels</string>
            <ProtectedString name="Source">-- Roblox全面大战场（客户端）——地面载具的样子：导入了原模型就用原模型（见下），没有就按 VehDefs 的尺寸用零件拼——车体（首上装甲、侧裙、发动机舱、反应装甲块）、
--   履带车的负重轮 / 主动轮 / 诱导轮 / 履带（下面一段段跟着负重轮上下）、轮式车的车轮（带轮毂、挡泥板，前轴转向）、
--   各式炮塔（楔形、圆形、艾布拉姆斯、步战车、遥控武器站、自行高炮、火神炮、自行榴弹炮、发射箱）、炮管（抽烟装置、炮口制退器）、
--   烟幕弹发射筒（就装在 VehDefs 规定的位置、朝规定的方向）
--   返回 { model, parts = { { 零件, 组, 相对位置 } }, wheels = { … } }：组是 hull（车体）/ turret / gun / wheel（第几个轮）/ seg（履带段）
--   每帧由 View 按车体、炮塔、炮、各轮的姿态算出零件位置（BulkMoveTo）
local VehModels = {}

-- 原模型（网页版装备模型原样转的 models/veh/&lt;模型键&gt;.glb，Studio 里导入后由 Imports.lua 收进 ReplicatedStorage.Imported.Veh.&lt;模型键&gt;）：
--   有就整辆换成它（真实尺寸，不缩放；车体、炮塔、炮、各个车轮照元数据 ImportedMeta 摆、按各自的转轴动），没有就用下面零件拼的
local RS = game:GetService("ReplicatedStorage")
local Tint = require(script.Parent:WaitForChild("Tint"))   -- 导入的贴图没出来时的底色（原贴图的平均色）
local TURN = require(RS:WaitForChild("ImportTurn")).TURN   -- 导入的每块网格被 Roblox 转了半圈（ImportTurn.lua）：摆的时候转回来
local TM = require(RS:WaitForChild("TankMods"))   -- 坦克改装：爆反块、主动防御、车顶加特林（用户 11-19）
local IM = nil
do
  local ok, r = pcall(function() return require(RS:WaitForChild("ImportedMeta", 3)) end)
  if ok and type(r) == "table" then IM = r end
end
-- 型号 → 原模型：先找 alias 的模型键；那个模型还没导入（Studio 里没导新 GLB）就退回 old 的旧模型键
--   （用户 11-23「原模型也换成这个」：M1A1 换成从 Sketchfab 原文件直接转的 m1a1i，没重新导入的照旧用以前的 m1a1）
local function importedFor(d)
  if not IM then return nil end
  local imp = RS:FindFirstChild("Imported")
  local veh = imp and imp:FindFirstChild("Veh")
  local keys = { IM.alias and IM.alias[d.id] }
  local old = IM.old and IM.old[d.id]
  if type(old) == "string" then table.insert(keys, old) end
  for _, key in ipairs(keys) do
    local info = IM.m[key]
    local f = info and veh and veh:FindFirstChild(key)
    if f then
      local n = f:GetAttribute("N")   -- 服务器记的块数：还没全复制过来就先不用（View 等块齐了再重建）
      if n and #f:GetChildren() &lt; n then return nil end
      return key, info, f
    end
  end
  return nil
end
VehModels.importedFor = importedFor

local V = Vector3.new
local CF = CFrame.new
local RGB = Color3.fromRGB
local MAT = Enum.Material
local CYL, BALL = Enum.PartType.Cylinder, Enum.PartType.Ball
-- 「窗帘-1」红外干扰灯在各原模型上的位置（车坐标，炮塔转角 0；用户 11-28「t90我记得有一对红色的车灯 这个一定要还原的跟原车一样」）：
--   gx 炮的横坐标、sx 灯离炮多远、y 灯的中心高、zf 灯盒正面（朝前 −Z）、w / h / d 灯盒宽高深——tools/models 的射线量的：
--   坐在炮塔正面防护块的上沿、紧挨着炮盾两边（T-90A 借 T-90M 的模型）
local SHTORA = { t90m = { gx = -0.094, sx = 1.5, y = 5.86, zf = -4.35, w = 0.85, h = 0.72, d = 0.75 } }
local ALONG_Z = CFrame.Angles(0, math.pi / 2, 0)   -- 圆柱的轴（X）转到 Z（炮管、烟幕弹管）
local UPRIGHT = CFrame.Angles(0, 0, math.pi / 2)  -- 圆柱的轴转到 Y（竖着的圆盘、舱盖）

local CAMO = {
  atk = { base = RGB(86, 100, 68), dark = RGB(60, 70, 48), light = RGB(118, 126, 90) },   -- 解放军：林地绿
  def = { base = RGB(176, 158, 116), dark = RGB(128, 114, 84), light = RGB(198, 184, 146) },   -- 美军：沙色
}
local TRACK, RUBBER, STEEL, GLASS = RGB(44, 44, 46), RGB(28, 28, 30), RGB(70, 72, 74), RGB(40, 54, 62)

-- paint：科技树暂用车的真车涂装（TechTree.paint，{ base, dark, light } 各是 RGB 三元组）；没给就按阵营
function VehModels.build(d, team, mods, paint)
  local C = CAMO[team] or CAMO.atk
  if type(paint) == "table" and paint.base then
    local function c3(t, dflt) return (type(t) == "table") and RGB(t[1], t[2], t[3]) or dflt end
    C = { base = c3(paint.base, C.base), dark = c3(paint.dark, C.dark), light = c3(paint.light, C.light) }
  end
  local m = Instance.new("Model")
  m.Name = d.id
  local parts, wheels = {}, {}
  local rng = Random.new(#d.id * 7919 + (team == "def" and 1 or 0))

  local function add(group, size, off, color, mat, shape, idx)
    local p = Instance.new((shape == "wedge") and "WedgePart" or "Part")
    if shape and shape ~= "wedge" then p.Shape = shape end
    p.Size = size
    p.Color = color
    p.Material = mat or MAT.SmoothPlastic
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.CFrame = off
    p.Parent = m
    table.insert(parts, { p, group, off, idx })
    return p
  end
  local function hull(size, off, color, mat, shape) return add("hull", size, off, color or C.base, mat or MAT.Metal, shape) end
  local function tur(size, off, color, mat, shape) return add("turret", size, off, color or C.base, mat or MAT.Metal, shape) end
  local function gun(size, off, color, mat, shape) return add("gun", size, off, color or C.base, mat or MAT.Metal, shape) end
  -- 一根沿 −Z 的圆管：从 z0 到 z1（z1 更靠前），直径 dia
  local function tube(fn, x, y, z0, z1, dia, color, mat)
    local L = math.abs(z1 - z0)
    return fn(V(L, dia, dia), CF(x, y, (z0 + z1) / 2) * ALONG_Z, color, mat, CYL)
  end
  -- 零件拼的车顶遥控武器站（原模型上没有机枪、或者机枪和炮塔分不开的坦克：99A2、15 式、零件拼的 M10；用户 11-19：坦克的机枪要能转，开火位置要在机枪）：
  --   座圈、武器站的罩子、光电盒子跟着底座转（rws，原点在座圈中心），12.7 毫米机枪（机匣、散热套筒、枪管、弹箱）跟着俯仰（rwg，原点在俯仰轴）；
  --   gunOff 俯仰轴相对座圈中心，muz 枪口在俯仰轴前面多远——枪口正好在服务器算的枪口上（VehDefs.muzzle 的 rws）
  local function rwsMg(gunOff, muz)
    local GM, BL = RGB(54, 56, 52), RGB(30, 31, 30)
    local function rw(size, off, color, mat, shape) return add("rws", size, off, color or C.base, mat or MAT.Metal, shape) end
    local function rg(size, off, color, mat, shape) return add("rwg", size, off, color or GM, mat or MAT.Metal, shape) end
    local gy, gz = gunOff.Y, gunOff.Z
    rw(V(0.22, 1.7, 1.7), CF(0, 0.11, 0) * UPRIGHT, C.dark, MAT.Metal, CYL)   -- 座圈
    rw(V(1.0, math.max(0.3, gy - 0.25), 1.1), CF(0, 0.22 + math.max(0.3, gy - 0.25) / 2, gz * 0.45), C.base)   -- 武器站的罩子（底座）
    rw(V(0.2, 0.55, 0.5), CF(0.42, gy - 0.12, gz), C.base)   -- 枪架右侧板
    rw(V(0.2, 0.55, 0.5), CF(-0.42, gy - 0.12, gz), C.base)   -- 枪架左侧板
    rw(V(0.5, 0.42, 0.58), CF(-0.78, gy + 0.05, gz + 0.05), GM)   -- 光电盒子（左边）
    rw(V(0.22, 0.2, 0.06), CF(-0.78, gy + 0.08, gz - 0.25), RGB(18, 22, 26), MAT.Glass)   -- 镜头
    rg(V(0.42, 0.44, 1.35), CF(0, 0, 0.35), GM)   -- 机匣
    rg(V(0.16, 0.3, 0.26), CF(0, -0.08, 1.12), BL)   -- 后部握把
    tube(rg, 0, 0.04, -0.32, -1.25, 0.26, BL)   -- 散热套筒
    tube(rg, 0, 0.04, -1.25, -muz, 0.14, BL)   -- 枪管
    rg(V(0.11, 0.2, 0.2), CF(0, 0.04, -muz + 0.08), BL)   -- 枪口制退器
    rg(V(0.36, 0.44, 0.62), CF(0.44, -0.04, 0.3), C.base)   -- 弹箱（右边供弹）
  end
  -- 手动的车长重机枪（99A 的 QJC-88 12.7 毫米，用户 11-21 晚：照真车加回车顶机枪）：车长舱口的座圈、枪架立柱和叉架、
  --   机匣、粗枪管、枪口制退器、左边弹箱、后面两个握把、环形瞄具——没有遥控武器站的罩子和光电盒子；照样跟着瞄准转、从枪口开火
  local function manualMg(gunOff, muz)
    local GM, BL, OD = RGB(52, 54, 50), RGB(28, 29, 28), RGB(76, 82, 58)
    local function rw(size, off, color, mat, shape) return add("rws", size, off, color or C.base, mat or MAT.Metal, shape) end
    local function rg(size, off, color, mat, shape) return add("rwg", size, off, color or GM, mat or MAT.Metal, shape) end
    local gy, gz = gunOff.Y, gunOff.Z
    rw(V(0.16, 1.6, 1.6), CF(0, 0.08, 0) * UPRIGHT, C.dark, MAT.Metal, CYL)   -- 舱口座圈
    local postH = math.max(0.3, gy - 0.2)
    rw(V(0.16, postH, 0.16), CF(0, 0.16 + postH / 2, gz), GM)   -- 枪架立柱
    rw(V(0.5, 0.1, 0.2), CF(0, gy - 0.2, gz), GM)   -- 叉架
    rg(V(0.34, 0.36, 1.2), CF(0, 0, 0.32), GM)   -- 机匣
    for sx = -1, 1, 2 do rg(V(0.07, 0.2, 0.07), CF(sx * 0.11, -0.08, 1.0), BL) end   -- 两个握把
    tube(rg, 0, 0.03, -0.28, -muz + 0.25, 0.16, BL)   -- 粗枪管
    rg(V(0.2, 0.2, 0.3), CF(0, 0.03, -muz + 0.12), BL)   -- 枪口制退器
    rg(V(0.32, 0.4, 0.55), CF(-0.36, -0.06, 0.28), OD)   -- 弹箱（左边供弹）
    rg(V(0.03, 0.16, 0.16), CF(0, 0.28, -0.25), BL)   -- 环形瞄具
  end
  -- 一组迷彩斑块（贴在一个面上的薄片）
  local function blotches(fn, cx, cy, cz, w, h, axis, n)
    for _ = 1, n do
      local u, v = (rng:NextNumber() - 0.5) * w, (rng:NextNumber() - 0.5) * h
      local sw, sh = rng:NextNumber(1.2, 3.2), rng:NextNumber(0.6, 1.6)
      if axis == "x" then fn(V(0.06, sh, sw), CF(cx, cy + v, cz + u), C.dark, MAT.SmoothPlastic)
      elseif axis == "y" then fn(V(sw, 0.06, sh), CF(cx + u, cy, cz + v), C.dark, MAT.SmoothPlastic) end
    end
  end

  local W, L, H, hh, clear = d.W, d.L, d.H, d.hullH, d.clear
  local extra = {}   -- 原模型的炮塔 / 炮转轴、悬架行程（View 用）

  ---------------------------------------------------------------- 原模型
  local ikey, info, folder = importedFor(d)
  if ikey then
    local function v3(t) return V(t[1], t[2], t[3]) end
    local tpiv = info.tur and v3(info.tur) or d.turret.pivot
    local gpiv = info.gun and v3(info.gun) or (tpiv + d.gun.pivot)
    -- 遥控武器站（M1A2 的 CROWS）：底座转轴、M2 俯仰轴（用户：机枪也要能转动）
    local rpiv = info.rws and info.rws.p and v3(info.rws.p) or nil
    local rgpiv = info.rws and info.rws.g and v3(info.rws.g) or nil
    -- 坦克不带机枪（VehDefs.TANK_MG，用户 11-22「坦克不要弄哪个机枪」）：原模型里拆出来的机枪（RwsGun）不画，
    --   座圈、观察镜、舱盖（Rws）照旧画、焊死在炮塔上；元数据要求拼的机枪（mk）也不拼
    local noMg = d.noRoofMg == true and d.cat == "tank"
    if noMg then rpiv, rgpiv = nil, nil end
    -- 车轮：每个轮一个弹簧（中心、半径照原模型）；轮式车最前面 d.steer 排转向
    local wix, names = {}, {}
    for g in pairs(info.wheels or {}) do table.insert(names, g) end
    table.sort(names)
    local zs = {}
    for _, g in ipairs(names) do
      local w = info.wheels[g]
      local c = v3(w.c)
      local wi = #wheels + 1
      wheels[wi] = { x = c.X, z = c.Z, r = c.Y, rad = math.max(w.r, 0.3), side = (c.X &lt; 0) and -1 or 1, dy = 0, vy = 0, spin = 0, steer = false }
      wix[g] = wi
      table.insert(zs, c.Z)
    end
    if #wheels == 0 then
      -- 原模型的车轮和车身是一整块（JLTV、M270、M1150、M1A1、96 式……）：照型号表的轮位（按原模型的长宽缩放）放几个看不见的弹簧，
      --   车身照样随地面起伏、俯仰、侧倾
      local hb = info.hull or { info.w, info.h, info.len }   -- 车身的宽、高、长
      local kz, kx = hb[3] / math.max(d.L, 1), hb[1] / math.max(d.W, 1)
      local function spring(x, z, r) wheels[#wheels + 1] = { x = x * kx, z = z * kz, r = r, rad = r, side = (x &lt; 0) and -1 or 1, dy = 0, vy = 0, spin = 0, steer = false } end
      if d.arch == "tracked" and d.rw then
        local R = d.rw
        for s = -1, 1, 2 do
          for i = 1, R.n do spring(s * R.x, R.z0 + (i - 1) * (R.z1 - R.z0) / math.max(R.n - 1, 1), R.r) end
        end
      elseif d.axles then
        for _, z in ipairs(d.axles) do
          for s = -1, 1, 2 do spring(s * d.wx, z, d.wr) end
        end
      end
    end
    if d.arch == "wheeled" and #zs &gt; 0 then
      table.sort(zs)
      local axles = {}
      for _, z in ipairs(zs) do
        if #axles == 0 or z - axles[#axles] &gt; 1.5 then table.insert(axles, z) end
      end
      local lim = axles[math.min(#axles, d.steer or 1)] + 0.75
      for _, w in ipairs(wheels) do w.steer = w.z &lt;= lim end
    end
    local carve = { cav = {}, glass = {}, inside = {} }
    -- carve.py 改过的块换了新名字（rep = 它顶替的旧块）：导入了新块就不用旧块；没重新导入的照旧用旧块
    local replaced = {}
    for name, p in pairs(info.parts) do
      if p.rep and folder:FindFirstChild("V_" .. ikey .. "__" .. name) then
        for _, old in ipairs(p.rep) do replaced[old] = true end
      end
    end
    for name, p in pairs(info.parts) do
      local src = folder:FindFirstChild("V_" .. ikey .. "__" .. name)
      -- k = int：原模型自带的车内（M1A1 的炮塔内饰，拆成 Int_* 十几块）不放进车模——坐进车里时内饰（InteriorAbrams）自己克隆、按组摆（炮尾后坐、握把摆）
      if src and src:IsA("BasePart") and not (noMg and p.g == "RwsGun") and not replaced[name] and p.k ~= "int" then
        local mp = Tint.fix(src:Clone(), src)
        mp.Anchored, mp.CanCollide, mp.CanQuery, mp.CanTouch = true, false, false, false
        mp.Size = v3(p.s)
        -- 原模型里这块本来就没贴图（JLTV、M270 整车都是）：照原材质的颜色上色——Studio 导入时不一定把材质颜色带过来
        local okT, tid = pcall(function() return mp.TextureID end)   -- 不是 MeshPart 的没有这个属性
        if p.col and not mp:FindFirstChildOfClass("SurfaceAppearance") and (not okT or (tid or "") == "") then
          mp.Color = Color3.fromRGB(p.col[1], p.col[2], p.col[3])
          mp.Material = p.met and Enum.Material.Metal or Enum.Material.SmoothPlastic
          if p.a then mp.Transparency = 1 - p.a end
        end
        local c = v3(p.c)
        local grp, off, wi = "hull", CF(c), nil
        if p.g == "Turret" or (noMg and p.g == "Rws") then grp, off = "turret", CF(c - tpiv)
        elseif p.g == "Gun" then grp, off = "gun", CF(c - gpiv)
        elseif p.g == "Rws" and rpiv then grp, off = "rws", CF(c - rpiv)
        elseif p.g == "RwsGun" and rgpiv then grp, off = "rwg", CF(c - rgpiv)
        elseif wix[p.g] then
          wi = wix[p.g]
          local w = wheels[wi]
          grp, off = "wheel", CF(c - V(w.x, w.r, w.z))
        end
        off = off * TURN   -- 绕这块自己的中心补回导入时转掉的半圈
        mp.CFrame = off
        -- 从原车挖出来的内腔（tools/models/carve.py，用户 11-23「在原车内部雕刻出来内饰」）：k = cav 内壁（平时藏着，坐进车里 Interior 显示）、
        --   glass 车窗玻璃（透明：车里看出去、车外看进来）、inside 原模型自带的简易内饰（坐进车里时藏起来，换成真内饰）
        if p.k == "cav" then
          if p.col then mp.Color = Color3.fromRGB(p.col[1], p.col[2], p.col[3]) end
          mp.Material = (p.m and Enum.Material[p.m]) or MAT.SmoothPlastic
          mp.CastShadow = false
          mp.Transparency = 1
          table.insert(carve.cav, mp)
        elseif p.k == "glass" then
          mp.Transparency = math.max(mp.Transparency, 1 - (p.a or 0.35))
          mp.CastShadow = false
          table.insert(carve.glass, mp)
        elseif p.k == "inside" then
          table.insert(carve.inside, mp)
        elseif p.k == "radar" then   -- 原模型拆出来的搜索雷达天线（铠甲-S1，blveh.json 的 label Radar）：View.lua 让带 Radar 的块一直转
          mp:SetAttribute("Radar", true)
        end
        mp.Parent = m
        table.insert(parts, { mp, grp, off, wi })
      end
    end
    -- 原模型没有机枪的（悍马 M998 软篷）：篷顶上补一挺零件拼的 M2——座圈、枪盾、枪架跟着炮塔转，枪身跟着俯仰，
    --   枪口正好在服务器算的炮口上（耳轴前 d.gun.len；用户：很多载具的机枪塔没法旋转、开火位置要对）
    if info.mg == "m2" then
      local GM, BL, OD = RGB(46, 48, 46), RGB(28, 29, 28), RGB(74, 80, 58)
      local gy = (gpiv - tpiv).Y   -- 枪架高
      tur(V(0.3, 3.0, 3.0), CF(0, 0.15, 0) * UPRIGHT, C.dark, MAT.Metal, CYL)   -- 座圈
      for sx = -1, 1, 2 do   -- 正面枪盾：左右两块，中间留出枪管的缝
        tur(V(1.05, 1.25, 0.12), CF(sx * 0.66, 0.95, -1.3), C.base)
        tur(V(0.12, 1.1, 0.8), CF(sx * 1.22, 0.9, -0.95) * CFrame.Angles(0, sx * 0.45, 0), C.base)   -- 侧翼
      end
      tur(V(0.24, gy, 0.24), CF(0, gy / 2, 0.1), GM)   -- 枪架立柱
      gun(V(0.5, 0.58, 1.7), CF(0, 0.1, 0.1), GM)   -- 机匣
      gun(V(0.14, 0.36, 0.26), CF(0, 0.05, 1.05), BL)   -- 握把
      tube(gun, 0, 0.12, -0.75, -1.85, 0.3, BL)   -- 散热套筒
      tube(gun, 0, 0.12, -1.85, -d.gun.len, 0.17, BL)   -- 枪管
      gun(V(0.4, 0.5, 0.78), CF(-0.48, -0.06, 0.05), OD)   -- 弹箱（M2 从左边供弹）
    end
    -- 原模型上没有机枪（或者去掉了）的坦克：元数据的 rws.mk——在座圈上拼一个遥控武器站（tools/models/vehrws.py）
    if info.rws and info.rws.mk and rpiv and rgpiv then
      if info.rws.mk == "manual" then manualMg(rgpiv - rpiv, info.rws.muz or 2.45) else rwsMg(rgpiv - rpiv, info.rws.muz or 2.45) end
    end
    extra = { imported = ikey, tpiv = tpiv, gpiv = gpiv - tpiv, travel = (d.arch == "tracked") and 0.12 or d.travel,
      rpiv = rpiv and (rpiv - tpiv) or nil, rgpiv = (rpiv and rgpiv) and (rgpiv - rpiv) or nil, carve = (#carve.cav &gt; 0) and carve or nil }
  end

  if not ikey then
  -- 零件拼的：炮塔、炮按型号表原来的转轴摆（VehDefs 的转轴照原模型改过，给导入了原模型的用；服务器的炮口照原模型，差一两格）
  extra.tpiv, extra.gpiv = d.turret and d.turret.pivot0, d.gun and d.gun.pivot0
  ---------------------------------------------------------------- 行走部分

  if d.arch == "tracked" then
    local R = d.rw
    local tw = math.max(1.2, W * 0.16)   -- 履带宽
    local spacing = (R.z1 - R.z0) / (R.n - 1)
    for s = -1, 1, 2 do
      local x = s * R.x
      for i = 1, R.n do
        local z = R.z0 + (i - 1) * spacing
        local wi = #wheels + 1
        wheels[wi] = { x = x, z = z, r = R.r, side = s, dy = 0, vy = 0, spin = 0, steer = false }
        add("wheel", V(tw * 0.8, R.r * 2, R.r * 2), CF(), RUBBER, MAT.SmoothPlastic, CYL, wi)
        add("wheel", V(tw * 0.84, R.r * 1.2, R.r * 1.2), CF(), C.dark, MAT.Metal, CYL, wi)
        add("wheel", V(tw * 0.86, R.r * 1.5, 0.25), CF(), STEEL, MAT.Metal, nil, wi)   -- 辐条（看得出在转）
        add("seg", V(tw, 0.32, spacing * 1.04), CF(x, 0.16, z), TRACK, MAT.DiamondPlate, nil, wi)   -- 下面这一段履带跟着轮
      end
      -- 上面一段履带、主动轮（前）、诱导轮（后）、前后斜着的两段
      local ytop = R.r * 2 + 0.18
      local zf, zb = R.z0 - R.r * 1.35, R.z1 + R.r * 1.25
      hull(V(tw, 0.32, R.z1 - R.z0 + R.r * 1.6), CF(x, ytop, (R.z0 + R.z1) / 2), TRACK, MAT.DiamondPlate)
      hull(V(tw * 0.9, R.r * 1.7, R.r * 1.7), CF(x, R.r * 1.35, zf), STEEL, MAT.Metal, CYL)
      hull(V(tw * 0.9, R.r * 1.6, R.r * 1.6), CF(x, R.r * 1.3, zb), STEEL, MAT.Metal, CYL)
      for _, e in ipairs({ { R.z0, zf, -1 }, { R.z1, zb, 1 } }) do
        local a = V(x, 0.2, e[1] + e[3] * R.r * 0.3)
        local b = V(x, ytop, e[2] + e[3] * R.r * 0.2)
        local mid, len = (a + b) / 2, (b - a).Magnitude
        hull(V(tw, 0.32, len), CFrame.lookAt(mid, b), TRACK, MAT.DiamondPlate)
      end
      if d.skirt then   -- 侧裙板：盖住负重轮上半截
        hull(V(0.3, R.r * 1.25, R.z1 - R.z0 + R.r * 2.4), CF(s * (W / 2 - 0.15), R.r * 1.75, (R.z0 + R.z1) / 2 - R.r * 0.3), C.base, MAT.Metal)
        blotches(hull, s * (W / 2), R.r * 1.75, (R.z0 + R.z1) / 2, R.z1 - R.z0, R.r, "x", 3)
      end
    end
  else
    local wx, wr, ww = d.wx, d.wr, d.ww
    for ai, z in ipairs(d.axles) do
      for s = -1, 1, 2 do
        local wi = #wheels + 1
        wheels[wi] = { x = s * wx, z = z, r = wr, side = s, dy = 0, vy = 0, spin = 0, steer = ai &lt;= (d.steer or 1) }
        add("wheel", V(ww, wr * 2, wr * 2), CF(), RUBBER, MAT.SmoothPlastic, CYL, wi)
        add("wheel", V(ww + 0.06, wr * 1.1, wr * 1.1), CF(), C.dark, MAT.Metal, CYL, wi)
        add("wheel", V(ww + 0.1, wr * 0.45, wr * 0.45), CF(), STEEL, MAT.Metal, CYL, wi)
        add("wheel", V(ww + 0.08, wr * 1.6, 0.22), CF(), RUBBER, MAT.SmoothPlastic, nil, wi)   -- 胎面花纹（看得出在转）
        -- 挡泥板（跟车体）
        hull(V(ww + 0.5, 0.25, wr * 2.3), CF(s * wx, wr * 2 + 0.55, z), C.dark, MAT.Metal)
      end
    end
  end

  ---------------------------------------------------------------- 车体

  if d.arch == "tracked" then
    local tw = math.max(1.2, W * 0.16)
    local inner = W - 2 * tw - 0.3
    hull(V(inner, hh - clear - 0.7, L * 0.94), CF(0, clear + (hh - clear - 0.7) / 2, 0), C.base)   -- 下车体
    hull(V(W, 0.75, L * 0.9), CF(0, hh - 0.375, L * 0.03), C.base)   -- 上车体（翼子板一直伸到履带上面）
    -- 首上（斜面朝前上）、首下（斜面朝前下）
    hull(V(W * 0.96, 1.5, 3.2), CF(0, hh - 0.75 - 0.75 + 0.75, -L / 2 + 1.0), C.base, MAT.Metal, "wedge")
    hull(V(inner, hh - clear - 1.2, 2.0), CF(0, clear + (hh - clear - 1.2) / 2, -L / 2 + 0.2) * CFrame.Angles(0, 0, math.pi), C.dark, MAT.Metal, "wedge")
    -- 发动机舱：散热格栅、排气口
    for i = 0, 3 do hull(V(W * 0.62, 0.12, 0.5), CF(0, hh + 0.06, L * 0.18 + i * 1.1), C.dark, MAT.DiamondPlate) end
    hull(V(W * 0.7, 0.9, 0.35), CF(0, hh - 0.9, L / 2 - 0.1), C.dark)
    hull(V(1.2, 0.5, 0.4), CF(W * 0.28, hh - 0.6, L / 2 + 0.1), RGB(36, 36, 36))
    -- 车灯、牵引钩、工具箱
    for s = -1, 1, 2 do
      hull(V(0.5, 0.35, 0.3), CF(s * W * 0.36, hh - 0.5, -L / 2 + 0.3), RGB(220, 220, 200), MAT.Glass)
      hull(V(0.5, 0.5, 0.6), CF(s * W * 0.22, clear + 0.5, -L / 2 - 0.1), STEEL)
      hull(V(0.9, 0.7, 3.2), CF(s * (W / 2 - 0.5), hh + 0.35, L * 0.22), C.dark)
    end
    if d.era then   -- 首上的反应装甲块
      for i = -3, 3 do
        for j = 0, 1 do hull(V(0.95, 0.35, 0.9), CF(i * 1.05, hh - 0.35 + j * 0.15, -L / 2 + 1.9 + j * 1.0), C.light, MAT.Metal) end
      end
    end
    if d.plow then   -- 扫雷犁
      hull(V(W * 0.92, 1.4, 0.4), CF(0, 0.9, -L / 2 - 1.6) * CFrame.Angles(math.rad(-25), 0, 0), STEEL, MAT.DiamondPlate)
      for i = -3, 3 do hull(V(0.28, 1.0, 1.2), CF(i * 1.3, 0.45, -L / 2 - 2.1), STEEL) end
    end
    if d.boat then   -- 两栖车：前面的防浪板
      hull(V(W * 0.9, 1.8, 0.3), CF(0, hh - 0.3, -L / 2 - 0.3) * CFrame.Angles(math.rad(35), 0, 0), C.dark)
    end
    if d.cab then   -- M270：前面的驾驶室
      hull(V(W * 0.86, 2.6, 5.6), CF(0, hh + 1.3, -L / 2 + 3.2), C.base)
      hull(V(W * 0.8, 1.0, 0.1), CF(0, hh + 1.9, -L / 2 + 0.38), GLASS, MAT.Glass)
    end
    blotches(hull, 0, hh + 0.01, 0, W * 0.8, L * 0.6, "y", 4)
  else
    local bw = W * 0.9
    if d.light then   -- 悍马、JLTV：低车身 + 发动机罩 + 乘员舱
      hull(V(bw, hh * 0.38, L * 0.96), CF(0, clear + hh * 0.19 + 0.3, 0), C.base)
      hull(V(bw * 0.96, 1.2, L * 0.36), CF(0, clear + hh * 0.38 + 0.9, -L * 0.3), C.base, MAT.Metal, "wedge")
      hull(V(bw, hh * 0.42, L * 0.56), CF(0, clear + hh * 0.38 + hh * 0.21 + 0.3, L * 0.14), C.base)
      for s = -1, 1, 2 do
        hull(V(0.08, hh * 0.24, L * 0.36), CF(s * (bw / 2 + 0.02), clear + hh * 0.66, L * 0.12), GLASS, MAT.Glass)
      end
      hull(V(bw * 0.86, hh * 0.24, 0.1), CF(0, clear + hh * 0.66, -L * 0.15), GLASS, MAT.Glass)
    elseif d.truck then   -- 卡车底盘：驾驶室在前、后面平板上装家伙
      hull(V(bw, 0.9, L * 0.96), CF(0, clear + 0.45, 0), C.dark)
      hull(V(bw, 3.4, 5.4), CF(0, clear + 0.9 + 1.7, -L / 2 + 2.8), C.base)
      hull(V(bw * 0.9, 1.2, 0.1), CF(0, clear + 3.0, -L / 2 + 0.06), GLASS, MAT.Glass)
      hull(V(bw, 0.5, L - 6), CF(0, hh - 0.25, 3.0), C.base)
      for s = -1, 1, 2 do hull(V(0.6, 0.35, 0.25), CF(s * bw * 0.36, clear + 1.4, -L / 2 + 0.05), RGB(220, 220, 200), MAT.Glass) end
    else   -- 装甲车：车身 + 前面的斜板 + 车顶
      hull(V(bw, hh - clear - 0.9, L * 0.94), CF(0, clear + (hh - clear - 0.9) / 2, 0.2), C.base)
      hull(V(bw, 1.8, 3.4), CF(0, hh - 0.9 - 0.9 + 0.9, -L / 2 + 1.5), C.base, MAT.Metal, "wedge")
      hull(V(bw, hh - clear - 2.6, 1.6), CF(0, clear + (hh - clear - 2.6) / 2, -L / 2 + 0.7) * CFrame.Angles(0, 0, math.pi), C.dark, MAT.Metal, "wedge")
      hull(V(bw * 0.96, 0.9, L * 0.78), CF(0, hh - 0.45, L * 0.08), C.base)
      hull(V(bw * 0.5, hh - clear - 1.4, 0.3), CF(0, clear + (hh - clear - 1.4) / 2 + 0.3, L / 2 + 0.05), C.dark)   -- 后门
      for s = -1, 1, 2 do
        hull(V(0.5, 0.3, 0.25), CF(s * bw * 0.34, hh - 1.4, -L / 2 + 0.25), RGB(220, 220, 200), MAT.Glass)
        hull(V(0.9, 0.8, 3.0), CF(s * (bw / 2 + 0.2), hh - 1.3, L * 0.2), C.dark)
      end
      if d.boat then hull(V(bw, 1.6, 0.3), CF(0, hh - 0.6, -L / 2 - 0.4) * CFrame.Angles(math.rad(35), 0, 0), C.dark) end
    end
    blotches(hull, 0, hh + 0.01, 0, bw * 0.7, L * 0.5, "y", 3)
  end

  ---------------------------------------------------------------- 炮塔（坐标系：转轴在原点，−Z 朝前）

  local T = d.turret
  local s = T.size
  local st = T.style
  if st == "wedge" or st == "round" or st == "abrams" then
    if st == "round" then
      tur(V(s.Y, s.X * 0.95, s.X * 0.95), CF(0, s.Y / 2, s.Z * 0.02) * UPRIGHT, C.base, MAT.Metal, CYL)
    else
      tur(V(s.X * 0.86, s.Y, s.Z * 0.66), CF(0, s.Y / 2, s.Z * 0.1), C.base)
    end
    -- 前面两块斜的（楔形装甲 / 反应装甲）
    for sx = -1, 1, 2 do
      local blk = tur(V(s.X * 0.36, s.Y * 0.92, s.Z * 0.42), CF(sx * s.X * 0.24, s.Y * 0.47, -s.Z * 0.33) * CFrame.Angles(0, sx * math.rad(st == "abrams" and 12 or 26), 0),
        (d.era and C.light) or C.base)
      if d.era then
        for i = 0, 2 do tur(V(s.X * 0.37, 0.12, 0.9), CF(sx * s.X * 0.24, s.Y * 0.95, -s.Z * 0.2 - i * 1.0), C.dark, MAT.SmoothPlastic) end
      end
    end
    if T.bustle then tur(V(s.X * 0.72, s.Y * 0.78, T.bustle), CF(0, s.Y * 0.45, s.Z / 2 + T.bustle / 2 - 0.4), C.base) end
    -- 舱盖、观瞄、天线
    tur(V(0.25, 1.4, 1.4), CF(d.cupola and d.cupola.X or 1.4, s.Y + 0.12, d.cupola and d.cupola.Z or 0.2) * UPRIGHT, C.dark, MAT.Metal, CYL)
    tur(V(0.25, 1.2, 1.2), CF(-1.2, s.Y + 0.12, 0.6) * UPRIGHT, C.dark, MAT.Metal, CYL)
    tur(V(0.9, 0.8, 1.1), CF(d.sight.X, s.Y + 0.4, d.sight.Z), C.dark)   -- 炮长镜
    tur(V(0.15, 0.15, 1.4), CF(d.sight.X, s.Y + 0.4, d.sight.Z - 0.6) * CFrame.Angles(0, 0, 0), GLASS, MAT.Glass)
    if d.citv then tur(V(1.0, 1.2, 1.0), CF(d.citv.X, s.Y + 0.6, d.citv.Z), C.dark) end
    if not d.rws and not d.noRoofMg then   -- 车长机枪（有遥控武器站的换成会转的，下面拼；99A 车顶不放机枪）
      tur(V(0.6, 0.6, 1.4), CF((d.cupola and d.cupola.X or 1.4), s.Y + 0.6, (d.cupola and d.cupola.Z or 0.2) - 0.6), RGB(40, 42, 44))
    end
    for sx = -1, 1, 2 do tur(V(0.1, 7, 0.1), CF(sx * s.X * 0.32, s.Y + 3.5, s.Z * 0.42), RGB(30, 30, 30), MAT.Metal, CYL) end
    blotches(tur, 0, s.Y + 0.01, 0, s.X * 0.6, s.Z * 0.6, "y", 3)
  elseif st == "ifv" then
    tur(V(s.X, s.Y, s.Z * 0.8), CF(0, s.Y / 2, s.Z * 0.1), C.base)
    tur(V(s.X * 0.9, s.Y * 0.9, s.Z * 0.3), CF(0, s.Y * 0.45, -s.Z * 0.45), C.base, MAT.Metal, "wedge")
    tur(V(0.8, 0.7, 0.9), CF(d.sight.X, s.Y + 0.35, d.sight.Z), C.dark)
    tur(V(0.25, 1.1, 1.1), CF(0.9, s.Y + 0.12, 0.6) * UPRIGHT, C.dark, MAT.Metal, CYL)
    if T.tow then tur(V(1.2, 1.4, 3.0), CF(s.X / 2 + 0.6, s.Y * 0.6, 0.4), C.dark) end   -- 布雷德利的陶式发射箱
    if T.pods then
      for sx = -1, 1, 2 do tur(V(1.0, 1.4, 2.4), CF(sx * (s.X / 2 + 0.55), s.Y * 0.6, 0.2), C.dark) end
    end
    tur(V(0.1, 6, 0.1), CF(-s.X * 0.35, s.Y + 3, s.Z * 0.4), RGB(30, 30, 30), MAT.Metal, CYL)
  elseif st == "rws" or st == "ring" then
    if st == "ring" then
      tur(V(0.4, s.X, s.X), CF(0, 0.2, 0) * UPRIGHT, C.dark, MAT.Metal, CYL)
      tur(V(1.8, 1.2, 0.15), CF(0, 1.0, -0.9), C.base)   -- 枪盾
      for sx = -1, 1, 2 do tur(V(0.15, 1.0, 1.0), CF(sx * 0.95, 0.9, -0.5) * CFrame.Angles(0, sx * 0.5, 0), C.base) end
    else
      tur(V(1.3, 0.7, 1.3), CF(0, 0.35, 0), C.dark)
      tur(V(0.7, 0.6, 0.7), CF(0.75, 1.0, -0.2), C.dark)   -- 光电
    end
  elseif st == "spaag" then
    tur(V(s.X * 0.7, s.Y, s.Z), CF(0, s.Y / 2, 0), C.base)
    tur(V(s.X * 0.66, s.Y * 0.7, s.Z * 0.3), CF(0, s.Y * 0.35, -s.Z * 0.55), C.base, MAT.Metal, "wedge")
    -- 后上方的搜索雷达（一直转：标记 Radar）、前面的跟踪雷达
    local rd = tur(V(0.25, 3.4, 1.4), CF(0, s.Y + 1.6, s.Z * 0.3), STEEL, MAT.Metal)
    rd:SetAttribute("Radar", true)
    tur(V(0.3, 0.3, 1.4), CF(0, s.Y + 0.7, s.Z * 0.3), STEEL, MAT.Metal, CYL)
    tur(V(0.6, 1.1, 1.1), CF(0, s.Y + 0.5, -s.Z * 0.3) * ALONG_Z, C.dark, MAT.Metal, CYL)
  elseif st == "vulcan" then
    tur(V(s.X, s.Y * 0.7, s.Z), CF(0, s.Y * 0.35, 0), C.base)
    if T.dome then   -- C-RAM：白色雷达罩
      tur(V(1.8, 1.8, 1.8), CF(0, s.Y + 0.6, 0.8), RGB(230, 230, 225), MAT.SmoothPlastic, BALL)
      tur(V(1.0, 1.8, 1.8), CF(0, s.Y - 0.1, 0.8) * UPRIGHT, RGB(230, 230, 225), MAT.SmoothPlastic, CYL)
    elseif T.radar then
      local rd = tur(V(0.2, 2.4, 1.2), CF(0, s.Y + 1.2, s.Z * 0.35), STEEL)
      rd:SetAttribute("Radar", true)
    else
      tur(V(1.2, 1.0, 0.8), CF(s.X * 0.35, s.Y * 0.85, s.Z * 0.2), C.dark)   -- 测距雷达
    end
  elseif st == "sph" then
    tur(V(s.X, s.Y, s.Z), CF(0, s.Y / 2, 0), C.base)
    tur(V(s.X * 0.96, s.Y * 0.5, 1.6), CF(0, s.Y * 0.75, -s.Z / 2 - 0.4), C.base, MAT.Metal, "wedge")
    for sx = -1, 1, 2 do tur(V(0.1, s.Y * 0.6, 2.2), CF(sx * (s.X / 2 + 0.03), s.Y * 0.45, 0.6), C.dark) end   -- 侧门
    tur(V(0.25, 1.4, 1.4), CF(s.X * 0.28, s.Y + 0.12, s.Z * 0.15) * UPRIGHT, C.dark, MAT.Metal, CYL)
    tur(V(0.6, 0.6, 1.4), CF(s.X * 0.28, s.Y + 0.6, s.Z * 0.15 - 0.6), RGB(40, 42, 44))
    blotches(tur, 0, s.Y + 0.01, 0, s.X * 0.6, s.Z * 0.6, "y", 3)
  elseif st == "launcher" then
    tur(V(s.X * 0.8, 0.8, s.Z * 0.5), CF(0, 0.4, 0), C.dark)
  end

  ---------------------------------------------------------------- 炮（坐标系：耳轴在原点，−Z 朝前，跟着俯仰）

  local Gd = setmetatable({ len = d.gun.len0 or d.gun.len, pivot = d.gun.pivot0 or d.gun.pivot }, { __index = d.gun })   -- 炮管长、耳轴也照型号表原来的
  if st == "launcher" then   -- 发射箱整个跟着起竖：前端一格格的管口
    gun(V(s.X, s.Y, s.Z), CF(0, s.Y / 2 + 0.4, 0), C.base)
    local nx, ny = 3, 2
    for i = 0, nx - 1 do
      for j = 0, ny - 1 do
        gun(V(s.X / nx * 0.8, s.Y / ny * 0.8, 0.1), CF((i - (nx - 1) / 2) * s.X / nx, 0.4 + (j + 0.5) * s.Y / ny, -s.Z / 2 - 0.02), RGB(26, 26, 28))
      end
    end
  elseif Gd.len &gt; 0 then
    if st ~= "rws" and st ~= "ring" then gun(V(math.min(s.X * 0.4, 3.0), Gd.cal * 3.6 + 0.6, 1.6), CF(0, 0, -0.4), C.base) end   -- 防盾
    if Gd.gatling then
      for k = 0, 5 do
        local a = k * math.pi / 3
        tube(gun, math.cos(a) * Gd.cal * 0.55, math.sin(a) * Gd.cal * 0.55, -0.6, -Gd.len, Gd.cal * 0.32, RGB(40, 40, 42))
      end
      tube(gun, 0, 0, -0.6, -1.6, Gd.cal * 1.7, RGB(50, 50, 52))
    elseif T.twin then   -- 双管高炮：炮塔两侧各一门
      for sx = -1, 1, 2 do
        gun(V(1.1, 1.3, 3.0), CF(sx * T.twin / 2, 0, -0.6), C.dark)
        tube(gun, sx * T.twin / 2, 0, -2.0, -Gd.len, Gd.cal, RGB(46, 48, 50))
        tube(gun, sx * T.twin / 2, 0, -Gd.len + 0.6, -Gd.len, Gd.cal * 1.6, RGB(46, 48, 50))
      end
    else
      tube(gun, 0, 0, -0.6, -Gd.len, Gd.cal, RGB(52, 54, 52))
      tube(gun, 0, 0, -0.9, -Gd.len * 0.5, Gd.cal * 1.18, C.base)   -- 热护套
      if Gd.fume then tube(gun, 0, 0, -Gd.len * 0.42, -Gd.len * 0.55, Gd.cal * 1.7, C.base) end
      if Gd.brake then gun(V(Gd.cal * 2.4, Gd.cal * 1.5, Gd.cal * 2.8), CF(0, 0, -Gd.len), RGB(48, 50, 50)) end
    end
    if d.coax then   -- 并列机枪口
      local c = d.coax - Gd.pivot
      tube(gun, c.X, c.Y, -0.2, -1.4, 0.2, RGB(30, 30, 30))
    end
  end

  ---------------------------------------------------------------- 烟幕弹发射筒（和 VehDefs.smokeTubes 一样的位置、朝向）

  local S = d.smoke
  if S then
    for _, b in ipairs(S.banks) do
      local fn = b.hull and hull or tur
      local frame = b.hull and (CF(0, hh, 0) * CF(b.at)) or CF(b.at)
      fn(V(1.1, 0.5, 0.9), frame * CF(0, -0.3, 0.1), C.dark)   -- 发射架
      for i = 1, S.n do
        local fan = (S.n &gt; 1) and ((i - 1) / (S.n - 1) - 0.5) or 0
        local yaw2 = math.rad(b.yaw + fan * 40 * (b.yaw &gt;= 0 and 1 or -1))
        local cf = frame * CF(fan * 0.9, (i % 2) * 0.35, 0) * CFrame.Angles(0, -yaw2, 0) * CFrame.Angles(math.rad(35), 0, 0)
        fn(V(0.85, 0.34, 0.34), cf * CF(0, 0, -0.3) * ALONG_Z, RGB(54, 58, 50), MAT.Metal, CYL)
        fn(V(0.05, 0.26, 0.26), cf * CF(0, 0, -0.74) * ALONG_Z, RGB(20, 20, 20), MAT.SmoothPlastic, CYL)   -- 管口
      end
    end
  end

  -- 零件拼的坦克（M10；还有没导入原模型时的退路）：车长位上拼一个会转的遥控武器站（VehDefs 给的 d.rws）
  if d.rws and d.rws.gun then
    rwsMg(d.rws.gun, d.rws.len or 2.45)
    extra.rpiv, extra.rgpiv = d.rws.pivot, d.rws.gun
  end
  end   -- 零件拼的（没有原模型时）

  -- 扬尘：后轮那里两个隐形发射点
  local dust = {}
  for _, s2 in ipairs({ -1, 1 }) do
    local p = hull(V(0.2, 0.2, 0.2), CF(s2 * W * 0.4, 0.4, L * 0.45), C.base)
    p.Transparency = 1
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
    pe.Rate = 0
    -- 尘柱：一团团往后、往上慢慢胀开、飘好几秒（Arma 里车后那一长条黄土），颜色和浓淡按脚下的地面在 View.lua 里换
    pe.Lifetime = NumberRange.new(2.6, 5.2)
    pe.Speed = NumberRange.new(3, 8)
    pe.SpreadAngle = Vector2.new(40, 25)
    pe.Acceleration = V(0, 1.6, 0)
    pe.Drag = 0.9
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-12, 12)
    pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3), NumberSequenceKeypoint.new(0.35, 10), NumberSequenceKeypoint.new(1, 19) })
    pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(0.4, 0.62), NumberSequenceKeypoint.new(1, 1) })
    pe.Color = ColorSequence.new(RGB(170, 146, 110))
    pe.EmissionDirection = Enum.NormalId.Back
    pe.LightInfluence = 1
    pe.Parent = p
    table.insert(dust, pe)
  end

  -- 排气（用户 11-20：载具照 UE5 的水平升级）：车尾两侧两个排气口——柴油机加油门、换挡那一下喷一股浓黑烟，怠速淡淡一缕；
  --   燃气轮机（M1 系列、T-80 系列：VehDefs 的 turbine）是淡灰的热气。浓淡在 View.lua 按油门 / 加速度调
  --   （原来写死 m1a1 / m1a2：拆出来的 M1、IPM1、M1A1 HC、M1A2 / SEP / SEPv3 照样是燃气轮机，同 Drive.lua 的发动机声）
  local exhaust = {}
  local turbine = d.turbine == true
  for _, s2 in ipairs({ -1, 1 }) do
    local p = hull(V(0.2, 0.2, 0.2), CF(s2 * W * 0.3, hh * 0.92, L * 0.44), C.base)
    p.Transparency = 1
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
    pe.Rate = 0
    pe.Lifetime = NumberRange.new(1.1, 2.4)
    pe.Speed = NumberRange.new(2.5, 5)
    pe.SpreadAngle = Vector2.new(18, 18)
    pe.Acceleration = V(0, 3.2, 0)
    pe.Drag = 1.2
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-25, 25)
    pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(0.3, 2.6), NumberSequenceKeypoint.new(1, 6.5) })
    pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, turbine and 0.82 or 0.45), NumberSequenceKeypoint.new(0.5, turbine and 0.9 or 0.7),
      NumberSequenceKeypoint.new(1, 1) })
    pe.Color = ColorSequence.new(turbine and RGB(150, 150, 146) or RGB(34, 33, 31))
    pe.EmissionDirection = Enum.NormalId.Top
    pe.LightInfluence = 1
    pe.Parent = p
    table.insert(exhaust, pe)
  end

  -- 被毁后的火、黑烟（平时关着）
  local fireP = hull(V(0.2, 0.2, 0.2), CF(0, hh + 0.5, 0), C.base)
  fireP.Transparency = 1
  local fire = Instance.new("ParticleEmitter")
  fire.Texture = "rbxasset://textures/particles/fire_main.dds"
  fire.Rate = 0
  fire.Lifetime = NumberRange.new(0.6, 1.2)
  fire.Speed = NumberRange.new(4, 8)
  fire.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 1) })
  fire.Color = ColorSequence.new(RGB(255, 170, 60), RGB(255, 80, 30))
  fire.LightEmission = 1
  fire.Parent = fireP
  local black = Instance.new("ParticleEmitter")
  black.Texture = "rbxasset://textures/particles/smoke_main.dds"
  black.Rate = 0
  black.Lifetime = NumberRange.new(4, 7)
  black.Speed = NumberRange.new(6, 10)
  black.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 4), NumberSequenceKeypoint.new(1, 18) })
  black.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
  black.Color = ColorSequence.new(RGB(30, 30, 30))
  black.Parent = fireP

  -- 夜里的车灯：前面两盏（轮式车是大灯，射灯照前面的路；履带车是暗的灯火管制灯）、后面两盏红尾灯；有人开才亮（View.lua）
  local lamps = {}
  local function lampPart(off, color, size)
    local p = add("hull", V(size, size * 0.7, 0.15), off, color, MAT.Neon)
    p.CastShadow = false
    table.insert(lamps, p)
    return p
  end
  local wheeled = d.arch == "wheeled"
  for sd = -1, 1, 2 do
    local fl = lampPart(CF(sd * d.W * 0.36, d.hullH * 0.62, -d.L / 2 - 0.05), wheeled and RGB(255, 244, 214) or RGB(255, 186, 120), wheeled and 0.55 or 0.3)
    if wheeled then
      local sl = Instance.new("SpotLight")
      sl.Face, sl.Angle, sl.Range, sl.Brightness, sl.Color, sl.Shadows = Enum.NormalId.Front, 55, 70, 3.2, RGB(255, 240, 210), false   -- 自己开的才投影子（View.lua）
      sl.Parent = fl
    end
    local tl = lampPart(CF(sd * d.W * 0.4, d.hullH * 0.55, d.L / 2 + 0.05), RGB(255, 40, 30), 0.32)
    local pl = Instance.new("PointLight")
    pl.Range, pl.Brightness, pl.Color, pl.Shadows = 6, 0.8, RGB(255, 40, 30), false
    pl.Parent = tl
  end

  ---------------------------------------------------------------- 改装（TankMods / EraMeta）
  --   用户 11-22 晚：「坦克要能自己选位置贴爆反」「要能有一整套的坦克改装体系」「坦克上面就别贴了」「别挡住一些部位」
  --   爆反：一格一格按改装（TankMods.cellsOn）贴；原模型上本来就有的格（own）平时不画，只记位置（被炸掉时 View 补焦黑的空位）；
  --     型号：FY-2 / FY-4 是砖（导入的 Kontakt-1 砖网格，重型的盒子厚 1.35 倍）、ARAT-1（M19）是方盒子瓦、ARAT-2（M32）叠在 M19 外面的弯瓦（原车自带的 M19 外面也叠）
  --   主动防护：GL5 炮塔四角各一个发射单元（带毫米波雷达）；Trophy 两侧各一个能转的发射器 + 四角四块雷达平板
  --   激光告警：炮塔前角、后角的告警探头（JD-3 多一个激光干扰头）
  --   栅栏装甲：车尾、侧面后段（发动机舱外）、炮塔尾部后面，离车身约半米的一排扁钢条
  --   扫雷犁：车头前面一整排犁齿 + 犁板 + 两侧滑橇，两根臂挂在车头下沿；组 plow，按模型属性 Plow 放下 / 升起（View 摆）
  --   多光谱伪装网：炮塔两侧、后面，车体侧面、后面一片片的网（不盖车顶、不挡观瞄）
  --   车底防雷板：车底一整块（从侧面低处才看得到）
  --   车顶加特林（kit 组）：坦克不带机枪以后不用了，代码留着
  local era, kpiv, plowPiv = {}, nil, nil
  local mm = TM.applyDef(d, mods)
  mm = mm and mm.mods
  local L = TM.eraOf(d.id)
  local tp = extra.tpiv or (d.turret and d.turret.pivot) or V()
  if L then
    local kit = RS:FindFirstChild("Imported") and RS.Imported:FindFirstChild("Veh") and RS.Imported.Veh:FindFirstChild("kitera")
    local brickMesh = kit and kit:FindFirstChild("V_kitera__Body_1")
    local function rel(g, cf) if g == "t" then return CF(-tp) * cf end return cf end
    local on = TM.cellsOn(d.id, mm)
    local ET = mm and TM.ERA[mm.era] or nil
    local th = (ET and ET.th) or 1
    local arat = mm and (mm.era == "arat" or mm.era == "arat2")
    for i, b in ipairs(L.b) do
      local own = TM.own(L, b)
      local fitted = on[i] == true
      local cf, w, h, t = TM.blockCF(L, b, CF(), 0, own and 1 or th)
      local g = (b[1] == "t") and "turret" or "hull"
      local e = { g = g, off = rel(b[1], cf), w = w, h = h, t = t, own = own, parts = {}, off2 = not fitted }   -- off2：这一格没贴（不画、炸不着）
      if fitted and extra.imported then
        local col = RGB(b[14], b[15], b[16])
        local base = rel(b[1], cf)
        local function put(size, o, color, mat, shape, tr)
          local p = add(g, size, base * o, color, mat, shape)
          if tr then p.Transparency = tr end
          p.CastShadow = size.Z &gt; 0.1
          table.insert(e.parts, p)
          return p
        end
        if not own and arat then
          -- ARAT-1（M19）：扁方盒，外面一圈压边、四颗固定螺栓，漆成车身色
          local c0 = col:Lerp(RGB(176, 158, 116), 0.35)
          put(V(w, h, t), CF(), c0, MAT.Metal)
          put(V(w * 0.86, h * 0.8, 0.04), CF(0, 0, t / 2 + 0.02), c0:Lerp(RGB(0, 0, 0), 0.08), MAT.SmoothPlastic)
          for sx = -1, 1, 2 do
            for sy = -1, 1, 2 do
              put(V(0.06, 0.13, 0.13), CF(sx * (w / 2 - 0.16), sy * (h / 2 - 0.14), t / 2 + 0.04) * CFrame.Angles(0, math.pi / 2, 0), RGB(70, 66, 56), MAT.Metal, CYL)
            end
          end
        elseif not own and brickMesh and brickMesh:IsA("MeshPart") then   -- 导入了砖的模型（models/veh/kitera.glb：Kontakt-1，evt22，CC-BY；贴图做旧过）
          local mp = Tint.fix(brickMesh:Clone(), brickMesh)
          mp.Anchored, mp.CanCollide, mp.CanQuery, mp.CanTouch = true, false, false, false
          mp.Size = V(w, h, t)
          local off = base * TURN
          mp.CFrame = off
          mp.Parent = m
          table.insert(parts, { mp, g, off })
          table.insert(e.parts, mp)
        elseif not own then
          -- 零件拼的做旧砖：漆面（比车身暗一点、金属纹理）、底下三成积灰、上沿一道掉漆露出的钢、一两道锈迹、两颗螺栓
          put(V(w, h, t), CF(), col:Lerp(RGB(40, 44, 34), 0.18), MAT.Metal)
          put(V(w * 1.004, h * 0.36, t * 1.02), CF(0, -h * 0.32, 0), RGB(92, 80, 60), MAT.Sand, nil, 0.5)
          put(V(w * 0.94, 0.05, 0.05), CF(0, h / 2 - 0.03, t / 2), RGB(150, 148, 136), MAT.Metal)
          for k = 1, (i % 3 == 0) and 2 or 1 do
            local x = ((i * 37 + k * 53) % 100 / 100 - 0.5) * w * 0.7
            put(V(0.07, h * (0.35 + (k * 0.1)), 0.02), CF(x, h * 0.05, t / 2 + 0.006), RGB(112, 60, 30), MAT.SmoothPlastic, nil, 0.3)
          end
          for sx = -1, 1, 2 do
            put(V(0.07, 0.17, 0.17), CF(sx * (w / 2 - 0.2), h / 2 - 0.17, t / 2 + 0.03) * CFrame.Angles(0, math.pi / 2, 0), RGB(48, 46, 40), MAT.Metal, CYL)
          end
        end
        if mm and mm.era == "arat2" then
          -- ARAT-2（M32）：叠在 M19 外面的弯瓦（中间往里凹，像屋顶的筒瓦）——两片斜板拼出弯度，上下两道边筋
          local c2 = col:Lerp(RGB(150, 134, 98), 0.4)
          local z0 = t / 2 + 0.16
          for sx = -1, 1, 2 do
            put(V(w * 0.52, h * 0.94, 0.12), CF(sx * w * 0.24, 0, z0 + 0.04) * CFrame.Angles(0, math.rad(-sx * 12), 0), c2, MAT.Metal)
          end
          for sy = -1, 1, 2 do put(V(w * 0.98, 0.07, 0.24), CF(0, sy * h * 0.47, z0), c2:Lerp(RGB(0, 0, 0), 0.12), MAT.Metal) end
        end
      end
      era[i] = e
    end
    local dark, olive = RGB(34, 36, 34), C.base:Lerp(RGB(50, 54, 44), 0.35)
    local function frameAt(c, n)
      local up = V(0, 1, 0)
      local rt = up:Cross(n)
      if rt.Magnitude &lt; 0.1 then rt = V(1, 0, 0) end
      rt = rt.Unit
      return CFrame.fromMatrix(c, rt, n:Cross(rt).Unit, n)   -- Z 朝外
    end
    local tb, hb = L.tb, L.hb
    local roofY = L.roof or (tb and tb[5] - 0.8) or (tp.Y + 2)
    -- 主动防护
    if mm and mm.aps == "trophy" and L.aps then
      for _, a in ipairs(L.aps.l or {}) do   -- 两侧能转的发射器（带圆顶的弹仓、两根朝外上斜的发射管、探测窗）
        local f = CF(-tp) * frameAt(V(a[1], a[2], a[3]), V(a[4], a[5], a[6]).Unit)
        tur(V(0.5, 0.42, 1.0), f * CF(0, 0, 0.2), dark)   -- 支架
        tur(V(1.2, 0.95, 1.55), f * CF(0, 0.05, 0.95), olive)   -- 发射器
        tur(V(1.1, 0.48, 1.45), f * CF(0, 0.52, 0.95), olive:Lerp(RGB(0, 0, 0), 0.15), MAT.Metal, BALL)   -- 圆顶盖
        for k = -1, 1, 2 do
          tur(V(0.62, 0.34, 0.34), f * CF(k * 0.3, 0.2, 1.75) * CFrame.Angles(math.rad(-30), math.pi / 2, 0), dark, MAT.Metal, CYL)
        end
        tur(V(0.5, 0.22, 0.04), f * CF(0, -0.18, 1.74), RGB(10, 12, 14), MAT.Glass)
      end
      for _, a in ipairs(L.aps.r or {}) do   -- EL/M-2133 四块平板天线（四角各一块，斜着朝外）
        local f = CF(-tp) * frameAt(V(a[1], a[2], a[3]), V(a[4], a[5], a[6]).Unit)
        tur(V(1.4, 1.0, 0.2), f * CF(0, 0, 0.12), olive)
        tur(V(1.18, 0.8, 0.05), f * CF(0, 0, 0.24), RGB(20, 22, 24), MAT.SmoothPlastic)
        tur(V(0.3, 0.3, 0.5), f * CF(0, -0.6, -0.05), dark)
      end
    elseif mm and mm.aps == "gl5" and L.aps then
      for _, a in ipairs(L.aps.r or {}) do   -- GL5：四角各一个方盒（前面一块毫米波雷达面、上面斜着一个发射筒）
        local f = CF(-tp) * frameAt(V(a[1], a[2] - 0.15, a[3]), V(a[4], a[5], a[6]).Unit)
        tur(V(1.3, 1.0, 1.1), f * CF(0, 0, 0.35), olive)
        tur(V(1.08, 0.72, 0.05), f * CF(0, 0.02, 0.92), RGB(24, 26, 28), MAT.SmoothPlastic)   -- 雷达面
        tur(V(0.9, 0.46, 0.46), f * CF(0, 0.62, 0.3) * CFrame.Angles(math.rad(-25), math.pi / 2, 0), dark, MAT.Metal, CYL)   -- 发射筒（朝外上）
        tur(V(0.06, 0.5, 0.5), f * CF(0, 0.82, 0.72) * CFrame.Angles(math.rad(-25), math.pi / 2, 0), RGB(60, 62, 58), MAT.Metal, CYL)   -- 筒口盖
        tur(V(0.4, 0.3, 0.6), f * CF(0, -0.55, -0.05), dark)   -- 托架
      end
    end
    -- 激光告警探头（四个角的侧墙上，不在车顶）；JD-3 多一个激光干扰头（炮塔左前侧墙）；「窗帘-1」也带激光告警
    if mm and (mm.ew == "lws" or mm.ew == "jd3" or mm.ew == "shtora") and L.aps then
      for _, a in ipairs(L.aps.r or {}) do
        local f = CF(-tp) * frameAt(V(a[1], a[2] - 0.85, a[3]), V(a[4], a[5], a[6]).Unit)
        tur(V(0.42, 0.34, 0.3), f * CF(0, 0, 0.15), dark)
        tur(V(0.3, 0.2, 0.04), f * CF(0, 0.02, 0.31), RGB(30, 40, 60), MAT.Glass)
      end
      if mm.ew == "jd3" and L.aps.r[1] then
        local a = L.aps.r[1]
        local f = CF(-tp) * frameAt(V(a[1], a[2] - 0.2, a[3] + 0.9), V(a[4], 0, a[6]).Unit)
        tur(V(0.6, 0.6, 0.55), f * CF(0, 0, 0.3), dark, MAT.Metal, CYL)
        tur(V(0.04, 0.42, 0.42), f * CF(0, 0, 0.6) * CFrame.Angles(0, math.pi / 2, 0), RGB(90, 20, 18), MAT.Glass, CYL)
      end
    end
    -- 「窗帘-1」（T-90A）：炮两边各一个 OTShU-1-7 红外干扰灯——车身色的方盒、上沿一道遮光檐、正面黑圈里一个大圆灯。
    --   开着的样子（用户 11-28 给的图「它开起来是这个效果」）：中心白热、往外金黄 → 橙 → 红的一圈，外面一团光晕把灯框都映红了，
    --   往前照出一片橙红的光；车活着就开着（残骸上灭掉：View.lua），被打的时候干扰（服务器 dazzle）闪一下更亮
    local SH = mm and mm.ew == "shtora" and SHTORA[extra.imported or ""] or nil
    if SH then
      local R90 = CFrame.Angles(0, math.pi / 2, 0)   -- 圆柱的轴（X）转到朝前
      for sx = -1, 1, 2 do
        local box = CF(-tp) * CF(SH.gx + sx * SH.sx, SH.y, SH.zf + SH.d / 2)
        local hb = tur(V(SH.w, SH.h, SH.d), box, olive)
        hb.Name = "ShtoraBox"
        tur(V(SH.w * 0.98, 0.06, 0.26), box * CF(0, SH.h / 2 - 0.03, -SH.d / 2 - 0.12), olive)   -- 遮光檐
        tur(V(0.06, 0.64, 0.64), box * CF(0, -0.02, -SH.d / 2 - 0.03) * R90, RGB(14, 14, 14), MAT.Metal, CYL)   -- 黑圈
        local rim = tur(V(0.05, 0.56, 0.56), box * CF(0, -0.02, -SH.d / 2 - 0.07) * R90, RGB(255, 78, 28), MAT.Neon, CYL)   -- 橙红的一圈
        rim.Name = "ShtoraLens"
        local mid = tur(V(0.05, 0.42, 0.42), box * CF(0, -0.02, -SH.d / 2 - 0.09) * R90, RGB(255, 168, 70), MAT.Neon, CYL)   -- 金黄
        mid.Name = "ShtoraMid"
        local core = tur(V(0.05, 0.24, 0.24), box * CF(0, -0.02, -SH.d / 2 - 0.11) * R90, RGB(255, 244, 222), MAT.Neon, CYL)   -- 白热的芯
        core.Name = "ShtoraCore"
        -- 光晕：贴在灯上的一团柔光（粒子锁在零件上、几颗叠着淡进淡出，看上去一直亮着）
        local at = Instance.new("Attachment")
        at.Name = "ShtoraGlow"
        at.Parent = core
        local pe = Instance.new("ParticleEmitter")
        pe.Name = "ShtoraHalo"
        pe.Texture = "rbxasset://textures/particles/explosion01_implosion_main.dds"
        pe.LightEmission, pe.LightInfluence = 1, 0
        pcall(function() pe.Brightness = 2.2 end)
        pe.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, RGB(255, 196, 120)), ColorSequenceKeypoint.new(1, RGB(255, 110, 50)) })
        pe.Size = NumberSequence.new(1.9)
        pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, 0.55), NumberSequenceKeypoint.new(0.75, 0.55), NumberSequenceKeypoint.new(1, 1) })
        pe.Lifetime = NumberRange.new(1.1, 1.3)
        pe.Rate = 4
        pe.Speed = NumberRange.new(0)
        pe.LockedToPart = true
        pe.ZOffset = 0.6
        pe.Parent = at
        -- 往前照的光（照亮车前一片地；不投影子）
        local sl = Instance.new("SpotLight")
        sl.Name = "ShtoraLight"
        sl.Face, sl.Angle, sl.Range, sl.Brightness, sl.Color, sl.Shadows = Enum.NormalId.Front, 70, 18, 1.6, RGB(255, 120, 56), false
        sl.Parent = hb
      end
    end
    -- 栅栏装甲：扁钢条竖着排（间距约 0.9 格 ≈ 32 厘米），上下两道横框、几根撑杆；离车身 1.4 格（半米）
    if mm and mm.slat == "slat" and hb then
      local SC = C.base:Lerp(RGB(60, 62, 56), 0.25)
      local function grille(group, o, along, wid, hei, depth)
        local fn = (group == "turret") and tur or hull
        local n = math.max(2, math.floor(wid / 0.9))
        for k = 0, n do
          local x = -wid / 2 + wid * k / n
          fn(V(0.07, hei, 0.32), o * CF(along * x, 0, 0), SC, MAT.Metal)
        end
        for sy = -1, 1, 2 do fn(V(wid + 0.1, 0.12, 0.12), o * CF(0, sy * hei / 2, 0), SC, MAT.Metal) end
        for k = -1, 1, 2 do fn(V(0.12, 0.12, depth), o * CF(k * wid * 0.42, hei * 0.3, -depth / 2), SC, MAT.Metal) end   -- 撑杆（往车身那边）
      end
      local rz = hb[6] + 1.4
      local y0, y1 = 1.4, hb[5] - 0.2
      grille("hull", CF(0, (y0 + y1) / 2, rz), 1, hb[4] - hb[1] - 0.6, y1 - y0, 1.4)   -- 车尾
      local sl = (hb[6] - hb[3]) * 0.3
      for sx = -1, 1, 2 do   -- 侧面后段（发动机舱外，裙板外面）
        local x = (sx &gt; 0) and (hb[4] + 1.2) or (hb[1] - 1.2)
        grille("hull", CF(x, (y0 + 1.1 + y1) / 2, hb[6] - sl / 2) * CFrame.Angles(0, math.pi / 2, 0), 1, sl, y1 - y0 - 1.1, 1.2)
      end
      if tb then   -- 炮塔尾部后面
        local tz = tb[6] + 1.0
        local ty0, ty1 = tb[2] + 0.3, roofY - 0.25
        grille("turret", CF(-tp) * CF((tb[1] + tb[4]) / 2, (ty0 + ty1) / 2, tz), 1, (tb[4] - tb[1]) * 0.78, ty1 - ty0, 1.0)
      end
    end
    -- 车底防雷板：车底一整块，四角加强筋
    if mm and mm.belly == "belly" and hb then
      local y = (d.clear or 1.3) * 0.62
      hull(V((hb[4] - hb[1]) * 0.62, 0.18, (hb[6] - hb[3]) * 0.72), CF(0, y, (hb[3] + hb[6]) / 2), RGB(52, 54, 50), MAT.DiamondPlate)
      for sx = -1, 1, 2 do hull(V(0.2, 0.3, (hb[6] - hb[3]) * 0.7), CF(sx * (hb[4] - hb[1]) * 0.3, y + 0.15, (hb[3] + hb[6]) / 2), RGB(46, 48, 44), MAT.Metal) end
    end
    -- 扫雷犁（全宽扫雷犁）：组 plow，转轴在车头下沿；放下时犁齿入土、升起时绕转轴往上抬 14°
    if mm and mm.eng == "plow" and hb then
      plowPiv = V(0, 1.7, hb[3] + 0.6)
      local PC, PD = C.base:Lerp(RGB(70, 72, 64), 0.3), RGB(46, 46, 44)
      local function pl(size, o, color, mat, shape) return add("plow", size, o, color or PC, mat or MAT.Metal, shape) end
      local bw = (hb[4] - hb[1]) * 1.0
      local zb = -3.4   -- 犁板在转轴前面多远
      for sx = -1, 1, 2 do   -- 两根臂
        pl(V(0.45, 0.55, 3.6), CF(sx * bw * 0.32, -0.4, -1.7) * CFrame.Angles(math.rad(10), 0, 0), PD)
      end
      pl(V(bw, 1.6, 0.25), CF(0, 0.2, zb) * CFrame.Angles(math.rad(-18), 0, 0))   -- 犁板（往后仰）
      pl(V(bw, 0.5, 0.25), CF(0, -0.75, zb - 0.45) * CFrame.Angles(math.rad(-48), 0, 0))   -- 犁板下沿往前卷
      pl(V(bw + 0.1, 0.18, 0.8), CF(0, 1.02, zb + 0.15), PD)   -- 顶梁
      local nT = math.max(6, math.floor(bw / 0.75))
      for k = 0, nT - 1 do   -- 犁齿（往前下插）
        local x = -bw / 2 + bw * (k + 0.5) / nT
        pl(V(0.16, 0.16, 1.15), CF(x, -1.05, zb - 0.85) * CFrame.Angles(math.rad(28), 0, 0), RGB(58, 56, 52), MAT.Metal)
      end
      for sx = -1, 1, 2 do   -- 两侧滑橇（控制犁地深度）
        pl(V(0.3, 0.35, 1.6), CF(sx * (bw / 2 + 0.2), -1.15, zb + 0.2), PD)
      end
    end
    -- 多光谱伪装网（梭鱼 MCS 那一类）：炮塔两侧、后面，车体侧面、后面一片片的网——三种颜色的斑块交错，不盖车顶、不挡观瞄、不盖车灯
    if mm and mm.cam == "mcs" and hb and tb then
      local NC = (team == "def") and { RGB(170, 150, 108), RGB(128, 112, 80), RGB(196, 180, 140) } or { RGB(76, 92, 60), RGB(58, 66, 46), RGB(104, 112, 78) }
      local function patch(fn, size, o, k)
        local p = fn(size, o, NC[(k % 3) + 1], MAT.Fabric)
        p.CastShadow = false
        return p
      end
      local k = 0
      for sx = -1, 1, 2 do
        -- 炮塔侧面后半（错开几片）
        local x = (sx &gt; 0) and (tb[4] + 0.18) or (tb[1] - 0.18)
        local z0, z1 = tb[3] + (tb[6] - tb[3]) * 0.45, tb[6] - 0.3
        for j = 0, 3 do
          k += 1
          local zc = z0 + (z1 - z0) * (j + 0.5) / 4
          patch(tur, V(0.08, (roofY - tb[2]) * (0.55 + (j % 2) * 0.2), (z1 - z0) / 3.4), CF(-tp) * CF(x + sx * 0.02 * (j % 2), tb[2] + (roofY - tb[2]) * 0.45, zc), k + (sx &gt; 0 and 1 or 0))
        end
        -- 车体侧面后段（裙板外）
        local hx = (sx &gt; 0) and (hb[4] + 0.22) or (hb[1] - 0.22)
        for j = 0, 4 do
          k += 1
          local zc = hb[3] + (hb[6] - hb[3]) * (0.45 + 0.11 * j)
          patch(hull, V(0.08, 1.6 + (j % 2) * 0.5, (hb[6] - hb[3]) * 0.12), CF(hx + sx * 0.02 * (j % 2), hb[5] * 0.55, zc), k)
        end
      end
      for j = 0, 3 do   -- 车尾
        k += 1
        patch(hull, V((hb[4] - hb[1]) / 4.2, 1.8, 0.08), CF(hb[1] + (hb[4] - hb[1]) * (j + 0.5) / 4, hb[5] * 0.6 + (j % 2) * 0.3, hb[6] + 0.25), k)
      end
    end
    -- 车顶 GAU-8 加特林炮塔附件：转轴在炮塔顶左侧（装填手那边），跟着炮俯仰（坦克不带机枪以后不用了）
    if mm and mm.roof == "gau8" then
      kpiv = TM.kitPivot(L)
      local kp = kpiv - tp
      local GM, BL, OD = RGB(52, 54, 50), RGB(28, 29, 28), C.base
      tur(V(0.3, 2.7, 2.7), CF(kp.X, kp.Y - 0.85, kp.Z) * UPRIGHT, BL, MAT.Metal, CYL)
      tur(V(1.6, 0.7, 1.9), CF(kp.X, kp.Y - 0.45, kp.Z + 0.2), OD)
      local function kg(size, off, color, mat, shape) return add("kit", size, off, color or GM, mat or MAT.Metal, shape) end
      kg(V(1.1, 1.0, 2.5), CF(0, 0, 0.3), OD)
      for k = 0, 6 do
        local a = k / 7 * math.pi * 2
        tube(kg, math.cos(a) * 0.27, math.sin(a) * 0.27, -0.95, -TM.KIT_MUZ, 0.16, BL)
      end
    end
  end

  return { model = m, parts = parts, wheels = wheels, dust = dust, exhaust = exhaust, fire = fire, black = black, def = d, lamps = lamps,
    imported = extra.imported, tpiv = extra.tpiv, gpiv = extra.gpiv, travel = extra.travel, rpiv = extra.rpiv, rgpiv = extra.rgpiv, carve = extra.carve,
    era = era, eraL = L, kpiv = kpiv and (kpiv - tp) or nil, plowPiv = plowPiv, mods = mm }
end

-- 爆反块被炸掉的样子（View 调）：砖藏起来，原地一块焦黑的底板、几片翻卷的钢皮、一圈熏黑——返回新加的零件 { 零件, 组, 相对位置 }
function VehModels.eraBlown(M, i)
  local e = M.era and M.era[i]
  if not e or e.blown then return {} end
  e.blown = true
  for _, p in ipairs(e.parts) do p.Transparency = 1 end
  local out = {}
  local function put(size, o, color, mat, tr)
    local p = Instance.new("Part")
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch = true, false, false, false
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Size, p.Color, p.Material = size, color, mat
    p.Transparency = tr or 0
    p.CastShadow = false
    local off = e.off * o
    p.CFrame = off
    p.Parent = M.model
    table.insert(out, { p, e.g, off })
    return p
  end
  local w, h, t = e.w, e.h, e.t
  -- 砖底下（贴着车身那一面）：焦黑的底板、熏黑的一圈
  put(V(w * 1.25, h * 1.25, 0.05), CF(0, 0, -t / 2 + 0.03), RGB(24, 22, 20), Enum.Material.Slate, 0.15)
  put(V(w * 0.92, h * 0.88, 0.09), CF(0, 0, -t / 2 + 0.07), RGB(40, 37, 33), Enum.Material.CorrodedMetal)
  -- 翻卷的钢皮（几片歪着的薄板）、两颗剩下的螺栓
  for k = 1, 3 do
    local a = (i * 13 + k * 29) % 17 / 17
    put(V(w * 0.22, h * 0.18, 0.04), CF((a - 0.5) * w * 0.8, ((k % 2) - 0.5) * h * 0.6, -t / 2 + 0.16) * CFrame.Angles(math.rad(35 + 30 * a), math.rad(20 * k), 0),
      RGB(70, 66, 58), Enum.Material.CorrodedMetal)
  end
  for sx = -1, 1, 2 do
    put(V(0.12, 0.15, 0.15), CF(sx * (w / 2 - 0.2), h / 2 - 0.17, -t / 2 + 0.12), RGB(44, 42, 38), Enum.Material.Metal)
  end
  return out
end

-- 静止的样子（炮塔朝前、炮平着）：把 build 出来的零件摆到车的底座系（科技树资料卡的装甲查看器用；车库 Garage.lua 里有一份一样的）
function VehModels.pose(M, d)
  local tp = M.tpiv or (d.turret and d.turret.pivot) or V()
  local tF = CF(tp)
  local gF = tF * CF(M.gpiv or (d.gun and d.gun.pivot) or V())
  local rF = M.rpiv and (tF * CF(M.rpiv)) or tF
  local rgF = (M.rpiv and M.rgpiv) and (rF * CF(M.rgpiv)) or rF
  local kF = M.kpiv and (tF * CF(M.kpiv)) or tF
  for _, it in ipairs(M.parts) do
    local p, grp, off, idx = it[1], it[2], it[3], it[4]
    local cf
    if grp == "turret" then cf = tF * off
    elseif grp == "gun" then cf = gF * off
    elseif grp == "rws" then cf = rF * off
    elseif grp == "rwg" then cf = rgF * off
    elseif grp == "kit" then cf = kF * off
    elseif grp == "wheel" then
      local w = M.wheels[idx]
      cf = w and (CF(w.x, w.r, w.z) * off) or off
    else cf = off end
    p.CFrame = cf
  end
  return tp
end

return VehModels</ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="278">
          <Properties>
            <string name="Name">VfxLib</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——特效共用的底子（用户 11-27：开炮、炮弹打地、机枪打地、坦克殉爆都照战雷 Eagle's Shadow 做，「在 M3 的 Mac 上要丝滑」）
--   · 粒子发射器池：每一「层」（贴图、颜色、大小曲线……）按大小分档常驻发射器，用的时候把它的小零件挪到位置、Emit 几颗——
--     不每发都 Instance.new 一堆零件和发射器再 Destroy。粒子喷出去就留在世界里（不跟零件走）。
--     颜色、大小、透明度曲线改了会连已经在飞的粒子一起变，所以按「层 + 大小档 + 变体（地面颜色、贴脸）」各建一份，不在用的时候改；
--     速度、散开角只影响新喷的，可以按次改（emitK）。发射器总数有上限（MAX_EM），满了借同一层最近的一档，再不行收最久没用的那一层
--   · 一层可以有几「处」（site：一个小零件 + 一个发射器，配置一样）——下面三条引擎行为模拟器验证不了，代码里不去赌它（11-27 审查 3）：
--     (b) 同一帧里把一个零件挪来挪去、喷好几次，粒子是不是出在各自的位置：同一帧里换了位置 / 朝向就换一处喷（犁沟那一串土团、
--         两颗白闪、制退器两边），一处只在一个地方喷
--     (c) 发射器挪到别处去喷，上一处还在飘的长寿命烟会不会跟着零件出了视野被一起剔除：寿命上限 ≥ 3 秒的烟、尘云（eSoot、eCloud、
--         mHang、gRise、eRing、kHang、wSoot……碎屑火星除外）每处爆炸借一处，固定在那里，粒子没灭完不挪走（到寿命才还回池里）；
--         离上一处不到 10 格的照用那一处（挪一点不碍事）。一层最多 8 处（长寿命）/ 6 处（别的），都占满了才借最早到期的那处
--     「不去赌」只管到这个数（11-27 复核写明）：一层一帧里要在 6 处以上喷（霰弹的一把弹丸、一帧里扫一大串机枪弹着点）时，第 7 处起
--     还是借这一帧用过的那几处（又回到 (b)：同一帧挪零件喷几次）；长寿命的烟同时超过 8 处在飘（火箭炮齐射、集束炸弹）时，借最早到期的
--     那一处，它还在飘的烟可能跟着零件被剔除（又回到 (c)）。是降级、不出错；Studio 里这两样要是真的不对，最多是扎堆的那几处画少了
--     (a) EmissionDirection = Front 时 SpreadAngle 的 X 是不是左右（水平）——见下面 SPREAD_XH：
--         Studio 里怎么看：Play（钢城、沙海都行），开坦克在平地上开一炮——炮口前应该是一大片又宽又扁、贴着地往前、往两边推开的扇形尘幕；
--         再往远处地上打一发榴弹（或看别人的落点）——落点那圈扬尘应该贴着地面往四周推开、是平的一圈。
--         要是看到的是竖起来的一堵墙、竖着的一个圈（尘往天上喷成一道竖缝），就是 X / Y 反了：把本文件里 `local SPREAD_XH = true`
--         改成 false（只改这一行，所有用到 {左右, 上下} 的层一起换过来），再开一炮看一遍
--   · 闪光灯池：8 盏点光源挂在 Attachment 上轮着用，亮度每帧按 Quad Out 降到 0（不每次新建零件、灯、补间）；投影子的同时只 1 盏
--   · 弹坑焦痕池（24 块，60 秒后 10 秒淡掉，满了收最旧的）、余火池（6 处：炸弹、导弹炸完坑里烧一会儿）
--   · 远近分档：离镜头 400 / 1100 / 2500 格（开镜按视场折算成看上去的远近）；同时活着的粒子估个数，太多了先砍碎屑、火星；
--     不走池的常喷发射器（碎块拖的火和烟、舱口火柱、炮塔身上的火）用 rateK 记进同一个数（按喷稳了以后同时活着的量：rate × min(寿命, 喷几秒)）、按它少喷
--   · 预建（prewarmLater）：常用的层进局时分几帧建好（一帧 4 个），第一炮、第一次殉爆不顿
--   · 贴图只用 Roblox 自带的（rbxasset://textures/particles/…），不上传图片
--   · 测试：L.logOn = true 以后每喷一次记一笔（L.log），tools/mock/vfxreal.lua、groundhit.lua、boom.lua 按它查
local VfxLib = {}

function VfxLib.new(G, FXF)
  local L = {}
  local V, RGB = Vector3.new, Color3.fromRGB
  local NSK, CSK = NumberSequenceKeypoint.new, ColorSequenceKeypoint.new
  local floor, max, min, abs = math.floor, math.max, math.min, math.abs

  -- 自带贴图（客户端 content/textures/particles 里的单张图，没有序列帧网格）
  local TX = {
    GLOW = "rbxasset://textures/particles/explosion01_implosion_main.dds",   -- 白色柔边圆点：闪光、火星（拉长）、冰晶、染色的小碎屑
    CORE = "rbxasset://textures/particles/explosion01_core_main.dds",        -- 橙褐色翻卷的一团：火球（染不白）
    FIRE = "rbxasset://textures/particles/fire_main.dds",                    -- 细丝状的火，本身暗褐：要 LightInfluence 0 + Brightness 3
    SMOKE = "rbxasset://textures/particles/smoke_main.dds",                  -- 白色柔软的一团（alpha 最高 0.33）：尘土、浅色的烟、水雾
    SOOT = "rbxasset://textures/particles/explosion01_smoke_main.dds",       -- 深灰黑、团块明显（alpha 0.33）：黑烟
    RING = "rbxasset://textures/particles/explosion01_shockwave_main.dds",   -- 白色双圈：冲击波圈、水面涟漪
    GRIT = "rbxasset://textures/particles/fire_sparks_main.dds",             -- 一片细碎的深色点：一颗就是一把砂砾
  }
  L.TX = TX

  ---------------------------------------------------------------- 序列
  -- ns(t0, v0, t1, v1, …) 或 ns(v)；cs(c) / cs(a, b) / cs(t0, c0, t1, c1, …)
  function L.ns(...)
    local a = { ... }
    if #a == 1 then return NumberSequence.new(a[1]) end
    local kp = {}
    for i = 1, #a, 2 do kp[#kp + 1] = NSK(a[i], a[i + 1]) end
    return NumberSequence.new(kp)
  end
  function L.cs(...)
    local a = { ... }
    if #a == 1 then return ColorSequence.new(a[1]) end
    if #a == 2 then return ColorSequence.new({ CSK(0, a[1]), CSK(1, a[2]) }) end
    local kp = {}
    for i = 1, #a, 2 do kp[#kp + 1] = CSK(a[i], a[i + 1]) end
    return ColorSequence.new(kp)
  end
  -- 透明度曲线整体加一点（贴脸、开镜时淡一点）：(t, v) 对的表
  function L.nsAdd(pairs_, add)
    local kp = {}
    for i = 1, #pairs_, 2 do kp[#kp + 1] = NSK(pairs_[i], min(1, pairs_[i + 1] + add)) end
    return NumberSequence.new(kp)
  end
  -- 零件的 +Y（EmissionDirection = Top 的发射方向）朝 up
  function L.upCF(p, up)
    local r = up:Cross((abs(up.Y) < 0.95) and V(0, 1, 0) or V(1, 0, 0)).Unit
    return CFrame.fromMatrix(p, r, up)
  end
  -- 零件的正面（EmissionDirection = Front）朝 dir、顶朝上（扇面、贴地一圈）
  function L.lookCF(p, dir)
    if dir.Magnitude < 1e-3 then return CFrame.new(p) end
    local d = dir.Unit
    if abs(d.Y) > 0.98 then return CFrame.lookAt(p, p + d, V(0, 0, 1)) end
    return CFrame.lookAt(p, p + d)
  end

  ---------------------------------------------------------------- 发射器池
  local POOL = Instance.new("Folder")   -- 放在 ClientFx 下面的子文件夹：画中画（ScopePip）只看 ClientFx 的直接子零件，不会去克隆这些看不见的小零件
  POOL.Name = "VfxPool"
  POOL.Parent = FXF
  L.folder = POOL
  local HIDE = CFrame.new(0, -2000, 0)
  local function holder(name, size)
    local p = Instance.new("Part")
    p.Name = name
    p.Size = size or V(0.2, 0.2, 0.2)
    p.Transparency = 1
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.CFrame = HIDE
    p.Parent = POOL
    return p
  end
  L.holder = holder

  -- SpreadAngle 的 (X, Y)：EmissionDirection = Front 时 X 是左右、Y 是上下（文档：Top 时两个分量是 X / Z 两个轴上的散开）。
  --   Studio 里要是看着反了（贴地一圈变成竖着的一圈、开炮的扇形尘幕变成竖着的一堵墙），把这里改成 false（怎么看见文件开头 (a)）
  local SPREAD_XH = true
  local function spreadV(sp)
    if type(sp) == "number" then return Vector2.new(sp, sp) end
    if type(sp) == "table" then
      if SPREAD_XH then return Vector2.new(sp[1], sp[2]) end
      return Vector2.new(sp[2], sp[1])
    end
    return Vector2.new(0, 0)
  end
  L.spreadV = spreadV

  -- 风（Workspace.GlobalWind，格/秒）：烟尘层开 WindAffectsDrag 顺风飘。地图没设风（0）时，烟尘层的加速度里补一点水平的（原来各处写死的那份）
  local wind = V()
  local windT = -10
  local FALLBACK = V(1.4, 0, 0.7)
  local function windNow()
    local t = os.clock()
    if t - windT > 2 then
      windT = t
      local ok, w = pcall(function() return workspace.GlobalWind end)
      wind = (ok and typeof(w) == "Vector3") and w or V()
    end
    return wind
  end
  L.wind = windNow

  local DEFS = {}      -- 层名 → { f = function(档的大小倍数, 变体) → 配置, fixed = 不分档 }
  local POOLS = {}     -- 键 → 层 { name, key, ti, var, o, sites = { 一处 = { h 小零件, pe 发射器, cf, t 上次喷, till 占到什么时候 } } }
  local nEm = 0
  L.MAX_EM = 420   -- 发射器（处）一共最多几个（测试可以临时调小）
  local SITE_LONG, SITE_SHORT = 8, 6   -- 一层最多几处：长寿命的烟尘 8 处（同时 8 处在飘），别的 6 处（一帧里在 6 个地方喷：犁沟的一串土团）
  local LONG = 3          -- 寿命上限 ≥ 3 秒的（碎屑火星除外）：每处借一处，粒子没灭完不挪走
  local NEAR_R = 10       -- 离上一处不到 10 格：照用那一处
  local RECENT = 0.04     -- 「同一帧」：这么久以内喷过（帧率 25 以上都算得住；算多了只是多借一处）
  L.stat = { emitters = 0, made = 0, emits = 0, emitted = 0, flashes = 0, scorch = 0, burners = 0, borrowed = 0, cut = 0,
    sites = 0, stolen = 0, recycled = 0, warm = 0, rated = 0 }
  local madeT, madeN = 0, 0   -- 每秒新建了几个发射器（测试查：别一下子建太多；预建的不算）
  L.madeMax = 0

  -- 配置字段：tex 贴图、life / spd {小, 大}、size / tr（NumberSequence）、col（ColorSequence）、acc 加速度、drag 阻力、
  --   le LightEmission、li LightInfluence（不写：le > 0.5 的 0，别的 1）、bright Brightness（不写：火的贴图 3，别的 1）、z ZOffset、
  --   dir EmissionDirection、spread 数或 {左右, 上下}、rot 转速、flat 平躺（VelocityPerpendicular）、vp 顺着速度拉长（VelocityParallel）、
  --   sq Squash、wind 跟着风、shape {"Sphere"/"Box"/…, 体积或表面, 往外或往里}、box 小零件的大小（出生的体积）、
  --   prio 1 要紧（闪光、火球）/ 2 一般 / 3 碎屑火星（粒子多了先砍）、cat "imp"（弹着点：另有 600 颗的上限）、
  --   site true / false：一处一个零件、粒子没灭完不挪（不写：寿命上限 ≥ 3 秒、prio 不是 3 的算）
  function L.def(name, f, fixed)
    DEFS[name] = { f = f, fixed = fixed }
  end
  function L.has(name) return DEFS[name] ~= nil end

  local LN12 = math.log(1.2)
  local function tierOf(s)
    s = math.clamp(tonumber(s) or 1, 0.05, 40)
    local i = floor(math.log(s) / LN12 + 0.5)
    return i, 1.2 ^ i
  end
  L.tierOf = tierOf

  local function maxOf(seq)
    local m = 0
    for _, k in ipairs(seq.Keypoints) do if k.Value > m then m = k.Value end end
    return m
  end
  local function apply(pe, o)
    pe.Texture = o.tex
    pe.Rate = o.rate or 0
    pe.Lifetime = NumberRange.new(o.life[1], o.life[2])
    pe.Speed = NumberRange.new(o.spd[1], o.spd[2])
    pe.SpreadAngle = spreadV(o.spread)
    pe.Size = o.size
    pe.Transparency = o.tr
    pe.Color = o.col
    local acc = o.acc or V()
    if o.wind and windNow().Magnitude < 0.5 then acc += FALLBACK end
    pe.Acceleration = acc
    pe.Drag = o.drag or 0
    local le = o.le or 0
    pe.LightEmission = le
    pe.LightInfluence = o.li or ((le > 0.5) and 0 or 1)
    pe.Brightness = o.bright or ((o.tex == TX.FIRE) and 3 or 1)
    pe.ZOffset = o.z or 0
    pe.EmissionDirection = o.dir or Enum.NormalId.Top
    if o.vp then
      pe.Orientation = Enum.ParticleOrientation.VelocityParallel
      pe.Rotation = NumberRange.new(0)
      pe.RotSpeed = NumberRange.new(0)
    else
      if o.flat then pe.Orientation = Enum.ParticleOrientation.VelocityPerpendicular end
      pe.Rotation = NumberRange.new(0, 360)
      pe.RotSpeed = NumberRange.new(-(o.rot or 30), o.rot or 30)
    end
    -- 新一点的属性（老版本 Studio 没有也别整个特效出错）
    if o.sq then pcall(function() pe.Squash = o.sq end) end
    if o.wind then pcall(function() pe.WindAffectsDrag = true end) end
    if o.shape then
      pcall(function()
        pe.Shape = Enum.ParticleEmitterShape[o.shape[1]]
        pe.ShapeStyle = Enum.ParticleEmitterShapeStyle[o.shape[2] or "Volume"]
        pe.ShapeInOut = Enum.ParticleEmitterShapeInOut[o.shape[3] or "Outward"]
      end)
    end
  end
  L.apply = apply

  local warming = false   -- 正在预建（不算进「每秒新建了几个」）
  local function newSite(e)
    local n = #e.sites
    local h = holder((n == 0) and e.key or (e.key .. "~" .. (n + 1)), e.o.box)
    local pe = Instance.new("ParticleEmitter")
    apply(pe, e.o)
    pe.Parent = h
    local s = { h = h, pe = pe, cf = nil, t = -1e9, till = 0 }
    e.sites[n + 1] = s
    nEm += 1
    L.stat.emitters = nEm
    L.stat.made += 1
    L.stat.sites += 1
    if not warming then
      local t = os.clock()
      if t - madeT > 1 then madeT, madeN = t, 0 end
      madeN += 1
      if madeN > L.madeMax then L.madeMax = madeN end
    end
    return s
  end
  local function shortTex(t) return (t and t:match("([%w_]+)%.%w+$")) or tostring(t) end
  local function newEm(name, key, ti, var, o)
    local long = o.site
    if long == nil then long = o.life[2] >= LONG and (o.prio or 2) ~= 3 end
    local e = { name = name, key = key, ti = ti, var = var, o = o, life = (o.life[1] + o.life[2]) / 2,
      big = maxOf(o.size), tex = shortTex(o.tex), used = os.clock(), long = long == true, sites = {} }
    local s = newSite(e)
    e.h, e.pe = s.h, s.pe   -- 第一处（测试、别的模块看配置用：几处的配置都一样）
    POOLS[key] = e
    return e
  end

  -- 到上限：收最久没用的那一层（它的粒子早灭了），腾出位置
  local function recycle(keep)
    local now = os.clock()
    local old, ot, oldBusy, obt = nil, math.huge, nil, math.huge
    for _, x in pairs(POOLS) do
      if x ~= keep then
        local busy = false
        for _, s in ipairs(x.sites) do
          if now < s.till or now - s.t < x.o.life[2] + 0.2 then busy = true break end
        end
        if not busy and x.used < ot then old, ot = x, x.used end
        if x.used < obt then oldBusy, obt = x, x.used end
      end
    end
    old = old or oldBusy
    if not old then return false end
    for _, s in ipairs(old.sites) do
      s.h:Destroy()
      nEm -= 1
    end
    POOLS[old.key] = nil
    L.stat.emitters = nEm
    L.stat.recycled += 1
    return true
  end

  local function keyOf(name, s, var)
    local D = DEFS[name]
    if not D then return nil end
    local ti, sc = 0, 1
    if not D.fixed then ti, sc = tierOf(s) end
    local key = D.fixed and (name .. (var or "")) or (name .. "#" .. ti .. (var or ""))
    return key, ti, sc, D
  end
  local function get(name, s, var)
    local key, ti, sc, D = keyOf(name, s, var)
    if not key then return nil end
    local e = POOLS[key]
    if e then
      e.used = os.clock()
      return e
    end
    if nEm >= L.MAX_EM then
      -- 满了：先借同一层、同一变体最近的一档（差三档以内：大小差不到一倍，总比不画好），没有就收最久没用的那一层，腾出来建这一层
      local best, bd = nil, math.huge
      for _, x in pairs(POOLS) do
        if x.name == name and x.var == var and abs(x.ti - ti) < bd then best, bd = x, abs(x.ti - ti) end
      end
      if best and bd <= 3 then
        L.stat.borrowed += 1
        best.used = os.clock()
        return best
      end
      if not recycle(nil) then return best end
    end
    local ok, o = pcall(D.f, sc, var)
    if not ok or type(o) ~= "table" then
      warn("[特效] 层 " .. name .. " 配置出错：" .. tostring(o))
      return nil
    end
    return newEm(name, key, ti, var, o)
  end
  L.get = get

  -- 这一次喷在哪一处（见文件开头 (b)、(c)）
  local function sameCF(a, b)
    return (a.Position - b.Position).Magnitude < 0.05 and a.LookVector:Dot(b.LookVector) > 0.9995 and a.UpVector:Dot(b.UpVector) > 0.9995
  end
  local function pickSite(e, cf, now)
    local sites = e.sites
    local p = cf.Position
    -- ① 这一帧在同一个位置、同一个朝向喷过的：接着用
    for _, s in ipairs(sites) do
      if now - s.t < RECENT and s.cf and sameCF(s.cf, cf) then return s end
    end
    -- ② 这一帧没用过、离上一处不到 10 格的：挪一点照用（上一处的烟还在零件附近）
    local best, bd = nil, NEAR_R
    for _, s in ipairs(sites) do
      if now - s.t >= RECENT and s.cf then
        local d = (s.cf.Position - p).Magnitude
        if d < bd then best, bd = s, d end
      end
    end
    if best then return best end
    -- ③ 这一帧没用过、粒子已经灭完的（长寿命的到寿命了；别的喷完就能挪）
    for _, s in ipairs(sites) do
      if now - s.t >= RECENT and now >= s.till then return s end
    end
    -- ④ 再建一处
    if #sites < (e.long and SITE_LONG or SITE_SHORT) and nEm < L.MAX_EM then return newSite(e) end
    -- ⑤ 都占着（太多了才会这样）：借这一帧没用过、最早到期的那处
    local old = nil
    for _, s in ipairs(sites) do
      if now - s.t >= RECENT and (not old or s.till < old.till) then old = s end
    end
    L.stat.stolen += 1
    return old or sites[1]
  end
  L.pickSite = pickSite   -- 测试用

  ---------------------------------------------------------------- 同时活着的粒子：按到期时间分桶估个数（每 0.25 秒一桶，管 40 秒）
  local NB, BW = 160, 0.25
  local bAll, bImp = table.create(NB, 0), table.create(NB, 0)
  local curB = floor(os.clock() / BW)
  L.live, L.liveImp = 0, 0
  local function advance()
    local nb = floor(os.clock() / BW)
    if nb <= curB then return end
    if nb - curB >= NB then
      for i = 1, NB do bAll[i], bImp[i] = 0, 0 end
      L.live, L.liveImp = 0, 0
    else
      for b = curB + 1, nb do
        local i = b % NB + 1
        L.live -= bAll[i]
        L.liveImp -= bImp[i]
        bAll[i], bImp[i] = 0, 0
      end
    end
    curB = nb
  end
  local function accountAt(n, expiry, imp)
    local b = floor(expiry / BW)
    if b <= curB then b = curB + 1 end
    if b - curB >= NB then b = curB + NB - 1 end
    local i = b % NB + 1
    bAll[i] += n
    L.live += n
    if imp then
      bImp[i] += n
      L.liveImp += n
    end
  end
  local function account(e, n) accountAt(n, os.clock() + e.life, e.o.cat == "imp") end
  -- 全局：活着的超过 SOFT 开始砍（碎屑火星先砍、一般的少砍、闪光火球不砍），到 HARD 只留要紧的
  L.SOFT, L.HARD, L.IMP_MAX = 1800, 2800, 600
  local function budgetK(pr)
    local live = L.live
    if live > L.HARD then return (pr == 1) and 0.5 or 0 end
    if live > L.SOFT then
      local f = (live - L.SOFT) / (L.HARD - L.SOFT)
      if pr == 3 then return 1 - f elseif pr == 2 then return 1 - 0.6 * f end
    end
    return 1
  end
  local function budget(e, n)
    advance()
    local pr = e.o.prio or 2
    local k = budgetK(pr)
    if e.o.cat == "imp" and L.liveImp + n > L.IMP_MAX then k = 0 end
    local m = floor(n * k + 0.5)
    if pr == 1 and n >= 1 and m < 1 and L.live <= L.HARD * 1.3 then m = 1 end
    if m < n then L.stat.cut += n - m end
    return m
  end
  -- 不走池的常喷发射器（碎块拖的火和烟、舱口火柱、炮塔身上挂的火和烟……）：rate 每秒几颗、secs 喷几秒、life 每颗活多久——
  --   记进同时活着的粒子数（全局预算管得到它们）；返回现在该按几成喷（粒子太多时少喷：Rate 乘它）。
  --   11-27 复核：原来把这几秒要喷的全记成「现在活着」（rate ×（secs + 0.25））——8 颗 / 秒喷 4 秒、每颗活 0.5 秒的一下记 34 颗，真活着的只有 4 颗；
  --   一次殉爆一下记了九百多颗（真同时活着的两百出头），两三辆车接连殉爆就提前砍火星、一般的层也少喷，画面无故变素。
  --   现在按喷稳了以后的量记一笔：rate × min(life, secs)；停喷以后一颗颗灭（线性减到 0），分四份在 [max(secs, life), secs + life] 里到期
  --   （刚开喷那一下多记了一点：宁可多算）
  function L.rateK(rate, secs, life, prio)
    advance()
    local k = budgetK(prio or 2)
    rate, secs, life = rate or 0, max(0, secs or 0), max(0.05, life or 1)
    local m = rate * k * min(life, secs)
    if m > 0 then
      local now = os.clock()
      local t1, span = max(secs, life), min(secs, life)
      for i = 1, 4 do accountAt(m / 4, now + t1 + span * i / 4) end
      L.stat.rated += rate * k * secs
    end
    return k
  end

  L.logOn, L.log = false, {}
  local function logIt(e, n, cf, s)
    local o = e.o
    local c0 = o.col.Keypoints[1].Value
    L.log[#L.log + 1] = { name = e.name, key = e.key, tex = e.tex, n = n, big = e.big, flat = o.flat == true, vp = o.vp == true,
      le = o.le or 0, li = s.pe.LightInfluence, bright = s.pe.Brightness, col = c0, pos = cf.Position, wind = o.wind == true,
      life = { o.life[1], o.life[2] }, var = e.var, sq = o.sq ~= nil, cat = o.cat, site = s.h, long = e.long,
      spread = s.pe.SpreadAngle, look = cf.LookVector, up = cf.UpVector }
  end

  -- 速度、散开角（只影响新喷的）：这一处的值不一样才写
  local function kickSite(s, spd, spread)
    if spd and (s.ks1 ~= spd[1] or s.ks2 ~= spd[2]) then
      s.ks1, s.ks2 = spd[1], spd[2]
      s.pe.Speed = NumberRange.new(spd[1], spd[2])
    end
    if spread and s.ksp ~= spread then
      s.ksp = spread
      s.pe.SpreadAngle = spreadV(spread)
    end
  end
  local function emitIn(e, cf, n, spd, spread)
    n = budget(e, floor(n + 0.5))
    if n < 1 then return e end
    local now = os.clock()
    local s = pickSite(e, cf, now)
    kickSite(s, spd, spread)
    s.h.CFrame = cf
    s.cf = cf
    s.pe:Emit(n)
    s.t = now
    if e.long then s.till = max(s.till, now + e.o.life[2] + 0.3) end
    account(e, n)
    L.stat.emits += 1
    L.stat.emitted += n
    if L.logOn then logIt(e, n, cf, s) end
    return e
  end
  -- 喷：name 层、s 大小倍数（按 1.2 倍一档）、cf 小零件放哪（Top 发射的 +Y、Front 发射的正面朝要喷的方向）、n 几颗、var 变体
  function L.emit(name, s, cf, n, var)
    if not n or n < 0.5 then return nil end
    local e = get(name, s, var)
    if not e then return nil end
    return emitIn(e, cf, n)
  end
  -- 先改速度 / 散开角再喷（同一层不同次的初速不一样：入射角、口径）
  function L.emitK(name, s, cf, n, var, spd, spread)
    if not n or n < 0.5 then return nil end
    local e = get(name, s, var)
    if not e then return nil end
    return emitIn(e, cf, n, spd, spread)
  end
  -- 改一层所有处的速度 / 散开角（别的模块用）
  function L.kick(e, spd, spread)
    if not e then return end
    for _, s in ipairs(e.sites) do kickSite(s, spd, spread) end
  end
  function L.count()
    local nh = 0
    for _, c in ipairs(POOL:GetChildren()) do if c:IsA("BasePart") then nh += 1 end end
    return nEm, nh
  end
  L.pools = POOLS
  -- 马上建好（弹着点那几种常用的：测试一开始就找得到）
  function L.prewarm(list, s, var)
    for _, name in ipairs(list) do get(name, s or 1, var) end
  end
  -- 分几帧建好（进局时：开炮、榴弹、殉爆、机枪打地常用的那几层；一帧 WARM_N 个，第一炮、第一次殉爆不用现建）：
  --   list = { { 层名, 大小, 变体, 几处（不写 1：一下要在两处喷的白闪、制退器、犁沟的一串土团多建几处） }, … }
  local warmQ, warmI = {}, 1
  local WARM_N = 4
  function L.prewarmLater(list)
    for _, it in ipairs(list) do warmQ[#warmQ + 1] = it end
  end
  function L.warmLeft() return #warmQ - warmI + 1 end
  local function stepWarm()
    if warmI > #warmQ then
      if #warmQ > 0 then warmQ, warmI = {}, 1 end
      return
    end
    local n = 0
    warming = true
    while warmI <= #warmQ and n < WARM_N do
      local it = warmQ[warmI]
      warmI += 1
      local key = keyOf(it[1], it[2], it[3])
      if key and nEm < L.MAX_EM - 40 then   -- 留 40 个给打起来现用的
        local e = POOLS[key]
        if not e then
          e = get(it[1], it[2], it[3])
          L.stat.warm += 1
          n += 1
        end
        while e and #e.sites < math.min(it[4] or 1, e.long and SITE_LONG or SITE_SHORT) do
          newSite(e)
          L.stat.warm += 1
          n += 1
        end
      end
    end
    warming = false
  end

  ---------------------------------------------------------------- 远近分档
  -- 1：400 格内全画；2：1100 格内数量减半、不画碎屑和冲击圈；3：2500 格内只画闪光、火球、几团烟和灯；4：更远夜里只点灯
  --   开镜（视场小）按看上去的远近算：8 倍镜里 3000 格外的炮弹落点看着像 400 格
  function L.lod(p)
    local cam = workspace.CurrentCamera
    local d = cam and (p - cam.CFrame.Position).Magnitude or 0
    local fov = cam and cam.FieldOfView or 70
    local de = d * min(1, fov / 70)
    local t = (de <= 400 and 1) or (de <= 1100 and 2) or (de <= 2500 and 3) or 4
    return t, d, de
  end
  function L.perfK() return math.clamp(G.perfK or 1, 0.5, 1.2) end

  ---------------------------------------------------------------- 闪光灯池
  local MAXL = 8
  local rig = holder("FlashRig")
  rig.CFrame = CFrame.new()
  local LS = {}
  for i = 1, MAXL do
    local a = Instance.new("Attachment")
    a.Name = "Flash" .. i
    a.Parent = rig
    local pl = Instance.new("PointLight")
    pl.Enabled, pl.Brightness, pl.Shadows = false, 0, false
    pl.Parent = a
    LS[i] = { a = a, pl = pl, on = false, t0 = 0, dur = 0.1, b0 = 0, range = 0, sh = false }
  end
  local liveSh = 0
  local function release(s)
    s.on = false
    s.pl.Enabled = false
    s.pl.Brightness = 0
    if s.sh then
      s.pl.Shadows = false
      s.sh = false
      liveSh -= 1
    end
  end
  -- p 位置、color、range（最大 120）、bright（夜里的亮度；白天自动加亮）、t 几秒降到 0、
  --   o.shadow 想投影子（同时只给 1 盏）、o.day 白天最多亮几倍（不写 2.5：小的闪光白天要亮一倍半才看得出来；
  --   殉爆、榴弹、炸弹那种大灯给 1.5——Realistic 光照下白天再乘 2.5 一大片过曝）
  L.DAY_MUL, L.DAY_MUL_BIG = 2.5, 1.5
  function L.flash(p, color, range, bright, t, o)
    if typeof(p) ~= "Vector3" then return nil end
    local cam = workspace.CurrentCamera
    range = min(120, range or 20)
    if cam and (cam.CFrame.Position - p).Magnitude > range + 400 then return nil end
    local dk = G.dayK and G.dayK() or 0
    local dm = (o and o.day) or L.DAY_MUL
    local b = (bright or 4) * (1 + (dm - 1) * dk)
    local now = os.clock()
    local slot, weak, wv = nil, nil, math.huge
    for i = 1, MAXL do
      local s = LS[i]
      if not s.on then
        slot = s
        break
      end
      local u = math.clamp((now - s.t0) / s.dur, 0, 1)
      local cur = s.b0 * (1 - u) * (1 - u) * s.range
      if cur < wv then weak, wv = s, cur end
    end
    if not slot then   -- 8 盏都亮着：比最暗的那盏亮就顶掉它
      if weak and wv < b * range then
        slot = weak
        release(slot)
      else
        return nil
      end
    end
    local want = (o and o.shadow and liveSh < 1 and (G.perfK or 1) >= 0.8) and true or false
    local pl = slot.pl
    slot.a.Position = p
    pl.Color, pl.Range, pl.Brightness = color, range, b
    if pl.Shadows ~= want then pl.Shadows = want end
    if want then liveSh += 1 end
    slot.sh = want
    pl.Enabled = true
    slot.on, slot.t0, slot.dur, slot.b0, slot.range = true, now, max(0.03, t or 0.1), b, range
    L.stat.flashes += 1
    return pl
  end
  function L.lightsOn()
    local n, s = 0, 0
    for i = 1, MAXL do
      if LS[i].on then n += 1 end
      if LS[i].sh then s += 1 end
    end
    return n, s
  end
  L.MAXL = MAXL

  ---------------------------------------------------------------- 弹坑焦痕池（榴弹、炸弹、导弹打在地上：薄零件上两张烟的贴图染黑，平铺在地上）
  local SC, scI = {}, 0
  local SC_MAX = 24
  function L.scorch(pos, D, col, tr, nrm)
    scI = scI % SC_MAX + 1
    local s = SC[scI]
    if not s then
      local p = holder("Crater")
      local ds = {}
      for i = 1, 2 do
        local dc = Instance.new("Decal")
        dc.Face = Enum.NormalId.Top
        dc.Texture = TX.SMOKE
        dc.Transparency = 1
        dc.Parent = p
        ds[i] = dc
      end
      s = { p = p, d = ds }
      SC[scI] = s
    end
    local up = (typeof(nrm) == "Vector3" and nrm.Magnitude > 0.5) and nrm.Unit or V(0, 1, 0)
    s.p.Size = V(D, 0.05, D)
    s.p.CFrame = L.upCF(pos + up * 0.07, up) * CFrame.Angles(0, math.random() * 6.28, 0)
    s.base, s.t0, s.on = tr, os.clock(), true
    for _, dc in ipairs(s.d) do
      dc.Color3 = col
      dc.Transparency = tr
    end
    L.stat.scorch += 1
    return s.p
  end
  function L.scorchLive()
    local n = 0
    for _, s in ipairs(SC) do if s.on then n += 1 end end
    return n, #SC
  end
  L.SCORCH_HOLD, L.SCORCH_FADE = 60, 10

  ---------------------------------------------------------------- 余火池：炸弹、导弹、大的残骸炸完坑里还烧一会儿（6 处轮着用）
  local BU = {}
  local BU_MAX = 6
  function L.burn(pos, R, secs)
    local now = os.clock()
    local s, old = nil, nil
    for _, b in ipairs(BU) do
      if now > b.free then
        s = b
        break
      end
      if not old or b.t0 < old.t0 then old = b end
    end
    if not s and #BU < BU_MAX then
      local h = holder("Burner")
      local f = Instance.new("ParticleEmitter")
      apply(f, { tex = TX.FIRE, life = { 0.6, 1.2 }, spd = { 2, 6 }, spread = 25, acc = V(0, 6, 0), size = L.ns(0, 3, 1, 0.5),
        tr = L.ns(0, 0.2, 1, 1), col = L.cs(0, RGB(255, 248, 230), 0.3, RGB(255, 200, 120), 1, RGB(255, 96, 40)), le = 0.9, li = 0, bright = 3, rot = 60 })   -- 中心偏白（用户 11-28）
      f.Parent = h
      local k = Instance.new("ParticleEmitter")
      apply(k, { tex = TX.SOOT, life = { 4, 6 }, spd = { 3, 6 }, spread = 15, acc = V(0, 3, 0), drag = 1, wind = true, size = L.ns(0, 4, 1, 16),
        tr = L.ns(0, 0.15, 1, 1), col = L.cs(RGB(255, 255, 255)), rot = 15 })
      k.Parent = h
      s = { h = h, f = f, k = k, free = 0, t0 = 0, R = 0 }
      BU[#BU + 1] = s
    end
    s = s or old
    if not s then return nil end
    s.h.CFrame = CFrame.new(pos)
    if abs(s.R - R) > 0.5 then   -- 大小换了才改（这一处原来的粒子早灭了）
      s.R = R
      s.f.Size = L.ns(0, R * 0.3, 1, R * 0.05)
      s.k.Size = L.ns(0, R * 0.4, 1, R * 1.8)
    end
    local kb = L.rateK(15, secs, 3, 2)   -- 记进全局预算（火 12 + 烟 3 颗 / 秒）
    s.f.Rate, s.k.Rate = 12 * kb, 3 * kb
    s.t0, s.till, s.free = now, now + secs, now + secs + 6
    L.stat.burners += 1
    return s
  end
  function L.burnersLive()
    local n = 0
    for _, b in ipairs(BU) do if b.till then n += 1 end end
    return n, #BU
  end

  ---------------------------------------------------------------- 每帧（Fx 的 stepFx 调）
  local slowT = 0
  local stepHooks = {}   -- 别的模块每帧要跟着跑的（Fx 的曳光池）
  function L.onStep(f) stepHooks[#stepHooks + 1] = f end
  function L.step(dt)
    local now = os.clock()
    for i = 1, MAXL do
      local s = LS[i]
      if s.on then
        local u = (now - s.t0) / s.dur
        if u >= 1 then release(s) else s.pl.Brightness = s.b0 * (1 - u) * (1 - u) end
      end
    end
    for _, f in ipairs(stepHooks) do f(dt or 1 / 60, now) end
    stepWarm()
    slowT += dt or 0
    if slowT < 0.25 then return end
    slowT = 0
    advance()
    for _, s in ipairs(SC) do   -- 焦痕：60 秒后 10 秒淡掉
      if s.on then
        local age = now - s.t0
        if age > L.SCORCH_HOLD + L.SCORCH_FADE then
          s.on = false
          for _, dc in ipairs(s.d) do dc.Transparency = 1 end
        elseif age > L.SCORCH_HOLD then
          local f = (age - L.SCORCH_HOLD) / L.SCORCH_FADE
          for _, dc in ipairs(s.d) do dc.Transparency = s.base + (1 - s.base) * f end
        end
      end
    end
    for _, b in ipairs(BU) do   -- 余火：到时候关
      if b.till and now > b.till then
        b.till = nil
        b.f.Rate, b.k.Rate = 0, 0
      end
    end
  end

  return L
end

return VfxLib
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="279">
          <Properties>
            <string name="Name">View</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——实体的样子：服务器上只有一个隐形的 Root（位置）和属性（Kind 种类、Team 队伍、Hp 血量……），
--   这里按种类拼一个本地模型，每帧平滑地跟着 Root 走（服务器 10～15 次 / 秒地挪，直接跟会一顿一顿的）；头顶血条
--   机器人步兵（摆腿走路、倒地）、登陆艇（放跳板、被打沉往下沉）、气垫艇、炸药包、地雷
--   地面载具（VehModels 拼的）：每个车轮 / 负重轮各自一个弹簧阻尼（按脚下的地面高度 + 细碎的颠簸，过坡上下抖），
--     车体跟着轮子上下、前后俯仰、左右侧倾（也带弹簧，刹车点头、起步抬头）；炮塔、炮按属性 Ty / Gp 转（自己开的车用本地的），
--     开炮后坐、车轮按走的路转、前轮转向、雷达转、扬尘、被毁冒火冒黑烟；零件一次 BulkMoveTo
--   别的模块能登记自己的样子：G.viewKind[种类] = { build(v, em, team), step(v, dt, camPos), recoil(v), remove(v) }（工事在 FortView）
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local View = {}

function View.init(G)
  local Config = G.Config
  local Map = require(RS:WaitForChild("Map"))
  local Debris = game:GetService("Debris")
  local VD = require(RS:WaitForChild("VehDefs"))
  local VM = require(script.Parent:WaitForChild("VehModels"))
  local TT = require(RS:WaitForChild("TechTree"))   -- 科技树暂用车的真车涂装（TreeKey 属性）
  local SK = require(RS:WaitForChild("WtSkins"))   -- 涂装、贴花（⑯，机库里选的：属性 Camo / TacNo / Emb）
  local WD = require(RS:WaitForChild("WtDamage"))  -- 哪些车殉爆会掀炮塔（CAROUSEL）、先烧几秒（cookSecs）
  local V = Vector3.new
  local CF = CFrame.new
  local RGB = Color3.fromRGB
  local me = Players.LocalPlayer

  -- 一个 Model 装所有实体的样子：热成像时整个打一个高亮（Highlight 有数量上限）
  local VF = Instance.new("Model")
  VF.Name = "EntView"
  VF.Parent = workspace
  G.viewFolder = VF

  local function p(m, size, cf, color, mat, shape)
    local x = Instance.new("Part")
    if shape then x.Shape = shape end
    x.Size, x.CFrame, x.Color = size, cf, color
    x.Material = mat or Enum.Material.SmoothPlastic
    x.Anchored, x.CanCollide, x.CanQuery, x.CanTouch = true, false, false, false
    x.TopSurface, x.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    x.Parent = m
    return x
  end

  -- 每种实体：拼零件（相对 Root 的偏移记在 parts 里），每帧额外动（腿、跳板）
  local UNIFORM = { atk = { RGB(150, 128, 92), RGB(110, 96, 70) }, def = { RGB(84, 104, 70), RGB(64, 78, 54) } }
  local KINDS = {}
  -- 机器人：服务器的命中盒高 5.6 格、中心在脚底上 2.8 格
  KINDS.bot = function(m, team)
    local U = UNIFORM[team] or UNIFORM.atk
    local L = {}
    L.torso = { p(m, V(2, 2, 1), CF(), U[1]), CF(0, 0.4, 0) }
    L.vest = { p(m, V(2.15, 1.3, 1.25), CF(), U[2]), CF(0, 0.55, 0) }
    L.head = { p(m, V(1.2, 1.2, 1.2), CF(), RGB(230, 190, 150)), CF(0, 2.0, 0) }
    L.helmet = { p(m, V(1.45, 0.65, 1.45), CF(), U[2], Enum.Material.SmoothPlastic), CF(0, 2.55, 0) }
    -- 夜视仪：头盔前面的支架和双筒（机器人夜里一直戴着、翻下来）
    L.nvg = { p(m, V(0.62, 0.24, 0.3), CF(), RGB(28, 30, 32), Enum.Material.Metal), CF(0, 2.22, -0.78) }
    for sx = -1, 1, 2 do
      L["nvgTube" .. sx] = { p(m, V(0.42, 0.24, 0.24), CF(), RGB(22, 24, 26), Enum.Material.Metal, Enum.PartType.Cylinder),
        CF(sx * 0.17, 2.12, -1.0) * CFrame.Angles(0, math.pi / 2, 0) }
    end
    L.lleg = { p(m, V(0.9, 2, 0.9), CF(), U[2]), CF(-0.5, -1.6, 0), "leg", 1 }
    L.rleg = { p(m, V(0.9, 2, 0.9), CF(), U[2]), CF(0.5, -1.6, 0), "leg", -1 }
    L.larm = { p(m, V(0.8, 1.9, 0.8), CF(), U[1]), CF(-1.2, 0.5, -0.5) * CFrame.Angles(-1.2, 0.35, 0) }
    L.rarm = { p(m, V(0.8, 1.9, 0.8), CF(), U[1]), CF(1.3, 0.5, -0.4) * CFrame.Angles(-1.2, 0, 0) }
    L.gun = { p(m, V(0.35, 0.45, 3.2), CF(), RGB(45, 47, 50), Enum.Material.Metal), CF(0.35, 0.75, -1.7) }
    L.band = { p(m, V(0.85, 0.35, 0.85), CF(), Config.Teams[team or "atk"].color, Enum.Material.Neon), CF(1.3, 1.0, -0.3) }
    return L
  end
  KINDS.lcm = function(m, team)
    local L = {}
    local hull = RGB(96, 104, 98)
    L.bottom = { p(m, V(16, 2, 34), CF(), hull, Enum.Material.Metal), CF(0, -2, 0) }
    L.lwall = { p(m, V(1, 6, 34), CF(), hull, Enum.Material.Metal), CF(-7.5, 1, 0) }
    L.rwall = { p(m, V(1, 6, 34), CF(), hull, Enum.Material.Metal), CF(7.5, 1, 0) }
    L.back = { p(m, V(16, 7, 1), CF(), hull, Enum.Material.Metal), CF(0, 1.5, 16.5) }
    L.cab = { p(m, V(6, 4, 4), CF(), RGB(120, 128, 120), Enum.Material.Metal), CF(0, 5, 14) }
    L.ramp = { p(m, V(15, 6, 0.8), CF(), hull, Enum.Material.Metal), CF(0, 1, -17), "ramp" }
    return L
  end
  -- 726 型气垫艇：黑色气垫围裙、甲板、两侧上层建筑、尾部两个大风扇
  KINDS.lcac = function(m)
    local L = {}
    local grey = RGB(112, 120, 116)
    L.skirt = { p(m, V(28, 3, 48), CF(), RGB(30, 30, 32), Enum.Material.Fabric), CF(0, -1.6, 0) }
    L.deck = { p(m, V(24, 1, 44), CF(), grey, Enum.Material.DiamondPlate), CF(0, 0.2, 0) }
    for s = -1, 1, 2 do
      L["side" .. s] = { p(m, V(3, 4, 40), CF(), grey, Enum.Material.Metal), CF(s * 12.5, 2.3, 0) }
      L["fan" .. s] = { p(m, V(2, 9, 9), CF(), RGB(70, 74, 72), Enum.Material.Metal, Enum.PartType.Cylinder), CF(s * 6, 6, 20) * CFrame.Angles(0, math.pi / 2, 0) }
      L["fin" .. s] = { p(m, V(0.4, 6, 3), CF(), grey, Enum.Material.Metal), CF(s * 6, 6, 23.5) }
    end
    L.bridge = { p(m, V(4, 4, 6), CF(), grey, Enum.Material.Metal), CF(10.5, 6.2, -14) }
    return L
  end
  KINDS.c4 = function(m) return { b = { p(m, V(1.1, 0.5, 0.7), CF(), RGB(176, 156, 112)), CF() }, l = { p(m, V(0.2, 0.2, 0.2), CF(), RGB(255, 40, 40), Enum.Material.Neon), CF(0, 0.3, 0) } } end
  KINDS.mine = function(m) return { b = { p(m, V(0.4, 1.4, 1.4), CF(), RGB(86, 96, 64), Enum.Material.Metal, Enum.PartType.Cylinder), CFrame.Angles(0, 0, math.pi / 2) } } end

  -- 别人的东西（飞机、车）的速度（锁定圈、提前量、接近率用；服务器不发速度）：服务器一秒只挪 Root 十来次，
  --   原来各处每帧算两帧的位置差，算出来是「0、0、一大截、0……」，平滑系数又是按帧给的——锁定圈、提前量跟着一跳一跳，帧率不同手感也不同。
  --   现在只在位置真的变了才算（这次变和上次变之间挪了多少 / 隔了多久），再按时间常数 0.15 秒平滑（1 − e^(−Δt/0.15)）；
  --   0.6 秒没挪过就当停了（同 G.follow）。rec：调用方自己留的一张表（第一次给空表）；maxV：一次挪得比这还快当成传送、不算。返回平滑后的速度
  --   传送 / 服务器纠正位置（11-27 审查）：按「两次挪之间」的平均速度判 maxV 比原来按帧判松（15 Hz 时一拍挪 maxV / 15 以内都算真的）——
  --   · 隔了 0.6 秒以上才又挪（停了很久、刚出现）：这一下只记位置、不算速度（原来停 5 秒后一下挪 300 格，速度估成 60、0.6 秒才归零）
  --   · 估计已经稳了（连着量了 2 个时间常数以上），一拍算出来的速度跟它差得离谱（差 1.5 倍且超过 150 格 / 秒）：当成一跳、这一拍不算
  --     （行进中一拍挪 80 格原来速度跳到 430）；连着两拍都这样才认（真的换了速度：直接用新的）。服务器拍子的抖动（±三成）在这个门槛里面
  local VEL_TAU = 0.15
  function G.velTrack(rec, p, now, maxV)
    local lp = rec.p
    if not lp then
      rec.p, rec.t, rec.v, rec.age, rec.odd = p, now, Vector3.zero, 0, 0
      return rec.v
    end
    if p ~= lp then
      local g = now - rec.t
      if g > 0.6 then
        rec.v, rec.age, rec.odd = Vector3.zero, 0, 0
      elseif g > 1e-3 then
        local raw = (p - lp) / g
        local v = rec.v
        if raw.Magnitude < (maxV or 2000) then
          local dv = (raw - v).Magnitude
          if (rec.age or 0) >= 2 * VEL_TAU and dv > 150 and dv > 1.5 * v.Magnitude then
            rec.odd = (rec.odd or 0) + 1
            if rec.odd >= 2 then rec.v, rec.odd = raw, 0 end
          else
            rec.v = v:Lerp(raw, 1 - math.exp(-g / VEL_TAU))
            rec.age, rec.odd = (rec.age or 0) + g, 0
          end
        end
      end
      rec.p, rec.t = p, now
    elseif now - rec.t > 0.6 then
      rec.v, rec.age = Vector3.zero, 0
    end
    return rec.v
  end

  local views = {}   -- [entModel] = { model, parts, cf, kind, t, … }
  G.views = views
  local byId = {}    -- [实体编号] = view（开炮后坐要按编号找）
  G.viewById = function(id) return byId[id] end
  -- 弹孔、擦痕（用户 11-25「全部都做」⑨）：服务器 Wt.lua 炮弹打中车时发 fx wtHole（命中点、表面法线、来向、pen / np / ric、在不在炮塔上）——
  --   击穿：焦黑的孔 + 熏黑的一圈；没击穿：灰色的坑；跳弹：顺着来向的一道亮擦痕。零件接到这辆车的零件表后面，跟着车体 / 炮塔走；
  --   每辆最多 24 个（再多就不贴了）
  local HOLE_MAX = 24
  G.viewHole = function(e)
    local v = byId[e.id]
    if not v or not v.M or not v.hullF or not v.plist or type(e.lp) ~= "table" then return end
    if (v.nHoles or 0) >= HOLE_MAX then return end
    v.nHoles = (v.nHoles or 0) + 1
    local M = v.M
    local function v3(t, dflt) return (type(t) == "table" and #t == 3) and Vector3.new(t[1], t[2], t[3]) or dflt end
    local P = v3(e.lp, Vector3.new())
    local n = v3(e.ln, Vector3.new(0, 1, 0))
    n = (n.Magnitude > 0.1) and n.Unit or Vector3.new(0, 1, 0)
    local grp = (e.z and v.tF) and "turret" or "hull"
    local frame = (grp == "turret") and v.tF or v.hullF
    local function put(size, off, color, tr, cyl)   -- off：在车体 / 炮塔坐标系里
      local p = Instance.new("Part")
      p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
      p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
      if cyl then p.Shape = Enum.PartType.Cylinder end
      p.Size, p.Color, p.Material, p.Transparency = size, color, Enum.Material.SmoothPlastic, tr or 0
      p.CFrame = frame * off
      p.Parent = M.model
      table.insert(M.parts, { p, grp, off })
      v.plist[#v.plist + 1] = p
      v.putH = nil   -- 新接了零件：这一帧一定要摆
    end
    local base = CFrame.lookAt(P + n * 0.02, P + n * 1.02) * CFrame.Angles(0, math.pi / 2, 0)   -- 圆柱的轴（X）朝外
    if e.r == "ric" then
      local d = v3(e.ld, Vector3.new(0, 0, -1))
      d = (d.Magnitude > 0.1) and d.Unit or Vector3.new(0, 0, -1)
      local tg = d - n * d:Dot(n)
      if tg.Magnitude < 0.05 then tg = n:Cross(Vector3.new(0, 1, 0)) end
      if tg.Magnitude < 0.05 then tg = Vector3.new(1, 0, 0) end
      local c0 = P + n * 0.03
      put(Vector3.new(0.2, 0.03, 1.2), CFrame.lookAt(c0, c0 + tg.Unit, n), Color3.fromRGB(176, 176, 170), 0)   -- 擦掉漆露出的钢
    elseif e.r == "np" then
      put(Vector3.new(0.04, 0.62, 0.62), base, Color3.fromRGB(96, 94, 90), 0.1, true)
      put(Vector3.new(0.05, 0.28, 0.28), base * CFrame.new(0.005, 0, 0), Color3.fromRGB(58, 56, 52), 0, true)
    else
      put(Vector3.new(0.04, 1.25, 1.25), base, Color3.fromRGB(36, 32, 28), 0.45, true)   -- 熏黑的一圈
      put(Vector3.new(0.05, 0.46, 0.46), base * CFrame.new(0.005, 0, 0), Color3.fromRGB(12, 11, 10), 0, true)   -- 孔
    end
  end
  G.R.Fx.OnClientEvent:Connect(function(list)
    if type(list) ~= "table" then return end
    for _, e in ipairs(list) do
      if type(e) == "table" and e.k == "wtHole" then G.try_(G.viewHole, e) end
    end
  end)
  local function bar(m, adornee, h)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(46, 6)
    bb.StudsOffsetWorldSpace = V(0, h or 5, 0)
    bb.MaxDistance = 260
    bb.Adornee = adornee
    bb.Parent = m
    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = RGB(0, 0, 0)
    bg.BackgroundTransparency = 0.4
    bg.BorderSizePixel = 0
    bg.Parent = bb
    local f = Instance.new("Frame")
    f.Size = UDim2.fromScale(1, 1)
    f.BorderSizePixel = 0
    f.Parent = bg
    return bb, f
  end

  local function add(em)
    if views[em] then return end
    local kind = em:GetAttribute("Kind")
    local root = em:FindFirstChild("Root")
    if not root then return end
    local team = em:GetAttribute("Team")
    local v = { cf = root.CFrame, root = root, kind = kind, t = 0, team = team, id = em:GetAttribute("EntId"), em = em }
    local ext = G.viewKind and G.viewKind[kind]   -- 别的模块登记的样子（工事 FortView……）：build 设好 v.model、v.anchor（血条挂点）
    if kind == "veh" then
      local d = VD.get(em:GetAttribute("Model") or "")
      if not d then return end
      -- 科技树出的车（TreeKey）：还没有原模型、用零件拼的按真车涂装上色（TechTree.paint；用户 11-25「很多车涂装纯米黄」），不按阵营刷沙色
      local tk = em:GetAttribute("TreeKey")
      local tit = (type(tk) == "string") and TT.get(tk) or nil
      -- 涂装（⑯）：机库里选了的（属性 Camo）——零件拼的车按它上色，原模型整体乘个色调
      local camo = em:GetAttribute("Camo")
      local cm = (type(camo) == "string") and SK.CAMO[camo] or nil
      if cm and not cm.base then cm = nil end
      local M = VM.build(d, team, em:GetAttribute("Mods"), cm or (tit and TT.paint(tit)) or nil)   -- 坦克改装：发射器、雷达板、加特林、补贴的爆反块（TankMods）
      -- 影子（11-27 M3 丝滑）：三边都不到 2 格的小零件（螺栓、灯座、把手、工具、天线座……）远处的车不投影子——在阴影图里只有几个像素看不出来，
      --   车多的时候阴影那一遍少画几百个小物体（太阳一挪整张阴影图重画时也少画）；机库、车库里的车（Garage、TechUI 自己 build）不动。
      --   自己开的车、离镜头 120 格以内的车照旧投（第三人称自己的车就在镜头前 15～25 格：车顶机枪、舱盖、潜望镜的影子看得见），
      --   超过 160 格才关（回差）：这里只记下是哪几块，stepVeh 按距离成批开关
      local small = {}
      for _, it in ipairs(M.parts) do
        local bp = it[1]
        if bp:IsA("BasePart") and bp.CastShadow then
          local sz = bp.Size
          if sz.X < 2 and sz.Y < 2 and sz.Z < 2 then small[#small + 1] = bp end
        end
      end
      v.smallSh, v.smallShOn = (#small > 0) and small or nil, true
      M.model.Parent = VF
      v.modsAttr = em:GetAttribute("Mods")
      v.treeKey = tk
      v.camo, v.tacNo, v.emb = camo, em:GetAttribute("TacNo"), em:GetAttribute("Emb")
      if cm and cm.tint then
        for _, it in ipairs(M.parts) do
          local sa = it[1]:FindFirstChildOfClass("SurfaceAppearance")
          if sa then pcall(function() sa.Color = cm.tint end) end
        end
      end
      -- 贴花（⑯）：战术号码（炮塔两侧白字）、国徽（车体两侧）——接到零件表后面，跟着炮塔 / 车体走
      local function decal(grp, off, txt, col, w, h)
        local p = Instance.new("Part")
        p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
        p.Transparency, p.Size = 1, V(w, h, 0.05)
        p.Parent = M.model
        local sg = Instance.new("SurfaceGui")
        sg.Face = Enum.NormalId.Front
        sg.CanvasSize = Vector2.new(w * 60, h * 60)
        sg.LightInfluence = 1
        sg.Parent = p
        local l = Instance.new("TextLabel")
        l.BackgroundTransparency = 1
        l.Size = UDim2.fromScale(1, 1)
        l.Text, l.TextScaled, l.Font = txt, true, Enum.Font.BuilderSansBold
        l.TextColor3, l.TextTransparency = col, 0.08
        l.Parent = sg
        table.insert(M.parts, { p, grp, off })
      end
      local tacNo = em:GetAttribute("TacNo")
      if type(tacNo) == "number" and d.turret then
        local ts, tp = d.turret.size, M.tpiv or d.turret.pivot
        for side = -1, 1, 2 do   -- 正面朝外（Front 面 −Z 转到 ±X）
          decal("turret", CFrame.new(side * (ts.X / 2 * 0.98 + 0.06), ts.Y * 0.5, 0.2) * CFrame.Angles(0, -side * math.pi / 2, 0),
            string.format("%03d", math.clamp(math.floor(tacNo), 0, 999)), Color3.fromRGB(236, 236, 230), 3.0, 1.3)
        end
      end
      local emb = em:GetAttribute("Emb")
      local E = (type(emb) == "string") and SK.EMB[emb] or nil
      if E then
        local hh = d.hullH or (d.H * 0.55)
        for side = -1, 1, 2 do
          decal("hull", CFrame.new(side * (d.W / 2 + 0.06), hh * 0.62, -d.L * 0.22) * CFrame.Angles(0, -side * math.pi / 2, 0), E[1], E[2], 1.6, 1.6)
        end
      end
      v.M, v.def, v.model = M, d, M.model
      v.ty, v.gp, v.recoil = em:GetAttribute("Ty") or 0, em:GetAttribute("Gp") or 0, 0
      v.bob, v.bobV, v.pitch, v.pitchV, v.roll, v.rollV = 0, 0, 0, 0, 0, 0
      v.speed, v.steer, v.lastPos, v.lastYaw = 0, 0, root.CFrame.Position, 0
      v.plist, v.clist = {}, {}
      for i, it in ipairs(M.parts) do v.plist[i] = it[1] end
      local anchor = Instance.new("Part")   -- 血条挂的点（在车顶上）
      anchor.Size, anchor.Transparency, anchor.Anchored = V(0.2, 0.2, 0.2), 1, true
      anchor.CanCollide, anchor.CanQuery, anchor.CanTouch = false, false, false
      anchor.Parent = M.model
      v.anchor = anchor
      v.bb, v.fill = bar(M.model, anchor, 2)
      v.bb.MaxDistance = 600
    elseif ext then
      if not ext.build(v, em, team) or not v.model then return end
      v.ext = ext
      v.model.Parent = VF
      v.bb, v.fill = bar(v.model, v.anchor, 2)
      v.bb.MaxDistance = 600
    else
      local mk = KINDS[kind]
      if not mk then return end
      local m = Instance.new("Model")
      m.Name = kind
      v.parts = mk(m, team)
      v.model = m
      m.Parent = VF
      v.bb, v.fill = bar(m, v.parts[next(v.parts)][1])
    end
    v.fill.BackgroundColor3 = Config.Teams[team or "atk"].color
    views[em] = v
    if v.id then byId[v.id] = v end
  end

  -- 实体没了：被打死的步兵倒地几秒、被打沉的艇往下沉，其余直接删
  local dying = {}
  local function engSndOff(v)   -- 别人的车的发动机、履带声（stepVeh 里挂的）
    if v.engS then
      for _, s in pairs(v.engS) do s:Destroy() end
      v.engS = nil
    end
  end
  local function remove(em)
    local v = views[em]
    if not v then return end
    views[em] = nil
    if v.id then byId[v.id] = nil end
    engSndOff(v)
    local hp = em:GetAttribute("Hp") or 1
    if v.ext and v.ext.remove then
      local ok, keep = pcall(v.ext.remove, v)
      if not ok and G.showError then G.showError("local view: " .. tostring(keep)) end
      if ok and keep == true then return end   -- 自己收尾（机器人倒地，Soldier.lua）
    end
    if hp <= 0 and v.kind ~= "veh" and not v.ext then
      v.t0 = os.clock()
      if v.bb then v.bb:Destroy() end
      table.insert(dying, v)
    else
      v.model:Destroy()
    end
  end
  local function stepDying()
    local t = os.clock()
    for i = #dying, 1, -1 do
      local v = dying[i]
      local a = t - v.t0
      if a > ((v.kind == "bot") and 6 or 5) then
        v.model:Destroy()
        table.remove(dying, i)
      else
        local cf
        if v.kind == "bot" then   -- 绕脚底往后倒
          local k = math.clamp(a / 0.45, 0, 1)
          cf = v.cf * CF(0, -2.8, 0) * CFrame.Angles(k * k * 1.45, 0, 0) * CF(0, 2.8 - 0.4 * k, 0)
        else
          cf = v.cf * CF(0, -a * 2.2, 0) * CFrame.Angles(0, 0, a * 0.12)
        end
        for _, L in pairs(v.parts) do L[1].CFrame = cf * L[2] end
      end
    end
  end

  -- 开炮：这辆车的炮往后坐一下；坦克、自行火炮的车体还被后坐力推得一晃（炮朝前开就抬头、朝侧面开就往另一边歪，弹簧摆两下才停——战雷那样）
  -- 炮的后坐曲线（用户 11-22：「坦克开炮，第一人称的时候那个炮管会瞬间往后」——原来开炮那一帧整段后坐一下子到位，再直线滑回去）：
  --   大炮 0.08 秒往后坐到底（先快后慢），顶住一下，到 0.62 秒复进完（两头慢中间快）；机关炮短：0.02 秒坐到底、0.14 秒回来。返回 0～1
  local function recoilCurve(t, big)
    if not t or t < 0 then return 0 end
    local a, h, e = 0.08, 0.11, 0.62
    if not big then a, h, e = 0.02, 0.025, 0.14 end
    if t < a then local u = t / a return 1 - (1 - u) * (1 - u) end
    if t < h then return 1 end
    if t < e then local u = (t - h) / (e - h) return 1 - u * u * (3 - 2 * u) end
    return 0
  end
  G.recoilCurve = recoilCurve
  function G.vehRecoil(id, g)   -- g：第几门炮（舰艇有前后两门的）
    local v = byId[id]
    if v and v.kind == "veh" then
      local big = v.def.cat == "tank" or v.def.cat == "arty"
      v.recoilA, v.recoilT, v.recoilBig = big and 1.7 or 0.35, 0, big
      v.shots = (v.shots or 0) + 1   -- 开了第几炮（Interior 按这个数接着放炮闩、装填手的动作）
      v.recoil = v.recoilA * recoilCurve(0.25 / 60, big)
      if big and not v.wrecked then
        local a = math.rad(v.ty or 0)
        local k = (v.def.cat == "arty") and 0.95 or 0.8
        v.pitchV = (v.pitchV or 0) + k * math.cos(a)
        v.rollV = (v.rollV or 0) + k * math.sin(a)
        v.bobV = (v.bobV or 0) - 2.5
      end
    elseif v and v.ext and v.ext.recoil then v.ext.recoil(v, g) end
  end

  ---------------------------------------------------------------- 弹药殉爆：炮塔连炮整个掀飞（用户：坦克被打爆盖子可以飞起来，动画逼真一点）
  -- 被毁的那一下，座圈里先喷一柱火，炮塔带着炮转着往上飞一两层楼高，落地砸起土、迸火星，弹一两下歪着停住；车体接着烧、殉爆的小炸响几声。
  -- 随机数按车的编号定：每个人看到的是同一个样子
  local TOSS_G = 9.81 * 2.8 * 1.25   -- 重力（格/秒²，略重一点，落得干脆）
  local trackMark   -- 履带印（下面定义）
  local function tossFx(p, big)
    -- 一柱火（从座圈直冲上去）、往四周上方撒的火星、一团黑烟：11-27 审查 5 改走 VfxLib 的池（WreckFx.lua 的 G.wreckTossFx；
    --   原来每次新建 3 个发射器、一下喷 186 颗，跟 WreckFx 同一刻的大火球叠在一起，殉爆第一秒六七百颗）
    if G.wreckTossFx then G.try_(G.wreckTossFx, p, big) end
    -- 灯：这里不点大灯（审查 6：两盏大灯叠在一起，白天过曝）——坦克（big）的殉爆 WreckFx 同一刻点了一盏；别的车掀炮塔只在老式扣血判毁时有
    --   （下面 add 里 whyW == nil 那一支），服务器那一下总会发 c = "wreck" 的爆炸（Ents.lua / Armor.lua），Fx.lua 的 boom 画它、点它那盏大灯
    --   （11-27 复核：原来这里还给别的车点一盏 Range 70 的，跟 boom 那盏 Range 120 的同时亮）。接着几下闷响、小灯只给别的车（坦克 WreckFx 画了一发发殉爆）
    if G.playSound then
      G.playSound("boom", p, 0.5)
      if not big then
        for i = 1, 4 do   -- 车里的炮弹接着一发发殉爆：闷闷的几声
          task.delay(0.5 + i * 0.45 + math.random() * 0.3, function()
            G.playSound("mortar", p, 0.7 + math.random() * 0.3)
            if G.flash then G.flash(p + V(0, 2, 0), RGB(255, 150, 70), 30, 5, 0.25, { day = 1.5 }) end
          end)
        end
      end
    end
    if G.shake then
      local cam = workspace.CurrentCamera
      local dd = cam and (cam.CFrame.Position - p).Magnitude or 999
      if dd < 220 then G.shake(0.5 * (1 - dd / 220)) end
    end
  end
  local function landFx(p)
    -- 贴地一圈冲击波、一圈土、一把火星（审查 5：走池，WreckFx.lua 的 G.wreckLandFx；原来每次新建 3 个发射器）
    if G.wreckLandFx then G.try_(G.wreckLandFx, p) end
    if G.playSound then G.playSound("splash", p, 0.35) G.playSound("boom", p, 1.6) end
  end
  G.tossCount = 0   -- 测试用
  local function startToss(v)
    local tF = v.tF
    if not tF then return end
    local seed = tonumber(v.id) or 0
    if seed == 0 then for c in tostring(v.id):gmatch(".") do seed += string.byte(c) end end
    local rng = Random.new(seed * 7919 + 17)
    -- 照宣传片里调好的样子（用户 11-22 看片子：掀盖有点尴尬——原来往上 36～54 格 / 秒、乱转，飞七到十五米高像气球）：
    --   往上 20～27 格 / 秒（顶起三米上下）、往旁边 3～6 格 / 秒，绕一根横着的轴慢慢翻（每秒 1～1.6 弧度），落在车旁边歪着停住
    local ang = rng:NextNumber() * 2 * math.pi
    local side = V(math.cos(ang), 0, math.sin(ang))
    -- 11-25「载具爆炸效果不够猛」：冲得更猛一点（往上 27～35 格 / 秒，顶起五六米）、往旁边甩得远一点、翻得快一点——重力照旧偏重，落得干脆不飘
    local hv = side * (4 + rng:NextNumber() * 5)
    local axis = V(-side.Z, (rng:NextNumber() - 0.5) * 0.4, side.X).Unit   -- 横轴：往哪边飞就朝哪边翻下去
    -- 11-27（照战雷、真车 jack-in-the-box：转盘弹药的车炮塔能被顶到两层楼高）：往上的速度按编号分三档——
    --   六成 27～35 格 / 秒（顶起四到六米）、三成 35～42、一成 42～50（九到十三米）；大家看到的一样
    local tier = rng:NextNumber()
    local vy = (tier < 0.6 and (27 + rng:NextNumber() * 8)) or (tier < 0.9 and (35 + rng:NextNumber() * 7)) or (42 + rng:NextNumber() * 8)
    v.toss = {
      cf = tF, vel = V(hv.X, vy, hv.Z),
      w = axis * (1.5 + rng:NextNumber() * 1.0),   -- 角速度（弧度/秒，世界坐标）
      bounce = 0, rest = false,
      restTilt = CFrame.Angles((rng:NextNumber() - 0.5) * 0.5, 0, (rng:NextNumber() - 0.5) * 0.6),
    }
    G.tossCount += 1
    G.tossVy = vy   -- 测试用
    tossFx(tF.Position, v.def.cat == "tank")
    -- 炮塔身上挂着火和黑烟一起飞（2.5 秒；落地 1 秒后关）：审查 5——火 30 → 12、烟 10 → 4 颗 / 秒，记进 VfxLib 的全局预算（粒子太多时再少喷）
    if G.fxPart then
      local th = G.fxPart(nil, V(0.4, 0.4, 0.4), tF, RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
      local kb = (G.vfx and G.vfx.rateK) and G.vfx.rateK(16, 3, 3, 2) or 1
      local tf = Instance.new("ParticleEmitter")
      tf.Texture = "rbxasset://textures/particles/fire_main.dds"
      tf.Rate = 12 * kb
      tf.Lifetime = NumberRange.new(0.35, 0.7)
      tf.Speed = NumberRange.new(1, 4)
      tf.SpreadAngle = Vector2.new(40, 40)
      tf.Acceleration = V(0, 8, 0)
      tf.LightEmission, tf.LightInfluence, tf.Brightness = 0.9, 0, 3
      tf.Rotation, tf.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-60, 60)
      tf.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.4), NumberSequenceKeypoint.new(0.4, 3.6), NumberSequenceKeypoint.new(1, 0.8) })
      tf.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
      tf.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, RGB(255, 226, 170)), ColorSequenceKeypoint.new(0.4, RGB(255, 150, 60)), ColorSequenceKeypoint.new(1, RGB(140, 50, 22)) })
      tf.Parent = th
      local ts = Instance.new("ParticleEmitter")
      ts.Texture = "rbxasset://textures/particles/explosion01_smoke_main.dds"
      ts.Rate = 4 * kb
      ts.Lifetime = NumberRange.new(1.8, 3)
      ts.Speed = NumberRange.new(1, 3)
      ts.SpreadAngle = Vector2.new(30, 30)
      ts.Drag = 0.8
      ts.Acceleration = V(0, 4, 0)
      ts.LightInfluence = 1
      pcall(function() ts.WindAffectsDrag = true end)
      ts.Rotation, ts.RotSpeed = NumberRange.new(0, 360), NumberRange.new(-20, 20)
      ts.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 11) })
      ts.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
      ts.Color = ColorSequence.new(RGB(255, 255, 255))
      ts.Parent = th
      v.toss.fxH = th
      task.delay(2.5, function() tf.Enabled, ts.Enabled = false, false end)
      Debris:AddItem(th, 7)
    end
  end
  local function stepToss(v, dt)
    local T = v.toss
    if not T or T.rest then return end
    dt = math.min(dt, 1 / 20)
    T.vel += V(0, -TOSS_G, 0) * dt
    local p = T.cf.Position + T.vel * dt
    local wm = T.w.Magnitude
    local rot = (wm > 1e-4) and CFrame.fromAxisAngle(T.w.Unit, wm * dt) or CFrame.new()
    local gy = math.max(Map.height(p.X, p.Z), -0.5)
    if p.Y < gy + 0.4 and T.vel.Y < 0 then   -- 砸到地上：弹一下（越弹越低），转得慢下来
      p = V(p.X, gy + 0.4, p.Z)
      T.bounce += 1
      landFx(p)
      if T.bounce >= 2 or math.abs(T.vel.Y) < 14 then   -- 砸下来顶多再颠一下就停住（原来弹三下）
        T.rest = true
        local fh = T.fxH
        if fh then task.delay(1, function() for _, pe in ipairs(fh:GetChildren()) do if pe:IsA("ParticleEmitter") then pe.Enabled = false end end end) end
        -- 停住：保留水平朝向，歪一点躺着（随机的倾角）
        local look = T.cf.LookVector
        local flat = V(look.X, 0, look.Z)
        flat = flat.Magnitude > 0.05 and flat.Unit or V(0, 0, -1)
        T.cf = CFrame.lookAt(p, p + flat) * T.restTilt
        return
      end
      T.vel = V(T.vel.X * 0.45, -T.vel.Y * 0.32, T.vel.Z * 0.45)
      T.w = T.w * 0.5
    end
    T.cf = CFrame.new(p) * rot * (T.cf - T.cf.Position)
    if T.fxH and T.fxH.Parent then T.fxH.CFrame = T.cf end
  end
  G.stepToss = stepToss
  -- 残骸烧的三段（用户 11-28「然后有浓烈的烟雾我持续冒」，见 stepVeh 里那段）：车身火、黑烟每秒几颗；超过 WRECK_THICK 处的烟柱细一档
  --   11-28 晚（用户「现在感觉有点卡」）：浓烟柱是一颗颗几十格大的半透明烟团，几处叠在一起每个像素要画几十层——同时冒浓烟的从 10 处减到 6 处
  --   （机器跟不上、自动画质降下来时 3 处），每秒的颗数、细一档的烟都少一点；烟团的大小 WreckFx heavyBurn 也收了一成多
  local WRECK_FIRE, WRECK_BLACK, WRECK_THIN, WRECK_THICK = { 26, 12, 5 }, { 7, 6, 5 }, 2, 6
  G.wreckBurnRates = { fire = WRECK_FIRE, black = WRECK_BLACK, thin = WRECK_THIN, thick = WRECK_THICK }   -- 测试用
  -- 残骸车身黑烟的 Rate：远近两个发射器（WreckFx.lua 的 G.wreckBlackRate：镜头近的喷小一号那根，另一根 0）
  local function setBlack(M, r)
    if G.wreckBlackRate then G.wreckBlackRate(M, r) elseif M.black then M.black.Rate = r end
  end

  -- 履带印：薄薄一片深色的方块贴在地上，淡出后回收（对象池，最多 MAX_MARK 段）
  local MAX_MARK = 360
  local marks, markI = {}, 0
  local markFolder = Instance.new("Folder")
  markFolder.Name = "TrackMarks"
  markFolder.Parent = workspace
  local TweenService = game:GetService("TweenService")
  local markInfo = TweenInfo.new(14, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
  function trackMark(cf, w, len)
    markI = markI % MAX_MARK + 1
    local m = marks[markI]
    if not m then
      m = Instance.new("Part")
      m.Anchored, m.CanCollide, m.CanQuery, m.CanTouch, m.CastShadow = true, false, false, false, false
      m.Material = Enum.Material.Ground
      m.Color = Color3.fromRGB(46, 40, 32)
      m.Parent = markFolder
      marks[markI] = m
    end
    if m:GetAttribute("Tw") then m:SetAttribute("Tw", nil) end
    m.Size = V(w, 0.1, len)
    m.CFrame = cf
    m.Transparency = 0.35
    TweenService:Create(m, markInfo, { Transparency = 1 }):Play()
  end
  G.trackMarkCount = function() return #marks end   -- 测试用

  ---------------------------------------------------------------- 载具：悬架

  -- 细碎的颠簸（土路、草地上轮子一跳一跳）：两层噪声，约 ±0.35 格
  local function bump(x, z)
    return 0.22 * math.noise(x / 5.3, z / 5.3, 0.37) + 0.12 * math.noise(x / 2.1, z / 2.1, 4.1)
  end
  local function angDiff(a, b) return (b - a + 180) % 360 - 180 end
  -- 两个 CFrame 差不多一样（位置差不到 0.0005 格、朝向差不到约 0.04°）；有一个是 nil 时两个都得是 nil
  local function sameCF(a, b)
    if a == nil or b == nil then return a == b end
    local dp = a.Position - b.Position
    if dp:Dot(dp) > 2.5e-7 then return false end
    return a.LookVector:Dot(b.LookVector) > 0.9999998 and a.UpVector:Dot(b.UpVector) > 0.9999998
  end

  -- 弹簧阻尼（负重轮、车体上下 / 俯仰 / 侧倾）：拆成不超过 1/120 秒的小步算（同 VehCam），一帧最多按 0.12 秒算——
  --   用户 11-25：「然后现在特别卡」「坦克一直在抽搐」：原来一帧一步 v += a·dt，负重轮（k 420、c 26）一帧超过 54 毫秒（不到 18 帧）
  --   就停不下来、在上下两个极限之间来回打，车体跟着轮子抽；车体（k 160）不到 10 帧直接算飞。游戏一卡，坦克就抽
  local function spring(x, vel, tgt, k, c, dt)
    dt = math.min(dt, 0.12)
    local n = math.max(1, math.ceil(dt * 120 - 1e-6))
    local h = dt / n
    for _ = 1, n do
      vel += ((tgt - x) * k - vel * c) * h
      x += vel * h
    end
    return x, vel
  end

  -- 镜头这一帧朝哪、放大了多少（stepView 每帧先填）：远处的车三帧一摆按「看上去多远」判（见 stepVeh 里的 farPut）
  local viewLook, viewK, viewCos = nil, 1, -1
  local function stepVeh(v, dt, camPos)
    local em, d, M = v.em, v.def, v.M
    -- 车灯：有人开、没被打爆才亮
    local lit = (em:GetAttribute("Driver") or 0) ~= 0 and not v.wrecked
    if v.lit ~= lit and M.lamps then
      v.lit = lit
      for _, p in ipairs(M.lamps) do
        p.Transparency = lit and 0 or 0.75
        for _, L in ipairs(p:GetChildren()) do if L:IsA("Light") then L.Enabled = lit end end
      end
    end
    -- 大灯投影子很费（每盏灯每帧画一遍阴影图）：只有自己开的这辆的大灯投影子，别人的照样亮、不投影子
    local mineV = G.myVeh ~= nil and G.myVeh.em == em
    if v.lampShadow ~= mineV and M.lamps then
      v.lampShadow = mineV
      for _, p in ipairs(M.lamps) do
        for _, L in ipairs(p:GetChildren()) do if L:IsA("SpotLight") then L.Shadows = mineV end end
      end
    end
    local own = G.myVeh and G.myVeh.em == em and G.myVeh
    local target = own and own.root or v.root.CFrame
    -- 位置：自己开的直接用本地算的；别人的平滑跟
    if own then v.cf = target else v.cf = G.follow(v, target) end
    local base = v.cf * CF(0, -d.H / 2, 0)
    -- 速度、转弯（别人的车按位置变化估）
    local pos = base.Position
    if own then
      v.speed, v.steer, v.accel = own.speed, own.steer, own.accel or 0
    else
      local delta = pos - v.lastPos
      local sp = delta:Dot(base.LookVector) / math.max(dt, 1e-3)
      v.accel = (sp - v.speed) / math.max(dt, 1e-3)
      v.speed = v.speed + (sp - v.speed) * math.min(1, dt * 6)
      local _, yaw = base:ToEulerAnglesYXZ()
      local yr = angDiff(math.deg(v.lastYaw), math.deg(yaw)) / math.max(dt, 1e-3)
      v.steer = v.steer + (math.clamp(-yr / math.max(d.turn, 1), -1, 1) - v.steer) * math.min(1, dt * 6)
      v.lastYaw = yaw
    end
    v.lastPos = pos
    -- 炮塔、炮
    local ty, gp = em:GetAttribute("Ty") or 0, em:GetAttribute("Gp") or 0
    if own then ty, gp = own.ty, own.gp end
    if own then v.ty, v.gp = ty, gp else
      v.ty = v.ty + angDiff(v.ty, ty) * math.min(1, dt * 10)
      v.gp = v.gp + (gp - v.gp) * math.min(1, dt * 10)
    end
    -- 炮管打坏了（战雷式伤害 Wt.lua 的 barrel 模块，用户 11-26「炮管损毁……对应效果」）：炮管慢慢耷拉到俯角 5°（谁的车都这样画）
    if G.wtModState and d.gun and G.wtModState(em, d, "barrel") == 0 then
      v.droop = math.min(1, (v.droop or 0) + dt * 0.8)
      v.gp = v.gp + (-5 - v.gp) * v.droop
    else
      v.droop = nil
    end
    if v.recoilT then
      v.recoilT += dt
      v.recoil = (v.recoilA or 0) * recoilCurve(v.recoilT, v.recoilBig)
      if v.recoilT > 0.7 then v.recoilT, v.recoil = nil, 0 end
    else
      v.recoil = 0
    end
    -- 遥控武器站：自己开的用本地算的转角，别人的读属性再平滑跟（用户：机枪也要能转动）
    if M.rpiv then
      local my, mp = em:GetAttribute("My") or 0, em:GetAttribute("Mp") or 0
      if own then v.my, v.mp = own.my or 0, own.mp or 0 else
        v.my = (v.my or 0) + angDiff(v.my or 0, my) * math.min(1, dt * 10)
        v.mp = (v.mp or 0) + (mp - (v.mp or 0)) * math.min(1, dt * 10)
      end
    end
    local camD = (pos - camPos).Magnitude
    local far = camD > 420
    -- 摆零件、负重轮按「看上去多远」（11-27 审查：8 倍镜看 1 公里外时速 30 公里的车，三帧才摆一次，60 帧时每 50 毫秒跳 2～3 个点，
    --   准星是顺的、目标一顿一顿）：在视野里、开着镜放大了的车按 距离 × min(1, 视场 / 70) 算（同特效 VfxLib.lod 的口径），
    --   开镜时只多摆镜子里那几辆；视野外、没放大的照旧按距离。扬尘、排气、真地形照旧按距离（far）
    local farPut = far
    if far and viewK < 1 and viewLook and (pos - camPos):Dot(viewLook) > camD * viewCos then farPut = camD * viewK > 420 end
    v.farPut = farPut   -- 测试看
    -- 小零件的影子（见 add）：自己的车、120 格以内投，160 格外不投；变了才成批改
    if v.smallSh then
      local want = own and true or camD < (v.smallShOn and 160 or 120)
      if want ~= v.smallShOn then
        v.smallShOn = want
        for _, bp in ipairs(v.smallSh) do bp.CastShadow = want end
      end
    end
    -- 轮子：每个一个弹簧阻尼；远了不算（省事）
    local W = M.wheels
    local rough = 1
    local onWater = Map.height(pos.X, pos.Z) < -1.5
    -- 真地形（用户 11-22：坦克半截身子卡在地里）：别人的车（服务器按 Map.height 放的）0.2 秒左右量一次车底的真地面（Drive.lua 的 terrainLift），
    --   平滑着抬高 / 放低；自己开的车 Drive 已经算进去了。轮子、履带印也按同一个地面
    local lift = 0
    if own then lift = own.tLift or 0
    elseif not v.wrecked then
      v.tpT = (v.tpT or 0) - dt
      if v.tpT <= 0 then
        v.tpT = 0.18 + ((tonumber(v.id) or 0) % 7) * 0.01
        local _, yawB = base:ToEulerAnglesYXZ()
        v.tLiftT = (not far and not onWater and G.terrainLift) and (G.terrainLift(d, pos, yawB) or 0) or 0
      end
      v.tLift = (v.tLift or 0) + ((v.tLiftT or 0) - (v.tLift or 0)) * math.min(1, dt * 5)
      lift = v.tLift
      if math.abs(lift) > 1e-3 then base = base + V(0, lift, 0) end
    end
    local sF, nF, sB, nB, sL, nL, sR, nR, sum = 0, 0, 0, 0, 0, 0, 0, 0, 0
    if not farPut then
      for _, w in ipairs(W) do
        local wp = (base * CF(w.x, 0, w.z)).Position
        local gy = Map.height(wp.X, wp.Z) + lift
        local tgt
        local trv = M.travel or d.travel   -- 原模型的履带车：履带是死的，负重轮只能动一点
        if gy < -0.5 and onWater then tgt = -trv   -- 在水里：轮子垂下去
        else tgt = math.clamp(math.max(gy, -0.5) + bump(wp.X, wp.Z) * rough - wp.Y, -trv, trv) end
        local dy
        dy, w.vy = spring(w.dy, w.vy, tgt, 420, 26, dt)
        w.dy = math.clamp(dy, -trv * 1.2, trv * 1.2)
        w.spin -= v.speed * dt / (w.rad or w.r)
        sum += w.dy
        if w.z < 0 then sF += w.dy nF += 1 else sB += w.dy nB += 1 end
        if w.x < 0 then sL += w.dy nL += 1 else sR += w.dy nR += 1 end
      end
    end
    local n = math.max(1, #W)
    local wb = math.max(4, (W[#W] and math.abs(W[#W].z - W[1].z)) or d.L * 0.7)
    local trk = math.max(3, d.W * 0.8)
    -- 车体：跟着轮子上下、俯仰、侧倾（弹簧）；起步抬头、刹车点头
    local tBob = sum / n * 0.55
    -- 起步抬头、刹车点头（战雷那样明显一点）
    local tPitch = ((nF > 0 and sF / nF or 0) - (nB > 0 and sB / nB or 0)) / wb * 0.7 + math.clamp((v.accel or 0) * 0.0022, -0.06, 0.06)
    local tRoll = ((nR > 0 and sR / nR or 0) - (nL > 0 and sL / nL or 0)) / trk * 0.7 + math.clamp(v.steer * v.speed * 0.0006, -0.04, 0.04)
    v.bob, v.bobV = spring(v.bob, v.bobV, tBob, 160, 14, dt)
    -- 车身俯仰、侧倾：战雷那样约 1.3 赫兹、阻尼小一点（一刹车车头往下一点头、停住往回弹一下再稳住，1.5～2 秒晃完）——
    --   原来 1.7 赫兹、阻尼大，车身硬邦邦的没分量（用户 11-26「坦克驾驶感跟战雷还是有差别」）
    v.pitch, v.pitchV = spring(v.pitch, v.pitchV, tPitch, 70, 6.5, dt)
    v.roll, v.rollV = spring(v.roll, v.rollV, tRoll, 80, 7.5, dt)
    local hh = d.hullH
    local hullF = base * CF(0, v.bob, 0) * CF(0, hh / 2, 0) * CFrame.Angles(v.pitch, 0, v.roll) * CF(0, -hh / 2, 0)
    local tF = hullF * CF(M.tpiv or d.turret.pivot) * CFrame.Angles(0, -math.rad(v.ty), 0)
    if v.toss then   -- 掀飞了的炮塔自己飞（炮、机枪塔跟着它）
      stepToss(v, dt)
      tF = v.toss.cf
    end
    local gF = tF * CF(M.gpiv or d.gun.pivot) * CFrame.Angles(math.rad(v.gp), 0, 0) * CF(0, 0, v.recoil)
    local rF = M.rpiv and (tF * CF(M.rpiv) * CFrame.Angles(0, -math.rad(v.my or 0), 0)) or nil
    local rgF = (rF and M.rgpiv) and (rF * CF(M.rgpiv) * CFrame.Angles(math.rad(v.mp or 0), 0, 0)) or nil
    v.hullF, v.tF, v.gF, v.rF, v.rgF = hullF, tF, gF, rF, rgF
    if G.tracksStep and M.imported then G.tracksStep(v, M, hullF, dt, far, base) end   -- 会转的履带（Tracks.lua，用户 11-25「坦克履带也要能动」；车速按没加晃动的 base 算）
    local steerA = math.rad(28) * math.clamp(v.steer, -1, 1)
    local now = os.clock()
    -- 爆反块被炸掉（服务器写 EraX："3,7,12"）：那一块换成焦黑的空位（VehModels.eraBlown 新加的零件接到零件表后面）
    local ex = em:GetAttribute("EraX")
    if ex ~= v.eraX then
      v.eraX = ex
      v.putH = nil   -- 新接了零件：这一帧一定要摆
      for i in string.gmatch(ex or "", "%d+") do
        for _, it in ipairs(VM.eraBlown(M, tonumber(i))) do
          table.insert(M.parts, it)
          v.plist[#v.plist + 1] = it[1]
        end
      end
    end
    -- 省事（用户 11-19：游戏非常卡顿）：一辆车一两百个零件，原来每帧全部重摆。停着没动的（停车场、残骸、没人开的、
    --   自己停着没转炮塔）摆好一次就不再挪；420 格外的三帧挪一次（远处看不出来）
    if v.radar == nil then
      v.radar = {}
      for _, it in ipairs(M.parts) do if it[1]:GetAttribute("Radar") then v.radar[it[1]] = true end end
      v.hasRadar = next(v.radar) ~= nil
    end
    -- 扫雷犁（坦克改装，Kit.lua）：模型属性 Plow 1 放下、0.5 正在升、0 收好——放下是 0°，收好往上抬 14°（升起要 11 秒，这里按它慢慢抬）
    local plowMoving = false
    if M.plowPiv then
      local pa = em:GetAttribute("Plow")
      local want = (pa == 1) and 0 or math.rad(14)
      local cur = v.plowA or want
      local step = math.rad(14) / ((pa == 0.5) and 11 or 2.5) * dt
      if math.abs(want - cur) > 1e-4 then
        cur = cur + math.clamp(want - cur, -step, step)
        plowMoving = true
      end
      v.plowA = cur
    end
    local still = not plowMoving and not v.hasRadar and not (v.toss and not v.toss.rest) and v.recoil <= 0 and math.abs(v.speed) < 0.01
      and math.abs(v.steer - (v.putSteer or 1e9)) < 1e-4
      and sameCF(hullF, v.putH) and sameCF(tF, v.putT) and sameCF(gF, v.putG) and sameCF(rF, v.putR) and sameCF(rgF, v.putRG)
    if still then
      for _, w in ipairs(W) do if math.abs(w.vy) > 0.003 then still = false break end end
    end
    v.farN = (v.farN or 0) + 1
    if not still and (not farPut or own or v.farN % 3 == 0) then
      v.putH, v.putT, v.putG, v.putR, v.putRG, v.putSteer = hullF, tF, gF, rF, rgF, v.steer
      local plist, clist = v.plist, v.clist
      -- 一个轮子（履带段）由好几块零件拼成：轮子的变换这一帧只算一次，同一个轮子的零件共用（原来每块零件各算一遍，
      --   stepView 里最热的就是这几行；乘法的先后和原来一样，摆出来的位置一模一样）
      local wcs, scs = v.wcC, v.scC
      if not wcs then wcs, scs = {}, {} v.wcC, v.scC = wcs, scs end
      table.clear(wcs)
      table.clear(scs)
      local kitF, plowF = nil, nil
      for i, it in ipairs(M.parts) do
        local grp, off = it[2], it[3]
        local cf
        if grp == "hull" then cf = hullF * off
        elseif grp == "turret" then
          cf = tF * off
          if v.radar[it[1]] then cf = cf * CFrame.Angles(0, now * 3, 0) end
        elseif grp == "gun" then cf = gF * off
        elseif grp == "rws" then cf = (rF or tF) * off
        elseif grp == "rwg" then cf = (rgF or rF or tF) * off
        elseif grp == "kit" then   -- 车顶加特林：跟着炮俯仰
          if not kitF then kitF = M.kpiv and (tF * CF(M.kpiv) * CFrame.Angles(math.rad(v.gp), 0, 0)) or tF end
          cf = kitF * off
        elseif grp == "plow" then   -- 扫雷犁：绕车头下沿的转轴抬起 / 放下
          if not plowF then plowF = hullF * CF(M.plowPiv) * CFrame.Angles(v.plowA or 0, 0, 0) end
          cf = plowF * off
        elseif grp == "wheel" then
          local j = it[4]
          local wcf = wcs[j]
          if not wcf then
            local w = W[j]
            wcf = base * CF(w.x, w.r + w.dy, w.z)
            if w.steer then wcf = wcf * CFrame.Angles(0, -steerA, 0) end
            wcf = wcf * CFrame.Angles(w.spin, 0, 0)
            wcs[j] = wcf
          end
          cf = wcf * off
        elseif grp == "seg" then
          local j = it[4]
          local scf = scs[j]
          if not scf then
            scf = base * CF(0, W[j].dy, 0)
            scs[j] = scf
          end
          cf = scf * off
        else cf = hullF * off end
        clist[i] = cf
      end
      workspace:BulkMoveTo(plist, clist, Enum.BulkMoveMode.FireCFrameChanged)
      v.anchor.CFrame = hullF * CF(0, d.H + 1, 0)
      G.viewPuts = (G.viewPuts or 0) + #plist   -- 测试、性能面板用：一共摆了多少个零件
    end
    -- 扬尘：在陆地上开得快才有
    local land = not onWater
    if v.fireLight and v.fireLight.Enabled then   -- 残骸的火光一闪一闪：每秒改 10 次（11-27：原来每帧都改）
      v.flT = (v.flT or 0) + dt
      if v.flT >= 0.1 then
        v.flT = 0
        v.fireLight.Brightness = 2.2 + math.random() * 1.6
      end
    end
    -- 扬尘按脚下的地面：土路、沙地最浓，草地淡一半，石头上更淡（每 0.3 秒看一次地面）
    v.dustT = (v.dustT or 0) - dt
    if v.dustT <= 0 then
      v.dustT = 0.3
      local mat = land and Map.material(pos.X, pos.Z, Map.height(pos.X, pos.Z), Map.slope(pos.X, pos.Z)) or nil
      local k, col = 0.5, nil
      if mat == Enum.Material.Ground then k, col = 1, Color3.fromRGB(168, 142, 104)
      elseif mat == Enum.Material.Sand then k, col = 1, Color3.fromRGB(206, 190, 150)
      elseif mat == Enum.Material.Rock or mat == Enum.Material.Slate then k, col = 0.3, Color3.fromRGB(150, 146, 138)
      else k, col = 0.45, Color3.fromRGB(150, 140, 112) end
      v.dustK = k
      if col and v.dustCol ~= col then
        v.dustCol = col
        for _, pe in ipairs(M.dust) do pe.Color = ColorSequence.new(col) end
      end
    end
    -- 粒子上限（11-27 M3 丝滑）：大团半透明的尘一层叠一层是显卡最贵的「填充」——一直开着跑的最多每秒 40 团（原来 60），
    --   按「看上去多远」（距离 × min(1, 视场 / 70)，同 VfxLib.lod 的口径；11-27 复核：原来按裸距离 420 格就砍到三成，开 8～12 倍镜看交战距离上的车只剩三成尘带）：
    --   1100 格外六成、2500 格外三成
    local rate = land and math.min(math.clamp((math.abs(v.speed) - 5) * 1.6, 0, 60) * (v.dustK or 0.5), 40) or 0
    local de = camD * viewK
    rate *= (de > 2500 and 0.35) or (de > 1100 and 0.6) or 1
    -- 侧滑、刚落地：扬尘更浓（自己开的车 Drive 给 slipA）
    if own and own.slipA then rate *= 1 + math.clamp(math.abs(math.sin(own.slipA)) * 4, 0, 2) end
    for _, pe in ipairs(M.dust) do if math.abs(pe.Rate - rate) > 0.5 then pe.Rate = rate end end
    -- 排气（VehModels）：怠速淡淡一缕；往前加速（踩油门、换挡后那一下）喷浓的；远了不放
    if M.exhaust and #M.exhaust > 0 then
      local acc = math.max(0, (v.accel or 0) * ((v.speed or 0) >= 0 and 1 or -1))
      local erate = far and 0 or (2 + math.clamp(acc * 0.9, 0, 26) + math.clamp(math.abs(v.speed or 0) * 0.05, 0, 3))
      for _, pe in ipairs(M.exhaust) do if math.abs(pe.Rate - erate) > 0.4 then pe.Rate = erate end end
    end
    -- 别人的车的发动机、履带声（用户 11-24：坦克的发动机声音做成战雷那样）：3D 的，挂在车的根部件上；380 格以内、有人开、没被毁才响；
    --   车速越快越尖越响、往前加速时更响（像在踩油门），履带车还有履带的哗啦声
    if not own then
      local dist = (pos - camPos).Magnitude
      -- 回差（A 挑的刺）：进 360 格才挂、出 400 格才拆——车在 380 格上下来回开时别每过一次线就拆了又建两个 Sound
      local running = lit and dist < (v.engS and 400 or 360) and v.root ~= nil and v.root.Parent ~= nil
      if running and not v.engS and G.realLoop then
        local tracked = d.arch == "tracked"
        local e1 = G.realLoop(tracked and "tankDrive" or "tankEngine", v.root)
        local e2 = tracked and G.realLoop("tankTracks", v.root) or nil
        for i, s in ipairs({ e1 or false, e2 or false }) do
          if s then
            s.Volume = 0
            s.RollOffMode = Enum.RollOffMode.InverseTapered
            s.RollOffMinDistance, s.RollOffMaxDistance = (i == 1) and 14 or 10, (i == 1) and 380 or 220
            pcall(function() s.TimePosition = math.random() * 2.5 end)   -- 几辆车别齐着响
          end
        end
        v.engS = { e1, e2 }
      end
      if v.engS then
        if not running then
          engSndOff(v)
        else
          local sp = math.clamp(math.abs(v.speed or 0) / math.max(d.speed or 30, 1), 0, 1)
          local acc = math.clamp(math.max(0, (v.accel or 0) * ((v.speed or 0) >= 0 and 1 or -1)) / 8, 0, 1)
          local e1, e2 = v.engS[1], v.engS[2]
          if e1 then
            e1.PlaybackSpeed = 0.72 + 0.5 * sp + 0.08 * acc
            e1.Volume = 0.35 + 0.5 * sp + 0.4 * acc
          end
          if e2 then
            e2.PlaybackSpeed = 0.55 + 0.75 * sp
            e2.Volume = math.clamp((sp - 0.02) * 4, 0, 1) * (0.25 + 0.5 * sp)
          end
        end
      end
    end
    -- 履带印（用户：坦克驾驶参考战雷）：履带车在地上开过去，两条履带底下每走 3.6 格留一段深色的印子，十几秒慢慢淡掉；
    --   离镜头 260 格以外、在水里、被毁了不留；全部车一共最多 MAX_MARK 段（旧的先收）
    if d.arch == "tracked" and land and not v.wrecked and not far and (pos - camPos).Magnitude < 260 then
      local lp = v.markPos
      if not lp then v.markPos = pos
      elseif (pos - lp).Magnitude >= 3.6 then
        local mid = (pos + lp) / 2
        local dir = pos - lp
        local L = dir.Magnitude
        local trackX = (d.rw and d.rw.x) or d.W * 0.36
        local tw = math.max(1.2, d.W * 0.16)
        for sgn = -1, 1, 2 do
          local o = base.RightVector * (sgn * trackX)
          local p = mid + o
          local gy = Map.height(p.X, p.Z) + lift
          if dir.X * dir.X + dir.Z * dir.Z > 0.0025 then   -- 只是上下动（车从高处落下来）：平着的方向没有，不画（lookAt 两点重合）
            trackMark(CFrame.lookAt(V(p.X, gy + 0.06, p.Z), V(p.X + dir.X, gy + 0.06, p.Z + dir.Z)), tw, L + 0.15)
          end
        end
        v.markPos = pos
      end
    else
      v.markPos = nil
    end
    -- 被毁：烧
    if em:GetAttribute("Wreck") and not v.wrecked then
      v.wrecked = true
      v.wreckT = os.clock()
      -- 坦克被打爆：炮塔掀飞；别的有炮塔的车四成会（按编号定，大家看到的一样）
      local whyW = em:GetAttribute("WtWhy")
      local base0 = v.cf * CF(0, -d.H / 2, 0)
      if d.turret and not v.toss then
        local seed = tonumber(v.id) or 0
        -- 战雷式伤害（服务器 Wt.lua）：只有弹放在车体底下（转盘式自动装弹机，WtDamage.CAROUSEL）的车殉爆才掀炮塔——
        --   用户 11-26「要先着火再飞」：先烧 WtCook 秒（舱口喷火、火星噼啪、黑烟往上冒），烧完一下炸开、炮塔飞起来；
        --   乘员打光、烧毁、弹在尾舱的车炮塔留着
        if whyW ~= nil then
          if whyW == "ammo" and WD.CAROUSEL[d.id] then
            local cook = em:GetAttribute("WtCook") or WD.cookSecs(v.id)
            v.cookT = os.clock() + cook
            if G.wreckCook then G.try_(G.wreckCook, v, base0, cook) end
            task.delay(cook, function()
              if v.toss or not (v.M and v.M.model and v.M.model.Parent) then return end
              startToss(v)
              if G.wreckFx then G.try_(G.wreckFx, v, "ammo", base0) end
            end)
          end
        elseif d.cat == "tank" or Random.new(seed * 31 + 7):NextNumber() < 0.4 then startToss(v) end
      end
      if G.wreckPrepBurn then G.try_(G.wreckPrepBurn, M) end   -- 火推亮、黑烟换深灰的贴图、近处那根小一号的黑烟（WreckFx.lua）
      -- 先烧再炸的（转盘车）：wreckCook 真接手了（v.cookJets）才由它定烧的那几秒（火 14、烟 6），炸开以后 heavyBurn 接着。
      --   11-27 复核：原来判的是 v.cookT——wreckCook 离镜头 4000 格外直接不管（不建舱口火柱），这里也不设，残骸 40 秒不冒黑烟、6000 格外连火也没有
      --   （沙海一两公里外开镜看自己打掉的 T-72、开飞机在高处都看不到烟柱）；远处的照别的残骸一样马上烧起来
      if not v.cookJets then
        M.fire.Rate = WRECK_FIRE[1]
        setBlack(M, WRECK_BLACK[1])
      end
      -- 殉爆的大火球、钢板碎块、接连殉爆、舱口窜火、浓黑烟柱、地面烧焦（WreckFx.lua，用户 11-25「载具爆炸效果不够猛画风不够战雷」）
      if G.wreckFx and not v.cookT then G.try_(G.wreckFx, v, whyW, base0) end   -- 先烧再炸的（转盘车殉爆）：大火球等烧完那一下再画
      if M.fire.Parent then   -- 夜里残骸的火光照亮周围（每帧闪一闪）
        local pl = Instance.new("PointLight")
        pl.Color, pl.Range, pl.Brightness, pl.Shadows = Color3.fromRGB(255, 140, 60), 40, 3, false   -- 投影子的只留最近的一处、只点最近的 3 辆（stepFireShadows）
        pl.Parent = M.fire.Parent
        v.fireLight = pl
      end
      for _, it in ipairs(M.parts) do
        local part = it[1]
        if part:IsA("MeshPart") then   -- 原模型：贴图盖住颜色，烧黑要先把贴图去掉
          for _, sa in ipairs(part:GetChildren()) do if sa:IsA("SurfaceAppearance") then sa:Destroy() end end
          pcall(function() part.TextureID = "" end)
          part.Color = Color3.fromRGB(40, 38, 36)
        elseif part:IsA("BasePart") then part.Color = part.Color:Lerp(Color3.new(0.05, 0.05, 0.05), 0.65) end
      end
      for _, pe in ipairs(M.dust) do pe.Enabled = false end
      for _, pe in ipairs(M.exhaust or {}) do pe.Enabled = false end
      -- 「窗帘-1」的红外干扰灯（T-90A，VehModels）：车没了，灯灭——灯罩剩一块暗红的玻璃
      if M.model then
        for _, x in ipairs(M.model:GetDescendants()) do
          local nm = x.Name
          if nm == "ShtoraLens" or nm == "ShtoraMid" or nm == "ShtoraCore" then
            x.Material = Enum.Material.Glass
            x.Color = Color3.fromRGB(60, 16, 12)
          elseif nm == "ShtoraHalo" or nm == "ShtoraLight" then
            x.Enabled = false
          end
        end
      end
    end
    -- 烧痕（⑨）：着火（服务器属性 WtF）超过 5 秒，车身熏黑一层（只改没贴图的零件；一辆车最多熏两次）
    if em:GetAttribute("WtF") == true and not v.wrecked then
      v.fireT0 = v.fireT0 or os.clock()
      if os.clock() - v.fireT0 > 5 and (v.scorch or 0) < 2 then
        v.scorch = (v.scorch or 0) + 1
        v.fireT0 = os.clock()
        for _, it in ipairs(M.parts) do
          local part = it[1]
          if part:IsA("BasePart") and not (part:IsA("MeshPart") and part.TextureID ~= "") and not part:FindFirstChildOfClass("SurfaceAppearance") then
            part.Color = part.Color:Lerp(Color3.new(0.06, 0.06, 0.06), 0.22)
          end
        end
      end
    else
      v.fireT0 = nil
    end
    -- 残骸整局留着（服务器 Armor.lua keepWreck）。用户 11-28（战雷截图）「然后有浓烈的烟雾我持续冒」：打爆的车一直冒浓黑的烟柱——
    --   原来烧四十秒火小下去、七十秒只剩一缕烟；改成：前 60 秒大火 + 浓烟柱（WreckFx heavyBurn 定的），60 秒火小一半、烟照样浓，
    --   150 秒以后小火苗 + 烟柱一直冒到残骸没了（火光这时灭），不再只剩一缕。
    --   几十辆车壳一起冒浓烟客户端吃不消：同时最多 WRECK_THICK 处按上面冒，再多的（最早打掉的先）细一档——还是一根看得见的烟柱（stepFireShadows 每半秒排）
    if v.wreckT then
      local age = os.clock() - v.wreckT
      local stage = (age > 150 and 2) or (age > 60 and 1) or 0
      local thin = v.smokeThin == true
      local key = stage * 2 + (thin and 1 or 0)
      if key ~= (v.burnKey or 0) then
        v.burnKey = key
        v.burnt1 = (stage >= 1) or nil
        v.burnt2 = (stage >= 2) or nil
        local fireR, blackR = WRECK_FIRE[stage + 1], WRECK_BLACK[stage + 1]
        if thin then fireR, blackR = math.min(fireR, 5), WRECK_THIN end
        if M.fire then M.fire.Rate = fireR end
        if M.black then setBlack(M, blackR) end
        if stage >= 2 and v.fireLight then v.fireLight:Destroy() v.fireLight = nil end
      end
      -- 镜头 60 格内黑烟小一号（贴脸的大烟团最费：半透明叠太多层）；半秒看一次，进 55 / 出 70 才换。
      --   11-27 审查 7：两个发射器换着喷（M.black 远、M.blackN 小一号的；WreckFx.lua 的 G.wreckBlackRate），不改 Size——
      --   Size 是整条曲线，一改连已经在飘的四十来颗一起缩放，走过那条线整根烟柱一下变小
      v.nearT = (v.nearT or 0) + dt
      if M.black and M.blackN and G.wreckBlackRate and v.nearT > 0.5 then
        v.nearT = 0
        local dd = (M.black.Parent.Position - camPos).Magnitude
        local want = v.blackNear
        if dd < 55 then want = true elseif dd > 70 then want = false end
        if want ~= v.blackNear then
          v.blackNear = want
          G.wreckBlackRate(M, nil, want == true)
        end
      end
    end
  end

  ---------------------------------------------------------------- 跟着实体文件夹

  local function watch(folder)
    for _, em in ipairs(folder:GetChildren()) do task.defer(add, em) end
    folder.ChildAdded:Connect(function(em) task.defer(add, em) end)
    folder.ChildRemoved:Connect(remove)
  end
  task.spawn(function()
    local f = workspace:WaitForChild("Ents", 60)
    if f then watch(f) end
  end)

  local cam = workspace.CurrentCamera
  -- 原模型是进服后陆续复制过来的：先用零件拼的样子建起来的，两秒看一次原模型齐了没有，齐了就重建（用户：很多飞机找不到建模）
  local function rebuild(em)
    local v = views[em]
    if not v then return end
    views[em] = nil
    if v.id then byId[v.id] = nil end
    engSndOff(v)
    if v.ext and v.ext.remove then G.try_(v.ext.remove, v) end
    if v.model then v.model:Destroy() end
    add(em)   -- 新建的 solidOn 是空的：下一帧离得近就重新挑实心零件
  end
  local impT = 0
  local function checkImports(dt)
    impT += dt
    if impT < 2 then return end
    impT = 0
    local list = {}
    for em, v in pairs(views) do
      local ok = false
      if v.kind == "veh" then
        ok = v.M ~= nil and not v.M.imported and v.def ~= nil and VM.importedFor(v.def) ~= nil
        if em:GetAttribute("Mods") ~= v.modsAttr or em:GetAttribute("TreeKey") ~= v.treeKey then ok = true end
        if em:GetAttribute("Camo") ~= v.camo or em:GetAttribute("TacNo") ~= v.tacNo or em:GetAttribute("Emb") ~= v.emb then ok = true end   -- 涂装、贴花晚到了（⑯）   -- 改装属性、科技树名字晚到了（或者换了）：按新的重建
      elseif v.ext and v.ext.importReady then ok = v.ext.importReady(v) == true end
      if ok and em.Parent then table.insert(list, em) end
    end
    for _, em in ipairs(list) do G.try_(rebuild, em) end
  end
  -- 实体对得上模型（用户：模型的实体和模型对不上）：服务器上的实体只有一个方盒（按型号表的长宽高），坦克是炮塔那么高一整块、
  --   飞机连翼尖都框不全、船连桅杆那么高——碰撞改在本机做：离自己的人近的车、飞机、船、工事、气垫艇，把看得见的零件设成实心
  --   （人的物理本来就在本机算，挡人按真正的外形；服务器的方盒只管挨打，不挡人）。很小的、几乎透明的、发光的、转的（旋翼、螺旋桨）、尾焰不算；
  --   自己正开着的那辆不算（人在里面）
  local SOLID_KIND = { veh = true, air = true, ship = true, fort = true, lcac = true }
  -- 一卡一卡（用户 11-18）：原来 280 格内的车、飞机、船全开着碰撞，这些零件每帧都在挪，物理引擎每帧都要重算——
  --   只在步行时、70 格内才开（走路撞得上的就这么近），一帧最多新开一辆（一下子来一群也不顿）
  local SOLID_IN, SOLID_OUT = 70, 95
  local solidBudget = 0
  local function solidSet(v, on)
    if (v.solidOn == true) == on then return end
    v.solidOn = on
    if on then
      local skip = {}
      local M = v.M
      if M then
        for _, key in ipairs({ "blades", "discs", "flames", "strobes", "lamps", "tvc" }) do
          for _, it in ipairs(M[key] or {}) do
            local p = (typeof(it) == "Instance") and it or (type(it) == "table" and (it.p or it[1])) or nil
            if typeof(p) == "Instance" then skip[p] = true end
          end
        end
      end
      local list = {}
      for _, p in ipairs(v.model:GetDescendants()) do
        if p:IsA("BasePart") and not skip[p] and p ~= v.anchor and p.Transparency < 0.9 and p.Material ~= Enum.Material.Neon
          and math.max(p.Size.X, p.Size.Y, p.Size.Z) >= 0.8 then
          p.CanQuery = true   -- 实心的零件 CanQuery 得开着（Roblox 的规定）
          p.CanCollide = true
          list[#list + 1] = p
        end
      end
      v.solidList = list
    else
      for _, p in ipairs(v.solidList or {}) do
        if p.Parent then
          p.CanCollide = false
          p.CanQuery = false
        end
      end
      v.solidList = nil
    end
  end
  G.viewSolid = solidSet
  local function stepSolid(v, here)
    if not SOLID_KIND[v.kind] or not v.model or not v.model.Parent then return end
    local mine = (G.drive and G.drive.em == v.em) or (G.fly and G.fly.em == v.em)
    local onFoot = not G.drive and not G.fly
    local p = (v.cf and v.cf.Position) or v.root.Position
    local d = here and (p - here).Magnitude or math.huge
    local want = onFoot and (not mine) and ((v.solidOn and d < SOLID_OUT) or (not v.solidOn and d < SOLID_IN))
    if want and not v.solidOn then
      if solidBudget <= 0 then return end   -- 这一帧已经开过一辆了：下一帧再开
      solidBudget -= 1
    end
    solidSet(v, want and true or false)
  end

  -- 残骸的火光（点光源）投影子很费（每盏灯每帧画一遍六面的阴影图）：只让离镜头最近、220 格内的那一处投影子，半秒挑一次
  local fireT = 0
  local function stepFireShadows(dt, camPos)
    fireT += dt
    if fireT < 0.5 then return end
    fireT = 0
    -- 11-27（M3 上要丝滑）：残骸的火光只点离镜头最近的 3 处（几十辆残骸一起亮着点光源吃不消），投影子的只给最近、200 格内那一处
    local list = {}
    for _, v in pairs(views) do
      local pl = v.fireLight
      if pl and pl.Parent then
        local dv = pl.Parent.Position - camPos
        list[#list + 1] = { pl = pl, d = dv:Dot(dv) }
      end
    end
    table.sort(list, function(a, b) return a.d < b.d end)
    for i, it in ipairs(list) do
      local on = i <= 3
      if it.pl.Enabled ~= on then it.pl.Enabled = on end
      local want = i == 1 and it.d < 200 * 200 and (G.perfK or 1) >= 0.8
      if it.pl.Shadows ~= want then it.pl.Shadows = want end
    end
    -- 冒浓烟的残骸最多 WRECK_THICK 处（最近打掉的优先），再早的细一档（stepVeh 按 v.smokeThin 换 Rate）
    local wr = {}
    for _, v in pairs(views) do if v.wreckT then wr[#wr + 1] = v end end
    local nThick = ((G.perfK or 1) < 0.8) and math.min(3, WRECK_THICK) or WRECK_THICK
    if #wr > nThick then table.sort(wr, function(a, b) return a.wreckT > b.wreckT end) end
    for i, v in ipairs(wr) do v.smokeThin = (i > nThick) or nil end
  end

  function G.stepView(dt)
    solidBudget = 1
    stepDying()
    G.try_(stepFireShadows, dt, cam.CFrame.Position)
    G.try_(checkImports, dt)
    local myTeam = me:GetAttribute("Side")
    local camPos = cam.CFrame.Position
    do   -- 视野（stepVeh 的 farPut）：放大倍数 min(1, 视场 / 70)；视野的锥按画面对角线的一半再放宽 15%（快进画面的也算）
      local fov = cam.FieldOfView
      viewK = math.min(1, fov / 70)
      if viewK < 1 then
        local vp = cam.ViewportSize
        local asp = (vp.Y > 0) and vp.X / vp.Y or 16 / 9
        viewLook = cam.CFrame.LookVector
        viewCos = math.cos(math.min(math.pi / 2, math.atan(math.tan(math.rad(fov) / 2) * math.sqrt(1 + asp * asp)) * 1.15))
      else
        viewLook = nil
      end
    end
    local ch = me.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local here = hrp and hrp.Position or nil
    for em, v in pairs(views) do
      if not em.Parent then
        remove(em)
      else
        local hp, mx = em:GetAttribute("Hp") or 1, em:GetAttribute("MaxHp") or 1
        if hp ~= v.hpSeen or mx ~= v.mxSeen then
          v.hpSeen, v.mxSeen = hp, mx
          v.fill.Size = UDim2.fromScale(math.clamp(hp / math.max(1, mx), 0, 1), 1)
        end
        -- 自己开的车、船不挂血条：右下的载具面板有车体血量；坐进瞄准镜（第一人称）时镜头前也不会飘着自己的血条
        local mine = (G.myVeh ~= nil and G.myVeh.em == em) or (G.sail ~= nil and G.sail.em == em)
        local bbOn = hp < mx and hp > 0 and not mine
        if v.bb.Enabled ~= bbOn then v.bb.Enabled = bbOn end
        G.try_(stepSolid, v, here)
        if v.kind == "veh" then
          G.try_(stepVeh, v, dt, camPos)
        elseif v.ext then
          G.try_(v.ext.step, v, dt, camPos)
        else
          local target = v.root.CFrame
          v.cf = G.follow(v, target)
          local moved = v.fl.vel.Magnitude * 0.1   -- 走多快（腿、跳板的动画快慢）：按快照算的速度，一个更新间隔挪多远
          if v.kind == "lcac" and G.lcacUnderMine then   -- 自己正开着的这条气垫艇：按本地算的车底摆（不等服务器，和甲板上的车贴死）
            local mine = G.lcacUnderMine(em:GetAttribute("Carry"))
            if mine then v.cf = mine end
          end
          v.t += dt * math.clamp(moved * 2, 0, 12)
          for _, L in pairs(v.parts) do
            local off = L[2]
            if L[3] == "leg" then off = off * CFrame.Angles(math.sin(v.t * 1.2) * 0.7 * L[4], 0, 0)
            elseif L[3] == "ramp" and em:GetAttribute("Ramp") then off = off * CFrame.Angles(-1.3, 0, 0) end
            L[1].CFrame = v.cf * off
          end
        end
      end
    end
  end
  -- 跟服务器位置（用户 11-18：一卡一卡的）：服务器一秒只挪十来次（飞机按驾驶的人每秒报 15 次），原来每帧往「最新收到的位置」指数逼近——
  --   目标一跳一跳，跟的速度就一阵快一阵慢（十赫兹的顿挫，别人的车、飞机、船、士兵全是）。改成快照插值：记下最近几次收到的位置和收到的时刻，
  --   画面晚一点点（约 1.3 个更新间隔，按实际收到的间隔自己调），在前后两次之间按时间匀速插；跳得太远（传送、重生）直接过去；
  --   停了很久又动：先补一个「上一刻还在原地」的快照，从静止起步，不一下窜出去。返回插好的 CFrame；fl.vel 是按快照算的速度（格 / 秒）
  local FL_N = 6
  function G.follow(v, target, jump)
    local now = os.clock()
    local f = v.fl
    if not f then
      f = { n = 1, t = { now }, c = { target }, gap = 0.1, vel = Vector3.zero }
      v.fl = f
      return target
    end
    local n = f.n
    local last = f.c[n]
    if target ~= last then
      local g = now - f.t[n]
      if (target.Position - last.Position).Magnitude > (jump or 250) then   -- 传送、重生：清空、直接过去
        f.n, f.t, f.c, f.vel = 1, { now }, { target }, Vector3.zero
        return target
      end
      if g < 0.5 then
        f.gap += (math.clamp(g, 0.03, 0.3) - f.gap) * 0.2
      else   -- 停了很久才又动：补一个刚才还在原地的快照
        if n >= FL_N then table.remove(f.t, 1) table.remove(f.c, 1) n -= 1 end
        n += 1
        f.t[n], f.c[n] = now - f.gap, last
      end
      if n >= FL_N then table.remove(f.t, 1) table.remove(f.c, 1) n -= 1 end
      n += 1
      f.t[n], f.c[n] = now, target
      f.n = n
      local dtS = f.t[n] - f.t[n - 1]
      if dtS > 1e-3 then f.vel = f.vel:Lerp((f.c[n].Position - f.c[n - 1].Position) / dtS, 0.5) end
    elseif now - f.t[n] > 0.6 then
      f.vel = Vector3.zero   -- 好一阵没动了：停了
    end
    local rt = now - math.clamp(f.gap * 1.3, 0.06, 0.3)
    if rt >= f.t[n] then return f.c[n] end
    for i = n, 2, -1 do
      local t0 = f.t[i - 1]
      if t0 <= rt then
        return f.c[i - 1]:Lerp(f.c[i], (rt - t0) / math.max(1e-3, f.t[i] - t0))
      end
    end
    return f.c[1]
  end

  -- 准星射线打在「看得见的」实体上（评估后的修改：命中判定）：画面上的小兵、车是 G.follow 插值过的，比服务器的命中盒晚一截，
  --   原来准星射线打的是隐形命中盒，瞄着跑动的小兵身体开枪，射线从命中盒后面擦过去、曳光弹穿过人打在地上；
  --   现在按画面上的位置算（小兵用随姿势变的 Hit 盒，别的用 Root 盒），服务器那边按开枪的人看到的那一刻判定（Rewind.lua）。
  --   返回最近的交点、实体模型、距离；maxLen 以内没有就返回 nil
  local function slab(p, d, h, tmin, tmax)
    if math.abs(d) < 1e-9 then
      if p < -h or p > h then return nil end
      return tmin, tmax
    end
    local t1, t2 = (-h - p) / d, (h - p) / d
    if t1 > t2 then t1, t2 = t2, t1 end
    if t1 > tmin then tmin = t1 end
    if t2 < tmax then tmax = t2 end
    if tmin > tmax then return nil end
    return tmin, tmax
  end
  function G.viewRay(o, dir, maxLen)
    local u = dir.Unit
    local best, bestEm, bestT = nil, nil, maxLen
    for em, v in pairs(views) do
      local root = v.root
      if root and root.Parent and em.Parent and em:GetAttribute("Driver") ~= me.UserId then
        local hb = em:FindFirstChild("Hit") or root
        local cf = ((v.fl and v.cf) or root.CFrame) * root.CFrame:ToObjectSpace(hb.CFrame)   -- 有快照插值的按画面上的位置
        local size = hb.Size
        local rel = cf.Position - o
        local along = rel:Dot(u)
        local r = size.Magnitude / 2
        if along > -r and along < bestT + r and (rel - u * along).Magnitude <= r then
          local lo, ld = cf:PointToObjectSpace(o), cf:VectorToObjectSpace(u)
          local a, b = slab(lo.X, ld.X, size.X / 2, 0, bestT)
          if a then a, b = slab(lo.Y, ld.Y, size.Y / 2, a, b) end
          if a then a, b = slab(lo.Z, ld.Z, size.Z / 2, a, b) end
          if a and a < bestT then best, bestEm, bestT = o + u * a, em, a end
        end
      end
    end
    if best then return best, bestEm, bestT end
    return nil
  end

  -- 一辆车出错不影响别的
  function G.try_(f, ...)
    local ok, err = pcall(f, ...)
    if not ok and G.showError then G.showError("local view: " .. tostring(err)) end
  end
end

return View
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="280">
          <Properties>
            <string name="Name">Warfx</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——战场氛围。用户 11-18：「按照 3A 游戏的标准把这款游戏做到惊艳，自由发挥，参考战雷、战地」（夜晚照旧锁定）
--   1. 照明弹（服务器 Battle.lua 打的，特效 k = "illum"）：按服务器时间算——
--      发射：从舰炮 / 迫击炮那里一颗拖着短尾巴的亮点抛物线飞上去（离镜头远的不画）；炸开：一闪、一小团烟、「噗」一声（按距离晚到）；
--      挂着降落伞慢慢落、随风飘，往上冒烟、往下掉火星，最后几秒逐渐熄灭。
--      照亮：Roblox 的点光源最远 60 格，照明弹在一百多格高——光源放在照明弹正下方离地 40 格的地方跟着走（离镜头最近的那发投影子：
--      影子跟着照明弹慢慢挪），DayNight.lua 按 G.illum 平滑提高附近环境光与曝光。
--   2. 夜空：一层低云；守方要地的对空探照灯慢慢扫；远处时不时的闷炮声（只有声音）
--   3. 房子着火、塌（服务器 Battle.lua）：着火的房子冒火、冒烟、火光一闪一闪；塌的时候扬起一大团尘土、碎块乱飞、轰隆一声；废墟冒一阵烟
--   4. 暴风雨（服务器给强度 StormK）：雨、闪电、雷声，云变厚、浪变大、风变大、雾变近
--   5. 阵亡镜头：死了以后镜头转向凶手、拉近，去色、景深，红色标记
local Warfx = {}

function Warfx.init(G)
  local RunService = game:GetService("RunService")
  local Debris = game:GetService("Debris")
  local Lighting = game:GetService("Lighting")
  local Players = game:GetService("Players")
  local GuiService = game:GetService("GuiService")
  local reducedMotion = false
  pcall(function()
    local function readMotion() reducedMotion = GuiService.ReducedMotionEnabled == true end
    readMotion()
    GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(readMotion)
  end)
  local V = Vector3.new
  local RGB = Color3.fromRGB
  local NSK, CSK = NumberSequenceKeypoint.new, ColorSequenceKeypoint.new
  local MapM = G.Map
  local FXF = G.fxFolder or workspace
  local function camPos() local c = workspace.CurrentCamera return c and c.CFrame.Position or V() end
  local function serverNow()
    local ok, t = pcall(function() return workspace:GetServerTimeNow() end)
    return ok and t or os.clock()
  end
  local TX = {
    glow = "rbxasset://textures/particles/explosion01_implosion_main.dds",
    smoke = "rbxasset://textures/particles/smoke_main.dds",
  }
  local EXP = "rbxasset://sounds/impact_explosion_03.mp3"
  local WIND = "rbxasset://sounds/action_falling.ogg"
  local WARM = RGB(255, 238, 208)

  local function part(shape, size, cf, color, mat, tr)
    local p = Instance.new("Part")
    p.Shape = shape or Enum.PartType.Block
    p.Size = size
    p.CFrame = cf
    p.Color = color
    p.Material = mat or Enum.Material.SmoothPlastic
    p.Transparency = tr or 0
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Parent = FXF
    return p
  end
  local function emitter(h, o)
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = o.tex
    pe.Rate = o.rate or 0
    pe.Lifetime = NumberRange.new(o.life[1], o.life[2])
    pe.Speed = NumberRange.new(o.spd[1], o.spd[2])
    pe.SpreadAngle = Vector2.new(o.spread or 180, o.spread or 180)
    pe.Size = o.size
    pe.Transparency = o.tr
    pe.Color = o.col
    pe.Acceleration = o.acc or V()
    pe.Drag = o.drag or 0
    pe.LightEmission = o.le or 0
    pe.LightInfluence = (o.le or 0) > 0.5 and 0 or 1
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-(o.rot or 20), o.rot or 20)
    pe.ZOffset = o.z or 0
    pe.EmissionDirection = o.dir or Enum.NormalId.Top
    pe.Parent = h
    return pe
  end
  local function nseq(...)
    local a, kp = { ... }, {}
    for i = 1, #a, 2 do kp[#kp + 1] = NSK(a[i], a[i + 1]) end
    return NumberSequence.new(kp)
  end
  local function cseq(a, b) return ColorSequence.new({ CSK(0, a), CSK(1, b) }) end

  ---------------------------------------------------------------- 照明弹

  local GR = V(0, -60, 0)   -- 上升段的「重力」（看着像一发炮弹抛上去，不按真实重力：几秒就到）
  local flares = {}         -- 正在飞 / 烧的
  G.flares = flares         -- 测试用
  local illumK = 0

  -- 照明弹在本地时刻 t（os.clock）的位置：上升段抛物线，炸开后随风飘、慢慢落、轻轻摆
  --   收到时按服务器时间算出它已经飞了多久，换成本地时钟的起点 f.t0（以后只看本地时钟：不受服务器时间抖动影响）
  local function flarePos(f, t)
    local e = f.e
    local u = t - f.t0
    if u < e.fl then
      local v0 = (e.p - e.o - GR * (0.5 * e.fl * e.fl)) / e.fl
      return e.o + v0 * u + GR * (0.5 * u * u), "rise"
    end
    local b = u - e.fl
    local fall = e.fall * b
    if b > e.burn then fall = e.fall * e.burn + (b - e.burn) * e.fall * 4 end   -- 烧完了伞兜不住，掉得快
    local sway = V(math.sin(b * 0.9 + f.ph) * 1.6, 0, math.cos(b * 0.7 + f.ph) * 1.2)
    return e.p + (e.w or V()) * b - V(0, fall, 0) + sway, (b <= e.burn) and "burn" or "out"
  end

  -- 柔和升降亮度，避免把高频闪烁传给整个夜间调色。
  local function flareI(f, b, burn)
    if b < 0 or b > burn then return 0 end
    local up = math.clamp(b / 0.75, 0, 1)
    local tail = math.clamp((burn - b) / 4, 0, 1)
    local glow = reducedMotion and 0.95 or (0.95 + 0.05 * math.sin(b * 2.4 + f.ph))
    return up * glow * tail
  end

  local function popSound(p, d)
    if not G.sfx or d > 3200 then return end
    G.sfx({ { id = EXP, vol = 0.55, s = { 1.9, 2.15 }, reg = { 0.02, 0.28 }, eq = { -6, 0, 0 } },
      { id = EXP, vol = 0.25, s = { 0.9, 1 }, reg = { 0.04, 0.6 }, eq = { 6, -4, -14 }, delay = 0.03 } },
      p, { delay = d / 960, rmin = 120, rmax = 3200, hiCut = -10 * math.clamp((d - 400) / 2000, 0, 1) })
  end

  local function ignite(f, pos, age)
    local d = (pos - camPos()).Magnitude
    if age < 0.65 then
      if not reducedMotion and G.flash and d < 2400 then G.flash(pos, WARM, 50, 2.7, 0.3) end
      popSound(pos, d)
    end
    local core = part(Enum.PartType.Ball, V(0.9, 0.9, 0.9), CFrame.new(pos), RGB(255, 246, 228), Enum.Material.Neon, 0)
    core.Name = "Illum"
    f.core = core
    -- 刺眼的一团光晕（一闪一闪）
    f.halo = emitter(core, { tex = TX.glow, rate = 22, life = { 0.12, 0.2 }, spd = { 0, 0 }, size = nseq(0, 6.5, 1, 9), tr = nseq(0, 0.2, 1, 0.65),
      col = cseq(RGB(255, 250, 236), WARM), le = 1, z = 1 })
    -- 往下掉的火星
    f.sparks = emitter(core, { tex = TX.glow, rate = 7, life = { 0.6, 1.4 }, spd = { 2, 6 }, spread = 35, dir = Enum.NormalId.Bottom, acc = V(0, -40, 0),
      size = nseq(0, 0.4, 1, 0), tr = nseq(0, 0, 1, 0.4), col = cseq(RGB(255, 236, 190), RGB(255, 150, 70)), le = 1 })
    -- 往上飘的白烟柱：被照明弹自己照亮（受光），一条留在半空慢慢散开
    local pk = G.perfK or 1
    if d < 6000 then
      f.smoke = emitter(core, { tex = TX.smoke, rate = (pk < 0.75) and 4 or 9, life = { 9, 15 }, spd = { 0.5, 1.5 }, spread = 25,
        acc = V(0, 0.8, 0) + (f.e.w or V()) * 0.3, drag = 0.3, size = nseq(0, 1.6, 0.3, 4.5, 1, 10), tr = nseq(0, 0.3, 0.6, 0.6, 1, 1),
        col = cseq(RGB(228, 224, 216), RGB(150, 150, 158)), rot = 15 })
    end
    -- 降落伞：一顶白伞 + 一根吊绳
    f.chute = part(Enum.PartType.Ball, V(5.2, 2, 5.2), CFrame.new(pos + V(0, 5.5, 0)), RGB(226, 226, 220), Enum.Material.Fabric, 0)
    f.cord = part(Enum.PartType.Block, V(0.06, 5, 0.06), CFrame.new(pos + V(0, 2.6, 0)), RGB(60, 60, 60), Enum.Material.SmoothPlastic, 0)
    -- 照亮自己周围（烟、伞）的小灯
    local pl = Instance.new("PointLight")
    pl.Range, pl.Brightness, pl.Color, pl.Shadows = 30, 2, WARM, false
    pl.Parent = core
    f.selfLight = pl
    -- 照地面的灯：在照明弹正下方离地 40 格（最远 60 格）
    local anchor = part(Enum.PartType.Block, V(0.2, 0.2, 0.2), CFrame.new(pos), RGB(0, 0, 0), Enum.Material.SmoothPlastic, 1)
    local gl = Instance.new("PointLight")
    gl.Range, gl.Brightness, gl.Color, gl.Shadows = 60, 4, WARM, false
    gl.Parent = anchor
    f.anchor, f.groundLight = anchor, gl
    -- 烧着的嘶嘶声
    if G.makeSound and d < 600 then
      f.hiss = G.makeSound({ id = WIND, vol = 2.2, s = { 1.6, 1.8 }, loop = { 0.5, 9.5 }, eq = { -16, 0, 4 } }, core, { rmin = 20, rmax = 260 })
    end
  end

  local function extinguish(f)
    if f.out then return end
    f.out = true
    for _, k in ipairs({ "halo", "sparks", "smoke" }) do if f[k] then f[k].Enabled = false end end
    if f.selfLight then f.selfLight.Enabled = false end
    if f.groundLight then f.groundLight.Enabled = false end
    if f.core then f.core.Transparency = 1 end
    if f.hiss then f.hiss:Stop() end
    if f.core then Debris:AddItem(f.core, 16) end   -- 烟柱的粒子还要飘一会儿
    if f.anchor then Debris:AddItem(f.anchor, 0.1) end
    if f.chute then
      if G.tween then
        G.tween(f.chute, 5, { Transparency = 1 })
        G.tween(f.cord, 5, { Transparency = 1 })
      end
      Debris:AddItem(f.chute, 5.2)
      Debris:AddItem(f.cord, 5.2)
    end
  end

  local function newIllum(e)
    if typeof(e.o) ~= "Vector3" or typeof(e.p) ~= "Vector3" or type(e.t) ~= "number" then return end
    e.fl, e.burn, e.fall = e.fl or 3, e.burn or 30, e.fall or 2.6
    local u = math.max(0, serverNow() - e.t)
    if u > e.fl + e.burn then return end   -- 进服前就烧完了
    local f = { e = e, ph = math.random() * 6.28, t0 = os.clock() - u }
    -- 上升段：一颗拖着短尾巴的亮点（发射点、炸开点都离镜头远的不画）
    local cp = camPos()
    if u < e.fl and math.min((e.o - cp).Magnitude, (e.p - cp).Magnitude) < 2500 then
      local sh = part(Enum.PartType.Ball, V(0.5, 0.5, 0.5), CFrame.new(e.o), RGB(255, 214, 160), Enum.Material.Neon, 0)
      local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
      a0.Position, a1.Position = V(0, 0.25, 0), V(0, -0.25, 0)
      a0.Parent, a1.Parent = sh, sh
      local tr = Instance.new("Trail")
      tr.Attachment0, tr.Attachment1 = a0, a1
      tr.Lifetime, tr.LightEmission, tr.FaceCamera = 0.35, 1, true
      tr.Color = cseq(RGB(255, 226, 180), RGB(255, 150, 80))
      tr.Transparency = nseq(0, 0.2, 1, 1)
      tr.Parent = sh
      f.shell = sh
      if (e.o - cp).Magnitude < 1800 then
        if e.by == "def" then
          if G.playSound then G.playSound("mortar", e.o) end
        elseif G.sfx then
          G.sfx({ { id = EXP, vol = 0.9, s = { 0.62, 0.7 }, reg = { 0, 1.4 }, eq = { 8, 0, -10 } } }, e.o, { delay = (e.o - cp).Magnitude / 960, rmin = 150, rmax = 6000 })
        end
      end
    end
    table.insert(flares, f)
  end

  local function stepFlares()
    if #flares == 0 then
      illumK = 0
      G.illum.pos = nil
      return
    end
    local t = os.clock()
    local cp = camPos()
    local k, nearest, nd = 0, nil, math.huge
    for i = #flares, 1, -1 do
      local f = flares[i]
      local e = f.e
      local pos, ph = flarePos(f, t)
      local b = t - f.t0 - e.fl
      if ph == "rise" then
        if f.shell then f.shell.CFrame = CFrame.new(pos) end
      else
        if f.shell then
          f.shell:Destroy()
          f.shell = nil
        end
        if not f.core and ph == "burn" then ignite(f, pos, b) end
        if not f.groundAt or t >= f.groundAt then
          f.ground = math.max(0, MapM.ground(pos.X, pos.Z))
          f.groundAt = t + 1 / 20
        end
        local gy = f.ground
        local alt = pos.Y - gy
        if f.core and not f.out and (ph == "out" or alt < 3) then extinguish(f) end
        if f.out then
          -- 已熄灭：伞还在掉（落到地上就停）
          if f.chute and f.chute.Parent and alt > 2 then
            f.chute.CFrame = CFrame.new(pos + V(0, 5.5, 0))
            f.cord.CFrame = CFrame.new(pos + V(0, 2.6, 0))
          end
        elseif f.core then
          local I = flareI(f, b, e.burn)
          f.core.CFrame = CFrame.new(pos)
          if f.chute then
            local tilt = CFrame.Angles(math.sin(b * 0.9 + f.ph) * 0.12, 0, math.cos(b * 0.7 + f.ph) * 0.12)
            f.chute.CFrame = CFrame.new(pos + V(0, 5.5, 0)) * tilt
            f.cord.CFrame = CFrame.new(pos + V(0, 2.6, 0)) * tilt
          end
          f.halo.Rate = 22 * math.max(0.2, I)
          f.selfLight.Brightness = 2.4 * I
          f.anchor.CFrame = CFrame.new(pos.X, gy + math.min(alt, 40), pos.Z)
          f.groundLight.Brightness = 4.5 * I
          local d = (pos - cp).Magnitude
          if d < nd then nearest, nd = f, d end
          -- 整片地亮起来：离照明弹 140 格内最亮，700 格外没有
          k += I * math.clamp(1 - (d - 140) / 560, 0, 1)
        end
        if b > e.burn + 6 then table.remove(flares, i) end
      end
    end
    -- 只有离镜头最近的那发投影子（点光源投影子很贵）
    for _, f in ipairs(flares) do
      if f.groundLight then
        local shadows = f == nearest and nd < 900 and not reducedMotion and (G.perfK or 1) >= 0.8
        if f.groundLight.Shadows ~= shadows then f.groundLight.Shadows = shadows end
      end
    end
    illumK = math.min(1.2, k)
    G.illum.pos = (nearest and nearest.core and nd < 1500) and nearest.core.Position or nil   -- 座舱盖上的划痕迎着它反光（Interior.lua）
  end

  G.illum = { k = 0, col = WARM }
  G.brightFlare = function() return G.illum.pos end   -- 离镜头最近、还在烧的照明弹在哪（没有就 nil）
  G.fxExtra = G.fxExtra or {}
  G.fxExtra.illum = newIllum

  ---------------------------------------------------------------- 夜空：低云
  -- Roblox 地形的云（Terrain.Clouds）：一层压得低的深灰蓝的云，月光照着边、遮住一半星星，开飞机能钻进去；机器跟不上（G.perfK 低）就关掉
  local clouds
  pcall(function()
    local T = workspace.Terrain
    clouds = T:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
    clouds.Cover, clouds.Density, clouds.Color = 0.6, 0.5, RGB(66, 72, 88)
    clouds.Parent = T
  end)
  G.nightClouds = clouds   -- 测试用

  ---------------------------------------------------------------- 积云（用户 11-24：「要能在任何位置都适合打坦克战、空战，包括云朵」）
  -- 地形的云是平平的一层；空战要一团一团的积云（能钻进去躲、穿出来）：按定死的种子在作战区上空摆几十团，每团十来个半透明的大球
  --   挤在一起（底下一块扁的云底、上面鼓起来），夜里是月光照着的灰蓝色、越往上越亮；不碰撞、不挡射线、不投影；客户端自己的、只摆一次
  local banks = Instance.new("Folder")
  banks.Name = "CloudBanks"
  banks.Parent = FXF
  G.cloudBanks = banks   -- 测试用
  local cloudParts = {}   -- { 零件, 上下位置 0 云底 ～ 1 云顶 }：昼夜更替跟着时间重新上色（stepCloudTint）
  -- 云跟着时间变色（用户 11-25「给沙漠地图做个昼夜更替」）：夜里月光照着的灰蓝、白天白、日出日落染一层橙粉；
  --   地形的那层云（clouds）也一样。亮度变了 0.02 以上才重新上色（几秒一次）
  local C_NLOW, C_NHIGH = RGB(70, 78, 94), RGB(122, 130, 146)
  local C_DLOW, C_DHIGH = RGB(198, 200, 206), RGB(248, 248, 246)
  local C_TW = RGB(250, 178, 140)
  local tintK = -1        -- 上次按哪个亮度上的色
  local tintLo, tintHi, tintI = nil, nil, 0   -- 正在重新上色（drainTint）：这一轮的云底色、云顶色，上到第几块了
  -- 现在该是什么颜色：亮度键、云底色、云顶色、昼夜（0 夜 ～ 1 昼）、日出日落的染色
  local function tintNow()
    local dk = G.dayK and G.dayK() or 0
    local c = G.clockNow and G.clockNow() or 2.3
    local alt = math.sin((c - 6) / 12 * math.pi)
    local tw = math.clamp(1 - math.abs(alt - 0.05) / 0.25, 0, 1) * 0.55
    return dk + tw * 3, C_NLOW:Lerp(C_DLOW, dk):Lerp(C_TW, tw), C_NHIGH:Lerp(C_DHIGH, dk):Lerp(C_TW, tw * 0.8), dk, tw
  end
  local fading, builtAt = nil, -99   -- fading：正在淡掉的那批球 { t0, list = { { 零件, 原来的透明度 } }, acc }；builtAt：这批是什么时候摆的
  local function dropFading()
    if not fading then return end
    for _, f in ipairs(fading.list) do f[1]:Destroy() end
    fading = nil
  end
  local function cloudBanks()
    -- 雪山上导入了体积云（SnowClouds.lua 开着，G.snowCloudsOn）：不再摆这几十团半透明的球——两套云叠着，
    --   五百多个透明大球一层层排序、填满屏幕是显卡最贵的（11-27 M3 丝滑）；没导入体积云照旧摆。
    --   已经摆了一会儿的（clouds.glb 晚到：SnowClouds 每 3 秒查一次、最多两分钟）1 秒淡掉再删，不一下子全没；刚摆的（换图那一下）直接删
    if G.snowCloudsOn then
      if #cloudParts > 0 then
        if os.clock() - builtAt > 2 then
          dropFading()
          local list = {}
          for _, it in ipairs(cloudParts) do if it[1].Parent then list[#list + 1] = { it[1], it[1].Transparency } end end
          fading = { t0 = os.clock(), list = list, acc = 0 }
        else
          dropFading()
          banks:ClearAllChildren()
        end
        table.clear(cloudParts)
      end
      tintLo = nil
      return
    end
    fading = nil
    banks:ClearAllChildren()
    table.clear(cloudParts)
    -- 摆的时候就按现在的钟点上色（原来先摆成夜里的灰蓝，要等下一次一秒一查才重新上色；正在分帧上色的那一轮也作废，不刷到新零件上）
    local key, LOW, HIGH, dk, tw = tintNow()
    tintK, tintLo = key, nil
    if clouds then clouds.Color = RGB(66, 72, 88):Lerp(RGB(244, 242, 238), dk):Lerp(C_TW, tw) end   -- 地形那层云同一个钟点（stepCloudTint 看到键没变就不再上）
    builtAt = os.clock()
    local rng = Random.new(91124)
    local span = (MapM.PLAY or 20000) * 0.9
    for _ = 1, 54 do
      local cx, cz = rng:NextNumber(-span, span), rng:NextNumber(-span, span)
      local cy = rng:NextNumber(1900, 3600)
      local size = rng:NextNumber(280, 720)
      local base = Instance.new("Part")
      base.Shape = Enum.PartType.Cylinder
      base.Size = Vector3.new(size * 0.22, size * 2.2, size * 2.2)
      base.CFrame = CFrame.new(cx, cy, cz) * CFrame.Angles(0, 0, math.pi / 2)
      base.Color, base.Transparency = LOW, 0.62
      table.insert(cloudParts, { base, 0 })
      for _, b in ipairs({ base }) do
        b.Anchored, b.CanCollide, b.CanQuery, b.CanTouch, b.CastShadow = true, false, false, false, false
        b.Material = Enum.Material.SmoothPlastic
        b.Parent = banks
      end
      for _ = 1, rng:NextInteger(7, 12) do
        local r = size * rng:NextNumber(0.32, 0.62)
        local up = rng:NextNumber(0, 1)
        local b = Instance.new("Part")
        b.Shape = Enum.PartType.Ball
        b.Size = Vector3.new(r * 2, r * 2, r * 2)
        b.CFrame = CFrame.new(cx + rng:NextNumber(-1, 1) * size * 0.9, cy + r * 0.35 + up * size * 0.32, cz + rng:NextNumber(-0.7, 0.7) * size * 0.9)
        b.Color = LOW:Lerp(HIGH, up)
        table.insert(cloudParts, { b, up })
        b.Transparency = rng:NextNumber(0.5, 0.68)
        b.Anchored, b.CanCollide, b.CanQuery, b.CanTouch, b.CastShadow = true, false, false, false, false
        b.Material = Enum.Material.SmoothPlastic
        b.Parent = banks
      end
    end
  end
  pcall(cloudBanks)
  if G.onMap then G.onMap(function() pcall(cloudBanks) end) end   -- 换地图（作战区大小变了）重摆
  G.cloudBanksRefresh = function() pcall(cloudBanks) end   -- SnowClouds 开 / 关时调
  -- 淡掉的那批球：一秒 20 次往透明走，1 秒后删（五百多块，每帧都写太多）
  local function stepFading(dt)
    local f = fading
    if not f then return end
    local u = (os.clock() - f.t0) / 1
    if u >= 1 then
      dropFading()
      return
    end
    f.acc += dt or 1 / 60
    if f.acc < 0.05 then return end
    f.acc = 0
    for _, it in ipairs(f.list) do it[1].Transparency = it[2] + (1 - it[2]) * u end
  end
  G.cloudBanksFading = function() return fading ~= nil end   -- 测试用
  G.cloudTintBusy = function() return tintLo ~= nil end       -- 测试用：还在分帧上色
  local function stepCloudTint()
    local key, lo, hi, dk, tw = tintNow()
    if math.abs(key - tintK) < 0.02 then return end
    tintK = key
    tintLo, tintHi, tintI = lo, hi, 0   -- 五百多块分几帧上色（drainTint），不在一帧里全改（11-27：那一帧一顿）
    if clouds then clouds.Color = RGB(66, 72, 88):Lerp(RGB(244, 242, 238), dk):Lerp(C_TW, tw) end
  end
  local TINT_N = 120   -- 一帧最多上色几块
  local function drainTint()
    if not tintLo then return end
    local n = #cloudParts
    local stop = math.min(n, tintI + TINT_N)
    for i = tintI + 1, stop do
      local it = cloudParts[i]
      if it[1].Parent then it[1].Color = tintLo:Lerp(tintHi, it[2]) end
    end
    tintI = stop
    if tintI >= n then tintLo = nil end
  end

  ---------------------------------------------------------------- 探照灯
  -- 守方几处要地（指挥部、机场、港口、营地）各两盏对空探照灯：灰绿色的灯筒架在矮杆上，一道淡蓝白的光柱斜着照上天，慢慢来回扫
  --   （二战登陆夜战那种画面）。只是画面：每个客户端自己画，扫的角度按服务器时间算（大家看到的差不多同步）；离镜头 9000 格外的不更新、不画
  local LIGHTS = {}
  G.searchlights = LIGHTS   -- 测试用
  local slFolder = Instance.new("Folder")
  slFolder.Name = "Searchlights"
  slFolder.Parent = FXF
  local function addLight(x, z, ph, az0)
    local gy = math.max(0, MapM.ground(x, z))
    local base = V(x, gy, z)
    local pole = part(Enum.PartType.Block, V(0.8, 7, 0.8), CFrame.new(base + V(0, 3.5, 0)), RGB(48, 52, 46), Enum.Material.Metal, 0)
    pole.Parent = slFolder
    local head = part(Enum.PartType.Cylinder, V(3.2, 3.6, 3.6), CFrame.new(base + V(0, 8.5, 0)), RGB(66, 74, 60), Enum.Material.Metal, 0)
    head.Parent = slFolder
    local lens = part(Enum.PartType.Cylinder, V(0.2, 3.1, 3.1), CFrame.new(base + V(0, 8.5, 0)), RGB(230, 238, 255), Enum.Material.Neon, 0)
    lens.Parent = slFolder
    local a0 = Instance.new("Attachment")
    a0.Parent = lens
    local beams = {}
    for _, spec in ipairs({ { len = 1100, w0 = 3, w1 = 60, a = 0.84 }, { len = 650, w0 = 1.6, w1 = 18, a = 0.7 } }) do
      local a1 = Instance.new("Attachment")
      a1.Position = V(spec.len, 0, 0)   -- 圆柱的轴是 X：灯头朝 +X 照（下面摆灯头时把 +X 转到光的方向）
      a1.Parent = lens
      local b = Instance.new("Beam")
      b.Attachment0, b.Attachment1 = a0, a1
      b.Width0, b.Width1 = spec.w0, spec.w1
      b.FaceCamera, b.LightEmission, b.LightInfluence, b.Segments = true, 1, 0, 1
      b.Color = ColorSequence.new(RGB(226, 234, 255), RGB(190, 206, 240))
      b.Transparency = nseq(0, spec.a, 0.12, spec.a + 0.03, 1, 1)
      b.Parent = lens
      table.insert(beams, b)
    end
    table.insert(LIGHTS, { base = base, head = head, lens = lens, beams = beams, ph = ph, az0 = az0 })
  end
  pcall(function()
    local sites = {}
    if MapM.COMMAND then table.insert(sites, { MapM.COMMAND.x, MapM.COMMAND.z }) end
    if MapM.AIRFIELD then table.insert(sites, { MapM.AIRFIELD.x, MapM.AIRFIELD.z - 160 }) end
    if MapM.PORT then table.insert(sites, { MapM.PORT.x, MapM.PORT.z - 60 }) end
    if MapM.CAMP then table.insert(sites, { MapM.CAMP.x, MapM.CAMP.z }) end
    for i, s in ipairs(sites) do
      -- 朝海（南边，攻方来的方向）照：两盏一左一右、相位错开
      addLight(s[1] - 55, s[2] + 30, i * 1.7, math.rad(160))
      addLight(s[1] + 55, s[2] + 30, i * 1.7 + 2.4, math.rad(200))
    end
  end)

  local function stepLights()
    if #LIGHTS == 0 then return end
    local t = reducedMotion and 0 or serverNow()
    local cp = camPos()
    for _, L in ipairs(LIGHTS) do
      local near = (L.base - cp).Magnitude < 9000 and not (G.dayK and G.dayK() > 0.45)   -- 白天不开（昼夜更替，用户 11-25）
      if L.near ~= near then
        L.near = near
        for _, b in ipairs(L.beams) do b.Enabled = near end
      end
      if near and L.time ~= t then
        L.time = t
        -- 方位角在朝海方向左右各 50° 里慢慢来回，仰角 35°～72°
        local az = L.az0 + math.rad(50) * math.sin(t * 0.11 + L.ph)
        local el = math.rad(53) + math.rad(19) * math.sin(t * 0.17 + L.ph * 1.3)
        local dir = V(math.sin(az) * math.cos(el), math.sin(el), math.cos(az) * math.cos(el))
        local p = L.base + V(0, 8.5, 0)
        local cf = CFrame.lookAt(p, p + dir) * CFrame.Angles(0, math.pi / 2, 0)   -- lookAt 的 −Z 朝 dir；绕 Y 转 90° 以后 +X 朝 dir（圆柱的轴）
        L.head.CFrame = cf
        L.lens.CFrame = cf * CFrame.new(1.65, 0, 0)
      end
    end
  end

  ---------------------------------------------------------------- 远处的炮声
  -- 战地那种「远处还在打」的底噪：每隔 7～16 秒，镜头外三四千格（作战区外、海那边）随机一个方向一声低沉的闷响（放慢、只留低音、长回声），
  --   有时候连着两三声（一轮齐射）。只有声音：不画东西（画了会让人以为那边有人）
  local rumbleAt = os.clock() + 8
  local rumbles = 0
  G.rumbleCount = function() return rumbles end   -- 测试用
  local function stepRumble()
    local t = os.clock()
    if t < rumbleAt then return end
    rumbleAt = t + 7 + math.random() * 9
    if not G.sfx then return end
    local a = math.random() * 2 * math.pi
    local p = camPos() + V(math.cos(a), 0, math.sin(a)) * (3200 + math.random() * 1800)
    local n = (math.random() < 0.35) and math.random(2, 3) or 1
    for i = 1, n do
      G.sfx({ { id = EXP, vol = 0.55, s = { 0.4, 0.48 }, reg = { 0, 2.2 }, eq = { 10, -6, -26 }, echo = { 0.42, 0.45, -8 }, delay = (i - 1) * (0.5 + math.random() * 0.6) } },
        p, { rmin = 2500, rmax = 9000 })
    end
    rumbles += 1
  end

  ---------------------------------------------------------------- 房子着火、塌（服务器 Battle.lua）
  -- 着火：房子模型的属性 Burning（被炸掉一半血）——屋顶那一层冒火、往上冒黑烟、橙色的火光一闪一闪（夜里很远就看得到）；
  --   效果挂在房子模型底下（本地的）：房子塌了被服务器挪走，效果跟着没。每秒查一次属性；房子列表 15 秒重扫一次（新一局复原的房子是新的副本）
  -- 塌：特效 collapse——扬起一大团尘土（往外冲的一圈 + 往上翻的一大团）、十几块碎块真的飞出去落地、轰隆一声（按距离晚到）、近处镜头震
  -- 废墟（Ruins 文件夹里的 Ruin_ 模型）：冒一阵烟、几点余火（90 秒后烟停）
  local FIRE = "rbxasset://textures/particles/fire_main.dds"
  local THUD = "rbxasset://sounds/action_jump_land.mp3"
  local burning = {}   -- [模型] = { h, light, ph }
  local ruinFx = {}    -- [模型] = true
  local collapses = 0
  G.collapseCount = function() return collapses end   -- 测试用

  local function decorateFire(m)
    local base, size = m:GetAttribute("BldBase"), m:GetAttribute("BldSize")
    if typeof(base) ~= "CFrame" or typeof(size) ~= "Vector3" then return end
    local h = part(Enum.PartType.Block, V(math.min(size.X, 14) * 0.6, 1, math.min(size.Z, 14) * 0.6), base * CFrame.new(0, size.Y * 0.7, 0), RGB(0, 0, 0), nil, 1)
    h.Name = "BldFire"
    h.Parent = m
    emitter(h, { tex = FIRE, rate = 16, life = { 0.6, 1.2 }, spd = { 3, 7 }, spread = 25, acc = V(0, 8, 0), size = nseq(0, 4.5, 1, 1),
      tr = nseq(0, 0.15, 1, 1), col = cseq(RGB(255, 204, 128), RGB(255, 92, 40)), le = 0.9 })
    emitter(h, { tex = TX.smoke, rate = 4, life = { 7, 11 }, spd = { 4, 8 }, spread = 15, acc = V(1.5, 4, 0.8), size = nseq(0, 4, 1, 18),
      tr = nseq(0, 0.35, 1, 1), col = cseq(RGB(38, 34, 32), RGB(96, 92, 88)), rot = 10 })
    local pl = Instance.new("PointLight")
    pl.Range, pl.Brightness, pl.Color, pl.Shadows = 44, 3, RGB(255, 150, 80), false
    pl.Parent = h
    burning[m] = { h = h, light = pl, ph = math.random() * 6.28 }
  end

  local function decorateRuin(m)
    ruinFx[m] = true
    local ok, cf, size = pcall(function() return m:GetBoundingBox() end)
    if not ok or typeof(cf) ~= "CFrame" then
      local p0 = m:FindFirstChildWhichIsA("BasePart")
      if not p0 then return end
      cf, size = p0.CFrame, V(12, 4, 12)
    end
    local h = part(Enum.PartType.Block, V(math.max(4, size.X * 0.5), 1, math.max(4, size.Z * 0.5)), CFrame.new(cf.Position), RGB(0, 0, 0), nil, 1)
    h.Name = "RuinSmoke"
    h.Parent = m
    local sm = emitter(h, { tex = TX.smoke, rate = 3, life = { 8, 13 }, spd = { 2, 5 }, spread = 25, acc = V(1.2, 2.5, 0.6), size = nseq(0, 5, 1, 16),
      tr = nseq(0, 0.45, 1, 1), col = cseq(RGB(70, 66, 62), RGB(120, 116, 110)), rot = 8 })
    local em = emitter(h, { tex = TX.glow, rate = 4, life = { 0.8, 1.6 }, spd = { 1, 4 }, spread = 40, acc = V(0, 3, 0), size = nseq(0, 0.35, 1, 0),
      tr = nseq(0, 0, 1, 0.5), col = cseq(RGB(255, 190, 110), RGB(255, 110, 50)), le = 1 })
    task.delay(90, function() sm.Enabled = false em.Enabled = false end)
  end

  -- 房子（模型属性 Bld）着火（属性 Burning）挂火焰、废墟（workspace.Ruins）冒烟。
  --   用户 11-25「游戏一阵一阵卡 然后枪 坦克 飞机一阵一阵抽搐」：原来每 15 秒把 Map.Scenery 整个 GetDescendants 一遍找房子——沙海的景物有四五万个实例，
  --   每 15 秒卡一下（tools/mock/hitch.lua 按行采样：尖峰那几帧三成多的时间在这里，平常的帧里一次都没有）；每秒还把每栋房子的属性读一遍。
  --   现在：开服后分帧扫一遍（只走文件夹和模型、不进零件，每帧 1500 个），以后靠 DescendantAdded 接新来的（开了 streaming 流进来的也是）；
  --   每栋房子盯着自己的 Burning 属性，变了才挂 / 撤火焰；废墟靠 ChildAdded
  local watched = setmetatable({}, { __mode = "k" })
  local function syncFire(m)
    local on = m.Parent ~= nil and m:GetAttribute("Burning") == true
    if on and not burning[m] then
      decorateFire(m)
    elseif not on and burning[m] then
      if burning[m].h.Parent then burning[m].h:Destroy() end
      burning[m] = nil
    end
  end
  local function watchBld(m)
    if watched[m] or not m:IsA("Model") or not m:GetAttribute("Bld") then return end
    watched[m] = true
    m:GetAttributeChangedSignal("Burning"):Connect(function() pcall(syncFire, m) end)
    if m:GetAttribute("Burning") == true then syncFire(m) end
  end
  G.bldWatched = function() local n = 0 for _ in pairs(watched) do n += 1 end return n end   -- 测试用
  local sceneryHooked, ruinsHooked = false, false
  local function hookScenery(scenery)
    sceneryHooked = true
    scenery.DescendantAdded:Connect(function(d)
      if d:IsA("Model") then task.defer(function() if d.Parent then pcall(watchBld, d) end end) end   -- 等属性到了再看
    end)
    task.spawn(function()
      local stack, n = { scenery }, 0
      while #stack > 0 do
        local node = table.remove(stack)
        if node.Parent then
          for _, c in ipairs(node:GetChildren()) do
            if c:IsA("Model") then
              if c:GetAttribute("Bld") then watchBld(c) else table.insert(stack, c) end
            elseif c:IsA("Folder") then
              table.insert(stack, c)
            end
            n += 1
            if n % 1500 == 0 then task.wait() end
          end
        end
      end
    end)
  end
  local function hookRuins(rf)
    ruinsHooked = true
    rf.ChildAdded:Connect(function(m)
      task.defer(function() if m.Parent and m:IsA("Model") and not ruinFx[m] then pcall(decorateRuin, m) end end)
    end)
    for _, m in ipairs(rf:GetChildren()) do
      if m:IsA("Model") and not ruinFx[m] then decorateRuin(m) end
    end
  end
  local function stepBlds()
    if not sceneryHooked then
      local map = workspace:FindFirstChild("Map")
      local scenery = map and map:FindFirstChild("Scenery")
      if scenery then hookScenery(scenery) end
    end
    if not ruinsHooked then
      local rf = workspace:FindFirstChild("Ruins")
      if rf then hookRuins(rf) end
    end
    for m in pairs(burning) do   -- 拆掉 / 流出去的房子
      if not m.Parent then
        if burning[m].h.Parent then burning[m].h:Destroy() end
        burning[m] = nil
      end
    end
    for m in pairs(ruinFx) do
      if not m.Parent then ruinFx[m] = nil end
    end
  end

  local function stepBurn()
    local cp = camPos()
    local t = os.clock()
    for _, b in pairs(burning) do
      if b.h.Parent and (b.h.CFrame.Position - cp).Magnitude < 1500 then
        local brightness = reducedMotion and 2.6 or (2.6 + 0.32 * math.sin(t * 3.1 + b.ph))
        if math.abs(b.light.Brightness - brightness) > 0.025 then b.light.Brightness = brightness end
      end
    end
  end

  G.fxExtra.collapse = function(e)
    if typeof(e.p) ~= "Vector3" or typeof(e.s) ~= "Vector3" then return end
    collapses += 1
    local p, s = e.p, e.s
    local gy = (typeof(e.cf) == "CFrame") and e.cf.Position.Y or (p.Y - s.Y / 2)
    local cp = camPos()
    local d = (p - cp).Magnitude
    if G.sfx and d < 5000 then
      G.sfx({ { id = EXP, vol = 1.3, s = { 0.36, 0.42 }, reg = { 0, 2.4 }, eq = { 10, -2, -16 }, echo = { 0.3, 0.35, -8 } },
        { id = THUD, vol = 1.2, s = { 0.32, 0.36 }, eq = { 8, 0, -12 }, delay = 0.25 },
        { id = THUD, vol = 0.9, s = { 0.4, 0.45 }, eq = { 6, 0, -10 }, delay = 0.6 } },
        p, { delay = d / 960, rmin = 80, rmax = 4500, must = true })
    end
    if d < 400 and G.shake and not reducedMotion then G.shake(0.55 * (1 - d / 400)) end
    if d > 4000 then return end
    local w = math.max(s.X, s.Z)
    local h = part(Enum.PartType.Block, V(1, 1, 1), CFrame.new(p.X, gy + 1.5, p.Z), RGB(0, 0, 0), nil, 1)
    -- 往外冲的一圈尘浪：零件绕竖轴转着一颗一颗往前发
    local ring = emitter(h, { tex = TX.smoke, life = { 2.5, 4.5 }, spd = { w * 0.6, w * 1.2 }, spread = 8, drag = 1.6, dir = Enum.NormalId.Front,
      acc = V(0, 1.5, 0), size = nseq(0, w * 0.18, 1, w * 0.55), tr = nseq(0, 0.25, 1, 1), col = cseq(RGB(164, 152, 134), RGB(140, 132, 120)), rot = 20 })
    local base = h.CFrame
    for i = 1, 18 do
      h.CFrame = base * CFrame.Angles(0, (i + math.random() * 0.6) * 2 * math.pi / 18, 0)
      ring:Emit(1)
    end
    h.CFrame = base
    -- 往上翻的一大团
    local col = emitter(h, { tex = TX.smoke, life = { 5, 9 }, spd = { w * 0.25, w * 0.7 }, spread = 50, drag = 1.2, acc = V(1, 3.5, 0.5),
      size = nseq(0, w * 0.3, 0.4, w * 0.75, 1, w * 1.1), tr = nseq(0, 0.12, 0.6, 0.45, 1, 1), col = cseq(RGB(150, 140, 124), RGB(104, 98, 90)), rot = 12 })
    col:Emit(math.floor(10 + w / 3))
    Debris:AddItem(h, 10)
    -- 碎块：真的零件往外飞、落地弹几下（本地物理）
    local n = math.clamp(math.floor(w / 2), 8, 18)
    if (G.perfK or 1) < 0.8 then n = math.floor(n / 2) end
    for i = 1, n do
      local c = Instance.new("Part")
      c.Size = V(0.6 + math.random() * 1.8, 0.5 + math.random() * 1.2, 0.6 + math.random() * 1.8)
      c.Color = (i % 3 == 0) and RGB(64, 58, 52) or RGB(108, 100, 90)
      c.Material = Enum.Material.Concrete
      c.CFrame = CFrame.new(p + V((math.random() - 0.5) * s.X * 0.6, (math.random() - 0.2) * s.Y * 0.4, (math.random() - 0.5) * s.Z * 0.6))
      c.Anchored, c.CanCollide, c.CanQuery, c.CanTouch, c.CastShadow = false, true, false, false, true
      c.Parent = FXF
      local dir = V(math.random() - 0.5, 0, math.random() - 0.5)
      dir = dir.Magnitude > 0.05 and dir.Unit or V(1, 0, 0)
      pcall(function()
        c.AssemblyLinearVelocity = dir * (8 + math.random() * 18) + V(0, 10 + math.random() * 22, 0)
        c.AssemblyAngularVelocity = V(math.random() - 0.5, math.random() - 0.5, math.random() - 0.5) * 12
      end)
      Debris:AddItem(c, 4 + math.random())
    end
  end

  ---------------------------------------------------------------- 暴风雨（服务器 Battle.lua 给强度：workspace 的属性 StormK）
  -- 雨：镜头上方一块看不见的板子往下撒细长的雨丝（顺着速度方向拉长；受光：照明弹、火光、探照灯附近的雨亮晶晶，黑处几乎看不见）；
  --   开飞机飞到云上面（700 格以上）不下。闪电保留远处的短光与雷声，减少动态效果时只保留雷声；
  --   云变厚变黑、海浪变大、风把草吹得乱晃、雾变近（DayNight.lua 读 G.weather.k）；雨声的「沙——」跟着强度
  local stormK = 0
  local rainPart, rainPE, rainSnd
  local rainActive, rainSoundOn = false, false
  local weatherAcc, lastLook = 0, 0
  local nextBolt = 0
  local bolts = 0
  G.boltCount = function() return bolts end   -- 测试用
  G.weather = { k = 0 }
  local stormCloud = RGB(40, 44, 54)
  local T0 = { cover = clouds and clouds.Cover or 0.6, dens = clouds and clouds.Density or 0.5, color = clouds and clouds.Color or RGB(66, 72, 88) }
  local terr = workspace:FindFirstChildOfClass("Terrain")
  local waterSize, waterSpeed, wind

  local function ensureRain()
    if rainPart then return end
    rainPart = part(Enum.PartType.Block, V(86, 1, 86), CFrame.new(0, -500, 0), RGB(0, 0, 0), nil, 1)
    rainPart.Name = "Rain"
    rainPE = emitter(rainPart, { tex = "rbxasset://textures/particles/SquareParticle.png", rate = 0, life = { 0.45, 0.6 }, spd = { 140, 175 }, spread = 6,
      dir = Enum.NormalId.Bottom, size = nseq(0, 0.07, 1, 0.07), tr = nseq(0, 0.45, 1, 0.55), col = cseq(RGB(206, 214, 228), RGB(190, 200, 216)), rot = 0 })
    rainPE.LightEmission, rainPE.LightInfluence = 0.15, 0.85
    rainPE.RotSpeed = NumberRange.new(0, 0)
    rainPE.Rotation = NumberRange.new(0, 0)
    pcall(function() rainPE.Orientation = Enum.ParticleOrientation.VelocityParallel end)
    pcall(function() rainPE.Squash = NumberSequence.new(3) end)   -- 拉成细长的雨丝
  end

  local function drawBolt(x, gy, z)
    local y = math.max(800, gy + 140)
    local pts = { V(x, y, z) }
    while y > gy + 1 do
      y = math.max(gy, y - (60 + math.random() * 70))
      local last = pts[#pts]
      table.insert(pts, V(last.X + (math.random() - 0.5) * 70, y, last.Z + (math.random() - 0.5) * 70))
    end
    local function seg(p0, p1, wdt)
      local L = (p1 - p0).Magnitude
      local s = part(Enum.PartType.Block, V(wdt, wdt, L), CFrame.lookAt((p0 + p1) / 2, p1), RGB(190, 207, 235), Enum.Material.Neon, 0.25)
      if G.tween then G.tween(s, 0.28, { Transparency = 1 }) end
      Debris:AddItem(s, 0.3)
    end
    for i = 1, #pts - 1 do seg(pts[i], pts[i + 1], 1.6) end
    local k0 = math.random(2, math.max(2, #pts - 2))   -- 分叉
    local bp = pts[k0]
    for i = 1, 3 do
      local nb = bp + V((math.random() - 0.5) * 120, -(50 + math.random() * 60), (math.random() - 0.5) * 120)
      seg(bp, nb, 0.9)
      bp = nb
    end
  end

  local function bolt(cp)
    local a = math.random() * 2 * math.pi
    local dist = 1200 + math.random() * 3800
    local x, z = cp.X + math.cos(a) * dist, cp.Z + math.sin(a) * dist
    local gy = math.max(0, MapM.ground(x, z))
    if not reducedMotion then drawBolt(x, gy, z) end
    local d = (V(x, gy, z) - cp).Magnitude
    if G.sfx then
      G.sfx({ { id = EXP, vol = 1.5, s = { 0.3, 0.36 }, reg = { 0, 2.5 }, eq = { 8, -2, -18 }, echo = { 0.5, 0.5, -6 } },
        { id = EXP, vol = 0.9, s = { 0.25, 0.28 }, reg = { 0, 2.5 }, eq = { 10, -4, -24 }, delay = 0.4 } },
        V(x, gy + 50, z), { delay = d / 960, rmin = 4000, rmax = 12000, must = true })
    end
    bolts += 1
  end

  local function stepRain(k, cp, look)
    if k > 0.01 then ensureRain() end
    if not rainPE then return end
    local active = k > 0.01 and cp.Y <= 700
    if active then
      local target = cp + V(look.X * 20, 38, look.Z * 20)
      if (rainPart.CFrame.Position - target).Magnitude >= 0.5 then rainPart.CFrame = CFrame.new(target) end
    elseif rainActive then
      pcall(function() rainPE:Clear() end)
    end
    rainActive = active
    local budget = G.mobile and 100 or 400
    if reducedMotion then budget = G.mobile and 68 or 120 end
    local rate = active and math.floor(budget * k * math.clamp(G.perfK or 1, 0.4, 1)) or 0
    if rainPE.Rate ~= rate then rainPE.Rate = rate end

    if active then
      if not rainSnd and G.makeSound then
        rainSnd = G.makeSound({ id = WIND, vol = 0.01, s = { 1.25, 1.3 }, loop = { 0.5, 9.5 }, eq = { -24, -4, 5 } }, game:GetService("SoundService"), {})
        rainSoundOn = rainSnd ~= nil
      end
      if rainSnd then
        local volume = k * 1.4
        if math.abs(rainSnd.Volume - volume) >= 0.015 then rainSnd.Volume = volume end
        if not rainSoundOn then rainSnd:Play() rainSoundOn = true end
      end
    elseif rainSoundOn then
      rainSnd:Stop()
      rainSoundOn = false
    end
  end

  local function setWeatherLook(k)
    -- 风的基数：DayNight 按图 / 区块设的那个（G.windBase）。换图、在训练场和战场之间瞬移时它会变，跟着重新取——
    --   原来只在暴风雨开始那一下记一次 GlobalWind：暴风雨里瞬移到别处，DayNight 写的新风会被旧基数插出来的值盖掉，雨停了还回到旧地方的风
    local base = G.windBase
    if base ~= nil and base ~= wind then
      wind = base
      if lastLook > 0 then pcall(function() workspace.GlobalWind = wind:Lerp(V(20, 0, 10), lastLook) end) end
    end
    if k == lastLook or (k > 0 and math.abs(k - lastLook) < 0.012) then return end
    if lastLook == 0 then
      if terr then waterSize, waterSpeed = terr.WaterWaveSize, terr.WaterWaveSpeed end
      if base == nil then pcall(function() wind = workspace.GlobalWind end) end   -- 没有 DayNight 给的基数（LightLooks 没换进来）：照旧记暴风雨开始时的
    end
    lastLook = k
    if clouds then
      clouds.Cover = T0.cover + (0.9 - T0.cover) * k
      clouds.Density = T0.dens + (0.82 - T0.dens) * k
      clouds.Color = T0.color:Lerp(stormCloud, k)
    end
    if terr then
      terr.WaterWaveSize = waterSize + (0.55 - waterSize) * k
      terr.WaterWaveSpeed = waterSpeed + (18 - waterSpeed) * k
    end
    if wind then pcall(function() workspace.GlobalWind = wind:Lerp(V(20, 0, 10), k) end) end
  end

  local function stepStorm(dt)
    local target = workspace:GetAttribute("StormK")
    target = type(target) == "number" and math.clamp(target, 0, 1) or 0
    stormK += (target - stormK) * (1 - math.exp(-dt * 0.8))
    if math.abs(target - stormK) < 0.005 then stormK = target end
    G.weather.k = stormK
    local cam = workspace.CurrentCamera
    if cam and (stormK > 0 or rainActive) then
      local cf = cam.CFrame
      stepRain(stormK, cf.Position, cf.LookVector)
      if stormK > 0.4 and os.clock() >= nextBolt then
        nextBolt = os.clock() + (5 + math.random() * 9) / stormK
        bolt(cf.Position)
      end
    elseif rainActive then
      stepRain(0, V(), V())
    end
    weatherAcc += dt
    if weatherAcc >= 0.12 then
      weatherAcc %= 0.12
      setWeatherLook(stormK)
    end
  end

  ---------------------------------------------------------------- 阵亡镜头（服务器 Battle.lua 的 G.killcam 发来 killcam）
  -- 阵亡后短暂转向事件来源。减少动态效果、重新部署、主菜单和镜头切换均优先接管。
  local player = Players.LocalPlayer
  local kc = nil
  local kcN = 0
  G.killcamCount = function() return kcN end   -- 测试用
  G.killcamOn = function() return kc ~= nil end
  local function smooth(x) x = math.clamp(x, 0, 1) return x * x * (3 - 2 * x) end

  local function endKillcam()
    if not kc then return end
    local shot = kc
    kc = nil
    pcall(function() RunService:UnbindFromRenderStep("Killcam") end)
    if workspace.CurrentCamera == shot.cam then shot.cam.FieldOfView = shot.fov0 end
    for _, o in ipairs(shot.objs) do if o.Parent then o:Destroy() end end
  end
  G.killcamStop = endKillcam   -- 阵亡效果（DeathFx.lua）开始时先停掉

  local function stepKillcam()
    if not kc then return end
    local u = os.clock() - kc.t0
    local cam = workspace.CurrentCamera
    local character = player.Character
    local round = G.S and G.S.round
    if u > 3.2 or reducedMotion or cam ~= kc.cam or (character and character ~= kc.character)
      or (kc.round and round and kc.round ~= round) or (G.menuShown and G.menuShown()) then
      endKillcam()
      return
    end
    local angle = smooth(u / 0.85)
    cam.CFrame = kc.fromView:Lerp(kc.focusView, angle)
    cam.FieldOfView = kc.fov0 + (kc.fovZ - kc.fov0) * smooth((u - 0.45) / 1.1)
  end

  local function startKillcam(e)
    if reducedMotion or (G.menuShown and G.menuShown()) or type(e) ~= "table" or typeof(e.p) ~= "Vector3" then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local from = (typeof(e.from) == "Vector3") and e.from or cam.CFrame.Position
    local d = (e.p - from).Magnitude
    if d < 3 or d > 2500 then return end
    endKillcam()
    kcN += 1
    -- 视野收到凶手周围约 14 格（远的拉得多），最窄 8°
    local fov = cam.FieldOfView
    local fovZ = math.clamp(math.deg(2 * math.atan(14 / d)), math.min(8, fov), fov)
    local eye = from + V(0, 0.4, 0)
    kc = { t0 = os.clock(), cam = cam, character = player.Character, round = G.S and G.S.round,
      fromView = CFrame.new(eye) * cam.CFrame.Rotation, focusView = CFrame.lookAt(eye, e.p),
      fov0 = fov, fovZ = fovZ, objs = {} }
    -- 凶手头顶的标记
    local anchor = part(Enum.PartType.Block, V(0.2, 0.2, 0.2), CFrame.new(e.p + V(0, 4.5, 0)), RGB(0, 0, 0), nil, 1)
    anchor.Name = "KillcamTag"
    table.insert(kc.objs, anchor)
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(240, 64)
    bb.AlwaysOnTop = true
    bb.LightInfluence = 0
    bb.Adornee = anchor
    bb.Parent = anchor
    local mark = Instance.new("Frame")
    mark.Size = UDim2.fromOffset(16, 16)
    mark.AnchorPoint = Vector2.new(0.5, 0.5)
    mark.Position = UDim2.new(0.5, 0, 1, -10)
    mark.Rotation = 45
    mark.BackgroundColor3 = RGB(230, 52, 46)
    mark.BorderSizePixel = 0
    mark.Parent = bb
    local lab = Instance.new("TextLabel")
    lab.Size = UDim2.new(1, 0, 0, 36)
    lab.BackgroundTransparency = 1
    lab.Font = Enum.Font.BuilderSansMedium
    lab.TextSize = 18
    lab.TextColor3 = RGB(255, 236, 232)
    lab.TextStrokeTransparency = 0.4
    lab.Text = string.format("%s  ·  %d m", tostring(e.name or "?"), math.floor(d / 2.8 + 0.5))
    lab.Parent = bb
    -- 真人：一圈红色描边
    if type(e.uid) == "number" then
      local pl = Players:GetPlayerByUserId(e.uid)
      local ch = pl and pl.Character
      if ch then
        local hl = Instance.new("Highlight")
        hl.FillColor, hl.OutlineColor = RGB(230, 52, 46), RGB(255, 90, 80)
        hl.FillTransparency, hl.OutlineTransparency = 0.8, 0
        hl.Adornee = ch
        hl.Parent = ch
        table.insert(kc.objs, hl)
      end
    end
    -- 去色 + 景深（对准凶手）
    local cc = Instance.new("ColorCorrectionEffect")
    cc.Name = "KillcamGrade"
    cc.Saturation, cc.Contrast, cc.TintColor = -0.55, 0.12, RGB(255, 228, 222)
    cc.Parent = Lighting
    table.insert(kc.objs, cc)
    pcall(function()
      local dof = Instance.new("DepthOfFieldEffect")
      dof.Name = "KillcamFocus"
      dof.FocusDistance, dof.InFocusRadius, dof.FarIntensity, dof.NearIntensity = d, math.max(8, d * 0.15), 0.55, 0.75
      dof.Parent = Lighting
      table.insert(kc.objs, dof)
    end)
    RunService:BindToRenderStep("Killcam", Enum.RenderPriority.Camera.Value + 20, function()
      local ok, err = pcall(stepKillcam)
      if not ok then
        endKillcam()
        if G.showError then G.showError("阵亡镜头：" .. tostring(err)) end
      end
    end)
  end
  local prevMsg = G.onMsg
  G.onMsg = function(kind, key, ...)
    if kind == "killcam" then
      local ok, err = pcall(startKillcam, key)
      if not ok then
        endKillcam()
        if G.showError then G.showError("阵亡镜头：" .. tostring(err)) end
      end
      return
    end
    if prevMsg then return prevMsg(kind, key, ...) end
  end

  local acc, bAcc = 0, 0
  G.frameConn("Warfx", function(dt)
    local okS, errS = pcall(stepStorm, dt or 1 / 60)
    if not okS and G.showError then G.showError("暴风雨：" .. tostring(errS)) end
    local ok, err = pcall(stepFlares)
    if not ok and G.showError then G.showError("照明弹：" .. tostring(err)) end
    G.illum.k = illumK
    acc += dt or 1 / 60
    if acc >= 1 / 30 then   -- 探照灯、远处的炮声：一秒 30 次就够
      acc = 0
      local ok2, err2 = pcall(function()
        stepLights()
        stepRumble()
        stepBurn()
        if clouds then
          local enabled = (G.perfK or 1) >= 0.7
          if clouds.Enabled ~= enabled then clouds.Enabled = enabled end
        end
      end)
      if not ok2 and G.showError then G.showError("战场氛围：" .. tostring(err2)) end
    end
    if tintLo then pcall(drainTint) end
    if fading then pcall(stepFading, dt) end
    bAcc += dt or 1 / 60
    if bAcc >= 1 then   -- 房子着火、废墟、云的颜色：一秒查一次
      bAcc = 0
      pcall(stepCloudTint)
      local ok3, err3 = pcall(stepBlds)
      if not ok3 and G.showError then G.showError("房子：" .. tostring(err3)) end
    end
  end)
end

return Warfx
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="281">
          <Properties>
            <string name="Name">Workshop</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——整备（Workshop）外壳：在机库里给选中的那一辆配挂载 / 弹药、改装、乘员、涂装、看资料
--   用户 11-27：「整个给载具配置武器的系统 做的很粗糙 我需要非常艺术经验的效果 参考战雷」——同类写实军事游戏那种精致、克制、写实的质感，
--   用我们自己的界面美术（docs/style.md、Theme.lua；零件在 WsKit.lua）。舞台就是机库现成的 3D 厂房 / 停机坪（HangarStage），不另开视口；
--   界面和机库同一块 1280 × 720 缩放的画布（TechUI 的 Root）：
--   · 0～92：机库顶栏照旧（「加入战斗」仍是这一屏唯一的主按钮；顶栏上和页签重复的扳手、弹药、资料键整备时收起：TechUI G.hangarWsMode）；
--     「这一局」那块、国旗、乘员框、选中车的资料、阵容卡、科技树把手也收起
--   · 抬头 80～120：左边「‹ 机库」（不画框：灰字、悬停变白）、车名（标题 21）、保存状态（车名右边：「自动保存」→ 服务器回了「已保存 ✓」→ 淡回去；
--     没存上琥珀「没存上 · 重试」）、下一行「中国 · VII 级 · BR 13.3」（粗 13 灰）；右边页签「挂载（地面车：弹药）· 改装 · 乘员 ·（涂装）· 资料」——
--     选中白底黑字（一屏白底只有页签 + 主按钮），没选中的不填底、不描边、灰字，页签组下面一道 1 像素底线。飞机没有涂装（现在只有地面车会上色），页签直接不放。
--     这一轮只有「挂载」是新做的（WsArms.lua），其余先打开现有的面板（G.openMods / openCrew / openSkin / openInfo / openAmmo），关了回到挂载页
--   · 左栏 x 24 宽 300、右栏靠右宽 320（132～580，高度跟着内容走：ws.fitCol）、底部条 592～696（高 104；上面一行 22 高放名牌、左右对称）；
--     左右两边各一块压暗的渐变（BG 色，外侧 0.35 → 里侧 1）：字清楚、中间的飞机像被打了光；右下角「拖动转 · 滚轮缩放 · 右键返回」
--   · 进场：两栏从两边滑进 24 像素 + 淡入、底部条从下面上来、抬头往下落一点（0.28 秒先快后慢），镜头飞到全景（0.55 秒两头慢）；
--     退场只淡出（0.18 秒）。CanvasGroup 只在这两段时间里用（平时是普通 Frame：CanvasGroup 在部分设备上把里面画成一张贴图，字会发糊）
--   · 返回（一层层退：开着的旧面板 → 选着的挂点 → 回机库）：「‹ 机库」、右键、Backspace；3D 空白处点一下只在整备里面退（不退出整备）；
--     Esc 也认，但 Roblox 按 Esc 会开系统菜单（引擎行为）：菜单开着、或者这一下是去开 / 关菜单的，都不算返回。Ctrl+Z 撤销（页自己的 undo）
--   · 改动即时存（不设「保存」键）
--   手机（1000 × 500 画布）：两栏收窄（236 / 244）、底部条 84 高、挂点卡横着卷；能点的东西都 ≥ 44 高（页签、小块、「‹ 机库」、内油、左右对称）
--   G.openWorkshop(科技树的项, 页签)、G.closeWorkshop(马上)、G.workshopOpen()、G.workshopState()（测试用）
--   入口：机库顶栏的弹药键（飞机 / 直升机；地面车这一轮照旧开配弹面板）
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local GuiService = game:GetService("GuiService")

local Workshop = {}

function Workshop.init(G)
  local TT = require(RS:WaitForChild("TechTree"))
  local WM = require(RS:WaitForChild("WtMods"))
  local K = require(script.Parent:WaitForChild("WsKit"))
  local WsArms = require(script.Parent:WaitForChild("WsArms"))
  local TH = K.TH
  local C, A, S = TH.C, TH.A, TH.S
  local me = Players.LocalPlayer
  local UD2, V2 = UDim2.new, Vector2.new
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local zh = G.isZh()   -- 多语言（11-28）：中文（简 / 繁）
  local compact = G.mobile == true or (UIS.TouchEnabled and not UIS.KeyboardEnabled)
  -- 排版（Root 画布上的像素）：M 边距、HY / HH 抬头、TOP 两栏的上沿、LW / RW 两栏宽、BH / BM 底部条的高和离下边多远、GAP 间距、DW 悬停资料卡宽、
  --   PLATE 底部条上面那一行（名牌、左右对称）、HIT 能点的东西最少多高（手机 44 ≈ 34pt）
  local LAY = compact and { M = 12, HY = 52, HH = 44, TOP = 104, LW = 236, RW = 244, BH = 84, BM = 10, GAP = 8, DW = 0, TABW = 84, TABH = 44, BACKW = 84, HIT = 44, PLATE = 22 }
    or { M = 24, HY = 80, HH = 40, TOP = 132, LW = 300, RW = 320, BH = 104, BM = 24, GAP = 12, DW = 300, TABW = 96, TABH = 30, BACKW = 80, HIT = 30, PLATE = 22 }

  local W = { on = false, tab = nil, it = nil, key = nil, panel = nil, page = nil }
  local ui = { blocks = {} }
  local built = false
  local H = nil   -- TechUI 的 G.hangarParts（vw × vh 是缩放后的画布、scale 是缩放倍数）
  local ws = { K = K, T = T, LAY = LAY, compact = compact }
  function ws.vw() return (H and H.vw) or 1280 end
  function ws.vh() return (H and H.vh) or 720 end
  function ws.scale() return (H and H.scale) or 1 end
  function ws.colH() return ws.vh() - LAY.TOP - LAY.BM - LAY.BH - LAY.GAP end
  function ws.barTop() return ws.vh() - LAY.BM - LAY.BH end   -- 底部条的上沿（Root 坐标）
  local arms = nil

  ---------------------------------------------------------------- 搭（第一次打开时：TechUI 的机库界面得先搭好）

  -- 一块（抬头、左栏、右栏、底部条、资料卡）：平时是普通的 Frame；进场 / 退场那一小段才临时放进一个 CanvasGroup（fader）里整体滑动、淡入淡出，动完放回来
  local function block(name, size, pos, anchor, z)
    local h = Instance.new("Frame")
    h.Name = name
    h.BackgroundTransparency = 1
    h.BorderSizePixel = 0
    h.Size, h.Position, h.AnchorPoint = size, pos, anchor or V2(0, 0)
    h.ZIndex = z or 2
    h.Parent = ui.root
    local f = Instance.new("CanvasGroup")
    f.Name = name .. "Fade"
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.ZIndex = z or 2
    f.Visible = false
    f.Parent = ui.root
    ui.blocks[h] = { fade = f, pos = pos, anchor = anchor or V2(0, 0), tok = nil }
    return h
  end
  local function wrap(h)   -- 放进 CanvasGroup（照这块现在的大小、位置）
    local b = ui.blocks[h]
    local f = b.fade
    if h.Parent == f then return f end
    f.Size, f.AnchorPoint, f.Position = h.Size, h.AnchorPoint, h.Position
    f.GroupTransparency = 0
    f.Visible = true
    h.Parent = f
    h.AnchorPoint, h.Position, h.Size = V2(0, 0), UD2(0, 0, 0, 0), UD2(1, 0, 1, 0)
    return f
  end
  local function unwrap(h)   -- 放回来（停在这块的原位）
    local b = ui.blocks[h]
    local f = b.fade
    if h.Parent ~= f then return end
    h.Size, h.AnchorPoint, h.Position = f.Size, b.anchor, b.pos
    h.Parent = ui.root
    f.Visible = false
  end
  local function holderOf(h)   -- 这块现在是谁在管大小（在 CanvasGroup 里时是它）
    local b = ui.blocks[h]
    return (b and h.Parent == b.fade) and b.fade or h
  end
  local function build()
    local hg = G.hangarGui
    H = G.hangarParts
    if not (hg and H) then return false end
    ws.Stage = G.hangarStage
    local root = K.frame(hg, UD2(1, 0, 1, 0), nil, nil, 1)
    root.Name = "Workshop"
    root.ZIndex = 3
    root.Visible = false
    ui.root = root
    -- 两边压暗（标签层下面）：BG 色，外侧 0.35 → 里侧 1——两栏的字不被背后的机库压着，中间的飞机更像被打了光（底下那一块 TechUI 的机库本来就有）
    for i = 1, 2 do
      local left = i == 1
      local sh = K.frame(root, UD2(0, 420, 1, 0), UD2(left and 0 or 1, 0, 0, 0), C.BG, 0, V2(left and 0 or 1, 0))
      sh.Name = left and "WsShadeL" or "WsShadeR"
      sh.ZIndex = 0
      local g = Instance.new("UIGradient")
      g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, left and 0.35 or 1), NumberSequenceKeypoint.new(1, left and 1 or 0.35) })
      g.Parent = sh
    end
    -- 3D 标签层（两栏、底部条压在它上面）
    local lab = K.frame(root, UD2(1, 0, 1, 0), nil, nil, 1)
    lab.Name = "WsLabels"
    lab.ZIndex = 1
    ws.labels = lab
    -- 抬头：「‹ 机库」、车名、保存状态、国家 · 等级 · BR；右边页签
    local head = block("WsHead", UD2(1, -2 * LAY.M, 0, LAY.HH), UD2(0, LAY.M, 0, LAY.HY), nil, 3)
    ui.head = head
    local back = K.button(head, UD2(0, LAY.BACKW, 0, LAY.HIT), UD2(0, -6, 0.5, 0), "WsBack")
    back.AnchorPoint = V2(0, 0.5)
    local chev = K.chevron(back, 6, LAY.HIT / 2 - 6, 12, C.MUTE)   -- 「‹」画出来（不靠字体）
    local bl = K.text(back, T("ws.back"), S.small, "bold", C.MUTE, UD2(1, -24, 1, 0), UD2(0, 22, 0, 0))
    bl.Name = "Label"
    back.MouseEnter:Connect(function()
      bl.TextColor3 = C.TEXT
      K.tintChevron(chev, C.TEXT)
    end)
    back.MouseLeave:Connect(function()
      bl.TextColor3 = C.MUTE
      K.tintChevron(chev, C.MUTE)
    end)
    back.Activated:Connect(function() if W.on then G.closeWorkshop() end end)
    local nx = LAY.BACKW + 6
    ui.nx = nx
    ui.name = K.text(head, "", compact and S.sub or S.title, "title", C.TEXT, UD2(0, 420, 0, compact and 22 or 24), UD2(0, nx, 0, compact and 1 or -1))
    ui.name.Name = "WsName"
    ui.sub = K.text(head, "", compact and S.tiny or S.small, "bold", C.MUTE, UD2(0, 420, 0, 16), UD2(0, nx, 1, compact and -18 or -15))
    ui.sub.Name = "WsSub"
    -- 保存状态（车名右边）
    local sv = K.button(head, UD2(0, 150, 0, compact and 22 or 24), UD2(0, nx + 120, 0, compact and 1 or -1), "WsSave")
    sv.Active = false
    ui.saveTick = K.tick(sv, 0, (compact and 22 or 24) / 2 - 5, 10, C.MUTE)
    ui.saveTick.Visible = false
    ui.saveT = K.text(sv, T("ws.autosave"), S.tiny, "bold", C.FAINT, UD2(1, -16, 1, 0), UD2(0, 0, 0, 0))
    ui.saveT.Name = "Label"
    sv.Activated:Connect(function()
      local f = W.saveFail
      if f and f.retry then
        W.saveFail = nil
        f.retry()
      end
    end)
    ui.save = sv
    -- 左栏、右栏（面板：深色 0.06 + 细线；高度跟着内容走）
    local colH = -(LAY.TOP + LAY.BM + LAY.BH + LAY.GAP) + 2
    local lg = block("WsLeft", UD2(0, LAY.LW + 2, 1, colH), UD2(0, LAY.M - 1, 0, LAY.TOP - 1), nil, 2)
    ui.lg = lg
    ws.left = K.panel(lg, UD2(1, -2, 1, -2), UD2(0, 1, 0, 1), nil, 0.06)
    ws.left.Name = "Panel"
    local rg = block("WsRight", UD2(0, LAY.RW + 2, 1, colH), UD2(1, -LAY.M + 1, 0, LAY.TOP - 1), V2(1, 0), 2)
    ui.rg = rg
    ws.right = K.panel(rg, UD2(1, -2, 1, -2), UD2(0, 1, 0, 1), nil, 0.06)
    ws.right.Name = "Panel"
    -- 底部条（挂点卡自己是卡片，条本身透明）；上面一行（名牌、左右对称）
    local bg = block("WsBottom", UD2(1, -2 * LAY.M + 4, 0, LAY.BH + 6 + LAY.PLATE), UD2(0, LAY.M - 2, 1, -LAY.BM + 3), V2(0, 1), 2)
    ui.bg = bg
    local bp = K.frame(bg, UD2(1, -4, 0, LAY.BH), UD2(0, 2, 1, -(LAY.BH + 3)), nil, 1)
    bp.Name = "Bar"
    bp.Active = true
    ws.bottom = bp
    local bh = K.frame(bg, UD2(1, -4, 0, LAY.PLATE), UD2(0, 2, 0, 0), nil, 1)
    bh.Name = "BarHead"
    ws.barHead = bh
    -- 悬停资料卡（桌面）：浮在左栏右边，位置固定（页定：武器列表的上沿）
    local dg = block("WsDetail", UD2(0, math.max(LAY.DW, 10) + 2, 0, 252), UD2(0, LAY.M + LAY.LW + LAY.GAP, 0, LAY.TOP), nil, 4)
    dg.Visible = false
    ui.dg = dg
    ws.detail = dg
    -- 右下角的提示（手机不写：没有滚轮、没有右键）
    if not compact then
      ui.hint = K.text(root, T("ws.hint"), S.tiny, "body", C.FAINT, UD2(0, 420, 0, 14), UD2(1, -LAY.M, 1, -5), Enum.TextXAlignment.Right, V2(1, 1))
      ui.hint.Name = "WsHint"
    end
    -- 浮在 3D 上的这几块挡住后面的拖车（TechUI：按位置挡）：平时的 Frame 和进退场时的 CanvasGroup 都登记
    G.stageBlockers = G.stageBlockers or {}
    for _, g in ipairs({ head, lg, rg, bg, dg }) do
      G.stageBlockers[g] = true
      G.stageBlockers[ui.blocks[g].fade] = true
    end
    return true
  end

  ---------------------------------------------------------------- 资料卡的位置、栏高、保存状态（页调用）

  -- 资料卡固定在左栏右边、武器列表上沿那一高（Root 坐标的 y）：换卡只换内容，不跟着卡片跳
  function ws.detailAt(y)
    local b = ui.blocks[ui.dg]
    b.pos = UD2(0, LAY.M + LAY.LW + LAY.GAP, 0, y)
    if ui.dg.Parent ~= b.fade then ui.dg.Position = b.pos end
  end
  -- 资料卡出来（第一次：0.12 秒淡入）/ 收起
  function ws.detailShow(on)
    local h = ui.dg
    local b = ui.blocks[h]
    if on then
      if h.Visible then return end
      h.Visible = true
      local f = wrap(h)
      f.Position = b.pos
      f.GroupTransparency = 1
      TH.tween(f, { GroupTransparency = 0 }, "hover", "out")
      local tok = {}
      b.tok = tok
      task.delay(TH.T.hover + 0.03, function() if b.tok == tok then unwrap(h) end end)
    else
      b.tok = nil
      unwrap(h)
      h.Visible = false
    end
  end
  -- 栏高跟着内容走：h 是内容高；超过整栏就是整栏；0.22 秒补间（instant：马上）
  function ws.fitCol(side, h, instant)
    local blk = (side == "left") and ui.lg or ui.rg
    if not blk then return end
    local hh = math.clamp(math.floor((h or 0) + 0.5), 40, ws.colH()) + 2
    local sz = UD2(0, ((side == "left") and LAY.LW or LAY.RW) + 2, 0, hh)
    local tgt = holderOf(blk)
    if instant or tgt.Size == sz then
      tgt.Size = sz
    else
      TH.tween(tgt, { Size = sz }, "ui", "out")
    end
  end
  -- 保存状态：idle 淡淡的「自动保存」、ok「已保存 ✓」（淡入 0.12、停 1.2、0.6 秒淡回 idle）、fail 琥珀「没存上 · 重试」（点了重发）
  local function saveUI(state)
    local lab, tk, b = ui.saveT, ui.saveTick, ui.save
    if not lab then return end
    W.saveTok = {}
    local tok = W.saveTok
    b.Active = state == "fail"
    if state == "ok" then
      tk.Visible = true
      lab.Position = UD2(0, 14, 0, 0)
      lab.Text = T("ws.saved")
      lab.TextColor3 = C.MUTE
      lab.TextTransparency = 1
      TH.tween(lab, { TextTransparency = 0 }, "hover", "out")
      task.delay(TH.T.hover + 1.2, function()
        if W.saveTok ~= tok then return end
        TH.tween(lab, { TextTransparency = 1 }, 0.3, "out")
        task.delay(0.3, function()
          if W.saveTok ~= tok then return end
          tk.Visible = false
          lab.Position = UD2(0, 0, 0, 0)
          lab.Text = T("ws.autosave")
          lab.TextColor3 = C.FAINT
          TH.tween(lab, { TextTransparency = 0 }, 0.3, "out")
        end)
      end)
    elseif state == "fail" then
      tk.Visible = false
      lab.Position = UD2(0, 0, 0, 0)
      lab.Text = T("ws.saveFail")
      lab.TextColor3 = C.WARN
      lab.TextTransparency = 0
    else
      tk.Visible = false
      lab.Position = UD2(0, 0, 0, 0)
      lab.Text = T("ws.autosave")
      lab.TextColor3 = C.FAINT
      lab.TextTransparency = 0
    end
  end
  -- 页发了一次存：check() → 服务器回的存档里是不是这一套；retry() → 再发一次。4 秒没回：没存上
  function ws.saving(check, retry)
    W.save = { t = os.clock(), check = check, retry = retry }
    W.saveFail = nil
  end
  local function placeSave()   -- 保存状态挪到车名右边（车名多宽按字估：标题字重的英文、数字宽一点）
    if not (ui.save and ui.name) then return end
    local w = K.textW(ui.name.Text, ui.name.TextSize, false, true)
    ui.save.Position = UD2(0, ui.nx + math.floor(w + 16), 0, compact and 1 or -1)
  end

  ---------------------------------------------------------------- 页签

  local TABS_AIR = { "arms", "mods", "crew", "info" }   -- 飞机没有涂装（现在只有地面车会上色）：不放这个页签
  local TABS_GROUND = { "ammo", "mods", "crew", "skin", "info" }
  local function buildTabs(air)
    for _, t in pairs(ui.tabs or {}) do t.b:Destroy() end
    if ui.tabLine then ui.tabLine:Destroy() end
    ui.tabs = {}
    local list = air and TABS_AIR or TABS_GROUND
    local n = #list
    local gap = 2
    for i, key in ipairs(list) do
      local b = Instance.new("TextButton")
      b.Name = "Tab_" .. key
      b.Text = T("ws.tab." .. key)
      b.Font = TH.F.bold
      b.TextSize = compact and S.small or S.body
      b.AutoButtonColor = false
      b.BorderSizePixel = 0
      b.BackgroundColor3 = C.TEXT
      b.BackgroundTransparency = 1
      b.TextColor3 = C.MUTE
      b.Size = UD2(0, LAY.TABW, 0, LAY.TABH)
      b.Position = UD2(1, -(n - i) * (LAY.TABW + gap), 1, -1)
      b.AnchorPoint = V2(1, 1)
      b.Parent = ui.head
      TH.corner(b)
      b.MouseEnter:Connect(function() if W.tab ~= key then b.TextColor3 = C.TEXT end end)
      b.MouseLeave:Connect(function() if W.tab ~= key then b.TextColor3 = C.MUTE end end)
      b.Activated:Connect(function() if ws.openTab then ws.openTab(key) end end)
      ui.tabs[key] = { b = b }
    end
    local tw = n * LAY.TABW + (n - 1) * gap
    ui.tabLine = K.frame(ui.head, UD2(0, tw, 0, 1), UD2(1, 0, 1, 0), C.LINE, A.line, V2(1, 1))
    ui.tabLine.Name = "TabLine"
  end
  local function paintTabs()
    for key, t in pairs(ui.tabs or {}) do
      local on = key == W.tab
      t.b.BackgroundColor3 = C.TEXT
      t.b.BackgroundTransparency = on and 0 or 1
      t.b.TextColor3 = on and C.BG or C.MUTE
    end
  end
  -- 现有的面板开着没有 / 关上
  local function panelOpen(p)
    if p == "mods" then return G.modsGui ~= nil and G.modsGui.Visible end
    if p == "crew" then return G.crewGui ~= nil and G.crewGui.Visible end
    if p == "info" then return G.infoGui ~= nil and G.infoGui.Visible end
    if p == "ammo" then return G.ammoPanelOpen ~= nil and G.ammoPanelOpen() == true end
    if p == "skin" then
      local g = me.PlayerGui:FindFirstChild("WtSkin")
      return g ~= nil and g.Enabled
    end
    return false
  end
  local function closePanel()
    local p = W.panel
    W.panel = nil
    if p == "mods" and G.modsGui then G.modsGui.Visible = false
    elseif p == "crew" and G.crewGui then G.crewGui.Visible = false
    elseif p == "info" and G.infoGui then G.infoGui.Visible = false
    elseif p == "skin" then
      local g = me.PlayerGui:FindFirstChild("WtSkin")
      if g then g.Enabled = false end
    end
  end
  function ws.openTab(key)
    if not W.on then return end
    local it = W.it
    if not (ui.tabs and ui.tabs[key]) then return end
    closePanel()
    if W.page and key == W.page.name then
      W.tab = key
      paintTabs()
      return
    end
    local opened = nil
    if key == "ammo" and G.openAmmo then
      local tree = G.treeState and G.treeState()
      local md = tree and tree.mods and tree.mods[W.key]
      local fx = WM.fx(it, md and md.done)
      G.openAmmo(W.key, fx and fx.ammo)
      opened = "ammo"
    elseif key == "mods" and G.openMods then
      G.openMods(it)
      opened = "mods"
    elseif key == "crew" and G.openCrew then
      local _, _, slot = nil, nil, 1
      if G.hangarSel then _, _, slot = G.hangarSel() end
      G.openCrew(it.nat, slot or 1, W.key)
      opened = "crew"
    elseif key == "skin" and G.openSkin then
      G.openSkin(W.key)
      opened = "skin"
    elseif key == "info" and G.openInfo then
      G.openInfo(it)
      opened = "info"
    end
    if opened then
      W.panel = opened
      W.tab = key
      paintTabs()
    end
  end

  ---------------------------------------------------------------- 进场 / 退场

  local function slideIn(h, dx, dy, show)
    local b = ui.blocks[h]
    h.Visible = show ~= false
    local f = wrap(h)
    f.Position = b.pos + UD2(0, dx, 0, dy)
    f.GroupTransparency = 1
    TH.tween(f, { Position = b.pos, GroupTransparency = 0 }, "panel", "out")
    local tok = {}
    b.tok = tok
    task.delay(TH.T.panel + 0.03, function() if b.tok == tok then unwrap(h) end end)
  end
  local function enter()
    ui.root.Visible = true
    W.leaveTok = nil
    local has = W.page ~= nil
    slideIn(ui.head, 0, -8)
    slideIn(ui.lg, -24, 0, has)
    slideIn(ui.rg, 24, 0, has)
    slideIn(ui.bg, 0, 24, has)
    ws.detailShow(false)
    if ui.hint then
      ui.hint.Visible = has
      ui.hint.TextTransparency = 1
      TH.tween(ui.hint, { TextTransparency = 0 }, "panel", "out", 0.2)
    end
  end
  local function leave(instant)
    if instant then
      for h, b in pairs(ui.blocks) do
        b.tok = nil
        unwrap(h)
      end
      ui.root.Visible = false
      return
    end
    for _, h in ipairs({ ui.head, ui.lg, ui.rg, ui.bg, ui.dg }) do
      local b = ui.blocks[h]
      local f = wrap(h)
      b.tok = nil
      TH.tween(f, { GroupTransparency = 1 }, "out", "out")
    end
    if ui.hint then TH.tween(ui.hint, { TextTransparency = 1 }, "out", "out") end
    local tok = {}
    W.leaveTok = tok
    task.delay(TH.T.out + 0.02, function()
      if W.leaveTok ~= tok or W.on then return end
      for h in pairs(ui.blocks) do unwrap(h) end
      ui.root.Visible = false
    end)
  end

  ---------------------------------------------------------------- 打开 / 关上

  function G.openWorkshop(it, tab)
    if not it and G.hangarSel then it = G.hangarSel() end
    if not it then return false end
    if not built then
      built = build()
      if not built then return false end
    end
    if W.on then
      if W.key == it.key then
        if tab then ws.openTab(tab) end
        return true
      end
      G.closeWorkshop(true)
    end
    local air = it.branch == "air" or it.branch == "heli"
    W.on, W.it, W.key, W.panel, W.page = true, it, it.key, nil, nil
    W.save, W.saveFail = nil, nil
    if G.hangarWsMode then G.hangarWsMode(true) end
    local N = TT.NAT[it.nat] or { name = it.nat, en = it.nat }
    local R0 = TT.RANKS[it.rank] or { roman = tostring(it.rank) }
    ui.name.Text = G.L(it.name, it.en)
    ui.sub.Text = T("ws.sub", G.L(N.name, N.en), R0.roman, TT.brText(it.br))
    placeSave()
    saveUI("idle")
    buildTabs(air)
    if air then
      arms = arms or WsArms.new(G, ws)
      if arms.open(it) then W.page = arms end
    end
    W.tab = W.page and W.page.name or (air and "arms" or "ammo")
    paintTabs()
    enter()
    if not air then ws.openTab("ammo")   -- 地面车（这一轮）：弹药页还是现在的配弹面板
    elseif tab and tab ~= W.tab then ws.openTab(tab) end
    return true
  end
  function G.closeWorkshop(instant)
    if not W.on then return end
    W.on = false
    W.press = nil
    closePanel()
    if W.page then W.page.close(instant) end
    W.page = nil
    leave(instant)
    if G.hangarWsMode then G.hangarWsMode(false, instant) end
    local S2 = ws.Stage
    if S2 then pcall(S2.home, instant and 0 or TH.T.cam) end
  end
  G.workshopOpen = function() return W.on end
  G.wsKit = K   -- 测试用（拖动条这些下一轮弹药页才用上的零件）
  G.workshopState = function() return W, arms and arms.state(), arms end   -- 测试、截图用
  -- 退一层：开着的旧面板 → 页里的一层（选着的挂点、弹出的小菜单……）→ 回机库
  ws.back = function()
    if W.panel then
      closePanel()
      W.tab = W.page and W.page.name or W.tab
      paintTabs()
      return
    end
    if W.page and W.page.esc() then return end
    G.closeWorkshop()
  end
  -- 只在整备里面退一层（3D 空白处点一下：全景时手一滑不该把整备关了）；退了返回 true
  ws.backSoft = function()
    if W.panel then
      ws.back()
      return true
    end
    return W.page ~= nil and W.page.esc() == true
  end
  G.workshopBack = ws.back

  -- 返回、撤销的键：右键、Backspace 退一层；Esc 也认（Roblox 的系统菜单要开 / 关的那一下不算：先看菜单开着没有，等一下再看一次）；Ctrl / ⌘ + Z 撤销
  local function menuOpen()
    local ok, v = pcall(function() return GuiService.MenuIsOpen end)
    return ok and v == true
  end
  local menuClosedAt = -9
  pcall(function() GuiService.MenuClosed:Connect(function() menuClosedAt = os.clock() end) end)
  local function ctrlDown()
    return UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
      or UIS:IsKeyDown(Enum.KeyCode.LeftSuper) or UIS:IsKeyDown(Enum.KeyCode.RightSuper)
  end
  UIS.InputBegan:Connect(function(io, gp)
    if not W.on then return end
    local kc, ut = io.KeyCode, io.UserInputType
    if kc == Enum.KeyCode.Escape then
      if UIS:GetFocusedTextBox() then return end
      if G.settingsGui and G.settingsGui.Enabled then return end
      local wasOpen = menuOpen() or (os.clock() - menuClosedAt < 0.25)
      task.defer(function()
        if not W.on or wasOpen or menuOpen() then return end
        ws.back()
      end)
    elseif kc == Enum.KeyCode.Backspace then
      if gp or UIS:GetFocusedTextBox() then return end
      ws.back()
    elseif kc == Enum.KeyCode.Z then
      if gp or UIS:GetFocusedTextBox() or not ctrlDown() then return end
      if W.page and W.page.undo then W.page.undo() end
    elseif ut == Enum.UserInputType.MouseButton2 then
      if gp then return end
      if G.stageFree and not G.stageFree(io.Position) then return end
      W.rpress = { pos = io.Position, t = os.clock() }
    elseif ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch then
      if gp or not (G.stageFree and G.stageFree(io.Position)) then return end
      W.press = { pos = io.Position, t = os.clock() }
    end
  end)
  -- 松开时才算点：按下到松开挪了不到 6 像素、不到 0.3 秒（拖着转飞机的不算）
  local function tapped(p, io)
    if not p then return false end
    local ok, d = pcall(function() return (Vector2.new(io.Position.X, io.Position.Y) - Vector2.new(p.pos.X, p.pos.Y)).Magnitude end)
    return ok and d < 6 and os.clock() - p.t < 0.3
  end
  UIS.InputEnded:Connect(function(io)
    if not W.on then return end
    local ut = io.UserInputType
    if ut == Enum.UserInputType.MouseButton2 then
      local p = W.rpress
      W.rpress = nil
      if tapped(p, io) then ws.back() end
    elseif ut == Enum.UserInputType.MouseButton1 or ut == Enum.UserInputType.Touch then
      local p = W.press
      W.press = nil
      if tapped(p, io) then ws.backSoft() end
    end
  end)

  -- 每帧：机库收起了（出击、观战、开了主菜单）就马上关；旧面板关了回到本页；存了 4 秒服务器没回：没存上；页自己的（3D 标签）
  local function step(dt)
    if not W.on then return end
    if not (G.hangarGui and G.hangarGui.Visible) then
      G.closeWorkshop(true)
      return
    end
    if W.panel and not panelOpen(W.panel) then
      W.panel = nil
      W.tab = W.page and W.page.name or W.tab
      paintTabs()
    end
    if W.save and os.clock() - W.save.t > 4 then
      W.saveFail = W.save
      W.save = nil
      saveUI("fail")
    end
    if W.page then W.page.step(dt or 0.016) end
  end
  local function safeStep(dt)
    local ok, err = pcall(step, dt)
    if not ok and G.showError then G.showError("local workshop: " .. tostring(err)) end
  end
  if G.frameConn then G.frameConn("workshop", safeStep) else RunService.RenderStepped:Connect(safeStep) end
  -- 存档变了（服务器推了新的 Tree：存上了、我的方案、改装研究完了）：保存状态、页上跟着刷
  me:GetAttributeChangedSignal("Tree"):Connect(function()
    task.defer(function()
      if not W.on then return end
      local sv = W.save
      if sv and sv.check then
        local ok, yes = pcall(sv.check)
        if ok and yes then
          W.save = nil
          saveUI("ok")
        end
      end
      if W.page and W.page.refresh then W.page.refresh() end
    end)
  end)
  -- 窗口大小变了：底部条按新的宽重排（TechUI 先重算画布）
  pcall(function()
    workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
      task.defer(function() if W.on and W.page and W.page.relayout then W.page.relayout() end end)
    end)
  end)
end

return Workshop
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="282">
          <Properties>
            <string name="Name">WreckFx</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——车被打爆（用户 11-25「载具爆炸效果不够猛画风不够战雷」；11-27「坦克爆炸照战雷做」「M3 上要丝滑」）：照真车殉爆的录像做，写实、不卡通
--   殉爆（服务器 Wt.lua destroy 的 why = "ammo"，View.lua 车变残骸那一帧调 G.wreckFx）：按车的编号从三种样子里挑一种（战雷 Drone Age：每次不一样，但所有人看到的一样）——
--     A「大火球」：白热闪光 → 翻滚的大火球（白热的芯、橙红的火）→ 裹着它往上翻的煤黑浓烟（蘑菇），一大把火星
--     B「座圈火柱」：火球小一点，一根火柱从炮塔座圈直冲上去
--     C「连爆」：两三下接连炸开（隔 0.15～0.3 秒，位置在车里错开）
--   之后：十来块真的钢板碎块（会落地、会弹的零件；抵掉一部分重力，能飞二三十格高、几十格远），拖着火和黑烟，落地 4 秒后定住、留到残骸没了
--     （全局最多 40 块，满了先收最早定住的）；履带车再甩出一两个负重轮，在地上滚；地上一圈冲击波、贴地往外推的一圈土；地面烧焦一大块；
--     八九秒里车里剩下的弹一发一发殉爆（一闪、火星、一小团火、噼啪响，越来越稀）；舱口往外蹿火；车身大火、浓黑的烟柱顺风歪过去
--     （View.lua 的 fire / black 发射器：这里调粗调黑；烧四十秒火小下去、七十秒只剩一缕烟，见 View.lua）
--   烧毁（"fire"）：没有大火球，发动机舱窜火、黑烟柱、地面烧焦；乘员打光（"crew"）和别的：一缕黑烟
--   爆炸那几层全用 VfxLib 的发射器池（不每次新建发射器）；火（fire_main 本身暗褐）LightInfluence 0 + Brightness 3 才亮，
--   烟用 explosion01_smoke_main（本身深灰）、受光照、跟着风；火星是白点顺着速度拉成线（不用八角星）
--   离镜头远、机器跟不上（G.perfK）的少画；同时最多 3 处殉爆在冒碎块
--   11-27 审查：
--   · 预算（5）：殉爆第一秒所有发射器加起来（池里喷的 + 掀炮塔的火柱火星黑烟 + 碎块拖的火和烟 + 舱口火柱 + 炮塔身上的火和烟 + 车身大火）
--     压在 350 颗以内——掀炮塔那几层改走池（G.wreckTossFx / G.wreckLandFx），常喷的发射器少喷一点、用 VfxLib.rateK 记进全局预算。
--     规格写的是 300，11-27 复核时明确接受 350：最费的连爆炸三下实测三百出头（接连殉爆的头一两下落不落在第一秒里，上下差二三十颗）；
--     再砍就得砍火星、连爆、火柱，而用户 11-25 嫌过「载具爆炸效果不够猛」；M3 上贵的是贴脸的大块半透明（overdraw），不是这一秒
--     多出来的二三十颗小火星；全局 1800 / 2800 的上限照样管着（tools/mock/vfxreal.lua 按炸三下查 ≤ 350）
--   · 灯（6）：殉爆只点这里这一盏大灯（View 掀炮塔那盏去掉），白天最多亮 1.5 倍
--   · 碎块（13）：碰撞组——只跟地形、建筑碰，不碰角色和车
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local WreckFx = {}

function WreckFx.init(G)
  local V, CF, RGB = Vector3.new, CFrame.new, Color3.fromRGB
  local Map = require(RS:WaitForChild("Map"))
  local VL = G.vfx
  if not VL then error("WreckFx 要先有 Fx（VfxLib）") end
  local TX = VL.TX
  local seq, cs = VL.ns, VL.cs
  local upCF, lookCF = VL.upCF, VL.lookCF
  local UP = V(0, 1, 0)
  local DAY = { day = VL.DAY_MUL_BIG }   -- 殉爆的灯白天最多亮 1.5 倍
  -- 写实的颜色：火是白热 → 金黄 → 橙红，烟是煤黑 → 灰褐（不要纯黑、不要发紫）
  local FIRE_MID, FIRE_DARK = RGB(255, 158, 64), RGB(150, 52, 22)
  -- 火的中心偏白（用户 11-28「战雷的火中心偏白」）：刚喷出来（在火团中心）近乎白热，往外飘、变老才转金黄 → 橙 → 暗红
  local FIRE_WHITE, FIRE_PALE = RGB(255, 250, 238), RGB(255, 226, 158)

  local function holder(cf)
    local p = Instance.new("Part")
    p.Size, p.CFrame, p.Transparency = V(0.3, 0.3, 0.3), cf, 1
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Parent = G.fxFolder or workspace
    return p
  end
  -- 单独一个常喷的发射器（舱口火柱、碎块拖的火和烟这种要跟着东西、喷好几秒的）：o 的字段同 VfxLib（tex、life、spd、spread、size、tr、col、
  --   acc、drag、le、li、bright、rot、dir、vp、sq、wind）；rate 常喷、n 一次喷多少；secs 大概喷几秒（记进全局预算，粒子太多时 Rate 少给）
  local function emitter(h, o)
    local pe = Instance.new("ParticleEmitter")
    if o.rate and o.rate > 0 then
      local kb = VL.rateK(o.rate, o.secs or 3, o.life[2], o.prio or 2)
      o.rate = o.rate * kb
    end
    VL.apply(pe, o)
    pe.Parent = h
    if o.n and o.n > 0 then pe:Emit(o.n) end
    return pe
  end
  local function lod(p)
    local t, d = VL.lod(p)
    local k = VL.perfK() * ((t == 2) and 0.65 or ((t >= 3) and 0.4 or 1))
    return k, d, t
  end
  local function N(x, k) return math.max(1, math.floor(x * k + 0.5)) end
  local stat = { big = 0, chunks = 0, pops = 0, scorch = 0, jets = 0, wheels = 0, anchored = 0, style = {}, toss = 0, land = 0 }   -- 给测试看的（tools/mock/wreckfx.lua、vfxreal.lua）
  G.wreckStat = stat
  local function groundAt(p) return math.max(Map.height(p.X, p.Z), 0) end
  -- 残骸脚下是什么地（扬起的土按它上色）
  local function codeAt(p)
    local hs = G.groundUnder and G.groundUnder(p + V(0, 4, 0), 16)
    return G.groundCode and G.groundCode(hs) or "d"
  end

  ---------------------------------------------------------------- 碰撞组（审查 13）
  -- 碎块、负重轮现在飞得高、飞得远，物理在本地算：原来 CanCollide 一开，最容易推开、绊住本地玩家的角色。
  --   VfxChunk（碎块）只跟 Default（地形、房子、地图上的零件）碰；角色（所有玩家的）、车（View 的模型）的零件放进 VfxActor
  --   ——VfxActor 跟 Default、跟自己照样碰，只是不碰碎块。碎块之间也不碰（省物理）。
  --   PhysicsService 注册不了（老版本、客户端不让注册）就照旧：碎块照样碰所有东西（输出里留一条提示）
  --   服务器（Ents.lua）开服时也注册一遍：客户端不让注册、不让改的话，用服务器注册好、复制过来的那份
  local CHUNK_G, ACTOR_G = "VfxChunk", "VfxActor"
  local groupsOk = pcall(function()
    local PS = game:GetService("PhysicsService")
    local function reg(n)
      local okR, has = pcall(function() return PS:IsCollisionGroupRegistered(n) end)
      if not (okR and has) then PS:RegisterCollisionGroup(n) end
    end
    reg(CHUNK_G)
    reg(ACTOR_G)
    local okSet = pcall(function()
      PS:CollisionGroupSetCollidable(CHUNK_G, ACTOR_G, false)
      PS:CollisionGroupSetCollidable(CHUNK_G, CHUNK_G, false)
      PS:CollisionGroupSetCollidable(CHUNK_G, "Default", true)
      PS:CollisionGroupSetCollidable(ACTOR_G, "Default", true)
      PS:CollisionGroupSetCollidable(ACTOR_G, ACTOR_G, true)
    end)
    if not okSet and PS:CollisionGroupsAreCollidable(CHUNK_G, ACTOR_G) then error("碰撞组没设好") end
  end)
  G.wreckGroupsOk = groupsOk
  if not groupsOk then warn("[特效] 碎块的碰撞组注册不了（PhysicsService）：碎块照旧碰所有东西") end
  if groupsOk then
    local function actorPart(d)
      if d:IsA("BasePart") then pcall(function() if d.CollisionGroup ~= ACTOR_G then d.CollisionGroup = ACTOR_G end end) end
    end
    local function actorModel(m)
      if not m then return end
      for _, d in ipairs(m:GetDescendants()) do actorPart(d) end
      m.DescendantAdded:Connect(actorPart)
    end
    local function watchChar(pl)
      if pl.Character then actorModel(pl.Character) end
      pl.CharacterAdded:Connect(actorModel)
    end
    for _, pl in ipairs(Players:GetPlayers()) do watchChar(pl) end
    Players.PlayerAdded:Connect(watchChar)
    actorModel(G.viewFolder)   -- 车、机器人、工事的样子（View.lua 的 EntView）
  end
  local function chunkGroup(p)
    if groupsOk then pcall(function() p.CollisionGroup = CHUNK_G end) end
  end

  ---------------------------------------------------------------- 爆炸的各层（q = 火球半径 R / 14，主战坦克 1 上下；按 1.2 倍一档建发射器）
  VL.def("wFlash", function(q)   -- A0 闪光
    local R = 14 * q
    return { tex = TX.GLOW, life = { 0.14, 0.2 }, spd = { 0, 0 }, size = seq(0, R * 2, 1, R * 3.6), tr = seq(0, 0, 1, 1),
      col = cs(RGB(255, 250, 236), RGB(255, 200, 140)), le = 1, li = 0, bright = 6, z = 4, prio = 1 }
  end)
  VL.def("wCore", function(q)   -- A1 火球芯：从车里一个球里往外胀开
    local R = 14 * q
    return { tex = TX.CORE, life = { 0.5, 0.9 }, spd = { R * 0.6, R * 1.6 }, spread = 180, drag = 6, acc = V(0, R * 0.8, 0), rot = 120,
      size = seq(0, R * 0.6, 0.3, R * 1.3, 1, R * 1.5), tr = seq(0, 0, 0.6, 0.3, 1, 1),
      col = cs(0, FIRE_WHITE, 0.32, RGB(255, 238, 196), 0.55, RGB(255, 172, 72), 0.8, RGB(170, 64, 26), 1, RGB(70, 36, 22)),
      le = 0.95, li = 0, bright = 4, z = 3, shape = { "Sphere", "Volume", "Outward" }, box = V(R * 0.8, R * 0.8, R * 0.8), prio = 1 }
  end)
  VL.def("wHeart", function(q)   -- A1′ 白热的芯（用户 11-28「战雷的火中心偏白」）：火球正中几团叠加发光的白光，比火球芯活得久一点，慢慢转金黄、淡掉
    local R = 14 * q
    return { tex = TX.GLOW, life = { 0.55, 0.95 }, spd = { 0, R * 0.25 }, spread = 180, drag = 4, acc = V(0, R * 0.5, 0),
      size = seq(0, R * 0.8, 0.35, R * 1.35, 1, R * 1.1), tr = seq(0, 0.15, 0.55, 0.4, 1, 1),
      col = cs(0, RGB(255, 255, 250), 0.5, RGB(255, 244, 214), 1, RGB(255, 200, 120)), le = 1, li = 0, bright = 4, z = 3, prio = 1 }
  end)
  VL.def("wFire", function(q)   -- A2 翻滚的火：往外滚、被空气挡住、往上卷
    local R = 14 * q
    return { tex = TX.FIRE, life = { 1.0, 2.0 }, spd = { R * 0.8, R * 2.4 }, spread = 180, drag = 4, acc = V(0, R * 1.1, 0), rot = 70,
      size = seq(0, R * 0.5, 0.25, R * 1.1, 1, R * 0.7), tr = seq(0, 0.05, 0.5, 0.25, 1, 1), col = cs(0, FIRE_WHITE, 0.2, FIRE_PALE, 0.5, FIRE_MID, 1, FIRE_DARK),
      le = 0.9, li = 0, bright = 3.5, z = 2, prio = 1 }
  end)
  VL.def("wSoot", function(q)   -- A3 黑烟蘑菇：从火球外面翻上去，越升越大、越淡，顺风歪
    local R = 14 * q
    return { tex = TX.SOOT, life = { 5, 9 }, spd = { R * 0.5, R * 1.5 }, spread = 180, drag = 1.6, acc = V(0, R * 0.38 + 3, 0), wind = true, rot = 18,
      size = seq(0, R * 0.7, 0.2, R * 1.6, 1, R * 3.2), tr = seq(0, 1, 0.05, 0.08, 0.4, 0.2, 1, 1), col = cs(RGB(255, 255, 255)), z = 1, prio = 2 }
  end)
  VL.def("wEdge", function(q)   -- A3 外沿浅一点的烟
    local R = 14 * q
    return { tex = TX.SMOKE, life = { 5, 9 }, spd = { R * 0.6, R * 1.6 }, spread = 180, drag = 1.6, acc = V(0, R * 0.38 + 3, 0), wind = true, rot = 18,
      size = seq(0, R * 0.8, 0.2, R * 1.8, 1, R * 3.4), tr = seq(0, 1, 0.05, 0.1, 0.4, 0.3, 1, 1), col = cs(RGB(44, 41, 38), RGB(78, 74, 70)), z = 1, prio = 2 }
  end)
  VL.def("wSpark", function()   -- A4 火星：往四周上方撒，顺着飞的方向拉成线，带重力落
    return { tex = TX.GLOW, life = { 0.9, 2.2 }, spd = { 30, 85 }, spread = 70, drag = 0.6, acc = V(0, -28, 0),
      size = seq(0, 0.5, 1, 0.15), tr = seq(0, 0, 0.8, 0.2, 1, 1), col = cs(RGB(255, 232, 170), RGB(255, 150, 70)), le = 1, li = 0, bright = 3,
      vp = true, sq = seq(0, 2, 1, 0.8), prio = 3 }
  end, true)
  VL.def("wPillar", function(q)   -- B 座圈火柱
    local R = 14 * q
    return { tex = TX.FIRE, life = { 0.9, 1.4 }, spd = { 40, 80 }, spread = 12, drag = 1.5, acc = V(0, 8, 0), rot = 80,
      size = seq(0, R * 0.35, 0.4, R * 0.7, 1, R * 0.2), tr = seq(0, 0.05, 0.6, 0.3, 1, 1), col = cs(0, FIRE_WHITE, 0.3, FIRE_PALE, 0.6, FIRE_MID, 1, FIRE_DARK),
      le = 0.95, li = 0, bright = 3, z = 2, prio = 1 }
  end)
  VL.def("wDust", function(q, v)   -- A8 贴地往外推的一圈土（按残骸脚下的地上色）
    local R = 14 * q
    local P = (G.groundPal and G.groundPal(v)) or { dust = RGB(132, 118, 98), dust2 = RGB(170, 160, 142), life = 1 }
    return { tex = TX.SMOKE, life = { 1.6 * P.life, 2.8 * P.life }, spd = { R * 1.2, R * 2.4 }, dir = Enum.NormalId.Front, spread = { 180, 3 }, drag = 2,
      acc = V(0, 1.2, 0), wind = true, rot = 25, size = seq(0, R * 0.4, 1, R * 1.6), tr = seq(0, 0.3, 1, 1), col = cs(P.dust, P.dust2), sq = seq(0, -0.5, 1, -0.5), prio = 2 }
  end)
  VL.def("wShock", function(q)   -- A8 贴地冲击波圈
    local R = 14 * q
    return { tex = TX.RING, life = { 0.45, 0.55 }, spd = { 0.05, 0.05 }, spread = 0, flat = true, size = seq(0, R * 0.5, 1, R * 5),
      tr = seq(0, 0.2, 1, 1), col = cs(RGB(240, 226, 200)), li = 1, z = 0, prio = 3 }
  end)
  -- A9 车里剩下的弹一发一发殉爆（var B：大的一下）
  VL.def("wPopFlash", function(_, v)
    local b = v == "B"
    return { tex = TX.GLOW, life = { 0.08, 0.13 }, spd = { 0, 0 }, size = b and seq(0, 9, 1, 13) or seq(0, 5, 1, 7), tr = seq(0, 0, 1, 1),
      col = cs(RGB(255, 246, 220), RGB(255, 190, 120)), le = 1, li = 0, bright = 5, z = 3, prio = 1 }
  end, true)
  VL.def("wPopSpark", function(_, v)
    return { tex = TX.GLOW, life = { 0.5, 1.3 }, spd = { 20, (v == "B") and 70 or 50 }, spread = 60, drag = 0.5, acc = V(0, -40, 0),
      size = seq(0, 0.4, 1, 0.1), tr = seq(0, 0, 1, 0.4), col = cs(RGB(255, 230, 160), RGB(255, 140, 60)), le = 1, li = 0, bright = 3,
      vp = true, sq = seq(0, 2, 1, 1), prio = 3 }
  end, true)
  VL.def("wPopFire", function(_, v)
    local b = v == "B"
    return { tex = TX.FIRE, life = { 0.4, 0.8 }, spd = { 6, b and 26 or 14 }, spread = 35, drag = 2.5, acc = V(0, 18, 0), rot = 60,
      size = b and seq(0, 4, 0.4, 7, 1, 1.5) or seq(0, 2.5, 0.4, 4, 1, 1), tr = seq(0, 0.05, 1, 1), col = cs(0, FIRE_WHITE, 0.35, FIRE_PALE, 1, FIRE_DARK),
      le = 0.9, li = 0, bright = 3, prio = 2 }
  end, true)
  VL.def("wPopSmoke", function(_, v)
    return { tex = TX.SOOT, life = { 2.5, 4.5 }, spd = { 4, 10 }, spread = 30, drag = 1.2, acc = V(0, 5, 0), wind = true, rot = 15,
      size = seq(0, 3, 1, (v == "B") and 14 or 9), tr = seq(0, 0.1, 1, 1), col = cs(RGB(255, 255, 255)), prio = 2 }
  end, true)
  -- 转盘车殉爆前先烧：里面噼啪的火星
  VL.def("wCrackle", function()
    return { tex = TX.GLOW, life = { 0.35, 0.9 }, spd = { 18, 46 }, spread = 70, drag = 0.6, acc = V(0, -40, 0), size = seq(0, 0.35, 1, 0.08),
      tr = seq(0, 0, 1, 0.4), col = cs(RGB(255, 236, 170), RGB(255, 150, 60)), le = 1, li = 0, bright = 3, vp = true, sq = seq(0, 2, 1, 1), prio = 3 }
  end, true)
  -- 烧毁：发动机舱窜一下火、冒一大团黑烟；乘员打光：一缕黑烟
  VL.def("wFireBurst", function()
    return { tex = TX.FIRE, life = { 0.6, 1.2 }, spd = { 6, 18 }, spread = 30, drag = 2, acc = V(0, 14, 0), rot = 60, size = seq(0, 3, 0.4, 7, 1, 2),
      tr = seq(0, 0.05, 1, 1), col = cs(0, FIRE_WHITE, 0.25, FIRE_PALE, 0.55, FIRE_MID, 1, FIRE_DARK), le = 0.9, li = 0, bright = 3, prio = 1 }
  end, true)
  VL.def("wFireSmoke", function()
    return { tex = TX.SOOT, life = { 4, 7 }, spd = { 6, 14 }, spread = 25, drag = 1.2, acc = V(0, 4, 0), wind = true, rot = 15,
      size = seq(0, 5, 1, 22), tr = seq(0, 0.05, 1, 1), col = cs(RGB(255, 255, 255)), prio = 2 }
  end, true)
  VL.def("wCrewSmoke", function()
    return { tex = TX.SOOT, life = { 3, 5 }, spd = { 3, 8 }, spread = 30, drag = 1.2, acc = V(0, 3, 0), wind = true, rot = 15,
      size = seq(0, 3, 1, 12), tr = seq(0, 0.15, 1, 1), col = cs(RGB(255, 255, 255)), prio = 2 }
  end, true)
  -- 掀炮塔（View.lua 的 tossFx / landFx，审查 5：原来每次新建 3～4 个发射器、一下喷 186 颗）：座圈里冲上去的一柱火、往四周上方撒的火星、
  --   一团黑烟；炮塔砸到地上：贴地一圈冲击波、一圈土、一把火星。var B：坦克（同时还有 WreckFx 的大火球：这几层少喷）
  VL.def("tFire", function()
    return { tex = TX.FIRE, life = { 0.35, 0.8 }, spd = { 28, 60 }, spread = 14, drag = 1.5, acc = V(0, 4, 0), rot = 80,
      size = seq(0, 3.5, 0.5, 7, 1, 2), tr = seq(0, 0.05, 1, 1), col = cs(0, RGB(255, 246, 200), 0.4, RGB(255, 160, 60), 1, RGB(120, 40, 20)),
      le = 1, li = 0, bright = 3, z = 2, prio = 1 }
  end, true)
  VL.def("tSpark", function()
    return { tex = TX.GLOW, life = { 0.8, 1.8 }, spd = { 30, 70 }, spread = 60, drag = 0.4, acc = V(0, -40, 0),
      size = seq(0, 0.45, 1, 0.12), tr = seq(0, 0, 0.8, 0.2, 1, 1), col = cs(RGB(255, 210, 120)), le = 1, li = 0, bright = 3,
      vp = true, sq = seq(0, 2, 1, 0.8), prio = 3 }
  end, true)
  VL.def("tSmoke", function()
    return { tex = TX.SOOT, life = { 2.5, 4.5 }, spd = { 14, 30 }, spread = 30, drag = 1.2, acc = V(0, 2, 0), wind = true, rot = 15,
      size = seq(0, 5, 1, 20), tr = seq(0, 0.05, 1, 1), col = cs(RGB(255, 255, 255)), prio = 2 }
  end, true)
  VL.def("tRing", function()
    return { tex = TX.RING, life = { 0.5, 0.6 }, spd = { 0.05, 0.05 }, spread = 0, flat = true, size = seq(0, 3, 1, 15),
      tr = seq(0, 0.35, 1, 1), col = cs(RGB(160, 146, 124)), li = 1, prio = 3 }
  end, true)
  VL.def("tDust", function(_, v)
    local P = (G.groundPal and G.groundPal(v)) or { dust = RGB(140, 124, 98), dust2 = RGB(170, 160, 142), life = 1 }
    return { tex = TX.SMOKE, life = { 1, 2.2 }, spd = { 8, 22 }, spread = 75, drag = 2.5, acc = V(0, -4, 0), wind = true, rot = 25,
      size = seq(0, 3, 1, 11), tr = seq(0, 0.3, 1, 1), col = cs(P.dust, P.dust2), prio = 2 }
  end, true)
  VL.def("tLandSpark", function()
    return { tex = TX.GLOW, life = { 0.3, 0.7 }, spd = { 20, 40 }, spread = 80, drag = 0.5, acc = V(0, -40, 0),
      size = seq(0, 0.35, 1, 0.1), tr = seq(0, 0, 1, 0.3), col = cs(RGB(255, 200, 120)), le = 1, li = 0, bright = 3,
      vp = true, sq = seq(0, 2, 1, 0.8), prio = 3 }
  end, true)
  -- p 座圈的位置；big 坦克（WreckFx 同时画殉爆的大火球：火柱、火星、黑烟都少一点）
  function G.wreckTossFx(p, big)
    local k, d = lod(p)
    if d > 4000 then return end
    VL.emit("tFire", 1, upCF(p, UP), N(big and 16 or 30, k))
    VL.emit("tSpark", 1, upCF(p, UP), N(big and 14 or 30, k))
    VL.emit("tSmoke", 1, upCF(p, UP), N(big and 5 or 10, k))
    stat.toss += 1
  end
  -- 炮塔砸到地上
  function G.wreckLandFx(p)
    local k, d = lod(p)
    if d > 2500 then return end
    VL.emit("tRing", 1, upCF(p + V(0, 0.2, 0), UP), 1)
    VL.emit("tDust", 1, upCF(p, UP), N(14, k), codeAt(p))
    VL.emit("tLandSpark", 1, upCF(p, UP), N(14, k))
    stat.land += 1
  end

  -- 声音：闷响（服务器那声爆炸之外再叠一层低沉拖长的）、殉爆的噼啪
  local EXP = G.sndIds and G.sndIds.EXP or "rbxasset://sounds/impact_explosion_03.mp3"
  local function thump(p, d)
    if not G.sfx then return end
    local L = { { id = EXP, vol = 1.3, s = { 0.42, 0.48 }, eq = { 10, -4, -12 }, echo = { 0.35, 0.4, -6 } } }
    local RL = G.realLayer and G.realLayer("boomL", 0.78, 1.15)
    if RL then L = { RL, L[1] } end
    G.sfx(L, p, { delay = math.max(0, d - 250) / 960 + 0.04, rmin = 120, rmax = 6000, must = true })
  end
  local function pop(p, d, big)
    if not G.sfx or d > 1800 then return end
    local RL = G.realLayer and G.realLayer("boomS", big and 1.05 or (1.3 + math.random() * 0.3), big and 0.8 or 0.45)
    local L = RL and { RL } or { { id = EXP, vol = big and 0.8 or 0.45, s = big and { 1.0, 1.1 } or { 1.6, 2.1 }, reg = { 0.02, 0.6 } } }
    G.sfx(L, p, { delay = math.max(0, d - 250) / 960, rmin = 40, rmax = 2500 })
  end

  -- ① 闪光：白热的一团 + 照亮四周的大灯（Range 120，0.6 秒降到 0；离镜头 250 格内才要影子，同时只给 1 盏）——殉爆只点这一盏，白天最多 1.5 倍
  local function flashAt(p, R, d)
    if G.flash then G.flash(p + V(0, R * 0.3, 0), RGB(255, 190, 120), 120, 14, 0.6, { shadow = d < 250, day = VL.DAY_MUL_BIG }) end
    VL.emit("wFlash", R / 14, CF(p), 2)
  end
  -- ② 火球 + 浓烟 + 火星（样子 A / B / C）
  G.wreckStyleOverride = nil   -- 测试用：强制样子（"A" / "B" / "C"）
  G.wreckBlastsOverride = nil  -- 测试用：连爆炸几下（2 / 3；最费的是 3 下）
  local function fireball(p, R, k, style, L)
    local q = R / 14
    local function blast(at, m)
      VL.emit("wHeart", q, CF(at + V(0, R * 0.15, 0)), N(4 * m, k))
      VL.emit("wCore", q, CF(at), N(12 * m, k))
      VL.emit("wFire", q, CF(at), N(22 * m, k))
      VL.emit("wSoot", q, CF(at + V(0, R * 0.2, 0)), N(18 * m, k))
      VL.emit("wEdge", q, CF(at + V(0, R * 0.2, 0)), N(5 * m, k))
    end
    if style == "C" then   -- 连爆：两三下，隔 0.15～0.3 秒，位置在车里错开（后几下的闪光不另点大灯：一盏小的）
      local nb = G.wreckBlastsOverride or (2 + ((math.random() < 0.5) and 1 or 0))
      local t = 0
      for i = 1, nb do
        local off = V((math.random() - 0.5) * 0.6 * L, 0, (math.random() - 0.5) * 0.6 * L)
        if i == 1 then blast(p, 0.5) else
          t += 0.15 + math.random() * 0.15
          task.delay(t, function()
            blast(p + off, 0.5)
            VL.emit("wFlash", q * 0.7, CF(p + off), 1)
            if G.flash then G.flash(p + off + V(0, 3, 0), RGB(255, 186, 110), 40, 6, 0.3, DAY) end
          end)
        end
      end
    elseif style == "B" then   -- 座圈火柱：火球小一点，一根火柱往上冲
      blast(p, 0.7)
      VL.emit("wPillar", q, upCF(p + V(0, R * 0.2, 0), UP), N(40, k))
    else
      blast(p, 1)
    end
    VL.emit("wSpark", 1, upCF(p, UP), N(32, k))
  end

  -- ④ 地上：贴地冲击波圈、扬起一圈土
  local function groundRing(p, R, k)
    local gy = groundAt(p)
    local code = codeAt(p)
    VL.emit("wShock", R / 14, upCF(V(p.X, gy + 0.8, p.Z), UP), 1)
    VL.emit("wDust", R / 14, lookCF(V(p.X, gy + 0.8, p.Z), V(1, 0, 0)), N(16, k), code)
  end

  -- ④ 地面烧焦：软边的黑斑（烟的贴图染黑，平铺在地上）；跟着残骸，残骸没了它也没了
  local function scorch(base, L, W, parent)
    local gy = groundAt(base.Position)
    local D = math.max(L, W) * 1.5 * 1.2
    local p = Instance.new("Part")
    p.Size = V(D, 0.05, D)
    p.CFrame = CF(base.Position.X, gy + 0.06, base.Position.Z) * CFrame.Angles(0, math.random() * 6.28, 0)
    p.Transparency = 1
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    for i = 1, 2 do
      local dc = Instance.new("Decal")
      dc.Face = Enum.NormalId.Top
      dc.Texture = TX.SMOKE
      dc.Color3 = RGB(0, 0, 0)
      dc.Transparency = (i == 1) and 0.05 or 0.35
      dc.Parent = p
    end
    p.Name = "Scorch"
    p.Parent = parent or G.fxFolder or workspace
    stat.scorch += 1
    return p
  end

  ---------------------------------------------------------------- ③ 钢板碎块、负重轮
  -- 真的零件：飞出去、落地弹、拖着火和烟。Workspace.Gravity 是默认的 196.2 格/秒²（约 7 g），原来往上 28～74 格/秒只飞得起 2～14 格——
  --   每块挂一个往上的恒力（VectorForce）抵掉一部分，等于重力 45 格/秒²：往上 40～70、往旁边 15～40 格/秒，能飞二三十格高、几十格远；
  --   落地就把恒力关了（按真重力停稳），4 秒后定住（锚定、不碰撞）留到残骸没了；全局最多 40 块（满了先收最早定住的）；
  --   碰撞组 VfxChunk：只跟地形、建筑碰，不碰角色和车；一直没落地的（掉海里、卡在半空）9 秒后淡掉
  --   拖的火和烟（审查 5）：大块的都拖，小块的四分之一拖；火 8 / 6、烟 4 / 2 颗每秒，记进全局预算
  local G_EFF = 45
  local CHUNK_MAX = 40
  local chunkList = {}   -- { p, f, sm, vf, t0, land, rest, owner, burnT }
  local function killChunk(c)
    if c.p.Parent then c.p:Destroy() end
    c.dead = true
  end
  local function cap(need)
    local live = 0
    for _, c in ipairs(chunkList) do if not c.dead then live += 1 end end
    while live + need > CHUNK_MAX do
      local old = nil
      for _, c in ipairs(chunkList) do
        if not c.dead and c.rest and (not old or c.rest < old.rest) then old = c end   -- 最早定住的
      end
      if not old then break end
      killChunk(old)
      stat.capKill = (stat.capKill or 0) + 1
      live -= 1
    end
    return math.max(0, CHUNK_MAX - live)
  end
  local function massOf(part)
    local ok, m = pcall(function() return part:GetMass() end)
    if ok and type(m) == "number" and m > 0 then return m end
    local s = part.Size
    return 7.8 * s.X * s.Y * s.Z * (part:IsA("WedgePart") and 0.5 or 1)
  end
  local function lift(c)
    local a = Instance.new("Attachment")
    a.Parent = c
    local vf = Instance.new("VectorForce")
    vf.Attachment0 = a
    vf.RelativeTo = Enum.ActuatorRelativeTo.World
    vf.ApplyAtCenterOfMass = true
    vf.Force = V(0, massOf(c) * (workspace.Gravity - G_EFF), 0)
    vf.Parent = c
    return vf
  end
  -- 碎块拖的烟带（Trail）：两个附着点隔 1.2 格（宽度 = 间距 × WidthScale），越往后越宽、越淡、越灰（烟散开了）；
  --   一直对着镜头；烧完（burnT）以后不再拖新的，已经拖出来的照常淡掉。贴图是烟团，按 4 格一段重复（看上去是一团团连着的浓烟）
  local function smokeTrail(c, big)
    local a0, a1 = Instance.new("Attachment"), Instance.new("Attachment")
    a0.Position, a1.Position = V(0, 0.6, 0), V(0, -0.6, 0)
    a0.Parent, a1.Parent = c, c
    local t = Instance.new("Trail")
    t.Attachment0, t.Attachment1 = a0, a1
    t.Texture = TX.SOOT
    pcall(function() t.TextureMode = Enum.TextureMode.Wrap end)
    t.TextureLength = 4
    t.FaceCamera = true
    t.Lifetime = big and 3.4 or 2.6
    t.MinLength = 0.2
    t.WidthScale = seq(0, big and 1.3 or 0.9, 0.3, big and 2.6 or 1.8, 1, big and 5 or 3.6)
    t.Transparency = seq(0, 0.2, 0.08, 0.04, 0.6, 0.35, 1, 1)
    t.Color = cs(0, RGB(255, 236, 200), 0.04, RGB(34, 31, 28), 0.5, RGB(52, 48, 44), 1, RGB(92, 88, 84))   -- 头上一点被火照亮
    t.LightEmission, t.LightInfluence = 0, 1
    t.Parent = c
    stat.trails = (stat.trails or 0) + 1
    return t
  end
  G.wreckSmokeTrail = smokeTrail   -- 测试用
  local function chunks(p, R, k, n, owner, wheels)
    n = N(n, k)
    local room = cap(n + (wheels or 0))
    n = math.min(n, room)
    for i = 1, n do
      local big = i <= 2
      local s = big and V(2.2 + math.random() * 1.4, 0.25, 1.6 + math.random()) or V(0.5 + math.random() * 1.2, 0.18 + math.random() * 0.2, 0.4 + math.random() * 0.9)
      local c = Instance.new((math.random() < 0.35) and "WedgePart" or "Part")
      c.Size = s
      c.CFrame = CF(p + V((math.random() - 0.5) * 3, 1 + math.random() * 2, (math.random() - 0.5) * 3)) * CFrame.Angles(math.random() * 6.28, math.random() * 6.28, math.random() * 6.28)
      c.Material = Enum.Material.CorrodedMetal
      c.Color = RGB(46, 43, 40):Lerp(RGB(70, 62, 52), math.random())
      c.Anchored, c.CanCollide, c.CanQuery, c.CanTouch, c.CastShadow = false, true, false, false, true
      chunkGroup(c)
      pcall(function() c.CustomPhysicalProperties = PhysicalProperties.new(7.8, 0.6, 0.15) end)   -- 钢：重、不怎么弹（模拟器没有这个类型）
      c.Parent = G.fxFolder or workspace
      local vf = lift(c)
      -- 11-28 用户给了战雷殉爆的截图：烧着的碎块往四面八方甩出一道道弧、拖着浓黑的烟——飞得更高更远（往上 50～95、往旁边 18～55 格 / 秒）
      local ang = math.random() * 6.28
      local hs = 18 + math.random() * 37
      local lv = V(math.cos(ang) * hs, 50 + math.random() * 45, math.sin(ang) * hs)
      local av = V((math.random() - 0.5) * 18, (math.random() - 0.5) * 18, (math.random() - 0.5) * 18)
      pcall(function() c.AssemblyLinearVelocity = lv end)
      pcall(function() c.AssemblyAngularVelocity = av end)
      -- 拖着的火和黑烟：一多半烧着（原来大块 + 四分之一），每块一条烟带（Trail：连成一整道弧，不是一团团的烟——颗粒不算进预算）
      --   + 头上的火、稀稀的几团烟（落地以后接着冒一会儿）
      local f, sm, tr
      local burnT = 2.5 + math.random() * 3
      if big or math.random() < 0.55 then
        f = emitter(c, { tex = TX.FIRE, rate = big and 8 or 5, secs = burnT, life = { 0.25, 0.5 }, spd = { 0.5, 2 }, spread = 40, acc = V(0, 6, 0),
          size = seq(0, big and 2.2 or 1.4, 1, 0.3), tr = seq(0, 0.1, 1, 1), col = cs(0, FIRE_WHITE, 0.35, FIRE_PALE, 1, FIRE_DARK), le = 0.9, li = 0, bright = 3, prio = 2 })
        sm = emitter(c, { tex = TX.SOOT, rate = big and 2 or 1, secs = 11, life = { 1.4, 2.6 }, spd = { 0.5, 2 }, spread = 30, acc = V(0, 3, 0), drag = 0.8, wind = true,
          size = seq(0, big and 1.6 or 1, 1, big and 6 or 4), tr = seq(0, 0.1, 1, 1), col = cs(RGB(255, 255, 255)), rot = 20, prio = 2 })
        tr = smokeTrail(c, big)
      end
      table.insert(chunkList, { p = c, f = f, sm = sm, tr = tr, vf = vf, t0 = os.clock(), owner = owner, burnT = burnT })
      stat.chunks += 1
    end
    -- 负重轮（战雷 Drone Age：飞出去的零件里有主动轮、负重轮，拖着烟，落地还会滚）
    for _ = 1, math.min(wheels or 0, math.max(0, room - n)) do
      local w = Instance.new("Part")
      w.Shape = Enum.PartType.Cylinder
      w.Size = V(0.8, 2.2, 2.2)
      w.CFrame = CF(p + V((math.random() - 0.5) * 4, 0.5, (math.random() - 0.5) * 4)) * CFrame.Angles(0, math.random() * 6.28, 0)
      w.Material = Enum.Material.CorrodedMetal
      w.Color = RGB(40, 38, 36)
      w.Anchored, w.CanCollide, w.CanQuery, w.CanTouch, w.CastShadow = false, true, false, false, true
      chunkGroup(w)
      pcall(function() w.CustomPhysicalProperties = PhysicalProperties.new(7.8, 0.5, 0.25) end)
      w.Parent = G.fxFolder or workspace
      local vf = lift(w)
      local ang = math.random() * 6.28
      local hv = 20 + math.random() * 15
      pcall(function() w.AssemblyLinearVelocity = V(math.cos(ang) * hv, 22 + math.random() * 12, math.sin(ang) * hv) end)
      pcall(function() w.AssemblyAngularVelocity = V(0, 0, (math.random() - 0.5) * 30) end)
      local burnT = 3 + math.random() * 2
      local sm = emitter(w, { tex = TX.SOOT, rate = 4, secs = burnT + 1, life = { 1.6, 2.8 }, spd = { 0.5, 2 }, spread = 30, acc = V(0, 3, 0), drag = 0.8, wind = true,
        size = seq(0, 1.2, 1, 5), tr = seq(0, 0.1, 1, 1), col = cs(RGB(255, 255, 255)), rot = 20, prio = 2 })
      table.insert(chunkList, { p = w, sm = sm, vf = vf, t0 = os.clock(), owner = owner, burnT = burnT, wheel = true })
      stat.wheels += 1
    end
  end
  G.wreckChunks = function(p, R, k, n) return chunks(p, R, k, n, nil, 0) end   -- Fx.lua 的 boom（飞机、舰被打爆那一类）也用真碎块
  G.wreckChunkList = function() return chunkList end   -- 测试用
  G.wreckChunkMax = CHUNK_MAX
  -- 碎块每秒看 10 次：落地关恒力、4 秒后定住；火烧几秒灭、烟变稀；没落地的淡掉；残骸没了的收掉
  local chT = 0
  RunService.RenderStepped:Connect(function(dt)
    if #chunkList == 0 then return end
    chT += dt
    if chT < 0.1 then return end
    chT = 0
    local now = os.clock()
    for i = #chunkList, 1, -1 do
      local c = chunkList[i]
      local part = c.p
      if c.dead or not part.Parent then
        table.remove(chunkList, i)
      else
        local age = now - c.t0
        if c.f and age > c.burnT and c.f.Enabled then c.f.Enabled = false end
        if c.tr and c.tr.Enabled and (age > c.burnT + 1.5 or (c.land and now - c.land > 0.5)) then c.tr.Enabled = false end   -- 烧完 / 落地：不再拖新的烟带
        if c.sm and not c.smThin and age > c.burnT + 1 then
          c.smThin = true
          c.sm.Rate = c.wheel and 0 or math.min(c.sm.Rate, 1.5)
        end
        if c.sm and age > 11 and c.sm.Enabled then c.sm.Enabled = false end
        if not c.land then
          local pos = part.Position
          local vel = V()
          pcall(function() vel = part.AssemblyLinearVelocity end)
          -- 落在房顶、车壳上的（不在地面）：慢下来半秒也算落地
          if age > 1 and vel.Magnitude < 3 then c.slow = (c.slow or 0) + 0.1 else c.slow = 0 end
          if (age > 0.3 and pos.Y < groundAt(pos) + 2.5 and vel.Y < 2) or c.slow >= 0.5 then
            c.land = now
            if c.vf then c.vf.Enabled = false end
            if Map.height(pos.X, pos.Z) < -0.5 then   -- 掉进海里：沉了
              killChunk(c)
            end
          elseif age > 9 and not c.fade then   -- 一直没落地（卡在半空）：淡掉
            c.fade = true
            TweenService:Create(part, TweenInfo.new(2.5), { Transparency = 1 }):Play()
            Debris:AddItem(part, 2.6)
          end
        elseif not c.rest and now - c.land > 4 then
          local sp = 0
          pcall(function() sp = part.AssemblyLinearVelocity.Magnitude end)
          if sp < 4 or now - c.land > 7 then
            c.rest = now
            part.Anchored = true
            part.CanCollide = false
            if c.vf then c.vf:Destroy() c.vf = nil end
            stat.anchored += 1
            if not c.owner then   -- 没有残骸跟着的（飞机、舰的碎块）：再留几秒淡掉
              task.delay(4, function()
                if part.Parent then TweenService:Create(part, TweenInfo.new(2.5), { Transparency = 1 }):Play() end
              end)
              Debris:AddItem(part, 6.6)
            end
          end
        elseif c.rest and c.owner and not c.owner.Parent then   -- 残骸没了：一起收掉
          killChunk(c)
        end
      end
    end
  end)

  -- ⑤ 车里剩下的弹一发一发殉爆（越来越稀）；舱口往外蹿火（前几秒）
  local function cookOff(v, base, L, W, H, k, d)
    local n = N(9, math.min(1, k + 0.2))
    local t = 0.35
    for i = 1, n do
      t += 0.25 + math.random() * 0.55 * (1 + i / n)
      task.delay(t, function()
        if not (v.M and v.M.model and v.M.model.Parent) then return end
        local q = base.Position + base.RightVector * ((math.random() - 0.5) * W * 0.6) + base.LookVector * ((math.random() - 0.5) * L * 0.6) + V(0, H * (0.75 + math.random() * 0.35), 0)
        local bigOne = (i % 4 == 0)
        local var = bigOne and "B" or nil
        if G.flash then G.flash(q, RGB(255, 186, 110), bigOne and 34 or 20, bigOne and 7 or 4, 0.18, DAY) end
        VL.emit("wPopFlash", 1, CF(q), 1, var)
        VL.emit("wPopSpark", 1, upCF(q, UP), bigOne and 22 or 10, var)
        VL.emit("wPopFire", 1, upCF(q, UP), bigOne and 9 or 5, var)
        VL.emit("wPopSmoke", 1, upCF(q, UP), bigOne and 5 or 3, var)
        pop(q, d, bigOne)
        stat.pops += 1
      end)
    end
  end
  local function hatchJet(base, H, secs, strong)
    local p = base.Position + V(0, H + 0.5, 0)
    local h = holder(CFrame.lookAt(p, p + V(0, 1, 0)))
    local f = emitter(h, { tex = TX.FIRE, rate = strong and 26 or 16, secs = secs + secs * 1.2 * 0.3, life = { 0.45, 0.9 }, spd = { strong and 16 or 9, strong and 34 or 18 }, spread = 14,
      dir = Enum.NormalId.Front, drag = 1.5, acc = V(0, 8, 0), size = seq(0, 2.6, 0.4, strong and 6 or 4, 1, 1.5), tr = seq(0, 0.05, 0.7, 0.35, 1, 1),
      col = cs(0, FIRE_WHITE, 0.3, FIRE_PALE, 0.6, FIRE_MID, 1, FIRE_DARK), le = 0.95, li = 0, bright = 3.5, rot = 80, z = 2, prio = 1 })
    stat.jets += 1
    task.delay(secs, function() f.Rate = f.Rate * 0.3 end)
    task.delay(secs * 2.2, function() f.Enabled = false end)
    Debris:AddItem(h, secs * 2.2 + 1.2)
  end

  -- ⑥ 车身的大火、烟柱：View.lua 的 fire / black 发射器（平时关着）调粗、调黑、升高、顺风；fire 的贴图本身暗：LightInfluence 0 + Brightness 3；
  --   black 换成深灰的烟贴图、受光照、跟着风。
  --   镜头 60 格内黑烟小一号（审查 7：原来是改 Size——Size 是整条曲线，一改连已经在飘的四十来颗一起缩放，走过那条线整根烟柱一下变小）：
  --   两个发射器，M.black 远处那根、M.blackN 小一号的那根，View.lua 按远近换着喷（G.wreckBlackRate：一个给 Rate、另一个 0）
  --   每辆车稳定时（View.lua 的节奏，用户 11-28「然后有浓烈的烟雾我持续冒」）：前 60 秒 fire 30 + black 8，60 秒后 14 + 7，150 秒以后 5 + 5 一直冒到残骸没了；
  --   同时冒浓烟的最多 10 处，再早的 black 2.5（还是一根烟柱）
  local function blackRate(M, r, near)
    if r ~= nil then M.blackRate = r end
    if near ~= nil then M.blackIsNear = near end
    local rr = M.blackRate or 0
    local b, bn = M.black, M.blackN
    local useN = M.blackIsNear == true and bn ~= nil
    if b and b.Rate ~= (useN and 0 or rr) then b.Rate = useN and 0 or rr end
    if bn and bn.Rate ~= (useN and rr or 0) then bn.Rate = useN and rr or 0 end
  end
  G.wreckBlackRate = blackRate
  local function prepBurn(M)
    local f, b = M.fire, M.black
    if f and not M.burnPrep then
      f.LightEmission, f.LightInfluence, f.Brightness = 0.9, 0, 3
    end
    if b and not M.burnPrep then
      b.Texture = TX.SOOT
      b.LightInfluence = 1
      b.Color = cs(RGB(255, 255, 255))
      b.Drag = 0.35
      pcall(function() b.WindAffectsDrag = true end)
      local ok, bn = pcall(function() return b:Clone() end)   -- 近处那根（小一号）：同一个零件上，平时不喷
      if ok and bn then
        bn.Name = "BlackNear"
        bn.Rate = 0
        bn.Parent = b.Parent
        M.blackN = bn
      end
    end
    M.burnPrep = true
  end
  G.wreckPrepBurn = prepBurn
  local function heavyBurn(M, strong)
    prepBurn(M)
    local f, b, bn = M.fire, M.black, M.blackN
    if f then
      f.Size = seq(0, strong and 6 or 4.5, 0.4, strong and 9 or 7, 1, 2)
      f.Lifetime = NumberRange.new(0.5, 1.0)
      f.Speed = NumberRange.new(5, 11)
      f.SpreadAngle = Vector2.new(25, 25)
      f.Acceleration = V(0, 7, 0)
      f.Transparency = seq(0, 0.05, 0.6, 0.35, 1, 1)
      f.Color = cs(0, FIRE_WHITE, 0.25, FIRE_PALE, 0.55, FIRE_MID, 1, FIRE_DARK)
      f.RotSpeed = NumberRange.new(-60, 60)
      f.Rotation = NumberRange.new(0, 360)
    end
    local acc = V(0, 2.4, 0)
    if VL.wind().Magnitude < 0.5 then acc = V(2.6, 2.4, 1.2) end   -- 地图没设风：照旧写死顺风歪过去
    -- 烟柱（11-28 用户「浓烈的烟雾我持续冒」）：粗一点、高一点（活 5.5～8.5 秒、往上冲得快一点，四五十米高的一根），越往上越大越淡、顺风歪
    local s0, s1, s2 = strong and 7 or 5, strong and 16 or 12, strong and 42 or 31   -- 11-28 晚：最上面 50 → 42 格（卡：烟团越大要画的像素越多）
    for _, e in ipairs({ b or false, bn or false }) do
      if e then
        local kk = (e == bn) and 0.7 or 1
        e.Lifetime = NumberRange.new(5.5, 8.5)
        e.Speed = NumberRange.new(9, 15)
        e.SpreadAngle = Vector2.new(12, 12)
        e.Acceleration = acc
        e.Size = seq(0, s0 * kk, 0.25, s1 * kk, 1, s2 * kk)
        e.Transparency = seq(0, 0.05, 0.3, 0.1, 0.75, 0.5, 1, 1)
        e.RotSpeed = NumberRange.new(-12, 12)
        e.Rotation = NumberRange.new(0, 360)
      end
    end
    if b then
      local r = b.Rate + ((bn and bn.Rate) or 0)
      local BR = G.wreckBurnRates   -- 殉爆、烧毁的：烟柱至少是头一分钟那一档（转盘车先烧那几秒是 6）
      if strong and BR then r = math.max(r, BR.black[1]) end
      blackRate(M, r)
    end
  end

  -- 样子 A / B / C：按车的编号定（大家看到的一样）
  local function styleOf(v)
    -- 编号先按字符串散列（同 WtDamage.cookSecs），再乘黄金分割常数取小数：相邻的编号也分得开，各个客户端算出来一样
    local h = 0
    for ch in tostring(v.id or ""):gmatch(".") do h = (h * 31 + string.byte(ch)) % 1000003 end
    local x = ((h * 2654435761) % 4294967296) / 4294967296
    return (x < 0.5 and "A") or (x < 0.78 and "B") or "C"
  end
  G.wreckStyleOf = styleOf

  -- 转盘车先烧的那两个舱口：炸开以后火小到四分之一、烟 2 颗每秒（只做一次）
  local function cookJetsDown(jets)
    if not jets or jets.done then return end
    jets.done = true
    for _, j in ipairs(jets) do
      if j.f.Parent then
        j.f.Rate = j.f.Rate * 0.25
        j.s.Rate = 2
      end
    end
  end
  -- 转盘车殉爆前先烧（用户 11-26「部分弹药架在下面的坦克被干掉炮塔飞起来吧 然后要先着火再飞」）：发射药一着火，
  --   车长、炮长两个舱口往上喷火（越烧越旺、越喷越高），里面噼啪乱响、火星乱溅，火光一闪一闪，黑烟往上冒；
  --   secs 秒后 View.lua 掀炮塔、G.wreckFx 画大火球（同一刻）——炸开那一刻舱口的火小到四分之一接着烧（这辆车不再另加 hatchJet）
  function G.wreckCook(v, base, secs)
    local d0 = v.def or {}
    local M = v.M or {}
    if not base then return end
    local L, W, H = d0.L or 20, d0.W or 10, d0.hullH or (d0.H or 8) * 0.6
    local tp = d0.turret and d0.turret.pivot
    local top = base.Position + V(0, (tp and tp.Y or H) + (d0.turret and 2.2 or 0.6), 0)
    local p = base.Position + V(0, H * 0.7, 0)
    local k, d = lod(p)
    if d > 4000 then return end   -- 太远：不接手（没设 v.cookJets）——View.lua 照别的残骸马上把车身的火、黑烟烧起来
    stat.cook = (stat.cook or 0) + 1
    prepBurn(M)
    v.cookJets = true
    -- 两个舱口：炮塔顶左右各一个（按车宽）
    local jets = {}
    for _, sx in ipairs({ -0.22, 0.2 }) do
      local q = top + base.RightVector * (W * sx) - base.LookVector * (L * 0.02)
      local h = holder(CFrame.lookAt(q, q + V(0, 1, 0)))
      local f = emitter(h, { tex = TX.FIRE, rate = 10, secs = secs + 5, life = { 0.35, 0.7 }, spd = { 6, 12 }, spread = 10, dir = Enum.NormalId.Front,
        drag = 1.4, acc = V(0, 8, 0), size = seq(0, 1.6, 0.4, 3, 1, 1), tr = seq(0, 0.05, 0.7, 0.35, 1, 1),
        col = cs(0, FIRE_WHITE, 0.3, FIRE_PALE, 0.6, FIRE_MID, 1, FIRE_DARK), le = 0.95, li = 0, bright = 3.5, rot = 80, z = 2, prio = 1 })
      local s2 = emitter(h, { tex = TX.SOOT, rate = 3, secs = secs + 5, life = { 2.5, 4 }, spd = { 5, 9 }, spread = 14, drag = 1, acc = V(0, 4, 0), wind = true,
        size = seq(0, 2, 1, 10), tr = seq(0, 0.1, 1, 1), col = cs(RGB(255, 255, 255)), rot = 15, prio = 2 })
      table.insert(jets, { h = h, f = f, s = s2, r = -1 })
      Debris:AddItem(h, secs + 5)
    end
    v.cookJetList = jets   -- 炸开那一刻（G.wreckFx）马上小下去，不等下面那圈 0.25 秒一看
    -- 越烧越旺：喷得越来越高、越来越密（每 0.25 秒看一次、变化过一成才写；原来每 0.1 秒改一遍）
    local t0 = os.clock()
    VL.rateK(2 * 30, secs, 0.7, 1)   -- 越烧越旺那段多出来的（平均每个舱口多 30 颗 / 秒）也记进全局预算
    task.spawn(function()
      while os.clock() - t0 < secs and not jets.done do
        local q = math.clamp((os.clock() - t0) / secs, 0, 1)
        for _, j in ipairs(jets) do
          local r = 10 + 46 * q
          if j.f.Parent and math.abs(r - j.r) > j.r * 0.1 then
            j.r = r
            j.f.Rate = r
            j.f.Speed = NumberRange.new(6 + 18 * q, 12 + 30 * q)
            j.f.Size = seq(0, 1.6 + 1.6 * q, 0.4, 3 + 4 * q, 1, 1.4)
            j.s.Rate = 3 + 6 * q
          end
        end
        task.wait(0.25)
      end
      cookJetsDown(jets)   -- 炸开那一下之后火小下去（大火由 heavyBurn 接着烧）；G.wreckFx 那边先到就已经小下去了
    end)
    -- 里面噼啪：零星的小殉爆（火星、闪一下、一声脆响），越到后面越密
    local t = 0.15
    while t < secs - 0.15 do
      local tt = t
      task.delay(tt, function()
        if not (M.model and M.model.Parent) then return end
        local q = top + base.RightVector * ((math.random() - 0.5) * W * 0.5) + V(0, -1 + math.random(), 0)
        VL.emit("wCrackle", 1, upCF(q, UP), N(14, k))
        if G.flash then G.flash(q, RGB(255, 170, 90), 18, 3, 0.12) end
        pop(q, d, false)
      end)
      t += 0.45 - 0.25 * (t / secs) + math.random() * 0.2
    end
    -- 车身也烧起来（View.lua 的 fire / black：先小、炸开以后 heavyBurn 调大）
    if M.fire then M.fire.Rate = 14 end
    if M.black then blackRate(M, 6) end
  end

  local liveBig = 0
  -- v：View.lua 的车（v.M 模型、v.def 型号）；why：服务器的 WtWhy（"ammo" 殉爆、"fire" 烧毁、"crew" 乘员打光、nil 老式血量打光）；base：车底的 CFrame
  function G.wreckFx(v, why, base)
    local d0 = v.def or {}
    local M = v.M or {}
    if not base then return end
    local L, W, H = d0.L or 20, d0.W or 10, d0.hullH or (d0.H or 8) * 0.6
    local p = base.Position + V(0, H * 0.7, 0)
    local k, d, tl = lod(p)
    if d > 6000 then return end
    local ammo = why == "ammo" or (why == nil and d0.cat == "tank")
    if ammo then
      -- 火球半径（格）：用户 11-28 给了战雷殉爆的截图（离得近时火球占满大半个屏幕）——原来车长的 0.55 倍（主战坦克 11 格、约 4 米）太小，
      --   改成约一个车长（主战坦克 20 格上下、约 7 米）；各层的速度、大小都按它放大，颗数不变（第一秒的预算照旧）
      local R = math.clamp(math.max(L, W) * 1.0, 13, 28)
      stat.lastR = R
      local style = G.wreckStyleOverride or styleOf(v)
      stat.big += 1
      stat.style[style] = (stat.style[style] or 0) + 1
      stat.last = style
      flashAt(p, R, d)
      if tl <= 3 then fireball(p, R, k, style, L) end
      if tl <= 2 then groundRing(p, R, k) end
      thump(p, d)
      if d < 1500 and liveBig < 3 then
        liveBig += 1
        task.delay(16, function() liveBig -= 1 end)
        chunks(p, R, k, 14, M.model, (d0.arch == "tracked") and (1 + ((style == "C") and 1 or 0)) or 0)
      end
      if v.cookJets then cookJetsDown(v.cookJetList) else hatchJet(base, H, 3.5, true) end   -- 转盘车先烧的那两个舱口还在喷：小下去接着喷，不另加
      cookOff(v, base, L, W, H, k, d)
      if G.shake then
        local shR = 260
        if d < shR then G.shake(0.9 * (1 - d / shR)) end
      end
      heavyBurn(M, true)
      -- 车身大火先小一点（第一秒火球、碎块、舱口火柱都在喷），两秒半以后照 View.lua 的节奏烧到头一分钟那一档（G.wreckBurnRates.fire[1]）
      if M.fire then
        M.fire.Rate = 10
        task.delay(2.5, function()
          local full = (G.wreckBurnRates and G.wreckBurnRates.fire[1]) or 26
          if M.fire and M.fire.Parent and not v.burnt1 and M.fire.Rate < full then M.fire.Rate = full end
        end)
      end
    elseif why == "fire" then
      local q = base.Position - base.LookVector * L * 0.3 + V(0, H, 0)   -- 发动机舱在后面
      VL.emit("wFireBurst", 1, upCF(q, UP), N(18, k))
      VL.emit("wFireSmoke", 1, upCF(q, UP), N(10, k))
      if G.flash then G.flash(q, RGB(255, 170, 90), 30, 5, 0.4, DAY) end
      hatchJet(base, H, 2.5, false)
      heavyBurn(M, true)
    else   -- 乘员打光：车停下、一缕黑烟
      VL.emit("wCrewSmoke", 1, upCF(p, UP), N(6, k))
      heavyBurn(M, false)
    end
    -- 地面烧焦（殉爆、烧毁的）：跟着残骸的模型，残骸没了一起没
    if (ammo or why == "fire") and M.model then
      local ok = pcall(scorch, base, L, W, M.model)
      if not ok then scorch(base, L, W) end
    end
  end

  -- 预建（审查 12）：殉爆、掀炮塔那几层进局时分几帧建好（11-28 火球放大以后主战坦克的半径 17～24 格：q 1.2 / 1.44 两档），第一次殉爆不用现建；
  --   贴地那圈土按地面分（土、草、沙、石；雪山加雪）——地图进服以后才投出来的，换图（G.onMap）时补排新地面的（同 Fx.lua）
  do
    local list = {}
    local warmed = {}
    local function dustFor(code)
      if warmed[code] then return end
      warmed[code] = true
      for _, q in ipairs({ 1.2, 1.44 }) do list[#list + 1] = { "wDust", q, code } end
      list[#list + 1] = { "tDust", 1, code }
    end
    local function mapCodes() return Map.NAME == "snow" and { "d", "v", "r", "i" } or { "d", "v", "n", "r" } end
    for _, q in ipairs({ 1.2, 1.44 }) do
      for _, nm in ipairs({ "wFlash", "wHeart", "wCore", "wFire", "wSoot", "wEdge", "wPillar", "wShock" }) do list[#list + 1] = { nm, q } end
    end
    list[#list + 1] = { "wFlash", 1 }   -- 连爆后几下的小闪光（q × 0.7）
    for _, nm in ipairs({ "wSpark", "wCrackle", "wFireBurst", "wFireSmoke", "wCrewSmoke", "tFire", "tSpark", "tSmoke", "tRing", "tLandSpark" }) do list[#list + 1] = { nm, 1 } end
    for _, nm in ipairs({ "wPopFlash", "wPopSpark", "wPopFire", "wPopSmoke" }) do
      list[#list + 1] = { nm, 1 }
      list[#list + 1] = { nm, 1, "B" }
    end
    for _, code in ipairs(mapCodes()) do dustFor(code) end
    VL.prewarmLater(list)
    if G.onMap then
      G.onMap(function()
        list = {}
        for _, code in ipairs(mapCodes()) do dustFor(code) end
        if #list > 0 then VL.prewarmLater(list) end
      end)
    end
  end
end

return WreckFx
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="283">
          <Properties>
            <string name="Name">WsArms</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——整备的「挂载」页（飞机、直升机；外壳是 Workshop.lua，零件是 WsKit.lua）
--   用户 11-27：「整个给载具配置武器的系统 做的很粗糙 我需要非常艺术经验的效果 参考战雷」——照同类写实军事游戏的做法（按挂点一个个配、换了 3D 马上跟着变、
--   写清楚正在改的是哪一套、重量和阻力数字比条重要），用我们自己的界面美术（docs/style.md；卡片和战斗里的弹药栏一套画法）：
--   舞台就是机库的停机坪（HangarStage：真光照、Highlight 描轮廓），起落架放着、弹舱打开、直升机旋翼停着；界面压在上面：
--   · 底部条：航炮（固定）│ 挂点卡（卡组的中点对准 3D 区的中点；左右对称时一对合成一张；顺序照全景画面上从左到右——全景从左前方看，右翼在画面左边，
--     卡片和机身上的编号一一对得上）│ 干扰弹（没研究锁住，点了去改装页）。卡组上面一行：名牌（鼠标挂着 / 选着的挂点：全称、类别、导引）、左右对称勾选框
--   · 机身上每个挂点：一个点、只走横竖的引线、一个键位框编号（每帧按 HangarStage.toScreen 摆，排在机轮着地线下面一行、互相不压）；
--     全景时只给镜头这一边的写编号，另一边只画淡点（悬停 / 选中一对时另一边那个也写，虚线引线 = 在机身后面）；选中的琥珀、后面跟名字；
--     镜头动着（飞向挂点、拖着转）时 0.12 秒淡掉，停稳了淡回来；落在两栏、资料卡、底部条底下的不画
--   · 左栏全景：方案（这一型的预设 + 三个「我的方案」）、状态行（照哪套改过 · 撤销）、挂载清单、提示；选了挂点：方案收成一行「‹ 方案 · 对地（已改 2）」，
--     下面挂点标题「挂点 3、8」（粗 17）+「中段 · 现在：霹雳-15 ×2」、武器卡（整张整张地放，放不下写「还有 N 种」；打开时卷到装着的那张）
--     鼠标挂在一张上：3D 先换上（停 0.12 秒才换，扫过去不来回重搭）、右栏琥珀的变化、旁边浮出资料卡（3D 小视口里这枚弹慢慢滚着转、四个关键数和已装的比）；
--     点一下装上（3D 里从挂架下滑上去、琥珀轮廓亮一下淡掉）；左右对称时一对一起换（同 Hangar.lua）。手机：第一次点是预览，再点一下才装上
--   · 右栏：当前挂载的外挂重量、阻力（ΔCD0）、起飞重量；性能比空挂（极速、推重比、持续转弯、爬升、翼载；悬停时换成「现在 → 换上」，红绿只说这次换上会怎样）；内油四档——
--     全部用飞行物理同一套算（FlightModel.loadout / perf：开飞机 Fly.lua 用的就是 loadout），不另编数；外挂重量上限仓库里没有数据，先不画上限。
--     直升机没有喷气机的飞行物理：只写重量（Fly.lua 直升机用的 AD.heavy）、续航（AD.fuelMin）、极速（副油箱的阻力，同 Fly.lua 的式子）
--   · 镜头：全景从左前下方看（按飞机大小、两栏中间那一段算距离；不自己转：转到正侧面构图就坏了），点一个挂点飞到它那一侧（偏航 ±125°，弹舱从下往上看）
--   改动即时存（Tech.lua treeLoad，不弹提示；车名右边的保存状态等服务器回了写「已保存」）、能撤销（最近 10 步：左栏「撤销」、Ctrl+Z）；
--   出击、试驾都按存的；「我的方案」存在 treeLoadSet（有内容的右键 / 长按：覆盖、清空）
local RS = game:GetService("ReplicatedStorage")

local WsArms = {}

function WsArms.new(G, ws)
  local K = ws.K
  local TH = K.TH
  local C, A, S = TH.C, TH.A, TH.S
  local AD = require(RS:WaitForChild("AirDefs"))
  local WMd = require(RS:WaitForChild("WtMods"))
  local FMok, FM = pcall(function() return require(RS:WaitForChild("FlightModel", 10)) end)
  if not FMok then FM = nil end
  local T = ws.T
  local LAY = ws.LAY
  local compact = ws.compact
  local UD2, V2, V3 = UDim2.new, Vector2.new, Vector3.new
  local RIGHT, CENTER = Enum.TextXAlignment.Right, Enum.TextXAlignment.Center

  local P = { name = "arms" }
  local st = nil   -- 打开着的这一架（见 P.open）

  ---------------------------------------------------------------- 字

  -- 武器的短名（卡片上）：aws.<型号>，没有就用全名
  local function wname(wid)
    if not wid then return T("ws.none") end
    local s = T("aws." .. wid)
    if s == "aws." .. wid then s = T("aw." .. wid) end
    if s == "aw." .. wid then s = string.upper(wid) end
    return s
  end
  local function catOf(w)
    if w.kind == "tank" then return "tank" end
    if w.arm then return "arm" end
    if w.kind == "bomb" then return w.guided and "gbomb" or "bomb" end
    return w.kind
  end
  -- 「空空导弹 · 主动雷达」（长）/「空空 · 雷达」（短）
  local function subOf(w, short)
    local c = T((short and "wcs." or "wcat.") .. catOf(w))
    if w.kind == "tank" or w.kind == "rkt" or w.kind == "gun" then return c end
    local g = w.guide or "none"
    return c .. " · " .. T((short and "gds." or "guide.") .. g)
  end
  local function km(v) return string.format("%.1f", (v or 0) / AD.M / 1000) end
  local function f1(v) return string.format("%.1f", v) end
  local function f2(v) return string.format("%.2f", v) end
  -- 武器卡第三行的三列：{ 射程 { 数, 单位 }, 锁定 / 发数 { 数, 单位 }, 每个挂点几枚 }（单位淡）
  local function colsOf(s, wid)
    local w = AD.W[wid]
    if not w then return {} end
    local n = AD.count(s, wid)
    local cnt = (n > 1) and ("×" .. n) or ""
    if w.kind == "tank" then return { { "+" .. math.floor(w.fuel * n * 100 + 0.5) .. "%", " " .. T("ws.unitFuel") }, nil, cnt } end
    if w.kind == "rkt" then return { w.range and { km(w.range), " km" } or nil, { tostring(w.tubes or n), " " .. T("ws.unitRk") }, "" } end
    if w.kind == "bomb" then
      local m = FM and FM.storeMass and FM.storeMass(w, AD.M) or nil
      return { m and { K.int(m), " kg" } or nil, nil, cnt }
    end
    return { w.range and { km(w.range), " km" } or nil, (w.lockTime and w.lockTime > 0) and { f1(w.lockTime), " s" } or nil, cnt }
  end
  -- 挂点在哪（翼尖 / 外侧 / 中段 / 内侧 / 机腹……）：按挂点名字；弹舱按 bay
  local POS = { tip = "tip", outer = "outer", wingO = "outer", pylO = "outer", railO = "outer", mid = "mid", pylM = "mid",
    inner = "inner", wingI = "inner", pylI = "inner", railI = "inner", wing = "wing", pylon = "wing", gloveO = "glove", gloveI = "glove",
    ctr = "ctr", body = "body", duct = "duct", stub = "stub", tunF = "tun", tunA = "tun", fusF = "fus", fusA = "fus" }
  local function posName(s)
    if s.bay then return T((s.bay == "main") and "ws.pos.bay" or "ws.pos.bayS") end
    return T("ws.pos." .. (POS[s.name] or "gen"))
  end

  ---------------------------------------------------------------- 挂载、性能

  local function sigOf(load)
    local s = {}
    for i = 1, #(st.d.st or {}) do s[i] = (load and load[i]) or "" end
    return table.concat(s, ",")
  end
  local function sameOn(d, a, b)
    for i = 1, #(d.st or {}) do if ((a and a[i]) or false) ~= ((b and b[i]) or false) then return false end end
    return true
  end
  local function same(a, b) return sameOn(st.d, a, b) end
  -- 直升机挂副油箱以后的极速（格 / 秒）：同 Fly.lua 直升机的式子——桨盘前倾到底时水平拉力 GS·tan(最大倾角) = 0.05·v + cq·(1 + 阻力)·v²，
  --   cq 按「不挂副油箱正好飞到型号表的 vMax」定
  local function heliTop(d, drag)
    local GS = AD.GRAV or 27.5
    local C0 = GS * math.tan(math.rad(d.tilt or 22))
    local vM = d.vMax or 90
    local cq0 = math.max(1e-5, (C0 - 0.05 * vM) / (vM * vM))
    local cq = cq0 * (1 + (drag or 0))
    return (-0.05 + math.sqrt(0.0025 + 4 * cq * C0)) / (2 * cq)
  end
  -- 一套挂载的数（按挂载 + 内油记着：同一套不重算）
  local function perfOf(load, fuel)
    local key = sigOf(load) .. "|" .. string.format("%.2f", fuel)
    local c = st.perf[key]
    if c then return c end
    local Lo = { ext = 0, xf = 0, dS = 0 }
    if FM and FM.loadout then
      local ok, r = pcall(FM.loadout, st.d, load, fuel, { key = st.key, AD = AD })
      if ok and r then Lo = r end
    end
    c = { Lo = Lo }
    if st.D and Lo.m and FM and FM.perf then
      local ok, p = pcall(FM.perf, st.D, Lo.m, Lo.dCD0)
      if ok then c.p = p end
    end
    local tf, drag = AD.tankFuel(st.d, load)
    c.tf, c.drag = tf, drag
    c.heavy = AD.heavy(st.d, fuel, tf)
    c.min = AD.fuelMin(st.d, fuel + tf)
    c.minX = (tf > 0) and AD.fuelMin(st.d, tf) or 0
    if st.d.kind == "heli" then c.vh = heliTop(st.d, drag) end
    st.perf[key] = c
    return c
  end
  G.wsPerfOf = function(load, fuel) return st and perfOf(load, fuel) end   -- 测试用：界面上的数按这个写

  ---------------------------------------------------------------- 卡片分组、编号

  -- 全景的镜头（左前下方）：卡片按挂点在这个画面上从左到右的位置排（屏幕往右 = 机体的 (cos y, 0, −sin y) 方向）
  local OV_YAW, OV_PITCH = math.rad(-150), -0.06
  local function ovX(p) return p.X * math.cos(OV_YAW) - p.Z * math.sin(OV_YAW) end
  -- 挂点编号：照真飞机从左翼尖到右翼尖 1、2、3……（同一个横坐标的前面的先）
  local function numberStations()
    local d = st.d
    local order = {}
    for i in ipairs(d.st or {}) do order[#order + 1] = i end
    table.sort(order, function(a, b)
      local pa, pb = d.st[a].pos, d.st[b].pos
      if math.abs(pa.X - pb.X) > 1e-3 then return pa.X < pb.X end
      return pa.Z < pb.Z
    end)
    st.num = {}
    for k, i in ipairs(order) do st.num[i] = k end
  end
  -- 底部的卡：左右对称时同名的一对合成一张；不对称时一个挂点一张。顺序：全景画面上从左到右（一对按镜头这一边那个算），和机身上的编号对得上
  local function makeGroups()
    local d = st.d
    local out, byName = {}, {}
    for i, s in ipairs(d.st or {}) do
      local g = st.sym and byName[s.name] or nil
      if not g then
        g = { st = {}, name = s.name }
        if st.sym then byName[s.name] = g end
        table.insert(out, g)
      end
      table.insert(g.st, i)
    end
    for _, g in ipairs(out) do
      table.sort(g.st, function(a, b) return st.num[a] < st.num[b] end)
      local rep = g.st[1]   -- 全景镜头那一边（左翼，X 小）的那个
      for _, i in ipairs(g.st) do if d.st[i].pos.X < d.st[rep].pos.X then rep = i end end
      g.rep = rep
      g.x, g.bay = ovX(d.st[rep].pos), d.st[rep].bay
      local nums = {}
      for _, i in ipairs(g.st) do table.insert(nums, tostring(st.num[i])) end
      g.nums = nums
      g.label = table.concat(nums, T("ws.sep"))   -- 「3、8」（编号里不用「·」：等宽小字里像小数点）
    end
    table.sort(out, function(a, b)
      if math.abs(a.x - b.x) > 1e-3 then return a.x < b.x end
      return st.num[a.st[1]] < st.num[b.st[1]]
    end)
    st.cards = out
  end
  local function cardOfStation(i)
    for ci, g in ipairs(st.cards or {}) do
      for _, j in ipairs(g.st) do if j == i then return ci end end
    end
    return nil
  end
  -- 这张卡现在挂的（一对里两边不一样时 mixed）
  local function cardWeapon(g, load)
    load = load or st.load
    local w0 = load[g.st[1]] or false
    local mixed = false
    for _, i in ipairs(g.st) do if (load[i] or false) ~= w0 then mixed = true end end
    return w0, mixed
  end
  local function previewLoad()
    if not (st.sel and st.hoverOpt ~= nil) then return nil end
    local g = st.cards[st.sel]
    local l = table.clone(st.load)
    for _, j in ipairs(g.st) do
      local wid = st.hoverOpt
      l[j] = (wid and table.find(st.d.st[j].opts, wid)) and wid or false
    end
    return l
  end

  ---------------------------------------------------------------- 3D：挂点的位置、高亮、装上的动效、弹舱

  local Stage = ws.Stage
  -- 每个挂点在飞机里的位置（模型坐标）：挂着弹的用弹的中心（零件的平均位置），空着的用挂架（AirModels 记的 stPos）
  local function computeAnchors(A0)
    st.anchor = {}
    local M = A0 and A0.M
    for i, s in ipairs(st.d.st or {}) do
      local p = nil
      local grp = st.groups3d and st.groups3d[i]
      if grp and A0 then
        local sum, n = V3(), 0
        for _, x in ipairs(grp:GetChildren()) do
          if x:IsA("BasePart") then
            sum += A0.cf:PointToObjectSpace(x.Position)
            n += 1
          end
        end
        if n > 0 then p = sum / n end
      end
      st.anchor[i] = p or (M and M.stPos and M.stPos[i]) or s.pos
    end
  end
  -- 挂点上的弹的零件收进一个模型（Station<i>）：一个 Highlight 罩住一整个挂点
  local function groupParts(A0)
    st.groups3d = {}
    local M = A0 and A0.M
    if not M or not M.stores then return end
    for i, list in pairs(M.stores) do
      if #list > 0 then
        local m = M.model:FindFirstChild("Station" .. i) or Instance.new("Model")
        m.Name = "Station" .. i
        m.Parent = M.model
        for _, it in ipairs(list) do
          if it.p then it.p.Parent = m end
        end
        st.groups3d[i] = m
      end
    end
  end
  local HL_SEL = { fill = C.WARN, fillT = 0.85, line = C.WARN, lineT = 0 }
  local HL_HOV = { fill = C.TEXT, fillT = 0.94, line = C.TEXT, lineT = 0.55 }
  local function applyHL()
    if not Stage then return end
    Stage.unhighlight()
    st.hlSel = {}
    local function hl(ci, o, keep)
      local g = ci and st.cards[ci]
      if not g then return end
      for _, i in ipairs(g.st) do
        local grp = st.groups3d and st.groups3d[i]
        if grp and grp.Parent then
          local h = Stage.highlight(grp, o)
          if h and keep then table.insert(keep, h) end
        end
      end
    end
    if st.sel then hl(st.sel, HL_SEL, st.hlSel) end
    if st.hov and st.hov ~= st.sel then hl(st.hov, HL_HOV) end
  end
  -- 装上：新挂的弹从挂架下 1.2 格滑上去（带一点回弹），选中的琥珀轮廓亮一下、0.5 秒淡回平时的样子
  local function mountAnim(stations)
    local A0 = G.hangarAir and G.hangarAir()
    if not A0 or not stations then return end
    local parts = {}
    for _, i in ipairs(stations) do
      local grp = st.groups3d and st.groups3d[i]
      if grp then
        for _, p in ipairs(grp:GetChildren()) do
          if p:IsA("BasePart") then table.insert(parts, { p = p, cf = p.CFrame }) end
        end
      end
    end
    if #parts > 0 then
      local down = A0.cf.UpVector * -1.2
      K.anim("wsMount", TH.T.mount, "back", function(e)
        for _, x in ipairs(parts) do
          if x.p.Parent then x.p.CFrame = x.cf + down * (1 - e) end
        end
      end)
    end
    local hs = st.hlSel or {}
    if #hs > 0 then
      K.anim("wsFlash", 0.5, "out", function(e)
        for _, h in ipairs(hs) do
          pcall(function() h.h.FillTransparency = 0.5 + (HL_SEL.fillT - 0.5) * e end)
        end
      end)
    end
  end
  -- 换上（或者还原）3D 里挂的：TechUI 换模型（同一架、同一套搭过的直接换回来；镜头不动），搭好回调 onAir
  local function show3d(load)
    if G.hangarAirLoad then return G.hangarAirLoad(load) end
    return false
  end
  local function onAir(A0)
    if not st or not A0 or A0.key ~= st.key then return end
    groupParts(A0)
    computeAnchors(A0)
    applyHL()
    if st.pendingMount then
      local m = st.pendingMount
      st.pendingMount = nil
      mountAnim(m)
    end
  end
  local function poseBay(k)
    if G.hangarAirPose then G.hangarAirPose({ gear = 1, bay = k, bayS = k, thr = 0 }) end
  end

  ---------------------------------------------------------------- 镜头

  -- 镜头竖直半视场的 tan：照镜头现在的视场角算（HangarStage 定 40°；Play.lua 每帧往 70° 拉一下，实际跟着帧率在 42～52° 之间）
  local function tanV()
    local cam = workspace.CurrentCamera
    local fov = cam and cam.FieldOfView or 40
    return math.tan(math.rad(math.clamp(fov, 20, 90)) / 2)
  end
  local function free3d()   -- 两栏中间留给 3D 的那一段（Root 坐标）：左、右
    local vw = ws.vw()
    return LAY.M + LAY.LW + LAY.GAP, vw - LAY.M - LAY.RW - LAY.GAP
  end
  -- 全景的距离：飞机在这个偏航 / 俯仰下的投影正好放进两栏中间那一段（留一成边）
  --   飞机是十字形（机身 × 机翼），斜着看时投影最宽的是翼尖或机头，不是外接方盒的角：按两者里大的那个 × 1.18 算；直升机的宽按旋翼
  local function fitDist(d, yaw, pitch)
    local vw, vh = ws.vw(), ws.vh()
    local tv = tanV()
    local tanH = tv * vw / math.max(vh, 1)
    local x0, x1 = free3d()
    local fx = math.max(0.25, (x1 - x0) / vw) * 0.9
    local fy = math.max(0.3, ws.colH() / vh) * 0.62
    local L, W, H = d.L or 40, d.W or 30, (d.H or 12)
    if d.kind == "heli" and d.rotor then W = math.max(W, d.rotor.r * 1.6) end
    local ay, ap = math.abs(math.sin(yaw)), math.abs(math.cos(yaw))
    local extX = math.max(W / 2 * ap, L / 2 * ay) * 1.18
    local extY = H / 2 * math.cos(pitch) + math.max(W / 2 * ay, L / 2 * ap) * math.abs(math.sin(pitch))
    return math.max(extX / (fx * tanH), extY / (fy * tv)) * 1.08
  end
  -- 镜头横着挪多少格，让 at 那一点落在画面的 sx（Root 坐标）上
  local function shiftFor(dist, sx)
    local vw, vh = ws.vw(), ws.vh()
    local tanH = tanV() * vw / math.max(vh, 1)
    return -(sx - vw / 2) / (vw / 2) * dist * tanH
  end
  -- 全景按透视算准：飞机最外面的几个点（机头、机尾、翼尖、平尾尖、每个挂点、机轮着地点、直升机的桨盘）投到画面上，
  --   调镜头的远近和横移，让它们正好落在两栏中间那一段（左右各留 28 像素、高不超过栏高的六成）——斜着看时机头离镜头近（透视放大）、
  --   后掠翼的翼尖靠后，按外接方盒估会偏出去（翼尖那个挂点的编号被右栏盖住）
  local function framePts(d)
    local pts = {}
    local function add(x, y, z) pts[#pts + 1] = V3(x, y, z) end
    local L, W = d.L or 40, d.W or 30
    add(0, 0, -L / 2)
    add(0, 0, L / 2)
    add(0, (d.H or 12) * 0.6, L * 0.3)   -- 垂尾顶（大约）
    add(0, -(d.gearH or 6), 0)            -- 机轮着地
    local wg = d.wing
    if wg and wg.xt then
      for _, sx in ipairs({ -1, 1 }) do add(sx * wg.xt, wg.y or 0, ((wg.zt0 or 0) + (wg.zt1 or 0)) / 2) end
    elseif d.kind ~= "heli" then
      for _, sx in ipairs({ -1, 1 }) do add(sx * W / 2, 0, 0) end
    end
    local ht = d.htail
    if ht and ht.xt then for _, sx in ipairs({ -1, 1 }) do add(sx * ht.xt, ht.y or 0, ht.zt1 or (L / 2)) end end
    for _, s in ipairs(d.st or {}) do add(s.pos.X, s.pos.Y, s.pos.Z) end
    if d.kind == "heli" and d.rotor and d.rotor.r then   -- 桨盘按八成算（桨尖伸到两栏底下没关系）
      local h0 = d.rotor.hub or V3(0, (d.H or 12) * 0.5, 0)
      local r = d.rotor.r * 0.8
      add(h0.X + r, h0.Y, h0.Z)
      add(h0.X - r, h0.Y, h0.Z)
      add(h0.X, h0.Y, h0.Z + r)
      add(h0.X, h0.Y, h0.Z - r)
    end
    -- 搭好的模型（原模型的翼展、挂点和型号表的数不完全一样）：挂点上的弹、所有零件的中心也算上（fitView 里只留沿画面横竖最外面的那几个）
    local A0 = G.hangarAir and G.hangarAir()
    if A0 and A0.key == st.key and A0.M and A0.M.model then
      for _, a in pairs(st.anchor or {}) do pts[#pts + 1] = a end
      local cand = {}
      for _, x in ipairs(A0.M.model:GetDescendants()) do
        if x:IsA("BasePart") and x.Transparency < 0.9 then cand[#cand + 1] = A0.cf:PointToObjectSpace(x.Position) end
      end
      pts.model = cand
      -- 旋翼（直升机）：桨叶的零件中心在半径中间，桨尖按上面的八成那几个点算
    end
    return pts
  end
  local function fitView(d, yaw, pitch)
    local vw, vh = ws.vw(), ws.vh()
    local tv = tanV()
    local tanH = tv * vw / math.max(vh, 1)
    local x0, x1 = free3d()
    local lx, rx = x0 + 28, x1 - 28
    local cxT, wantW, wantH = (lx + rx) / 2, rx - lx, ws.colH() * 0.6
    local cp = math.cos(pitch)
    local f = -V3(math.sin(yaw) * cp, math.sin(pitch), math.cos(yaw) * cp)   -- 镜头往哪看（从镜头指向目标）
    local r = f:Cross(V3(0, 1, 0)).Unit
    local u = r:Cross(f)
    local gh = d.gearH or 6
    local off = V3(0, gh * 0.08, 0)   -- 镜头看的那一点（gearH × 0.92）在机身原点下面一点
    local pts = framePts(d)
    if pts.model and #pts.model > 0 then   -- 模型零件：沿画面横 / 竖方向各取最外面几个（几百个零件全投影一遍太慢）
      local m = pts.model
      local function keep(axis, k)
        table.sort(m, function(a, b) return a:Dot(axis) < b:Dot(axis) end)
        for i = 1, math.min(k, #m) do pts[#pts + 1] = m[i] end
        for i = math.max(1, #m - k + 1), #m do pts[#pts + 1] = m[i] end
      end
      keep(r, 8)
      keep(u, 4)
      pts.model = nil
    end
    local function ext(D, sh)
      local mn, mx, ymn, ymx = math.huge, -math.huge, math.huge, -math.huge
      for _, p in ipairs(pts) do
        local q = p + off
        local dep = D + q:Dot(f)
        if dep > 1 then
          local sx = vw / 2 * (1 + (q:Dot(r) - sh) / (dep * tanH))
          local sy = vh / 2 * (1 - q:Dot(u) / (dep * tv))
          mn, mx = math.min(mn, sx), math.max(mx, sx)
          ymn, ymx = math.min(ymn, sy), math.max(ymx, sy)
        end
      end
      return mn, mx, ymn, ymx
    end
    local function centerShift(D)   -- 横移：最左、最右两个点的中点对准两栏中间
      local sh = 0
      for _ = 1, 5 do
        local mn, mx = ext(D, sh)
        if mn == math.huge then break end
        sh += ((mn + mx) / 2 - cxT) * (D * tanH) / (vw / 2)
      end
      return sh
    end
    local lo, hi = 5, 4000
    for _ = 1, 30 do
      local D = (lo + hi) / 2
      local mn, mx, ymn, ymx = ext(D, centerShift(D))
      if mn == math.huge or mx - mn > wantW or ymx - ymn > wantH then lo = D else hi = D end
    end
    return hi, centerShift(hi)
  end
  local function overview(t)
    local d = st.d
    local ok, dist, sh = pcall(fitView, d, OV_YAW, OV_PITCH)
    if not ok or not dist then   -- 算不出来（不该发生）：照外接方盒估
      dist = fitDist(d, OV_YAW, OV_PITCH)
      local x0, x1 = free3d()
      sh = shiftFor(dist, (x0 + x1) / 2)
    end
    if Stage then
      Stage.focus({ at = V3(0, (d.gearH or 6) * 0.92, 0), dist = dist, yaw = OV_YAW, pitch = OV_PITCH, shift = sh, t = t })
    end
  end
  local function stationView(ci, t)
    local g = st.cards[ci]
    if not (g and Stage) then return end
    local d = st.d
    local vs = Stage.viewState()
    local camSide = (math.sin(vs.sy or vs.yaw or 0) >= 0) and 1 or -1
    local pick = g.st[1]
    for _, i in ipairs(g.st) do if ((d.st[i].pos.X >= 0) and 1 or -1) == camSide then pick = i end end
    local s = d.st[pick]
    local a = (st.anchor and st.anchor[pick]) or s.pos
    local side = (math.abs(s.pos.X) < 0.5) and camSide or ((s.pos.X >= 0) and 1 or -1)
    -- 离多远：画面里看得见这一侧的大半个机翼（按视场角换算：视场宽了就近一点，框住的一样多）；直升机机身长、短翼短：从侧前方远一点看
    local heli = d.kind == "heli"
    local dist = (heli and math.max((d.L or 40) * 0.36, 14) or math.max(d.L or 40, d.W or 30) * 0.27) / tanV()
    local yawS = heli and math.rad(100) or math.rad(125)
    local x0, x1 = free3d()
    -- 挂点落在哪：桌面上左边浮着这枚弹的资料卡（左栏右边 300 宽），挂点放到资料卡和右栏中间；手机放在两栏中间
    local sx = compact and (x0 + x1) / 2 or (x0 + LAY.DW + LAY.GAP + x1) / 2
    Stage.focus({ at = V3(0, d.gearH or 6, 0) + a, dist = dist, yaw = side * yawS, pitch = s.bay and -0.15 or (heli and -0.04 or -0.08),
      shift = shiftFor(dist, sx), t = t })
  end

  ---------------------------------------------------------------- 界面零件（左栏、右栏、底部条、标签层、资料卡）：每次打开按这一架重建

  local ui = {}
  -- 清空一块（只删界面零件：面板自己的 UIGradient / UIStroke / UICorner 留着）
  local function clear(f) for _, c in ipairs(f:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end end
  -- 分节标题换字（线跟着字的宽挪）
  local function setHeader(h, str)
    if not h or not h.t then return end
    h.t.Text = str
    local tw = K.textW(str, S.small) + 8
    h.ln.Size = UD2(0, math.max(0, h.w - tw), 0, 1)
    h.ln.Position = UD2(0, h.x + tw, 0, h.y + 8)
  end
  local function header(parent, str, y, w, x)
    local t, ln = K.header(parent, str, y, w, x)
    return { t = t, ln = ln, w = w, x = x or 12, y = y }
  end

  -- 左栏：全景（方案、状态行、挂载清单、提示）/ 选了挂点（收起的方案行、挂点标题、武器卡）
  local CH = compact and 54 or 62   -- 武器卡的高（桌面一屏放得下 5 张整卡 +「还有 N 种」）
  local PW, PH = compact and 76 or 104, compact and 28 or 40   -- 卡上那块图
  local CHIP_H = compact and 44 or 28   -- 小块的高（手机能点的东西 ≥ 44）
  local refreshAll, selectCard, setHover, buildList, updateRight, refreshChips, layoutLeft, refreshListLook, updatePlate, setHov
  local closeMenu, showUndo

  ---------------------------------------------------------------- 改动：撤销、存、3D、刷新

  local function snap() return { load = table.clone(st.load), pk = st.pk, mine = st.mine, fuel = st.fuel } end
  -- 存（即时存，不弹提示）：车名右边的保存状态等服务器推回来的存档里真有这一套才写「已保存」；4 秒没回「没存上 · 重试」
  local function save()
    local key, d, l, pk, f = st.key, st.d, table.clone(st.load), st.pk, st.fuel
    local function send()
      if G.treeSaveLoad then G.treeSaveLoad(key, l, pk, f, true) end
    end
    local function check()
      local t = G.treeState and G.treeState()
      local v = t and t.load and t.load[key]
      if type(v) ~= "table" or type(v.l) ~= "table" then return false end
      return sameOn(d, AD.cleanLoad(d, v.l), l) and math.abs(AD.cleanFuel(v.f) - f) < 1e-6
    end
    local function arm()
      if ws.saving then ws.saving(check, function()
        send()
        arm()
      end) end
    end
    -- 存档里已经是这一套（只换了「我的方案」那一格的选中、或者原样点回来）：不发（服务器的存档不会变，也就等不到回音）
    local t = G.treeState and G.treeState()
    local v = t and t.load and t.load[key]
    if type(v) == "table" and type(v.l) == "table" and sameOn(d, AD.cleanLoad(d, v.l), l) and math.abs(AD.cleanFuel(v.f) - f) < 1e-6
      and (v.p or false) == (pk or false) then return end
    send()
    arm()
  end
  -- 换成新的一套（点了装上、换预设、读我的方案、改内油、撤销）：记一步撤销、存、3D 跟着换（新挂上的从挂架下滑上去）、界面刷新（数字滚动）
  --   一样的不动（也不发服务器）
  local function commit(nl, pk, mine, fuel, why)
    local before = snap()
    if same(before.load, nl) and before.pk == pk and before.mine == mine and math.abs(before.fuel - fuel) < 1e-6 then return false end
    if why ~= "undo" then
      table.insert(st.undo, before)
      if #st.undo > 10 then table.remove(st.undo, 1) end
    end
    local changed = {}
    for i = 1, #(st.d.st or {}) do
      local a, b = st.load[i] or false, nl[i] or false
      if a ~= b and b then table.insert(changed, i) end
    end
    st.load, st.pk, st.mine, st.fuel = nl, pk, mine, fuel
    st.pendingMount = (#changed > 0) and changed or nil
    local rebuilt = show3d(st.load)
    if not rebuilt and st.pendingMount then
      local m = st.pendingMount
      st.pendingMount = nil
      mountAnim(m)
    end
    save()
    refreshAll(true)
    showUndo(#st.undo > 0)
    return true
  end
  function P.undo()
    if not st or #st.undo == 0 then return false end
    closeMenu()
    local s0 = table.remove(st.undo)
    st.hoverOpt = nil
    ws.detailShow(false)
    commit(s0.load, s0.pk, s0.mine, s0.fuel, "undo")
    return true
  end

  local function presetMod()   -- 照哪套预设改的、改了几个挂点
    if not st.pk then return nil, 0 end
    local pl = AD.presetLoad(st.d, st.pk)
    local n = 0
    for i = 1, #(st.d.st or {}) do if (pl[i] or false) ~= (st.load[i] or false) then n += 1 end end
    return pl, n
  end
  local function setOf(i)
    local t = G.treeState and G.treeState()
    local sets = t and t.sets and t.sets[st.key]
    local v = sets and sets[tostring(i)]
    if type(v) == "table" and type(v.l) == "table" then return { l = AD.cleanLoad(st.d, v.l), f = AD.cleanFuel(v.f) } end
    return nil
  end
  local function choosePreset(key)
    closeMenu()
    st.hoverOpt = nil
    commit(AD.presetLoad(st.d, key), key, nil, st.fuel, "preset")
  end

  ---------------------------------------------------------------- 我的方案

  -- 存上了：这一格自己反馈（一圈琥珀描边 0.6 秒淡掉），不跳到抬头去
  local function flashSlot(ch)
    local fl = ch.f:FindFirstChild("SavedFlash") or K.frame(ch.f, UD2(1, 0, 1, 0), nil, nil, 1)
    fl.Name = "SavedFlash"
    TH.corner(fl)
    local s = TH.stroke(fl)
    s.Color, s.Transparency = C.WARN, 0
    TH.tween(s, { Transparency = 1 }, 0.6, "out")
  end
  local function mineSave(i)
    if G.treeSaveSet then G.treeSaveSet(st.key, i, st.load, st.fuel) end
    st.mine = i
    refreshChips()
    if ui.mine[i] then flashSlot(ui.mine[i]) end
  end
  local function mineClear(i)
    if G.treeSaveSet then G.treeSaveSet(st.key, i, false) end
    if st.mine == i then st.mine = nil end
    refreshChips()
  end
  local function mineClick(i)
    closeMenu()
    local v = setOf(i)
    if v then
      st.hoverOpt = nil
      if not commit(v.l, nil, i, v.f, "mine") then
        st.mine, st.pk = i, nil
        refreshChips()
      end
    else
      mineSave(i)
    end
  end
  closeMenu = function()
    if ui.menu then
      ui.menu:Destroy()
      ui.menu = nil
    end
  end
  -- 有内容的一格右键 / 长按：小菜单「覆盖成现在这套 / 清空」
  local function openMenu(i)
    closeMenu()
    local ch = ui.mine and ui.mine[i]
    if not ch then return end
    local ih = compact and 44 or 28
    local mw = compact and 176 or 156
    local p = ch.f.Position
    local m = K.panel(ws.left, UD2(0, mw, 0, 2 * ih + 8), UD2(0, math.min(p.X.Offset, LAY.LW - 12 - mw), 0, p.Y.Offset + ch.f.Size.Y.Offset + 4), nil, 0.02)
    m.Name = "MineMenu"
    m.ZIndex = 10
    for k, it in ipairs({ { "Over", T("ws.mineOver"), function() mineSave(i) end }, { "Clear", T("ws.mineClear"), function() mineClear(i) end } }) do
      local b = K.button(m, UD2(1, -8, 0, ih), UD2(0, 4, 0, 4 + (k - 1) * ih), "Mine_" .. it[1])
      b.ZIndex = 11
      local t = K.text(b, it[2], S.small, "bold", C.MUTE, UD2(1, -16, 1, 0), UD2(0, 8, 0, 0))
      t.ZIndex = 12
      b.MouseEnter:Connect(function() t.TextColor3 = C.TEXT end)
      b.MouseLeave:Connect(function() t.TextColor3 = C.MUTE end)
      b.Activated:Connect(function()
        closeMenu()
        it[3]()
      end)
    end
    ui.menu = m
  end
  -- 一格：有内容的同预设小块（我的 1，选中 / 已改）；空着的只画淡的键位框「1」和「＋」（悬停写「存当前」）
  local function mineSlot(parent, i, size, pos)
    local ch
    ch = K.chip(parent, "", size, pos, { name = "Mine_" .. i, onClick = function()
      if ui.menuJust then
        ui.menuJust = false
        return
      end
      mineClick(i)
    end })
    local h = size.Y.Offset
    local kb = K.keyBox(ch.f, tostring(i), 8, math.floor((h - 14) / 2), C.FAINT, "Key")
    local pl = K.plus(ch.f, 30, math.floor((h - 9) / 2), 9, C.FAINT)
    local hint = K.text(ch.f, T("ws.mineEmpty"), S.tiny, "bold", C.MUTE, UD2(1, -46, 1, 0), UD2(0, 44, 0, 0))
    hint.Name = "Hint"
    hint.Visible = false
    ch.key, ch.plus, ch.hint = kb, pl, hint
    ch.f.MouseEnter:Connect(function() if ch.empty then hint.Visible = true end end)
    ch.f.MouseLeave:Connect(function() hint.Visible = false end)
    ch.f.InputBegan:Connect(function(io)
      if io.UserInputType == Enum.UserInputType.MouseButton2 then
        if not ch.empty then openMenu(i) end
      elseif io.UserInputType == Enum.UserInputType.Touch then   -- 长按 0.5 秒
        local tok = {}
        ch.hold = tok
        task.delay(0.5, function()
          if ch.hold == tok and not ch.empty and st then
            ui.menuJust = true
            openMenu(i)
          end
        end)
      end
    end)
    ch.f.InputEnded:Connect(function(io) if io.UserInputType == Enum.UserInputType.Touch then ch.hold = nil end end)
    return ch
  end

  ---------------------------------------------------------------- 左栏

  local function buildLeft()
    local Lf = ws.left
    clear(Lf)
    ui.menu = nil
    local w = LAY.LW - 24
    ui.chips, ui.mine = {}, {}
    local presets = st.d.presets or {}
    -- 全景：方案
    local schemeBox = K.frame(Lf, UD2(1, 0, 0, 10), nil, nil, 1)
    schemeBox.Name = "Schemes"
    ui.schemeBox = schemeBox
    local y = 10
    K.header(schemeBox, T("ws.schemes"), y, w)
    y += 22
    local cols = 3
    local G6 = 6
    local CW = math.floor((w - (cols - 1) * G6) / cols)
    for k, p in ipairs(presets) do
      local r, c = math.floor((k - 1) / cols), (k - 1) % cols
      local ch = K.chip(schemeBox, T("preset." .. p.key), UD2(0, CW, 0, CHIP_H), UD2(0, 12 + c * (CW + G6), 0, y + r * (CHIP_H + G6)), {
        name = "Preset_" .. p.key,
        onClick = function() choosePreset(p.key) end })
      ui.chips[p.key] = ch
    end
    y += math.max(1, math.ceil(#presets / cols)) * (CHIP_H + G6) + 6
    K.header(schemeBox, T("ws.mine"), y, w)
    y += 22
    for i = 1, 3 do ui.mine[i] = mineSlot(schemeBox, i, UD2(0, CW, 0, CHIP_H), UD2(0, 12 + (i - 1) * (CW + G6), 0, y)) end
    y += CHIP_H + 8
    ui.status = K.text(schemeBox, "", S.tiny, "bold", C.MUTE, UD2(0, w - 48, 0, 16), UD2(0, 12, 0, y))
    ui.status.Name = "LoadStatus"
    ui.statusY = y
    y += 24
    schemeBox.Size = UD2(1, 0, 0, y)
    ui.schemeH = y
    -- 全景：挂载清单、提示
    ui.manifest = K.frame(Lf, UD2(1, 0, 0, 10), UD2(0, 0, 0, y), nil, 1)
    ui.manifest.Name = "Manifest"
    ui.hint = K.text(Lf, T(compact and "ws.pickTouch" or "ws.pick"), S.tiny, "body", C.FAINT, UD2(0, w, 0, 16), UD2(0, 12, 0, y))
    ui.hint.Name = "PickHint"
    -- 选了挂点：方案收成一行「‹ 方案 · 对地（已改 2）」（点了回全景）
    local sbox = K.frame(Lf, UD2(1, 0, 1, 0), nil, nil, 1)
    sbox.Name = "StationBox"
    ui.sbox = sbox
    local rowH = CHIP_H
    local row = K.button(sbox, UD2(1, -24, 0, rowH), UD2(0, 12, 0, 4), "BackToSchemes")
    local chev = K.chevron(row, 0, math.floor(rowH / 2) - 6, 12, C.MUTE)
    local rl = K.text(row, "", S.small, "bold", C.MUTE, UD2(1, -66, 1, 0), UD2(0, 18, 0, 0))
    rl.Name = "Label"
    row.MouseEnter:Connect(function()
      rl.TextColor3 = C.TEXT
      K.tintChevron(chev, C.TEXT)
    end)
    row.MouseLeave:Connect(function()
      rl.TextColor3 = C.MUTE
      K.tintChevron(chev, C.MUTE)
    end)
    row.Activated:Connect(function() if selectCard then selectCard(nil) end end)
    K.frame(sbox, UD2(1, -24, 0, 1), UD2(0, 12, 0, 4 + rowH + 2), C.LINE, A.line).Name = "RowLine"
    ui.schemeRow, ui.schemeRowT = row, rl
    local hy = 4 + rowH + 6
    ui.stHead = K.text(sbox, "", compact and S.body or S.sub, "bold", C.TEXT, UD2(0, w - 56, 0, 22), UD2(0, 12, 0, hy))
    ui.stHead.Name = "StationHead"
    ui.stPos = K.text(sbox, "", compact and S.tiny or S.small, "bold", C.MUTE, UD2(0, w, 0, 16), UD2(0, 12, 0, hy + (compact and 20 or 22)))
    ui.stPos.Name = "StationPos"
    ui.bayTag = K.frame(sbox, UD2(0, 40, 0, 16), UD2(1, -12, 0, hy + 3), C.PANEL, 1, V2(1, 0))
    ui.bayTag.Name = "BayTag"
    TH.stroke(ui.bayTag).Transparency = 0.6
    TH.corner(ui.bayTag)
    K.text(ui.bayTag, T("ws.bay"), S.tiny, "bold", C.MUTE, UD2(1, 0, 1, 0), nil, CENTER).Name = "Text"
    local listY = hy + (compact and 40 or 44)
    ui.listY = listY
    local list = Instance.new("ScrollingFrame")
    list.Name = "Weapons"
    list.BackgroundTransparency = 1
    list.BorderSizePixel = 0
    list.ScrollBarThickness = compact and 0 or 3
    list.ScrollBarImageColor3 = C.MUTE
    list.ScrollBarImageTransparency = 0.3
    list.ScrollingDirection = Enum.ScrollingDirection.Y
    list.ClipsDescendants = true
    list.CanvasSize = UD2(0, 0, 0, 0)
    list.Size = UD2(1, -18, 0, 100)
    list.Position = UD2(0, 12, 0, listY)
    list.Parent = sbox
    ui.list = list
    ui.more = K.text(sbox, "", S.tiny, "bold", C.FAINT, UD2(0, w, 0, 14), UD2(0, 12, 0, listY + 100))
    ui.more.Name = "More"
    list:GetPropertyChangedSignal("CanvasPosition"):Connect(function() if ui.updateMore then ui.updateMore() end end)
    -- 撤销（换了预设、我的方案、一对挂点、内油以后 5 秒）：状态行 / 收起的方案行右边一个文字键
    local ub = Instance.new("TextButton")
    ub.Name = "Undo"
    ub.AutoButtonColor = false
    ub.BackgroundTransparency = 1
    ub.BorderSizePixel = 0
    ub.Text = T("ws.undo")
    ub.Font = TH.F.bold
    ub.TextSize = S.tiny
    ub.TextColor3 = C.MUTE
    ub.TextXAlignment = RIGHT
    ub.Size = UD2(0, 44, 0, compact and 44 or 18)
    ub.AnchorPoint = V2(1, 0.5)
    ub.Visible = false
    ub.ZIndex = 3
    ub.Parent = Lf
    ub.MouseEnter:Connect(function() ub.TextColor3 = C.TEXT end)
    ub.MouseLeave:Connect(function() ub.TextColor3 = C.MUTE end)
    ub.Activated:Connect(function() P.undo() end)
    ui.undo = ub
  end
  showUndo = function(on)
    local ub = ui.undo
    if not ub then return end
    ui.undoTok = {}
    local tok = ui.undoTok
    ub.Visible = on == true
    if on then task.delay(5, function() if ui.undoTok == tok and ub.Parent then ub.Visible = false end end) end
  end

  -- 挂载清单（全景时左栏下半）：航炮在最前，然后按类（空空、空地、炸弹、火箭巢、副油箱），一种一行：小图、短名、类别、几枚
  local CAT_ORDER = { aam = 1, agm = 2, bomb = 3, rkt = 4, tank = 5 }
  local function buildManifest()
    local box = ui.manifest
    if not box then return 0 end
    clear(box)
    local w = LAY.LW - 24
    local d = st.d
    local rows = {}
    if d.gun then table.insert(rows, { gun = d.gun, n = d.gunAmmo or 0 }) end
    local cnt, order = {}, {}
    for i, s0 in ipairs(d.st or {}) do
      local wid = st.load[i]
      local Wd = wid and AD.W[wid]
      if Wd then
        if not cnt[wid] then
          cnt[wid] = 0
          table.insert(order, wid)
        end
        cnt[wid] += (Wd.kind == "rkt") and 1 or AD.count(s0, wid)
      end
    end
    table.sort(order, function(a, b)
      local ka, kb = CAT_ORDER[AD.W[a].kind] or 9, CAT_ORDER[AD.W[b].kind] or 9
      if ka ~= kb then return ka < kb end
      return a < b
    end)
    for _, wid in ipairs(order) do table.insert(rows, { wid = wid, n = cnt[wid] }) end
    K.header(box, T("ws.manifest"), 4, w)
    local RH = compact and 24 or 30
    local PWm, PHm = compact and 48 or 64, compact and 16 or 20
    local maxRows = math.max(1, math.floor((ws.colH() - (ui.schemeH or 0) - 26 - (compact and 6 or 32)) / RH))
    local all = {}
    for _, r in ipairs(rows) do if r.wid then all[#all + 1] = r.wid end end
    local px = K.artScale(all, PWm, PHm, 2)
    local nShown = 0
    for k, r in ipairs(rows) do
      if k > maxRows then break end
      nShown = k
      local row = K.frame(box, UD2(0, w, 0, RH - 4), UD2(0, 12, 0, 26 + (k - 1) * RH), nil, 1)
      row.Name = "Man_" .. (r.wid or r.gun)
      local lb = K.lightbox(row, UD2(0, PWm, 0, PHm), UD2(0, 0, 0.5, -PHm / 2))
      if r.gun then K.gunArt(lb, r.gun, PWm, PHm) else K.weaponArt(lb, r.wid, PWm, PHm, { px = px }) end
      local Wd = r.wid and AD.W[r.wid]
      K.text(row, r.gun and wname(r.gun) or wname(r.wid), S.small, "bold", C.TEXT, UD2(0, w - PWm - 104, 1, 0), UD2(0, PWm + 10, 0, 0)).Name = "Name"
      local cat = r.gun and T("wcs.gun") or T("wcs." .. catOf(Wd))
      K.text(row, cat, S.tiny, "cond", C.MUTE, UD2(0, 64, 1, 0), UD2(1, -44, 0, 0), RIGHT, V2(1, 0)).Name = "Cat"
      local cntT = r.gun and tostring(r.n) or ("×" .. r.n)
      K.text(row, cntT, S.small, "mono", C.TEXT, UD2(0, 40, 1, 0), UD2(1, 0, 0, 0), RIGHT, V2(1, 0)).Name = "Count"
    end
    local h = 26 + nShown * RH
    if #order == 0 then
      K.text(box, T("ws.manifestEmpty"), S.small, "body", C.FAINT, UD2(0, w, 0, 18), UD2(0, 12, 0, h)).Name = "Empty"
      h += 22
    end
    box.Size = UD2(1, 0, 0, h)
    return h
  end

  -- 武器卡（左栏）：左边 104 × 40 的图（平时灰、装着的 / 鼠标挂着的白）、标题（粗 15）、「类别 · 导引」、第三行三列（射程 · 锁定 · 每个挂点几枚，按列对齐、单位淡）；
  --   装着的：左边 2 像素白竖条 + 右上「已装」（粗 12 灰）
  local function cell(parent, data, x, w, y)
    local l = K.text(parent, "", S.tiny, "mono", C.TEXT, UD2(0, w, 0, 16), UD2(0, x, 0, y), RIGHT)
    l.RichText = true
    l.Text = data and K.rich({ { data[1] }, { data[2], C.FAINT } }, S.tiny) or ""
    return l
  end
  local pickWeapon
  local function weaponCard(parent, k, wid, s, px)
    local y = (k - 1) * (CH + 6)
    local wcard = K.card(parent, UD2(1, -6, 0, CH), UD2(0, 0, 0, y), {
      name = "Opt_" .. (wid or "none"),
      onEnter = function() if not compact and setHover then setHover(wid, true) end end,
      onLeave = function() if not compact and setHover then setHover(wid, false) end end,
      onClick = function() if pickWeapon then pickWeapon(wid) end end })
    local f = wcard.f
    local w = wid and AD.W[wid]
    local px0 = compact and 8 or 10
    wcard.wid = wid
    if w then
      wcard.lb = K.lightbox(f, UD2(0, PW, 0, PH), UD2(0, px0, 0.5, -PH / 2))
      wcard.artPx = math.min(px * 1.5, K.artScale({ wid }, PW, PH, 4))
      local tx = px0 + PW + 10
      local t1 = K.text(f, wname(wid), compact and S.small or S.body, "bold", C.TEXT, UD2(1, -(tx + 46), 0, 18), UD2(0, tx, 0, compact and 3 or 4))
      t1.Name = "Name"
      local t2 = K.text(f, subOf(w, compact), compact and S.tiny or S.small, "cond", C.MUTE, UD2(1, -(tx + 8), 0, 16), UD2(0, tx, 0, compact and 19 or 23))
      t2.Name = "Sub"
      local cols = colsOf(s, wid)
      local y3 = compact and 34 or 41
      cell(f, cols[1], tx, compact and 54 or 60, y3).Name = "Range"
      if not compact then cell(f, cols[2], tx + 60, 48, y3).Name = "Lock" end
      local cn = K.text(f, cols[3] or "", S.tiny, "mono", C.TEXT, UD2(0, 36, 0, 16), UD2(1, -10, 0, y3), RIGHT, V2(1, 0))
      cn.Name = "Count"
    else   -- 不挂：虚线框
      wcard.st.Transparency = 1
      wcard.restT = 1
      wcard.f.BackgroundTransparency = 0.6
      K.dashed(f, LAY.LW - 24, CH, C.LINE, 0.55)
      local t1 = K.text(f, T("ws.none"), compact and S.small or S.body, "bold", C.TEXT, UD2(1, -24, 0, 18), UD2(0, 16, 0, CH / 2 - 18))
      t1.Name = "Name"
      local t2 = K.text(f, T("ws.noneSub"), S.small, "cond", C.MUTE, UD2(1, -24, 0, 16), UD2(0, 16, 0, CH / 2 + 2))
      t2.Name = "Sub"
    end
    local tag = K.text(f, T("ws.equipped"), S.tiny, "bold", C.MUTE, UD2(0, 60, 0, 14), UD2(1, -10, 0, compact and 4 or 6), RIGHT, V2(1, 0))
    tag.Name = "Equipped"
    tag.Visible = false
    local tx0 = (compact and 8 or 10) + PW + 10
    local again = K.text(f, T("ws.tapAgain"), S.tiny, "bold", C.MUTE, UD2(1, -(tx0 + 8), 0, 16), UD2(0, tx0, 0, compact and 19 or 23))
    again.Name = "TapAgain"
    again.Visible = false
    wcard.tag, wcard.again, wcard.sub = tag, again, f:FindFirstChild("Sub")
    return wcard
  end
  -- 卡上跟着状态走的：装着的（白竖条、「已装」）、鼠标挂着 / 预览着的（图变白；手机写「再点一下装上」）——不重建（鼠标还挂在卡上，重建了悬停就断了）
  refreshListLook = function()
    local g = st.sel and st.cards[st.sel]
    if not g then return end
    local cur, mixed = cardWeapon(g)
    for _, cd in ipairs(ui.opts or {}) do
      local own = (not mixed) and (cur or false) == (cd.wid or false)
      local pv = st.hoverOpt ~= nil and (st.hoverOpt or false) == (cd.wid or false)
      cd:setOwn(own)
      cd.tag.Visible = own and not (compact and pv)
      cd.again.Visible = compact and pv and not own
      if cd.sub then cd.sub.Visible = not cd.again.Visible end
      if compact then cd:setHover(pv) end
      if cd.lb then
        local hot = own or pv or cd.hov
        if cd.hot ~= hot then
          cd.hot = hot
          K.weaponArt(cd.lb, cd.wid, PW, PH, { px = cd.artPx, col = hot and C.TEXT or C.MUTE })
        end
      end
    end
  end

  buildList = function()
    if not ui.list then return end
    clear(ui.list)
    ui.opts = {}
    local g = st.sel and st.cards[st.sel]
    if not g then return end
    local d = st.d
    local s = d.st[g.st[1]]
    local cur = cardWeapon(g)
    local Wc = cur and AD.W[cur]
    ui.stHead.Text = T("ws.station", g.label)
    local now = Wc and (wname(cur) .. ((AD.count(s, cur) > 1 and Wc.kind ~= "rkt") and (" ×" .. AD.count(s, cur)) or "")) or T("ws.emptyNow")
    ui.stPos.Text = posName(s) .. " · " .. T("ws.now", now)
    ui.bayTag.Visible = g.bay ~= nil
    local opts = table.clone(s.opts)
    table.insert(opts, false)
    local px = K.artScale(s.opts, PW, PH, 4)
    local kCur = #opts
    for k, wid in ipairs(opts) do
      local cd = weaponCard(ui.list, k, wid, s, px)
      table.insert(ui.opts, cd)
      K.reveal(cd.f, k)
      if (wid or false) == (cur or false) then kCur = k end
    end
    -- 列表多高：整张整张地放（放不下的写「还有 N 种」），多出来的给面板留白
    local avail = ws.colH() - ui.listY - 6
    local nFit = math.max(1, math.floor((avail + 6) / (CH + 6)))
    if nFit < #opts then nFit = math.max(1, math.floor((avail - 18 + 6) / (CH + 6))) end
    nFit = math.min(nFit, #opts)
    local listH = nFit * (CH + 6) - 6
    ui.listH, ui.listMore = listH, nFit < #opts
    ui.list.Size = UD2(1, -18, 0, listH)
    ui.list.CanvasSize = UD2(0, 0, 0, #opts * (CH + 6) - 6)
    ui.more.Position = UD2(0, 12, 0, ui.listY + listH + 4)
    ui.nFit = nFit
    -- 卷到装着的那张（放在中间）
    local maxY = math.max(0, #opts * (CH + 6) - 6 - listH)
    local cy = math.clamp((kCur - 1) * (CH + 6) - (listH - CH) / 2, 0, maxY)
    ui.list.CanvasPosition = V2(0, math.floor(cy / (CH + 6) + 0.5) * (CH + 6))
    ui.updateMore = function()
      local okc, cp = pcall(function() return ui.list.CanvasPosition end)
      local top = (okc and cp) and math.floor(cp.Y / (CH + 6) + 0.5) or 0
      local below = math.max(0, #opts - (top + nFit))
      ui.more.Text = (below > 0) and T("ws.more", below) or ""
    end
    ui.updateMore()
    refreshListLook()
    if ws.detailAt then ws.detailAt(LAY.TOP + ui.listY) end
  end

  -- 左栏两种样子：全景（方案 + 清单 + 提示，高度跟着内容走）/ 选了挂点（整栏）
  layoutLeft = function(instant)
    local g = st.sel and st.cards[st.sel]
    local ov = g == nil
    ui.schemeBox.Visible = ov
    ui.manifest.Visible = ov
    ui.hint.Visible = ov and not compact   -- 手机放不下（第一次点武器卡时卡上自己写「再点一下装上」）
    ui.sbox.Visible = not ov
    local w = LAY.LW - 24
    if ov then
      local mh = buildManifest()
      local hy = ui.schemeH + mh + 6
      ui.hint.Position = UD2(0, 12, 0, hy)
      ui.undo.Position = UD2(0, 12 + w, 0, ui.statusY + 8)
      ws.fitCol("left", compact and (hy + 4) or (hy + 26), instant)
    else
      buildList()
      ui.undo.Position = UD2(0, 12 + w, 0, 4 + CHIP_H / 2)
      -- 栏高到最后一张卡（有「还有 N 种」再加一行）为止：只有三四种可挂的时候下面不留半截空面板
      ws.fitCol("left", ui.listY + (ui.listH or 0) + (ui.listMore and 22 or 0) + 10, instant)
    end
  end

  refreshChips = function()
    local _, nMod = presetMod()
    for key, ch in pairs(ui.chips or {}) do
      local on = st.mine == nil and st.pk == key
      ch:set(on, (on and nMod > 0) and T("ws.modTag") or nil)
    end
    for i, ch in ipairs(ui.mine or {}) do
      local v = setOf(i)
      local on = st.mine == i and v ~= nil
      local modded = on and not (same(v.l, st.load) and math.abs(v.f - st.fuel) < 1e-6)
      ch.empty = v == nil
      ch.t.Text = v and T("ws.mineN", i) or ""
      ch.key.Visible, ch.plus.Visible = v == nil, v == nil
      if v ~= nil then ch.hint.Visible = false end
      ch:set(on, modded and T("ws.modTag") or nil)
      if v == nil then   -- 空格：不画框（只有键位框和加号）
        local s = ch.f:FindFirstChildOfClass("UIStroke")
        if s then s.Transparency = 1 end
      end
    end
    -- 状态行「照『对地』改过 2 个挂点」/「对地 · 预设」/「我的 1」/「自定义」；收起的方案行「方案 · 对地（已改 2）」
    local txt, col, short = "", C.MUTE, ""
    if st.mine then
      local v = setOf(st.mine)
      local modded = v and not (same(v.l, st.load) and math.abs(v.f - st.fuel) < 1e-6)
      txt, col = modded and T("ws.mineModded", st.mine) or T("ws.mineN", st.mine), modded and C.WARN or C.MUTE
      short = T("ws.mineN", st.mine) .. (modded and T("ws.modShort0") or "")
    elseif st.pk then
      local _, n = presetMod()
      local pn = T("preset." .. st.pk)
      if n > 0 then
        txt, col = T("ws.presetModded", pn, n), C.WARN
        short = T("ws.modShort", pn, n)
      else
        txt = T("ws.presetExact", pn)
        short = pn
      end
    else
      txt = T("ws.custom")
      short = T("ws.custom")
    end
    if ui.status then
      ui.status.Text = txt
      ui.status.TextColor3 = col
    end
    if ui.schemeRowT then ui.schemeRowT.Text = T("ws.schemeRow", short) end
  end

  ---------------------------------------------------------------- 右栏：当前挂载、性能对比、内油

  local function buildRight()
    local Rf = ws.right
    clear(Rf)
    ui.cmp = {}
    local w = LAY.RW - 24
    local y = compact and 8 or 10
    header(Rf, T("ws.thisSet"), y, w)
    y += compact and 20 or 22
    local function stat(key, label)
      local row = K.frame(Rf, UD2(0, w, 0, 20), UD2(0, 12, 0, y), nil, 1)
      row.Name = "Stat_" .. key
      K.text(row, label, S.small, "cond", C.MUTE, UD2(0.5, 0, 1, 0), nil).Name = "Name"
      local v = K.text(row, "", compact and S.small or S.body, "mono", C.TEXT, UD2(0.6, 0, 1, 0), UD2(1, 0, 0, 0), RIGHT, V2(1, 0))
      v.Name = "Val"
      y += 22
      return v
    end
    ui.vExt = stat("ext", T("ws.ext"))
    if st.jet then
      ui.vDrag = stat("drag", T("ws.drag"))
      ui.vMass = (not compact) and stat("mass", T("ws.mass")) or nil   -- 手机：右栏只有 300 高，起飞重量不写
      ui.vHeavy = nil
    else
      ui.vDrag, ui.vMass = nil, nil
      ui.vHeavy = stat("heavy", T("ws.heavy"))
    end
    y += compact and 6 or 10
    ui.perfHead = header(Rf, T("ws.perf"), y, w)
    y += compact and 20 or 22
    -- 列名（粗 12 淡）：平时「空挂 现在 差」，悬停时「现在 换上 差」
    ui.colA, ui.colB = nil, nil
    if not compact then
      ui.colA = K.text(Rf, T("ws.colBase"), S.tiny, "bold", C.FAINT, UD2(0, 50, 0, 14), UD2(0, 12 + w + K.CMP_COLS.base, 0, y), RIGHT, V2(1, 0))
      ui.colA.Name = "ColA"
      ui.colB = K.text(Rf, T("ws.colCur"), S.tiny, "bold", C.FAINT, UD2(0, 50, 0, 14), UD2(0, 12 + w + K.CMP_COLS.cur, 0, y), RIGHT, V2(1, 0))
      ui.colB.Name = "ColB"
      ui.colD = K.text(Rf, T("ws.colD"), S.tiny, "bold", C.FAINT, UD2(0, 40, 0, 14), UD2(0, 12 + w, 0, y), RIGHT, V2(1, 0))
      ui.colD.Name = "ColD"
      y += 16
    end
    local rows
    if st.jet then
      rows = { { "vAB", "ws.vAB" }, { "vMil", "ws.vMil" }, { "tw", "ws.tw" }, { "str", "ws.str" }, { "roc", "ws.roc" }, { "wl", "ws.wl" } }
      if st.D and not (st.D.Ta > st.D.Tm) then table.remove(rows, 2) end   -- 没有加力：只有一个极速
      if compact then rows = { rows[1], { "tw", "ws.tw" }, { "str", "ws.str" }, { "roc", "ws.roc" } } end
    else
      rows = { { "vh", "ws.vMax" }, { "min", "ws.endurRow" } }
    end
    local RH = compact and 24 or 26
    for _, r in ipairs(rows) do
      ui.cmp[r[1]] = K.compare(Rf, y, w, T(r[2]), nil, compact, RH)
      ui.cmp[r[1]].f.Name = "Cmp_" .. r[1]
      y += RH
    end
    if st.jet and not compact then   -- 手机放不下这一行说明
      local note = K.text(Rf, T("ws.perfNote"), S.tiny, "body", C.FAINT, UD2(0, w, 0, 16), UD2(0, 12, 0, y + 4))
      note.Name = "Note"
      y += 30
    else
      y += 8
    end
    header(Rf, T("ws.fuel"), y, w)
    y += compact and 20 or 22
    local opts = {}
    for _, f in ipairs(AD.FUEL_OPTS) do
      local pc = math.floor(f * 100 + 0.5)
      table.insert(opts, { key = f, text = pc .. "%", name = "Fuel" .. pc })
    end
    local segH = compact and 44 or 28
    ui.fuel = K.seg(Rf, opts, UD2(0, w, 0, segH), UD2(0, 12, 0, y), { name = "FuelSeg", onPick = function(f)
      closeMenu()
      commit(table.clone(st.load), st.pk, st.mine, f, "fuel")
    end })
    y += segH + 8
    ui.fuel1, ui.fuel2 = nil, nil
    if st.jet then   -- 直升机：续航、重量上面已经有了（不重复写）
      ui.fuel1 = K.text(Rf, "", S.small, "mono", C.TEXT, UD2(0, w, 0, 16), UD2(0, 12, 0, y))
      ui.fuel1.Name = "Endurance"
      y += 18
      if not compact then
        ui.fuel2 = K.text(Rf, "", S.tiny, "mono", C.MUTE, UD2(0, w, 0, 16), UD2(0, 12, 0, y))
        ui.fuel2.Name = "FuelWeight"
        y += 18
      end
    end
    ws.fitCol("right", y + 8, true)
  end

  -- roll：数字滚动（点了装上、改内油）；悬停预览时直接换
  updateRight = function(roll)
    if not st or not ui.vExt then return end
    local cur = perfOf(st.load, st.fuel)
    local empty = perfOf(st.empty, st.fuel)
    local pl = previewLoad()
    local pv = pl and perfOf(pl, st.fuel) or nil
    local function put(lab, key, v, fmt)
      if not lab or v == nil then return end
      if roll and not pv then K.roll(lab, key, st.shown[key], v, fmt) else
        K.stop(key)
        lab.Text = fmt(v)
      end
      st.shown[key] = v
      lab.TextColor3 = pv and C.WARN or C.TEXT
    end
    -- 当前挂载（悬停时是换上以后的，琥珀）
    local x = (pv or cur).Lo
    put(ui.vExt, "wsExt", x.ext, function(v) return K.int(v) .. " kg" end)
    put(ui.vDrag, "wsDrag", x.dCD0 or 0, function(v) return "+" .. string.format("%.4f", v) end)
    put(ui.vMass, "wsMass", x.m, function(v) return K.int(v) .. " kg" end)
    if ui.vHeavy then
      ui.vHeavy.Text = T("ws.heavyVal", K.signed(((pv or cur).heavy - 1) * 100))
      ui.vHeavy.TextColor3 = pv and C.WARN or C.TEXT
    end
    -- 性能：平时 空挂 → 现在（差灰）；悬停时 现在 → 换上（差红绿）
    setHeader(ui.perfHead, T(pv and "ws.perfPv" or "ws.perf"))
    if ui.colA then
      ui.colA.Text = T(pv and "ws.colCur" or "ws.colBase")
      ui.colB.Text = T(pv and "ws.colNew" or "ws.colCur")
    end
    if st.jet and cur.p and empty.p then
      local P0, P1, P2 = empty.p, cur.p, pv and pv.p
      local function row(key, get, fmt, dfmt, better, eps)
        local r = ui.cmp[key]
        if r then r:set(get(P0), get(P1), P2 and get(P2) or nil, { fmt = fmt, dfmt = dfmt, better = better, eps = eps, roll = roll }) end
      end
      local int = function(v) return K.int(v) end
      row("vAB", function(p) return p.vAB * 3.6 end, int, function(v) return K.signed(v) end, 1, 0.5)
      row("vMil", function(p) return p.vMil * 3.6 end, int, function(v) return K.signed(v) end, 1, 0.5)
      row("tw", function(p) return p.tw end, f2, function(v) return K.signed(v, 2) end, 1, 0.005)
      row("str", function(p) return p.str * 180 / math.pi end, f1, function(v) return K.signed(v, 1) end, 1, 0.05)
      row("roc", function(p) return p.roc end, int, function(v) return K.signed(v) end, 1, 0.5)
      row("wl", function(p) return p.wl end, int, function(v) return K.signed(v) end, -1, 0.5)
    elseif not st.jet then
      local vt = function(c) return (c.vh or 0) / AD.M * 3.6 end
      if ui.colA then   -- 直升机不挂副油箱时两行都没变（只写一个数）：列名不写
        local flat = not pv and math.abs(vt(empty) - vt(cur)) < 0.5 and math.abs(empty.min - cur.min) < 0.5
        for _, c in ipairs({ ui.colA, ui.colB, ui.colD }) do c.Visible = not flat end
      end
      if ui.cmp.vh then ui.cmp.vh:set(vt(empty), vt(cur), pv and vt(pv) or nil, { fmt = function(v) return K.int(v) end, dfmt = function(v) return K.signed(v) end,
        better = 1, eps = 0.5, roll = roll }) end
      if ui.cmp.min then ui.cmp.min:set(empty.min, cur.min, pv and pv.min or nil, { fmt = function(v) return T("ws.minutes", math.floor(v + 0.5)) end,
        dfmt = function(v) return K.signed(v) end, better = 1, eps = 0.5, roll = roll }) end
    end
    -- 内油
    if ui.fuel then ui.fuel.set(st.fuel) end
    local c = pv or cur
    if ui.fuel1 then
      ui.fuel1.Text = T("ws.endur", c.min) .. ((c.minX > 0) and ("  " .. T("ws.endurTank", c.minX)) or "")
      ui.fuel1.TextColor3 = pv and C.WARN or C.TEXT
    end
    if ui.fuel2 and st.D then
      local xf = c.Lo.xf or 0
      ui.fuel2.Text = T("ws.fuelKg", K.int(st.D.fi * st.fuel)) .. ((xf > 0.5) and T("ws.fuelKgX", K.int(xf)) or "")
    end
  end

  ---------------------------------------------------------------- 悬停资料卡（桌面：左栏右边，位置固定在武器列表上沿那一高）

  local function buildDetail()
    local D0 = ws.detail
    if ui.dView then ui.dView:clear() end
    clear(D0)
    ui.dView, ui.dRows = nil, nil
    if compact then return end
    local w = LAY.DW
    local pnl = K.panel(D0, UD2(0, w, 0, 250), UD2(0, 1, 0, 1), nil, 0.04)
    pnl.Name = "Card"
    ui.dName = K.text(pnl, "", S.body, "bold", C.TEXT, UD2(0, w - 24, 0, 20), UD2(0, 12, 0, 8))
    ui.dName.Name = "Name"
    ui.dSub = K.text(pnl, "", S.small, "cond", C.MUTE, UD2(0, w - 24, 0, 16), UD2(0, 12, 0, 28))
    ui.dSub.Name = "Sub"
    -- 这枚弹的 3D 模型（同挂在飞机上的那套零件）：后面一块横向柔光，弹在里面慢慢滚着转
    ui.dPlate = K.lightbox(pnl, UD2(0, w - 24, 0, 72), UD2(0, 12, 0, 48))
    ui.dView = K.wpnView(pnl, UD2(0, w - 24, 0, 72), UD2(0, 12, 0, 48), "WsWpnView")
    -- 四个关键数：名字 | 2 像素的条（同类之间比；有已装的那枚时画它的刻度）| 数 | 比已装的那枚（变好绿、变差红）
    ui.dRows = {}
    for k = 1, 4 do
      local y = 128 + (k - 1) * 20
      local nm = K.text(pnl, "", S.tiny, "cond", C.MUTE, UD2(0, 64, 0, 16), UD2(0, 12, 0, y))
      local tr = K.frame(pnl, UD2(0, 100, 0, 2), UD2(0, 80, 0, y + 7), C.LINE, 0.88)
      local bar = K.frame(tr, UD2(0, 0, 1, 0), nil, C.TEXT, 0.1)
      local tick = K.frame(tr, UD2(0, 1, 0, 7), UD2(0, 0, 0.5, 0), C.MUTE, 0, V2(0.5, 0.5))
      tick.Name = "Ref"
      local v = K.text(pnl, "", S.tiny, "mono", C.TEXT, UD2(0, 60, 0, 16), UD2(0, 244, 0, y), RIGHT, V2(1, 0))
      local dv = K.text(pnl, "", S.tiny, "mono", C.MUTE, UD2(0, 42, 0, 16), UD2(1, -12, 0, y), RIGHT, V2(1, 0))
      dv.Name = "Diff"
      ui.dRows[k] = { nm = nm, bar = bar, v = v, tr = tr, tick = tick, dv = dv }
    end
    K.frame(pnl, UD2(0, w - 24, 0, 1), UD2(0, 12, 0, 210), C.LINE, 0.9).Name = "Sep"
    ui.dVs = {}
    local cw = (w - 24) / 6
    for k = 1, 6 do
      local x = 12 + (k - 1) * cw
      local a = K.text(pnl, "", S.tiny, "cond", C.FAINT, UD2(0, cw, 0, 14), UD2(0, x, 0, 214), CENTER)
      local b = K.text(pnl, "", S.tiny, "mono", C.TEXT, UD2(0, cw, 0, 14), UD2(0, x, 0, 230), CENTER)
      ui.dVs[k] = { a = a, b = b }
    end
    ws.detailShow(false)
  end
  local VS_KEYS = { "inf", "light", "armor", "air", "ship", "fort" }
  -- 一枚弹的四个关键数：{ 名字键, 值, 写法, 差的写法, better（1 越大越好 / −1 越小越好）, nobar（不画条：锁定时间越长越差，条的方向会反）}
  local function rowsOf(x, s)
    local n = AD.count(s, x.id)
    local sgn0 = function(v) return K.signed(v) end
    if x.kind == "tank" then
      return { { "ws.d.fuel", x.fuel * n * 100, function(v) return "+" .. math.floor(v + 0.5) .. "%" end, sgn0, 1 },
        { "ws.d.drag", x.drag * n * 100, function(v) return "-" .. math.floor(v + 0.5) .. "%" end, sgn0, -1 },
        { "ws.d.extra", AD.fuelMin(st.d, x.fuel * n), function(v) return T("ws.minutes", math.floor(v + 0.5)) end, sgn0, 1 },
        { "ws.d.shell", (FM and FM.storeMass(x, AD.M) or 0) * n, function(v) return K.int(v) .. " kg" end, sgn0, -1 } }
    elseif x.kind == "bomb" then
      return { { "ws.d.dmg", x.dmg or 0, function(v) return K.int(v) end, sgn0, 1 },
        { "ws.d.radius", (x.splash or 0) / AD.M, function(v) return K.int(v) .. " m" end, sgn0, 1 },
        { "ws.d.mass", (FM and FM.storeMass(x, AD.M) or 0) * n, function(v) return K.int(v) .. " kg" end, sgn0, -1 },
        { "ws.d.count", n, function(v) return "×" .. math.floor(v) end, sgn0, 1 } }
    elseif x.kind == "rkt" then
      return { { "ws.d.tubes", x.tubes or 1, function(v) return tostring(math.floor(v)) end, sgn0, 1 },
        { "ws.d.range", x.range or 0, function(v) return km(v) .. " km" end, function(v) return K.signed(v / AD.M / 1000, 1) end, 1 },
        { "ws.d.dmg", x.dmg or 0, function(v) return K.int(v) end, sgn0, 1 },
        { "ws.d.speed", (x.speed or 0) / AD.M, function(v) return K.int(v) .. " m/s" end, sgn0, 1 } }
    end
    return { { "ws.d.range", x.range or 0, function(v) return km(v) .. " km" end, function(v) return K.signed(v / AD.M / 1000, 1) end, 1 },
      { "ws.d.speed", (x.speed or 0) / AD.M, function(v) return K.int(v) .. " m/s" end, sgn0, 1 },
      { "ws.d.dmg", x.dmg or 0, function(v) return K.int(v) end, sgn0, 1 },
      { "ws.d.lock", x.lockTime or 0, function(v) return (v > 0) and (f1(v) .. " s") or "-" end, function(v) return K.signed(v, 1) end, -1, true } }
  end
  local function showDetail(wid)
    if compact or not ui.dRows then return end
    local w = wid and AD.W[wid]
    if not (w and st.sel) then
      ws.detailShow(false)
      return
    end
    local g = st.cards[st.sel]
    local s = st.d.st[g.st[1]]
    local cur = cardWeapon(g)
    local Wc = cur and AD.W[cur]
    ui.dName.Text = T("aw." .. wid)
    ui.dSub.Text = subOf(w, false)
    if ui.dView and ui.dView:set(wid) then
      for _, c in ipairs(ui.dPlate:GetChildren()) do if c.Name == "Art" then c:Destroy() end end
    else   -- 视口拼不出来（模块没到）：退回剪影
      local W2 = LAY.DW - 24
      K.weaponArt(ui.dPlate, wid, W2, 72, { px = K.artScale(s.opts, W2, 72, 8), col = C.TEXT })
    end
    local mine = rowsOf(w, s)
    local ref = (Wc and Wc.kind == w.kind and cur ~= wid) and rowsOf(Wc, s) or nil
    local mx = { 0, 0, 0, 0 }
    for _, o in ipairs(s.opts) do
      local x = AD.W[o]
      if x and x.kind == w.kind then
        for k, r in ipairs(rowsOf(x, s)) do mx[k] = math.max(mx[k], r[2]) end
      end
    end
    for k, r in ipairs(ui.dRows) do
      local e = mine[k]
      r.nm.Text = e and T(e[1]) or ""
      r.v.Text = e and e[3](e[2]) or ""
      local bar = e ~= nil and not e[6]
      r.tr.Visible = bar
      local rv = ref and ref[k]
      if bar then
        r.bar.Size = UD2(math.clamp(e[2] / math.max(mx[k], 1e-6), 0, 1), 0, 1, 0)
        r.tick.Visible = rv ~= nil
        if rv then r.tick.Position = UD2(math.clamp(rv[2] / math.max(mx[k], 1e-6), 0, 1), 0, 0.5, 0) end
      end
      if rv and e and math.abs(e[2] - rv[2]) > 1e-6 then
        local dd = e[2] - rv[2]
        r.dv.Text = e[4](dd)
        r.dv.TextColor3 = ((dd * (e[5] or 1)) > 0) and C.GOOD or C.BAD
      else
        r.dv.Text = ""
      end
    end
    for k, c in ipairs(ui.dVs) do
      local key = VS_KEYS[k]
      local v = w.vs and w.vs[key]
      c.a.Text = T("ws.vs." .. key)
      c.b.Text = v and ("×" .. f1(v)) or "-"
      c.b.TextColor3 = (v and v >= 1) and C.TEXT or ((v and v < 0.5) and C.FAINT or C.MUTE)
      c.a.Visible, c.b.Visible = w.kind ~= "tank", w.kind ~= "tank"
    end
    ws.detailShow(true)
  end

  ---------------------------------------------------------------- 底部条：航炮 │ 挂点卡 │ 干扰弹；上面一行：名牌、左右对称

  local FIXW = compact and 88 or 112   -- 固定卡的宽
  local function artBox()   -- 卡里那块图：y 22～58（手机 20～44）
    return compact and 20 or 22, compact and 24 or 36
  end
  local function stationCard(parent, ci, g, x, cw, px)
    local h = LAY.BH
    local cd = K.card(parent, UD2(0, cw, 0, h), UD2(0, x, 0, 0), {
      name = "Station_" .. ci,
      onEnter = function() if st and setHov then setHov(ci) end end,
      onLeave = function() if st and st.hov == ci and setHov then setHov(nil) end end,
      onClick = function() if st and selectCard then selectCard((st.sel == ci) and nil or ci) end end })
    local f = cd.f
    -- 左上编号框（同弹药栏的键位框；一对就两个 [3][8]，间距 3）
    cd.keys = {}
    local kx = 10
    for k, nstr in ipairs(g.nums) do
      local kb, kw = K.keyBox(f, nstr, kx, 6, C.MUTE, (k == 1) and "Num" or ("Num" .. k))
      cd.keys[k] = { box = kb, st = g.st[k] }
      kx += kw + 3
    end
    -- 右上：这张卡一共几枚（等宽 15）
    cd.cnt = K.text(f, "", S.body, "mono", C.TEXT, UD2(0, 40, 0, 18), UD2(1, -10, 0, 4), RIGHT, V2(1, 0))
    cd.cnt.Name = "Count"
    local ay, ah = artBox()
    cd.lb = K.lightbox(f, UD2(1, -12, 0, ah), UD2(0, 6, 0, ay))
    cd.nm = K.text(f, "", compact and S.tiny or S.small, "bold", C.TEXT, UD2(1, -20, 0, 16), UD2(0, 10, 0, compact and 47 or 63))
    cd.nm.Name = "Name"
    cd.sub = K.text(f, "", S.tiny, "bold", C.MUTE, UD2(1, -20, 0, 14), UD2(0, 10, 0, compact and 64 or 82))
    cd.sub.Name = "Sub"
    cd.g, cd.pw, cd.ph, cd.px, cd.ci = g, cw - 12, ah, px, ci
    return cd
  end
  local function fillStationCard(cd)
    local g = cd.g
    local wid, mixed = cardWeapon(g)
    local s = st.d.st[g.st[1]]
    local on = st.sel == cd.ci
    local hot = on or st.hov == cd.ci
    if wid then
      local w = AD.W[wid]
      local n = AD.count(s, wid)
      -- 一架飞机一个比例尺（长的就是长），细长的导弹最多放大到 1.6 倍（不然一根头发丝）
      local px = math.min(cd.px * 1.6, K.artScale({ wid }, cd.pw, cd.ph, 3))
      local sig = wid .. (hot and "+" or "-")
      if cd.artSig ~= sig then
        cd.artSig = sig
        K.weaponArt(cd.lb, wid, cd.pw, cd.ph, { px = px, col = hot and C.TEXT or C.MUTE })
      end
      cd.nm.Text = wname(wid) .. (mixed and " *" or "")
      cd.nm.TextColor3 = C.TEXT
      local total = 0
      for _, i in ipairs(g.st) do if st.load[i] and AD.W[st.load[i]] then total += (AD.W[st.load[i]].kind == "rkt") and 1 or AD.count(st.d.st[i], st.load[i]) end end
      cd.cnt.Text = tostring(total)
      cd.sub.Text = (w.kind == "rkt") and T("ws.tubes", w.tubes or n) or ((w.kind == "tank") and T("wcs.tank") or T("gds." .. (w.guide or "none")))
      cd:setDim(false)
    else
      cd.artSig = nil
      for _, c in ipairs(cd.lb:GetChildren()) do if c.Name == "Art" then c:Destroy() end end
      cd.nm.Text = T("ws.empty")
      cd.nm.TextColor3 = C.FAINT
      cd.cnt.Text = ""
      cd.sub.Text = mixed and T("ws.mixed") or ""
      cd:setDim(true)
    end
    cd:setSel(on)
    -- 照预设改过的挂点：编号框琥珀（看得出是哪几个改了）
    local pl = st.pk and AD.presetLoad(st.d, st.pk) or nil
    for _, kk in ipairs(cd.keys) do
      local mod = pl ~= nil and (pl[kk.st] or false) ~= (st.load[kk.st] or false)
      kk.box.TextColor3 = mod and C.WARN or C.MUTE
      local s2 = kk.box:FindFirstChildOfClass("UIStroke")
      if s2 then s2.Color = mod and C.WARN or C.MUTE end
    end
  end
  -- 名牌（卡组上面）：鼠标挂着的、没有就选着的那个挂点——「挂点 3、8 · 霹雳-15」（窄体 15 白）+「· 空空导弹 · 主动雷达」（13 灰）
  updatePlate = function()
    if not ui.plate then return end
    local ci = st.hov or st.sel
    local g = ci and st.cards[ci]
    if not g then
      ui.plate.Text = ""
      return
    end
    local wid = cardWeapon(g)
    local w = wid and AD.W[wid]
    local head = T("ws.station", g.label) .. "  ·  " .. (w and wname(wid) or T("ws.noneSub"))
    local tail = w and ("  ·  " .. subOf(w, false)) or ""
    ui.plate.Text = K.rich({ { head }, { tail, C.MUTE, S.small } }, S.body)
  end
  -- 鼠标挂着哪一张挂点卡（卡片、机身上的编号都算）：3D 白色淡轮廓、卡片描边亮、名牌
  setHov = function(ci)
    if not st then return end
    local was = st.hov
    st.hov = ci
    for _, cd in ipairs(ui.scards or {}) do
      cd:setHover(cd.ci == ci)
      if cd.ci == was or cd.ci == ci then fillStationCard(cd) end
    end
    applyHL()
    updatePlate()
  end
  local function buildBottom()
    local B = ws.bottom
    clear(B)
    clear(ws.barHead)
    ui.scards = {}
    local d = st.d
    local h = LAY.BH
    local vw = ws.vw()
    local barW = vw - 2 * LAY.M
    local ay, ah = artBox()
    local xL, xR = 0, barW
    -- 航炮（固定卡，不能点：悬停不变亮）
    if d.gun then
      local gc = K.card(B, UD2(0, FIXW, 0, h), UD2(0, 0, 0, 0), { name = "GunCard", still = true })
      K.text(gc.f, T("ws.gun"), S.tiny, "bold", C.MUTE, UD2(1, -20, 0, 14), UD2(0, 10, 0, 6)).Name = "Head"
      K.text(gc.f, tostring(d.gunAmmo or 0), S.body, "mono", C.TEXT, UD2(0, 50, 0, 18), UD2(1, -10, 0, 4), RIGHT, V2(1, 0)).Name = "Count"
      local lb = K.lightbox(gc.f, UD2(1, -12, 0, ah), UD2(0, 6, 0, ay))
      K.gunArt(lb, d.gun, FIXW - 12, ah, { col = C.MUTE })
      K.text(gc.f, wname(d.gun), compact and S.tiny or S.small, "bold", C.TEXT, UD2(1, -20, 0, 16), UD2(0, 10, 0, compact and 47 or 63)).Name = "Name"
      K.text(gc.f, T("ws.gunFixed"), S.tiny, "bold", C.FAINT, UD2(1, -20, 0, 14), UD2(0, 10, 0, compact and 64 or 82)).Name = "Sub"
      xL = FIXW + 13
      K.frame(B, UD2(0, 1, 0, h - 24), UD2(0, FIXW + 6, 0, 12), C.LINE, A.line).Name = "Div"
    end
    -- 干扰弹（固定卡；没研究：锁住、点了去改装页；研究了不能点）
    do
      local it = st.it
      local t = G.treeState and G.treeState()
      local md = t and t.mods and t.mods[st.key]
      local fx = WMd.fx(it, md and md.done)
      local locked = not fx.flares
      local fc = K.card(B, UD2(0, FIXW, 0, h), UD2(0, barW - FIXW, 0, 0), { name = "FlareCard", still = not locked, onClick = function()
        if locked and ws.openTab then ws.openTab("mods") end
      end })
      K.text(fc.f, T("ws.flares"), S.tiny, "bold", C.MUTE, UD2(1, -20, 0, 14), UD2(0, 10, 0, 6)).Name = "Head"
      if not locked then
        K.text(fc.f, tostring(d.flares or 0), S.body, "mono", C.TEXT, UD2(0, 50, 0, 18), UD2(1, -10, 0, 4), RIGHT, V2(1, 0)).Name = "Count"
      end
      local lb = K.lightbox(fc.f, UD2(1, -12, 0, ah), UD2(0, 6, 0, ay))
      K.flareArt(lb, FIXW - 12, ah, { col = locked and C.MUTE or C.MUTE, tr = locked and 0.65 or 0.1 })
      local nm = K.text(fc.f, locked and T("ws.flaresLocked") or T("ws.flaresOn"), compact and S.tiny or S.small, "bold",
        locked and C.FAINT or C.TEXT, UD2(1, -20, 0, 16), UD2(0, 10, 0, compact and 47 or 63))
      nm.Name = "Name"
      K.text(fc.f, locked and T("ws.flaresHow") or T("ws.flaresAuto"), S.tiny, "bold", locked and C.FAINT or C.MUTE, UD2(1, -20, 0, 14),
        UD2(0, 10, 0, compact and 64 or 82)).Name = "Sub"
      ui.flareLocked = locked
      xR = barW - FIXW - 13
      K.frame(B, UD2(0, 1, 0, h - 24), UD2(0, barW - FIXW - 7, 0, 12), C.LINE, A.line).Name = "Div"
    end
    -- 挂点卡：卡组的中点对准 3D 区的中点（就在飞机和编号行底下），夹在两张固定卡中间；放不下才铺满、横着卷（最后一张露出四成：看得出还能卷）
    local n = #st.cards
    local avail = xR - xL
    local GAPC = 4
    local lo, hi = compact and 80 or 88, compact and 100 or 120
    local x0f, x1f = free3d()
    local fitFree = math.floor(((x1f - x0f) - (n - 1) * GAPC) / math.max(n, 1))   -- 先试整组放在两栏中间（正好在飞机底下）
    local cw = (fitFree >= lo) and math.min(hi, fitFree) or math.clamp(math.floor((avail - (n - 1) * GAPC) / math.max(n, 1)), lo, hi)
    local need = n * cw + (n - 1) * GAPC
    local scroll = need > avail + 0.5
    if scroll then
      for k = n - 1, 1, -1 do
        cw = math.floor((avail - k * GAPC) / (k + 0.4))
        if cw >= lo then break end
      end
      cw = math.max(lo, cw)
      need = n * cw + (n - 1) * GAPC
    end
    local mid = (x0f + x1f) / 2 - LAY.M   -- 3D 区的中点（条的坐标）
    local gx = scroll and xL or math.clamp(math.floor(mid - need / 2 + 0.5), xL, math.max(xL, xR - need))
    local area = Instance.new("ScrollingFrame")
    area.Name = "Stations"
    area.BackgroundTransparency = 1
    area.BorderSizePixel = 0
    area.ScrollBarThickness = 0
    area.ScrollingDirection = Enum.ScrollingDirection.X
    area.ClipsDescendants = true
    area.Size = UD2(0, math.max(10, avail), 0, h + 4)
    area.Position = UD2(0, xL, 0, -2)
    area.CanvasSize = UD2(0, math.max(avail, (gx - xL) + need), 1, 0)
    area.Parent = B
    ui.area, ui.cardW = area, cw
    -- 一架飞机的挂点卡一个比例尺（长的弹就是长）
    local all = {}
    for _, s in ipairs(st.d.st or {}) do for _, w in ipairs(s.opts) do all[#all + 1] = w end end
    local px = K.artScale(all, cw - 12, ah, 3)
    for ci, g in ipairs(st.cards) do
      local x = (gx - xL) + (ci - 1) * (cw + GAPC)
      local cd = stationCard(area, ci, g, x, cw, px)
      cd.f.Position = UD2(0, x, 0, 2)
      cd.pos = cd.f.Position
      ui.scards[ci] = cd
      fillStationCard(cd)
    end
    if n == 0 then
      K.text(area, T("ws.noStations"), S.small, "body", C.FAINT, UD2(1, 0, 1, 0), nil, CENTER)
    end
    -- 卡组上面一行：左边名牌、右边左右对称——只在两栏中间那一段（这一行和两栏的底边一样高，伸出去就压在面板上）
    local gl = math.max(gx, x0f - LAY.M)
    local gr = math.min(scroll and xR or (gx + need), x1f - LAY.M)
    ui.plate = K.text(ws.barHead, "", S.body, "cond", C.TEXT, UD2(0, math.max(40, gr - gl - 96), 1, 0), UD2(0, gl, 0, 0))
    ui.plate.Name = "Plate"
    ui.plate.RichText = true
    ui.sym = K.check(ws.barHead, T("ws.sym"), UD2(0, gr, 0.5, 0), { name = "SymToggle", value = st.sym, h = LAY.HIT, anchor = V2(1, 0.5),
      onToggle = function(on)
        if on == st.sym then return end
        local keep = st.sel and st.cards[st.sel] and st.cards[st.sel].st[1]
        st.sym = on
        makeGroups()
        st.sel = keep and cardOfStation(keep) or nil
        st.hov = nil
        buildBottom()
        layoutLeft()
        applyHL()
      end })
    updatePlate()
  end

  ---------------------------------------------------------------- 3D 标签（每帧）

  local function buildTags()
    local layer = ws.labels
    clear(layer)
    st.tags = {}
    for i in ipairs(st.d.st or {}) do
      local tg = K.tag(layer, "Tag_" .. i, not compact)
      if not compact then
        tg.b.MouseEnter:Connect(function() if st and setHov then setHov(cardOfStation(i)) end end)
        tg.b.MouseLeave:Connect(function() if st and st.hov == cardOfStation(i) and setHov then setHov(nil) end end)
        tg.b.Activated:Connect(function()
          if not st then return end
          local ci = cardOfStation(i)
          if ci and selectCard then selectCard((st.sel == ci) and nil or ci) end
        end)
      end
      tg:show(false)
      st.tags[i] = tg
    end
  end
  -- 一行标签互相不压：先按想要的位置从左往右推开，超出右边再往左收，最后左边夹住
  local function spread(list, x0, x1, gap)
    local pos = {}
    for k, e in ipairs(list) do
      local c = e.want
      if k > 1 then c = math.max(c, pos[k - 1] + (list[k - 1].w + e.w) / 2 + gap) end
      pos[k] = c
    end
    for k = #list, 1, -1 do
      local lim = (k == #list) and (x1 - list[k].w / 2) or (pos[k + 1] - (list[k + 1].w + list[k].w) / 2 - gap)
      pos[k] = math.min(pos[k], lim)
    end
    for k = 1, #list do
      local lim = (k == 1) and (x0 + list[k].w / 2) or (pos[k - 1] + (list[k - 1].w + list[k].w) / 2 + gap)
      pos[k] = math.max(pos[k], lim)
    end
    return pos
  end
  local function wrapPi(a) return (a + math.pi) % (2 * math.pi) - math.pi end
  local function placeTags(dt)
    local A0 = G.hangarAir and G.hangarAir()
    if not (A0 and A0.key == st.key and Stage and st.anchor) then
      for _, tg in pairs(st.tags or {}) do tg:show(false) end
      return
    end
    -- 镜头动着（飞向挂点、拖着转、缩放）：0.12 秒淡掉，停稳了淡回来——一排编号不在眼前换位置
    local vs = Stage.viewState()
    local moving = vs.flying or math.abs(wrapPi(vs.yaw - vs.sy)) > 0.004 or math.abs(vs.pitch - vs.sp) > 0.004 or math.abs(vs.dist - vs.sd) > 0.08
    local want = moving and 0 or 1
    local stp = (dt or 0.016) / TH.T.hover
    st.tagAlpha = math.clamp(st.tagAlpha + math.clamp(want - st.tagAlpha, -stp, stp), 0, 1)
    local alpha = st.tagAlpha
    if alpha <= 0.01 then
      for _, tg in pairs(st.tags) do tg:show(false) end
      return
    end
    local sc = ws.scale()
    local cam = workspace.CurrentCamera
    local camX = cam and A0.cf:PointToObjectSpace(cam.CFrame.Position).X or 0
    local camSide = (camX >= 0) and 1 or -1
    local cur = previewLoad() or st.load   -- 悬停预览时，选中那一对写预览的那枚（3D 里换上的就是它）
    local gh = st.d.gearH or 6
    local x0, x1 = free3d()
    if ws.detail and ws.detail.Visible then x0 = x0 + LAY.DW + LAY.GAP end   -- 资料卡开着：它盖着的那一段也不画
    local barY = ws.barTop() - LAY.PLATE - 4
    local floorY = 0
    local pts, dots = {}, {}
    for i, tg in pairs(st.tags) do
      local a = st.anchor[i]
      local sp, z, on = Stage.toScreen(A0.cf * a)
      local used = false
      if sp and on and z > 0 then
        local x, y = sp.X / sc, sp.Y / sc
        if x >= x0 + 4 and x <= x1 - 4 and y < barY - 30 and y > LAY.TOP then
          local s = st.d.st[i]
          local ci = cardOfStation(i)
          local sel, hov = ci ~= nil and ci == st.sel, ci ~= nil and ci == st.hov
          local near = math.abs(s.pos.X) <= 1.5 or ((s.pos.X >= 0) and 1 or -1) == camSide
          if near or sel or hov then
            local fsp = Stage.toScreen(A0.cf * V3(a.X, -gh, a.Z))   -- 挂点正下方的地面：标签排在机轮着地的那条线下面，不压在起落架上
            if fsp then floorY = math.max(floorY, fsp.Y / sc) end
            local wid = cur[i]
            local nm = (sel and near) and (wid and wname(wid) or T("ws.empty")) or nil
            local num = tostring(st.num[i])
            table.insert(pts, { i = i, x = x, y = y, num = num, name = nm, w = K.tagW(num, nm), sel = sel, hov = hov, far = not near, empty = not wid })
            used = true
          elseif not st.sel then   -- 另一边：只在全景时画个淡点（选了挂点镜头凑近一边时，另一边的点挤在机身上，不画）
            table.insert(dots, { i = i, x = x, y = y })
            used = true
          end
        end
      end
      if not used then tg:show(false) end
    end
    if #pts > 0 then
      table.sort(pts, function(a, b) return a.x < b.x end)
      local maxY = 0
      for _, p in ipairs(pts) do maxY = math.max(maxY, p.y) end
      local railY = math.clamp(math.max(maxY + 30, floorY + 12), LAY.TOP + 20, barY - 16)
      for _, p in ipairs(pts) do p.want = p.x end
      local pos = spread(pts, x0, x1, 4)
      for k, p in ipairs(pts) do
        p.lx = pos[k]
        p.lvl = 0
      end
      -- 引线横着走的那一层：同一方向偏开、横段重叠的错开 4 像素（往右偏的左边那个低、往左偏的右边那个低：竖线不穿过别人的横段）
      for k = 2, #pts do
        local p, q = pts[k], pts[k - 1]
        if p.lx > p.x + 1 and q.lx > q.x + 1 and p.x < q.lx then p.lvl = q.lvl + 1 end
      end
      for k = #pts - 1, 1, -1 do
        local p, q = pts[k], pts[k + 1]
        if p.lx < p.x - 1 and q.lx < q.x - 1 and q.lx < p.x then p.lvl = q.lvl + 1 end
      end
      for _, p in ipairs(pts) do
        local tg = st.tags[p.i]
        tg:show(true)
        tg:place({ dx = p.x, dy = p.y, lx = p.lx, ly = railY, jy = railY - 8 - 4 * math.min(p.lvl, 4), num = p.num, name = p.name,
          sel = p.sel, hov = p.hov, empty = p.empty, far = p.far, alpha = alpha })
      end
    end
    for _, dd in ipairs(dots) do st.tags[dd.i]:dotOnly(dd.x, dd.y, alpha * 0.85) end
  end

  ---------------------------------------------------------------- 选挂点、悬停、装上

  selectCard = function(ci)
    if not st then return end
    closeMenu()
    st.sel = ci
    st.hoverOpt = nil
    ws.detailShow(false)
    for _, cd in ipairs(ui.scards or {}) do fillStationCard(cd) end
    layoutLeft()
    applyHL()
    updatePlate()
    if ci then stationView(ci, TH.T.cam) else overview(TH.T.cam) end
    -- 卷到选中的那张（手机上挂点卡横着卷）
    if ci and ui.area and ui.scards[ci] then
      pcall(function()
        local x = ui.scards[ci].pos.X.Offset
        local wv = ui.area.Size.X.Offset
        local cx = math.clamp(x - wv / 2 + (ui.cardW or 100) / 2, 0, math.max(0, ui.area.CanvasSize.X.Offset - wv))
        ui.area.CanvasPosition = V2(cx, 0)
      end)
    end
    show3d(st.load)
    updateRight(false)
  end
  -- 鼠标挂在一张武器卡上（on）/ 离开：右栏马上显示变化（直接换、不滚），3D 停 0.12 秒再换（扫过一列卡时不来回重搭）
  setHover = function(wid, on)
    if not st or not st.sel then return end
    st.hoverVer = (st.hoverVer or 0) + 1
    local ver = st.hoverVer
    if on then
      st.hoverOpt = wid
      updateRight(false)
      refreshListLook()
      showDetail(wid)
      task.delay(0.12, function()
        if st and st.hoverVer == ver and st.hoverOpt == wid then
          local pl = previewLoad()
          if pl then show3d(pl) end
        end
      end)
    else
      task.delay(0.06, function()
        if st and st.hoverVer == ver then
          st.hoverOpt = nil
          ws.detailShow(false)
          updateRight(false)
          refreshListLook()
          show3d(st.load)
        end
      end)
    end
  end
  -- 点一张武器卡：装上（左右对称时一对一起换）。手机：第一次点是预览（3D 换上、右栏琥珀的变化、卡上「再点一下装上」），再点一下才装上
  pickWeapon = function(wid)
    if not st or not st.sel then return end
    if compact and (st.hoverOpt == nil or (st.hoverOpt or false) ~= (wid or false)) then
      st.hoverVer = (st.hoverVer or 0) + 1
      st.hoverOpt = wid
      updateRight(false)
      refreshListLook()
      local pl = previewLoad()
      if pl then show3d(pl) end
      return
    end
    local g = st.cards[st.sel]
    local l = table.clone(st.load)
    for _, j in ipairs(g.st) do l[j] = (wid and table.find(st.d.st[j].opts, wid)) and wid or false end
    st.hoverOpt = nil
    st.hoverVer = (st.hoverVer or 0) + 1
    ws.detailShow(false)
    if not commit(l, st.pk, st.mine, st.fuel, "pair") then
      refreshListLook()
      updateRight(false)
    end
  end

  refreshAll = function(roll)
    if not st then return end
    for _, cd in ipairs(ui.scards or {}) do fillStationCard(cd) end
    if st.sel then
      refreshListLook()
      local g = st.cards[st.sel]
      local cur = g and cardWeapon(g)
      local s = g and st.d.st[g.st[1]]
      if s then
        local Wc = cur and AD.W[cur]
        local now = Wc and (wname(cur) .. ((AD.count(s, cur) > 1 and Wc.kind ~= "rkt") and (" ×" .. AD.count(s, cur)) or "")) or T("ws.emptyNow")
        ui.stPos.Text = posName(s) .. " · " .. T("ws.now", now)
      end
    else
      layoutLeft()
    end
    refreshChips()
    updateRight(roll)
    applyHL()
    updatePlate()
  end

  ---------------------------------------------------------------- 打开 / 关上 / 每帧

  function P.open(it)
    local d = AD.get(it.play)
    if not d then return false end
    local load, pk, fuel = nil, nil, 1
    if G.treeAirLoad then load, pk, fuel = G.treeAirLoad(it) end
    load = load or AD.presetLoad(d)
    local t = G.treeState and G.treeState()
    local v = t and t.load and t.load[it.key]
    local savedP = (type(v) == "table") and (type(v.p) == "string") and v.p or nil
    if type(v) == "table" and type(v.l) == "table" and not savedP then pk = nil end   -- 存过、没记预设：自定义（或我的方案）
    local D = nil
    if FM and d.kind == "jet" then D = FM.get(d.id, it.key) or (d.like and FM.get(d.like)) or nil end
    local empty = {}
    for i = 1, #(d.st or {}) do empty[i] = false end
    st = { it = it, key = it.key, d = d, D = D, jet = D ~= nil, load = load, pk = pk, fuel = AD.cleanFuel(fuel or 1), sym = true,
      sel = nil, hov = nil, hoverOpt = nil, perf = {}, shown = {}, empty = empty, tagAlpha = 0, undo = {} }
    -- 打开时正好是哪一套「我的方案」
    for i = 1, 3 do
      local sv = setOf(i)
      if not st.pk and sv and same(sv.l, st.load) and math.abs(sv.f - st.fuel) < 1e-6 then st.mine = i end
    end
    numberStations()
    makeGroups()
    G.onHangarAir = onAir
    buildLeft()
    buildRight()
    buildDetail()
    buildBottom()
    buildTags()
    layoutLeft(true)
    refreshChips()
    showUndo(false)
    show3d(st.load)
    local A0 = G.hangarAir and G.hangarAir()
    if A0 and A0.key == st.key then onAir(A0) end
    -- 弹舱打开（0.6 秒）、镜头飞到全景；标签等镜头停稳了自己淡出来
    K.anim("wsBay", 0.6, "out", function(e) poseBay(e) end)
    overview(TH.T.cam)
    updateRight(false)
    return true
  end
  function P.close(instant)
    if not st then return end
    st = nil
    closeMenu()
    K.stop("wsMount")
    K.stop("wsFlash")
    if G.onHangarAir == onAir then G.onHangarAir = nil end
    if Stage then Stage.unhighlight() end
    clear(ws.labels)
    ws.detailShow(false)
    if ui.dView then ui.dView:clear() end
    -- 3D 还原成存的那套；弹舱关上（0.3 秒）
    if G.hangarAirLoad then G.hangarAirLoad(nil) end
    if instant then
      K.stop("wsBay")
      if G.hangarAirPose then G.hangarAirPose(nil) end
    else
      K.anim("wsBay", 0.3, "out", function(e)
        if e >= 1 then
          if G.hangarAirPose then G.hangarAirPose(nil) end
        else
          poseBay(1 - e)
        end
      end)
    end
  end
  -- 退一层（Esc / 右键 / Backspace / 3D 空白处点一下）：先关小菜单 → 手机上的预览 → 选着的挂点退回全景；都没有返回 false（外壳再退出整备）
  function P.esc()
    if not st then return false end
    if ui.menu then
      closeMenu()
      return true
    end
    if compact and st.hoverOpt ~= nil then
      st.hoverOpt = nil
      st.hoverVer = (st.hoverVer or 0) + 1
      refreshListLook()
      updateRight(false)
      show3d(st.load)
      return true
    end
    if st.sel then
      selectCard(nil)
      return true
    end
    return false
  end
  function P.step(dt)
    if not st then return end
    placeTags(dt)
    if ui.dView and ws.detail and ws.detail.Visible then ui.dView:spin(dt) end
  end
  function P.refresh()   -- 存档变了（服务器推了新的 Tree：我的方案、改装研究完了）
    if not st then return end
    refreshChips()
    local t = G.treeState and G.treeState()
    local md = t and t.mods and t.mods[st.key]
    local fx = WMd.fx(st.it, md and md.done)
    if (not fx.flares) ~= ui.flareLocked then buildBottom() end
  end
  function P.relayout()
    if not st then return end
    buildBottom()
    layoutLeft(true)
  end
  -- 测试、截图用：现在的状态、点某张挂点卡 / 武器卡
  function P.state() return st end
  function P.select(ci) selectCard(ci) end
  function P.ui() return ui end
  return P
end

return WsArms
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="284">
          <Properties>
            <string name="Name">WsKit</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——整备（Workshop）共用的界面零件：面板、卡片、小块、分段键、勾选框、拖动条、对比行、引线标签、武器剪影、数字滚动
--   用户 11-27：「整个给载具配置武器的系统 做的很粗糙 我需要非常艺术经验的效果 参考战雷」——要的是同类写实军事游戏那种精致、克制、写实的质感，
--   用我们自己的界面美术（docs/style.md、Theme.lua）。卡片和战斗里的弹药栏（WtTank.lua）同一套画法：平涂深色半透明底 + 1 像素细线、圆角 2，
--   不要玻璃渐变、不抬起；选中 = 琥珀细描边 + 贴底 2 像素琥珀线；装着的那个 = 左边 2 像素白竖条（同弹药栏膛里那发）；图后面垫一块横向柔光。
--   白底只给页签和主按钮（一屏最多两块）；次级的选中（预设、内油……）用 Theme.setPicked。颜色只表意：琥珀 = 正在改 / 预览 / 改过，
--   绿 / 红只说「这次换上会变好 / 变差」，灰 = 锁住 / 空；不用蓝。中文小字一律用粗一档（K.text 自动换，docs/style.md 第 6 条）。
--   动效时长、缓动从 Theme.T / Theme.EASE 取（docs/style.md「动效」），每一处都能被打断：同一个东西再动一次，从它现在的样子接着走。
--   Workshop.lua（外壳）、WsArms.lua（挂载页）用；以后的弹药 / 改装 / 乘员 / 涂装页同一套
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UIS = game:GetService("UserInputService")
local TH = require(RS:WaitForChild("Theme"))

local K = { TH = TH }
local C, A, F, S = TH.C, TH.A, TH.F, TH.S
local UD2, V2 = UDim2.new, Vector2.new
local RIGHT = Enum.TextXAlignment.Right

---------------------------------------------------------------- 字：中文小字粗一档

-- Roboto 系（等宽、窄体）没有中文字形：13 号以下的中文退到引擎的后备字体，字重跟着 Regular / Medium 走，比 Bold 细一档（docs/style.md 第 6 条不许）——
--   K.text 建的字都按这一条：字号 ≤ 13、字里有中文、字体是窄体 / 正文的，换成 Bold；等宽的字里数字和中文混着（「巡航 18 分钟」）：开 RichText，
--   只把中文那几段包成 Builder Sans Bold，数字照旧等宽。之后改 Text 也照这条（盯着 Text 变）
local BOLD_FAMILY = "rbxasset://fonts/families/BuilderSans.json"
local function hasCJK(s)
  for _, cp in utf8.codes(s or "") do if cp >= 0x2E80 then return true end end
  return false
end
K.hasCJK = hasCJK
local function esc(s) return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;")) end
-- 一段字里的中文包成 Builder Sans Bold（RichText 的写法）；别的字照原样（转义）
local function boldCJK(s)
  local out, run, inC = {}, {}, nil
  local function flush()
    if #run == 0 then return end
    local t = esc(table.concat(run))
    if inC then t = '<font family="' .. BOLD_FAMILY .. '" weight="bold">' .. t .. "</font>" end
    out[#out + 1] = t
    run = {}
  end
  for _, cp in utf8.codes(s) do
    local c = cp >= 0x2E80
    if c ~= inC then
      flush()
      inC = c
    end
    run[#run + 1] = utf8.char(cp)
  end
  flush()
  return table.concat(out)
end
K.boldCJK = boldCJK
local function hex(c) return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
K.hex = hex
-- 几段字拼一行（RichText；标签要开 RichText）：parts = { { 字, 颜色（可选）, 字号（可选） }, … }；字号 ≤ 13 的段里的中文自动包成粗体。
--   base：这个标签自己的字号（段没写字号时按它判断大小）
function K.rich(parts, base)
  local out = {}
  for _, p in ipairs(parts) do
    local s = p[1] or ""
    if s ~= "" then
      local sz = p[3] or base or S.small
      local body = esc(s)   -- 中文小字不再自动加粗（用户 11-27「我觉得字体可以细一点」）
      local at = {}
      if p[2] then at[#at + 1] = 'color="' .. hex(p[2]) .. '"' end
      if p[3] then at[#at + 1] = 'size="' .. tostring(p[3]) .. '"' end
      if #at > 0 then body = "<font " .. table.concat(at, " ") .. ">" .. body .. "</font>" end
      out[#out + 1] = body
    end
  end
  return table.concat(out)
end
local function fitFont(t)
  local s = t.Text
  if s:find("<font", 1, true) then return end   -- 自己拼好的 RichText（K.rich / 已经包过的）
  local kind = t:GetAttribute("FK") or "body"
  -- 中文小字不再自动换粗体（用户 11-27「我觉得字体可以细一点」：整体降一档，层级靠字号、颜色，不靠加粗）
  t.Font = F[kind] or F.body
end
K.fitFont = fitFont

---------------------------------------------------------------- 基本零件

function K.frame(parent, size, pos, col, tr, anchor)
  local f = Instance.new("Frame")
  f.Size = size or UD2(1, 0, 1, 0)
  f.Position = pos or UD2(0, 0, 0, 0)
  f.AnchorPoint = anchor or V2(0, 0)
  f.BackgroundColor3 = col or C.PANEL
  f.BackgroundTransparency = tr or 0
  f.BorderSizePixel = 0
  f.Parent = parent
  return f
end
-- 字：font 是 Theme.F 的键（body / bold / title / mono / cond）；一行、放不下截掉（…）；中文小字自动粗一档（见上）
function K.text(parent, str, ts, font, col, size, pos, align, anchor)
  local t = Instance.new("TextLabel")
  t.BackgroundTransparency = 1
  t.BorderSizePixel = 0
  t.TextSize = ts or S.body
  t.Font = F[font or "body"] or F.body
  t:SetAttribute("FK", font or "body")
  t.Text = str or ""
  t.TextColor3 = col or C.TEXT
  t.TextXAlignment = align or Enum.TextXAlignment.Left
  t.TextYAlignment = Enum.TextYAlignment.Center
  t.TextTruncate = Enum.TextTruncate.AtEnd
  t.Size = size or UD2(1, 0, 0, (ts or S.body) + 4)
  t.Position = pos or UD2(0, 0, 0, 0)
  t.AnchorPoint = anchor or V2(0, 0)
  fitFont(t)
  t:GetPropertyChangedSignal("Text"):Connect(function() fitFont(t) end)
  t.Parent = parent
  return t
end
-- 透明的按钮（整块能点、自己不画东西）
function K.button(parent, size, pos, name)
  local b = Instance.new("TextButton")
  b.Name = name or "Button"
  b.Text = ""
  b.AutoButtonColor = false
  b.BackgroundTransparency = 1
  b.BorderSizePixel = 0
  b.Size = size or UD2(1, 0, 1, 0)
  b.Position = pos or UD2(0, 0, 0, 0)
  b.Parent = parent
  return b
end
local function round(f)
  local c = f:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
  c.CornerRadius = UDim.new(0.5, 0)
  c.Parent = f
  return f
end
K.round = round
-- 两点之间一根线（像素坐标，同一个父零件里）：转角度的细条（画尖角、勾这种小图形用；引线只走横竖，见 Tag:path）
function K.line(f, x1, y1, x2, y2, th)
  local dx, dy = x2 - x1, y2 - y1
  local len = math.sqrt(dx * dx + dy * dy)
  f.AnchorPoint = V2(0.5, 0.5)
  f.Size = UD2(0, math.max(1, len), 0, th or 1)
  f.Position = UD2(0, (x1 + x2) / 2, 0, (y1 + y2) / 2)
  f.Rotation = (len > 0.01) and math.deg(math.atan2(dy, dx)) or 0
  return f
end
-- 字有多宽（估算：没有 TextService 也能排版；中日韩一个字一个字号宽，英文、数字半个多一点）
function K.textW(s, ts, mono, heavy)
  local w = 0
  for _, cp in utf8.codes(tostring(s or "")) do
    if cp >= 0x2E80 then w += ts
    elseif cp == 32 then w += ts * 0.3
    else w += ts * (mono and 0.6 or (heavy and 0.66 or 0.54)) end
  end
  return w
end
-- 1,840 这种写法（数字里的负号用 ASCII 的 -：U+2212 那个减号不是每种字体都有，缺字会画成方框）
function K.int(n)
  n = math.floor((n or 0) + 0.5)
  local s = tostring(math.abs(n))
  local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
  if out:sub(1, 1) == "," then out = out:sub(2) end
  return ((n < 0) and "-" or "") .. out
end
-- 带正负号的小数：+0.0042、-60（0 写 0）
function K.signed(v, dec)
  dec = dec or 0
  local mag = string.format("%." .. dec .. "f", math.abs(v))
  if dec == 0 then mag = K.int(math.abs(v)) end
  if math.abs(v) < 0.5 * 10 ^ (-dec) then return "0" end
  return ((v < 0) and "-" or "+") .. mag
end
-- 往左的尖角（「‹ 机库」的 ‹：画两笔细线，不靠字体里有没有这个字）；size 像素高
function K.chevron(parent, x, y, size, col, th)
  local box = K.frame(parent, UDim2.new(0, size, 0, size), UDim2.new(0, x, 0, y), nil, 1)
  box.Name = "Chevron"
  local a = K.frame(box, nil, nil, col or C.TEXT, 0)
  a.Name = "Stroke"
  K.line(a, size * 0.68, size * 0.12, size * 0.28, size * 0.52, th or 1.5)
  local b = K.frame(box, nil, nil, col or C.TEXT, 0)
  b.Name = "Stroke"
  K.line(b, size * 0.28, size * 0.48, size * 0.68, size * 0.88, th or 1.5)
  return box
end
function K.tintChevron(box, col)
  for _, s in ipairs(box:GetChildren()) do if s:IsA("Frame") then s.BackgroundColor3 = col end end
end
-- 勾（「已保存」后面那个）：两笔细线，size 像素见方
function K.tick(parent, x, y, size, col, th)
  local box = K.frame(parent, UDim2.new(0, size, 0, size), UDim2.new(0, x, 0, y), nil, 1)
  box.Name = "Tick"
  K.line(K.frame(box, nil, nil, col or C.MUTE, 0), size * 0.08, size * 0.55, size * 0.38, size * 0.85, th or 1.5)
  K.line(K.frame(box, nil, nil, col or C.MUTE, 0), size * 0.34, size * 0.85, size * 0.94, size * 0.2, th or 1.5)
  return box
end
-- 加号（空着的「我的方案」）：一横一竖
function K.plus(parent, x, y, size, col)
  local box = K.frame(parent, UDim2.new(0, size, 0, size), UDim2.new(0, x, 0, y), nil, 1)
  box.Name = "Plus"
  K.frame(box, UD2(1, 0, 0, 1), UD2(0, 0, 0.5, 0), col or C.FAINT, 0, V2(0, 0.5))
  K.frame(box, UD2(0, 1, 1, 0), UD2(0.5, 0, 0, 0), col or C.FAINT, 0, V2(0.5, 0))
  return box
end
-- 键位框（同弹药栏左上那个：14 × 14、1 像素描边、等宽 12）：挂点卡的编号、空着的「我的方案」
function K.keyBox(parent, str, x, y, col, name)
  local w = math.max(14, math.floor(K.textW(str, S.tiny, true) + 6))
  local b = Instance.new("TextLabel")
  b.Name = name or "Key"
  b.BackgroundTransparency = 1
  b.BorderSizePixel = 0
  b.Text = str
  b.Font = F.mono
  b.TextSize = S.tiny
  b.TextColor3 = col or C.MUTE
  b.TextXAlignment = Enum.TextXAlignment.Center
  b.Size = UD2(0, w, 0, 14)
  b.Position = UD2(0, x, 0, y)
  b.Parent = parent
  local s = TH.stroke(b)
  s.Color, s.Transparency = col or C.MUTE, 0
  return b, w
end

---------------------------------------------------------------- 逐帧的小动画（自己插值的：数字滚动、3D 里的东西）——同一个键再来一次就从头接着走（打断）

local anims = {}
local animConn = nil
local function stepAnims(dt)
  local keys = {}
  for k in pairs(anims) do keys[#keys + 1] = k end
  for _, k in ipairs(keys) do
    local a = anims[k]
    if a then
      a.t += dt or 0.016
      local x = math.clamp(a.t / math.max(a.T, 1e-3), 0, 1)
      local ok = pcall(a.f, TH.ease(a.ease or "out", x), x)
      if (x >= 1 or not ok) and anims[k] == a then anims[k] = nil end
    end
  end
end
-- K.anim(键, 秒, 缓动键, f(缓动后的 0～1, 原始 0～1))：马上画第一帧
function K.anim(key, T, ease, f)
  local a = { t = 0, T = T or TH.T.ui, ease = ease, f = f }
  anims[key] = a
  if not animConn then animConn = RunService.RenderStepped:Connect(stepAnims) end
  pcall(f, 0, 0)
  if (T or 0) <= 0 then
    pcall(f, 1, 1)
    anims[key] = nil
  end
end
function K.stop(key) anims[key] = nil end
function K.animating(key) return anims[key] ~= nil end
-- 数字滚动（docs/style.md：数字变化 0.22 秒先快后慢）：从显示着的数滚到新的；fmt(数) → 字。只在点了装上、改内油的时候滚（悬停预览直接换：扫一列卡时右栏的数不一直转）
function K.roll(label, key, from, to, fmt)
  if type(to) ~= "number" then
    K.stop(key)
    label.Text = fmt(to)
    return
  end
  if type(from) ~= "number" or from ~= from or math.abs(from - to) < 1e-9 then
    K.stop(key)
    label.Text = fmt(to)
    return
  end
  K.anim(key, TH.T.num, "out", function(e) label.Text = fmt(from + (to - from) * e) end)
end

---------------------------------------------------------------- 面板、柔光、分节标题

-- 面板（整备的左栏、右栏）：深色底（整备 0.06：几乎不透，背后的机库横梁、地标线不压在字上），竖向一点点渐变（RAISE 渐到 BG），1 像素细线、圆角 2；
--   挡住后面的拖车（Active）
function K.panel(parent, size, pos, anchor, tr)
  local f = K.frame(parent, size, pos, Color3.new(1, 1, 1), tr or A.panel, anchor)
  f.Active = true
  TH.grad(f, C.RAISE, C.BG)
  TH.corner(f)
  TH.stroke(f)
  return f
end
-- 图后面一块横向柔光（同弹药栏 WtTank.lua：白、透明 0.92，横着 1 → 0 → 1 渐变；不描边、不圆角、不套框）：深色的弹体从暗底上分出来
function K.lightbox(parent, size, pos)
  local f = K.frame(parent, size, pos, Color3.new(1, 1, 1), 0.92)
  f.Name = "Plate"
  local g = Instance.new("UIGradient")
  g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) })
  g.Parent = f
  return f
end
K.plate = K.lightbox
-- 分节标题：13 号灰字（中文自动粗一档）+ 右边一道到头的细线（技术图纸那种）
function K.header(parent, str, y, w, x)
  x = x or 12
  local t = K.text(parent, str, S.small, "cond", C.MUTE, UD2(0, w, 0, 16), UD2(0, x, 0, y))
  t.Name = "Head"
  local tw = K.textW(str, S.small) + 8
  local ln = K.frame(parent, UD2(0, math.max(0, w - tw), 0, 1), UD2(0, x + tw, 0, y + 8), C.LINE, A.line)
  ln.Name = "HeadLine"
  return t, ln
end
-- 虚线框（「不挂」那张卡）：沿四边画 1 像素的短线；w × h 是框的像素大小
function K.dashed(parent, w, h, col, tr, dash, gap)
  local box = K.frame(parent, UD2(1, 0, 1, 0), nil, nil, 1)
  box.Name = "Dash"
  dash, gap = dash or 4, gap or 3
  local function run(len, f)
    local x = 0
    while x < len - 0.5 do
      local l = math.min(dash, len - x)
      f(x, l)
      x += dash + gap
    end
  end
  run(w, function(x, l)
    K.frame(box, UD2(0, l, 0, 1), UD2(0, x, 0, 0), col or C.LINE, tr or 0.55)
    K.frame(box, UD2(0, l, 0, 1), UD2(0, x, 1, -1), col or C.LINE, tr or 0.55)
  end)
  run(h, function(y, l)
    K.frame(box, UD2(0, 1, 0, l), UD2(0, 0, 0, y), col or C.LINE, tr or 0.55)
    K.frame(box, UD2(0, 1, 0, l), UD2(1, -1, 0, y), col or C.LINE, tr or 0.55)
  end)
  return box
end
-- 进场：一项盖一层面板色、淡开（列表一项项错开 Theme.stagger(i)，最多 8 项）；i 从 1 起
function K.reveal(f, i, dy)
  local cov = f:FindFirstChild("Reveal") or K.frame(f, UD2(1, 0, 1, 0), nil, C.PANEL, 0)
  cov.Name = "Reveal"
  cov.ZIndex = 20
  cov.BackgroundTransparency = 0
  TH.corner(cov)
  TH.tween(cov, { BackgroundTransparency = 1 }, "panel", "out", TH.stagger(i))
  if dy and dy ~= 0 then
    local p = f.Position
    f.Position = p + UD2(0, 0, 0, dy)
    TH.tween(f, { Position = p }, "panel", "out", TH.stagger(i))
  end
  return cov
end

---------------------------------------------------------------- 卡片（同弹药栏的格子）

local Card = {}
Card.__index = Card
-- 卡片（挂点卡、武器卡、固定卡）：平涂深色半透明底（PANEL 0.35）+ 1 像素细线、圆角 2；悬停描边变亮（0.82 → 0.45），不抬起；
--   选中：1 像素琥珀描边 + 贴底 2 像素琥珀线；装着的（own）：左边 2 像素白竖条；dim：空着的（底更淡 0.6）
--   o：{ name, tr 底的透明度, still = true 不能点的（固定卡：悬停不变亮）, onEnter, onLeave, onClick }
function K.card(parent, size, pos, o)
  o = o or {}
  local b = Instance.new("TextButton")
  b.Name = o.name or "Card"
  b.Text = ""
  b.AutoButtonColor = false
  b.Size, b.Position = size, pos
  b.BackgroundColor3 = C.PANEL
  b.BackgroundTransparency = o.tr or 0.35
  b.BorderSizePixel = 0
  b.Parent = parent
  TH.corner(b)
  local st = TH.stroke(b)
  local sl = K.frame(b, UD2(1, 0, 0, 2), UD2(0, 0, 1, -2), C.WARN, 0)
  sl.Name = "SelLine"
  sl.Visible = false
  sl.ZIndex = 4
  local ob = K.frame(b, UD2(0, 2, 1, 0), nil, C.TEXT, 0)
  ob.Name = "OwnBar"
  ob.Visible = false
  ob.ZIndex = 4
  local cd = setmetatable({ f = b, st = st, selLine = sl, ownBar = ob, pos = pos, sel = false, hov = false, own = false, o = o, tr = o.tr or 0.35 }, Card)
  if not o.still then
    b.MouseEnter:Connect(function()
      cd:setHover(true)
      if o.onEnter then o.onEnter(cd) end
    end)
    b.MouseLeave:Connect(function()
      cd:setHover(false)
      if o.onLeave then o.onLeave(cd) end
    end)
  end
  if o.onClick then b.Activated:Connect(function() o.onClick(cd) end) end
  return cd
end
local function cardLook(cd)
  local st = cd.st
  if cd.sel then
    st.Color = C.WARN
    TH.tween(st, { Transparency = 0 }, "hover", "out")
  else
    st.Color = C.LINE
    TH.tween(st, { Transparency = cd.hov and A.lineHi or (cd.restT or A.line) }, "hover", "hover")
  end
  cd.selLine.Visible = cd.sel
end
function Card:setSel(on)
  if self.sel == (on == true) then return end
  self.sel = on == true
  cardLook(self)
end
function Card:setHover(on)
  if self.hov == (on == true) then return end
  self.hov = on == true
  cardLook(self)
end
function Card:setOwn(on)
  self.own = on == true
  self.ownBar.Visible = self.own
end
function Card:setDim(on) self.f.BackgroundTransparency = on and 0.6 or self.tr end
function Card:move(pos)
  self.pos = pos
  self.f.Position = pos
end

---------------------------------------------------------------- 小块（方案、预设）、分段键、勾选框

local Chip = {}
Chip.__index = Chip
-- 小块（预设、我的方案）：Theme.setPicked——选中 RAISE 底 + 白细线 + 底边 2 像素白线、字白；没选中透明底 + 细线、字灰（悬停字白、线亮）；
--   照这套改过：右边一个琥珀小字「已改」
function K.chip(parent, str, size, pos, o)
  o = o or {}
  local b = Instance.new("TextButton")
  b.Name = o.name or "Chip"
  b.Text = ""
  b.AutoButtonColor = false
  b.Size, b.Position = size, pos
  b.BorderSizePixel = 0
  b.Parent = parent
  TH.corner(b)
  local pad = (size.X.Offset > 0 and size.X.Offset < 80) and 6 or 8   -- 小块窄（手机一行三个）：字的边距收一点，「防空压制」放得下
  local t = K.text(b, str, S.small, "bold", C.MUTE, UD2(1, -2 * pad, 1, 0), UD2(0, pad, 0, 0))
  t.Name = "Label"
  local mod = K.text(b, "", S.tiny, "bold", C.WARN, UD2(0, 34, 1, 0), UD2(1, -7, 0, 0), RIGHT, V2(1, 0))
  mod.Name = "Mod"
  mod.Visible = false
  local ch = setmetatable({ f = b, t = t, mod = mod, on = false, hov = false, o = o }, Chip)
  TH.setPicked(b, false)
  b.MouseEnter:Connect(function() ch:hover(true) end)
  b.MouseLeave:Connect(function() ch:hover(false) end)
  if o.onClick then b.Activated:Connect(function() o.onClick(ch) end) end
  return ch
end
function Chip:hover(on)
  self.hov = on == true
  if self.on or self.off then return end
  local s = self.f:FindFirstChildOfClass("UIStroke")
  if s then TH.tween(s, { Transparency = self.hov and A.lineHi or (self.empty and 1 or A.line) }, "hover", "hover") end
  self.t.TextColor3 = self.hov and C.TEXT or C.MUTE
end
function Chip:set(on, modTxt)
  self.on = on == true
  TH.setPicked(self.f, self.on)
  if not self.on and self.hov then self.t.TextColor3 = C.TEXT end
  self.mod.Visible = modTxt ~= nil and modTxt ~= ""
  self.mod.Text = modTxt or ""
  local pad = self.t.Position.X.Offset
  self.t.Size = UD2(1, self.mod.Visible and -46 or -2 * pad, 1, 0)
end

-- 分段键（内油 25 / 50 / 75 / 100）：一排小块（间距 4），选中的 Theme.setPicked；opts = { { key, text, name } … }；o.onPick(键)
function K.seg(parent, opts, size, pos, o)
  o = o or {}
  local box = K.frame(parent, size, pos, nil, 1)
  box.Name = o.name or "Seg"
  local n = #opts
  local gap = o.gap or 4
  local sg = { f = box, btns = {}, cur = nil, on = true }
  for i, op in ipairs(opts) do
    local b = Instance.new("TextButton")
    b.Name = op.name or ("Seg_" .. tostring(op.key))
    b.AutoButtonColor = false
    b.Text = op.text or tostring(op.key)
    b.Font = F.bold
    b.TextSize = o.ts or S.small
    b.BorderSizePixel = 0
    b.Size = UD2(1 / n, -gap * (n - 1) / n, 1, 0)
    b.Position = UD2((i - 1) / n, (i - 1) * gap / n, 0, 0)
    b.Parent = box
    TH.corner(b)
    TH.setPicked(b, false)
    b.MouseEnter:Connect(function()
      if sg.cur ~= op.key and sg.on then
        b.TextColor3 = C.TEXT
        TH.tween(b:FindFirstChildOfClass("UIStroke"), { Transparency = A.lineHi }, "hover", "hover")
      end
    end)
    b.MouseLeave:Connect(function()
      if sg.cur ~= op.key and sg.on then
        b.TextColor3 = C.MUTE
        TH.tween(b:FindFirstChildOfClass("UIStroke"), { Transparency = A.line }, "hover", "hover")
      end
    end)
    b.Activated:Connect(function() if sg.on and o.onPick then o.onPick(op.key) end end)
    sg.btns[op.key] = b
  end
  function sg.set(k)
    sg.cur = k
    for key, b in pairs(sg.btns) do TH.setPicked(b, key == k) end
  end
  function sg.enable(on)
    sg.on = on == true
    for key, b in pairs(sg.btns) do
      b.Active = sg.on
      if not sg.on and key ~= sg.cur then b.TextColor3 = C.FAINT end
    end
  end
  return sg
end

-- 勾选框（左右对称）：14 × 14 的框（1 像素灰线；勾上了里面一块 8 × 8 白）+ 一行字（粗 12 灰，悬停白）；整行能点（o.h 高：手机 44）
--   o = { name, value, h, onToggle(新的值) }
function K.check(parent, str, pos, o)
  o = o or {}
  local h = o.h or 22
  local w = math.floor(14 + 8 + K.textW(str, S.tiny) + 6)
  local b = K.button(parent, UD2(0, w, 0, h), pos, o.name or "Check")
  b.AnchorPoint = o.anchor or V2(0, 0)
  local box = K.frame(b, UD2(0, 14, 0, 14), UD2(0, 0, 0.5, -7), C.PANEL, 0.35)
  box.Name = "Box"
  TH.corner(box, 2)
  local bs = TH.stroke(box)
  bs.Color, bs.Transparency = C.MUTE, 0
  local tk = K.frame(box, UD2(0, 8, 0, 8), UD2(0.5, 0, 0.5, 0), C.TEXT, 0, V2(0.5, 0.5))
  tk.Name = "On"
  local t = K.text(b, str, S.tiny, "bold", C.MUTE, UD2(1, -22, 1, 0), UD2(0, 22, 0, 0))
  t.Name = "Label"
  local ck = { f = b, on = false, w = w }
  function ck.set(on)
    ck.on = on == true
    tk.Visible = ck.on
    bs.Color = ck.on and C.TEXT or C.MUTE
  end
  b.MouseEnter:Connect(function() t.TextColor3 = C.TEXT end)
  b.MouseLeave:Connect(function() t.TextColor3 = C.MUTE end)
  b.Activated:Connect(function() if o.onToggle then o.onToggle(not ck.on) end end)
  ck.set(o.value)
  return ck
end

---------------------------------------------------------------- 拖动条（配弹：一种弹带几发；以后的弹药页用）

-- 轨道 4 高、填充 TEXT、滑块 10 × 16（悬停 / 拖着时琥珀描边）、每 tick 一道刻度；左右 26 × 26 的 − / +（透明底细线）；右边数目（等宽 17）；
--   lock：别的弹已经占掉的那一截（画 FAINT，拖不进去）；o = { w 轨道宽, min, max, step, tick, value, lock, onChange(数) }
function K.slider(parent, pos, o)
  local w = o.w or 172
  local box = K.frame(parent, UD2(0, w + 26 * 2 + 12 + 40, 0, 26), pos, nil, 1)
  box.Name = o.name or "Slider"
  local sl = { f = box, v = o.value or 0, min = o.min or 0, max = o.max or 10, step = o.step or 1, lock = o.lock or 0 }
  local function btn(x, s, name)
    local b = Instance.new("TextButton")
    b.Name = name
    b.Text = s
    b.Font = F.bold
    b.TextSize = S.body
    b.TextColor3 = C.TEXT
    b.AutoButtonColor = false
    b.BackgroundColor3 = C.RAISE
    b.BackgroundTransparency = 1
    b.BorderSizePixel = 0
    b.Size = UD2(0, 26, 0, 26)
    b.Position = UD2(0, x, 0, 0)
    b.Parent = box
    TH.corner(b)
    TH.stroke(b)
    b.MouseEnter:Connect(function() b.BackgroundTransparency = 0.1 end)
    b.MouseLeave:Connect(function() b.BackgroundTransparency = 1 end)
    return b
  end
  local minus = btn(0, "", "Minus")
  K.frame(minus, UD2(0, 10, 0, 2), UD2(0.5, 0, 0.5, 0), C.TEXT, 0, V2(0.5, 0.5)).Name = "Bar"   -- 减号画出来（U+2212 不是每种字体都有）
  local x0 = 26 + 6
  local track = K.frame(box, UD2(0, w, 0, 4), UD2(0, x0, 0.5, -2), C.LINE, 0.85)
  track.Name = "Track"
  local lockF = K.frame(track, UD2(0, 0, 1, 0), UD2(1, 0, 0, 0), C.FAINT, 0.2, V2(1, 0))
  lockF.Name = "Locked"
  local fill = K.frame(track, UD2(0, 0, 1, 0), nil, C.TEXT, 0)
  fill.Name = "Fill"
  local ticks = K.frame(box, UD2(0, w, 0, 4), UD2(0, x0, 0.5, 4), nil, 1)
  ticks.Name = "Ticks"
  local thumb = Instance.new("TextButton")
  thumb.Name = "Thumb"
  thumb.Text = ""
  thumb.AutoButtonColor = false
  thumb.BackgroundColor3 = C.TEXT
  thumb.BorderSizePixel = 0
  thumb.Size = UD2(0, 10, 0, 16)
  thumb.AnchorPoint = V2(0.5, 0.5)
  thumb.Parent = box
  TH.corner(thumb)
  local tst = TH.stroke(thumb, true, C.WARN)
  tst.Transparency = 1
  tst.Thickness = 1.5
  local plus = btn(x0 + w + 6, "+", "Plus")
  local num = K.text(box, "", S.sub, "mono", C.TEXT, UD2(0, 40, 1, 0), UD2(0, x0 + w + 6 + 26 + 6, 0, 0), RIGHT)
  num.Name = "Count"
  local function draw()
    local span = math.max(1, sl.max - sl.min)
    local k = math.clamp((sl.v - sl.min) / span, 0, 1)
    fill.Size = UD2(k, 0, 1, 0)
    lockF.Size = UD2(math.clamp(sl.lock / span, 0, 1), 0, 1, 0)
    thumb.Position = UD2(0, x0 + k * w, 0.5, 0)
    num.Text = tostring(sl.v)
  end
  local function setTicks()
    ticks:ClearAllChildren()
    local tk = o.tick or 5
    local span = math.max(1, sl.max - sl.min)
    if tk > 0 and span / tk <= 40 then
      for v = sl.min, sl.max, tk do
        K.frame(ticks, UD2(0, 1, 0, 3), UD2((v - sl.min) / span, 0, 0, 0), C.LINE, 0.7).Name = "Tick"
      end
    end
  end
  function sl.set(v, quiet)
    local hi = sl.max - sl.lock
    v = math.clamp(math.floor((v or 0) / sl.step + 0.5) * sl.step, sl.min, math.max(sl.min, hi))
    local was = sl.v
    sl.v = v
    draw()
    if not quiet and v ~= was and o.onChange then o.onChange(v) end
  end
  function sl.get() return sl.v end
  function sl.setLock(n)
    sl.lock = math.max(0, n or 0)
    sl.set(sl.v, true)
  end
  function sl.range(lo, hi)
    sl.min, sl.max = lo, hi
    setTicks()
    sl.set(sl.v, true)
  end
  minus.Activated:Connect(function() sl.set(sl.v - sl.step) end)
  plus.Activated:Connect(function() sl.set(sl.v + sl.step) end)
  -- 拖：按住滑块或轨道，鼠标的横坐标换成数（按轨道在屏幕上的位置算）
  local drag = false
  local function fromX(px)
    local ok, a, sz = pcall(function() return track.AbsolutePosition, track.AbsoluteSize end)
    if not ok or not a or sz.X <= 0 then return end
    sl.set(sl.min + (px - a.X) / sz.X * (sl.max - sl.min))
  end
  thumb.MouseEnter:Connect(function() TH.tween(tst, { Transparency = 0 }, "hover", "hover") end)
  thumb.MouseLeave:Connect(function() if not drag then TH.tween(tst, { Transparency = 1 }, "hover", "hover") end end)
  thumb.MouseButton1Down:Connect(function() drag = true end)
  UIS.InputEnded:Connect(function(io)
    if drag and (io.UserInputType == Enum.UserInputType.MouseButton1 or io.UserInputType == Enum.UserInputType.Touch) then
      drag = false
      TH.tween(tst, { Transparency = 1 }, "hover", "hover")
    end
  end)
  UIS.InputChanged:Connect(function(io)
    if drag and (io.UserInputType == Enum.UserInputType.MouseMovement or io.UserInputType == Enum.UserInputType.Touch) then fromX(io.Position.X) end
  end)
  setTicks()
  draw()
  return sl
end

---------------------------------------------------------------- 对比行（右栏的性能：空挂 vs 现在；悬停时 现在 vs 换上）

-- 一行：左边名字（13 灰，中文粗一档）；右边三列——第一列（等宽 13 淡：平时「空挂」、悬停时「现在」）、→、第二列（等宽 15：平时「现在」白、
--   悬停时「换上」琥珀）、差（等宽 13）。平时差值灰（挂弹的代价，不是警告）；悬停预览时差 = 换上 − 现在，变好绿、变差红。
--   不画条（数都在 97%～100%，条长看不出区别；数字比条重要）；行底一道 1 像素细线。narrow（手机）：只写第二列和差
local Cmp = {}
Cmp.__index = Cmp
K.CMP_COLS = { base = -130, cur = -56 }   -- 第一列、第二列的右边（离行右边多远）：列名那一行照这个对齐
function K.compare(parent, y, w, label, x, narrow, rh)
  x = x or 12
  rh = rh or 26
  local row = K.frame(parent, UD2(0, w, 0, rh), UD2(0, x, 0, y), nil, 1)
  row.Name = "Cmp"
  local nm = K.text(row, label, S.small, "cond", C.MUTE, UD2(0, w - (narrow and 112 or 172), 1, -1), UD2(0, 0, 0, 0))
  nm.Name = "Name"
  local delta = K.text(row, "", S.small, "mono", C.MUTE, UD2(0, 46, 1, -1), UD2(1, 0, 0, 0), RIGHT, V2(1, 0))
  delta.Name = "Delta"
  local vb = K.text(row, "", S.body, "mono", C.TEXT, UD2(0, 66, 1, -1), UD2(1, narrow and -54 or K.CMP_COLS.cur, 0, 0), RIGHT, V2(1, 0))
  vb.Name = "Val"
  local va = K.text(row, "", S.small, "mono", C.FAINT, UD2(0, 56, 1, -1), UD2(1, K.CMP_COLS.base, 0, 0), RIGHT, V2(1, 0))
  va.Name = "Base"
  local arrow = K.text(row, "→", S.small, "mono", C.FAINT, UD2(0, 12, 1, -1), UD2(1, K.CMP_COLS.base + 6, 0, 0))
  arrow.Name = "Arrow"
  arrow.Visible, va.Visible = not narrow, not narrow
  local sep = K.frame(row, UD2(1, 0, 0, 1), UD2(0, 0, 1, -1), C.LINE, 0.92)
  sep.Name = "Sep"
  return setmetatable({ f = row, nm = nm, delta = delta, vb = vb, va = va, arrow = arrow, narrow = narrow,
    key = tostring(row) .. tostring(math.random()) }, Cmp)
end
-- base 空挂、cur 现在、pv 悬停预览（nil 不预览）；o = { fmt(数) → 字, dfmt(差) → 字, better = 1 越大越好 / −1 越小越好, eps, roll = true 数字滚动（点了装上、改内油） }
--   没变（空挂 = 现在、没在预览）：只写一个数（「极速 284」，不写「284 → 284」）
function Cmp:set(base, cur, pv, o)
  local fmt = o.fmt
  local dfmt = o.dfmt or function(v) return K.signed(v) end
  local eps = o.eps or 1e-6
  local better = o.better or 1
  local prev = pv ~= nil
  local from = prev and cur or base
  local to = prev and pv or cur
  local d = to - from
  local flat = (not prev) and math.abs(d) < eps
  self.va.Visible = not self.narrow and not flat
  self.arrow.Visible = not self.narrow and not flat
  self.va.Text = fmt(from)
  if prev or not o.roll then
    K.stop(self.key .. "v")
    self.vb.Text = fmt(to)
  else
    K.roll(self.vb, self.key .. "v", self.shown, to, fmt)
  end
  self.shown = to
  self.vb.TextColor3 = prev and C.WARN or C.TEXT
  self.delta.Text = (math.abs(d) < eps) and "" or dfmt(d)
  if prev and math.abs(d) >= eps and better ~= 0 then
    self.delta.TextColor3 = ((d * better) > 0) and C.GOOD or C.BAD
  else
    self.delta.TextColor3 = C.MUTE
  end
end
-- 只写一个数（没有对比的行）
function Cmp:plain(txt, col)
  self.va.Text, self.delta.Text = "", ""
  self.va.Visible, self.arrow.Visible = false, false
  K.stop(self.key .. "v")
  self.vb.Text = txt
  self.vb.TextColor3 = col or C.TEXT
end

---------------------------------------------------------------- 引线标签（3D 挂点：一个点、只走横竖的引线、一个 14 高的键位框「3」；选中的后面跟名字）

local Tag = {}
Tag.__index = Tag
-- clickable：手机上 false（标签太小，点底部的挂点卡）
function K.tag(layer, name, clickable)
  local dot = K.frame(layer, UD2(0, 6, 0, 6), nil, C.TEXT, 0, V2(0.5, 0.5))
  dot.Name = "Dot"
  round(dot)
  local ring = Instance.new("UIStroke")
  ring.Color, ring.Thickness, ring.Transparency = C.FAINT, 1, 1
  ring.Parent = dot
  local b = Instance.new("TextButton")
  b.Name = name or "Tag"
  b.AutoButtonColor = false
  b.Text = ""
  b.BackgroundColor3 = C.PANEL
  b.BackgroundTransparency = 0.35
  b.BorderSizePixel = 0
  b.Size = UD2(0, 20, 0, 14)
  b.Active = clickable ~= false
  b.Interactable = clickable ~= false
  b.Parent = layer
  TH.corner(b, 2)
  local st = TH.stroke(b)
  st.Transparency = A.lineHi
  local num = K.text(b, "", S.tiny, "mono", C.MUTE, UD2(0, 24, 1, 0), UD2(0, 5, 0, 0))
  num.Name = "Num"
  local nm = K.text(b, "", S.tiny, "bold", C.WARN, UD2(0, 90, 1, 0), UD2(0, 20, 0, 0))
  nm.Name = "Name"
  nm.Visible = false
  return setmetatable({ dot = dot, ring = ring, b = b, st = st, num = num, nm = nm, segs = {}, layer = layer, txt = nil, nameT = nil, w = 20 }, Tag)
end
function Tag:show(on)
  self.dot.Visible, self.b.Visible = on, on
  if not on then for _, f in ipairs(self.segs) do f.Visible = false end end
end
-- 一条只走横竖的折线（pts：{ { x, y }, … }，像素坐标取整）；dashed：机身另一边的（虚线：3 实 3 空）
function Tag:path(pts, col, tr, dashed)
  local k = 0
  local function seg(x, y, w, h)
    k += 1
    local f = self.segs[k]
    if not f then
      f = K.frame(self.layer, nil, nil, C.MUTE, 0)
      f.Name = "Leader"
      self.segs[k] = f
    end
    f.Visible = true
    f.Position = UD2(0, x, 0, y)
    f.Size = UD2(0, w, 0, h)
    f.BackgroundColor3 = col
    f.BackgroundTransparency = tr
  end
  for i = 1, #pts - 1 do
    local a, b = pts[i], pts[i + 1]
    local x0, y0 = math.floor(math.min(a[1], b[1]) + 0.5), math.floor(math.min(a[2], b[2]) + 0.5)
    local x1, y1 = math.floor(math.max(a[1], b[1]) + 0.5), math.floor(math.max(a[2], b[2]) + 0.5)
    local horiz = (y1 - y0) < (x1 - x0)
    local len = horiz and (x1 - x0) or (y1 - y0)
    if len >= 1 then
      if dashed then
        local t = 0
        while t < len do
          local l = math.min(3, len - t)
          if horiz then seg(x0 + t, y0, l, 1) else seg(x0, y0 + t, 1, l) end
          t += 6
        end
      elseif horiz then
        seg(x0, y0, len + 1, 1)
      else
        seg(x0, y0, 1, len + 1)
      end
    end
  end
  for j = k + 1, #self.segs do self.segs[j].Visible = false end
end
-- 标签多宽（编号 + 选中时的名字）
function K.tagW(num, name)
  local w = math.floor(K.textW(num, S.tiny, true) + 10)
  if name and name ~= "" then w += math.floor(K.textW(name, S.tiny) + 6) end
  return math.max(16, w)
end
-- 摆：o = { dx, dy 挂点在画面上的位置；lx 标签中点、ly 标签上沿；jy 引线横着走的那一层；num 编号；name 名字（选中时才给）；
--   sel 选中（琥珀，永远不淡）、hov 鼠标挂着（白）、empty 空挂点（淡、空心点）、far 在机身另一边（虚线引线）、alpha 整体（镜头动着时淡掉）}
--   引线：从点竖着落到 jy、横着走到标签中点、再竖着落进标签（不出斜线）
function Tag:place(o)
  local a = math.clamp(o.alpha or 1, 0, 1)
  local tr = 1 - a
  local col = o.sel and C.WARN or (o.empty and C.FAINT or (o.hov and C.TEXT or C.MUTE))
  local dotC = o.sel and C.WARN or (o.empty and C.FAINT or C.TEXT)
  self.dot.Position = UD2(0, math.floor(o.dx + 0.5), 0, math.floor(o.dy + 0.5))
  self.dot.Size = o.sel and UD2(0, 7, 0, 7) or UD2(0, 6, 0, 6)
  self.dot.BackgroundColor3 = dotC
  self.dot.BackgroundTransparency = o.empty and 1 or tr
  self.ring.Color = dotC
  self.ring.Transparency = o.empty and (0.1 + 0.9 * tr) or 1
  local lcol = o.sel and C.WARN or (o.far and C.FAINT or C.MUTE)
  local ltr = o.sel and (0.15 + 0.85 * tr) or ((o.far and 0.2 or 0.45) + (o.far and 0.8 or 0.55) * tr)
  self:path({ { o.dx, o.dy + 4 }, { o.dx, o.jy }, { o.lx, o.jy }, { o.lx, o.ly } }, lcol, ltr, o.far)
  if self.txt ~= o.num or self.nameT ~= (o.name or "") then
    self.txt, self.nameT = o.num, o.name or ""
    self.num.Text = o.num
    self.nm.Text = self.nameT
    self.nm.Visible = self.nameT ~= ""
    local nw = math.floor(K.textW(o.num, S.tiny, true))
    self.num.Size = UD2(0, nw + 2, 1, 0)
    self.nm.Position = UD2(0, 5 + nw + 6, 0, 0)
    self.w = K.tagW(o.num, o.name)
  end
  self.b.Size = UD2(0, self.w, 0, 14)
  self.b.Position = UD2(0, math.floor(o.lx - self.w / 2 + 0.5), 0, math.floor(o.ly + 0.5))
  self.b.BackgroundTransparency = 0.35 + 0.65 * tr
  self.num.TextColor3 = col
  self.num.TextTransparency = tr
  self.nm.TextColor3 = C.WARN
  self.nm.TextTransparency = tr
  self.st.Color = o.sel and C.WARN or (o.hov and C.TEXT or C.LINE)
  self.st.Transparency = o.sel and tr or ((o.hov and 0.2 or A.lineHi) + (1 - (o.hov and 0.2 or A.lineHi)) * tr)
end
-- 只画一个点（全景时机身另一边的挂点：4 像素淡点，不写编号）
function Tag:dotOnly(dx, dy, alpha)
  self.b.Visible = false
  for _, f in ipairs(self.segs) do f.Visible = false end
  self.dot.Visible = true
  self.dot.Position = UD2(0, math.floor(dx + 0.5), 0, math.floor(dy + 0.5))
  self.dot.Size = UD2(0, 4, 0, 4)
  self.dot.BackgroundColor3 = C.FAINT
  self.dot.BackgroundTransparency = 1 - math.clamp(alpha or 1, 0, 1)
  self.ring.Transparency = 1
end

---------------------------------------------------------------- 武器剪影（这一轮先用单色剪影顶上，下一轮换 Blender 渲的图：tools/models/ammopics_blender.py 那条管线）
-- 照弹药栏（WtTank.lua）剪影的笔法：横放、弹头朝右、单色；尺寸按真弹的外形（AirDefs.W[...].shape：弹长 L、弹径 d，格），
--   弹头样式、尾翼 / 弹翼 / 鸭翼的位置和大小、炸弹尾翼套件、火箭巢、副油箱按 WeaponModels 的描述（同一枚弹在 3D 里、剪影里一个样子）。
--   不用圆角拼（圆滚滚的胶囊就是卡通）：雷达罩、炸弹头、副油箱两头、火箭巢整流罩都是 2～4 段递减的矩形（d → 0.78d → 0.5d……）拼出锥形 / 卵形。
--   一个挂点挂几枚只画一枚（几枚写在卡片右上角）；平时灰（MUTE）、选中和悬停的那张白（调用的地方给 col）。
--   px：每格多少像素——同一个挂点的几种弹、同一架飞机的挂点卡一个比例尺（长的就是长、粗的就是粗，像一张弹药识别图）
local WM, AD = nil, nil
local function libs()
  if not WM then
    local ok, m = pcall(function() return require(RS:WaitForChild("WeaponModels", 5)) end)
    WM = ok and m or false
  end
  if not AD then
    local ok, m = pcall(function() return require(RS:WaitForChild("AirDefs", 5)) end)
    AD = ok and m or false
  end
  return WM or nil, AD or nil
end
K.libs = libs
local function descOf(wid, w)
  local wm = libs()
  local d = wm and wm.D and wm.D[wid]
  if d then return d end
  if w and w.kind == "bomb" then return { nose = "bomb", kit = "mk" } end
  if w and w.kind == "tank" then return { tank = true } end
  if w and w.kind == "rkt" then return { pod = true } end
  return { nose = "radar", tail = { at = 0.92, c = 0.09, s = 2 } }
end
-- 剪影一共多长、多高（格：高算上上下的翼面）——给 K.artScale 定比例尺
function K.artExtent(wid)
  local _, ad = libs()
  local w = ad and ad.W[wid]
  if not w then return 6, 1 end
  local sh = w.shape or { L = 5, d = 0.6 }
  local L, d = sh.L, sh.d
  local ds = descOf(wid, w)
  if ds.tank or ds.pod then return L, d * 1.15 end
  if w.kind == "bomb" then return L, d * ((ds.kit == "paveway") and 2.3 or ((ds.kit == "jdam") and 1.7 or 1.35)) end
  local s = 0
  for _, F0 in ipairs({ ds.tail, ds.mid, ds.can }) do
    if F0 then s = math.max(s, F0.strake and F0.s * 0.4 or F0.s) end
  end
  return L, d * (1 + 2 * 0.707 * s)
end
-- 这几种弹放进 w × h 的框（四周留 pad 像素）用多大的比例尺：最长 / 最高的那种正好放下
function K.artScale(wids, w, h, pad)
  pad = pad or 3
  local px = 1e9
  for _, wid in ipairs(wids) do
    if wid then
      local L, H = K.artExtent(wid)
      px = math.min(px, (w - 2 * pad) / math.max(L, 0.1), (h - 2 * pad) / math.max(H, 0.05))
    end
  end
  return (px < 1e8) and px or 4
end
-- 在 box（w × h 像素）里画 wid 的剪影：o = { px 比例尺, col 颜色（默认 MUTE）, tr 透明度（默认 0.1）, dx, dy }
function K.weaponArt(box, wid, w, h, o)
  o = o or {}
  for _, c in ipairs(box:GetChildren()) do if c.Name == "Art" then c:Destroy() end end
  local _, ad = libs()
  local W0 = ad and ad.W[wid]
  if not W0 then return nil end
  local px = o.px or K.artScale({ wid }, w, h)
  local col = o.col or C.MUTE
  local tr0 = o.tr or 0.1
  local cut = C.BG
  local art = K.frame(box, UD2(1, 0, 1, 0), nil, nil, 1)
  art.Name = "Art"
  local sh = W0.shape or { L = 5, d = 0.6 }
  local L, d = sh.L, sh.d
  local ds = descOf(wid, W0)
  local x0 = (w - L * px) / 2 + (o.dx or 0)
  local yc = h / 2 + (o.dy or 0)
  local function X(x) return x0 + x * px end
  local function Y(y) return yc - y * px end
  local function tr(t) return t or tr0 end
  -- 一块：x 从 a 到 b（格，从弹尾量起）、中心高 y、高 hh
  local function blk(a, b, y, hh, t, c2)
    local wp = math.max(1, (b - a) * px)
    local hp = math.max(1, hh * px)
    return K.frame(art, UD2(0, wp, 0, hp), UD2(0, X((a + b) / 2), 0, Y(y)), c2 or col, tr(t), V2(0.5, 0.5))
  end
  -- 一串递减的段（从 a 往 b 收细：steps = { { 占这一串的比例, 粗细（× d）}, … }）：锥形、卵形的头 / 尾
  local function taper(a, b, steps, t)
    local x = a
    for _, sp in ipairs(steps) do
      local x2 = x + (b - a) * sp[1]
      blk(math.min(x, x2), math.max(x, x2), 0, d * sp[2], t)
      x = x2
    end
  end
  local function ln(xa, ya, xb, yb, th, t)
    local f = K.frame(art, nil, nil, col, tr(t))
    K.line(f, X(xa), Y(ya), X(xb), Y(yb), math.max(1, th or 1))
    return f
  end
  -- 后掠的三角翼：后缘竖着在 xa、翼根贴着弹体表面 y0（从 xa 到前面的 xb）、翼尖在 (xa, y0 + 方向 × hh)
  local function fin(xa, xb, y0, hh, dir, t)
    local ch = math.abs(xb - xa)
    blk(xa, xa + math.max(ch * 0.2, 1 / px), y0 + dir * hh / 2, hh, t)
    blk(xa, xa + ch * 0.5, y0 + dir * hh / 4, hh / 2, t)
    ln(xb, y0, xa, y0 + dir * hh, math.max(1, math.min(ch, hh) * px * 0.3), t)
  end
  local function band(at, frac)   -- 弹体上的环带：暗一道
    local x = L - at * L
    local bw = math.max(frac * L, 1 / px)
    blk(x - bw / 2, x + bw / 2, 0, d * 0.98, 0.45, cut)
  end
  if ds.tank then   -- 副油箱：中段直筒，两头一段段收尖；两道焊缝；有的尾部小安定面
    blk(L * 0.24, L * 0.76, 0, d)
    taper(L * 0.76, L, { { 0.4, 0.8 }, { 0.35, 0.56 }, { 0.25, 0.28 } })
    taper(L * 0.24, 0, { { 0.42, 0.82 }, { 0.33, 0.58 }, { 0.25, 0.32 } })
    band(0.47, 0.006)
    band(0.27, 0.006)
    if ds.fins then
      fin(L * 0.04, L * 0.17, -d * 0.22, d * 0.34, -1, 0.2)
      fin(L * 0.04, L * 0.17, d * 0.22, d * 0.24, 1, 0.3)
    end
    return art
  end
  if ds.pod then   -- 火箭巢：粗圆筒、前后整流罩（两段收细）、前端发射管口那一面、一道环带、两排管子的影子
    blk(L * 0.12, L * 0.86, 0, d)
    taper(L * 0.86, L, { { 0.62, 0.86 }, { 0.38, 0.66 } })
    taper(L * 0.12, 0, { { 0.55, 0.86 }, { 0.45, 0.62 } })
    blk(L * 0.985, L, 0, d * 0.62, 0.3, cut)
    band(0.3, 0.035)
    for _, yy in ipairs({ -0.22, 0.22 }) do blk(L * 0.16, L * 0.84, yy * d, math.max(1 / px, d * 0.05), 0.72, cut) end
    return art
  end
  if W0.kind == "bomb" then
    local nose = ds.nose or "bomb"
    if nose == "laser" then   -- 激光制导炸弹：战斗部、细脖子上的导引头（两段）、四片鸭翼
      blk(L * 0.2, L * 0.7, 0, d)
      taper(L * 0.7, L * 0.82, { { 0.5, 0.9 }, { 0.5, 0.72 } })
      blk(L * 0.82, L * 0.92, 0, d * 0.5)
      taper(L * 0.92, L, { { 0.6, 0.56 }, { 0.4, 0.38 } })
      for _, dir in ipairs({ 1, -1 }) do fin(L * 0.83, L * 0.9, dir * d * 0.25, d * 0.34, dir, 0.18) end
    else   -- 普通炸弹 / 卫星制导：卵形头（一段段收细；制导的前面一个引信）
      blk(L * 0.22, L * 0.7, 0, d)
      taper(L * 0.7, L * 0.985, { { 0.34, 0.92 }, { 0.26, 0.78 }, { 0.22, 0.56 }, { 0.18, 0.32 } })
      if nose == "jdam" then blk(L * 0.97, L, 0, d * 0.2) end
    end
    for _, b in ipairs(ds.bands or {}) do band(b[1], b[2]) end
    local kit = ds.kit or "mk"
    if kit == "mk" then   -- 低阻尾锥 + 方尾翼
      blk(L * 0.1, L * 0.23, 0, d * 0.8)
      blk(L * 0.02, L * 0.11, 0, d * 0.52)
      for _, dir in ipairs({ 1, -1 }) do blk(L * 0.01, L * 0.18, dir * d * 0.42, d * 0.36, 0.25) end
    elseif kit == "jdam" or kit == "sdb" then   -- 卫星制导尾翼套件：尾段、四片长尾翼、弹体边条
      blk(L * 0.01, L * 0.25, 0, d * 0.86)
      blk(L * -0.005, L * 0.015, 0, d * 0.6)
      local fh = d * ((kit == "sdb") and 0.42 or 0.62) * 0.707
      for _, dir in ipairs({ 1, -1 }) do
        fin(L * 0.01, L * 0.17, dir * d * 0.43, fh, dir, 0.15)
        if kit == "jdam" then blk(L * 0.37, L * 0.67, dir * d * 0.52, math.max(d * 0.08, 1 / px), 0.3) end
      end
    elseif kit == "paveway" then   -- 激光制导炸弹的大尾翼
      blk(L * 0.0, L * 0.2, 0, d * 0.7)
      for _, dir in ipairs({ 1, -1 }) do blk(L * 0.0, L * 0.2, dir * d * 0.6, d * 0.58, 0.28) end
    end
    if ds.wing then   -- 折叠弹翼（雷石-6、小直径炸弹）：挂着时折在弹体上面
      local Wd = ds.wing
      local xc = L - Wd.at * L - Wd.span * 0.2
      blk(xc - Wd.span * 0.25, xc + Wd.span * 0.25, d * 0.58, math.max(0.1, 1 / px), 0.12)
    end
    return art
  end
  -- 导弹（空空 / 空地 / 地空）
  local nose = ds.nose or "radar"
  local noseL = (nose == "radar" or nose == "arm") and L * 0.16 or L * 0.09
  blk(L * 0.012, L - noseL, 0, d)
  blk(0, L * 0.02, 0, d * 0.66)   -- 尾喷口
  if nose == "radar" or nose == "arm" then   -- 雷达罩：细长的尖头（四段收细）
    taper(L - noseL, L, { { 0.34, 0.84 }, { 0.3, 0.62 }, { 0.22, 0.4 }, { 0.14, 0.18 } })
  elseif nose == "laser" then   -- 激光：细一点的导引头
    taper(L - noseL, L, { { 0.55, 0.84 }, { 0.45, 0.6 } })
  else   -- 红外 / 电视：短的玻璃罩（三段收圆）
    taper(L - noseL, L, { { 0.5, 0.82 }, { 0.32, 0.58 }, { 0.18, 0.3 } })
  end
  for _, b in ipairs(ds.bands or {}) do band(b[1], b[2]) end
  local function fins(Fd)
    if not Fd then return end
    local xc = L - Fd.at * L
    local ch = Fd.c * L
    local sp = Fd.s * d * 0.707   -- X 形的四片：侧面看上下各一片，展长 × cos 45°
    for _, dir in ipairs({ 1, -1 }) do
      if Fd.grid then   -- 栅格翼（R-77）：一个细框
        local f = blk(xc - ch / 2, xc + ch / 2, dir * (d / 2 + sp / 2), sp, 1)
        local s = Instance.new("UIStroke")
        s.Color, s.Thickness, s.Transparency = col, 1, tr(0.15)
        s.Parent = f
      elseif Fd.strake then   -- 长边条：贴着弹体的细长翼
        blk(xc - ch / 2, xc + ch / 2, dir * (d / 2 + sp * 0.2), sp * 0.4, 0.22)
      else
        fin(xc - ch / 2, xc + ch / 2, dir * d / 2, sp, dir, 0.15)
      end
    end
  end
  fins(ds.tail)
  fins(ds.mid)
  fins(ds.can)
  if ds.wing then   -- 巡航弹的折叠弹翼（KD-88、鹰击-83K）：挂着时折在弹体上面
    local Wd = ds.wing
    local xc = L - Wd.at * L - Wd.span * 0.2
    blk(xc - Wd.span * 0.25, xc + Wd.span * 0.25, d * 0.58, math.max(0.1, 1 / px), 0.12)
  end
  return art
end
-- 机炮（航炮固定卡）：机匣、一根或几根炮管、炮口、供弹槽；几管按型号
local GUN_BARRELS = { m61 = 3, gau8 = 3, gau22 = 3, m134 = 3, yakb = 3, m197 = 3, gsh23 = 2, gsh302 = 2 }
function K.gunArt(box, gid, w, h, o)
  o = o or {}
  for _, c in ipairs(box:GetChildren()) do if c.Name == "Art" then c:Destroy() end end
  local art = K.frame(box, UD2(1, 0, 1, 0), nil, nil, 1)
  art.Name = "Art"
  local col = o.col or C.MUTE
  local tr0 = o.tr or 0.1
  local n = GUN_BARRELS[gid or ""] or 1
  local cy = h / 2
  local x0, x1 = w * 0.1, w * 0.92
  K.frame(art, UD2(0, w * 0.32, 0, h * 0.34), UD2(0, x0, 0, cy - h * 0.17), col, tr0).Name = "Receiver"
  local gap = math.max(2, h * 0.09)
  for i = 1, n do
    local y = cy + (i - (n + 1) / 2) * gap
    K.frame(art, UD2(0, x1 - (x0 + w * 0.3), 0, math.max(1, h * 0.06)), UD2(0, x0 + w * 0.3, 0, y - math.max(1, h * 0.06) / 2), col, tr0).Name = "Barrel"
  end
  K.frame(art, UD2(0, w * 0.06, 0, math.max(2, h * 0.08 + (n - 1) * gap)), UD2(0, x1 - w * 0.06, 0, cy - math.max(2, h * 0.08 + (n - 1) * gap) / 2), col, tr0).Name = "Muzzle"
  local chute = K.frame(art, nil, nil, col, 0.4)
  K.line(chute, x0 + w * 0.06, cy + h * 0.17, x0 - w * 0.02, cy + h * 0.4, math.max(1, h * 0.08))
  return art
end
-- 干扰弹（固定卡）：一排四发药筒（方头）
function K.flareArt(box, w, h, o)
  o = o or {}
  for _, c in ipairs(box:GetChildren()) do if c.Name == "Art" then c:Destroy() end end
  local art = K.frame(box, UD2(1, 0, 1, 0), nil, nil, 1)
  art.Name = "Art"
  local col = o.col or C.MUTE
  local tr0 = o.tr or 0.1
  local cw, ch = math.max(4, w * 0.09), math.max(8, h * 0.56)
  for i = 0, 3 do
    local x = w * 0.5 + (i - 1.5) * (cw + math.max(2, w * 0.035)) - cw / 2
    K.frame(art, UD2(0, cw, 0, ch), UD2(0, x, 0, h / 2 - ch / 2 + 2), col, tr0).Name = "Case"
    K.frame(art, UD2(0, cw * 0.7, 0, math.max(2, cw * 0.4)), UD2(0, x + cw * 0.15, 0, h / 2 - ch / 2 + 2 - math.max(2, cw * 0.4)), col, tr0).Name = "Cap"
    K.frame(art, UD2(0, cw, 0, 1), UD2(0, x, 0, h / 2 + ch / 2 - 3), C.BG, 0.4).Name = "Rim"
  end
  return art
end

---------------------------------------------------------------- 武器的 3D 小视口（悬停资料卡：这枚弹真的 3D 模型——同 AirModels 挂在挂点上的那套零件，慢慢滚着转）

local View = {}
View.__index = View
-- 灯光照弹药栏的渲染图：环境光 90 灰、主光暖白、从左上前方照过来
function K.wpnView(parent, size, pos, name)
  local vp = Instance.new("ViewportFrame")
  vp.Name = name or "WsWpnView"
  vp.BackgroundTransparency = 1
  vp.BorderSizePixel = 0
  vp.Size, vp.Position = size, pos
  vp.Ambient = Color3.fromRGB(90, 90, 90)
  vp.LightColor = Color3.fromRGB(255, 250, 240)
  vp.LightDirection = Vector3.new(-1, -1, -0.5)
  vp.Parent = parent
  local cam = Instance.new("Camera")
  cam.FieldOfView = 18
  cam.Parent = vp
  vp.CurrentCamera = cam
  return setmetatable({ vp = vp, cam = cam, parts = nil, offs = nil, wid = nil, a = 0, L = 1 }, View)
end
-- 换一枚弹：拼零件（WeaponModels，和挂在飞机上的一样）、镜头按弹长退到正好放下（从侧前方偏上 6° 看，弹头朝右）
function View:set(wid)
  if wid == self.wid then return self.parts ~= nil end
  self.wid = wid
  if self.model then self.model:Destroy() end
  self.model, self.parts, self.offs = nil, nil, nil
  local wm, ad = libs()
  local w = wid and ad and ad.W[wid]
  if not (wm and w) then return false end
  local m = Instance.new("Model")
  m.Name = "Weapon"
  local ok, r = pcall(wm.make, m, w, CFrame.new(), false)
  if not ok or not r then
    m:Destroy()
    return false
  end
  m.Parent = self.vp
  self.model, self.parts, self.offs = m, r.parts, r.offs
  local sh = w.shape or { L = 5, d = 0.6 }
  self.L = sh.L
  local _, H = K.artExtent(wid)
  local vw = self.vp.Size.X.Offset > 0 and self.vp.Size.X.Offset or 276
  local vh = self.vp.Size.Y.Offset > 0 and self.vp.Size.Y.Offset or 72
  local tv = math.tan(math.rad(self.cam.FieldOfView) / 2)
  local th = tv * vw / vh
  local dist = math.max((sh.L * 0.56) / th, (H * 0.78) / tv) + sh.d
  -- 弹体沿 −Z（弹头朝前）：镜头在 +X 那边（画面往右 = 弹头），往弹头那边偏 20°、往上抬 6°
  local yaw, pitch = math.rad(20), math.rad(6)
  local eye = Vector3.new(math.cos(yaw) * math.cos(pitch), math.sin(pitch), -math.sin(yaw) * math.cos(pitch)) * dist
  self.cam.CFrame = CFrame.lookAt(eye, Vector3.new(0, 0, 0))
  self.a = 0
  self:spin(0)
  return true
end
-- 绕弹轴慢慢滚（每秒 8°）：尾翼、弹翼转过来能看出是立体的；视口里只有十几个零件，每帧摆一下不费事
function View:spin(dt)
  if not self.parts then return end
  self.a = (self.a + math.rad(8) * (dt or 0)) % (2 * math.pi)
  local rot = CFrame.Angles(0, 0, self.a)
  for i, p in ipairs(self.parts) do
    if p.Parent then p.CFrame = rot * self.offs[i] end
  end
end
function View:clear()
  if self.model then self.model:Destroy() end
  self.model, self.parts, self.offs, self.wid = nil, nil, nil, nil
end

return K
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="285">
          <Properties>
            <string name="Name">WtAir</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——战雷式飞机受伤（用户 11-24 夜「把整个游戏做成战雷」④）
--   服务器 WtAir.lua 写在飞机实体上的属性：WtaP（每个部件一位 0～9）、WtaEng 推力系数、WtaCtl 舵效系数、WtaWing 断了哪边翼（L / R）、
--   WtaTail 尾翼 / 尾桨没了、WtaLift 直升机旋翼还在不在、WtaFire 起火、WtaLeak 漏油、WtaKO 飞行员昏迷
--   · 飞控（Fly.lua 每帧问 G.wtaFlight）：推力、舵效打折；断翼往断的那边滚、升力少一大半；没了尾翼俯仰乱晃；昏迷松杆往下掉
--   · 外面看（谁的飞机都画，2500 格以内）：用户 11-25「发动机各种状态 冒烟什么的都要做出来」——按发动机那块的血分档，从每个喷口出来：
--     轻伤（≤ 66）拖一缕淡灰烟、重伤（≤ 33）浓的深灰烟、打坏了（0）熄火：喷口不亮（Fly.lua）、拖一道黑烟；
--     起火：喷口一团火（一闪一闪）+ 滚滚黑烟；漏油：受伤那边机翼拖一道白色油雾
--   · 断翼（用户 11-25「飞机如果断了机翼 那机翼应该要能掉下去」「机翼应该会消失才对」）：WtaWing 一变，那边外翼从模型上消失
--     （AirModels.breakWing：原模型按 wingcut.py 切出来的外翼块、挂在上面的弹、翼尖灯），断口一块烧黑的截面；
--     复制出来的那截外翼带着飞机的速度往外甩出去，翻滚着掉（重力、阻力），拖油雾和烟，落地躺一会儿再消失
--   · 自己开的：左下一个俯视的飞机损伤图（机翼、尾翼、发动机、油箱、座舱、操纵面按状态上色：淡灰好、黄伤、红没了），
--     起火 / 漏油 / 断翼的字；飞行员昏迷整屏慢慢黑下去、写「飞行员昏迷」
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local WtAir = {}

function WtAir.init(G)
  local AD = require(RS:WaitForChild("AirDefs"))
  local AM = require(script.Parent:WaitForChild("AirModels"))
  local V, UD2, V2 = Vector3.new, UDim2.new, Vector2.new
  local CF = CFrame.new
  local RGB = Color3.fromRGB
  local me = Players.LocalPlayer
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local BOLD = Enum.Font.BuilderSansMedium
  local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
  local FIRE = "rbxasset://textures/particles/fire_main.dds"
  local NEAR = 2500
  local TH = G.Theme   -- 统一外观（docs/style.md）
  local M_OK, M_HURT, M_BAD, M_DEAD = TH.C.NEUTRAL, TH.C.WARN, TH.C.WARN:Lerp(TH.C.BAD, 0.5), TH.C.BAD

  ---------------------------------------------------------------- 飞控要的数（每帧问一次，同一帧缓存）
  local cacheEm, cacheT, cache = nil, -1, nil
  function G.wtaFlight(em)
    if not em then return nil end
    local t = os.clock()
    if em == cacheEm and t == cacheT then return cache end
    cacheEm, cacheT = em, t
    if em:GetAttribute("WtaP") == nil then cache = nil return nil end
    cache = {
      eng = em:GetAttribute("WtaEng") or 1, ctl = em:GetAttribute("WtaCtl") or 1, wing = em:GetAttribute("WtaWing"),
      tail = em:GetAttribute("WtaTail") == true, lift = em:GetAttribute("WtaLift") or 1, ko = em:GetAttribute("WtaKO") == true,
    }
    return cache
  end

  ---------------------------------------------------------------- 外面看：起火、漏油
  local fx = setmetatable({}, { __mode = "k" })   -- [视图] = { M, fire, smoke, leak }
  local function mount(M, cf0)
    local p = Instance.new("Part")
    p.Name = "WtaFx"
    p.Size = V(0.4, 0.4, 0.4)
    p.Transparency = 1
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    AM.attach(M, p, cf0)
    return p
  end
  local function emitter(parent, tex, col, size, life, rate, light)
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = tex
    pe.Color = ColorSequence.new(col)
    pe.LightEmission, pe.LightInfluence = light or 0, light and 0 or 0.8
    pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, size[1]), NumberSequenceKeypoint.new(1, size[2]) })
    pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 1) })
    pe.Lifetime = NumberRange.new(life[1], life[2])
    pe.Speed = NumberRange.new(0.5, 3)
    pe.Rotation = NumberRange.new(0, 360)
    pe.RotSpeed = NumberRange.new(-60, 60)
    pe.Rate = rate
    pe.Enabled = false
    pe.Parent = parent
    return pe
  end
  local function build(v)
    local M, d = v.M, v.def
    local S = { M = M, fire = {}, smoke = {}, haze = {}, dark = {} }
    -- 每个喷口一组：火、着火的黑烟、轻伤的淡灰烟、重伤 / 熄火的深灰烟（喷口往后半个喷口直径，烟不从机身里冒出来）
    for _, nz in ipairs(AM.nozzles and AM.nozzles(M) or { { p = V(0, 0, d.L * 0.4), r = 0.8 } }) do
      local r = math.max(0.4, nz.r)
      local m = mount(M, CF(nz.p + V(0, 0, r)))
      table.insert(S.fire, emitter(m, FIRE, RGB(255, 150, 60), { r * 3.2, r * 0.6 }, { 0.25, 0.5 }, 60, 0.9))
      table.insert(S.smoke, emitter(m, SMOKE, RGB(40, 38, 36), { r * 3, r * 13 }, { 2.5, 4.5 }, 30))
      table.insert(S.haze, emitter(m, SMOKE, RGB(176, 178, 180), { r * 1.4, r * 6 }, { 1.2, 2.2 }, 10))
      table.insert(S.dark, emitter(m, SMOKE, RGB(74, 72, 70), { r * 2.2, r * 10 }, { 2, 3.6 }, 22))
    end
    for _, pe in ipairs(S.haze) do pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) }) end
    local wingX = (d.W or 20) * 0.28
    S.leakL = emitter(mount(M, CF(-wingX, 0, 0)), SMOKE, RGB(236, 240, 244), { 1.2, 5 }, { 1.2, 2.2 }, 40)
    S.leakR = emitter(mount(M, CF(wingX, 0, 0)), SMOKE, RGB(236, 240, 244), { 1.2, 5 }, { 1.2, 2.2 }, 40)
    return S
  end
  local function setOn(pe, on)
    if pe == nil then return end
    if typeof(pe) == "Instance" then
      if pe.Enabled ~= on then pe.Enabled = on end
    else   -- 每个喷口一个：一组
      for _, x in ipairs(pe) do if x.Enabled ~= on then x.Enabled = on end end
    end
  end
  -- 发动机那块的血（WtaP 里 eng 那一位，0～9；没有就 9）
  local function engDigit(em)
    local wp = em:GetAttribute("WtaP")
    if type(wp) ~= "string" then return 9 end
    local i = (#wp == 6) and 3 or 4   -- 直升机 6 块（rotor, tail, eng…），固定翼 7 块（wingL, wingR, tail, eng…）
    return tonumber(wp:sub(i, i)) or 9
  end

  ---------------------------------------------------------------- 自己开的：左下损伤图
  local gui = Instance.new("ScreenGui")
  gui.Name = "WtAirHud"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 5
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")
  local function frame(parent, size, pos, color, tr, anchor)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.AnchorPoint = size, pos or UD2(), anchor or V2()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = color or M_OK, tr or 0, 0
    f.Parent = parent
    return f
  end
  local function round(f, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = r or UDim.new(0, 2)
    c.Parent = f
    return f
  end
  local function label(parent, text, size, pos, ts, color, anchor, align)
    local l = Instance.new("TextLabel")
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.BackgroundTransparency = 1
    l.Text, l.TextSize, l.TextColor3, l.Font = text or "", ts or 12, color or Color3.new(1, 1, 1), BOLD
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextStrokeTransparency, l.TextStrokeColor3 = 0.4, RGB(0, 0, 0)
    l.Parent = parent
    return l
  end
  -- 飞机放在左下（开飞机时圆形小地图在左上，左下空着）
  local DI = frame(gui, UD2(0, 230, 0, 128), UD2(0, 24, 1, -24), RGB(0, 0, 0), 1, V2(0, 1))
  DI.Name = "WtAirDamage"
  local scale = Instance.new("UIScale")
  scale.Parent = DI
  do
    local bg = round(frame(DI, UD2(1, 0, 1, 0), nil, RGB(0, 0, 0), 0.55), UDim.new(0, 4))
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.6, 0.35), NumberSequenceKeypoint.new(1, 1) })
    g.Parent = bg
  end
  -- 俯视飞机（机头朝上），每块一个框
  local PL = {}
  local function part(name, size, pos)
    local f = round(frame(DI, size, pos, M_OK, 0.75, V2(0.5, 0.5)))
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = M_OK, 1, 0.45
    s.Parent = f
    f.Name = name
    PL[name] = { f = f, s = s, last = 9, flash = 0 }
    return f
  end
  local CX, CY = 58, 64
  part("fuse", UD2(0, 12, 0, 96), UD2(0, CX, 0, CY))
  part("pilot", UD2(0, 8, 0, 14), UD2(0, CX, 0, CY - 34))
  part("fuel", UD2(0, 10, 0, 22), UD2(0, CX, 0, CY - 6))
  part("eng", UD2(0, 10, 0, 22), UD2(0, CX, 0, CY + 22))
  part("wingL", UD2(0, 44, 0, 18), UD2(0, CX - 28, 0, CY + 2))
  part("wingR", UD2(0, 44, 0, 18), UD2(0, CX + 28, 0, CY + 2))
  part("tail", UD2(0, 34, 0, 9), UD2(0, CX, 0, CY + 40))
  part("ctrl", UD2(0, 4, 0, 4), UD2(0, CX + 52, 0, CY + 52))   -- 操纵面：只在受损时亮（一个小点 + 字）
  part("rotor", UD2(0, 92, 0, 4), UD2(0, CX, 0, CY - 8))   -- 直升机的旋翼：一道横条
  PL.fuse.f.ZIndex, PL.fuel.f.ZIndex, PL.eng.f.ZIndex, PL.pilot.f.ZIndex = 1, 3, 3, 3
  local fireDot = round(frame(DI, UD2(0, 16, 0, 16), UD2(0, CX, 0, CY + 22), RGB(255, 120, 30), 0.1, V2(0.5, 0.5)), UDim.new(0.5, 0))
  fireDot.ZIndex = 5
  local tip = label(DI, "", UD2(0, 110, 0, 100), UD2(0, 118, 0, 12), 12)
  tip.TextWrapped = true
  tip.TextYAlignment = Enum.TextYAlignment.Top
  tip.RichText = true
  local black = frame(gui, UD2(1, 0, 1, 0), nil, RGB(0, 0, 0), 1)
  black.ZIndex = 10
  local koT = label(black, "", UD2(1, 0, 0, 30), UD2(0, 0, 0.5, -15), 24, RGB(255, 90, 76), nil, Enum.TextXAlignment.Center)
  koT.ZIndex = 11
  local koSince = nil

  local ORDER_JET = { "wingL", "wingR", "tail", "eng", "fuel", "pilot", "ctrl" }
  local ORDER_HELI = { "rotor", "tail", "eng", "fuel", "pilot", "ctrl" }
  local function stepHud(st)
    local em = st and st.em
    local wp = em and em:GetAttribute("WtaP")
    if not wp or em:GetAttribute("Wreck") then gui.Enabled = false koSince = nil return end
    gui.Enabled = true
    local vp = workspace.CurrentCamera.ViewportSize
    -- 手机：左下是摇杆和油门键，挪到右上小地图下面；开着光电吊舱时左下是吊舱的读数，先收起
    local touch = game:GetService("UserInputService").TouchEnabled and not game:GetService("UserInputService").KeyboardEnabled
    if touch then DI.AnchorPoint, DI.Position = V2(1, 0), UD2(1, -12, 0, 236) end
    scale.Scale = touch and 0.8 or math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.8, 1.25)
    DI.Visible = not st.eo
    local heli = st.d and st.d.kind == "heli"
    local order = heli and ORDER_HELI or ORDER_JET
    PL.wingL.f.Visible, PL.wingR.f.Visible, PL.rotor.f.Visible = not heli, not heli, heli
    local t = os.clock()
    local states = {}
    for i, k in ipairs(order) do
      local s = tonumber(string.sub(wp, i, i)) or 9
      states[k] = s
      local o = PL[k]
      if s < o.last then o.flash = t + 1 end
      o.last = s
      local col, tr = M_OK, 0.75
      if s <= 0 then col, tr = M_DEAD, 0.1 elseif s <= 3 then col, tr = M_BAD, 0.15 elseif s <= 6 then col, tr = M_HURT, 0.25 end
      if t < o.flash and (t * 8) % 1 < 0.5 then col, tr = Color3.new(1, 1, 1), 0 end
      o.f.BackgroundColor3, o.f.BackgroundTransparency = col, tr
      o.s.Color, o.s.Transparency = col, (s >= 7) and 0.45 or 0
      if k == "ctrl" then o.f.Visible = s < 7 end
      if (k == "wingL" or k == "wingR") and s <= 0 then o.f.BackgroundTransparency = 0.6 end   -- 断了：只剩一个红框
    end
    local fire = em:GetAttribute("WtaFire") == true
    fireDot.Visible = fire
    if fire then
      local pu = 0.5 + 0.5 * math.sin(t * 9)
      fireDot.Size = UD2(0, 12 + 7 * pu, 0, 12 + 7 * pu)
      fireDot.BackgroundColor3 = RGB(255, 90 + math.floor(90 * pu), 30)
    end
    -- 右边的字：起火、漏油、断翼、发动机、尾翼、操纵
    local lines = {}
    local function add(key, col) table.insert(lines, string.format('<font color="#%02X%02X%02X">%s</font>', math.floor(col.R * 255), math.floor(col.G * 255), math.floor(col.B * 255), T(key))) end
    if fire then add("wta.tFire", ((t * 3) % 1 < 0.6) and M_DEAD or M_BAD) end
    if em:GetAttribute("WtaLeak") then add("wta.tLeak", M_HURT) end
    if em:GetAttribute("WtaWing") then add("wta.tWing", M_DEAD) end
    if heli and (states.rotor or 9) <= 0 then add("wta.tRotor", M_DEAD) end
    local eng = em:GetAttribute("WtaEng") or 1
    if eng <= 0 then add("wta.tEngDead", M_DEAD) elseif eng < 1 then add("wta.tEng", M_HURT) end
    if em:GetAttribute("WtaTail") then add(heli and "wta.tTailRotor" or "wta.tTail", M_DEAD) end
    if (states.ctrl or 9) < 7 then add("wta.tCtrl", M_HURT) end
    tip.Text = table.concat(lines, "\n")
    -- 飞行员昏迷：整屏慢慢黑下去
    local ko = em:GetAttribute("WtaKO") == true
    if ko and not koSince then koSince = t end
    if not ko then koSince = nil end
    local k = koSince and math.clamp((t - koSince) / 1.6, 0, 1) or 0
    black.BackgroundTransparency = 1 - 0.92 * k
    koT.Text = (k > 0.3) and T("wta.ko") or ""
  end
  G.wtaHudShown = function() return gui.Enabled end   -- 测试用

  ---------------------------------------------------------------- 断掉的外翼：翻滚着掉下去
  local GRAV = AD.GRAV or 27.5
  local debris = {}
  local function groundAt(p)
    local Map = G.Map
    local ok, h = pcall(function() return Map and AD.ground(Map, p.X, p.Z) end)
    return (ok and type(h) == "number") and h or -1e9
  end
  local function spawnDebris(list, v, side)
    if #list == 0 then return end
    local cf0 = v.cf or list[1].cf
    local c = V()
    for _, x in ipairs(list) do c += x.cf.Position end
    c /= #list
    local piv = CF(c) * (cf0 - cf0.Position)
    local m = Instance.new("Model")
    m.Name = "WingDebris"
    local plist, rel = {}, {}
    local big, bigV = nil, 0
    for _, x in ipairs(list) do
      x.p.Parent = m
      table.insert(plist, x.p)
      table.insert(rel, piv:ToObjectSpace(x.cf))
      local s = x.p.Size
      if s.X * s.Y * s.Z > bigV then big, bigV = x.p, s.X * s.Y * s.Z end
    end
    m.Parent = workspace
    if big then   -- 断口那头拖油雾、烟（几秒后淡掉）
      local att = Instance.new("Attachment")
      att.Parent = big
      local sx = (side == "L") and 1 or -1   -- 断口在靠机身那边
      att.Position = big.CFrame:PointToObjectSpace(big.Position + cf0.RightVector * sx * big.Size.X * 0.4)
      local pe1 = emitter(att, SMOKE, RGB(236, 240, 244), { 1.5, 6 }, { 1, 2 }, 40)
      local pe2 = emitter(att, SMOKE, RGB(60, 56, 52), { 2, 9 }, { 2, 3.5 }, 18)
      pe1.Enabled, pe2.Enabled = true, true
      task.delay(4, function() pe1.Enabled = false end)
      task.delay(7, function() pe2.Enabled = false end)
    end
    local sgn = (side == "L") and -1 or 1
    local vel = (v.vel or V()) + cf0.RightVector * sgn * 16 + cf0.UpVector * 6
    local spin = V((math.random() - 0.5) * 2, (math.random() - 0.5) * 1.5, -sgn * (2.5 + math.random() * 2.5))
    table.insert(debris, { m = m, plist = plist, rel = rel, cf = piv, vel = vel, spin = spin, t = 0, clist = {} })
  end
  local function stepDebris(dt)
    for i = #debris, 1, -1 do
      local D = debris[i]
      D.t += dt
      if D.t > 22 or not D.m.Parent then
        D.m:Destroy()
        table.remove(debris, i)
      elseif not D.landed then
        -- 一截机翼：阻力大（翼面迎着风翻滚），掉得比飞机慢，横着飘
        D.vel += V(0, -GRAV, 0) * dt
        D.vel *= math.max(0, 1 - 0.45 * dt)
        local p = D.cf.Position + D.vel * dt
        local gy = groundAt(p)
        if p.Y < gy + 0.5 then
          p = V(p.X, gy + 0.5, p.Z)
          D.landed = true
        end
        D.cf = CF(p) * (D.cf - D.cf.Position) * CFrame.Angles(D.spin.X * dt, D.spin.Y * dt, D.spin.Z * dt)
        for k, r in ipairs(D.rel) do D.clist[k] = D.cf * r end
        workspace:BulkMoveTo(D.plist, D.clist, Enum.BulkMoveMode.FireCFrameChanged)
      elseif D.t > 16 then   -- 落地躺一会儿，淡掉
        local k = (D.t - 16) / 6
        for _, q in ipairs(D.plist) do q.Transparency = math.max(q.Transparency, k) end
      end
    end
  end
  G.wtaDebris = function() return #debris end   -- 测试用

  ---------------------------------------------------------------- 每帧
  local acc = 0
  G.frameConn("WtAir", function(dt)
    local st = G.fly
    G.try_(stepHud, st and st.pilot ~= false and st or nil)
    if #debris > 0 then G.try_(stepDebris, dt) end
    acc += dt
    if acc < 0.1 then return end
    acc = 0
    local cp = workspace.CurrentCamera.CFrame.Position
    for em, v in pairs(G.views or {}) do
      if v.kind == "air" and v.M and v.def and em.Parent then
        local wreck = em:GetAttribute("Wreck") == true
        local fire = not wreck and em:GetAttribute("WtaFire") == true
        local leak = not wreck and em:GetAttribute("WtaLeak") ~= nil
        local ed = wreck and 9 or engDigit(em)   -- 0 打坏、1～3 重伤、4～6 轻伤
        local hurt = ed <= 6
        local pos = v.cf and v.cf.Position or (v.root and v.root.CFrame.Position) or cp
        local near = (pos - cp).Magnitude < NEAR
        -- 断翼：那边外翼消失、掉下去（远处的只藏不掉）；落地修好了（WtaWing 清掉）外翼回来；成了残骸的不再变
        local wingA = em:GetAttribute("WtaWing")
        local gone = v.M.wingGone
        if (wingA == "L" or wingA == "R") and not (gone and gone[wingA]) then
          local list = AM.breakWing(v.M, wingA)
          if near then spawnDebris(list, v, wingA) else for _, x in ipairs(list) do x.p:Destroy() end end
        elseif wingA == nil and gone and not wreck then
          for sd in pairs(gone) do AM.restoreWing(v.M, sd) end
        end
        local S = fx[v]
        if (fire or leak or hurt) and near and (not S or S.M ~= v.M) then
          S = build(v)
          fx[v] = S
        end
        if S then
          setOn(S.fire, fire and near)
          setOn(S.smoke, fire and near)
          setOn(S.haze, near and not fire and ed >= 4 and ed <= 6)
          setOn(S.dark, near and not fire and ed <= 3)
          -- 着火的火苗一闪一闪（不是一直一样大）；熄火的黑烟淡一点（没有排气推着）
          if fire and near then
            local k = 0.75 + 0.35 * math.sin(os.clock() * 17 + #S.fire) + 0.15 * math.sin(os.clock() * 41)
            for _, pe in ipairs(S.fire) do pe.Rate = 60 * k end
          end
          if ed == 0 then for _, pe in ipairs(S.dark) do pe.Rate = 12 end
          else for _, pe in ipairs(S.dark) do pe.Rate = 22 end end
          -- 漏油：被打的那边机翼（不知道哪边就两边都冒一点）
          local wing = em:GetAttribute("WtaWing")
          setOn(S.leakL, leak and near and wing ~= "L")
          setOn(S.leakR, leak and near and wing ~= "R")
        end
      end
    end
  end)
end

return WtAir
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="286">
          <Properties>
            <string name="Name">WtAmmo</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——机库里配弹（用户 11-25「全部都做」④：战雷出车前选每种弹带几发）
--   机库出击阵容卡片上的「弹药」（TechUI.lua 调 G.openAmmo(科技树的键, 能打前几种)）：主炮每种弹一行（名字、0 米穿深、− / +，
--   按住 Shift 一次 5 发），底下总数 / 满载、待发弹架几发；「默认」「带一半」「满载」；改了就发服务器（Wt.lua G.ACT.wtAmmoSet），
--   这一局里再出这辆车照这个配。少带弹：打中弹架不容易殉爆（弹架空了根本不炸），但打几发就得回据点补
--   没研究的弹种（科技树改装「第二种弹」「第三种弹」）灰着、配不了
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local WtAmmo = {}

function WtAmmo.init(G)
  local VD = require(RS:WaitForChild("VehDefs"))
  local BAL = require(RS:WaitForChild("Ballistics"))
  local TT = require(RS:WaitForChild("TechTree"))
  local WD = require(RS:WaitForChild("WtDamage"))
  local me = Players.LocalPlayer
  local RGB, UD2, V2 = Color3.fromRGB, UDim2.new, Vector2.new
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local BOLD, MED = Enum.Font.BuilderSansMedium, Enum.Font.BuilderSans
  local TH = G.Theme   -- 统一外观（docs/style.md）
  local WHITE, DIM, GOLD, BAD = TH.C.TEXT, TH.C.MUTE, TH.C.WARN, TH.C.BAD
  local SPLIT = { 5, 3, 2, 1, 1 }   -- 默认配弹（同服务器 Wt.lua）

  local gui = Instance.new("ScreenGui")
  gui.Name = "WtAmmo"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 14   -- 盖在机库（TechUI 12）上面
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local function frame(parent, size, pos, col, tr, anchor)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.AnchorPoint = size, pos or UD2(), anchor or V2()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = col or RGB(10, 12, 14), tr or 0, 0
    f.Parent = parent
    return f
  end
  local function text(parent, s, size, pos, ts, col, font, align)
    local l = Instance.new("TextLabel")
    l.Size, l.Position = size, pos or UD2()
    l.BackgroundTransparency = 1
    l.Text, l.TextSize, l.TextColor3, l.Font = s or "", ts or 14, col or WHITE, font or BOLD
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.Parent = parent
    return l
  end
  local function button(parent, s, size, pos, on)
    local b = Instance.new("TextButton")
    b.Size, b.Position = size, pos or UD2()
    b.BackgroundColor3, b.BackgroundTransparency, b.BorderSizePixel = (on == false) and RGB(40, 42, 46) or RGB(52, 70, 58), 0.1, 0
    b.Text, b.TextSize, b.TextColor3, b.Font = s, 14, (on == false) and DIM or WHITE, BOLD
    b.AutoButtonColor = on ~= false
    b.Parent = parent
    return b
  end

  local saved = {}   -- 科技树的键 → { 弹种 = 几发 }（这一局里记着）
  local panel = nil
  local function close()
    if panel then panel:Destroy() panel = nil end
    gui.Enabled = false
  end
  G.ammoPanelOpen = function() return panel ~= nil end

  function G.openAmmo(key, nA)
    close()
    local it = TT.get and TT.get(key)
    local vid = (it and (it.veh or it.base)) or key
    local d = VD.get and VD.get(vid) or VD[vid]
    if not d then return end
    local wid = nil
    for _, w in ipairs(d.weapons or {}) do if BAL.GUN[w] then wid = w break end end
    if not wid then
      if G.toast then G.toast(T("wta2.noGun"), "info") end
      return
    end
    local w = VD.W[wid]
    local cap = (w.mag or 1) + (w.reserve or 0)
    local list = BAL.GUN[wid]
    local n = math.max(1, math.min(#list, nA or #list))
    local lay = WD.prof(d).lay
    local rcap = d.rdyN or ((lay == "e3") and 22 or ((lay == "w4") and 15 or nil))
    -- 现在的配法：配过的照旧，没配过的按默认比例
    local cur = {}
    local prev = saved[key]
    local function defaults()
      local tw = 0
      for i = 1, n do tw += SPLIT[i] or 1 end
      local sum = 0
      for i, k in ipairs(list) do
        cur[k] = (i <= n) and math.floor(cap * (SPLIT[i] or 1) / tw) or 0
        sum += cur[k]
      end
      cur[list[1]] += cap - sum
    end
    if prev then for _, k in ipairs(list) do cur[k] = prev[k] or 0 end else defaults() end
    local function total() local s = 0 for _, k in ipairs(list) do s += cur[k] or 0 end return s end

    gui.Enabled = true
    local H = 118 + #list * 40
    panel = frame(gui, UDim2.fromOffset(440, H), UD2(0.5, 0, 0.5, 0), RGB(12, 14, 17), 0.05, V2(0.5, 0.5))
    panel.Name = "AmmoPanel"
    do
      local st = Instance.new("UIStroke")
      st.Color, st.Transparency = RGB(110, 120, 126), 0.35
      st.Parent = panel
    end
    local nm = (it and G.T and T("tree." .. key)) or T("veh." .. vid)
    if nm == "tree." .. key then nm = T("veh." .. vid) end
    text(panel, nm .. "  ·  " .. T("wta2.title"), UD2(1, -24, 0, 24), UD2(0, 12, 0, 10), 16, WHITE)
    local sumT = text(panel, "", UD2(1, -24, 0, 18), UD2(0, 12, 0, 36), 13, DIM, MED)
    local rows = {}
    local function redraw()
      local s = total()
      sumT.Text = T("wta2.sum", s, cap) .. (rcap and ("   ·   " .. T("wta2.rack", math.min(rcap, math.max(0, s - 1)))) or "")
        .. ((s < cap) and ("   ·   " .. T("wta2.less")) or "")
      for _, r in ipairs(rows) do r.cnt.Text = tostring(cur[r.k] or 0) end
    end
    local function send()
      saved[key] = table.clone(cur)
      G.R.Act:FireServer("wtAmmoSet", key, cur)
      redraw()
    end
    for i, k in ipairs(list) do
      local a = BAL.AMMO[k] or {}
      local wa = WD.AMMO and WD.AMMO[k]
      local y = 62 + (i - 1) * 40
      local okType = i <= n
      local row = frame(panel, UD2(1, -24, 0, 34), UD2(0, 12, 0, y), RGB(22, 25, 29), 0.1)
      row.Name = "Ammo_" .. k
      -- 型号 + 弹种（按现在的语言：用户 11-28「弹种这些还是根据语言改变吧」；原来写 [SABOT] / [穿甲] 这种火控上的字，中英混着）
      local kd = BAL.kindOf and BAL.kindOf(k)
      local nm = (G.ammoInfo and select(1, G.ammoInfo(k))) or (BAL.desig and BAL.desig(k)) or a.name or k
      text(row, nm .. (kd and ("  ·  " .. T("ammo.t." .. kd)) or ""), UD2(0.6, 0, 1, 0), UD2(0, 8, 0, 0), 13, okType and WHITE or DIM)
      local pen = wa and wa.p0 and (math.floor(wa.p0) .. " mm") or ""
      text(row, okType and pen or T("wta2.locked"), UD2(0, 90, 1, 0), UD2(0.6, -40, 0, 0), 12, okType and GOLD or BAD, MED)
      local minus = button(row, "−", UDim2.fromOffset(30, 26), UD2(1, -112, 0, 4), okType)
      minus.Name = "Minus"
      local cnt = text(row, "0", UDim2.fromOffset(40, 34), UD2(1, -78, 0, 0), 15, WHITE, BOLD, Enum.TextXAlignment.Center)
      cnt.Name = "Count"
      local plus = button(row, "+", UDim2.fromOffset(30, 26), UD2(1, -36, 0, 4), okType)
      plus.Name = "Plus"
      local function step(sgn)
        if not okType then return end
        local by = UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 5 or 1
        if sgn > 0 then by = math.min(by, cap - total()) end
        cur[k] = math.max(0, (cur[k] or 0) + sgn * by)
        send()
      end
      minus.MouseButton1Click:Connect(function() step(-1) end)
      plus.MouseButton1Click:Connect(function() step(1) end)
      table.insert(rows, { k = k, cnt = cnt })
    end
    local by = H - 46
    local b1 = button(panel, T("wta2.def"), UDim2.fromOffset(96, 32), UD2(0, 12, 0, by))
    b1.MouseButton1Click:Connect(function() defaults() send() end)
    local b2 = button(panel, T("wta2.half"), UDim2.fromOffset(96, 32), UD2(0, 116, 0, by))
    b2.MouseButton1Click:Connect(function()
      defaults()
      for _, k in ipairs(list) do cur[k] = math.floor((cur[k] or 0) / 2) end
      send()
    end)
    -- 涂装、贴花（⑯，WtSkin.lua）：机库顶栏的图标键放不下了，从配弹面板进
    if G.openSkin then
      local b4 = button(panel, T("wsk.title"), UDim2.fromOffset(110, 32), UD2(0, 216, 0, by))
      b4.Name = "SkinBtn"
      b4.MouseButton1Click:Connect(function() close() G.openSkin(key) end)
    end
    local b3 = button(panel, T("wta2.close"), UDim2.fromOffset(96, 32), UD2(1, -108, 0, by))
    b3.Name = "Close"
    b3.MouseButton1Click:Connect(close)
    redraw()
    if not prev then send() end   -- 第一次打开：把默认配法也记下（服务器按它配）
  end
  G.closeAmmo = close
  -- 出击了 / 机库关了：面板收起
  G.frameConn("WtAmmo", function()
    if panel and G.S and G.S.alive then close() end
  end)
end

return WtAmmo
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="287">
          <Properties>
            <string name="Name">WtBattle</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——战雷式对局的界面（用户 11-24 夜「把整个游戏做成战雷」③：对局玩法）
--   服务器 WtMatch.lua 推的 S.wt：{ sp, free 第一辆免费还在, paid 花 SP 出过几辆, order 阵容（先后）, ln 每型出过几次, lost 每型被毁几次, max, backup, earned, vk, ak }
--   · SP：比分条下面一块「SP 350 · 出击阵容 2 / 5」（部署界面、步行时；开车开飞机时收起，那时是战雷的车辆界面），攒了 SP 下面飘「+100 SP」
--   · 选车（Depot.lua 的召唤列表）：每张卡写这辆现在要多少 SP（免费 / 够了金黄 / 不够红），阵容满了、备用用完了写出来；标题行带上 SP
--   · 结算（一局打完、不是 PvE）：战雷那样——中间一条大字「任务完成 / 任务失败」，下面我方 / 敌方两张表（名次、名字、得分、击毁、击落、击杀、
--     占点、阵亡，自己那行高亮），最下面这一局的得分、经验、攒的 SP、下一局倒计时；原来的结算卡（UI.lua）收起
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local WtBattle = {}

function WtBattle.init(G)
  local Config = require(RS:WaitForChild("Config"))
  local VD = require(RS:WaitForChild("VehDefs"))
  local AD = require(RS:WaitForChild("AirDefs"))
  local V2, UD2 = Vector2.new, UDim2.new
  local RGB = Color3.fromRGB
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local BOLD, MED, BLACK = Enum.Font.BuilderSansMedium, Enum.Font.BuilderSans, Enum.Font.BuilderSansBold
  local LEFT, RIGHT = Enum.TextXAlignment.Left, Enum.TextXAlignment.Right
  local TH = G.Theme   -- 统一外观（docs/style.md）
  local WHITE, MUTE, INK = TH.C.TEXT, TH.C.MUTE, TH.C.INK
  local GOOD, BAD, GOLD = TH.C.GOOD, TH.C.BAD, TH.C.WARN

  local gui = Instance.new("ScreenGui")
  gui.Name = "WtBattle"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 12   -- 盖在部署界面上面（结算页要盖住一切）
  gui.Parent = me:WaitForChild("PlayerGui")

  local function frame(parent, size, pos, color, tr, anchor)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.AnchorPoint = size, pos or UD2(), anchor or V2()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = color or INK, tr or 0, 0
    f.Parent = parent
    return f
  end
  local function label(parent, text, size, pos, ts, color, font, anchor, align)
    local l = Instance.new("TextLabel")
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.BackgroundTransparency = 1
    l.Text, l.TextSize, l.TextColor3, l.Font = text or "", ts or 13, color or WHITE, font or BOLD
    l.TextXAlignment = align or Enum.TextXAlignment.Center
    l.TextStrokeTransparency, l.TextStrokeColor3 = 0.6, INK
    l.Parent = parent
    return l
  end
  local function hex(c) return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
  local function teamColor(t)
    -- 队伍的颜色按看的人算：自己这一边绿、对面红、中立灰（统一外观 docs/style.md，不再攻方一律红、守方一律绿）
    if t ~= "atk" and t ~= "def" then return TH.C.NEUTRAL end
    return TH.side(t)
  end

  ---------------------------------------------------------------- SP 那一块
  local chip = frame(gui, UD2(0, 260, 0, 26), UD2(0.5, 0, 0, 80), RGB(8, 12, 14), 0.32, V2(0.5, 0))
  chip.Name = "WtSp"
  chip.Visible = false
  do
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 4)
    c.Parent = chip
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = GOLD, 1, 0.7
    s.Parent = chip
  end
  local chipT = label(chip, "", UD2(1, -16, 1, 0), UD2(0, 8, 0, 0), 13, WHITE, BOLD)
  chipT.RichText = true
  local gainT = label(gui, "", UD2(0, 160, 0, 18), UD2(0.5, 0, 0, 110), 15, GOLD, BLACK, V2(0.5, 0))
  gainT.Name = "WtSpGain"
  gainT.Visible = false
  local lastSp, gainUntil, gainSum = nil, 0, 0

  local function catOf(id)
    local d = AD.get(id)
    if d then return d.cat end
    d = VD.get(id)
    return d and d.cat or "ship"
  end
  -- 这一型现在的状态：字、颜色
  local function tagOf(id, cat, w, S)
    local n = (w.ln and w.ln[id]) or 0
    if n == 0 and #(w.order or {}) >= (w.max or 5) then return T("wtm.full"), MUTE end
    if n >= 1 + (w.backup or 1) then return T("wtm.used"), BAD end
    local c = 0
    if S.phase == "battle" and not w.free then c = Config.WtCost(id, cat or catOf(id), w.paid or 0) end
    local txt, col
    if c == 0 then txt, col = T("wtm.free"), GOOD
    else txt, col = T("wtm.cost", c), (c <= (w.sp or 0)) and GOLD or BAD end
    if n >= 1 then txt ..= " · " .. T("wtm.backup") end   -- 已经出过一次：这次是备用
    return txt, col
  end
  G.wtTagOf = function(id, cat) local S = G.S return (S and S.wt) and tagOf(id, cat, S.wt, S) or nil end   -- 测试用
  -- Depot.lua 的召唤卡片：y 是这张卡上放这行字的高度（跟左边那行「类别、名额」并排，靠右）
  function G.wtCardTag(b, id, cat, y)
    local S = G.S
    local w = S and S.wt
    if not w then return end
    local txt, col = tagOf(id, cat, w, S)
    local l = label(b, txt, UD2(0, 120, 0, 16), UD2(1, -10, 0, y or 74), 12, col, BLACK, V2(1, 0), RIGHT)
    l.Name = "WtSpTag"
  end
  function G.wtSpLine()
    local S = G.S
    local w = S and S.wt
    if not w then return nil end
    return T("wtm.sp", w.sp or 0) .. "  ·  " .. T("wtm.lineup", #(w.order or {}), w.max or 5)
  end

  ---------------------------------------------------------------- 出击栏（战雷：阵亡以后在出击界面直接选车，人在车里出生）
  --   部署界面下面一条：本队能开的地面车一排、飞机直升机一排，每张卡写名字、这辆现在要多少 SP（免费 / 够了 / 不够 / 阵容满了 / 备用用完）；
  --   点一张 → 服务器 WtMatch.lua G.ACT.wtDeployVeh（在主基地出生、出车、坐进去）；装备照部署界面左下选的
  local strip = Instance.new("ScrollingFrame")
  strip.Name = "WtLineup"
  strip.Size, strip.Position, strip.AnchorPoint = UD2(0.62, 0, 0, 76), UD2(0.5, 0, 1, -104), V2(0.5, 1)
  strip.BackgroundColor3, strip.BackgroundTransparency, strip.BorderSizePixel = RGB(8, 12, 14), 0.35, 0
  strip.ScrollingDirection = Enum.ScrollingDirection.X
  strip.ScrollBarThickness = 4
  strip.CanvasSize = UD2(0, 0, 0, 0)
  strip.AutomaticCanvasSize = Enum.AutomaticSize.X
  strip.Visible = false
  strip.Parent = gui
  do
    local l = Instance.new("UIListLayout")
    l.FillDirection = Enum.FillDirection.Horizontal
    l.Padding = UDim.new(0, 6)
    l.VerticalAlignment = Enum.VerticalAlignment.Center
    l.SortOrder = Enum.SortOrder.LayoutOrder
    l.Parent = strip
    local pd = Instance.new("UIPadding")
    pd.PaddingLeft, pd.PaddingRight = UDim.new(0, 8), UDim.new(0, 8)
    pd.Parent = strip
  end
  local stripTitle = label(gui, "", UD2(0.62, 0, 0, 18), UD2(0.5, 0, 1, -182), 13, GOLD, BOLD, V2(0.5, 1), LEFT)
  stripTitle.Visible = false
  local cards, cardKey, cardGen = {}, nil, 0
  local function buildCards(S)
    local team = S.team or "atk"
    local key = team .. ":" .. tostring(#(S.wt and S.wt.order or {}))
    if key == cardKey and #cards > 0 then return end
    cardKey = key
    cardGen += 1
    for _, c in ipairs(cards) do c.b:Destroy() end
    cards = {}
    local ids = {}
    for _, cat in ipairs({ "tank", "apc", "aa", "arty", "jet", "heli" }) do
      for _, id in ipairs(Config.TeamVehicles(team, cat)) do table.insert(ids, { id = id, cat = cat }) end
    end
    for i, it in ipairs(ids) do
      local b = Instance.new("TextButton")
      b.Name = "Deploy_" .. it.id
      b.Text = ""
      b.LayoutOrder = i
      b.Size = UD2(0, 132, 0, 60)
      b.BackgroundColor3, b.BackgroundTransparency, b.BorderSizePixel = RGB(22, 26, 30), 0.1, 0
      b.AutoButtonColor = true
      b.Parent = strip
      local st = Instance.new("UIStroke")
      st.Color, st.Transparency, st.Thickness = WHITE, 0.85, 1
      st.Parent = b
      local nm = string.match(T("veh." .. it.id), "^(%S+)") or T("veh." .. it.id)
      label(b, nm, UD2(1, -10, 0, 20), UD2(0, 6, 0, 5), 14, WHITE, BLACK, nil, LEFT)
      label(b, T("vcat." .. it.cat), UD2(1, -10, 0, 14), UD2(0, 6, 0, 24), 11, MUTE, MED, nil, LEFT)
      local tag = label(b, "", UD2(1, -10, 0, 16), UD2(0, 6, 1, -20), 12, GOLD, BLACK, nil, LEFT)
      b.Activated:Connect(function()
        local sel = G.deploySel
        G.R.Act:FireServer("wtDeployVeh", it.id, sel and sel.kit or nil)
      end)
      table.insert(cards, { b = b, tag = tag, id = it.id, cat = it.cat, st = st })
    end
  end
  local stripS, stripLang, stripGen = nil, nil, -1   -- 上次写卡片时的战况表、语言、第几批卡
  local function stepStrip(S)
    local dying = G.deathFxOn ~= nil and G.deathFxOn() == true
    -- 机库开着（D 的 TechUI：Config.Wt.noInfantry，玩家不当步兵）就是它管出击——这条出击栏只在还能当步兵的时候出来
    local hangar = G.hangarActive ~= nil and G.hangarActive() == true
    local show = S.wt ~= nil and S.alive == false and (S.phase == "battle" or S.phase == "prep") and not dying and not hangar
      and not (G.menuShown and G.menuShown()) and not G.factionOpen and S.picked ~= false
    strip.Visible, stripTitle.Visible = show, show
    if not show then stripS = nil return end
    buildCards(S)
    -- 卡上的字、描边只跟服务器推的战况（G.S，一秒两次）有关：没来新的就不每帧重写几十张卡（11-27 M3 丝滑）
    if S == stripS and G.lang == stripLang and cardGen == stripGen then return end
    stripS, stripLang, stripGen = S, G.lang, cardGen
    stripTitle.Text = T("wtm.lineupTitle") .. "   ·   " .. (G.wtSpLine() or "")
    for _, c in ipairs(cards) do
      local txt, col = tagOf(c.id, c.cat, S.wt, S)
      c.tag.Text, c.tag.TextColor3 = txt, col
      local inLine = (S.wt.ln and S.wt.ln[c.id] or 0) > 0
      c.st.Color, c.st.Transparency = inLine and GOLD or WHITE, inLine and 0.2 or 0.85
    end
  end

  ---------------------------------------------------------------- 结算页
  local res = frame(gui, UD2(1, 0, 1, 0), nil, RGB(4, 6, 8), 0.22)
  res.Name = "WtResults"
  res.Visible = false
  local resScale = Instance.new("UIScale")
  resScale.Parent = res
  local ban = frame(res, UD2(1, 0, 0, 104), UD2(0, 0, 0, 64), INK, 0.3)
  do
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, 0.2),
      NumberSequenceKeypoint.new(0.75, 0.2), NumberSequenceKeypoint.new(1, 1) })
    g.Parent = ban
  end
  local banLine = frame(ban, UD2(0.5, 0, 0, 2), UD2(0.5, 0, 1, -2), GOLD, 0, V2(0.5, 0))
  local banT = label(ban, "", UD2(1, 0, 0, 56), UD2(0, 0, 0, 8), 46, WHITE, BLACK)
  banT.Name = "Title"
  local banS = label(ban, "", UD2(1, 0, 0, 20), UD2(0, 0, 0, 68), 15, MUTE, MED)
  local COLS = { { "#", 26 }, { "wtm.cName", 150 }, { "wtm.cScore", 58 }, { "wtm.cVk", 48 }, { "wtm.cAk", 48 }, { "wtm.cK", 48 }, { "wtm.cC", 48 }, { "wtm.cD", 48 } }
  local TW = 0
  for _, c in ipairs(COLS) do TW += c[2] end
  local NROW = 10
  local function makeTable(x)
    local o = { root = frame(res, UD2(0, TW + 16, 0, 34 + NROW * 24 + 8), UD2(0.5, x, 0, 196), RGB(10, 14, 16), 0.3, V2(0.5, 0)), rows = {} }
    o.title = label(o.root, "", UD2(1, -16, 0, 22), UD2(0, 8, 0, 4), 15, WHITE, BLACK, nil, LEFT)
    o.bar = frame(o.root, UD2(1, 0, 0, 2), UD2(0, 0, 0, 0), WHITE, 0)
    local hx = 8
    for _, c in ipairs(COLS) do
      label(o.root, (c[1] == "#") and "#" or T(c[1]), UD2(0, c[2], 0, 14), UD2(0, hx, 0, 28), 11, MUTE, MED, nil, (c[2] >= 100) and LEFT or Enum.TextXAlignment.Center)
      hx += c[2]
    end
    for i = 1, NROW do
      local r = { f = frame(o.root, UD2(1, -8, 0, 22), UD2(0, 4, 0, 34 + 10 + (i - 1) * 24), WHITE, 1), c = {} }
      local cx = 4
      for j, c in ipairs(COLS) do
        r.c[j] = label(r.f, "", UD2(0, c[2], 1, 0), UD2(0, cx, 0, 0), (j == 2) and 13 or 13, WHITE, (j == 2) and MED or BOLD, nil, (c[2] >= 100) and LEFT or Enum.TextXAlignment.Center)
        if j == 2 then r.c[j].TextTruncate = Enum.TextTruncate.AtEnd end
        cx += c[2]
      end
      o.rows[i] = r
    end
    return o
  end
  local GAPX = (TW + 16) / 2 + 12
  local tA, tB = makeTable(-GAPX), makeTable(GAPX)
  local rewards = label(res, "", UD2(0, 900, 0, 22), UD2(0.5, 0, 0, 196 + 34 + NROW * 24 + 28), 16, GOLD, BOLD, V2(0.5, 0))
  -- 科技树的明细（TechUI.lua G.treeResultText）：研究点、记在哪辆上、改装、乘员经验
  local treeT = label(res, "", UD2(0, 1100, 0, 36), UD2(0.5, 0, 0, 196 + 34 + NROW * 24 + 54), 13, GOLD, MED, V2(0.5, 0))
  treeT.Name = "TreeResult"
  treeT.TextWrapped = true
  local nextT = label(res, "", UD2(0, 600, 0, 18), UD2(0.5, 0, 0, 196 + 34 + NROW * 24 + 96), 13, MUTE, MED, V2(0.5, 0))

  local board = {}
  local baseBoard = G.onBoard
  G.onBoard = function(d)
    board = (type(d) == "table") and d or board
    if baseBoard then return baseBoard(d) end
  end
  local function fill(o, team, list, myName)
    local c = teamColor(team)
    o.bar.BackgroundColor3 = c
    o.title.Text = T("hud." .. team)
    o.title.TextColor3 = c:Lerp(WHITE, 0.3)
    local rows = {}
    for _, r in ipairs(list) do if r.t == team then table.insert(rows, r) end end
    table.sort(rows, function(a, b) return (a.s or 0) > (b.s or 0) end)
    for i, R in ipairs(o.rows) do
      local r = rows[i]
      R.f.Visible = r ~= nil
      if r then
        local mine = r.id == me.UserId or (r.id == nil and r.n == myName)
        R.f.BackgroundTransparency = mine and 0.82 or ((i % 2 == 0) and 0.95 or 1)
        local vals = { tostring(i), r.n or "?", tostring(r.s or 0), tostring(r.vk or 0), tostring(r.ak or 0), tostring(r.k or 0), tostring(r.c or 0), tostring(r.d or 0) }
        for j, l in ipairs(R.c) do
          l.Text = vals[j]
          l.TextColor3 = mine and GOLD or ((j == 2) and WHITE or MUTE:Lerp(WHITE, 0.4))
        end
      end
    end
  end
  G.wtResultsOn = function()   -- UI.lua 原来的结算卡看这个收起
    local S = G.S
    -- 还在试驾场里：这一局的结算（任务失败 / 完成）不弹（用户 11-25 晚「训练场为什么会有missionfailed」）
    return S ~= nil and S.phase == "end" and not S.pve and S.wt ~= nil and not (G.inTestDrive and G.inTestDrive())
  end
  local function stepResults(S)
    local on = G.wtResultsOn()
    res.Visible = on
    if not on then return end
    local vp = cam.ViewportSize
    resScale.Scale = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.55, 1.2)
    local won = S.winner == S.team
    banT.Text = T(won and "wtm.win" or "wtm.lose")
    banT.TextColor3 = won and RGB(236, 240, 236) or RGB(240, 120, 104)
    banLine.BackgroundColor3 = won and GOLD or BAD
    banS.Text = T((S.winner == "atk") and "ui.win.atk" or "ui.win.def") .. (S.mvp and ("   ·   MVP  " .. S.mvp) or "")
    local mine = S.team or "atk"
    fill(tA, mine, board, me.DisplayName)
    fill(tB, (mine == "atk") and "def" or "atk", board, me.DisplayName)
    local m, w = S.me or {}, S.wt or {}
    rewards.Text = T("wtm.rewards", m.s or 0, m.gain or 0, w.earned or 0, w.vk or 0, w.ak or 0)
    treeT.Text = G.treeResultText and G.treeResultText() or ""
    nextT.Text = T("ui.nextRound", S.left or 0)
  end

  ---------------------------------------------------------------- 击杀信息（战雷左边那一栏）：「玩家A [豹 2A6] 击毁 玩家B [T-72B3]」
  --   服务器 WtMatch.lua 车被打掉时发 { op = "wtFeed", k 打的人, kt 他那队, kv 他开的车, v 车里的人, vt 那队, vv 那辆车, air 打下来的是飞机, why 殉爆 / 起火 }；
  --   我方蓝、敌方红；最多 7 行，8 秒后淡掉；自己相关的那行底色亮一点
  local FEED_N = 7
  local feedBox = frame(gui, UD2(0, 460, 0, FEED_N * 22), UD2(0, 16, 0.36, 0), INK, 1)
  feedBox.Name = "WtKillFeed"
  local feedRows, feedList = {}, {}
  for i = 1, FEED_N do
    local r = frame(feedBox, UD2(1, 0, 0, 20), UD2(0, 0, 0, (i - 1) * 22), INK, 0.6)
    local l = label(r, "", UD2(1, -12, 1, 0), UD2(0, 6, 0, 0), 13, WHITE, BOLD, nil, LEFT)
    l.RichText = true
    r.Visible = false
    feedRows[i] = { f = r, l = l }
  end
  local BLUE, RED = TH.C.FRIEND, TH.C.FOE   -- 自己这边绿、对面红（统一外观，不用蓝）
  local function vehName(id, tk)   -- tk：科技树的键（科技树出的车写科技树里的名字）
    if tk then
      local nm = T("tree." .. tk)
      if nm ~= "tree." .. tk then return nm end
    end
    return id and (string.match(T("veh." .. id), "^(%S+)") or T("veh." .. id)) or nil
  end
  local function feedLine(m)
    local side = me:GetAttribute("Side")
    local function who(name, team, veh, tk)
      local col = (team == side) and BLUE or RED
      local nm = name or T("wtm.ai")
      local v = vehName(veh, tk)
      return string.format('<font color="%s">%s</font>%s', hex(col), nm, v and string.format(' <font color="#C8CDD0">[%s]</font>', v) or "")
    end
    local verb = T(m.air and "wtm.shotDown" or ((m.why == "ammo") and "wtm.ammoRack" or ((m.why == "fire") and "wtm.burned" or "wtm.destroyed")))
    if not m.k then return who(m.v, m.vt, m.vv, m.vk) .. "  " .. verb end
    return who(m.k, m.kt, m.kv, m.kk) .. "  " .. verb .. "  " .. who(m.v, m.vt, m.vv, m.vk)
  end
  -- 每帧只写变了的（11-27 M3 丝滑：原来每帧每行重设字、透明度——字一样也重排一遍）
  local function redrawFeed()
    local t = os.clock()
    for i = #feedList, 1, -1 do if t - feedList[i].t > 9 then table.remove(feedList, i) end end
    for i, R in ipairs(feedRows) do
      local e = feedList[i]
      local vis = e ~= nil
      if R.vis ~= vis then R.vis = vis R.f.Visible = vis end
      if e then
        if R.txt ~= e.txt then R.txt = e.txt R.l.Text = e.txt end
        local a = math.clamp((t - e.t - 7.5) / 1.5, 0, 1)
        if R.a ~= a then R.a = a R.l.TextTransparency = a end
        local bt = (e.mine and 0.35 or 0.6) + a * 0.4
        if R.bt ~= bt then R.bt = bt R.f.BackgroundTransparency = bt end
      end
    end
  end
  -- 新的一条（11-27「把各种动画效果做出丝滑感」）：原来一下子冒出来、下面几行一下子跳一格——
  --   现在旧的几行往下滑一格、新的那行从左上滑进第一行（Theme.T.ui 0.22 秒、Quart Out，docs/style.md「动效」）。
  --   第 i 行现在显示的是原来第 i - 1 行的那条：从「那一行现在在哪」接着滑——上一条还没滑完又来一条（打得热闹时）
  --   不会往回跳半格；都停稳了的时候就是往上一格，跟原来一样
  local TweenService = game:GetService("TweenService")
  local SLIDE = TweenInfo.new((TH.T and TH.T.ui) or 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
  local feedNow, feedStart = {}, {}
  local function slideFeed()
    if G.reducedMotion and G.reducedMotion() then return end
    for i, R in ipairs(feedRows) do feedNow[i] = R.f.Position end
    for i, R in ipairs(feedRows) do
      feedStart[i] = (i == 1) and UD2(0, -18, 0, -22) or feedNow[i - 1]
      R.f.Position = feedStart[i]
      TweenService:Create(R.f, SLIDE, { Position = UD2(0, 0, 0, (i - 1) * 22) }):Play()
    end
  end
  G.wtFeedSlide = function() return feedStart, feedRows, UD2 end   -- 测试用：上一次各行从哪开始滑、各行（UD2：测试拿来摆位置）
  -- 火炮支援的落点：地上一圈红（本队看得见；敌人只看得见炮弹落下来）
  local artyMarks = {}
  local function artyMark(e)
    if typeof(e.p) ~= "Vector3" or e.team ~= me:GetAttribute("Side") then return end
    local p = Instance.new("Part")
    p.Name = "WtArtyMark"
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Shape = Enum.PartType.Cylinder
    p.Size = Vector3.new(0.3, (e.r or 70) * 2, (e.r or 70) * 2)
    p.CFrame = CFrame.new(e.p + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, 0, math.pi / 2)
    p.Material, p.Color, p.Transparency = Enum.Material.Neon, RGB(255, 70, 50), 0.82
    p.Parent = workspace
    table.insert(artyMarks, { p = p, till = os.clock() + (e.t or 10) })
  end
  G.R.Fx.OnClientEvent:Connect(function(list)
    if type(list) ~= "table" then return end
    for _, e in ipairs(list) do
      if type(e) == "table" and e.k == "artyMark" then G.try_(artyMark, e) end
    end
  end)
  -- 战场奖章：屏幕上方一条——左边一道琥珀细条 + 名字 + 加了多少分，几个一起来就排队
  --   （统一外观 docs/style.md：不再画金色圆章、星星、22 号金字；用户 11-25「四不像」）
  local award = frame(gui, UD2(0, 260, 0, 44), UD2(0.5, 0, 0, 150), TH.C.PANEL, TH.A.panel, V2(0.5, 0))
  award.Name = "WtAward"
  award.Visible = false
  frame(award, UD2(0, 3, 1, 0), UD2(0, 0, 0, 0), GOLD, 0)
  local awName = label(award, "", UD2(1, -18, 0, 22), UD2(0, 14, 0, 3), 16, WHITE, BOLD, nil, LEFT)
  local awPts = label(award, "", UD2(1, -18, 0, 16), UD2(0, 14, 0, 24), 13, GOLD, TH.F.mono, nil, LEFT)
  local awQueue, awUntil = {}, 0
  local function nextAward()
    local a = table.remove(awQueue, 1)
    if not a then award.Visible = false return end
    awName.Text = T("wta.aw." .. a.a)
    awPts.Text = T("wtm.awardPts", a.pts or 0)
    award.Visible = true
    awUntil = os.clock() + 2.6
    if G.sfx then pcall(G.sfx, "uiClick") end
  end
  G.R.Drive.OnClientEvent:Connect(function(m)
    if type(m) == "table" and m.op == "wtAward" then
      table.insert(awQueue, m)
      if not award.Visible then nextAward() end
    end
  end)
  G.frameConn("WtAward", function()
    if award.Visible then
      local t = os.clock()
      local k = math.clamp(1 - (awUntil - t) / 0.25, 0, 1)   -- 刚出来的 0.25 秒：从大缩到正常
      local pop = 1 - math.clamp((t - (awUntil - 2.6)) / 0.25, 0, 1)
      award.Size = UD2(0, 260 * (1 + 0.06 * pop), 0, 44 * (1 + 0.06 * pop))
      if t > awUntil then nextAward() end
      local _ = k
    end
  end)
  G.R.Drive.OnClientEvent:Connect(function(m)
    if type(m) ~= "table" or m.op ~= "wtFeed" then return end
    table.insert(feedList, 1, { txt = feedLine(m), t = os.clock(), mine = m.vid == me.UserId or m.k == me.DisplayName })
    while #feedList > FEED_N do table.remove(feedList) end
    redrawFeed()
    slideFeed()
  end)
  G.wtFeedRows = function() return feedList end   -- 测试用

  ---------------------------------------------------------------- 每帧
  local chipTxt, chipY, chipW = nil, nil, nil
  G.frameConn("WtBattle", function()
    if #feedList > 0 then G.try_(redrawFeed) end
    for i = #artyMarks, 1, -1 do
      local a = artyMarks[i]
      if os.clock() > a.till then a.p:Destroy() table.remove(artyMarks, i) end
    end
    local S = G.S
    local w = S and S.wt
    if S then G.try_(stepResults, S) G.try_(stepStrip, S) end
    -- 阵亡镜头里（DeathFx：跟着残骸、看凶手）整屏只留那一行字（用户 11-27「雷达什么图全部消失」）
    local covered = (G.menuShown and G.menuShown()) or (G.boardShown and G.boardShown()) or G.factionOpen or (G.deathFxOn and G.deathFxOn())
    local driving = G.drive ~= nil or G.myVeh ~= nil
    local show = w ~= nil and not covered and not driving and (S.phase == "battle" or S.phase == "prep") and S.picked ~= false
      and not (G.hangarGui and G.hangarGui.Visible)   -- 机库顶上自己写了 SP（TechUI.lua），这一块不再叠在 3D 车上
    chip.Visible = show
    local t = os.clock()
    if w then
      if lastSp and (w.sp or 0) > lastSp then   -- 攒了 SP：下面飘一下
        gainSum = ((t < gainUntil) and gainSum or 0) + (w.sp - lastSp)
        gainUntil = t + 1.8
      end
      lastSp = w.sp or 0
    else
      lastSp = nil
    end
    if show then
      local y = ((G.hudLayout and G.hudLayout.scoreBottom) or 64) + 8
      local free = w.free and S.phase == "battle"
      local txt = string.format('<font color="%s">%s</font>   ·   %s%s', hex(GOLD), T("wtm.sp", w.sp or 0), T("wtm.lineup", #(w.order or {}), w.max or 5),
        free and ("   ·   " .. T("wtm.firstFree")) or "")
      -- 字、位置、宽度没变就不重设（11-27：原来每帧重设一遍字，界面每帧重排）；字宽照旧每帧量（字体刚载好时宽度会变）
      if txt ~= chipTxt then chipTxt = txt chipT.Text = txt end
      if y ~= chipY then
        chipY = y
        chip.Position = UD2(0.5, 0, 0, y)
        gainT.Position = UD2(0.5, 0, 0, y + 30)
      end
      local okB, tw = pcall(function() return chipT.TextBounds.X end)   -- 测试用的模拟器里没有 TextBounds：按字数估
      if not okB then tw = (utf8.len((string.gsub(chipT.Text, "<[^>]+>", ""))) or 30) * 8 end
      local cw = math.clamp(tw + 24, 200, 460)
      if cw ~= chipW then chipW = cw chip.Size = UD2(0, cw, 0, 26) end
    end
    gainT.Visible = show and t < gainUntil
    if gainT.Visible then
      gainT.Text = T("wtm.gain", math.floor(gainSum + 0.5))
      gainT.TextTransparency = math.clamp((t - (gainUntil - 0.5)) / 0.5, 0, 1)
    end
  end)
end

return WtBattle
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="288">
          <Properties>
            <string name="Name">WtCam</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——观战（用户 11-25「全部都做」⑮：战雷里被打掉以后能看队友）
--   机库（TechUI）开着的时候顶上一个「观战队友」：点了机库收起（TechUI 的 G.hangarSet 问 G.wtSpectating），镜头跟着一个
--   活着、有真人开的队友的车 / 飞机（← → 换人）；Esc 或「回机库」回去；自己出击了自动停。被打掉那一下的击杀镜头在 DeathFx.lua
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local WtCam = {}

function WtCam.init(G)
  local me = Players.LocalPlayer
  local RGB, UD2, V3 = Color3.fromRGB, UDim2.new, Vector3.new
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local BOLD = Enum.Font.BuilderSansMedium

  local gui = Instance.new("ScreenGui")
  gui.Name = "WtCam"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 15   -- 在机库（12）上面
  gui.Parent = me:WaitForChild("PlayerGui")
  local function btn(text, pos)
    local b = Instance.new("TextButton")
    b.Size, b.Position, b.AnchorPoint = UDim2.fromOffset(150, 30), pos, Vector2.new(0.5, 0)
    local TH = G.Theme   -- 统一外观：灰底白字、细边、2 像素圆角（docs/style.md）
    b.BackgroundColor3, b.BackgroundTransparency, b.BorderSizePixel = TH.C.RAISE, 0.1, 0
    b.Text, b.TextSize, b.Font, b.TextColor3 = text, TH.S.body, TH.F.bold, TH.C.TEXT
    TH.corner(b)
    TH.stroke(b)
    b.Visible = false
    b.Parent = gui
    return b
  end
  -- 「观战队友」放在机库右下角（原来在屏幕上方正中，压着机库、科技树的标题）
  local specBtn = btn(T("wt.spec"), UD2(1, -40, 1, -45))
  specBtn.AnchorPoint = Vector2.new(1, 1)
  specBtn.Size = UDim2.fromOffset(170, 36)
  specBtn.Name = "SpecBtn"
  local backBtn = btn(T("wt.specBack"), UD2(0.5, 0, 0, 92))
  backBtn.Name = "SpecBack"
  local info = Instance.new("TextLabel")
  info.BackgroundTransparency = 1
  info.Size, info.Position, info.AnchorPoint = UDim2.fromOffset(600, 24), UD2(0.5, 0, 0, 60), Vector2.new(0.5, 0)
  info.TextSize, info.Font, info.TextColor3 = 16, BOLD, G.Theme.C.TEXT
  info.TextStrokeTransparency = 0.35
  info.Visible = false
  info.Parent = gui

  local on, idx, camType0, smooth = false, 1, nil, nil
  G.wtSpectating = function() return on end
  local function mates()
    local side = me:GetAttribute("Side")
    local out = {}
    local ents = workspace:FindFirstChild("Ents")
    for _, em in ipairs(ents and ents:GetChildren() or {}) do
      local drv = em:GetAttribute("Driver")
      if em:GetAttribute("Team") == side and type(drv) == "number" and drv > 0 and drv ~= me.UserId and not em:GetAttribute("Wreck") then
        table.insert(out, em)
      end
    end
    table.sort(out, function(a, b) return (a:GetAttribute("EntId") or 0) < (b:GetAttribute("EntId") or 0) end)
    return out
  end
  local function stop()
    if not on then return end
    on = false
    local cam = workspace.CurrentCamera
    if cam and camType0 then pcall(function() cam.CameraType = camType0 end) end
    smooth = nil
    if G.hangarSet then pcall(G.hangarSet, true) end   -- 机库马上回来
  end
  local function start()
    if #mates() == 0 then
      if G.toast then G.toast(T("wt.specNone"), "info") end
      return
    end
    on, idx = true, 1
    local cam = workspace.CurrentCamera
    camType0 = cam.CameraType
    pcall(function() cam.CameraType = Enum.CameraType.Scriptable end)
    if G.hangarSet then pcall(G.hangarSet, false) end
  end
  specBtn.MouseButton1Click:Connect(start)
  G.wtSpecStart = start   -- 机库顶上的「观战」（TechUI.lua）调这个
  backBtn.MouseButton1Click:Connect(stop)
  UIS.InputBegan:Connect(function(io, gp)
    if not on or gp then return end
    if io.KeyCode == Enum.KeyCode.Escape then stop()
    elseif io.KeyCode == Enum.KeyCode.Left then idx -= 1 smooth = nil
    elseif io.KeyCode == Enum.KeyCode.Right then idx += 1 smooth = nil end
  end)

  G.frameConn("WtCam", function(dt)
    local S = G.S
    local alive = S and S.alive
    local hangar = G.hangarActive and G.hangarActive() and not alive and S and (S.phase == "battle" or S.phase == "prep")
      and not (G.deathFxOn and G.deathFxOn())
    if on and (alive or not hangar) then stop() end
    specBtn.Visible = (hangar and not on and not G.hangarHasSpec) == true   -- 开局还没有 S 时 hangar 是 nil（给 Visible 赋 nil 会报错）；机库顶上有「观战」就不画这个
    backBtn.Visible = on
    info.Visible = on
    if not on then return end
    local list = mates()
    if #list == 0 then stop() return end
    idx = ((idx - 1) % #list) + 1
    local em = list[idx]
    local okP, cf = pcall(function() return em:GetPivot() end)
    if not okP then return end
    local p = cf.Position
    local flat = V3(cf.LookVector.X, 0, cf.LookVector.Z)
    flat = (flat.Magnitude > 0.05) and flat.Unit or V3(0, 0, -1)
    local air = em:GetAttribute("Kind") == "air"
    local want = p - flat * (air and 70 or 34) + V3(0, air and 18 or 12, 0)
    smooth = smooth and smooth:Lerp(want, math.min(1, dt * 4)) or want
    workspace.CurrentCamera.CFrame = CFrame.lookAt(smooth, p + V3(0, 3, 0))
    local pl = Players:GetPlayerByUserId(em:GetAttribute("Driver"))
    local tk = em:GetAttribute("TreeKey")
    local vn = tk and T("tree." .. tk) or T("veh." .. tostring(em:GetAttribute("Model") or ""))
    info.Text = T("wt.specOn", ((pl and pl.DisplayName) or "?") .. " · " .. vn)
  end)
end

return WtCam
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="289">
          <Properties>
            <string name="Name">WtComms</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——地图方格、标点、无线电（用户 11-25「全部都做」⑭，B 挑刺 13）
--   · 方格：大地图、小地图（同一张 MapUI 的图）上画 A～J（列）/ 1～10（行）的网格，每格左上角小字「C3」；G.gridRef(x, z) → "C3"
--   · I 标点：把准星对着的地方标给全队（服务器 WtMatch.lua 的 G.ACT.wtPing 转发）——地图上一个黄圈、三维里一个黄菱形写「C3 · 谁」，10 秒
--   · O 无线电：小菜单，按数字选一句（需要支援 / 跟我来 / 收到 / 不行 / 撤退 / 这里有敌人 / 进攻、守住最近的据点），全队左边一行字；
--     「需要支援」「这里有敌人」顺手标点。菜单开着时数字键不换弹（Drive.lua 问 G.radioOpen）
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local WtComms = {}

function WtComms.init(G)
  local Map = require(RS:WaitForChild("Map"))
  local me = Players.LocalPlayer
  local RGB, UD2, V2, V3 = Color3.fromRGB, UDim2.new, Vector2.new, Vector3.new
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local BOLD, MED = Enum.Font.BuilderSansMedium, Enum.Font.BuilderSans
  local TH = G.Theme   -- 统一外观（docs/style.md）
  local YEL, WHITE, DIM = TH.C.WARN, TH.C.TEXT, TH.C.MUTE
  local COLS = { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J" }

  ---------------------------------------------------------------- 方格
  local function gridRef(x, z)
    if not G.mapUV then return "?" end
    local u, v = G.mapUV(x, z)
    local c = math.clamp(math.floor(u * 10) + 1, 1, 10)
    local r = math.clamp(math.floor(v * 10) + 1, 1, 10)
    return COLS[c] .. r
  end
  G.gridRef = gridRef
  task.spawn(function()
    for _ = 1, 200 do
      if G.mapRoot then break end
      task.wait(0.1)
    end
    local root = G.mapRoot
    if not root then return end
    local layer = Instance.new("Frame")
    layer.Name = "WtGrid"
    layer.Size = UD2(1, 0, 1, 0)
    layer.BackgroundTransparency = 1
    layer.ZIndex = 3
    layer.Parent = root
    for i = 1, 9 do
      for _, vert in ipairs({ true, false }) do
        local l = Instance.new("Frame")
        l.BorderSizePixel = 0
        l.BackgroundColor3 = RGB(255, 255, 255)
        l.BackgroundTransparency = 0.82
        l.Size = vert and UD2(0, 1, 1, 0) or UD2(1, 0, 0, 1)
        l.Position = vert and UD2(i / 10, 0, 0, 0) or UD2(0, 0, i / 10, 0)
        l.ZIndex = 3
        l.Parent = layer
      end
    end
    for c = 1, 10 do
      for r = 1, 10 do
        local t = Instance.new("TextLabel")
        t.BackgroundTransparency = 1
        t.Size = UD2(0.1, -4, 0, 12)
        t.Position = UD2((c - 1) / 10, 3, (r - 1) / 10, 2)
        t.Text = COLS[c] .. r
        t.TextSize, t.Font = 10, MED
        t.TextColor3, t.TextTransparency = WHITE, 0.45
        t.TextXAlignment = Enum.TextXAlignment.Left
        t.ZIndex = 3
        t.Parent = layer
      end
    end
  end)

  ---------------------------------------------------------------- 左边一列：无线电、标点的话（8 秒）
  local gui = Instance.new("ScreenGui")
  gui.Name = "WtComms"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 7
  gui.Parent = me:WaitForChild("PlayerGui")
  local lines = {}
  local box = Instance.new("Frame")
  box.Name = "RadioLog"
  box.BackgroundTransparency = 1
  box.Size = UDim2.fromOffset(420, 5 * 22)
  box.Position = UD2(0, 16, 0.42, 0)
  box.Parent = gui
  local rows = {}
  for i = 1, 5 do
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size = UD2(1, 0, 0, 20)
    l.Position = UD2(0, 0, 0, (i - 1) * 22)
    l.TextSize, l.Font = 15, BOLD
    l.TextColor3 = YEL
    l.TextStrokeTransparency = 0.4
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.RichText = true
    l.Visible = false
    l.Parent = box
    rows[i] = l
  end
  local function addLine(txt)
    table.insert(lines, 1, { txt = txt, t = os.clock() })
    while #lines > 5 do table.remove(lines) end
  end
  G.wtRadioLines = function() return lines end   -- 测试用

  ---------------------------------------------------------------- 标点：地图上的黄圈、三维里的黄菱形
  local pings = {}
  local fold = Instance.new("Folder")
  fold.Name = "WtPings"
  fold.Parent = workspace
  local function addPing(p, who, grid)
    local a = Instance.new("Part")
    a.Anchored, a.CanCollide, a.CanQuery, a.CanTouch, a.Transparency = true, false, false, false, 1
    a.Size = V3(0.2, 0.2, 0.2)
    a.CFrame = CFrame.new(p + V3(0, 8, 0))
    a.Parent = fold
    local bb = Instance.new("BillboardGui")
    bb.Size = UDim2.fromOffset(140, 40)
    bb.AlwaysOnTop = true
    bb.Parent = a
    local d = Instance.new("TextLabel")
    d.BackgroundTransparency = 1
    d.Size = UD2(1, 0, 0, 20)
    d.Text = "◆"
    d.TextScaled = true
    d.TextColor3 = YEL
    d.Parent = bb
    local n = Instance.new("TextLabel")
    n.BackgroundTransparency = 1
    n.Size = UD2(1, 0, 0, 16)
    n.Position = UD2(0, 0, 0, 22)
    n.Text = grid .. " · " .. (who or "")
    n.TextSize, n.Font = 12, BOLD
    n.TextColor3 = YEL
    n.TextStrokeTransparency = 0.3
    n.Parent = bb
    local dot = nil
    if G.mapDot and G.mapRoot and G.mapUV then
      local u, v = G.mapUV(p.X, p.Z)
      local marks = G.mapRoot:FindFirstChild("Marks") or G.mapRoot
      local ok, dd = pcall(G.mapDot, marks, u, v, 12, YEL, "", 8)
      if ok then dot = dd end
    end
    table.insert(pings, { a = a, dot = dot, t = os.clock() })
    while #pings > 6 do
      local old = table.remove(pings, 1)
      if old.a then old.a:Destroy() end
      if old.dot then old.dot:Destroy() end
    end
  end

  ---------------------------------------------------------------- 无线电菜单（O）
  local MSG = { "need", "follow", "ok", "no", "retreat", "enemy", "attack", "defend" }
  local menu = Instance.new("Frame")
  menu.Name = "RadioMenu"
  menu.Size = UDim2.fromOffset(260, 24 + #MSG * 24)
  menu.Position = UD2(0, 16, 0.42, -24 - #MSG * 24 - 10)
  menu.BackgroundColor3, menu.BackgroundTransparency, menu.BorderSizePixel = RGB(10, 12, 14), 0.25, 0
  menu.Visible = false
  menu.Parent = gui
  do
    local tl = Instance.new("TextLabel")
    tl.BackgroundTransparency = 1
    tl.Size = UD2(1, -12, 0, 22)
    tl.Position = UD2(0, 8, 0, 2)
    tl.Text = T("wtr.menu")
    tl.TextSize, tl.Font, tl.TextColor3 = 13, BOLD, YEL
    tl.TextXAlignment = Enum.TextXAlignment.Left
    tl.Parent = menu
    for i, k in ipairs(MSG) do
      local l = Instance.new("TextLabel")
      l.BackgroundTransparency = 1
      l.Size = UD2(1, -12, 0, 22)
      l.Position = UD2(0, 8, 0, 2 + i * 24)
      l.Text = i .. "   " .. T("wtr." .. k, "…")
      l.TextSize, l.Font, l.TextColor3 = 14, MED, WHITE
      l.TextXAlignment = Enum.TextXAlignment.Left
      l.Parent = menu
    end
  end
  local menuT = 0
  G.radioOpen = function() return menu.Visible end

  -- 准星对着哪（开车：瞄准点；开飞机：镜头前方打到的地面；步行：鼠标指的地方）
  local function aimPoint()
    local st = G.drive
    if st and st.aimPt then return st.aimPt end
    local cam = workspace.CurrentCamera
    local o, d = cam.CFrame.Position, cam.CFrame.LookVector
    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    local ex = { fold }
    if me.Character then table.insert(ex, me.Character) end
    rp.FilterDescendantsInstances = ex
    local res = workspace:Raycast(o, d * 30000, rp)
    return res and res.Position or (o + d * 3000)
  end
  local function myPos()
    local st = G.drive
    if st and st.root then return st.root.Position end
    local ch = me.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.Position or workspace.CurrentCamera.CFrame.Position
  end
  local function nearestPoint(p)
    local best, bd = nil, math.huge
    for _, pt in ipairs(Map.POINTS or {}) do
      local d = (Vector2.new(pt.x, pt.z) - Vector2.new(p.X, p.Z)).Magnitude
      if d < bd then best, bd = pt, d end
    end
    return best and best.id or "?"
  end
  local function sendRadio(i)
    local k = MSG[i]
    if not k then return end
    local arg = nil
    local pos = nil
    if k == "need" then pos = myPos() arg = gridRef(pos.X, pos.Z)
    elseif k == "enemy" then pos = aimPoint() arg = gridRef(pos.X, pos.Z)
    elseif k == "attack" or k == "defend" then arg = nearestPoint(aimPoint()) end
    G.R.Act:FireServer("wtRadio", k, arg, pos)
  end

  UIS.InputBegan:Connect(function(io, gp)
    if gp then return end
    local k = io.KeyCode
    -- 中键：标记准星对着的敌人给全队（用户 11-27「如果发现了敌载具可以进行全队标记 你仿照战雷就行」）——开车、开飞机、开船、炮手位都行；
    --   服务器 Weapons.lua G.ACT.vmark 从自己的车 / 飞机往准星方向一个窄锥里找看得见的敌人，全队屏幕上红菱形跟着它、小地图上红点。
    --   Alt + 中键是飞机的标目标点（Fly.lua），这里让开
    if io.UserInputType == Enum.UserInputType.MouseButton3 and not (UIS:IsKeyDown(Enum.KeyCode.LeftAlt) or UIS:IsKeyDown(Enum.KeyCode.RightAlt)) then
      if G.drive or G.fly or G.sail or G.gunner then G.R.Act:FireServer("vmark", aimPoint()) end
      return
    end
    if k == Enum.KeyCode.O then
      menu.Visible = not menu.Visible
      menuT = os.clock()
    elseif k == Enum.KeyCode.I then
      local p = aimPoint()
      G.R.Act:FireServer("wtPing", p)
    elseif menu.Visible then
      local nums = { One = 1, Two = 2, Three = 3, Four = 4, Five = 5, Six = 6, Seven = 7, Eight = 8 }
      local i = nums[k.Name]
      if i then
        menu.Visible = false
        sendRadio(i)
      elseif k == Enum.KeyCode.Escape then
        menu.Visible = false
      end
    end
  end)

  ---------------------------------------------------------------- 服务器转发来的
  G.R.Drive.OnClientEvent:Connect(function(m)
    if type(m) ~= "table" then return end
    if m.op == "wtPing" and typeof(m.p) == "Vector3" then
      local grid = gridRef(m.p.X, m.p.Z)
      addPing(m.p, m.from, grid)
      addLine(T("wtr.pinged", m.from or "?", grid))
      if G.sfx then pcall(G.sfx, "uiClick") end
    elseif m.op == "wtRadio" and type(m.k) == "string" then
      addLine(T("wtr.line", m.from or "?", T("wtr." .. m.k, m.arg or "")))
      if typeof(m.p) == "Vector3" then addPing(m.p, m.from, gridRef(m.p.X, m.p.Z)) end
      if G.sfx then pcall(G.sfx, "uiClick") end
    end
  end)

  local rowC = {}   -- [第几行] = { vis, txt, a } 上一帧写进去的
  G.frameConn("WtComms", function()
    local t = os.clock()
    for i = #lines, 1, -1 do if t - lines[i].t > 8 then table.remove(lines, i) end end
    -- 只写变了的（11-27 M3 丝滑：原来没有无线电的时候也每帧把每一行写一遍）
    for i, r in ipairs(rows) do
      local L = lines[i]
      local c = rowC[i]
      if not c then c = {} rowC[i] = c end
      local vis = L ~= nil
      if c.vis ~= vis then c.vis = vis r.Visible = vis end
      if L then
        if c.txt ~= L.txt then c.txt = L.txt r.Text = L.txt end
        local a = math.clamp((t - L.t - 6.5) / 1.5, 0, 1)
        if c.a ~= a then c.a = a r.TextTransparency = a end
      end
    end
    for i = #pings, 1, -1 do
      local P = pings[i]
      if t - P.t > 10 then
        if P.a then P.a:Destroy() end
        if P.dot then P.dot:Destroy() end
        table.remove(pings, i)
      end
    end
    if menu.Visible and t - menuT > 6 then menu.Visible = false end   -- 开着不选：六秒自己收起
  end)
end

return WtComms
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="290">
          <Properties>
            <string name="Name">WtFlight</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——战雷式的开飞机界面
--   用户 11-24 夜：「飞机操作ui我记得有个版本已经帮我改成战争雷霆的了 现在完全不是」「战雷ui压根不是这样的」，发了 B 站战雷视频的截图
--   （米格-29、F-15 的空战）；「不同导弹有不同锁定范围 锁定前大圈和小圈都是白色的 锁定就都变成红色」「那个雷达屏在右侧」。
--   照截图和战雷 wiki（官方英文 wiki「Airborne radars」、中文 wiki「机载雷达」「雷达告警接收器」）做，图都是框和字拼的：
--   · 左上一列小字（标签灰白、数白色等宽）：节流阀（开加力写红色「110 % 加力」）、表速、速度、马赫数、海拔高、雷达高；
--     挂的弹一种一行（「空对空 4[左] R-73」：剩几发、下一发从哪边挂架打，选中的那行前面「›」；红外导引头追踪时标签换成红色「追踪」）、
--     热焰弹、干扰箔（每组诱饵弹里两样都有：一个数）、机炮（「机 炮 自动 150 30 毫米 GSh-30-1」）、燃油量（照现在的油门还能飞几分几秒）；
--     每台发动机的油温、引擎温度（开加力油温往上走、变橙色，后面写还能撑多久）
--   · 机头一个小 ⊕（固定机炮顺着机头打）；选了导弹：大圈是这种弹导引头能锁的离轴角（每种弹不一样大，近距格斗弹的大到出屏幕），
--     小圈是导引头看着哪（追踪时滑到目标上）——锁定前都是白的，锁上都变红
--   · 雷达跟踪着的目标：方框，右边距离、接近速度（越飞越远是负的），左下高度差，下面一个圈带一根线（目标往哪飞：线朝下迎头冲你来，朝上背对你跑）
--   · 顶上一条航向罗盘（雷达看到的敌机在上面是小三角，锁着的套框）；左边雷达告警圆盘（RWR：敌机雷达扫到你标型号，锁着你一条虚线连到中间，
--     导弹打过来「MSL」红色闪、实线）；底下中间「已选武器」「导引头」两行；右边雷达屏在 Radar.lua；右上圆形小地图（TankHud 的飞机模式）；
--     左下损伤图是 C 的 WtAir.lua
--   G.wtFlightStep(st, info)：AirHud 每帧调（G.wtFlightOn 开着时 AirHud 原来那套 MWT 式的收起来）；G.wtFlightOff() 下飞机收起
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local WtFlight = {}

function WtFlight.init(G)
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local AD = require(RS:WaitForChild("AirDefs"))
  local V, V2, UD2 = Vector3.new, Vector2.new, UDim2.new
  local RGB = Color3.fromRGB
  local clamp, rad, deg = math.clamp, math.rad, math.deg
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
  local TH = G.Theme   -- 统一外观（docs/style.md）
  local HUD = TH.C.HUD                     -- 战雷平显的绿（界面一律绿色：用户 11-21）
  local TXT, LAB = TH.C.TEXT, TH.C.MUTE   -- 左上：数白、标签灰白
  local RED, ORG, WHITE = TH.C.BAD, TH.C.WARN, Color3.new(1, 1, 1)
  local INK = RGB(0, 0, 0)
  local MONO, SANS = Enum.Font.RobotoMono, Enum.Font.BuilderSans
  G.wtFlightOn = true

  local gui = Instance.new("ScreenGui")
  gui.Name = "WtFlight"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 5
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local function frame(parent, size, pos, col, tr, anchor)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.AnchorPoint = size, pos or UD2(), anchor or V2()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = col or INK, tr or 1, 0
    f.Parent = parent
    return f
  end
  local function label(parent, size, pos, ts, col, font, anchor, align)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.Text, l.TextSize, l.TextColor3, l.Font = "", ts or 13, col or TXT, font or MONO
    l.TextXAlignment = align or Enum.TextXAlignment.Left
    l.TextStrokeTransparency, l.TextStrokeColor3 = 0.55, INK
    l.Parent = parent
    return l
  end
  local function ringOf(parent, px, col, th)   -- 一个圈：圆角框 + 描边
    local f = frame(parent, UDim2.fromOffset(px, px), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0.5, 0)
    c.Parent = f
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = col or WHITE, th or 1.4, 0
    s.Parent = f
    return f, s
  end
  local function seg(parent, col, th)   -- 一段线（setSeg 摆两头）
    local f = frame(parent, UDim2.fromOffset(2, th or 1.4), UD2(), col or HUD, 0, V2(0.5, 0.5))
    f.Visible = false
    return f
  end
  local function setSeg(f, x0, y0, x1, y1)
    local dx, dy = x1 - x0, y1 - y0
    f.Size = UDim2.fromOffset(math.sqrt(dx * dx + dy * dy), f.Size.Y.Offset)
    f.Position = UDim2.fromOffset((x0 + x1) / 2, (y0 + y1) / 2)
    f.Rotation = deg(math.atan2(dy, dx))
    f.Visible = true
  end

  local W = {}
  G.wtFlight = W   -- 测试用

  ---------------------------------------------------------------- 左上：参数表
  local LIST_X = mobile and 12 or 70   -- 让开左上角的菜单键（≡）、Roblox 自己那排按钮
  local list = frame(gui, UDim2.fromOffset(330, 470), UD2(0, LIST_X, 0, mobile and 64 or 58))
  list.Name = "WtParams"
  local ROW, COL1, COL2 = 16, 74, 178
  local rows = {}
  local function row(i)
    local r = rows[i]
    if r then return r end
    local y = (i - 1) * ROW
    r = {}
    r.mk = label(list, UDim2.fromOffset(10, ROW), UD2(0, -2, 0, y), 13, TXT, MONO)
    r.lab = label(list, UDim2.fromOffset(COL1 - 10, ROW), UD2(0, 10, 0, y), 13, LAB, SANS)
    r.val = label(list, UDim2.fromOffset(COL2 - COL1, ROW), UD2(0, COL1 + 8, 0, y), 13, TXT, MONO)
    r.ext = label(list, UDim2.fromOffset(160, ROW), UD2(0, COL2 + 8, 0, y), 13, TXT, MONO)
    r.lab.Name, r.val.Name, r.ext.Name = "Lab" .. i, "Val" .. i, "Ext" .. i
    rows[i] = r
    return r
  end
  local nRows = 0
  local function put(mk, lab, val, ext, labCol, valCol)
    nRows += 1
    local r = row(nRows)
    r.mk.Text, r.lab.Text, r.val.Text, r.ext.Text = mk or "", lab or "", val or "", ext or ""
    r.lab.TextColor3, r.val.TextColor3, r.ext.TextColor3 = labCol or LAB, valCol or TXT, valCol or TXT
    r.mk.Visible, r.lab.Visible, r.val.Visible, r.ext.Visible = true, true, true, true
  end
  local function gap()
    nRows += 1
    local r = row(nRows)
    r.mk.Text, r.lab.Text, r.val.Text, r.ext.Text = "", "", "", ""
  end
  W.rows = rows

  -- 大气（国际标准大气，对流层）：表速 = 真速 × √(ρ / ρ0)，声速按温度
  local function atmo(hM)
    local h = clamp(hM, -500, 20000)
    local Tk = math.max(216.65, 288.15 - 0.0065 * h)
    local rho = (h < 11000) and (1 - 2.25577e-5 * h) ^ 4.25588 or 0.2971 * math.exp(-(h - 11000) / 6341.6)
    return rho, 20.05 * math.sqrt(Tk)
  end
  -- 发动机温度（只是看的：油门越大越热，开加力油温慢慢往上走、过了 105 °C 变橙色，写还能撑多久——战雷那样；不影响推演）
  local eng = { oil = 88, egt = 520, abT = 0 }
  local KIND_LAB = { aam = "wt.aam", agm = "wt.agm", bomb = "wt.bomb", rkt = "wt.rkt" }

  ---------------------------------------------------------------- 机头 ⊕、导弹的大圈小圈
  local bore = frame(gui, UDim2.fromOffset(26, 26), UD2(0.5, 0, 0.5, 0), INK, 1, V2(0.5, 0.5))
  bore.Name = "WtBore"
  do
    local _, s = ringOf(bore, 16, HUD, 1.4)
    s.Parent.Name = "Ring"
    for _, a in ipairs({ { 0, -10, 1.4, 8 }, { 0, 10, 1.4, 8 }, { -10, 0, 8, 1.4 }, { 10, 0, 8, 1.4 } }) do   -- 十字从圈里伸出来一点
      local f = frame(bore, UDim2.fromOffset(a[3], a[4]), UD2(0.5, a[1], 0.5, a[2]), HUD, 0, V2(0.5, 0.5))
      f.Name = "Tick"
    end
  end
  bore.Visible = false
  local bigC, bigS = ringOf(gui, 200, WHITE, 1.5)
  bigC.Name = "SeekerCone"
  bigC.Visible = false
  local smallC, smallS = ringOf(gui, 26, WHITE, 1.6)
  smallC.Name = "SeekerHead"
  smallC.Visible = false
  -- 雷达近战模式的扫描区（Radar.lua 的 G.radarAcmZone，机体坐标）：竖扫两条竖线、平显视场 / 可挪一个框、瞄准线 / 头盔一个小圈
  local acmZ = frame(gui, UDim2.fromScale(1, 1), UD2(), INK, 1)
  acmZ.Name = "WtAcmZone"
  acmZ.Visible = false
  local acmSeg = {}
  for i = 1, 4 do
    acmSeg[i] = seg(acmZ, HUD, 1.4)
    acmSeg[i].Name = "AcmEdge"
  end
  local acmRing = ringOf(acmZ, 20, HUD, 1.4)
  acmRing.Name = "AcmRing"

  ---------------------------------------------------------------- 锁定框（雷达 / 导引头跟踪着的目标）
  local box = frame(gui, UDim2.fromOffset(30, 30), UD2(), INK, 1, V2(0.5, 0.5))
  box.Name = "WtLockBox"
  local boxS = Instance.new("UIStroke")
  boxS.Color, boxS.Thickness = HUD, 1.6
  boxS.Parent = box
  box.Visible = false
  local bDist = label(box, UDim2.fromOffset(90, 15), UD2(1, 4, 0, -2), 13, HUD, MONO)
  local bVc = label(box, UDim2.fromOffset(90, 15), UD2(1, 4, 0, 14), 13, HUD, MONO)
  local bAlt = label(box, UDim2.fromOffset(70, 15), UD2(0, 0, 1, 3), 13, HUD, MONO, V2(1, 0), Enum.TextXAlignment.Right)
  bDist.Name, bVc.Name, bAlt.Name = "Range", "Closure", "AltDiff"
  for _, l in ipairs({ bDist, bVc, bAlt }) do l.TextStrokeTransparency = 0.3 end
  -- 目标往哪飞：一个小圈、从圈心伸出一根线（线朝下迎头、朝上背对着跑；左右按它横着飞的方向）
  local asp = frame(box, UDim2.fromOffset(24, 24), UD2(0.5, 0, 1, 18), INK, 1, V2(0.5, 0.5))
  asp.Name = "Aspect"
  ringOf(asp, 10, HUD, 1.4)
  local aspLine = frame(asp, UDim2.fromOffset(1.6, 11), UD2(0.5, 0, 0.5, 0), HUD, 0, V2(0.5, 0))
  aspLine.Name = "AspectLine"
  local tracks = setmetatable({}, { __mode = "k" })
  local function velOf(em, p, t)   -- 目标的速度（服务器不发速度）：只在服务器真挪了它时按两次挪之间的时间算、按时间平滑（View.lua G.velTrack）
    local r = tracks[em]
    if not r then
      r = {}
      tracks[em] = r
    end
    if G.velTrack then return G.velTrack(r, p, t, 3000) end
    r.p, r.t, r.v = p, t, r.v or V()
    return r.v
  end

  ---------------------------------------------------------------- 顶上：航向罗盘
  local TAPE_W, TAPE_DEG = 380, 30   -- 宽多少像素、两头各多少度
  local tape = frame(gui, UDim2.fromOffset(TAPE_W, 34), UD2(0.5, 0, 0, mobile and 40 or 6), INK, 1, V2(0.5, 0))
  tape.Name = "WtHeading"
  tape.ClipsDescendants = true
  local tapeMarks = {}
  for i = 1, 16 do
    local l = label(tape, UDim2.fromOffset(40, 14), UD2(), 12, TXT, MONO, V2(0.5, 0), Enum.TextXAlignment.Center)
    local tk = frame(tape, UDim2.fromOffset(1.4, 5), UD2(), TXT, 0.2, V2(0.5, 0))
    tapeMarks[i] = { l = l, tk = tk }
  end
  local caret = label(gui, UDim2.fromOffset(20, 12), UD2(0.5, 0, 0, (mobile and 40 or 6) + 30), 11, TXT, MONO, V2(0.5, 0), Enum.TextXAlignment.Center)
  caret.Text = "^"
  caret.Name = "WtHeadingCaret"
  local tapeTri = {}   -- 雷达看到的敌机：罗盘上一个小菱形（锁着的换成方框）
  for i = 1, 10 do
    local tr = frame(tape, UDim2.fromOffset(7, 7), UD2(), RED, 0, V2(0.5, 0.5))
    tr.Name = "Contact"
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = HUD, 1.4, 1
    s.Parent = tr
    tr.Visible = false
    tapeTri[i] = { f = tr, s = s }
  end

  ---------------------------------------------------------------- 左边：雷达告警圆盘（RWR）
  local RW = 150
  local rwr = frame(gui, UDim2.fromOffset(RW, RW), UD2(0, mobile and 18 or 46, 0.5, 70), INK, 1, V2(0, 0.5))
  rwr.Name = "WtRwr"
  do
    local o = ringOf(rwr, RW, HUD, 1.4)
    o.Name = "Outer"
    local i2 = ringOf(rwr, RW * 0.62, HUD, 1)
    i2.Name = "Inner"
    local plus = label(rwr, UDim2.fromOffset(20, 20), UD2(0.5, 0, 0.5, 0), 16, HUD, MONO, V2(0.5, 0.5), Enum.TextXAlignment.Center)
    plus.Text = "+"
  end
  local rwrBg = Instance.new("UICorner")
  rwrBg.CornerRadius = UDim.new(0.5, 0)
  rwrBg.Parent = rwr
  rwr.BackgroundColor3, rwr.BackgroundTransparency = RGB(0, 30, 10), 0.75
  local rwrTags, rwrLines = {}, {}
  for i = 1, 8 do
    local l = label(rwr, UDim2.fromOffset(40, 14), UD2(), 12, HUD, MONO, V2(0.5, 0.5), Enum.TextXAlignment.Center)
    l.Visible = false
    rwrTags[i] = l
    local dashes = {}
    for k = 1, 6 do
      dashes[k] = seg(rwr, HUD, 1.4)
      dashes[k].Name = "RwrDash"
    end
    rwrLines[i] = dashes
  end
  local threats = {}   -- [实体 id] = { t 最后一次, lock 锁着我到什么时候, msl 导弹打过来到什么时候 }
  function G.wtRwrEvent(op, m)   -- Fly.lua 收到服务器的 rwr / rwrLock 时转过来
    if op == "rwrLock" and m.by then
      local r = threats[m.by] or {}
      r.lock = os.clock() + 1.1
      threats[m.by] = r
    elseif op == "rwr" then
      W.mslUntil = os.clock() + 4
      W.mslBy = W.lastLockBy
    end
    if op == "rwrLock" then W.lastLockBy = m.by end
  end

  ---------------------------------------------------------------- 底下中间：已选武器、导引头
  local selW = label(gui, UDim2.fromOffset(420, 16), UD2(0.5, -130, 1, mobile and -150 or -118), 14, TXT, SANS)
  local selS = label(gui, UDim2.fromOffset(420, 16), UD2(0.5, -130, 1, mobile and -132 or -100), 14, TXT, SANS)
  selW.Name, selS.Name = "WtSelWeapon", "WtSeeker"

  ---------------------------------------------------------------- 每帧
  local lastT = -9
  local function px(degs)   -- 离轴角 → 屏幕上离画面中心多少像素（按镜头视场）
    local vh = math.max(cam.ViewportSize.Y, 1)
    return (vh / 2) / math.tan(rad(cam.FieldOfView / 2)) * math.tan(rad(clamp(degs, 0, 85)))
  end
  local function proj(p)
    local sp, on = cam:WorldToViewportPoint(p)
    return UDim2.fromOffset(sp.X, sp.Y), on and sp.Z > 0, sp
  end

  function G.wtFlightStep(st, info)
    if not G.wtFlightOn or not info.pilot or st.uav then
      gui.Enabled = false
      return
    end
    gui.Enabled = true
    local t = os.clock()
    local dt = math.min(0.1, t - lastT)
    lastT = t
    local d = info.d
    local cf = st.cf
    local pos = cf.Position
    local jet = d.kind == "jet"

    -- ① 左上参数表
    nRows = 0
    local thr = st.thr or 0
    if jet then
      if thr > 100.5 then put(nil, T("wt.thr"), string.format("%d %% %s", math.floor(thr + 0.5), T("wt.ab")), nil, nil, RED)
      else put(nil, T("wt.thr"), string.format("%d %%", math.floor(thr + 0.5))) end
    else
      put(nil, T("wt.rotor"), string.format("%d %%", math.floor((st.rpm or 0) + 0.5)))
    end
    local hM = pos.Y / AD.M
    local rho, a = atmo(hM)
    local tas = st.vel.Magnitude / AD.M
    put(nil, T("wt.ias"), string.format("%d km/h", math.floor(tas * math.sqrt(rho) * 3.6 + 0.5)))
    put(nil, T("wt.tas"), string.format("%d km/h", math.floor(tas * 3.6 + 0.5)))
    put(nil, T("wt.mach"), string.format("%.2f", tas / a))
    put(nil, T("wt.alt"), T("wt.m", math.floor(hM + 0.5)))
    put(nil, T("wt.ralt"), T("wt.m", math.max(0, info.agl or 0)))
    gap()
    -- 挂的弹：一种一行（机炮放最后），选中的前面「›」
    local items = info.wl or {}
    local gunIt, flareIt = nil, nil
    local lk = info.lock
    for _, it in ipairs(items) do
      if it.flare then flareIt = it
      elseif it.w and it.w.kind == "gun" then gunIt = gunIt or it
      elseif it.w then
        local labK = KIND_LAB[it.w.kind] or "wt.agm"
        local labCol = nil
        if it.sel and lk and lk.on and lk.seeker == "ir" and not lk.locked then labK, labCol = "wt.track", RED end   -- 红外导引头在追踪
        local n = it.n or 0
        local side = (n % 2 == 0) and T("wt.left") or T("wt.right")   -- 左右挂架轮着打
        put(it.sel and ">" or "", T(labK), (n > 0) and string.format("%d[%s]", n, side) or "0", T("aw." .. it.wid), labCol, (n > 0) and TXT or RED)
      end
    end
    local nf = flareIt and flareIt.n or st.flares or 0
    put("", T("wt.flare"), tostring(nf), nil, nil, (nf > 0) and TXT or RED)
    put("", T("wt.chaff"), tostring(nf), nil, nil, (nf > 0) and TXT or RED)
    if gunIt then
      put(gunIt.sel and ">" or "", T("wt.gun"), tostring(gunIt.n or 0), T("aw." .. gunIt.wid), nil, ((gunIt.n or 0) > 0) and TXT or RED)
    end
    put("", T("wt.fuel"), info.fuelT or "--:--", nil, nil, info.fuelCol or TXT)
    gap()
    -- 发动机：每台一组油温、引擎温度——跟着发动机真实的状态走（用户 11-26「飞机发动机有 bug」）：
    --   原来开加力一分钟油温过 105 °C 就挂一个橙色的「还能撑多久」倒计时，可油温最高只到 116 °C，倒计时永远停在 0:33 走不完
    --   （喷气机在这里不会过热坏掉，战雷的喷气机也不过热）——倒计时去掉；
    --   发动机受伤：排气温度高、发涩（橙）；打坏 / 没油熄火：两个温度一路往下掉（红，写「熄火」）
    local k = clamp(thr / 100, 0, 1.3)
    local wae = G.wtaFlight and G.wtaFlight(st.em)
    local engK = wae and wae.eng or 1
    local dead = st.out == true or engK <= 0
    if jet then
      local ab = thr > 100.5 and not dead
      eng.abT = ab and math.min(eng.abT + dt, 120) or math.max(0, eng.abT - dt * 0.5)
      local oilT = dead and 45 or (84 + 14 * math.min(k, 1) + eng.abT / 120 * 6)
      local egtT = dead and 160 or (520 + 330 * math.min(k, 1) + (ab and 100 or 0) + (1 - engK) * 160)
      eng.oil += (oilT - eng.oil) * math.min(1, dt * (dead and 0.08 or 0.4))
      eng.egt += (egtT - eng.egt) * math.min(1, dt * (dead and 0.35 or 1.5))
    else
      local r = clamp((st.rpm or 0) / 100, 0, 1)
      eng.oil += (((dead and 45) or (80 + 20 * r)) - eng.oil) * math.min(1, dt * (dead and 0.08 or 0.4))
      eng.egt += (((dead and 160) or (480 + 260 * r + (1 - engK) * 140)) - eng.egt) * math.min(1, dt * (dead and 0.35 or 1.5))
    end
    local nEng = (d.eng and #d.eng > 0) and #d.eng or 1
    local hurt = not dead and engK < 1
    local col = (dead and RED) or (hurt and ORG) or TXT
    for _ = 1, math.min(nEng, 3) do
      put("", T("wt.oil"), string.format("%d°C", math.floor(eng.oil + 0.5)), nil, (dead or hurt) and col or nil, col)
      put("", T("wt.eng"), dead and string.format("%d°C %s", math.floor(eng.egt + 0.5), T("wt.engOff")) or string.format("%d°C", math.floor(eng.egt + 0.5)),
        nil, (dead or hurt) and col or nil, col)
    end
    for i = nRows + 1, #rows do
      local r = rows[i]
      r.mk.Visible, r.lab.Visible, r.val.Visible, r.ext.Visible = false, false, false, false
    end

    -- ② 机头 ⊕、导弹的大圈小圈
    local bp, bon = proj(pos + cf.LookVector * 600)
    bore.Position, bore.Visible = bp, bon and not st.eo and not st.bsight
    local w = info.w
    local missile = w and (w.kind == "aam" or w.kind == "agm") and (w.cone or 0) > 0
    if missile and bon and not st.eo and not st.bsight then
      local locked = lk and lk.on and lk.locked
      local col = locked and RED or WHITE
      local r0 = px(w.cone) * 2
      bigC.Size, bigC.Position, bigC.Visible = UDim2.fromOffset(r0, r0), bp, true
      bigS.Color = col
      -- 小圈：导引头看着哪——没目标在大圈中心；追踪 / 锁定时滑到目标上（红外的从机头滑过去，雷达弹锁着就在目标上）
      local sp = bp
      if lk and lk.on and lk.p then
        local kk = locked and 1 or clamp(lk.k or 0, 0, 1)
        sp = bp:Lerp(lk.p, (lk.seeker == "ir") and kk or (locked and 1 or 0))
      end
      smallC.Position, smallC.Visible = sp, true
      smallC.Size = UDim2.fromOffset(locked and 22 or 26, locked and 22 or 26)
      smallS.Color = col
    else
      bigC.Visible, smallC.Visible = false, false
    end
    -- 雷达近战模式的扫描区：按机体坐标的角度投到画面上（离机头 800 格的那个面）；竖扫的上头（+50°）多半在画面外，线照样画（屏幕边上截断）
    local zA = G.radarAcmZone and G.radarAcmZone()
    if zA and not st.eo and not st.bsight then
      local function at(a, e)
        local ca, ce = math.cos(rad(a)), math.cos(rad(e))
        local dir = cf:VectorToWorldSpace(V(math.sin(rad(a)) * ce, math.sin(rad(e)), -ca * ce))
        local _, _, sp = proj(pos + dir * 800)
        return sp.X, sp.Y, sp.Z > 1
      end
      local okAll = true
      if zA.fixed or zA.head then
        local x, y, on = at(zA.cAz, zA.cEl)
        local r0 = math.max(px(math.max(zA.A, zA.H, zA.beam or 2)) * 2, 12)
        acmRing.Position, acmRing.Size, acmRing.Visible = UDim2.fromOffset(x, y), UDim2.fromOffset(r0, r0), on
        for _, s2 in ipairs(acmSeg) do s2.Visible = false end
        okAll = on
      else
        acmRing.Visible = false
        local a0, a1, e0, e1 = zA.cAz - zA.A, zA.cAz + zA.A, zA.cEl - zA.H, zA.cEl + zA.H
        local x00, y00, o1 = at(a0, e0)
        local x10, y10, o2 = at(a1, e0)
        local x01, y01, o3 = at(a0, e1)
        local x11, y11, o4 = at(a1, e1)
        okAll = o1 and o2 and o3 and o4
        if okAll then
          setSeg(acmSeg[1], x00, y00, x01, y01)   -- 左边
          setSeg(acmSeg[2], x10, y10, x11, y11)   -- 右边
          if zA.vert then   -- 竖扫只画两条竖线
            acmSeg[3].Visible, acmSeg[4].Visible = false, false
          else
            setSeg(acmSeg[3], x01, y01, x11, y11)
            setSeg(acmSeg[4], x00, y00, x10, y10)
          end
        else
          for _, s2 in ipairs(acmSeg) do s2.Visible = false end
        end
      end
      acmZ.Visible = okAll
    else
      acmZ.Visible = false
    end

    -- ③ 锁定框：距离、接近速度、高度差、目标往哪飞（选的弹没锁、雷达 STT 锁着的也画：雷达锁定跟所选武器无关）
    local tgt, blk = st.lock, lk
    if not (blk and blk.on and blk.p and tgt) and st.rdLock and not st.rdLock.mem and st.rdLock.p then
      local rp, ron = proj(st.rdLock.p)
      if ron then blk, tgt = { on = true, p = rp, dist = st.rdLock.dist }, st.rdLock end
    end
    if blk and blk.on and blk.p and tgt and not st.eo and not st.bsight then
      box.Visible = true
      box.Position = blk.p
      local m = (blk.dist or 0) / AD.M
      bDist.Text = (m >= 1000) and string.format("%.1f km", m / 1000) or string.format("%d m", math.floor(m + 0.5))
      bVc.Text = blk.vc and string.format("%d m/s", math.floor(blk.vc + 0.5)) or ""
      local em = tgt.em
      local root = em and em.Parent and em:FindFirstChild("Root")
      if root then
        local tp = root.CFrame.Position
        local dh = (tp.Y - pos.Y) / AD.M
        bAlt.Text = (math.abs(dh) >= 1000) and string.format("%+.0f km", dh / 1000) or string.format("%+d m", math.floor(dh / 10 + 0.5) * 10)
        local vT = velOf(em, tp, t)
        local los = (pos - tp)   -- 从目标看向我
        if vT.Magnitude > 5 and los.Magnitude > 1 then
          local u = los.Unit
          local head = vT.Unit:Dot(u)   -- 1 迎头冲我来、−1 背对我
          local side = cam.CFrame.RightVector:Dot(vT.Unit)
          local ang = deg(math.acos(clamp(head, -1, 1)))   -- 0 迎头、180 背对
          aspLine.Rotation = (side >= 0) and -ang or ang   -- 0°：线朝下（迎头）
          aspLine.Visible = true
        else
          aspLine.Visible = false
        end
      else
        bAlt.Text = ""
        aspLine.Visible = false
      end
    else
      box.Visible = false
    end

    -- ④ 航向罗盘
    local lv = cf.LookVector
    local hdg = (deg(math.atan2(lv.X, -lv.Z)) + 360) % 360
    local base = math.floor((hdg - TAPE_DEG) / 5) * 5
    local CARD = { [0] = "N", [90] = "E", [180] = "S", [270] = "W" }
    for i, mk in ipairs(tapeMarks) do
      local h = base + (i - 1) * 5
      local off = h - hdg
      local x = TAPE_W / 2 + off / TAPE_DEG * (TAPE_W / 2)
      local hh = (h % 360 + 360) % 360
      mk.l.Visible = x > 8 and x < TAPE_W - 8 and (hh % 10 == 0 or hh % 5 == 0)
      mk.tk.Visible = mk.l.Visible
      if mk.l.Visible then
        mk.l.Position = UDim2.fromOffset(x, 0)
        mk.tk.Position = UDim2.fromOffset(x, 15)
        mk.l.Text = CARD[hh] or tostring(hh)
        mk.l.TextColor3 = CARD[hh] and HUD or TXT
      end
    end
    local contacts = G.airRadarContacts and G.airRadarContacts() or {}   -- Radar.lua（Hud.lua 的 G.radarContacts 是小地图那份）
    local ni = 0
    for _, c in ipairs(contacts) do
      if ni < #tapeTri and math.abs(c.az) < TAPE_DEG then
        ni += 1
        local tr = tapeTri[ni]
        tr.f.Position = UDim2.fromOffset(TAPE_W / 2 + c.az / TAPE_DEG * (TAPE_W / 2), 26)
        tr.f.Rotation = c.locked and 0 or 45
        tr.f.Size = c.locked and UDim2.fromOffset(9, 9) or UDim2.fromOffset(6, 6)
        tr.f.BackgroundTransparency = c.locked and 1 or (c.friend and 0.65 or 0)   -- 敌我识别认出的友机：淡一点（Radar.lua contacts.friend）
        tr.s.Transparency = c.locked and 0 or 1
        tr.f.Visible = true
      end
    end
    for i = ni + 1, #tapeTri do tapeTri[i].f.Visible = false end

    -- ⑤ 雷达告警圆盘：敌机的雷达扫到我（在它的扫描范围里）标型号，锁着我虚线连到中间，导弹打过来实线、红色闪
    local ents = workspace:FindFirstChild("Ents")
    local side = me:GetAttribute("Side")
    local myYaw = math.atan2(lv.X, -lv.Z)
    local ti = 0
    local R0 = RW / 2
    local function place(i, bearing, rr, text, col, mode)   -- mode：nil 只有字、"dash" 虚线、"solid" 实线
      local x = R0 + math.sin(bearing) * rr
      local y = R0 - math.cos(bearing) * rr
      local tag = rwrTags[i]
      tag.Text, tag.TextColor3, tag.Visible = text, col, true
      tag.Position = UDim2.fromOffset(x, y)
      local dashes = rwrLines[i]
      for kq, dsh in ipairs(dashes) do
        if mode then
          local n = #dashes
          local a0, a1 = (kq - 1) / n, (kq - (mode == "dash" and 0.45 or 0)) / n
          local ex, ey = R0 + math.sin(bearing) * (rr - 9), R0 - math.cos(bearing) * (rr - 9)
          setSeg(dsh, R0 + (ex - R0) * a0, R0 + (ey - R0) * a0, R0 + (ex - R0) * a1, R0 + (ey - R0) * a1)
          dsh.BackgroundColor3 = col
        else
          dsh.Visible = false
        end
      end
    end
    local mslOn = W.mslUntil and t < W.mslUntil
    for _, em in ipairs(ents and ents:GetChildren() or {}) do
      if ti >= #rwrTags then break end
      local mdl = em:GetAttribute("Model")
      -- 敌机的雷达按它的科技树版本取（Radars.lua：F-16A 是 APG-66、苏-30SM 是 N011M），不是只看型号
      local rd = mdl and AD.radarOf and AD.radarOf(mdl, em:GetAttribute("TreeKey"))
      local root = em:FindFirstChild("Root")
      if rd and root and em ~= st.em and em:GetAttribute("Team") ~= side and em:GetAttribute("Kind") == "air" and (em:GetAttribute("Hp") or 1) > 0 then
        local rc = root.CFrame
        local to = pos - rc.Position
        local dist = to.Magnitude
        local id = em:GetAttribute("EntId")
        local th = id and threats[id]
        local locking = th and th.lock and t < th.lock
        local l = rc:VectorToObjectSpace(to / math.max(dist, 1))
        -- 扫到我：在它的量程里、它默认扫描方式的方位宽度里（第 4 步以前没有扫描中心；不然苏-35S 的 ±120° 万向架一下子全扫得到）、俯仰万向架里
        local elT = deg(math.asin(clamp(l.Y, -1, 1)))
        local inScan = dist <= rd.range and math.abs(deg(math.atan2(l.X, -l.Z))) <= (AD.Radars and AD.Radars.half(rd) or rd.az) and elT <= rd.elU and elT >= -rd.elD
        if inScan or locking then
          ti += 1
          local rel = -to
          local bearing = math.atan2(rel.X, -rel.Z) - myYaw
          local missileHere = mslOn and (W.mslBy == id)
          local rr = R0 * (missileHere and 0.42 or (locking and 0.6 or 0.8))
          local code = rd.rwr or string.upper(string.sub(mdl, 1, 4))   -- 告警器代号（Radars.lua 的 rwr：米格-29 写 29，不再是型号前四个字母 MIG2）
          if missileHere then
            place(ti, bearing, rr, ((t * 4) % 1 < 0.6) and "MSL" or "", RED, "solid")
          elseif locking then
            place(ti, bearing, rr, code, ORG, "dash")
          else
            place(ti, bearing, rr, code, HUD, nil)
          end
        end
      end
    end
    if mslOn and not (W.mslBy and threats[W.mslBy]) and ti < #rwrTags then   -- 导弹打过来、不知道是谁打的：正后方闪「MSL」
      ti += 1
      place(ti, math.pi, R0 * 0.42, ((t * 4) % 1 < 0.6) and "MSL" or "", RED, "solid")
    end
    for i = ti + 1, #rwrTags do
      rwrTags[i].Visible = false
      for _, dsh in ipairs(rwrLines[i]) do dsh.Visible = false end
    end
    for id, th in pairs(threats) do
      if not th.lock or t - th.lock > 5 then threats[id] = nil end
    end

    -- ⑥ 底下中间：已选武器、导引头
    if w and info.wid then
      selW.Text = T("wt.selW", T("aw." .. info.wid), T("air.k." .. (w.kind or "agm")))
      if w.kind == "aam" or (w.kind == "agm" and (w.cone or 0) > 0) then
        local stt = (lk and lk.on) and (lk.locked and "wt.seekLock" or "wt.seekTrack") or "wt.seekOn"
        selS.Text = T("wt.seeker", T(stt))
        selS.TextColor3 = (lk and lk.on and lk.locked) and RED or TXT
      else
        selS.Text = ""
      end
    else
      selW.Text, selS.Text = "", ""
    end
  end

  function G.wtFlightOff()
    gui.Enabled = false
  end
  G.wtFlightGui = gui   -- 测试用
  G.frameConn("WtFlight", function()
    if gui.Enabled and os.clock() - lastT > 0.25 then gui.Enabled = false end
  end)
end

return WtFlight
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="291">
          <Properties>
            <string name="Name">WtHud</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——战雷式伤害的界面（用户 11-24「把整个游戏做成战雷」：乘员和模块伤害 + X 光回放）
--   · 命中提示（打出去的）：准星下面一行——击穿（橙）/ 未击穿（灰）/ 跳弹（黄）/ 已击毁（红：弹药殉爆、车组全灭、烧毁），
--     后面跟这一发伤了谁：「炮长阵亡 · 炮闩损毁 · 起火」
--   · X 光命中回放（右上一个窗，照战雷：贴近命中点看，三到七秒）：目标车的外形半透明、里面的乘员和模块素模，打坏的上色（受损黄、
--     打坏近黑 + 橙框、乘员受伤黄 / 阵亡红），弹药 / 发动机标识色（洋红 / 电光蓝）；上面正中结果字，窗口下面车组和一行行损伤；
--     弹芯 / 射流一道橙线、破片一锥灰白线、打中东西的地方红点、命中点一团红光（服务器、客户端用同一个伪随机，画出来和算的一样）；
--     跳弹 / 没击穿也放（静止的，弹开的方向一截橙线）
--   · 自己的车挨打：底下一行红字「被击穿：装填手阵亡」；左下车组 / 模块面板（驾 / 炮 / 车 / 装，发 / 传 / 履 / 炮管 / 闩 / 驱 / 弹 / 油），
--     起火、维修进度、「Y 维修 / 灭火」提示；换位「装填手 6 秒后接替炮长」
--   服务器 Wt.lua 发 { op = "wtHit" / "wtHurt" / "wtSwap" / "wtSwapped" / "wtFireOut" / "wtFixed" }，车的状态在实体属性 WtC / WtM / WtF / WtFix
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local WtHud = {}

function WtHud.init(G)
  local W = require(RS:WaitForChild("WtDamage"))
  local VD = require(RS:WaitForChild("VehDefs"))
  local XO = nil   -- X 透视（XrayOwn.lua）的共用形状：X 光回放里的乘员也画成零件拼的人
  do
    local ms = script.Parent and script.Parent:FindFirstChild("XrayOwn")
    if ms then
      local ok, r = pcall(require, ms)
      if ok and type(r) == "table" then XO = r end
    end
  end
  local V2, V3, UD2 = Vector2.new, Vector3.new, UDim2.new
  local CF = CFrame.new
  local RGB = Color3.fromRGB
  local me = Players.LocalPlayer
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local BOLD, MONO = Enum.Font.BuilderSansMedium, Enum.Font.RobotoMono
  local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
  local TH = G.Theme   -- 统一外观（docs/style.md）
  local OK, HURT, DEAD, GREY = TH.C.GOOD, TH.C.WARN, TH.C.BAD, TH.C.MUTE
  -- 打中的结果（站在开炮的人这边说）：击毁白、击穿琥珀、跳弹 / 没击穿灰（统一外观：红只留给「敌人、危险」）
  local PEN, RIC, KILL = TH.C.WARN, TH.C.MUTE, TH.C.TEXT

  local gui = Instance.new("ScreenGui")
  gui.Name = "WtHud"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 6
  gui.Parent = me:WaitForChild("PlayerGui")

  local function label(parent, text, size, pos, ts, color, font, anchor, align)
    local l = Instance.new("TextLabel")
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.BackgroundTransparency = 1
    l.Text, l.TextSize, l.TextColor3, l.Font = text or "", ts or 14, color or Color3.new(1, 1, 1), font or BOLD
    l.TextXAlignment = align or Enum.TextXAlignment.Center
    l.TextStrokeTransparency, l.TextStrokeColor3 = 0.35, RGB(0, 0, 0)
    l.Parent = parent
    return l
  end
  local function frame(parent, size, pos, color, tr, anchor)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.AnchorPoint = size, pos or UD2(), anchor or V2()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = color or RGB(0, 0, 0), tr or 0, 0
    f.Parent = parent
    return f
  end

  local function partName(p)
    if p.kind == "crew" then return T("wt.r." .. (p.seat or p.k)) end
    return T("wt.m." .. p.k)
  end
  -- 这一下伤了谁：「炮长阵亡 · 发动机损毁 · 起火」
  local function details(m)
    local bits = {}
    for _, p in ipairs(m.parts or {}) do
      if p.kind == "crew" then
        table.insert(bits, partName(p) .. T((p.s == 0) and "wt.dead" or "wt.hurt"))
      elseif p.s == 0 then
        table.insert(bits, partName(p) .. T("wt.broken"))
      elseif p.s == 1 then
        table.insert(bits, partName(p) .. T("wt.damaged"))
      end
    end
    if m.blow then table.insert(bits, T("wt.blowout")) end
    if m.fire then table.insert(bits, T("wt.onFire")) end
    return table.concat(bits, " · ")
  end

  ---------------------------------------------------------------- 命中提示（打出去的）

  local hitBox = frame(gui, UDim2.fromOffset(640, 52), UD2(0.5, 0, 0.5, 70), RGB(0, 0, 0), 1, V2(0.5, 0))
  hitBox.Name = "WtHitText"
  local hitTop = label(hitBox, "", UD2(1, 0, 0, 24), UD2(0, 0, 0, 0), 20, PEN, TH.F.bold)
  hitTop.Name = "Result"
  local hitSub = label(hitBox, "", UD2(1, 0, 0, 18), UD2(0, 0, 0, 26), 14, TH.C.TEXT)
  hitSub.Name = "Detail"
  hitBox.Visible = false
  local hitUntil = 0
  -- 出现、换内容、消失（11-27 审查）：原来每来一条都从 1.15 倍瞬间跳回去再缩——机炮一秒 3～30 条，缩放永远走不完，正中那行字一直在闪
  --   （docs/style.md「正中：命中提示（一闪就走）」）。现在只在三种时候轻轻弹一下（1.07 倍，0.12 秒）：原来没显示、结果升级了
  --   （击穿 → 击毁 / 致命）、离上次弹超过 0.4 秒；连着来的只换字。到点不再一下子没了：字 0.18 秒淡掉再藏（又来一条就接着显示）
  local HIT_FADE = 0.18
  local hitRank, hitPopAt = 0, -9
  local function hitShown(rank)
    local now = os.clock()
    local was = hitBox.Visible and now <= hitUntil   -- 正在淡出的当成没显示：重新弹出来
    if hitTop.TextTransparency ~= 0 then
      hitTop.TextTransparency, hitTop.TextStrokeTransparency = 0, 0.35
      hitSub.TextTransparency, hitSub.TextStrokeTransparency = 0, 0.35
    end
    hitBox.Visible = true
    if not was or rank > hitRank or now - hitPopAt > 0.4 then
      hitPopAt = now
      if G.uiPop then G.uiPop(hitBox, 1.07) end
    end
    hitRank = was and math.max(hitRank, rank) or rank   -- 显示期间只记最高一级（机炮打车击穿、跳弹混着来，跳弹 → 击穿不算升级）
  end
  local function showHit(m)
    local top, col
    if m.kill then
      top, col = T((m.why == "ammo") and "wt.killAmmo" or ((m.why == "fire") and "wt.killFire" or "wt.kill")), KILL
    elseif m.r == "pen" then top, col = T("wt.pen"), PEN
    elseif m.r == "ric" then top, col = T("wt.ric"), RIC
    elseif m.r == "np" then top, col = T("wt.np"), GREY
    else top, col = T("wt.hit"), PEN end
    hitTop.Text, hitTop.TextColor3 = top, col
    if m.kill then G.wtKillShownAt = os.clock() end   -- Hud.lua 的 G.pop 看到就不再弹第二条「击毁 XX」（屏幕中间只留一处）
    local sub = details(m)
    if (m.r == "np" or m.r == "ric") and m.pen and m.arm then sub = T("wt.mm", m.arm, m.pen) .. ((sub ~= "") and ("   " .. sub) or "") end
    hitSub.Text = sub
    hitShown(m.kill and 3 or ((m.r == "pen") and 2 or 1))
    hitUntil = os.clock() + (m.kill and 3.6 or 2.6)
  end

  -- 飞机（WtAir.lua）：打中了哪块、断翼 / 起火 / 漏油 / 飞行员昏迷
  local function airBits(m)
    local bits, seen = {}, {}
    for _, ev in ipairs(m.ev or {}) do
      if not seen[ev] then seen[ev] = true table.insert(bits, T("wta.e." .. ev)) end
    end
    if #bits == 0 then
      for _, k in ipairs(m.parts or {}) do
        if not seen[k] then seen[k] = true table.insert(bits, T("wta.p." .. k)) end
      end
    end
    return table.concat(bits, " · ")
  end
  local function showAirHit(m)
    local big = false
    for _, ev in ipairs(m.ev or {}) do if ev ~= "leak" then big = true end end
    hitTop.Text = T(big and "wta.crit" or "wt.hit")
    hitTop.TextColor3 = big and KILL or PEN
    hitSub.Text = airBits(m)
    hitShown(big and 3 or 1)
    hitUntil = os.clock() + (big and 3 or 1.6)
  end

  ---------------------------------------------------------------- X 光命中回放

  -- 11-28（用户「跟战雷还是有区别」）：照战雷的命中回放重排——右上角（我们右上是小地图：在它下面）、没有边框和标题栏；
  --   上面正中一个结果字（命中 / 击穿 / 已击毁），窗口下面右对齐「车组 存活 / 总数」、红字一行行写打坏了什么，左边一排模块小牌
  local XW, XH = mobile and 270 or 400, mobile and 152 or 225
  local xr = frame(gui, UDim2.fromOffset(XW, XH + 132), mobile and UD2(1, -12, 0, 120) or UD2(1, -20, 0, 18), RGB(0, 0, 0), 1, V2(1, 0))
  xr.Name = "WtXray"
  xr.Visible = false
  local vp = Instance.new("ViewportFrame")
  vp.Name = "View"
  vp.Size, vp.Position = UDim2.fromOffset(XW, XH), UD2(0, 0, 0, 0)
  -- 战雷的命中回放：整个是浅灰蓝的素模（车壳、部件一个色调），只有打坏的东西上色；底色近黑、一盏偏上的主光，面有明暗
  vp.BackgroundColor3, vp.BackgroundTransparency = RGB(12, 14, 17), 0.06
  vp.Ambient, vp.LightColor, vp.LightDirection = RGB(146, 152, 162), RGB(212, 216, 224), V3(-0.4, -1, -0.6)
  vp.Parent = xr
  do
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 6)
    c.Parent = vp
  end
  local xTitle = label(xr, "", UD2(1, -20, 0, 22), UD2(0.5, 0, 0, 6), 17, RGB(240, 214, 70), TH.F.bold, V2(0.5, 0))
  xTitle.Name = "XrTitle"
  xTitle.ZIndex = 3
  xTitle.TextStrokeTransparency, xTitle.TextStrokeColor3 = 0.35, RGB(0, 0, 0)
  -- 窗口下面：右边「车组 2 / 4」，下面红字一行一个打坏的东西；左边一排模块小牌（这一发打到的亮起来）
  local xCrew = label(xr, "", UD2(0, 170, 0, 18), UD2(1, -2, 0, XH + 6), 14, RGB(206, 212, 218), BOLD, V2(1, 0), Enum.TextXAlignment.Right)
  xCrew.Name = "XrCrew"
  xCrew.RichText = true
  local xDmg = {}
  for i = 1, 6 do
    local l = label(xr, "", UD2(0, 240, 0, 17), UD2(1, -2, 0, XH + 6 + i * 17), 14, RGB(236, 64, 52), BOLD, V2(1, 0), Enum.TextXAlignment.Right)
    l.Name = "XrDmg" .. i
    l.TextStrokeTransparency = 0.25
    xDmg[i] = l
  end
  local XR_TAGS = { "breech", "engine", "trans", "track", "tdrive", "edrive" }   -- 炮、发动机、传动、履带、方向机、高低机
  local xTags = {}
  for i, k in ipairs(XR_TAGS) do
    local f = frame(xr, UDim2.fromOffset(22, 18), UD2(0, 2 + (i - 1) * 25, 0, XH + 6), RGB(16, 20, 24), 0.35)
    f.Name = "XrTag_" .. k
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 3)
    c.Parent = f
    xTags[k] = label(f, T("wt.ms." .. k), UD2(1, 0, 1, 0), UD2(), 11, RGB(120, 126, 132), BOLD)
  end
  local vcam = Instance.new("Camera")
  vcam.FieldOfView = 46
  vcam.Parent = vp
  vp.CurrentCamera = vcam
  local world = Instance.new("WorldModel")
  world.Parent = vp
  local xrUntil, xrSpin, xrC, xrDist, xrDir = 0, 0, V3(), 12, V3(0, 0, -1)   -- xrC：静止的回放绕着看的那一点（命中点附近）

  local function box(size, cf, color, tr, mat)
    local p = Instance.new("Part")
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Size = V3(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
    p.CFrame = cf
    p.Color, p.Transparency = color, tr or 0
    p.Material = mat or Enum.Material.SmoothPlastic
    p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
    p.Parent = world
    return p
  end
  local function line(a, b, color, th)
    local d = b - a
    if d.Magnitude < 0.05 then return end
    box(V3(th or 0.12, th or 0.12, d.Magnitude), CFrame.lookAt((a + b) / 2, b), color, 0, Enum.Material.Neon)
  end
  local function entModel(id)
    local f = workspace:FindFirstChild("Ents")
    if not f then return nil end
    for _, em in ipairs(f:GetChildren()) do if em:GetAttribute("EntId") == id then return em end end
    return nil
  end
  -- 状态：先看实体属性（服务器刚写的），这一发报来的（m.parts：打到的乘员 / 模块打完以后的状态）盖在上面——
  --   11-28：原来只看属性，开炮的人这边那辆车没流下来（远、刚出生）时全按没事画，打死的驾驶员还是绿的
  local function states(em, d, m)
    local lay = W.layout(d)
    local cs, ms = {}, {}
    local wc = em and em:GetAttribute("WtC")
    local wm = em and em:GetAttribute("WtM")
    local i = 0
    for tok in string.gmatch(wc or "", "[^,]+") do i += 1 cs[i] = tonumber(string.sub(tok, 1, 1)) or 2 end
    for j = 1, #(wm or "") do ms[j] = tonumber(string.sub(wm, j, j)) or 2 end
    local out = {}
    local ci, mi = 0, 0
    for _, it in ipairs(lay.list) do
      if it.kind == "crew" then ci += 1 out[it] = cs[ci] or 2 else mi += 1 out[it] = ms[mi] or 2 end
    end
    if m and m.parts then
      local byK = {}
      for _, it in ipairs(lay.list) do byK[it.k] = it end
      for _, pt in ipairs(m.parts) do
        local it = pt.k and byK[pt.k]
        if it and type(pt.s) == "number" then out[it] = math.min(out[it] or 2, pt.s) end
      end
    end
    return out
  end
  ---------------------------------------------------------------- X 光：射流的慢放动画
  --   用户 11-24 夜「射流弹击中别的坦克的 x 光动画要有特殊效果」：破甲 / 金属射流弹打穿时 X 光窗口里慢放——
  --   ① 弹飞进来（镜头从来弹方向斜上方推近到命中点）② 打上装甲：一团白闪、贴着装甲面一圈冲击波、窗口底色轻轻亮一下、镜头一震，弹坑烧红再冷下去
  --   ③ 白热的射流一点点钻进车里（越往里越慢），射流头一颗亮球、光套跳动，经过的地方甩出熔化的金属珠（白 → 橙 → 暗红），
  --      后面一截慢的杵体（真的聚能装药：射流头每秒七八公里，杵体只有几百米）④ 破片一根根往外长，打到的乘员 / 模块闪红再定色
  --   ⑤ 弹药殉爆一团火球 / 起火一簇火 ⑥ 镜头一直贴着命中点（11-28 照战雷，不再拉回去看整辆车），打完稍退一点；
  --   左下小字：车名 · 距离、弹种 · 穿深 / 等效毫米；击毁时上面的结果字换成「已击毁——弹药殉爆」
  local xInfo = label(xr, "", UD2(0, XW - 16, 0, 30), UD2(0, 8, 0, XH - 34), 11, RGB(196, 204, 212), BOLD, nil, Enum.TextXAlignment.Left)
  xInfo.Name = "XrInfo"
  xInfo.ZIndex = 3
  xInfo.TextWrapped, xInfo.TextYAlignment = true, Enum.TextYAlignment.Bottom   -- 长的字幕（弹种说明 + 穿深）折成两行，不再出框
  xInfo.TextStrokeTransparency, xInfo.TextStrokeColor3 = 0.3, RGB(6, 8, 10)
  local xName = ""   -- 车名 · 距离（字幕第一行）
  local VP_BG, INFO = RGB(12, 14, 17), RGB(196, 204, 212)
  local function setInfo(txt) xInfo.Text = (txt and txt ~= "") and (xName .. "\n" .. txt) or xName end
  -- 窗口下面（战雷的回放）：右边「车组 存活 / 总数」，下面一行一个这一发打坏的东西（打坏 / 阵亡红、受损 / 重伤黄、起火 / 殉爆橙）——
  --   慢放的时候跟着射流 / 破片到的那一刻一行行冒出来；左边的模块小牌：冒出来的那一行是哪块，那块亮起来（坏了红、伤了黄）
  local TAG_OF = { breech = "breech", engine = "engine", trans = "trans", trackL = "track", trackR = "track", tdrive = "tdrive", edrive = "edrive" }
  local TAG_IDLE, DMG_RED, DMG_YEL, DMG_FIRE = RGB(120, 126, 132), RGB(236, 64, 52), RGB(255, 206, 60), RGB(255, 140, 40)
  local KILLC_T = RGB(255, 92, 64)   -- 击毁（同下面 KILLC）
  local TITLE_Y, TITLE_GREY = RGB(240, 214, 70), RGB(196, 202, 208)
  local xrLines, xrSeen = {}, {}   -- 这一回放（连发叠画时这几发一起）的损伤行：{ text, col, at, rank, tag, s }
  local function hex(c) return string.format("#%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
  local function dmgReset()
    table.clear(xrLines)
    table.clear(xrSeen)
    for _, l in ipairs(xDmg) do l.Visible = false end
    for _, l in pairs(xTags) do l.TextColor3 = TAG_IDLE l.Parent.BackgroundTransparency = 0.35 end
    xCrew.Text = ""
  end
  local function dmgAdd(key, text, col, at, rank, tag, sv)
    local L = xrSeen[key]
    if L then   -- 同一件后来更坏了（受损 → 打坏）：改那一行
      if rank > L.rank then L.text, L.col, L.rank, L.s = text, col, rank, sv end
      L.at = math.min(L.at, at)
      return
    end
    L = { text = text, col = col, at = at, rank = rank, tag = tag, s = sv }
    xrSeen[key] = L
    table.insert(xrLines, L)
  end
  local function dmgFill(m, atOf)   -- atOf(p)：这一件慢放里第几秒到（nil：马上写）；p = nil 是起火 / 殉爆
    for _, p in ipairs(m.parts or {}) do
      local sv = type(p.s) == "number" and p.s or 1
      local at = atOf and atOf(p) or 0
      if p.kind == "crew" then
        if sv < 2 then dmgAdd("c:" .. tostring(p.seat or p.k), partName(p) .. T((sv == 0) and "wt.dead" or "wt.hurt"), (sv == 0) and DMG_RED or DMG_YEL, at, 2 - sv) end
      elseif sv < 2 then
        dmgAdd("m:" .. tostring(p.k), partName(p) .. T((sv == 0) and "wt.broken" or "wt.damaged"), (sv == 0) and DMG_RED or DMG_YEL, at, 2 - sv, TAG_OF[p.k], sv)
      end
    end
    if m.blow then dmgAdd("blow", T("wt.blowout"), DMG_FIRE, atOf and atOf(nil) or 0, 1) end
    if m.fire then dmgAdd("fire", T("wt.onFire"), DMG_FIRE, atOf and atOf(nil) or 0, 1) end
  end
  local function dmgStep(t)
    local n, worst = 0, {}
    for _, L in ipairs(xrLines) do
      if t >= L.at then
        if n < #xDmg then
          n += 1
          xDmg[n].Text, xDmg[n].TextColor3, xDmg[n].Visible = L.text, L.col, true
        end
        if L.tag then worst[L.tag] = math.min(worst[L.tag] or 2, L.s or 1) end
      end
    end
    for i = n + 1, #xDmg do xDmg[i].Visible = false end
    for k, l in pairs(xTags) do
      local sv = worst[k]
      l.TextColor3 = (sv == 0) and DMG_RED or ((sv == 1) and DMG_YEL or TAG_IDLE)
      l.Parent.BackgroundTransparency = sv and 0.1 or 0.35
    end
  end
  local function crewLine(st, lay)   -- 「车组 2 / 4」：活着的（受伤也算）/ 总数，活着的数字黄（全灭红）
    local alive, total = 0, 0
    for _, it in ipairs(lay.list) do
      if it.kind == "crew" then
        total += 1
        if (st[it] or 2) > 0 then alive += 1 end
      end
    end
    if total == 0 then xCrew.Text = "" return end
    local c = (alive == 0) and DMG_RED or TITLE_Y
    xCrew.Text = T("wtt.crew", '<font color="' .. hex(c) .. '">' .. alive .. "</font>", total)
  end
  local function resultWord(m, anim)   -- 上面正中的结果字：命中 / 击穿黄，跳弹 / 未击穿灰，击毁红（慢放的击毁到炸的那一刻才换）
    if m.kill and not anim then return T((m.why == "ammo") and "wt.killAmmo" or ((m.why == "fire") and "wt.killFire" or "wt.kill")), KILLC_T, 3 end
    if m.r == "pen" or m.kill then return T("wt.pen"), TITLE_Y, 2 end
    if m.r == "ric" then return T("wt.ric"), TITLE_GREY, 0 end
    if m.r == "np" then return T("wt.np"), TITLE_GREY, 0 end
    return T("wt.hit"), TITLE_Y, 1
  end
  -- 颜色（用户 11-28「跟战雷还是有区别」：照战雷的命中回放）：没事的部件和乘员都是浅灰蓝 / 灰白的素模（不再按类别上色）；
  --   受损橙、打坏近黑（外面一圈橙色的框）、乘员受伤橙黄、阵亡红；破片打中的地方一个个红点，破片本身灰白
  --   用户 11-28「给弹药 发动机都搞一下特殊颜色的标识吧」「这个颜色你可以做的和战雷有些区别」：没事的弹药洋红、发动机电光蓝
  --   （我们自己的标识色，不是战雷的橙 / 绿；按 X 的透视用同一套，XrayOwn.MARK）；受损黄
  local CLAY, CLAY_CREW = RGB(170, 182, 194), RGB(206, 212, 218)
  local MARK = (XO and XO.MARK) or { ammo = RGB(236, 62, 196), engine = RGB(46, 156, 255) }
  local DMGC, DEADM, CREW_KO, CREW_HURT = RGB(255, 214, 48), RGB(24, 24, 28), RGB(222, 40, 32), RGB(255, 214, 48)
  local EDGE, FRAG, SPALL = RGB(255, 132, 28), RGB(236, 36, 28), RGB(232, 234, 238)
  local BLACKC = Color3.new(0, 0, 0)
  local function xrCol(kind, cat, s, hit)   -- 一件的颜色：坏了按状态，没事的素模（弹药、发动机有标识色）
    if kind == "crew" then return (s == 0) and CREW_KO or ((s == 1) and CREW_HURT or CLAY_CREW) end
    if s == 0 then return DEADM elseif s == 1 then return DMGC end
    return MARK[cat] or CLAY
  end
  local function catOfK(k)   -- 拿不到透视形状时按模块名分类（弹药、发动机要标识色）
    k = tostring(k or "")
    if string.sub(k, 1, 4) == "ammo" then return "ammo" end
    if k == "engine" then return "engine" end
    return "other"
  end
  local function xrTr(kind, s, hit)   -- 乘员、打到的、坏了的实心；没打到的没事部件稍微透一点（后面打坏的透得出来）
    if kind == "crew" or s < 2 or hit then return 0 end
    return 0.12
  end
  local function xrSub(col, g, s, cat)   -- 一件里的子件：深色件（排气、缸盖、炮管的箍）、弹头、玻璃——素模里只是深一点
    if g == "dk" or g == "tip" then return col:Lerp(BLACKC, (s == 2) and 0.24 or 0.3) end
    if g == "gl" then return (s == 2) and RGB(150, 176, 190) or col end
    return col
  end
  -- 打坏的模块外面一圈橙色的框（战雷的描边；ViewportFrame 里画不了 Highlight，用十二根细边围一个跟着模块那个框架的盒子）
  local function edgePart(a, b, col, th)
    local dd = b - a
    local p = Instance.new("Part")
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Size = V3(th, th, math.max(dd.Magnitude, 0.05))
    p.CFrame = CFrame.lookAt((a + b) / 2, b)
    p.Color, p.Material = col, Enum.Material.Neon
    p.Parent = world
    return p
  end
  local function edgeBox(F, parts, hidden)
    local mn, mx = nil, nil
    for _, q in ipairs(parts) do
      local cf, sz = q.p.CFrame, q.size or q.p.Size
      for i = 0, 7 do
        local w = cf * V3(((i % 2 == 0) and -1 or 1) * sz.X / 2, ((math.floor(i / 2) % 2 == 0) and -1 or 1) * sz.Y / 2, ((i < 4) and -1 or 1) * sz.Z / 2)
        local l = F:PointToObjectSpace(w)
        mn = mn and V3(math.min(mn.X, l.X), math.min(mn.Y, l.Y), math.min(mn.Z, l.Z)) or l
        mx = mx and V3(math.max(mx.X, l.X), math.max(mx.Y, l.Y), math.max(mx.Z, l.Z)) or l
      end
    end
    if not mn then return {} end
    mn, mx = mn - V3(0.08, 0.08, 0.08), mx + V3(0.08, 0.08, 0.08)
    local cs = {}
    for i = 0, 7 do cs[i] = F * V3((i % 2 == 0) and mn.X or mx.X, (math.floor(i / 2) % 2 == 0) and mn.Y or mx.Y, (i < 4) and mn.Z or mx.Z) end
    local out = {}
    for _, e in ipairs({ { 0, 1 }, { 2, 3 }, { 4, 5 }, { 6, 7 }, { 0, 2 }, { 1, 3 }, { 4, 6 }, { 5, 7 }, { 0, 4 }, { 1, 5 }, { 2, 6 }, { 3, 7 } }) do
      local p = edgePart(cs[e[1]], cs[e[2]], EDGE, 0.07)
      p.Transparency = hidden and 1 or 0.05
      out[#out + 1] = p
    end
    return out
  end
  local TI, JD = 0.7, 0.95   -- 弹飞进来 0.7 秒；射流钻进去 0.95 秒（都是慢放的）
  local xa = nil
  local function ease(q) q = math.clamp(q, 0, 1) return 1 - (1 - q) ^ 2.4 end
  local function lerp(a, b, q) return a + (b - a) * q end
  local function rng(seed)   -- 确定的伪随机（同一发每次放出来一样）
    local s = math.floor(seed or 1) % 2147483647
    if s <= 0 then s = 1 end
    return function() s = (s * 16807) % 2147483647 return s / 2147483647 end
  end
  local function nb(size, cf, col, shape)   -- 一个发光件，先藏着
    local p = box(size, cf, col, 1, Enum.Material.Neon)
    if shape then p.Shape = shape end
    return p
  end
  local function seg(p, a, b, th)   -- 把一根件摆成 a → b
    local L = (b - a).Magnitude
    if L < 0.03 then p.Transparency = 1 return false end
    p.Size = V3(th, th, L)
    p.CFrame = CFrame.lookAt((a + b) / 2, b)
    return true
  end
  local function heat(q, c0, c1, c2, k)   -- 白热 → 橙 → 暗红（k 那一点到橙）
    if q < k then return c0:Lerp(c1, q / k) end
    return c1:Lerp(c2, math.clamp((q - k) / (1 - k), 0, 1))
  end
  local WHITE, ORANGE, EMBER = RGB(255, 246, 225), RGB(255, 150, 55), RGB(140, 32, 22)
  local KILLC = KILLC_T   -- 标题：已击毁（命中 / 击穿是黄）
  -- 战雷的回放：破片打中东西的地方一个红点（到的那一刻冒出来）；命中点一团红光（弹在那里撞开装甲、破片从那里喷）
  local function addDot(A, pos, t)
    A.dots = A.dots or {}
    table.insert(A.dots, { p = nb(V3(0.36, 0.36, 0.36), CF(pos), FRAG, Enum.PartType.Ball), t = t })
  end
  local function dotsStep(A, t)
    for _, D in ipairs(A.dots or {}) do
      local q = (t - D.t) / 0.25
      if q >= 0 then
        D.p.Transparency = 0
        D.p.Size = V3(1, 1, 1) * ((q < 1) and lerp(0.62, 0.36, q) or 0.36)
      end
    end
  end
  local function redGlow(A, pos, big)
    A.rg = nb(V3(1, 1, 1), CF(pos), RGB(255, 46, 36), Enum.PartType.Ball)
    A.rgR = big and 2.6 or 1.9
  end
  local function redGlowStep(A, ti)
    if not A.rg then return end
    ti -= A.rgT or 0
    if ti < 0 then A.rg.Transparency = 1 return end
    A.rg.Size = V3(1, 1, 1) * lerp(0.5, A.rgR, ease(ti / 0.25))
    A.rg.Transparency = (ti < 1.2) and 0.32 or lerp(0.32, 0.72, math.clamp((ti - 1.2) / 1.8, 0, 1))
  end

  local function xaBuild(m, x, d, yaw, p0, dv, hitP)
    local big = x.big == true
    local M = W.M
    local core = math.max((x.core or 0) * M, 1.2)
    local R = rng(x.seed)
    local A = { t0 = os.clock(), p0 = p0, dv = dv, core = core, big = big, hitP = hitP }
    A.shell = nb(V3(0.24, 0.24, 1.2), CF(p0 - dv * 12), RGB(255, 205, 130))
    A.trail = nb(V3(0.08, 0.08, 0.1), CF(p0 - dv * 12), RGB(255, 120, 40))
    -- 装甲面的法线（冲击波贴着它扩开）：炮塔上的按炮塔转角换回底座系
    local zone, _, _, n = W.where(d, p0, dv, yaw)
    if zone == "tur" and n then n = W.fromTur(d, n, yaw) - W.fromTur(d, V3(), yaw) end
    if not n or n.Magnitude < 0.5 then n = -dv end
    n = n.Unit
    A.flash = nb(V3(1, 1, 1), CF(p0), RGB(255, 255, 255), Enum.PartType.Ball)
    A.ring = nb(V3(0.05, 1, 1), CFrame.lookAt(p0 + n * 0.06, p0 + n * 1.06) * CFrame.Angles(0, math.pi / 2, 0), RGB(200, 230, 255), Enum.PartType.Cylinder)
    A.crater = nb(V3(0.9, 0.9, 0.9), CF(p0), ORANGE, Enum.PartType.Ball)
    -- 射流：白热的芯、青白的光套、外面一层淡光，射流头一颗亮球，后面一截慢的杵体
    local w = big and 0.2 or 0.15
    A.w = w
    A.jet = nb(V3(w, w, 0.1), CF(p0), RGB(245, 252, 255))
    A.glow = nb(V3(w, w, 0.1), CF(p0), RGB(130, 205, 255))
    A.halo = nb(V3(w, w, 0.1), CF(p0), RGB(90, 160, 255))
    A.tip = nb(V3(1, 1, 1), CF(p0), RGB(255, 255, 255), Enum.PartType.Ball)
    A.slug = nb(V3(w * 2.4, w * 2.4, w * 5.5), CF(p0), RGB(255, 200, 120))
    -- 熔化的金属珠：射流头经过那一刻甩出来（射流头的位置 = core · ease(τ / JD)，反过来求经过的时刻）
    A.beads = {}
    local r1 = dv:Cross(math.abs(dv.Y) < 0.9 and V3(0, 1, 0) or V3(1, 0, 0)).Unit
    local r2 = dv:Cross(r1).Unit
    local NB = big and 26 or 16
    for i = 1, NB do
      local u = (i - 0.5) / NB * 0.94
      local a = R() * math.pi * 2
      local v = (r1 * math.cos(a) + r2 * math.sin(a)) * (0.5 + R() * 1.7) + dv * (R() * 0.9 - 0.25)
      table.insert(A.beads, { p = nb(V3(0.3, 0.3, 0.3), CF(p0), WHITE, Enum.PartType.Ball), u = u, v = v, s = 0.16 + R() * 0.24,
        t = TI + JD * (1 - (1 - u) ^ (1 / 2.4)) })
    end
    -- 打到的乘员 / 模块什么时候「到」：射流经过、破片打到，都没有就在射流快钻完时
    local function mark(it, tt)
      for _, H in ipairs(hitP) do if H.it == it and (not H.at or tt < H.at) then H.at = tt end end
    end
    for _, h in ipairs(W.trace(d, yaw, p0 + dv * 0.1, dv, core, true)) do
      local th = TI + JD * (1 - (1 - math.clamp(h.t / core, 0, 1)) ^ (1 / 2.4))
      mark(h.it, th)
      addDot(A, p0 + dv * (0.1 + h.t), th)
    end
    redGlow(A, p0 + dv * 0.35, big)
    A.spall = {}
    local cone = W.cone(dv, x.half or 18, x.n or 0, x.seed)
    for i, rv in ipairs(cone) do
      local len = (1.4 + (i % 4) * 0.35) * M
      local hits = W.trace(d, yaw, p0 + dv * 0.1, rv, len, true)
      local l2 = hits[1] and math.max(0.3, hits[1].t + 0.4) or len
      local t1 = TI + 0.14 + (i - 1) * (0.55 / math.max(#cone, 1)) + R() * 0.05
      local dur = 0.26 + l2 / M * 0.07
      table.insert(A.spall, { p = nb(V3(0.06, 0.06, 0.1), CF(p0), SPALL), tip = nb(V3(0.26, 0.26, 0.26), CF(p0), RGB(255, 255, 255), Enum.PartType.Ball),
        rv = rv, len = l2, t = t1, d = dur })
      if hits[1] then
        mark(hits[1].it, t1 + dur * 0.45)
        addDot(A, p0 + dv * 0.1 + rv * hits[1].t, t1 + dur * 0.45)
      end
    end
    for _, H in ipairs(hitP) do
      if not H.at then H.at = W.inside(d, yaw, p0, H.it, 0.6) and TI or (TI + JD * 0.8) end   -- 车外的零件（履带、炮管）：打上那一下
    end
    -- 击毁：弹药殉爆（打到的那个弹药架）、起火（打到的油箱 / 发动机）
    local lay = W.layout(d)
    local hk = {}
    for _, H in ipairs(hitP) do hk[H.it.k] = H.it end
    local function find(keys)
      for _, k in ipairs(keys) do if hk[k] then return hk[k] end end
      for _, k in ipairs(keys) do for _, it in ipairs(lay.list) do if it.k == k then return it end end end
      return nil
    end
    if m.kill and m.why == "ammo" then
      local it = find({ "ammo", "ammoH" })
      if it then
        A.boom = nb(V3(1, 1, 1), CF(W.center(d, yaw, it)), WHITE, Enum.PartType.Ball)
        A.boomR = math.max(d.W or 6, 6) * 1.1
        A.boomT = TI + JD + 0.3
      end
    end
    if m.fire or (m.kill and m.why == "fire") then
      local it = find({ "fuelL", "fuelR", "engine", "ammoH" })
      if it then
        local c = W.center(d, yaw, it)
        A.fire, A.fireT = {}, TI + JD + (A.boom and 0.9 or 0.35)
        for i = 1, 4 do
          table.insert(A.fire, { p = nb(V3(1, 1, 1), CF(c), (i % 2 == 0) and RGB(255, 190, 70) or RGB(255, 110, 40), Enum.PartType.Ball),
            c = c + V3((R() - 0.5) * 1.6, (i - 1) * 0.45, (R() - 0.5) * 1.6), s = 1.1 + R() * 0.8 })
        end
      end
    end
    if x.tan then   -- 串联破甲：主装药前面一小段，前级先炸一下（引爆爆反、开路）
      A.pre = nb(V3(1, 1, 1), CF(p0 - dv * 0.9), RGB(255, 236, 200), Enum.PartType.Ball)
      A.preR = nb(V3(0.05, 1, 1), CFrame.lookAt(p0 - dv * 0.9, p0 - dv * 1.9) * CFrame.Angles(0, math.pi / 2, 0), RGB(255, 210, 150), Enum.PartType.Cylinder)
    end
    A.info = T(big and "wt.xrJetB" or (x.tan and "wt.xr.tandem" or "wt.xrJet"), m.pen or "?", m.arm or "?")
    A.info2 = m.kill and T((m.why == "ammo") and "wt.killAmmo" or ((m.why == "fire") and "wt.killFire" or "wt.kill")) or nil
    return A
  end

  local function xaStep(t, dt)
    local A = xa
    local p0, dv, core, w = A.p0, A.dv, A.core, A.w
    local ti = t - TI
    -- 串联：前级在主装药打上前 0.14 秒先炸一小团
    if A.pre then
      local pq = (t - (TI - 0.14)) / 0.32
      if pq >= 0 and pq < 1 then
        A.pre.Size, A.pre.Transparency = V3(1, 1, 1) * lerp(0.4, 2.6, ease(pq)), pq
        A.preR.Size, A.preR.Transparency = V3(0.05, lerp(0.4, 3.4, ease(pq)), lerp(0.4, 3.4, ease(pq))), lerp(0.25, 1, pq)
      else A.pre.Transparency, A.preR.Transparency = 1, 1 end
    end
    -- ① 弹飞进来，尾巴拖一道曳光
    if ti < 0 then
      local sp = p0 - dv * (12 * (1 - t / TI))
      A.shell.CFrame = CFrame.lookAt(sp, sp + dv)
      A.shell.Transparency = 0
      if seg(A.trail, p0 - dv * 12, sp - dv * 0.6, 0.08) then A.trail.Transparency = 0.2 end
    else
      A.shell.Transparency = 1
      if seg(A.trail, p0 - dv * 12, p0, 0.08) then A.trail.Transparency = math.clamp(0.2 + ti * 0.4, 0.2, 0.7) end
    end
    if ti >= 0 then
      -- ② 命中：白闪、冲击波、弹坑；窗口底色轻轻亮一下
      local fq = ti / 0.35
      A.flash.Transparency = (fq < 1) and fq or 1
      A.flash.Size = V3(1, 1, 1) * lerp(0.6, A.big and 4.4 or 3.4, ease(fq))
      local rq = ti / 0.6
      local r = lerp(0.4, A.big and 7.5 or 5.5, ease(rq))
      A.ring.Size = V3(0.05, r, r)
      A.ring.Transparency = (rq < 1) and lerp(0.15, 1, rq) or 1
      local cq = math.clamp(ti / 2.4, 0, 1)
      A.crater.Color = heat(cq, WHITE, ORANGE, EMBER, 0.2)
      A.crater.Transparency = lerp(0, 0.3, cq)
      vp.BackgroundColor3 = RGB(58, 64, 72):Lerp(VP_BG, math.clamp(ti / 0.3, 0, 1))
      -- ③ 射流
      local jq = ti / JD
      local a = p0 + dv * 0.05
      local pulse = 1 + 0.22 * math.sin(t * 47) + 0.12 * math.sin(t * 83)
      if jq < 1 then
        local b = p0 + dv * math.max(core * ease(jq), 0.08)
        if seg(A.jet, a, b, w) then A.jet.Transparency = 0 end
        if seg(A.glow, a, b, w * 3.2 * pulse) then A.glow.Transparency = 0.45 end
        if seg(A.halo, a, b, w * 7 * pulse) then A.halo.Transparency = 0.82 end
        A.tip.CFrame, A.tip.Size, A.tip.Transparency = CF(b), V3(1, 1, 1) * w * 4.6 * pulse, 0
      else   -- 射流用完了：芯子冷成一道烧红的孔道，光套、射流头淡掉
        local b = p0 + dv * core
        local cq2 = math.clamp((ti - JD) / 1.6, 0, 1)
        if seg(A.jet, a, b, w * lerp(1, 0.7, cq2)) then
          A.jet.Color = RGB(245, 252, 255):Lerp(RGB(255, 110, 50), cq2)
          A.jet.Transparency = lerp(0, 0.25, cq2)
        end
        if seg(A.glow, a, b, w * 3.2) then A.glow.Transparency = lerp(0.45, 1, cq2) end
        A.halo.Transparency = 1
        A.tip.Transparency = math.clamp((ti - JD) / 0.25, 0, 1)
      end
      -- 杵体：跟在后面慢慢走，只走到射流长度的三成多
      if ti > 0.1 then
        local sq = math.clamp((ti - 0.1) / (JD * 1.7), 0, 1)
        local sp = p0 + dv * (core * 0.36 * ease(sq))
        A.slug.CFrame = CFrame.lookAt(sp, sp + dv)
        A.slug.Color = heat(sq, RGB(255, 215, 140), ORANGE, EMBER, 0.35)
        A.slug.Transparency = lerp(0.05, 0.35, sq)
      end
      -- 熔化的金属珠：往外甩、慢慢往下掉、冷下去
      for _, B in ipairs(A.beads) do
        local bt = t - B.t
        if bt >= 0 then
          local q = bt / 1.5
          if q < 1 then
            B.p.CFrame = CF(p0 + dv * (core * B.u) + B.v * ease(q) + V3(0, -0.7 * q * q, 0))
            B.p.Size = V3(1, 1, 1) * lerp(B.s, B.s * 0.45, q)
            B.p.Color = heat(q, WHITE, ORANGE, EMBER, 0.3)
            B.p.Transparency = lerp(0, 0.65, q)
          else B.p.Transparency = 1 end
        end
      end
    end
    -- ④ 破片一根根往外长（头上一颗亮点），长完从黄冷成橙
    for _, Sx in ipairs(A.spall) do
      local st = t - Sx.t
      if st >= 0 then
        local q = st / Sx.d
        local cur = Sx.len * ease(q)
        if seg(Sx.p, p0, p0 + Sx.rv * math.max(cur, 0.06), 0.06) then
          if q < 1 then
            Sx.p.Color, Sx.p.Transparency = SPALL, 0
            Sx.tip.CFrame, Sx.tip.Transparency = CF(p0 + Sx.rv * cur), 0
          else
            local fq = math.clamp((st - Sx.d) / 1.2, 0, 1)
            Sx.p.Color, Sx.p.Transparency = SPALL:Lerp(RGB(150, 156, 164), fq), lerp(0, 0.4, fq)
            Sx.tip.Transparency = 1
          end
        end
      end
    end
    -- ⑤ 打到的乘员 / 模块：到的那一刻红白闪、胀一下，再定成最后的颜色（乘员是零件拼的人：H.ps 每个零件一起闪）
    for _, H in ipairs(A.hitP) do
      local ht = t - H.at
      if ht >= 0 then
        if ht < 0.7 then
          local fc = (math.floor(ht * 14) % 2 == 0) and RGB(255, 255, 255) or RGB(255, 40, 30)
          local gk = 1 + 0.3 * (1 - ht / 0.7)
          for _, q in ipairs(H.ps or { H }) do
            q.p.Color, q.p.Transparency, q.p.Size = fc, 0, q.size * gk
          end
        elseif not H.done then
          H.done = true
          for _, q in ipairs(H.ps or { H }) do q.p.Color, q.p.Transparency, q.p.Size = xrSub(H.col, q.g, H.s or 2, H.cat), H.tr, q.size end
          for _, e in ipairs(H.edges or {}) do e.Transparency = 0.05 end   -- 打坏 / 受损的：外面一圈橙框
        end
      end
    end
    -- ⑥ 弹药殉爆、起火
    if A.boom and t >= A.boomT then
      local q = (t - A.boomT) / 1.2
      if q < 1 then
        A.boom.Size = V3(1, 1, 1) * lerp(1, A.boomR, ease(q))
        A.boom.Color = heat(q, WHITE, ORANGE, EMBER, 0.3)
        A.boom.Transparency = lerp(0.05, 1, q ^ 1.5)
        vp.BackgroundColor3 = RGB(110, 66, 40):Lerp(VP_BG, math.clamp(q * 3, 0, 1))
      else A.boom.Transparency = 1 end
    end
    if A.fire and t >= A.fireT then
      for i, F in ipairs(A.fire) do
        local fl = 0.75 + 0.22 * math.sin(t * (9 + i * 3.7) + i) + 0.14 * math.sin(t * 23 + i * 2)
        F.p.Size = V3(1, 1, 1) * F.s * fl
        F.p.CFrame = CF(F.c + V3(0, (fl - 0.6) * 0.9, 0))
        F.p.Transparency = 0.25
      end
    end
    dotsStep(A, t)
    redGlowStep(A, ti)
    dmgStep(t)
    -- 字幕（左下小字：车名 · 距离、弹种和穿深）；击毁的原因换到上面正中的标题
    if ti >= 0 and not A.said then A.said = true setInfo(A.info) xInfo.TextColor3, xInfo.Visible = INFO, true end
    if A.info2 and not A.said2 and t >= (A.boomT or (TI + JD)) + 0.15 then A.said2 = true xTitle.Text, xTitle.TextColor3 = A.info2, KILLC end
    -- 镜头（战雷的回放：一直贴着命中的那一块看，不拉回去看整辆车）：从来弹方向斜后上方推近，跟一点射流，慢慢挪一点；打完稍微退一点看清打坏了什么
    xrSpin += dt * math.rad(5)
    local back = ease((t - (TI + JD + 0.6)) / 2.2)
    local tgt = p0 + dv * math.min(core * 0.35 * ease(ti / JD), 3)
    local dist = lerp(lerp(xrDist * 1.3, xrDist, ease(t / TI)), xrDist * 1.32, back)
    local eye = tgt + CFrame.Angles(0, xrSpin, 0) * xrDir * dist + V3(0, dist * 0.42, 0)
    if ti >= 0 and ti < 0.5 then
      local k = (1 - ti / 0.5) ^ 2 * (A.big and 0.45 or 0.32)
      eye += V3(math.sin(t * 91) * k, math.sin(t * 73 + 1) * k, math.sin(t * 57 + 2) * k)
    end
    vcam.CFrame = CFrame.lookAt(eye, tgt)
  end

  ---------------------------------------------------------------- X 光：动能弹、穿甲爆破、杀爆、碎甲的慢放（用户待办「不同弹种击中的 X 光效果不一样」）
  --   服务器给 x.sub（Wt.lua xrSub），这里一种一个样子（伤害上的区别在 Wt.lua SUBFX）：
  --   fs 长杆尾翼稳定脱壳穿甲弹：细长的杆扎进去，杆头被装甲啃短（入口往回溅一圈火花），里面一道窄而密的破片锥，剩下的杆接着往里钻
  --   ds 脱壳穿甲弹：粗短的钨芯，钻得浅一点、破片锥宽一点
  --   ap 全口径穿甲弹：胖弹头把一块烧红的装甲塞子顶进车里，破片锥最宽、块头最大
  --   aphe 穿甲爆破弹：先像 ap 一样钻进去，走一米多（引信延时）在车里炸开——一团火、破片四面八方、窗口一片橙
  --   ac 机炮 / 机枪的小弹：小闪、细孔、几片
  --   he 杀爆弹：在车外炸开——半个火球、贴着装甲的大冲击波、破片往外飞，烟往上冒；薄皮车才有几片钻进来
  --   hesh 碎甲弹：弹头拍扁成一张饼贴在装甲上、起爆，冲击波一圈圈穿过装甲，内壁烧红、崩成一大锥碎片往里飞（装甲没有洞）
  local KS = {
    fs = { len = 2.6, w = 0.09, col = RGB(255, 238, 180), TI = 0.5, P = 0.42, back = 10, deep = 1, erode = 0.6 },
    ds = { len = 1.5, w = 0.17, col = RGB(235, 235, 245), TI = 0.55, P = 0.48, back = 7, deep = 0.9, erode = 0.35 },
    ap = { len = 1.15, w = 0.38, col = RGB(205, 175, 120), TI = 0.62, P = 0.6, back = 4, deep = 1, plug = true, wide = true },
    aphe = { len = 1.15, w = 0.38, col = RGB(205, 175, 120), TI = 0.62, P = 0.6, back = 4, deep = 1, plug = true, wide = true, burst = 1.2 },
    ac = { len = 0.6, w = 0.07, col = RGB(255, 220, 150), TI = 0.4, P = 0.3, back = 4, deep = 1, small = true },
    he = { len = 1.0, w = 0.42, col = RGB(126, 132, 100), TI = 0.62, P = 0.5, blast = true },
    hesh = { len = 1.0, w = 0.44, col = RGB(160, 158, 118), TI = 0.62, P = 0.6, scab = true },
  }
  -- 方向随机散在一个锥里（半角 deg）
  local function coneDir(R, axis, deg)
    local a = R() * math.pi * 2
    local th = math.rad(deg) * math.sqrt(R())
    local u1 = axis:Cross(math.abs(axis.Y) < 0.9 and V3(0, 1, 0) or V3(1, 0, 0)).Unit
    local u2 = axis:Cross(u1).Unit
    return (axis * math.cos(th) + (u1 * math.cos(a) + u2 * math.sin(a)) * math.sin(th)).Unit
  end
  -- 击毁：弹药殉爆（打到的那个弹药架）、起火（打到的油箱 / 发动机），tB 殉爆的时刻
  local function killFx(A, m, d, yaw, hitP, R, tB)
    local lay = W.layout(d)
    local hk = {}
    for _, H in ipairs(hitP) do hk[H.it.k] = H.it end
    local function find(keys)
      for _, k in ipairs(keys) do if hk[k] then return hk[k] end end
      for _, k in ipairs(keys) do for _, it in ipairs(lay.list) do if it.k == k then return it end end end
      return nil
    end
    if m.kill and m.why == "ammo" then
      local it = find({ "ammo", "ammoH" })
      if it then
        A.boom = nb(V3(1, 1, 1), CF(W.center(d, yaw, it)), WHITE, Enum.PartType.Ball)
        A.boomR = math.max(d.W or 6, 6) * 1.1
        A.boomT = tB
      end
    end
    if m.fire or (m.kill and m.why == "fire") then
      local it = find({ "fuelL", "fuelR", "engine", "ammoH" })
      if it then
        local c = W.center(d, yaw, it)
        A.fire, A.fireT = {}, tB + (A.boom and 0.6 or 0.05)
        for i = 1, 4 do
          table.insert(A.fire, { p = nb(V3(1, 1, 1), CF(c), (i % 2 == 0) and RGB(255, 190, 70) or RGB(255, 110, 40), Enum.PartType.Ball),
            c = c + V3((R() - 0.5) * 1.6, (i - 1) * 0.45, (R() - 0.5) * 1.6), s = 1.1 + R() * 0.8 })
        end
      end
    end
  end
  -- 一根往外长的破片（头上一颗亮点）：o 起点、rv 方向、len 长、t 开始、d 长出来用的时间
  local function frag(list, o, rv, len, t, dur, th, col)
    table.insert(list, { p = nb(V3(th, th, 0.1), CF(o), col or SPALL), tip = nb(V3(th * 3.4, th * 3.4, th * 3.4), CF(o), RGB(255, 255, 255), Enum.PartType.Ball),
      o = o, rv = rv, len = len, t = t, d = dur, th = th, col = col or SPALL })
  end
  local function fragStep(list, t)
    for _, F in ipairs(list) do
      local ft = t - F.t
      if ft >= 0 then
        local q = ft / F.d
        local cur = F.len * ease(q)
        if seg(F.p, F.o, F.o + F.rv * math.max(cur, 0.06), F.th) then
          if q < 1 then
            F.p.Color, F.p.Transparency = F.col, 0
            F.tip.CFrame, F.tip.Transparency = CF(F.o + F.rv * cur), 0
          else   -- 长完：灰白冷成灰、淡一点（战雷的破片线）
            local fq = math.clamp((ft - F.d) / 1.2, 0, 1)
            F.p.Color, F.p.Transparency = F.col:Lerp(RGB(150, 156, 164), fq), lerp(0, 0.4, fq)
            F.tip.Transparency = 1
          end
        end
      end
    end
  end

  local function xkBuild(m, x, d, yaw, p0, dv, hitP, sub)
    local K = KS[sub]
    local M = W.M
    local R = rng(x.seed)
    local A = { t0 = os.clock(), p0 = p0, dv = dv, K = K, sub = sub, hitP = hitP, TI = K.TI, P = K.P, frags = {}, back = {} }
    A.step = nil   -- 下面赋值（xkStep 在后面定义）
    A.core = math.max((x.core or 0) * M, K.small and 0.6 or 1.0)
    local zone, _, _, n = W.where(d, p0, dv, yaw)
    if zone == "tur" and n then n = W.fromTur(d, n, yaw) - W.fromTur(d, V3(), yaw) end
    if not n or n.Magnitude < 0.5 then n = -dv end
    n = n.Unit
    A.n = n
    A.shell = nb(V3(K.w, K.w, K.len), CF(p0 - dv * 12), K.col)
    A.trail = nb(V3(0.06, 0.06, 0.1), CF(p0 - dv * 12), RGB(255, 140, 50))
    A.flash = nb(V3(1, 1, 1), CF(p0), RGB(255, 255, 255), Enum.PartType.Ball)
    A.ring = nb(V3(0.05, 1, 1), CFrame.lookAt(p0 + n * 0.06, p0 + n * 1.06) * CFrame.Angles(0, math.pi / 2, 0), RGB(220, 235, 255), Enum.PartType.Cylinder)
    A.crater = nb(V3(0.7, 0.7, 0.7), CF(p0), ORANGE, Enum.PartType.Ball)
    local function mark(it, tt)
      for _, H in ipairs(hitP) do if H.it == it and (not H.at or tt < H.at) then H.at = tt end end
    end
    -- 往回溅的火花（杆头被装甲啃下来的碎渣）
    for _ = 1, (K.back or 0) do
      table.insert(A.back, { p = nb(V3(0.16, 0.16, 0.16), CF(p0), WHITE, Enum.PartType.Ball), v = coneDir(R, n, 55) * (1.2 + R() * 2.2), t = K.TI + R() * 0.12, s = 0.1 + R() * 0.14 })
    end
    local half = x.half or 18
    local nF = math.max(4, x.n or 10)
    if K.blast then
      -- 杀爆：车外炸开（火球半个露在外面）、烟往上冒，破片往外飞；打穿了（薄皮车）几片钻进来
      A.fbR = math.max((x.bl or 2.2) * M * 0.45, 2.4)
      A.fb = nb(V3(1, 1, 1), CF(p0 + n * 0.4), WHITE, Enum.PartType.Ball)
      A.smoke = nb(V3(1, 1, 1), CF(p0 + n * 1.2), RGB(92, 90, 86), Enum.PartType.Ball)
      for _ = 1, 16 do frag(A.frags, p0 + n * 0.2, coneDir(R, n, 78), (1.6 + R() * 1.8) * M, K.TI + R() * 0.06, 0.32 + R() * 0.2, 0.07, RGB(255, 220, 130)) end
      if m.r == "pen" or m.kill then
        for _ = 1, 6 do
          local rv = coneDir(R, dv, 35)
          local len = (0.8 + R() * 0.8) * M
          local hits = W.trace(d, yaw, p0 + dv * 0.2, rv, len, true)
          local l2 = hits[1] and math.max(0.3, hits[1].t + 0.3) or len
          local t1 = K.TI + 0.06 + R() * 0.08
          frag(A.frags, p0 + dv * 0.2, rv, l2, t1, 0.26, 0.06)
          if hits[1] then
            mark(hits[1].it, t1 + 0.15)
            addDot(A, p0 + dv * 0.2 + rv * hits[1].t, t1 + 0.15)
          end
        end
      end
    elseif K.scab then
      -- 碎甲：拍扁的炸药饼、穿过装甲的冲击波、内壁烧红崩落成一大锥
      A.pan = nb(V3(0.4, 0.4, 0.4), CFrame.lookAt(p0 + n * 0.08, p0 + n * 1.08) * CFrame.Angles(0, math.pi / 2, 0), RGB(232, 214, 150), Enum.PartType.Cylinder)
      A.wave = nb(V3(0.05, 1, 1), CF(p0), RGB(200, 230, 255), Enum.PartType.Cylinder)
      local inner = p0 + dv * 0.3 * M
      A.inner = inner
      A.scab = nb(V3(0.16, 1.3, 1.3), CFrame.lookAt(inner, inner + dv) * CFrame.Angles(0, math.pi / 2, 0), ORANGE, Enum.PartType.Cylinder)
      for _ = 1, math.floor(nF * 1.6 + 0.5) do
        local rv = coneDir(R, dv, half * 2.4)
        local len = (1.0 + R() * 1.3) * M
        local hits = W.trace(d, yaw, inner, rv, len, true)
        local l2 = hits[1] and math.max(0.3, hits[1].t + 0.3) or len
        local t1 = K.TI + 0.42 + R() * 0.1
        local dur = 0.24 + l2 / M * 0.06
        frag(A.frags, inner, rv, l2, t1, dur, 0.09)
        if hits[1] then
          mark(hits[1].it, t1 + dur * 0.5)
          addDot(A, inner + rv * hits[1].t, t1 + dur * 0.5)
        end
      end
    else
      -- 动能弹：孔道、杆头、（全口径）装甲塞子；破片从穿出来的地方喷；穿甲爆破弹走一米多炸开
      A.chan = nb(V3(K.w, K.w, 0.1), CF(p0), RGB(255, 200, 120))
      A.chanGlow = nb(V3(K.w, K.w, 0.1), CF(p0), RGB(255, 140, 60))
      if K.plug then A.plug = nb(V3(0.14, 1.0, 1.0), CF(p0), RGB(255, 160, 80), Enum.PartType.Cylinder) end
      local deep = A.core * (K.deep or 1)
      A.deep = deep
      local function tOf(dist) return K.TI + K.P * (1 - (1 - math.clamp(dist / deep, 0, 1)) ^ (1 / 2.4)) end
      for _, h in ipairs(W.trace(d, yaw, p0 + dv * 0.1, dv, deep, true)) do
        mark(h.it, tOf(h.t))
        addDot(A, p0 + dv * (0.1 + h.t), tOf(h.t))
      end
      local ex = p0 + dv * (K.small and 0.15 or 0.35)
      local nS = K.wide and math.floor(nF * 1.25 + 0.5) or nF
      if sub == "aphe" then nS = math.floor(nF * 0.6 + 0.5) end
      for i = 1, nS do
        local rv = coneDir(R, dv, half * (K.wide and 1.6 or (sub == "fs" and 0.8 or 1.1)))
        local len = (1.2 + R() * 1.3) * M * (K.small and 0.5 or 1)
        local hits = W.trace(d, yaw, ex, rv, len, true)
        local l2 = hits[1] and math.max(0.3, hits[1].t + 0.4) or len
        local t1 = K.TI + 0.06 + (i - 1) * (0.35 / nS) + R() * 0.04
        local dur = 0.22 + l2 / M * 0.06
        frag(A.frags, ex, rv, l2, t1, dur, (K.wide and 0.1 or 0.06) * (0.8 + R() * 0.6))
        if hits[1] then
          mark(hits[1].it, t1 + dur * 0.45)
          addDot(A, ex + rv * hits[1].t, t1 + dur * 0.45)
        end
      end
      if K.burst then
        local bd = math.min(deep, K.burst * M)
        A.bp, A.tb = p0 + dv * bd, tOf(bd)
        A.fb = nb(V3(1, 1, 1), CF(A.bp), WHITE, Enum.PartType.Ball)
        for _ = 1, 18 do
          local rv = coneDir(R, dv, 175)
          local len = (1.0 + R() * 1.0) * M
          local hits = W.trace(d, yaw, A.bp, rv, len, true)
          local l2 = hits[1] and math.max(0.3, hits[1].t + 0.3) or len
          local dur = 0.18 + l2 / M * 0.05
          local t1 = A.tb + R() * 0.05
          frag(A.frags, A.bp, rv, l2, t1, dur, 0.07)
          if hits[1] then
            mark(hits[1].it, t1 + dur * 0.5)
            addDot(A, A.bp + rv * hits[1].t, t1 + dur * 0.5)
          end
        end
      end
    end
    for _, H in ipairs(hitP) do
      if not H.at then H.at = W.inside(d, yaw, p0, H.it, 0.6) and K.TI or (K.TI + K.P * 0.8) end
    end
    -- 命中点一团红光：碎甲在内壁崩落的地方（拍上去 0.4 秒以后）；杀爆没打穿的不画
    if K.scab then redGlow(A, A.inner, true) A.rgT = 0.4
    elseif not K.blast or m.r == "pen" or m.kill then redGlow(A, p0 + dv * 0.3, K.wide or K.blast) end
    killFx(A, m, d, yaw, hitP, R, (A.tb or (K.TI + K.P)) + 0.35)
    A.info = T("wt.xr." .. sub, m.pen or "?", m.arm or "?")
    A.info2 = m.kill and T((m.why == "ammo") and "wt.killAmmo" or ((m.why == "fire") and "wt.killFire" or "wt.kill")) or nil
    return A
  end

  local function xkStep(t, dt)
    local A = xa
    local K, p0, dv, n = A.K, A.p0, A.dv, A.n
    local TIk, Pk = A.TI, A.P
    local ti = t - TIk
    -- ① 飞进来，尾巴拖一道曳光
    if ti < 0 then
      local sp = p0 - dv * (12 * (1 - t / TIk) + K.len * 0.5)
      A.shell.CFrame = CFrame.lookAt(sp, sp + dv)
      A.shell.Transparency = 0
      if seg(A.trail, p0 - dv * 12, sp - dv * K.len * 0.5, 0.06) then A.trail.Transparency = 0.25 end
    elseif seg(A.trail, p0 - dv * 12, p0, 0.06) then
      A.trail.Transparency = math.clamp(0.25 + ti * 0.5, 0.25, 1)
    end
    if ti >= 0 then
      -- ② 打上：白闪、贴着装甲的一圈、弹坑烧红；窗口底色轻轻亮一下
      local fq = ti / 0.3
      A.flash.Transparency = (fq < 1) and fq or 1
      A.flash.Size = V3(1, 1, 1) * lerp(0.4, (K.small and 1.4) or (K.blast and 5) or 2.8, ease(fq))
      local rq = ti / 0.55
      local r = lerp(0.3, (K.blast and 9) or (K.scab and 6) or (K.small and 2) or 4.5, ease(rq))
      A.ring.Size = V3(0.05, r, r)
      A.ring.Transparency = (rq < 1) and lerp(0.2, 1, rq) or 1
      local cq = math.clamp(ti / 2.2, 0, 1)
      A.crater.Color = heat(cq, WHITE, ORANGE, EMBER, 0.2)
      A.crater.Transparency = lerp(0, 0.35, cq)
      vp.BackgroundColor3 = RGB(58, 64, 72):Lerp(VP_BG, math.clamp(ti / 0.25, 0, 1))
      if K.blast or K.scab then A.shell.Transparency = 1 end
    end
    -- 往回溅的火花
    for _, B in ipairs(A.back) do
      local bt = t - B.t
      if bt >= 0 then
        local q = bt / 0.6
        if q < 1 then
          B.p.CFrame = CF(p0 + B.v * ease(q) + V3(0, -0.4 * q * q, 0))
          B.p.Size = V3(1, 1, 1) * lerp(B.s, B.s * 0.4, q)
          B.p.Color = heat(q, WHITE, ORANGE, EMBER, 0.35)
          B.p.Transparency = lerp(0, 0.7, q)
        else B.p.Transparency = 1 end
      end
    end
    -- ③ 钻进去：杆头往里走（越往里越慢），长杆被啃短；孔道一路烧红再冷下去；全口径弹顶着一块装甲塞子
    if A.chan and ti >= 0 then
      local q = math.clamp(ti / Pk, 0, 1)
      local tipD = A.deep * ease(q)
      local tip = p0 + dv * math.max(tipD, 0.05)
      local L = K.len * (1 - (K.erode or 0) * q)
      A.shell.CFrame = CFrame.lookAt(tip - dv * L * 0.5, tip)
      A.shell.Size = V3(K.w, K.w, math.max(L, 0.1))
      if q < 1 then
        A.shell.Color, A.shell.Transparency = K.col:Lerp(WHITE, 0.5), 0
      else
        local cq = math.clamp((ti - Pk) / 1.4, 0, 1)
        A.shell.Color, A.shell.Transparency = heat(cq, WHITE, ORANGE, EMBER, 0.25), lerp(0, 0.2, cq)
      end
      if A.tb and t >= A.tb then A.shell.Transparency = 1 end   -- 穿甲爆破弹：炸了就没了
      local hq = math.clamp(ti / 2, 0, 1)
      if seg(A.chan, p0, tip, K.w * 0.8) then A.chan.Transparency, A.chan.Color = 0.1, heat(hq, RGB(255, 230, 170), ORANGE, EMBER, 0.3) end
      if seg(A.chanGlow, p0, tip, K.w * 2.6) then A.chanGlow.Transparency = lerp(0.55, 1, math.clamp(ti / 1.6, 0, 1)) end
      if A.plug then
        local pq = math.clamp(ti / (Pk * 0.6), 0, 1)
        local pp = p0 + dv * (math.min(tipD, A.deep * 0.45) + 0.12)
        A.plug.CFrame = CFrame.lookAt(pp, pp + dv) * CFrame.Angles(0, math.pi / 2, 0) * CFrame.Angles(pq * 1.4, 0, 0)
        A.plug.Color, A.plug.Transparency = heat(math.clamp(ti / 1.8, 0, 1), RGB(255, 220, 160), ORANGE, EMBER, 0.3), 0
      end
    end
    -- ④ 破片
    fragStep(A.frags, t)
    -- ⑤ 穿甲爆破弹在车里炸开 / 杀爆在车外炸开 / 碎甲拍饼、冲击波、内壁崩落
    if A.tb and A.fb then
      local bt = t - A.tb
      if bt >= 0 then
        local q = bt / 0.8
        if q < 1 then
          A.fb.Size = V3(1, 1, 1) * lerp(0.5, 2.6 * W.M, ease(q))
          A.fb.Color = heat(q, WHITE, ORANGE, EMBER, 0.25)
          A.fb.Transparency = lerp(0, 0.9, q ^ 1.4)
          vp.BackgroundColor3 = RGB(110, 66, 40):Lerp(VP_BG, math.clamp(q * 3, 0, 1))
        else A.fb.Transparency = 1 end
      end
    end
    if K.blast and ti >= 0 then
      local q = ti / 0.9
      if q < 1 then
        A.fb.Size = V3(1, 1, 1) * lerp(0.8, A.fbR * 2, ease(q))
        A.fb.Color = heat(q, WHITE, ORANGE, RGB(70, 60, 55), 0.25)
        A.fb.Transparency = lerp(0, 0.85, q ^ 1.3)
      else A.fb.Transparency = 1 end
      local sq = (ti - 0.25) / 2.5
      if sq > 0 and sq < 1 then
        A.smoke.Size = V3(1, 1, 1) * lerp(1.5, A.fbR * 2.6, ease(sq))
        A.smoke.CFrame = CF(p0 + n * (1.2 + 2 * sq) + V3(0, 2.4 * sq, 0))
        A.smoke.Transparency = lerp(0.5, 1, sq)
      elseif sq >= 1 then A.smoke.Transparency = 1 end
    end
    if K.scab and ti >= 0 then
      local pq = math.clamp(ti / 0.15, 0, 1)
      local pr = lerp(0.4, 1.9, ease(pq))
      A.pan.Size = V3(lerp(0.4, 0.12, pq), pr, pr)
      A.pan.Transparency = (ti < 0.22) and 0 or 1
      local wq = (ti - 0.2) / 0.22
      if wq >= 0 and wq < 1 then
        local wp = p0 + dv * (0.3 * W.M * wq)
        A.wave.CFrame = CFrame.lookAt(wp, wp + dv) * CFrame.Angles(0, math.pi / 2, 0)
        A.wave.Size = V3(0.06, 1.6 + 1.4 * wq, 1.6 + 1.4 * wq)
        A.wave.Transparency = 0.2 + 0.6 * wq
      else A.wave.Transparency = 1 end
      local sq = (ti - 0.4) / 0.3
      if sq >= 0 then
        A.scab.Transparency = (sq < 1) and lerp(0, 1, sq) or 1
        A.scab.Color = heat(math.clamp(sq, 0, 1), WHITE, ORANGE, EMBER, 0.4)
      end
    end
    -- ⑥ 打到的乘员 / 模块：到的那一刻红白闪、胀一下，再定成最后的颜色（乘员是零件拼的人：H.ps 每个零件一起闪）
    for _, H in ipairs(A.hitP) do
      local ht = t - H.at
      if ht >= 0 then
        if ht < 0.7 then
          local fc = (math.floor(ht * 14) % 2 == 0) and RGB(255, 255, 255) or RGB(255, 40, 30)
          local gk = 1 + 0.3 * (1 - ht / 0.7)
          for _, q in ipairs(H.ps or { H }) do
            q.p.Color, q.p.Transparency, q.p.Size = fc, 0, q.size * gk
          end
        elseif not H.done then
          H.done = true
          for _, q in ipairs(H.ps or { H }) do q.p.Color, q.p.Transparency, q.p.Size = xrSub(H.col, q.g, H.s or 2, H.cat), H.tr, q.size end
          for _, e in ipairs(H.edges or {}) do e.Transparency = 0.05 end   -- 打坏 / 受损的：外面一圈橙框
        end
      end
    end
    -- ⑦ 弹药殉爆、起火
    if A.boom and t >= A.boomT then
      local q = (t - A.boomT) / 1.2
      if q < 1 then
        A.boom.Size = V3(1, 1, 1) * lerp(1, A.boomR, ease(q))
        A.boom.Color = heat(q, WHITE, ORANGE, EMBER, 0.3)
        A.boom.Transparency = lerp(0.05, 1, q ^ 1.5)
        vp.BackgroundColor3 = RGB(110, 66, 40):Lerp(VP_BG, math.clamp(q * 3, 0, 1))
      else A.boom.Transparency = 1 end
    end
    if A.fire and t >= A.fireT then
      for i, F in ipairs(A.fire) do
        local fl = 0.75 + 0.22 * math.sin(t * (9 + i * 3.7) + i) + 0.14 * math.sin(t * 23 + i * 2)
        F.p.Size = V3(1, 1, 1) * F.s * fl
        F.p.CFrame = CF(F.c + V3(0, (fl - 0.6) * 0.9, 0))
        F.p.Transparency = 0.25
      end
    end
    dotsStep(A, t)
    redGlowStep(A, ti)
    dmgStep(t)
    -- 字幕（左下小字）；击毁的原因换到上面正中的标题
    if ti >= 0 and not A.said then A.said = true setInfo(A.info) xInfo.TextColor3, xInfo.Visible = INFO, true end
    if A.info2 and not A.said2 and t >= (A.boomT or (TIk + Pk)) + 0.15 then A.said2 = true xTitle.Text, xTitle.TextColor3 = A.info2, KILLC end
    -- 镜头（同射流）：一直贴着命中的那一块，从来弹方向斜上方推近、跟一点弹芯，打完稍微退一点；打上那一下一震
    xrSpin += dt * math.rad(5)
    local back = ease((t - (TIk + Pk + 0.6)) / 2.2)
    local tgt = A.chan and (p0 + dv * math.min((A.deep or 0) * 0.35 * ease(math.max(ti, 0) / Pk), 3)) or p0
    local dist = lerp(lerp(xrDist * 1.3, xrDist, ease(t / TIk)), xrDist * 1.32, back)
    local eye = tgt + CFrame.Angles(0, xrSpin, 0) * xrDir * dist + V3(0, dist * 0.42, 0)
    if ti >= 0 and ti < 0.45 then
      local k = (1 - ti / 0.45) ^ 2 * ((K.blast and 0.5) or (K.small and 0.12) or 0.3)
      eye += V3(math.sin(t * 91) * k, math.sin(t * 73 + 1) * k, math.sin(t * 57 + 2) * k)
    end
    vcam.CFrame = CFrame.lookAt(eye, tgt)
  end

  local GHOST_N = 120   -- 回放里车的半透明影子最多几块
  -- 车壳影子的样子（11-28：浅一点、更透——原来 150,190,220 / 0.88，几层模型叠起来一片浑蓝，盖住里面的部件）
  local GHOST = { col = RGB(206, 220, 234), tr = 0.9, mat = Enum.Material.SmoothPlastic }
  local XR_LIMIT = 360   -- 回放里部件最多几个零件（XrayOwn.plan 的 limit：弹多的车一发一个零件、再多少画几发）
  local lastGhost = nil   -- 测试 / 截图用（tools/mock/xrshot.lua）：这一回放的车壳用哪个原模型、炮塔转角、样子
  local IMeta = nil       -- ImportedMeta（第一次用到时 require；没有记 false）
  G.wtXrStyle = function()
    if not lastGhost then return {} end
    local s = lastGhost.style
    return { ghost = { key = lastGhost.key, ty = lastGhost.ty, tur = lastGhost.tur,
      style = { col = { math.floor(s.col.R * 255 + 0.5), math.floor(s.col.G * 255 + 0.5), math.floor(s.col.B * 255 + 0.5) }, tr = s.tr,
        mat = tostring(s.mat):match("([%w_]+)$") } } }
  end
  -- 影子用哪几块（11-27 审查）：原来按包围盒体积挑最大的 120 块——履带板（Tracks.lua 挂在车模型下的 TrackLink，一辆八九十块）占了名额，
  --   细长的件（炮管、天线、机枪，体积小）被挤掉，而炮管是回放里最好认的东西。现在履带板不要，按最长的那条边排：丢的是螺栓、灯座这种小块
  local function ghostParts(model)
    local cand = {}
    for _, p in ipairs(model:GetDescendants()) do
      if p:IsA("BasePart") and p.Transparency < 0.9 and p.Name ~= "TrackLink" then
        local sz = p.Size
        cand[#cand + 1] = { p, math.max(sz.X, sz.Y, sz.Z) }
      end
    end
    if #cand > GHOST_N then table.sort(cand, function(a, b) return a[2] > b[2] end) end
    local out = {}
    for i = 1, math.min(#cand, GHOST_N) do out[i] = cand[i][1] end
    return out
  end
  G.wtGhostParts = ghostParts   -- 测试用
  local function ball(pos, r, col, tr)
    local b = box(V3(r, r, r), CF(pos), col, tr or 0, Enum.Material.Neon)
    b.Shape = Enum.PartType.Ball
    return b
  end
  local function staticShot(d, yaw, p0, dv, x, pen)
    line(p0 - dv * 9, p0, RGB(255, 120, 40), 0.16)
    if pen then
      local core = (x.core or 0) * W.M
      if core > 0 then
        line(p0, p0 + dv * core, RGB(255, 150, 50), 0.2)
        for _, h in ipairs(W.trace(d, yaw, p0 + dv * 0.1, dv, core, true)) do ball(p0 + dv * (0.1 + h.t), 0.36, FRAG) end
      end
      for i, rv in ipairs(W.cone(dv, x.half or 18, x.n or 0, x.seed)) do
        local len = (1.4 + (i % 4) * 0.35) * W.M
        local hits = W.trace(d, yaw, p0 + dv * 0.1, rv, len, true)
        local l2 = hits[1] and math.max(0.3, hits[1].t + 0.4) or len
        line(p0, p0 + rv * l2, SPALL, 0.06)
        if hits[1] then ball(p0 + dv * 0.1 + rv * hits[1].t, 0.36, FRAG) end
      end
      ball(p0 + dv * 0.3, 1.9, RGB(255, 46, 36), 0.4)
    end
    box(V3(0.5, 0.5, 0.5), CF(p0), RGB(255, 240, 200), 0, Enum.Material.Neon)
  end
  -- 机枪 / 机炮连着打穿同一辆（用户 11-28「机枪连续贯穿车体的话 x光就同一个角度然后一直放各种子弹打进去的x透视吧」）：
  --   1.5 秒内同一辆的下一发小弹不重画、不换角度——这一发的弹道、弹芯、破片接着画进去，打到的乘员 / 模块按现在的状态改色，镜头停住不绕
  local xrBurst = nil   -- { id, t, n }
  local xrHold = false  -- 镜头停住（连发时）
  local xrParts = {}    -- 上一次完整画的乘员 / 模块：[布局项] = { p, ps }
  local function burstHit(m, d, x)
    local p0 = V3(x.p[1], x.p[2], x.p[3])
    local dv = V3(x.d[1], x.d[2], x.d[3]).Unit
    local yaw = x.ty or 0
    staticShot(d, yaw, p0, dv, x, m.r == "pen" or m.kill)
    local st = states(entModel(m.id), d, m)
    for it, P in pairs(xrParts) do
      local sv = st[it] or 2
      local hit = sv < 2
      local col = xrCol(P.kind, P.cat or "other", sv, hit)
      local tr = xrTr(P.kind, sv, hit)
      for _, q in ipairs(P.ps or { { p = P.p } }) do q.p.Color, q.p.Transparency = xrSub(col, q.g, sv, P.cat), tr end
      if hit and P.kind ~= "crew" and not P.edges then P.edges = edgeBox(P.F or CF(), P.ps or { { p = P.p, size = P.p.Size } }, false) end
    end
    xrBurst.n += 1
    xrBurst.t = os.clock()
    xrUntil = math.max(xrUntil, os.clock() + 2.5)
    setInfo(T("wt.xrBurst", xrBurst.n))
    xInfo.Visible = true
    local w, c, rk = resultWord(m, false)   -- 这几发里最好的结果（打穿过一发就一直写击穿）
    if rk >= (xrBurst.rank or 0) then xTitle.Text, xTitle.TextColor3, xrBurst.rank = w, c, rk end
    dmgFill(m)
    dmgStep(99)
    crewLine(st, W.layout(d))
  end
  local function showXray(m)
    local d = VD.get and VD.get(m.veh) or VD[m.veh]
    local x = m.xr
    if not d or not x then return end
    if x.sub == "ac" and xrBurst and xrBurst.id == m.id and xr.Visible and os.clock() - xrBurst.t < 1.5 then
      burstHit(m, d, x)
      return
    end
    world:ClearAllChildren()
    table.clear(xrParts)
    xa = nil
    vp.BackgroundColor3 = VP_BG
    xInfo.Visible = false
    dmgReset()
    local lay = W.layout(d)
    local yaw = x.ty or 0
    local base = CF()   -- 回放里车底座在原点
    -- 车的外形：看得见那辆车就照它的模型复制一份半透明的；看不见画车体、炮塔两个半透明的框
    local v = G.viewById and G.viewById(m.id)
    local n = 0
    if v and v.model and v.hullF then
      local inv = (v.hullF):Inverse()
      -- 只复制 GHOST_N 块（11-27 M3 丝滑：原来最多复制 400 块，命中那一下卡一顿；零件拼的车小零件上百块，
      --   88% 透明的影子里看不出来；原模型的车本来就没几块，照旧整辆）
      for _, p in ipairs(ghostParts(v.model)) do
        n += 1
        local c = p:Clone()
        for _, ch in ipairs(c:GetChildren()) do if not ch:IsA("SpecialMesh") then ch:Destroy() end end
        pcall(function() c.TextureID = "" end)
        c.Anchored, c.CanCollide, c.CastShadow = true, false, false
        c.Material, c.Color, c.Transparency = GHOST.mat, GHOST.col, GHOST.tr
        c.CFrame = inv * p.CFrame
        c.Parent = world
      end
    end
    if n == 0 then
      local hH = lay.hH
      local b1 = box(V3(d.W, hH - (d.clear or 1.2), d.L), CF(0, ((d.clear or 1.2) + hH) / 2, 0), GHOST.col, 0.86)
      b1:SetAttribute("XrGhost", true)
      if d.turret then
        local tcf = CF(W.fromTur(d, V3(), yaw)) * CFrame.Angles(0, -math.rad(yaw), 0)
        local b2 = box(lay.ts, tcf * CF(0, lay.ts.Y / 2, 0), GHOST.col, 0.84)
        b2:SetAttribute("XrGhost", true)
      end
    end
    do   -- 截图用：这辆车的原模型键（ImportedMeta 的 alias）、炮塔转角
      if IMeta == nil then
        local ms = RS:FindFirstChild("ImportedMeta")
        local okIM, r = ms ~= nil, nil
        if okIM then okIM, r = pcall(require, ms) end
        IMeta = (okIM and type(r) == "table") and r or false
      end
      local key = IMeta and IMeta.alias and IMeta.alias[d.id]
      local info = key and IMeta.m and IMeta.m[key]
      lastGhost = { key = key, ty = yaw, tur = info and info.tur, style = GHOST }
    end
    -- 乘员、模块（用户 11-28「目前x光效果还是不如战雷」：照战雷的命中回放重画）——每件照真东西的样子画（XrayOwn.plan，同按住 X 的透视：
    --   一发发的弹、发动机缸体、变速箱、油箱、炮闩炮管、人形乘员），实心、打光（原来除了乘员都是一个半透明的方块、统一一种蓝灰）；
    --   没事的按类别一种沉着的颜色（XC：弹药黄铜、油箱橄榄、发动机钢灰……），这一发没打到的淡一点、退后一点，打到的才醒目；
    --   伤了琥珀、毁了红、乘员阵亡暗红；拿不到形状的退回一个方块
    local st = states(entModel(m.id), d, m)
    local hitK = {}
    for _, p in ipairs(m.parts or {}) do hitK[p.k] = true end
    local sub = (not x.jet) and KS[x.sub or ""] and x.sub or nil   -- 动能弹 / 穿甲爆破 / 杀爆 / 碎甲：各自的慢放（xkBuild）
    local anim = (x.jet or sub) and (m.r == "pen" or m.kill) and x.sub ~= "ac" and true or false   -- 打穿了才放慢放动画（机枪 / 机炮的小弹不放：连发时同一个角度往里叠）
    local hitP = {}   -- 动画里打到的乘员 / 模块：先画成没事的样子，射流 / 破片到了才变色
    local tF = d.turret and (CF(W.fromTur(d, V3(), yaw)) * CFrame.Angles(0, -math.rad(yaw), 0)) or CF()
    local FR = { hull = CF(), tur = tF, gun = (d.gun and d.turret) and (tF * CF(d.gun.pivot) * CFrame.Angles(math.rad(x.gp or 0), 0, 0)) or tF }
    local plan = nil
    if XO and XO.plan then
      local okP, r = pcall(XO.plan, d, { limit = XR_LIMIT })
      if okP and type(r) == "table" and r.items then plan = r end
    end
    local byIt = {}
    if plan then for _, x2 in ipairs(plan.items) do if x2.it then byIt[x2.it] = x2 end end end
    local function partsOf(specs, F, colFn, tr)   -- 一件的零件：{ { p, size, g } … }
      local ps = {}
      for _, sp in ipairs(specs) do
        local q = box(sp.s, F * sp.cf, colFn(sp.g), tr)
        if sp.sh == "S" then q.Shape = Enum.PartType.Ball elseif sp.sh == "C" then q.Shape = Enum.PartType.Cylinder end
        q.Size = sp.s
        ps[#ps + 1] = { p = q, size = q.Size, g = sp.g }
      end
      return ps
    end
    for _, it in ipairs(lay.list) do
      local s = st[it] or 2
      local x2 = byIt[it]
      local cat = (it.kind == "crew") and "crew" or (x2 and x2.cat) or "other"
      local col = xrCol(it.kind, cat, s, hitK[it.k])
      local tr = xrTr(it.kind, s, hitK[it.k])
      local ps, F = nil, nil
      if x2 and x2.specs and #x2.specs > 0 then
        F = FR[x2.frame] or FR.hull
        ps = partsOf(x2.specs, F, function(g) return xrSub(col, g, s, cat) end, tr)
      end
      local p
      if ps and #ps > 0 then
        p = ps[1].p
      else
        local size = it.hi - it.lo
        local c = (it.lo + it.hi) / 2
        local cf = it.tur and (CF(W.fromTur(d, c, yaw)) * CFrame.Angles(0, -math.rad(yaw), 0)) or CF(c)
        F = it.tur and tF or CF()
        p = box((it.kind == "crew") and size * 0.8 or size, cf, col, tr)
        if it.kind == "crew" then
          local sm = Instance.new("SpecialMesh")
          sm.MeshType = Enum.MeshType.Sphere
          sm.Parent = p
        end
        ps = nil
      end
      -- 这一发打坏 / 打伤的模块：外面一圈橙框（慢放的到那一刻才亮）
      local edges = (hitK[it.k] and it.kind ~= "crew" and s < 2) and edgeBox(F, ps or { { p = p, size = p.Size } }, anim) or nil
      xrParts[it] = { p = p, ps = ps, kind = it.kind, cat = cat, F = F, edges = edges }
      if anim and hitK[it.k] then
        table.insert(hitP, { p = p, ps = ps, it = it, col = col, tr = tr, size = p.Size, cat = cat, s = s, edges = edges })
        local c0 = xrCol(it.kind, cat, 2, true)   -- 射流 / 破片到之前：没事的样子
        for _, q in ipairs(ps or { { p = p } }) do q.p.Color, q.p.Transparency = xrSub(c0, q.g, 2, cat), 0 end
      end
    end
    if plan then   -- 不算伤害的件（并列机枪、车长周视镜、热像仪、反坦克导弹发射架）：没事的颜色、淡一点
      for _, x2 in ipairs(plan.items) do
        if not x2.it and x2.specs and x2.cat ~= "era" then
          local col = xrCol("mod", x2.cat, 2, false)
          partsOf(x2.specs, FR[x2.frame] or FR.hull, function(g) return xrSub(col, g, 2, x2.cat) end, xrTr("mod", 2, false))
        end
      end
    end
    -- 弹道：外面一段、弹芯往里一段（橙），破片一锥（黄）；射流打穿的换成慢放动画
    local p0 = V3(x.p[1], x.p[2], x.p[3])
    local dv = V3(x.d[1], x.d[2], x.d[3]).Unit
    if anim and x.jet then
      xa = xaBuild(m, x, d, yaw, p0, dv, hitP)
      xa.step = xaStep
    elseif anim then
      xa = xkBuild(m, x, d, yaw, p0, dv, hitP, sub)
      xa.step = xkStep
    else
      staticShot(d, yaw, p0, dv, x, m.r == "pen" or m.kill)
      if m.r == "ric" then   -- 跳弹：照装甲面的法线反射，弹开的那一截（渐淡的橙线）
        local zone, _, _, nn = W.where(d, p0, dv, yaw)
        if zone == "tur" and nn then nn = W.fromTur(d, nn, yaw) - W.fromTur(d, V3(), yaw) end
        if nn and nn.Magnitude > 0.5 then
          nn = nn.Unit
          local rv = dv - nn * 2 * dv:Dot(nn)
          if rv.Magnitude > 0.1 then
            rv = rv.Unit
            line(p0, p0 + rv * 4, RGB(255, 150, 60), 0.12)
            line(p0 + rv * 4, p0 + rv * 9, RGB(255, 196, 140), 0.07)
          end
        end
      end
    end
    -- 镜头（战雷的回放）：贴近命中点看——车长的六成左右远（原来 1.3 倍车长看整辆车），从来弹方向斜上方、偏开 30 度左右（弹道不缩成一个点）；
    --   没放慢放的绕着命中点和车中心之间那一点慢慢转
    local cen = V3(0, (d.H or 7) * 0.45, 0)
    xrC = anim and p0 or p0:Lerp(cen, 0.3)
    xrDist = math.clamp(math.max(d.L, d.W) * 0.62, 9, 16)
    xrDir = (-dv * V3(1, 0, 1))
    if xrDir.Magnitude < 0.1 then xrDir = V3(0, 0, 1) end
    xrDir = xrDir.Unit
    xrSpin = math.rad(anim and 32 or 26)
    local nm = (m.tk and T("tree." .. m.tk) ~= "tree." .. m.tk) and T("tree." .. m.tk) or T("veh." .. m.veh)   -- 科技树出的车写科技树里的名字
    -- 字：上面正中结果字；左下小字第一行车名 · 距离、第二行弹种和穿深（慢放的打上那一刻写）；窗口下面车组、损伤行
    local w, c, rk = resultWord(m, anim)
    xTitle.Text, xTitle.TextColor3 = w, c
    xName = T("wt.xrName", nm, m.dist or 0)
    setInfo(nil)
    xInfo.TextColor3, xInfo.Visible = INFO, not anim
    if not anim and m.pen and m.arm then setInfo(T("wt.mm", m.arm, m.pen)) end
    local atK = {}
    for _, H in ipairs(hitP) do atK[H.it.k] = H.at end
    dmgFill(m, xa and function(p)
      if not p then return (xa.boomT or xa.fireT or ((xa.TI or TI) + (xa.P or JD))) + 0.2 end
      return (atK[p.k] or ((xa.TI or TI) + (xa.P or JD))) + 0.25
    end or nil)
    dmgStep(xa and 0 or 99)
    crewLine(st, lay)
    -- 摆在哪：右上（小地图在右上时——步兵、开飞机——挪到它下面）
    if not mobile then
      local box0 = G.hudParts and G.hudParts.miniBox
      local y = 18
      if box0 and box0.Visible and box0.AnchorPoint.X > 0.5 and box0.Position.X.Scale > 0.5 and box0.Position.Y.Scale < 0.5 then
        y = box0.Position.Y.Offset + box0.Size.Y.Offset + 12
      end
      xr.Position = UD2(1, -20, 0, y)
    end
    xr.Visible = true
    xrUntil = os.clock() + (anim and (m.kill and 7 or 6.2) or (m.kill and 5.5 or ((m.r == "pen") and 4.5 or 3.2)))   -- 跳弹 / 没击穿短一点
    xrBurst = (x.sub == "ac") and { id = m.id, t = os.clock(), n = 1, rank = rk } or nil   -- 机枪 / 机炮：接下来 1.5 秒内的同一辆往里叠
    xrHold = x.sub == "ac"   -- 连发：镜头停在这个角度
    if xa then G.try_(xa.step, 0, 0) end   -- 先摆好第一帧（不然头一帧是没藏好的件）
    local _ = base
  end

  ---------------------------------------------------------------- 左下：自己这辆车的车组 / 模块

  local panel = frame(gui, UDim2.fromOffset(254, 96), mobile and UD2(0, 12, 1, -238) or UD2(0, 254, 1, -24), RGB(6, 10, 12), 0.35, V2(0, 1))
  panel.Name = "WtCrew"
  panel.Visible = false
  do
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = RGB(120, 200, 140), 1, 0.55
    s.Parent = panel
  end
  local crewIcons, modIcons = {}, {}
  local CREW_ROW = { "drv", "gnr", "cmd", "ldr" }
  for i, r in ipairs(CREW_ROW) do
    local f = frame(panel, UDim2.fromOffset(48, 30), UD2(0, 6 + (i - 1) * 54, 0, 6), RGB(20, 30, 26), 0.2)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 4)
    c.Parent = f
    local l = label(f, T("wt.rs." .. r), UD2(1, 0, 1, 0), UD2(), 15, OK, BOLD)
    f.Name = "Crew_" .. r
    crewIcons[r] = { f = f, l = l }
  end
  local MOD_ROW = { "engine", "trans", "track", "barrel", "breech", "tdrive", "edrive", "ammo", "fuel" }
  for i, k in ipairs(MOD_ROW) do
    local f = frame(panel, UDim2.fromOffset(25, 20), UD2(0, 6 + (i - 1) * 27, 0, 42), RGB(20, 30, 26), 0.2)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, 3)
    c.Parent = f
    local l = label(f, T("wt.ms." .. k), UD2(1, 0, 1, 0), UD2(), 11, OK, BOLD)
    f.Name = "Mod_" .. k
    modIcons[k] = { f = f, l = l }
  end
  local panelTip = label(panel, "", UD2(1, -8, 0, 16), UD2(0, 4, 0, 72), 12, Color3.new(1, 1, 1), BOLD, nil, Enum.TextXAlignment.Left)
  panelTip.Name = "Tip"
  local flashUntil = 0

  local hurtText = label(gui, "", UDim2.fromOffset(700, 22), UD2(0.5, 0, 1, -150), 17, DEAD, BOLD, V2(0.5, 1))
  hurtText.Name = "WtHurtText"
  hurtText.Visible = false
  local hurtUntil = 0
  local function say(text, col, dur)
    hurtText.Text, hurtText.TextColor3 = text, col or DEAD
    hurtText.Visible = true
    hurtUntil = os.clock() + (dur or 3)
  end

  local function colOf(s) return (s == 0) and DEAD or ((s == 1) and HURT or OK) end
  local function updatePanel()
    local st = G.myVeh
    local em = st and st.em
    local wc = em and em:GetAttribute("WtC")
    if not wc or (G.S and G.S.veh == nil and not st) then panel.Visible = false return end
    if G.wtTankShown and G.wtTankShown() then panel.Visible = false return end   -- 电脑上是战雷那套的损伤示意图（WtTank.lua）
    panel.Visible = true
    local d = st.d or (VD.get and VD.get(em:GetAttribute("Model") or ""))
    if not d then panel.Visible = false return end
    local lay = W.layout(d)
    -- 乘员：按座位（谁坐在这个位子上、活没活）
    local seatState, have = {}, {}
    for tok in string.gmatch(wc, "[^,]+") do
      local s, seat = tonumber(string.sub(tok, 1, 1)) or 2, string.sub(tok, 2)
      if seatState[seat] == nil or s > seatState[seat] then seatState[seat] = s end
      have[seat] = true
    end
    for _, r in ipairs(CREW_ROW) do
      local ic = crewIcons[r]
      ic.f.Visible = have[r] == true
      if have[r] then ic.l.TextColor3 = colOf(seatState[r]) end
    end
    -- 模块：几块合成一个图标的取最差的（左右履带、几个弹药架、几个油箱）
    local wm = em:GetAttribute("WtM") or ""
    local worst = {}
    local mi = 0
    for _, it in ipairs(lay.list) do
      if it.kind ~= "crew" then
        mi += 1
        local s = tonumber(string.sub(wm, mi, mi)) or 2
        local k = it.k
        if k == "trackL" or k == "trackR" then k = "track" elseif k == "ammoH" then k = "ammo" elseif k == "fuelL" or k == "fuelR" then k = "fuel" end
        if worst[k] == nil or s < worst[k] then worst[k] = s end
      end
    end
    for _, k in ipairs(MOD_ROW) do
      local ic = modIcons[k]
      ic.f.Visible = worst[k] ~= nil
      if worst[k] then ic.l.TextColor3 = colOf(worst[k]) end
    end
    local t = os.clock()
    local flash = t < flashUntil and (t * 8) % 1 < 0.5
    panel.BackgroundColor3 = flash and RGB(90, 20, 14) or RGB(6, 10, 12)
    -- 提示：起火、维修中、坏了能修
    local fire = em:GetAttribute("WtF") == true
    local fix = em:GetAttribute("WtFix")
    local anyBad = false
    for _, s in pairs(worst) do if s < 2 then anyBad = true end end
    local afLeft = em:GetAttribute("WtAFLeft")   -- 弹药架起火：几秒内不灭就殉爆（服务器 Wt.lua，用户 11-28「弹药架起火如果不及时灭火修要爆炸」）
    if fire and type(afLeft) == "number" then panelTip.Text, panelTip.TextColor3 = T("wt.tipAmmoFire", afLeft), ((t * 5) % 1 < 0.6) and DEAD or Color3.new(1, 1, 1)
    elseif fire then panelTip.Text, panelTip.TextColor3 = T("wt.tipFire"), ((t * 3) % 1 < 0.6) and DEAD or HURT
    elseif fix then panelTip.Text, panelTip.TextColor3 = T("wt.tipFixing", math.floor(fix * 100)), HURT
    elseif anyBad then panelTip.Text, panelTip.TextColor3 = T("wt.tipFix"), Color3.new(1, 1, 1)
    else panelTip.Text = "" end
  end

  ---------------------------------------------------------------- 金属射流（破甲弹、金属射流弹打在车上）
  --   用户 11-24 夜「再做一个金属射流弹」：命中点一团白光、往外喷一圈火花，一道白热的射流顺着来向钻进去（从车外伸进去一截，
  --   打穿的钻得深、射流弹更粗更亮），零点几秒淡掉；没打穿只有一小截
  local TS = game:GetService("TweenService")
  local function jetFx(e)
    if typeof(e.p) ~= "Vector3" or typeof(e.d) ~= "Vector3" then return end
    if (e.p - workspace.CurrentCamera.CFrame.Position).Magnitude > 3000 then return end
    local d = (e.d.Magnitude > 0.01) and e.d.Unit or V3(0, 0, -1)
    local len = math.clamp(e.len or 2, 0.5, 24)
    local big = e.big == true
    local a0, a1 = e.p - d * 1.4, e.p + d * len
    local mid, L = (a0 + a1) / 2, (a1 - a0).Magnitude
    local f = Instance.new("Folder")
    f.Name = "WtJet"
    f.Parent = workspace
    local function mk(size, cf, col, tr, shape)
      local q = Instance.new("Part")
      q.Anchored, q.CanCollide, q.CanQuery, q.CanTouch, q.CastShadow = true, false, false, false, false
      q.Material, q.Color, q.Transparency, q.Size, q.CFrame = Enum.Material.Neon, col, tr, size, cf
      if shape then q.Shape = shape end
      q.Parent = f
      return q
    end
    local w = big and 0.22 or 0.14
    local core = mk(V3(w, w, L), CFrame.lookAt(mid, a1), RGB(240, 250, 255), 0.02)
    local glow = mk(V3(w * 4, w * 4, L), CFrame.lookAt(mid, a1), RGB(150, 210, 255), 0.6)
    local flash = mk(V3(1, 1, 1) * (big and 3.4 or 2.6), CFrame.new(e.p), RGB(255, 236, 200), 0.15, Enum.PartType.Ball)
    local lt = Instance.new("PointLight")
    lt.Color, lt.Brightness, lt.Range = RGB(200, 225, 255), big and 8 or 5, 22
    lt.Parent = flash
    local pe = Instance.new("ParticleEmitter")   -- 火花：从命中点往外喷（射流反溅出来的铜和钢的碎渣）
    pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
    pe.Color = ColorSequence.new(RGB(255, 236, 190), RGB(255, 140, 60))
    pe.LightEmission = 1
    pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0.05) })
    pe.Lifetime = NumberRange.new(0.18, 0.45)
    pe.Speed = NumberRange.new(30, 70)
    pe.SpreadAngle = Vector2.new(55, 55)
    pe.Drag = 4
    pe.Rate = 0
    pe.EmissionDirection = Enum.NormalId.Front
    local emit = Instance.new("Attachment")
    emit.CFrame = CFrame.lookAt(Vector3.zero, -d)   -- 往来向那边喷
    emit.Parent = flash
    pe.Parent = emit
    pcall(function() pe:Emit(big and 46 or 30) end)
    local ti = TweenInfo.new(big and 0.32 or 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TS:Create(core, ti, { Transparency = 1 }):Play()
    TS:Create(glow, ti, { Transparency = 1, Size = V3(w * 7, w * 7, L) }):Play()
    TS:Create(flash, ti, { Transparency = 1, Size = flash.Size * 1.8 }):Play()
    TS:Create(lt, ti, { Brightness = 0 }):Play()
    task.delay(0.8, function() f:Destroy() end)
  end
  G.R.Fx.OnClientEvent:Connect(function(list)
    if type(list) ~= "table" then return end
    for _, e in ipairs(list) do
      if type(e) == "table" and e.k == "wtJet" then G.try_(jetFx, e) end
    end
  end)

  ---------------------------------------------------------------- 服务器发来的

  G.R.Drive.OnClientEvent:Connect(function(m)
    if type(m) ~= "table" then return end
    local op = m.op
    if op == "wtHit" then
      showHit(m)
      if G.wtVoice then   -- 车组语音（⑬，WtVoice.lua）
        G.wtVoice(m.kill and ((m.why == "ammo") and "killAmmo" or "kill") or ((m.r == "pen") and "pen" or ((m.r == "ric") and "ric" or ((m.r == "np") and "np" or "hit"))))
      end
      -- 命中回放：击穿 / 击毁，还有跳弹、没击穿（战雷也放：看弹打在哪、为什么没进去）——机枪 / 机炮的小弹没打穿的不放（一秒几十发刷屏）
      local small = m.xr and m.xr.sub == "ac"
      if m.xr and (m.r == "pen" or m.kill or ((m.r == "ric" or m.r == "np") and not small)) then G.try_(showXray, m) end
    elseif op == "wtHurt" then
      flashUntil = os.clock() + 1.2
      if G.wtVoice then   -- 车组语音（⑬）：被击穿 / 跳弹、着火、谁阵亡、哪个模块坏了
        if m.r == "pen" then G.wtVoice("hurtPen") elseif m.r == "ric" then G.wtVoice("hurtRic") end
        if m.fire then G.wtVoice("fire") end
        for _, p in ipairs(m.parts or {}) do
          if p.kind == "crew" and p.s == 0 then G.wtVoice(p.seat or p.k)
          elseif p.s == 0 and (p.k == "engine" or p.k == "barrel" or p.k == "breech") then G.wtVoice(p.k)
          elseif p.s == 0 and (p.k == "trackL" or p.k == "trackR") then G.wtVoice("track") end
        end
      end
      local head = T((m.r == "pen") and "wt.youPen" or ((m.r == "fire") and "wt.youFire" or ((m.r == "ric") and "wt.youRic" or ((m.r == "np") and "wt.youNp" or "wt.youHit"))))
      local sub = details(m)
      say(head .. ((sub ~= "") and ("：" .. sub) or ""), (m.r == "ric" or m.r == "np") and GREY or DEAD, 3.2)
    elseif op == "wtSwap" then
      if G.wtVoice then G.wtVoice("swap") end
      say(T("wt.swap", T("wt.r." .. m.from), T("wt.r." .. m.role), m.t or 6), HURT, 3)
    elseif op == "wtSwapped" then
      say(T("wt.swapped", T("wt.r." .. m.from), T("wt.r." .. m.role)), OK, 2.5)
    elseif op == "wtFireOut" then
      if G.wtVoice then G.wtVoice("fireOut") end
      say(T(m.ext and "wt.extOk" or "wt.fireOut"), OK, 2)
    elseif op == "wtSupply" then
      if G.wtVoice then G.wtVoice("resupply") end   -- 停在自己的据点里补给（服务器 Wt.lua supplyStep）
      local bits = {}
      if m.ammo then table.insert(bits, T("wt.supAmmo")) end
      if m.crew then table.insert(bits, T("wt.supCrew", T("wt.r." .. m.crew))) end
      say(table.concat(bits, " · "), OK, 2)
    elseif op == "wtFixed" then
      if G.wtVoice then G.wtVoice("fixed") end
      say(T("wt.fixed"), OK, 2)
    elseif op == "wtKilled" then   -- 自己的车被打掉：「被 XX 的 YY 击毁」+ 那一发的 X 光（战雷的击毁回放）
      G.wtKiller = m.kid and { id = m.kid, t = os.clock() } or nil   -- 击杀镜头（⑮）：阵亡效果（DeathFx.lua）的镜头转去看打你的那辆
      local kv = m.kveh and (string.match(T("veh." .. m.kveh), "^(%S+)") or T("veh." .. m.kveh)) or nil
      if m.kk and T("tree." .. m.kk) ~= "tree." .. m.kk then kv = T("tree." .. m.kk) end   -- 打你的是科技树出的车：写科技树里的名字
      say(kv and T("wt.killedBy", m.from or "?", kv) or T("wt.killedBy2", m.from or "?"), DEAD, 5)
      if m.xr then G.try_(showXray, m) end
    elseif op == "wtaHit" then
      showAirHit(m)
    elseif op == "wtaHurt" then
      local only = #(m.ev or {}) == 1 and m.ev[1] == "fireOut"
      if only then say(T("wta.e.fireOut"), OK, 2)
      else say(T("wta.hurt") .. "：" .. airBits(m), DEAD, 3) end
    end
  end)

  G.frameConn("WtHud", function(dt)
    local t = os.clock()
    if hitBox.Visible and t > hitUntil then   -- 到点：字淡掉再藏
      local a = math.clamp((t - hitUntil) / HIT_FADE, 0, 1)
      if a >= 1 then
        hitBox.Visible = false
        hitRank = 0
      else
        local st = 0.35 + 0.65 * a
        hitTop.TextTransparency, hitTop.TextStrokeTransparency = a, st
        hitSub.TextTransparency, hitSub.TextStrokeTransparency = a, st
      end
    end
    if hurtText.Visible and t > hurtUntil then hurtText.Visible = false end
    if xr.Visible then
      if t > xrUntil then
        xr.Visible = false
        world:ClearAllChildren()
        xa = nil
      elseif xa then
        G.try_(xa.step or xaStep, t - xa.t0, dt)
      else
        if not xrHold then xrSpin += dt * math.rad(6) end   -- 连发叠画时镜头停住（同一个角度）
        local d = CFrame.Angles(0, xrSpin, 0) * xrDir
        local eye = xrC + d * xrDist + V3(0, xrDist * 0.42, 0)
        vcam.CFrame = CFrame.lookAt(eye, xrC)
      end
    end
    G.try_(updatePanel)
  end)
end

return WtHud
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="292">
          <Properties>
            <string name="Name">WtMap</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——M 键大地图页（用户 11-25：「交战给我改成这样的画面 按m放大地图」「按m打开地图是这样的」——
--   战雷那张图：左边一栏这一局的情况、出击阵容、任务目标；右边一张带网格坐标的大地图）
--   · 战斗中按 B 打开 / 关上（开坦克时 M 是烟幕弹——用户 11-25「烟幕改成m」；开喷气机 B 是机轮刹车、M 是鼠标瞄准，不开）；
--     观战、开直升机时 M 也能开；Esc 关；机库里不开
--   · 右边：MapUI 那张图（同小地图、部署界面是同一张，挂过来、关的时候挂回小地图），盖 10 × 10 的网格，行 A～J、列 1～10
--   · 左边：模式和阶段、剩余时间、我的 SP；目标据点（谁的、在不在争夺）；出击阵容出过的车（出了几次、备用还剩几次）
local RS = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local WtMap = {}

function WtMap.init(G)
  local TH = require(RS:WaitForChild("Theme"))
  local me = Players.LocalPlayer
  local RGB = Color3.fromRGB
  local function L(zh, en) return G.L(zh, en) end   -- 多语言（11-28）
  local open = false

  local gui = Instance.new("ScreenGui")
  gui.Name = "WtMap"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 9
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")
  local dim = Instance.new("Frame")
  dim.Size = UDim2.fromScale(1, 1)
  dim.BackgroundColor3, dim.BackgroundTransparency, dim.BorderSizePixel = RGB(6, 8, 10), 0.25, 0
  dim.Parent = gui
  local function frame(parent, size, pos, col, tr)
    local f = Instance.new("Frame")
    f.Size, f.Position = size, pos or UDim2.new()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = col or TH.C.PANEL, tr or 0, 0
    f.Parent = parent
    return f
  end
  local function text(parent, s, size, pos, ts, col, font, xa)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Text, t.Size, t.Position = s, size, pos or UDim2.new()
    t.TextSize, t.TextColor3, t.Font = ts or TH.S.body, col or TH.C.TEXT, font or TH.F.body
    t.TextXAlignment = xa or Enum.TextXAlignment.Left
    t.TextStrokeTransparency = 0.6
    t.Parent = parent
    return t
  end
  -- 左栏
  local LW = 320
  -- 锚点放在中间（11-27 审查）：打开时 G.uiPop 的 UIScale 以锚点为原点缩放——锚点在左上角时是从左上往右下长，看着像往右下飘了一下
  local left = frame(dim, UDim2.new(0, LW, 1, -120), UDim2.new(0, 28 + LW / 2, 0.5, 0), TH.C.PANEL, 0.12)
  left.AnchorPoint = Vector2.new(0.5, 0.5)
  left.Name = "Side"
  TH.corner(left)
  TH.stroke(left)
  local title = text(left, L("战场地图", "BATTLE MAP"), UDim2.new(1, -24, 0, 30), UDim2.new(0, 12, 0, 8), TH.S.title, TH.C.TEXT, TH.F.title)
  title.Name = "Title"
  local info = text(left, "", UDim2.new(1, -24, 0, 60), UDim2.new(0, 12, 0, 42), TH.S.small, TH.C.MUTE, TH.F.bold)
  info.Name = "Info"
  info.TextYAlignment = Enum.TextYAlignment.Top
  info.TextWrapped = true
  local sec1 = text(left, L("目标", "OBJECTIVES"), UDim2.new(1, -24, 0, 20), UDim2.new(0, 12, 0, 108), TH.S.sub, TH.C.TEXT, TH.F.bold)
  local objList = frame(left, UDim2.new(1, -24, 0, 150), UDim2.new(0, 12, 0, 132), TH.C.BG, 1)
  objList.Name = "Objectives"
  local sec2 = text(left, L("出过的车", "SPAWNED"), UDim2.new(1, -24, 0, 20), UDim2.new(0, 12, 0, 292), TH.S.sub, TH.C.TEXT, TH.F.bold)
  local vehList = frame(left, UDim2.new(1, -24, 0, 200), UDim2.new(0, 12, 0, 316), TH.C.BG, 1)
  vehList.Name = "Spawned"
  local hint = text(dim, L("B / Esc 关闭", "B / Esc to close"), UDim2.new(0, 300, 0, 20), UDim2.new(0, 28, 1, -50), TH.S.small, TH.C.MUTE, TH.F.bold)
  hint.Name = "Hint"
  sec1.Name, sec2.Name = "SecObj", "SecVeh"
  -- 右边：大地图 + 网格
  local mapBox = frame(dim, UDim2.fromOffset(600, 600), UDim2.fromOffset(28 + LW + 40 + 300, 60 + 300), RGB(0, 0, 0), 0.2)
  mapBox.AnchorPoint = Vector2.new(0.5, 0.5)   -- 同左栏：锚点在中间（大小在 layout 里按屏幕定，位置跟着摆）
  mapBox.Name = "MapBox"
  TH.stroke(mapBox)
  local holder = frame(mapBox, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)
  holder.Name = "Holder"
  holder.ClipsDescendants = true
  local grid = frame(mapBox, UDim2.fromScale(1, 1), nil, RGB(0, 0, 0), 1)
  grid.Name = "Grid"
  grid.ZIndex = 20
  local ROWS = { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J" }
  for i = 1, 9 do
    local v = frame(grid, UDim2.new(0, 1, 1, 0), UDim2.fromScale(i / 10, 0), RGB(255, 255, 255), 0.82)
    v.ZIndex = 20
    local h = frame(grid, UDim2.new(1, 0, 0, 1), UDim2.fromScale(0, i / 10), RGB(255, 255, 255), 0.82)
    h.ZIndex = 20
  end
  for i = 1, 10 do   -- 行 A～J 写在左边、列 1～10 写在上边（战雷那样）
    local r = text(mapBox, ROWS[i], UDim2.new(0, 20, 0.1, 0), UDim2.new(0, -24, (i - 1) / 10, 0), TH.S.small, TH.C.TEXT, TH.F.bold, Enum.TextXAlignment.Center)
    r.Name = "Row_" .. ROWS[i]
    local c = text(mapBox, tostring(i), UDim2.new(0.1, 0, 0, 18), UDim2.new((i - 1) / 10, 0, 0, -20), TH.S.small, TH.C.TEXT, TH.F.bold, Enum.TextXAlignment.Center)
    c.Name = "Col_" .. i
  end
  -- 按屏幕大小摆：地图是正方形，左栏右边能放多大放多大
  local function layout()
    local vs = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
    local s = math.max(200, math.min(vs.Y - 110, vs.X - (28 + LW + 40) - 28))
    mapBox.Size = UDim2.fromOffset(s, s)
    mapBox.Position = UDim2.fromOffset(28 + LW + 40 + s / 2, 60 + s / 2)   -- 左上角照旧在 (28 + LW + 40, 60)
  end
  -- 格子坐标（小地图、地图上的点说位置用）：世界坐标 → 「C7」
  function G.mapGridRef(x, z)
    if not G.mapUV then return "" end
    local u, v = G.mapUV(x, z)
    local col = math.clamp(math.floor(u * 10) + 1, 1, 10)
    local row = math.clamp(math.floor(v * 10) + 1, 1, 10)
    return ROWS[row] .. col
  end

  local function sideName(t)
    local mine = me:GetAttribute("Side")
    if t == nil or t == "none" or t == "" then return L("中立", "Neutral"), TH.C.MUTE end
    if t == mine then return L("我方", "Ours"), TH.C.FRIEND end
    return L("敌方", "Enemy"), TH.C.FOE
  end
  local function fill()
    local S = G.S or {}
    for _, c in ipairs(objList:GetChildren()) do c:Destroy() end
    for _, c in ipairs(vehList:GetChildren()) do c:Destroy() end
    local modeName = L("历史", "Realistic")   -- 只有历史（11-27）
    local left = S.left and string.format("%d:%02d", math.floor(S.left / 60), math.floor(S.left % 60)) or "--:--"
    local w = S.wt
    info.Text = string.format(L("陆战 · %s · %s\n剩余 %s · 我的 SP %d", "Ground · %s · %s\n%s left · SP %d"), modeName,
      (S.phase == "prep") and L("准备阶段", "Preparation") or L("交战中", "Battle"), left, w and w.sp or 0)
    -- 目标据点
    local y = 0
    for _, p in ipairs(S.points or {}) do
      if y > 130 then break end
      local nm, col = sideName(p.owner)
      local row = frame(objList, UDim2.new(1, 0, 0, 24), UDim2.fromOffset(0, y), TH.C.BG, 0.5)
      row.Name = "Point_" .. tostring(p.id)
      local badge = frame(row, UDim2.fromOffset(22, 22), UDim2.fromOffset(1, 1), col, 0.15)
      TH.corner(badge, 2)
      text(badge, tostring(p.id), UDim2.fromScale(1, 1), nil, TH.S.small, RGB(16, 18, 20), TH.F.title, Enum.TextXAlignment.Center)
      local st = nm
      if p.act and (p.prog or 0) > 0 and (p.prog or 0) < 1 then st = st .. L(" · 争夺中 ", " · contested ") .. math.floor((p.prog or 0) * 100) .. "%" end
      if p.locked then st = st .. L(" · 未开放", " · locked") end
      local where = ""
      local MP = G.Map and G.Map.POINTS
      if MP then
        for _, q in ipairs(MP) do if q.id == p.id and q.x then where = "  " .. G.mapGridRef(q.x, q.z) end end
      end
      text(row, st .. where, UDim2.new(1, -32, 1, 0), UDim2.fromOffset(30, 0), TH.S.small, col, TH.F.bold)
      y += 26
    end
    if y == 0 then text(objList, L("这张图没有据点", "No objectives"), UDim2.new(1, 0, 0, 20), nil, TH.S.small, TH.C.MUTE) end
    -- 出过的车（WtMatch 推的 S.wt：出了几次、备用还剩几次）
    y = 0
    for _, k in ipairs(w and w.order or {}) do
      if y > 180 then break end
      local n = (w.ln and w.ln[k]) or 0
      local left2 = math.max(0, 1 + (w.backup or 1) - n)
      local nm = (G.T and G.T("tree." .. k)) or k
      if nm == "tree." .. k then nm = (G.T and G.T("veh." .. k)) or k end
      local row = text(vehList, string.format(L("%s　出了 %d 次 · 还能出 %d 次", "%s  spawned %d · %d left"), nm, n, left2),
        UDim2.new(1, 0, 0, 22), UDim2.fromOffset(0, y), TH.S.small, (left2 > 0) and TH.C.TEXT or TH.C.MUTE, TH.F.bold)
      row.Name = "Veh_" .. k
      y += 24
    end
    if y == 0 then text(vehList, L("这一局还没出车", "Nothing spawned yet"), UDim2.new(1, 0, 0, 20), nil, TH.S.small, TH.C.MUTE) end
  end

  local TweenService = game:GetService("TweenService")
  local DIM_T = TweenInfo.new((TH.T and TH.T.ui) or 0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)   -- Theme.T.ui、EASE.out（docs/style.md「动效」）
  local function setOpen(on)
    if on == open then return end
    open = on
    gui.Enabled = on
    if on then
      layout()
      fill()
      if G.mapMount then G.mapMount(holder, UDim2.fromScale(1, 1)) end
      -- 打开（11-27「动画做出丝滑感」）：原来一下子盖满屏——背后暗下来（0.22 秒）、左栏和地图从 0.96 弹到 1（0.18 秒，从各自的中心长开）
      if G.uiPop and not (G.reducedMotion and G.reducedMotion()) then
        dim.BackgroundTransparency = 1
        TweenService:Create(dim, DIM_T, { BackgroundTransparency = 0.25 }):Play()
        G.uiPop(left, 0.96, true)
        G.uiPop(mapBox, 0.96, true)
      end
    else
      local P = G.hudParts
      if G.mapMount and P then G.mapMount(P.miniClip or P.miniBox, UDim2.fromScale(1, 1)) end
    end
  end
  G.wtMapOpen = function() return open end
  G.wtMapToggle = function(on) if on == nil then on = not open end setOpen(on) end
  local function canOpen()
    if G.hangarActive and G.hangarActive() then return false end
    if G.settingsShown and G.settingsShown() then return false end
    local S = G.S
    return S ~= nil and (S.phase == "battle" or S.phase == "prep")
  end
  UIS.InputBegan:Connect(function(io, gp)
    if gp or UIS:GetFocusedTextBox() then return end
    local k = io.KeyCode
    if k == Enum.KeyCode.Escape and open then setOpen(false) return end
    local jet = G.fly ~= nil and G.fly.d and G.fly.d.kind == "jet"
    local ground = G.drive ~= nil
    if (k == Enum.KeyCode.B and not jet and not (G.interiorOn and G.interiorOn())) or (k == Enum.KeyCode.M and not jet and not ground) then
      if open then setOpen(false) elseif canOpen() then setOpen(true) end
    end
  end)
  -- 开着的时候每秒刷新一次左栏；机库开了 / 一局结束就关
  task.spawn(function()
    while true do
      task.wait(1)
      if open then
        if not canOpen() then setOpen(false) else fill() layout() end
      end
    end
  end)
end

return WtMap
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="293">
          <Properties>
            <string name="Name">WtSkin</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——机库里选涂装、贴花（用户 11-25「全部都做」⑯）
--   出击阵容卡片上的「涂装」（TechUI.lua 调 G.openSkin(科技树的键)）：六种涂装（色块）、战术号码（三位数，留空就不贴）、国徽开关；
--   选了就发服务器（WtMatch.lua G.ACT.wtSkinSet），这一局里出这辆车按它；画法在 View.lua（零件拼的车直接上色，原模型乘色调）
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local WtSkin = {}

function WtSkin.init(G)
  local SK = require(RS:WaitForChild("WtSkins"))
  local TT = require(RS:WaitForChild("TechTree"))
  local me = Players.LocalPlayer
  local RGB, UD2, V2 = Color3.fromRGB, UDim2.new, Vector2.new
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local BOLD, MED = Enum.Font.BuilderSansMedium, Enum.Font.BuilderSans
  local WHITE, DIM, GOLD = RGB(236, 240, 242), RGB(150, 158, 164), RGB(255, 210, 120)
  local zh = true   -- 多语言（11-28）：中文（简 / 繁）
  if G.isZh then zh = G.isZh() end

  local gui = Instance.new("ScreenGui")
  gui.Name = "WtSkin"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 14
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local saved = {}   -- 键 → { c, n, e }
  local panel = nil
  local function close()
    if panel then panel:Destroy() panel = nil end
    gui.Enabled = false
  end
  local function label(parent, s, size, pos, ts, col, font)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Size, l.Position = size, pos
    l.Text, l.TextSize, l.TextColor3, l.Font = s, ts or 14, col or WHITE, font or BOLD
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
  end
  function G.openSkin(key)
    close()
    local it = TT.get and TT.get(key)
    local cur = saved[key] or { c = "std", n = nil, e = true }
    gui.Enabled = true
    panel = Instance.new("Frame")
    panel.Name = "SkinPanel"
    panel.Size, panel.Position, panel.AnchorPoint = UDim2.fromOffset(460, 250), UD2(0.5, 0, 0.5, 0), V2(0.5, 0.5)
    panel.BackgroundColor3, panel.BackgroundTransparency, panel.BorderSizePixel = RGB(12, 14, 17), 0.05, 0
    panel.Parent = gui
    local st = Instance.new("UIStroke")
    st.Color, st.Transparency = RGB(110, 120, 126), 0.35
    st.Parent = panel
    local nm = it and T("tree." .. key) or key
    label(panel, nm .. "  ·  " .. T("wsk.title"), UD2(1, -24, 0, 24), UD2(0, 12, 0, 10), 16)
    -- 涂装：一排色块
    local sw = {}
    local function redraw()
      for k, b in pairs(sw) do
        local s2 = b:FindFirstChildOfClass("UIStroke")
        if s2 then s2.Thickness, s2.Color = (cur.c == k) and 3 or 1, (cur.c == k) and GOLD or RGB(90, 96, 100) end
      end
    end
    local function send()
      saved[key] = { c = cur.c, n = cur.n, e = cur.e }
      G.R.Act:FireServer("wtSkinSet", key, cur.c, cur.n, cur.e)
      redraw()
    end
    for i, k in ipairs(SK.ORDER) do
      local C = SK.CAMO[k]
      local b = Instance.new("TextButton")
      b.Name = "Camo_" .. k
      b.Size, b.Position = UDim2.fromOffset(68, 62), UD2(0, 12 + (i - 1) * 73, 0, 44)
      b.BackgroundColor3, b.BorderSizePixel = C.base or RGB(60, 64, 60), 0
      b.Text = ""
      b.Parent = panel
      local s2 = Instance.new("UIStroke")
      s2.Parent = b
      if C.dark then   -- 迷彩的另两种颜色两小块
        for j, col in ipairs({ C.dark, C.light }) do
          local f = Instance.new("Frame")
          f.Size, f.Position = UD2(0.36, 0, 0.3, 0), UD2(0.08 + (j - 1) * 0.46, 0, 0.1, 0)
          f.BackgroundColor3, f.BorderSizePixel = col, 0
          f.Parent = b
        end
      end
      local l = label(b, G.L(C.zh, C.en), UD2(1, 0, 0, 16), UD2(0, 0, 1, -18), 11, WHITE, MED)
      l.TextXAlignment = Enum.TextXAlignment.Center
      l.TextStrokeTransparency = 0.3
      b.MouseButton1Click:Connect(function() cur.c = k send() end)
      sw[k] = b
    end
    -- 战术号码
    label(panel, T("wsk.no"), UD2(0, 120, 0, 24), UD2(0, 12, 0, 122), 14)
    local tb = Instance.new("TextBox")
    tb.Name = "TacNo"
    tb.Size, tb.Position = UDim2.fromOffset(90, 28), UD2(0, 130, 0, 120)
    tb.BackgroundColor3, tb.BorderSizePixel = RGB(28, 32, 36), 0
    tb.Text, tb.PlaceholderText = cur.n and string.format("%03d", cur.n) or "", "213"
    tb.TextSize, tb.Font, tb.TextColor3 = 16, BOLD, WHITE
    tb.ClearTextOnFocus = false
    tb.Parent = panel
    tb.FocusLost:Connect(function()
      local n = tonumber(string.match(tb.Text or "", "%d+") or "")
      cur.n = n and math.clamp(n, 0, 999) or nil
      tb.Text = cur.n and string.format("%03d", cur.n) or ""
      send()
    end)
    -- 国徽
    local eb = Instance.new("TextButton")
    eb.Name = "Emblem"
    eb.Size, eb.Position = UDim2.fromOffset(160, 28), UD2(0, 240, 0, 120)
    eb.BackgroundColor3, eb.BorderSizePixel = RGB(40, 52, 46), 0
    eb.TextSize, eb.Font, eb.TextColor3 = 14, BOLD, WHITE
    eb.Parent = panel
    local function ebTxt() eb.Text = T(cur.e and "wsk.embOn" or "wsk.embOff") end
    ebTxt()
    eb.MouseButton1Click:Connect(function() cur.e = not cur.e ebTxt() send() end)
    label(panel, T("wsk.note"), UD2(1, -24, 0, 34), UD2(0, 12, 0, 160), 11, DIM, MED).TextWrapped = true
    local ok = Instance.new("TextButton")
    ok.Name = "Close"
    ok.Size, ok.Position = UDim2.fromOffset(100, 32), UD2(1, -112, 1, -44)
    ok.BackgroundColor3, ok.BorderSizePixel = RGB(52, 70, 58), 0
    ok.Text, ok.TextSize, ok.Font, ok.TextColor3 = T("wta2.close"), 14, BOLD, WHITE
    ok.Parent = panel
    ok.MouseButton1Click:Connect(close)
    redraw()
    if not saved[key] then send() end
  end
  G.closeSkin = close
  G.frameConn("WtSkin", function()
    if panel and G.S and G.S.alive then close() end
  end)
end

return WtSkin
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="294">
          <Properties>
            <string name="Name">WtSpawn</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——局内出击页（战雷的「重生界面」）
--   用户 11-28（给了战雷截图）：「被击毁重新召唤载具要有这个界面」——进局选第一辆、被打掉以后选下一辆都在这一页，不再回 3D 机库：
--   · 顶上一排出击阵容卡（车图、名字、战斗等级、乘员组号、这一局要多少 SP / 免费 / 备用 / 用完了 / 超出本局战斗等级）；
--     选中的那张上面一块琥珀色「加入战斗！」（点它直接出）
--   · 左栏：选中那一辆的出击设置——飞机 / 直升机：挂载方案、燃油量（几成 · 能飞几分钟）；地面车：按机库里配的弹出击；下面「任务目标」
--   · 右边：大地图（同小地图那张，挂过来；网格 A～J / 1～10，同 M 键大地图 WtMap.lua）
--   · 底下一条：数据统计（战况表）· 观战模式 · 退出战斗；右边大按钮「加入战斗！（重生次数：N）」，回车也是它
--   · 左上：模式 · 地图、阶段、剩余时间、我的 SP
--   什么时候出来：在局里（服务器推的 S.pick：这一局算他的、人还没出生）、阵亡镜头放完了、没开主菜单 / 设置 / 观战 / 战况表。
--   开着它的时候机库（TechUI.lua G.hangarSet）不出来；阵容、SP 规矩、能不能出全借机库那边（G.techLineup），出击发同一个 deployVeh
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local UIS = game:GetService("UserInputService")

local WtSpawn = {}

function WtSpawn.init(G)
  local TH = require(RS:WaitForChild("Theme"))
  local AD = require(RS:WaitForChild("AirDefs"))
  local TT = require(RS:WaitForChild("TechTree"))
  local me = Players.LocalPlayer
  local RGB, U2, V2 = Color3.fromRGB, UDim2, Vector2.new
  local function L(zh, en) return G.L(zh, en) end   -- 多语言（11-28）
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local mobile = UIS.TouchEnabled and not UIS.KeyboardEnabled
  local AMBER, TEXT, MUTE, FAINT, GOOD, BAD, GOLD = TH.C.WARN, TH.C.TEXT, TH.C.MUTE, TH.C.FAINT, TH.C.GOOD, TH.C.BAD, TH.C.WARN
  local function act(...)
    local args = table.pack(...)
    pcall(function() G.R.Act:FireServer(table.unpack(args, 1, args.n)) end)
  end

  local gui = Instance.new("ScreenGui")
  gui.Name = "WtSpawn"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 13   -- 机库（12）上面、观战（15）/ 设置（30）/ 阵亡效果（40）下面
  gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")
  G.wtSpawnGui = gui   -- 测试用

  local function frame(parent, size, pos, col, tr, name)
    local f = Instance.new("Frame")
    f.Size, f.Position = size, pos or U2.new()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = col or TH.C.PANEL, tr or 0, 0
    if name then f.Name = name end
    f.Parent = parent
    return f
  end
  local function text(parent, s, size, pos, ts, col, font, xa, name)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Text, t.Size, t.Position = s or "", size, pos or U2.new()
    t.TextSize, t.TextColor3, t.Font = ts or TH.S.body, col or TEXT, font or TH.F.body
    t.TextXAlignment = xa or Enum.TextXAlignment.Left
    t.TextStrokeTransparency = 0.7
    if name then t.Name = name end
    t.Parent = parent
    return t
  end
  local function btn(parent, s, size, pos, name, primary)
    local b = Instance.new("TextButton")
    b.AutoButtonColor = false
    b.Text = s
    b.Size, b.Position = size, pos or U2.new()
    b.Font = primary and TH.F.title or TH.F.bold
    b.TextSize = primary and TH.S.sub or TH.S.small
    b.TextColor3 = primary and RGB(24, 18, 8) or TEXT
    b.BackgroundColor3 = primary and AMBER or TH.C.RAISE
    b.BackgroundTransparency = primary and 0 or 0.15
    b.BorderSizePixel = 0
    if name then b.Name = name end
    b.Parent = parent
    TH.corner(b, 2)
    if primary then TH.grad(b, RGB(255, 214, 120), RGB(200, 132, 30)) else TH.stroke(b, false, TH.C.LINE).Transparency = 0.86 end
    b.MouseEnter:Connect(function() if not primary then b.BackgroundColor3 = RGB(48, 54, 60) end end)
    b.MouseLeave:Connect(function() if not primary then b.BackgroundColor3 = TH.C.RAISE end end)
    return b
  end

  -- 整页按 1280 × 720 画，窗口大了小了整体缩放（同机库）
  local root = frame(gui, U2.fromOffset(1280, 720), U2.fromScale(0.5, 0.5), RGB(0, 0, 0), 1, "Root")
  root.AnchorPoint = V2(0.5, 0.5)
  local scale = Instance.new("UIScale")
  scale.Parent = root
  local dim = frame(gui, U2.fromScale(1, 1), nil, RGB(6, 9, 12), 0.18, "Dim")   -- 背后的战场压暗
  dim.ZIndex = 0
  root.ZIndex = 1
  local function layout()
    local vs = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or V2(1280, 720)
    scale.Scale = math.max(0.5, math.min(vs.X / 1280, vs.Y / 720))
  end

  ---------------------------------------------------------------- 左上：这一局
  local info = text(root, "", U2.fromOffset(420, 18), U2.fromOffset(28, 14), TH.S.small, MUTE, TH.F.bold, nil, "Info")
  local info2 = text(root, "", U2.fromOffset(420, 18), U2.fromOffset(28, 32), TH.S.small, MUTE, TH.F.body, nil, "Info2")

  ---------------------------------------------------------------- 顶上一排出击阵容卡
  local CW, CH, CG = 168, 92, 8
  local row = frame(root, U2.fromOffset(5 * CW + 4 * CG, CH), U2.fromOffset(640 - (5 * CW + 4 * CG) / 2, 62), RGB(0, 0, 0), 1, "Lineup")
  local tab = btn(row, L("加入战斗！", "Join battle!"), U2.fromOffset(CW - 24, 22), U2.fromOffset(0, -24), "JoinTab", true)
  tab.TextSize = TH.S.small
  tab.ZIndex = 3
  local cards = {}

  ---------------------------------------------------------------- 左栏：这一辆的出击设置、任务目标
  local LX, LY, LW = 28, 172, 340
  local side = frame(root, U2.fromOffset(LW, 470), U2.fromOffset(LX, LY), TH.C.PANEL, 0.1, "Side")
  TH.corner(side, 2)
  TH.stroke(side)
  local selName = text(side, "", U2.new(1, -24, 0, 26), U2.fromOffset(12, 8), TH.S.title, TEXT, TH.F.title, nil, "SelName")
  local selSub = text(side, "", U2.new(1, -24, 0, 18), U2.fromOffset(12, 36), TH.S.small, MUTE, TH.F.body, nil, "SelSub")
  local opts = frame(side, U2.new(1, -24, 0, 250), U2.fromOffset(12, 64), RGB(0, 0, 0), 1, "Options")
  local objT = text(side, L("任务目标", "Mission objective"), U2.new(1, -24, 0, 20), U2.fromOffset(12, 322), TH.S.sub, TEXT, TH.F.bold, nil, "ObjTitle")
  local objList = frame(side, U2.new(1, -24, 0, 120), U2.fromOffset(12, 346), RGB(0, 0, 0), 1, "Objectives")

  ---------------------------------------------------------------- 右边：大地图
  local MX, MY = LX + LW + 36, LY
  local MS = 720 - MY - 64   -- 正方形
  local mapBox = frame(root, U2.fromOffset(MS, MS), U2.fromOffset(MX, MY), RGB(0, 0, 0), 0.2, "MapBox")
  TH.stroke(mapBox)
  local holder = frame(mapBox, U2.fromScale(1, 1), nil, RGB(0, 0, 0), 1, "Holder")
  holder.ClipsDescendants = true
  local grid = frame(mapBox, U2.fromScale(1, 1), nil, RGB(0, 0, 0), 1, "Grid")
  grid.ZIndex = 20
  local ROWS = { "A", "B", "C", "D", "E", "F", "G", "H", "I", "J" }
  for i = 1, 9 do
    frame(grid, U2.new(0, 1, 1, 0), U2.fromScale(i / 10, 0), RGB(255, 255, 255), 0.82).ZIndex = 20
    frame(grid, U2.new(1, 0, 0, 1), U2.fromScale(0, i / 10), RGB(255, 255, 255), 0.82).ZIndex = 20
  end
  for i = 1, 10 do   -- 行 A～J 在左边、列 1～10 在上边（战雷）
    text(mapBox, ROWS[i], U2.new(0, 20, 0.1, 0), U2.new(0, -22, (i - 1) / 10, 0), TH.S.small, MUTE, TH.F.bold, Enum.TextXAlignment.Center)
    text(mapBox, tostring(i), U2.new(0.1, 0, 0, 16), U2.new((i - 1) / 10, 0, 0, -18), TH.S.small, MUTE, TH.F.bold, Enum.TextXAlignment.Center)
  end

  ---------------------------------------------------------------- 底下一条
  local bar = frame(root, U2.fromOffset(1280 - 56, 40), U2.fromOffset(28, 720 - 52), RGB(0, 0, 0), 1, "Bar")
  local bStats = btn(bar, L("数据统计", "Statistics"), U2.fromOffset(124, 34), U2.fromOffset(0, 3), "Stats")
  local bSpec = btn(bar, L("观战模式", "Spectate"), U2.fromOffset(124, 34), U2.fromOffset(132, 3), "Spectate")
  local bLeave = btn(bar, L("退出战斗", "Leave battle"), U2.fromOffset(124, 34), U2.fromOffset(264, 3), "SpawnLeave")   -- 别叫 LeaveMatch：机库那个按钮叫这个
  local go = btn(bar, "", U2.fromOffset(330, 40), U2.new(1, -330, 0, 0), "SpawnGo", true)
  local goSub = text(go, "", U2.new(1, -16, 0, 12), U2.new(0, 8, 1, -13), TH.S.tiny, RGB(60, 42, 14), TH.F.bold, Enum.TextXAlignment.Center, "GoSub")
  go.TextYAlignment = Enum.TextYAlignment.Top
  local goPad = Instance.new("UIPadding")
  goPad.PaddingTop = UDim.new(0, 4)
  goPad.Parent = go
  local hint = text(root, L("回车 加入战斗 · Tab 战况", "Enter join · Tab scores"), U2.fromOffset(300, 14), U2.new(1, -328, 1, -66), TH.S.tiny, FAINT, TH.F.body, Enum.TextXAlignment.Right, "Hint")
  if mobile then hint.Visible = false end

  ---------------------------------------------------------------- 状态
  local on = false
  local lastClick = { key = nil, t = -9 }   -- 双击一张卡直接出（同战雷；单击会重画卡片，所以不记在卡上）
  local sel = nil        -- 选中的那一位：{ key, it, can, sp, ... }（G.techLineup 的一项）
  local lineSig = nil    -- 上次画卡片时的阵容、战况
  G.wtSpawnOn = function() return on end

  local function lineup()
    if not G.techLineup then return {}, 1 end
    local ok, list, si = pcall(G.techLineup)
    if not ok then return {}, 1 end
    return list or {}, si or 1
  end
  local function spawnsLeft(key)
    local w = G.S and G.S.wt
    if not w then return nil end
    local n = (w.ln and w.ln[key]) or 0
    return math.max(0, 1 + (w.backup or 1) - n)
  end

  -- 一个选项行：标题 + 一排小按钮（点一个就是它；当前的那个亮）
  local function optRow(y, title, choices, cur, onPick, name)
    text(opts, title, U2.new(1, 0, 0, 16), U2.fromOffset(0, y), TH.S.tiny, MUTE, TH.F.bold)
    local n = #choices
    local w = math.floor((LW - 24 - (n - 1) * 4) / math.max(n, 1))
    for i, c in ipairs(choices) do
      local b = btn(opts, c.label, U2.fromOffset(w, 28), U2.fromOffset((i - 1) * (w + 4), y + 18), (name or "Opt") .. "_" .. tostring(c.v))
      b.TextSize = TH.S.tiny
      b.TextWrapped = true
      local isCur = c.v == cur
      if isCur then
        b.BackgroundColor3, b.BackgroundTransparency = RGB(70, 58, 30), 0
        local st = b:FindFirstChildOfClass("UIStroke")
        if st then st.Color, st.Transparency = AMBER, 0.2 end
      end
      b.MouseButton1Click:Connect(function() if not isCur then onPick(c.v) end end)
    end
    return y + 52
  end

  local function fillOptions()
    for _, c in ipairs(opts:GetChildren()) do c:Destroy() end
    local it = sel and sel.it
    if not it then
      selName.Text = L("出击阵容是空的", "Lineup is empty")
      selSub.Text = ""
      return
    end
    selName.Text = sel.name or it.key
    local kind = (it.branch == "air") and L("战机", "Aircraft") or (it.branch == "heli") and L("直升机", "Helicopter") or L("地面车", "Ground vehicle")
    selSub.Text = kind .. "  ·  BR " .. (sel.br or "?")
    local a = (it.branch ~= "ground") and AD.get(it.play) or nil
    local y = 0
    if a and G.treeAirLoad and G.treeSaveLoad then
      local l, p, f = G.treeAirLoad(it)
      -- 挂载方案（这一型的预设；整备里改过的写「自定」）
      local ch = {}
      for _, pr in ipairs(a.presets or {}) do
        local nmp = T("preset." .. pr.key)
        if nmp == "preset." .. pr.key then nmp = pr.key end
        table.insert(ch, { v = pr.key, label = nmp })
      end
      if #ch > 4 then   -- 太多放不下一排：只列前四个（其余在机库整备里换）
        local keep = {}
        for i = 1, 4 do keep[i] = ch[i] end
        local hasCur = false
        for _, c in ipairs(keep) do if c.v == p then hasCur = true end end
        if not hasCur and p then
          for _, c in ipairs(ch) do if c.v == p then keep[4] = c end end
        end
        ch = keep
      end
      if #ch > 0 then
        y = optRow(y, L("挂载", "Loadout"), ch, p, function(v)
          local _, _, f0 = G.treeAirLoad(it)
          G.treeSaveLoad(it.key, AD.presetLoad(a, v), v, f0, true)
          fillOptions()
        end, "Preset")
      end
      -- 燃油量（几成 · 能飞几分钟，同战雷「62%（25 分）」）
      local fc = {}
      for _, fv in ipairs(AD.FUEL_OPTS or { 0.25, 0.5, 0.75, 1 }) do
        local mins = AD.fuelMin and AD.fuelMin(a, fv) or nil
        table.insert(fc, { v = fv, label = string.format("%d%%", math.floor(fv * 100 + 0.5)) .. (mins and (L("（", " (") .. mins .. L(" 分）", " min)")) or "") })
      end
      local fNow = AD.cleanFuel(f)
      local best, bd = nil, math.huge
      for _, c in ipairs(fc) do if math.abs(c.v - fNow) < bd then best, bd = c.v, math.abs(c.v - fNow) end end
      y = optRow(y, L("燃油量", "Fuel"), fc, best, function(v)
        local l2, p2 = G.treeAirLoad(it)
        G.treeSaveLoad(it.key, l2, p2, v, true)
        fillOptions()
      end, "Fuel")
      -- 挂载表（战雷的「挂载」窗口，LoadoutWin.lua；用户 11-28「飞机选挂载我还是没找到位置 你给我做成这样」）
      local lb = btn(opts, L("挂载表…（全部方案、每个挂点挂什么）", "Loadout table… (all presets)"), U2.new(1, 0, 0, 28), U2.fromOffset(0, y + 2), "OpenLoadout")
      lb.TextSize = TH.S.small
      lb.MouseButton1Click:Connect(function() if G.openLoadout then G.openLoadout(it.key) end end)
    else
      text(opts, L("弹药：按机库里配的出击", "Ammo: as loaded in the hangar"), U2.new(1, 0, 0, 18), U2.fromOffset(0, y), TH.S.small, MUTE, TH.F.bold)
    end
  end

  local function fillObjectives()
    for _, c in ipairs(objList:GetChildren()) do c:Destroy() end
    local S = G.S or {}
    local it = sel and sel.it
    local air = it and it.branch ~= "ground"
    local mine = me:GetAttribute("Side")
    local y = 0
    local first = air and L("☆ 协助地面部队，夺取制空权", "☆ Support ground forces, win air superiority")
      or L("☆ 占领并守住据点", "☆ Capture and hold the zones")
    text(objList, first, U2.new(1, 0, 0, 20), U2.fromOffset(0, y), TH.S.small, TEXT, TH.F.bold, nil, "Obj0")
    y += 24
    for _, p in ipairs(S.points or {}) do
      if y > 96 then break end
      local who, col = L("中立", "neutral"), MUTE
      if p.owner == mine then who, col = L("我方", "ours"), TH.C.FRIEND or GOOD
      elseif p.owner ~= nil and p.owner ~= "none" and p.owner ~= "" then who, col = L("敌方", "enemy"), TH.C.FOE or BAD end
      local where = ""
      local MP = G.Map and G.Map.POINTS
      if MP and G.mapGridRef then
        for _, q in ipairs(MP) do if q.id == p.id and q.x then where = "  " .. G.mapGridRef(q.x, q.z) end end
      end
      text(objList, string.format("%s %s · %s%s", L("据点", "Zone"), tostring(p.id), who, where), U2.new(1, 0, 0, 18), U2.fromOffset(12, y), TH.S.small, col, TH.F.body)
      y += 20
    end
  end

  local function fillTop()
    local S = G.S or {}
    local w = S.wt or {}
    local left = S.left and string.format("%d:%02d", math.floor(S.left / 60), math.floor(S.left % 60)) or "--:--"
    local mid = S.map or (G.Map and G.Map.id) or ""
    local mapN = T("map." .. mid .. ".name")
    if mapN == "map." .. mid .. ".name" then mapN = mid end
    info.Text = L("历史", "Realistic") .. ((mapN ~= "") and ("  ·  " .. mapN) or "")
    info2.Text = ((S.phase == "prep") and L("准备阶段", "Preparation") or L("交战中", "In battle")) .. L("  ·  剩余时间 ", "  ·  time left ") .. left
      .. "  ·  SP " .. tostring(w.sp or 0)
  end

  local function setGo()
    local key = sel and sel.key
    local left = key and spawnsLeft(key)
    go.Text = L("加入战斗！", "Join battle!") .. ((left ~= nil) and string.format(L("（重生次数：%d）", " (respawns: %d)"), left) or "")
    local can = sel ~= nil and sel.can == true
    go.BackgroundTransparency = can and 0 or 0.45
    go.TextColor3 = can and RGB(24, 18, 8) or RGB(80, 70, 50)
    goSub.Text = sel and ((sel.name or "") .. ((sel.sp and sel.sp ~= "") and ("  ·  " .. sel.sp) or "")) or L("阵容里没有能出的车", "Nothing to spawn")
    goSub.TextColor3 = (sel and not can) and RGB(150, 30, 20) or RGB(60, 42, 14)
    tab.Visible = can
  end

  local function buildCards()
    local list, si = lineup()
    for _, c in ipairs(cards) do c:Destroy() end
    table.clear(cards)
    sel = list[si]
    if not sel or sel.lock then   -- 选中的那位禁选：挑第一位能出的
      for i = 1, 5 do
        if list[i] and not list[i].lock then sel, si = list[i], i break end
      end
    end
    for i = 1, 5 do
      local c = list[i]
      local x = (i - 1) * (CW + CG)
      local card = Instance.new("TextButton")
      card.Name = c and ("Spawn_" .. c.key) or ("SpawnEmpty_" .. i)
      card.AutoButtonColor = false
      card.Text = ""
      card.Size, card.Position = U2.fromOffset(CW, CH), U2.fromOffset(x, 0)
      card.BackgroundColor3, card.BackgroundTransparency, card.BorderSizePixel = RGB(27, 31, 36), 0.08, 0
      card.Parent = row
      TH.corner(card, 2)
      table.insert(cards, card)
      local isSel = c ~= nil and sel ~= nil and c.key == sel.key
      if c and c.lock then card:SetAttribute("Locked", true) end   -- 禁选（还没出过地面车的飞机）
      if isSel then TH.glow(card) else TH.stroke(card, false, TH.C.LINE).Transparency = 0.84 end
      if c then
        local dead = c.can ~= true
        local bay = frame(card, U2.fromScale(1, 1), nil, RGB(255, 255, 255), dead and 0.8 or 0.35, "Bay")
        bay.ZIndex = 0
        TH.corner(bay, 2)
        if TH.rankGrad then TH.rankGrad(bay, c.it.rank) end
        local img = Instance.new("ImageLabel")
        img.Name = "Pic"
        img.BackgroundTransparency = 1
        img.ScaleType = Enum.ScaleType.Fit
        img.Size, img.Position = U2.new(1, -16, 1, -38), U2.fromOffset(8, 16)
        img.ImageTransparency = dead and 0.6 or 0
        img.Parent = card
        if G.techPicOn then pcall(G.techPicOn, img, c.it) end
        text(card, c.name or c.key, U2.new(1, -36, 0, 16), U2.fromOffset(6, 2), TH.S.small, dead and FAINT or TEXT, TH.F.bold, Enum.TextXAlignment.Left, "VehName")
        local br = text(card, c.br or "", U2.fromOffset(40, 16), U2.new(1, -44, 0, 2), TH.S.small, c.over and BAD or MUTE, TH.F.mono, Enum.TextXAlignment.Right, "Br")
        br.TextStrokeTransparency = 0.5
        text(card, "#" .. i, U2.fromOffset(24, 14), U2.new(0, 6, 1, -16), TH.S.tiny, FAINT, TH.F.mono, nil, "Slot")
        text(card, c.sp or "", U2.new(1, -36, 0, 14), U2.new(0, 30, 1, -16), TH.S.tiny, c.spC or MUTE, TH.F.bold, Enum.TextXAlignment.Right, "Sp")
        local slotI = i
        card.MouseButton1Click:Connect(function()
          if c.lock then return end
          if G.techSelectSlot then pcall(G.techSelectSlot, slotI) end
          lineSig = nil   -- 下一帧重画
        end)
        card.MouseButton1Down:Connect(function()   -- 双击直接出（同战雷）
          local t = os.clock()
          if lastClick.key == c.key and t - lastClick.t < 0.35 and c.can then act("deployVeh", c.key) end
          lastClick.key, lastClick.t = c.key, t
        end)
      else
        text(card, L("空位", "Empty"), U2.fromScale(1, 1), nil, TH.S.small, FAINT, TH.F.body, Enum.TextXAlignment.Center)
      end
      if isSel then tab.Position = U2.fromOffset(x + 12, -24) end
    end
    fillOptions()
    fillObjectives()
    setGo()
  end

  local function deploy()
    if sel and sel.can then act("deployVeh", sel.key) end
  end
  go.MouseButton1Click:Connect(deploy)
  tab.MouseButton1Click:Connect(deploy)
  bStats.MouseButton1Click:Connect(function() if G.boardToggle then G.boardToggle(true) end end)
  bSpec.MouseButton1Click:Connect(function() if G.wtSpecStart then G.wtSpecStart() end end)
  bLeave.MouseButton1Click:Connect(function() act("matchLeave") end)

  ---------------------------------------------------------------- 开、关
  local function wantOn()
    local S = G.S
    if not S or S.pick ~= true or S.alive then return false end
    if not (G.hangarActive and G.hangarActive()) then return false end
    if G.deathFxOn and G.deathFxOn() then return false end
    if G.menuShown and G.menuShown() then return false end
    if G.settingsShown and G.settingsShown() then return false end
    if G.wtSpectating and G.wtSpectating() then return false end
    if G.boardShown and G.boardShown() then return false end
    if S.phase == "end" then return false end
    return true
  end
  local function setOn(v)
    if v == on then return end
    on = v
    gui.Enabled = v
    if v then
      layout()
      lineSig = nil
      if G.mapMount then G.mapMount(holder, U2.fromScale(1, 1)) end
      if G.uiPop and not (G.reducedMotion and G.reducedMotion()) then G.uiPop(root, 0.97, true) end
    else
      local P = G.hudParts
      if G.mapMount and P then G.mapMount(P.miniClip or P.miniBox, U2.fromScale(1, 1)) end
    end
    if G.refresh then pcall(G.refresh) end   -- 机库跟着收 / 出（TechUI G.hangarSet 看 G.wtSpawnOn）
  end
  G.wtSpawnSet = function(v) setOn(v == true) end   -- 测试用

  UIS.InputBegan:Connect(function(io, gp)
    if not on or gp or UIS:GetFocusedTextBox() then return end
    if io.KeyCode == Enum.KeyCode.Return or io.KeyCode == Enum.KeyCode.KeypadEnter then deploy() end
  end)
  -- 战况表从这一页点开的：Esc 关上回到这一页
  UIS.InputBegan:Connect(function(io, gp)
    if gp then return end
    if io.KeyCode == Enum.KeyCode.Escape and G.boardShown and G.boardShown() and G.S and G.S.pick and G.boardToggle then G.boardToggle(false) end
  end)

  local acc = 0
  local function step(dt)
    acc += dt
    if acc < 0.1 then return end
    acc = 0
    setOn(wantOn())
    if not on then return end
    -- 阵容、战况（服务器一秒推两次 G.S）、语言变了才重画卡片
    local list, si = lineup()
    local S = G.S or {}
    local w = S.wt or {}
    local bits = { tostring(si), tostring(G.lang), tostring(w.sp), tostring(w.free), tostring(w.paid), tostring(S.phase) }
    for i = 1, 5 do
      local c = list[i]
      bits[#bits + 1] = c and (c.key .. ":" .. tostring(c.sp) .. ":" .. tostring(c.can)) or "-"
    end
    local sig = table.concat(bits, "|")
    if sig ~= lineSig then
      lineSig = sig
      buildCards()
    end
    fillTop()
  end
  if G.frameConn then G.frameConn("WtSpawn", step) else game:GetService("RunService").RenderStepped:Connect(step) end
  local cam = workspace.CurrentCamera
  if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() if on then layout() end end) end
end

return WtSpawn
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="295">
          <Properties>
            <string name="Name">WtTank</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——战雷式坦克界面（用户 11-24 夜「把整个游戏做成战雷」②：坦克战雷化）
--   电脑上开坦克时 VehHud 的 stepTank 每帧调 G.wtTankStep，原来 MWT 那套（右下全息车、六边形弹种钮、∧ 准星、车旁的车速牌）收起：
--   · 准星：炮现在指的地方一个圆（中心一点、左右下三道刻度），颜色就是战雷的穿深指示——照服务器 Wt.lua 同一套算
--     （WtDamage：瞄着的那一处几毫米、入射角换算的等效厚度、这种弹在这个距离的穿深、跳弹概率）：
--     绿 打得穿，黄 说不准（穿深和等效厚度差不多、或者可能跳弹），红 打不穿 / 会跳弹，没瞄着敌方车辆是白的；
--     圈外一道装填弧（顺时针走满就装好），左边剩几秒、右边测距
--   · 底部正中：弹药栏——主炮每种弹一格（数字键直接选，战雷那样）、机炮 / 机枪各一格，烟幕弹（M）、维修 / 灭火（Y）、望远镜（C）……；
--     每格一张写实弹种图（AmmoPics，Blender 按真弹渲的），选中琥珀描边 + 底边琥珀线，装填时底边进度条 + 剩几秒；打光了图去色、发数变红
--   · 左下（圆形小地图右边）：损伤示意图——俯视的车（车头朝上）：车体轮廓、履带、发动机、传动、弹药架、油箱，
--     炮塔跟着炮塔朝向转（炮管、炮闩、方向机、尾舱弹药在炮塔上）；乘员一个个小人在自己的位子上（白 好、橙 伤、灰 阵亡 / 空位）；
--     模块好的淡灰、受损黄、损毁红，刚坏的闪一下，起火的地方一团火；右边车速、档位，起火 / 维修中 / 按 Y 修的提示
local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")

local WtTank = {}

function WtTank.init(G)
  local W = require(RS:WaitForChild("WtDamage"))
  local VD = require(RS:WaitForChild("VehDefs"))
  local BAL = require(RS:WaitForChild("Ballistics"))
  local TM = require(RS:WaitForChild("TankMods"))   -- 爆反种类（穿深指示扣爆反，同服务器 Era.lua）
  local V2, UD2 = Vector2.new, UDim2.new
  local CF = CFrame.new
  local RGB = Color3.fromRGB
  local me = Players.LocalPlayer
  local cam = workspace.CurrentCamera
  local function T(k, ...) return G.T and G.T(k, ...) or k end
  local BOLD, MED = Enum.Font.BuilderSansMedium, Enum.Font.BuilderSans
  local MONO_F = Enum.Font.RobotoMono
  local LEFT, RIGHT = Enum.TextXAlignment.Left, Enum.TextXAlignment.Right
  local TH = G.Theme   -- 统一外观（docs/style.md）
  local WHITE, INK = TH.C.TEXT, TH.C.INK
  local PEN_OK, PEN_MAYBE, PEN_NO = TH.C.GOOD, TH.C.WARN, TH.C.BAD
  local AMBER = TH.C.WARN
  local M_OK, M_HURT, M_DEAD = TH.C.NEUTRAL, TH.C.WARN, TH.C.BAD
  local C_OK, C_HURT, C_DEAD = TH.C.TEXT, TH.C.WARN, TH.C.FAINT

  local gui = Instance.new("ScreenGui")
  gui.Name = "WtTank"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 5
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")

  local function frame(parent, size, pos, color, tr, anchor)
    local f = Instance.new("Frame")
    f.Size, f.Position, f.AnchorPoint = size, pos or UD2(), anchor or V2()
    f.BackgroundColor3, f.BackgroundTransparency, f.BorderSizePixel = color or WHITE, tr or 0, 0
    f.Parent = parent
    return f
  end
  local function label(parent, text, size, pos, ts, color, font, anchor, align)
    local l = Instance.new("TextLabel")
    l.Size, l.Position, l.AnchorPoint = size, pos or UD2(), anchor or V2()
    l.BackgroundTransparency = 1
    l.Text, l.TextSize, l.TextColor3, l.Font = text or "", ts or 13, color or WHITE, font or BOLD
    l.TextXAlignment = align or Enum.TextXAlignment.Center
    l.TextStrokeTransparency, l.TextStrokeColor3 = 0.45, INK   -- 沙地、天空这种亮背景上也看得清
    l.Parent = parent
    return l
  end
  local function round(f, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = r or UDim.new(0.5, 0)
    c.Parent = f
    return f
  end
  local function stroke(f, color, th, tr)
    local s = Instance.new("UIStroke")
    s.Color, s.Thickness, s.Transparency = color, th, tr or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = f
    return s
  end
  local function nk(t, v) return NumberSequenceKeypoint.new(t, v) end

  -- 平滑的进度弧（顺时针、从正上方起）：左右两半各裁一半，各自一个圆环描边，描边上的渐变一半透明、转渐变的角度就是走到哪
  --   （Roblox 没有画弧线的东西；转了角度的细方块拼的弧边缘有锯齿——用户 11-19 嫌像素感）
  local function progRing(parent, D, th, color)
    local o = { root = frame(parent, UD2(0, D, 0, D), UD2(0.5, 0, 0.5, 0), WHITE, 1, V2(0.5, 0.5)), g = {}, s = {} }
    for i = 1, 2 do   -- 1 右半、2 左半
      local clip = frame(o.root, UD2(0.5, 0, 1, 0), UD2(i == 1 and 0.5 or 0, 0, 0, 0), WHITE, 1)
      clip.ClipsDescendants = true
      local ring = round(frame(clip, UD2(2, -2 * th, 1, -2 * th), UD2(i == 1 and -1 or 0, th, 0, th), WHITE, 1))
      local s = stroke(ring, color, th, 0)
      local g = Instance.new("UIGradient")
      g.Transparency = NumberSequence.new({ nk(0, 0), nk(0.499, 0), nk(0.501, 1), nk(1, 1) })
      g.Parent = s
      o.g[i], o.s[i] = g, s
    end
    function o.set(k, col)
      local a = math.clamp(k, 0, 1) * 360
      -- 渐变方向转 a 度：方向反面那半个平面不透明——右半从正上方顺时针走到 a，过了半圈左半接着走
      o.g[1].Rotation = math.clamp(a, 0, 180)
      o.g[2].Rotation = math.clamp(a, 180, 360)
      if col then for _, s in ipairs(o.s) do s.Color = col end end
    end
    return o
  end

  ---------------------------------------------------------------- 准星（照战雷：大圈 = 鼠标 / 镜头瞄的地方，小圈 = 炮这一刻开火真打到的地方）
  --   用户 11-28「坦克准心不是有两个圈吗 中间还有个小十字去掉 然后 较大那个环改成鼠标光标的位置 跟战雷一样 中间那个小的是坦克炮口实际会打到的位置吧」：
  --   大圈钉在鼠标那点（屏幕正中、镜头瞄的地方），装填弧、测距、装填秒数跟着它；小圈跟着炮管（炮塔还没转过来时在外面，转到位滑进大圈里），
  --   小圈的颜色 = 打不打得穿，炮口被挡时小圈上画红叉。原来反着画：大圈在炮的落点、镜头那里一个小圈（VehHud 的 CamAim，战雷界面里收起）；
  --   大圈左右下三道刻度、中心那一点去掉
  local AIM = {}
  AIM.root = frame(gui, UD2(0, 90, 0, 90), UD2(0.5, 0, 0.5, 0), WHITE, 1, V2(0.5, 0.5))
  AIM.root.Name = "WtGunAim"
  AIM.scale = Instance.new("UIScale")
  AIM.scale.Parent = AIM.root
  -- 黑色的底：每一道白线后面垫一道半透明黑（亮沙地上白线会看不见）
  stroke(round(frame(AIM.root, UD2(0, 28, 0, 28), UD2(0.5, 0, 0.5, 0), WHITE, 1, V2(0.5, 0.5))), INK, 3.4, 0.62)
  AIM.ring = round(frame(AIM.root, UD2(0, 28, 0, 28), UD2(0.5, 0, 0.5, 0), WHITE, 1, V2(0.5, 0.5)))
  AIM.ringS = stroke(AIM.ring, WHITE, 1.6, 0.02)
  -- 小圈：炮真打到的地方（Drive gunImpact 的落点），颜色 = 打不打得穿
  AIM.gun = frame(gui, UD2(0, 24, 0, 24), UD2(0.5, 0, 0.5, 0), WHITE, 1, V2(0.5, 0.5))
  AIM.gun.Name = "WtGunMark"
  stroke(round(frame(AIM.gun, UD2(0, 11, 0, 11), UD2(0.5, 0, 0.5, 0), WHITE, 1, V2(0.5, 0.5))), INK, 3.8, 0.55)
  AIM.gunS = stroke(round(frame(AIM.gun, UD2(0, 11, 0, 11), UD2(0.5, 0, 0.5, 0), WHITE, 1, V2(0.5, 0.5))), WHITE, 2, 0.02)
  -- 炮口被挡（用户 11-27「坦克准心对标战雷」）：炮塔转到位了，这一发却会打在前面的坡 / 墙上——小圈上画一个红叉（Drive gunImpact 判的）
  AIM.block = frame(AIM.gun, UD2(0, 20, 0, 20), UD2(0.5, 0, 0.5, 0), WHITE, 1, V2(0.5, 0.5))
  AIM.block.Name = "WtGunBlocked"
  AIM.block.Visible = false
  for _, r in ipairs({ 45, -45 }) do
    local b = frame(AIM.block, UD2(0, 18, 0, 2), UD2(0.5, 0, 0.5, 0), PEN_NO, 0, V2(0.5, 0.5))
    b.Rotation = r
  end
  -- 装填弧：圈外一道大环（用户 11-25「坦克开炮后外面那个大环装弹是顺时针从红色变成绿色」）——从正上方顺时针走满，
  --   颜色跟着进度从红经琥珀变绿，装好那一下整圈绿亮一下再收；底下一道很淡的轨道
  AIM.track = stroke(round(frame(AIM.root, UD2(0, 48, 0, 48), UD2(0.5, 0, 0.5, 0), WHITE, 1, V2(0.5, 0.5))), INK, 3, 0.7)
  AIM.rel = progRing(AIM.root, 54, 3, PEN_NO)
  AIM.relT = label(AIM.root, "", UD2(0, 50, 0, 14), UD2(0.5, -36, 0.5, 0), 14, AMBER, BOLD, V2(1, 0.5), RIGHT)
  AIM.rng = label(AIM.root, "", UD2(0, 70, 0, 14), UD2(0.5, 36, 0.5, 0), 14, WHITE, BOLD, V2(0, 0.5), LEFT)
  local function relColor(k)   -- 装填进度 → 红 → 琥珀 → 绿
    k = math.clamp(k or 0, 0, 1)
    if k < 0.5 then return PEN_NO:Lerp(AMBER, k / 0.5) end
    return AMBER:Lerp(PEN_OK, (k - 0.5) / 0.5)
  end
  local readyT, wasReady = -9, true

  ---------------------------------------------------------------- 穿深指示：照服务器（Wt.lua G.wtShellHit）同一套算
  local rayP = RaycastParams.new()
  rayP.FilterType = Enum.RaycastFilterType.Exclude
  local function entOf(inst)
    local ents = workspace:FindFirstChild("Ents")
    while inst and inst.Parent and inst.Parent ~= ents do inst = inst.Parent end
    return (inst and inst.Parent == ents) and inst or nil
  end
  local wq = {}   -- 给 WtDamage 查弹的：{ ammo 弹种键, id 武器号, kind }（同服务器那份武器表认弹的办法）
  local function penColor(st, I)
    local dir = I.p - I.o
    if dir.Magnitude < 1 then return nil end
    local ex = { st.em }
    if me.Character then table.insert(ex, me.Character) end
    if G.viewFolder then table.insert(ex, G.viewFolder) end
    rayP.FilterDescendantsInstances = ex
    local res = workspace:Raycast(I.o, dir.Unit * (dir.Magnitude + 6), rayP)
    local em = res and entOf(res.Instance)
    if not em or em:GetAttribute("Wreck") or (em:GetAttribute("Hp") or 1) <= 0 then return nil end
    local tm = em:GetAttribute("Team")
    if tm == nil or tm == me:GetAttribute("Side") then return nil end
    local d = em:GetAttribute("WtC") and VD.get(em:GetAttribute("Model") or "")
    local root = em:FindFirstChild("Root")
    if not d or not root then return nil end
    local base = root.CFrame * CF(0, -d.H / 2, 0)
    local p = base:PointToObjectSpace(res.Position)
    local dv = base:VectorToObjectSpace(dir.Unit)
    local yaw = em:GetAttribute("Ty") or 0
    wq.ammo, wq.id, wq.kind = I.am or (BAL.GUN[I.wid or ""] or {})[1], I.wid, I.w and I.w.kind   -- 还没换过弹种：这门炮的默认弹
    local pen, a = W.pen(wq, (res.Position - I.o).Magnitude / W.M)
    -- 打在还没炸的爆反块上（用户 11-27 挑刺：客户端穿深没算爆反，T-72B3、T-90M 会把破甲弹显示成能打穿）：按这辆车的爆反种类打折，同服务器 Era.lua G.eraShell
    local v = G.views and G.views[em]
    local era = v and v.M and v.M.era
    if era then
      local onBlock = false
      for _, blk in ipairs(era) do
        if not blk.blown then
          for _, q in ipairs(blk.parts or {}) do if q == res.Instance then onBlock = true break end end
        end
        if onBlock then break end
      end
      if onBlock then
        local L = TM.eraOf(d.id)
        -- 爆反型号：这辆车挂的（模型属性 Mods 的 era，同服务器 Era.lua G.eraSetup；11-27 起 96B 出厂也是 FY-4），没有才按模型自带的
        local mm = TM.decode(em:GetAttribute("Mods") or "")
        local kind = TM.ERA[mm.era or ""] or (L and TM.ERA[L.kind]) or TM.ERA.fy2
        local amA = BAL.AMMO[wq.ammo or ""]
        local mult
        if (I.w and I.w.kind == "atgm") or (amA and amA.cls == "atgm") then
          mult = W.singleCharge(wq) and kind.k or (kind.kt or kind.k)   -- 反坦克导弹、炮射导弹：单装药按 k、串联按 kt（同服务器 Era.lua G.eraBlast）
        else
          mult = (amA and amA.ce) and kind.k or kind.ke
        end
        if mult and mult < 1 then pen = pen * ((a.t == "ce" and a.tandem) and math.max(mult, 0.85) or mult) end
      end
    end
    local zone, face, weak, n, _, dq = W.where(d, p, dv, yaw)
    local ang = math.deg(math.acos(math.clamp(-dq:Dot(n), -1, 1)))
    local eff = W.effective(W.armor(d, zone, face, a.t) * weak, ang, a.t)
    local rp = W.ricochet(a.t, ang)
    if pen < eff * 0.92 or rp >= 0.6 then return PEN_NO end
    if pen >= eff * 1.12 and rp < 0.15 then return PEN_OK end
    return PEN_MAYBE
  end

  ---------------------------------------------------------------- 底部正中：弹药栏
  -- 用户 11-27 晚：「我需要你完全按照战雷的风格去做设计 而不是这种卡通风格……更拟真」（嫌上一版的单色剪影还是卡通）——
  --   弹种图换成写实渲染图（ReplicatedStorage.AmmoPics，tools/models/ammopics_blender.py：Blender 按真弹的结构建模、照实物涂装，
  --   真材质：黄铜、钢、可燃药筒、黑弹托……）：横放、弹头朝右、弹尖压在格子右边 6 像素，药筒往左伸出格子、最后 16 像素 UIGradient 渐隐；
  --   同一门炮的弹一个毫米 → 像素比例（M1028 就是比 M829A3 短、榴弹就是比穿甲弹粗），整排像一张弹药识别图；
  --   机枪格是一小段弹链，工具格（烟幕弹、扳手 / 灭火器、望远镜、电台话筒、激光测距仪）也是实物渲染，同一套光。
  --   用不了 EditableImage（游戏设置没开 Mesh / Image API）时退回单色剪影（icon）。
  --   界面骨架零装饰：格子平涂深色半透明底 + 1 像素细线、小圆角，不要玻璃渐变、不抬起；
  --   三组：主炮弹 | 机枪 / 其他武器 | 工具，组间一道细竖线，不要整排的底板；
  --   字只用 Theme.S 的字号，战场字黑描边：右上发数（等宽 15）、左上 12 × 12 键位框（等宽 12 灰）、选中那格左下类型（窄体 12）、
  --   右下冷却秒数（等宽 12）；整排上方名牌写这一发的全称（窄体 15 白「M829A3」+ 13 灰「· APFSDS-T」），装填时右边「装填 4.1 s」。
  --   颜色只表示状态（白、灰、琥珀、红，不用蓝）：选中（下一发装这种）琥珀细描边；装好了键位框右边一个 4 像素白点；
  --   装填中底边一道琥珀进度条从左往右匀速走、图压暗到八成，装好 120 毫秒内图回来；
  --   打空：图去色、35% 不透明、发数红 0，按它的键描边红闪两下、名牌写「无弹」；冷却：暗遮罩从上往下退 + 灰色秒数；
  --   主炮坏了（炮长阵亡 / 炮闩炮管损毁）：图 25%、发数变暗、键位框变暗，名牌右边一次红字「主炮损坏」；补给：发数每加 1 白闪 80 毫秒。
  --   动效 80～150 毫秒（线性），不跳、不缩放、不抬升、不循环闪；整排出现时淡入 150 毫秒
  -- 11-27 美术审查（17 条）以后：
  --   · 状态信号去重：「选中」和「膛内」在这个游戏里永远是同一格（换弹种就重新装填）——左边白竖条、平时的底边琥珀线去掉，
  --     底边线只在装填 / 维修时当进度条；装填秒数只写在名牌右边（格子里不再重复）；装填压暗六成 → 八成（DTC10 不再成一团泥）
  --   · 格子不挤：没选中的格子不写类型（名牌上有），图区 34 → 40 高、从 y 10 起，键位框 14 → 12；
  --     名牌后面垫一条两端渐隐的暗底（亮地面上浅灰字看得清；描边照规范 0.45）
  --   · 去掉图后面那块横向柔光（上下是硬边的一条亮横带）：渲染里加了一盏下后方的轮廓光，黑件的上下沿都勾出来了
  --   · 带药筒的左边 16 像素「先压暗、后透明」：颜色在 16 像素内从 0.25 灰到白、透明度只在最左 4 像素里从 1 到 0（读起来是药筒伸进阴影，不是雾）
  --   · 图两套：屏幕（逻辑像素）高 ≥ 850 用 2 倍图（1080p：正好 2:1；Retina Mac 1470 × 956 这类：接近 1:1），更矮的用 1 倍
  --     （1280 × 720、1366 × 768 这类低分屏格子只有 78 像素宽，2 倍图要缩 2.4 倍，没有 mipmap 时细杆断线、字成噪点）——
  --     Roblox 不给脚本看屏幕的 DPI 缩放，只能按逻辑屏高估
  --   · 上车时按格子排队解图（HudArt G.ammoPicPump：每帧一张，彩色的先、去色的后），整排都解好了才一起显示；
  --     有一格解不出 / 没有图就整排退回剪影（不混着）；只有 EditableImage 建不出来才算用不了，换车再试一次
  --   · 每帧只在值变了的时候才写属性（put；名牌的字串也只在内容变了时才拼）——M3 上省下每格每帧二十来次属性写入
  -- 11-27 美术审查第二轮以后：
  --   · 主炮坏了只说一次：原来 5 个弹种格都把发数换成红字「损坏」（左下损伤图、「按 Y 维修」也在说）——格子里发数照写
  --     （FAINT、透明 0.4），图照样压到 25%、键位框变暗；只在名牌这一行右边（装填秒数的位置）写一次红色「主炮损坏」
  --   · 装填秒数只说一次：车外的准星在屏幕上时它自己写着秒数 + 琥珀弧，名牌右边就不写；开镜、望远镜里没有那个准星
  --     （瞄准镜里只有一个装好的小方块），名牌照写
  --   · 换分辨率不闪：窗口跨过逻辑高 850（Mac 在窗口和全屏之间切）时，旧的那套图先留着显示，新的一套在后台每帧解一张，
  --     全解好了一起换（原来整排先清掉、约 18 帧后才淡入回来）
  local AW, AH, TW = 96, 60, 60      -- 弹种 / 机枪格、工具格（按 1080p 的像素，整排再按屏幕高缩放，layout）
  local GAP, GRP = 4, 10             -- 格间距；组之间各空 10 像素、中间一道 1 像素的线
  local PLATE = 22                   -- 名牌那一行
  local IMG_Y, IMG_H = 10, 40        -- 图区：x 0～92（工具格 2～58）、y 10～50（弹轴压在 y 30）
  local KEY = 12                     -- 键位框
  local COND_F = (TH.F and TH.F.cond) or MED
  local SZ = TH.S or { tiny = 12, small = 13, body = 15 }
  local MUTE, FAINT = TH.C.MUTE, TH.C.FAINT
  local ICON = TH.C.TEXT
  local BAR = frame(gui, UD2(0, 0, 0, AH + PLATE), UD2(0.5, 0, 1, -16), WHITE, 1, V2(0.5, 1))
  BAR.Name = "WtAmmoBar"
  local barScale = Instance.new("UIScale")
  barScale.Parent = BAR
  local dividers = {}
  local function divider(k)
    local dv = dividers[k]
    if not dv then
      dv = frame(BAR, UD2(0, 1, 0, AH - 16), UD2(0, 0, 1, -8), WHITE, 0.85, V2(0.5, 1))
      dv.Name = "Divider"
      dividers[k] = dv
    end
    return dv
  end
  -- 只在值变了时才写（每帧每格二十来个属性，大多数帧里都没变）：c 是这个东西自己的「上次写的值」表
  local function put(c, key, obj, prop, v)
    if c[key] ~= v then
      c[key] = v
      obj[prop] = v
    end
  end
  -- 名牌：这一发的全称；右边装填剩几秒；后面垫一条两端渐隐的暗底（亮地面上也看得清）
  local plateBg = frame(BAR, UD2(0, 0, 0, 20), UD2(0, -8, 0, -1), TH.C.PANEL, 0.5)
  plateBg.Name = "PlateBg"
  do
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new({ nk(0, 1), nk(0.08, 0), nk(0.92, 0), nk(1, 1) })
    g.Parent = plateBg
  end
  local ammoName = label(BAR, "", UD2(0, 420, 0, 18), UD2(0, 2, 0, 0), SZ.body, TH.C.TEXT, COND_F, V2(0, 0), LEFT)
  ammoName.Name = "AmmoName"
  ammoName.RichText = true
  ammoName.ZIndex = 2
  local loadTxt = label(BAR, "", UD2(0, 140, 0, 18), UD2(0, 0, 0, 0), SZ.small, AMBER, MONO_F, V2(1, 0), RIGHT)
  loadTxt.Name = "LoadTime"
  loadTxt.ZIndex = 2
  local plateC = {}   -- 名牌这一行上次写的值（put）
  local function hex(c) return string.format("%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end
  local MUTE_HEX = hex(MUTE)
  -- 型号（名牌）；类型（名牌「· 类型」）和每格左下的短类型按弹种（Ballistics.kindOf）、照现在的语言写（Lang 的 ammo.t / ammo.s：
  --   用户 11-28「目前局内我分辨不出来弹种 这些还是根据语言改变吧 比如我选了中文 穿甲弹就要写上」）；下表只用第一项（型号），没写的弹按 Ballistics.desig
  local AMMO_INFO = {
    m829a3 = { "M829A3", "APFSDS-T", "APFSDS" }, m830 = { "M830", "HEAT-MP-T", "HEAT-MP" }, m830a1 = { "M830A1", "MPAT", "MPAT" },
    m1028 = { "M1028", "Canister", "CAN" }, m900 = { "M900", "APFSDS-T", "APFSDS" }, m456 = { "M456A2", "HEAT-T", "HEAT" },
    m833 = { "M833", "APFSDS-T", "APFSDS" }, m392 = { "M392A2", "APDS-T", "APDS" }, m409 = { "M409", "HEAT-MP-T", "HEAT-MP" },
    dm53 = { "DM53", "APFSDS-T", "APFSDS" }, dm33 = { "DM33", "APFSDS-T", "APFSDS" }, dm12 = { "DM12", "HEAT-MP-T", "HEAT-MP" },
    dm13 = { "DM13", "APDS-T", "APDS" }, dm33l7 = { "DM33 (105)", "APFSDS-T", "APFSDS" }, dm12h = { "DM12 (105)", "HEAT-T", "HEAT" },
    dtc10 = { "DTC10-125", "APFSDS", "APFSDS" }, heat125 = { "125 mm", "HEAT-FS", "HEAT-FS" }, he125 = { "125 mm", "HE-FRAG", "HE-FRAG" },
    bm60 = { "3BM60 Svinets-2", "APFSDS", "APFSDS" }, bm42 = { "3BM42 Mango", "APFSDS", "APFSDS" }, bm22 = { "3BM22 Zakolka", "APFSDS", "APFSDS" },
    bm15 = { "3BM15", "APFSDS", "APFSDS" }, bk31 = { "3BK31", "HEAT-FS (tandem)", "HEAT-FS" }, bk18m = { "3BK18M", "HEAT-FS", "HEAT-FS" },
    of26 = { "3OF26", "HE-FRAG", "HE-FRAG" }, refleks = { "9M119M Refleks", "ATGM", "ATGM" },
    br412d = { "BR-412D", "APBC-T", "APBC" }, bk5m = { "BK-5M", "HEAT-FS", "HEAT-FS" }, of412 = { "OF-412", "HE-FRAG", "HE-FRAG" },
    apfsds69 = { "100 mm", "APFSDS", "APFSDS" },
  }
  local function ammoInfo(k)
    local a = BAL.AMMO[k]
    local kd = BAL.kindOf and BAL.kindOf(k)
    local ty = kd and T("ammo.t." .. kd) or ""
    local tag = kd and T("ammo.s." .. kd) or ((a and a.sym) or "")
    if a and a.cls == "jet" then   -- 游戏里的「金属射流弹」：按口径叫
      local cal = string.match(k, "%d+") or ""
      return T("wtt.jet", cal), ty, tag
    end
    local i = AMMO_INFO[k]
    if i then return i[1], ty, tag end
    return (BAL.desig and BAL.desig(k)) or (a and a.name) or k, ty, tag
  end
  G.ammoInfo = ammoInfo   -- 型号、类型、短类型（测试、别的界面用）
  local slots = {}
  -- 后备图标（用不了 EditableImage 时）：单色剪影，横着放、弹头朝右，画在图片区正中 46 × 18 的一块里；b(x, y, w, h, 透明, 圆角, 转角) 以这块的中心为原点
  local function icon(box, kind)
    box:ClearAllChildren()
    local function b(x, y, w, h, tr, r, rot)
      local f = frame(box, UD2(0, w, 0, h), UD2(0.5, x, 0.5, y), ICON, tr or 0, V2(0.5, 0.5))
      f.ZIndex = 2
      if r then round(f, (r == true) and UDim.new(0.5, 0) or UDim.new(0, r)) end
      if rot then f.Rotation = rot end
      return f
    end
    local function ring(x, y, dd, th)   -- 空心圆（细线）
      local f = round(frame(box, UD2(0, dd, 0, dd), UD2(0.5, x, 0.5, y), ICON, 1, V2(0.5, 0.5)))
      f.ZIndex = 2
      stroke(f, ICON, th or 1.5, 0)
      return f
    end
    local function dark(x, y, w, h)   -- 剪影上挖一道（弹带、钨珠）：底板色
      local f = frame(box, UD2(0, w, 0, h), UD2(0.5, x, 0.5, y), TH.C.PANEL, 0.1, V2(0.5, 0.5))
      f.ZIndex = 3
      return f
    end
    if kind == "ap" then   -- 尾翼稳定脱壳穿甲弹：细长杆、三瓣弹托、尾翼
      b(1, 0, 32, 2)
      b(17.5, 0, 3, 3, nil, nil, 45)
      b(-3, 0, 10, 7, 0.35, 1)
      b(-14, -2.6, 6, 1.6, nil, nil, -32)
      b(-14, 2.6, 6, 1.6, nil, nil, 32)
      b(-16.5, 0, 1.6, 7)
    elseif kind == "heat" or kind == "mpat" or kind == "jet" then   -- 破甲 / 多用途 / 射流：弹体、圆头、炸高探针、尾翼
      b(-3, 0, 16, 7, nil, 1)
      b(6.5, 0, 7, 6, nil, 3)
      b(13.5, 0, 8, 1.6)
      b(18, 0, 3, 3, nil, true)
      b(-13.5, 0, 3, 10, 0.25, 1)
      if kind == "mpat" then b(13, 0, 2, 4) end      -- 多用途：探针上的近炸环
      if kind == "jet" then dark(-1, 0, 1.5, 7) end  -- 串联：前后两级装药中间一道
    elseif kind == "he" then   -- 杀爆弹：弹体、卵形头、引信、弹带
      b(-3, 0, 20, 8, nil, 2)
      b(8.5, 0, 9, 6.5, nil, 3.2)
      b(14, 0, 3.5, 3, nil, 1)
      dark(-8, 0, 2, 8)
    elseif kind == "can" then   -- 霰弹：平头圆筒、一排钨珠
      b(0, 0, 24, 9, nil, 1)
      for k2 = -1, 1 do dark(k2 * 6 + 3, 0, 2.5, 2.5) end
    elseif kind == "sam" then   -- 导弹：弹体、头、前后两组翼
      b(0, 0, 28, 3, nil, 1.5)
      b(15, 0, 4, 4, nil, true)
      b(7, 0, 2, 8, 0.2)
      b(-11, 0, 3, 10, 0.2)
    elseif kind == "ac" then   -- 机炮弹：两发
      for _, y in ipairs({ -3.5, 3.5 }) do
        b(-4, y, 13, 4.5, nil, 1)
        b(5.5, y, 7, 3.8, nil, 1.9)
      end
    elseif kind == "mg" then   -- 机枪弹：一排三发
      for _, y in ipairs({ -5, 0, 5 }) do
        b(-3, y, 11, 2.8, nil, 1)
        b(4.5, y, 5, 2.6, nil, 1.3)
      end
    elseif kind == "smoke" then   -- 烟幕弹：发射筒 + 三团烟（淡）
      b(-7, 0, 11, 9, nil, 1)
      b(-1, 0, 2, 7)
      b(5, -2, 8, 8, 0.45, true)
      b(10, 1.5, 7, 7, 0.58, true)
      b(4.5, 3.5, 6, 6, 0.66, true)
    elseif kind == "scout" or kind == "bino" then   -- 侦察、车长望远镜：望远镜（两个细线圆 + 中间连接）
      ring(-6, 1, 11)
      ring(6, 1, 11)
      b(0, -1, 4, 3)
      b(-6, -6, 5, 3, 0.3, 1)
      b(6, -6, 5, 3, 0.3, 1)
    elseif kind == "arty" then   -- 火炮支援：野战电台话筒（同写实图：弯手柄、两头朝下的听筒 / 话筒、背上的按讲键；原来画的是准星，两套图意思不一样）
      b(0, -2.5, 24, 3.4, nil, 1.7)
      b(-12, 1.5, 7, 6.5, nil, 2, -14)
      b(12, 1.5, 6, 5.5, nil, 2, 14)
      b(0, -5.5, 8, 2, 0.3, 1)
    elseif kind == "ext" then   -- 灭火器
      b(-2, 1, 16, 7, nil, 2)
      b(7.5, -2.5, 6, 2)
      b(4, -5, 4, 2)
    else   -- 维修：扳手（斜着的柄 + 开口的头）
      b(-2, 2, 22, 3, nil, 1.5, -35)
      local hd = ring(8, -6, 8, 2.2)
      hd.Rotation = -35
      dark(10.5, -8.5, 3.5, 3.5)
    end
  end
  local function newSlot(i)
    local s = {}
    s.f = round(frame(BAR, UD2(0, AW, 0, AH), UD2(0, 0, 1, 0), TH.C.PANEL, 0.35, V2(0, 1)), UDim.new(0, TH.R or 2))
    s.f.Name = "Slot" .. i
    s.f.ClipsDescendants = true
    s.st = stroke(s.f, WHITE, 1, 0.85)
    -- （原来图后面一块 88 × 34 的横向柔光：上下是硬边的一条亮横带——去掉，黑件靠渲染里下后方那盏轮廓光勾边）
    s.img = Instance.new("ImageLabel")
    s.img.Name = "Pic"
    s.img.BackgroundTransparency = 1
    s.img.BorderSizePixel = 0
    s.img.Size, s.img.Position = UD2(0, 92, 0, IMG_H), UD2(0, 0, 0, IMG_Y)
    s.img.ZIndex = 2
    s.img.Visible = false
    s.img.Parent = s.f
    -- 药筒往左伸出格子：最左边 16 像素「先压暗、后透明」——颜色从 0.25 灰过到白（药筒伸进阴影里），
    --   透明度只在最左 4 像素里从 1 到 0（原来浅色药筒整段透明渐隐，读成一团往左淡出的白雾）；图不伸出去的（125 毫米分装弹、工具）关掉
    s.imgFade = Instance.new("UIGradient")
    do
      local e, f = 16 / 92, 4 / 92
      local g0 = Color3.new(0.25, 0.25, 0.25)
      s.imgFade.Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, g0), ColorSequenceKeypoint.new(e * 0.5, g0:Lerp(WHITE, 0.62)),
        ColorSequenceKeypoint.new(e, Color3.new(1, 1, 1)), ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)) })
      s.imgFade.Transparency = NumberSequence.new({ nk(0, 1), nk(f * 0.5, 0.4), nk(f, 0), nk(1, 0) })
    end
    s.imgFade.Enabled = false
    s.imgFade.Parent = s.img
    s.ic = frame(s.f, UD2(0, 46, 0, 18), UD2(0, 46, 0, IMG_Y + IMG_H / 2), WHITE, 1, V2(0.5, 0.5))   -- 后备：单色剪影
    s.ic.Name = "Icon"
    s.mask = frame(s.f, UD2(1, 0, 0, 0), UD2(0, 0, 1, 0), TH.C.PANEL, 0.3, V2(0, 1))   -- 冷却：暗遮罩，从上往下退
    s.mask.Name = "Cooldown"
    s.mask.ZIndex = 3
    s.mask.Visible = false
    s.keyBox = frame(s.f, UD2(0, KEY, 0, KEY), UD2(0, 4, 0, 4), WHITE, 1)
    s.keyBox.ZIndex = 4
    s.keyS = stroke(s.keyBox, MUTE, 1, 0)
    s.key = label(s.keyBox, "", UD2(1, 0, 1, 0), nil, SZ.tiny, MUTE, MONO_F)
    s.key.ZIndex = 4
    s.rdy = round(frame(s.f, UD2(0, 4, 0, 4), UD2(0, 4 + KEY + 4, 0, 4 + KEY / 2), WHITE, 0, V2(0, 0.5)))   -- 装好了：键位框右边一个白点
    s.rdy.Name = "Ready"
    s.rdy.ZIndex = 4
    s.rdy.Visible = false
    s.nBg = frame(s.f, UD2(0, 28, 0, 16), UD2(1, -3, 0, 2), WHITE, 1, V2(1, 0))   -- 补给：发数后面白闪一下
    s.nBg.ZIndex = 4
    s.n = label(s.f, "", UD2(0, 46, 0, 16), UD2(1, -6, 0, 2), SZ.body, WHITE, MONO_F, V2(1, 0), RIGHT)
    s.n.ZIndex = 5
    s.tag = label(s.f, "", UD2(1, -10, 0, 13), UD2(0, 6, 1, -4), SZ.tiny, TH.C.TEXT, COND_F, V2(0, 1), LEFT)   -- 弹种短名（每格都写，选中的白）
    s.tag.Name = "Tag"
    s.tag.ZIndex = 4
    s.tag.Visible = false
    s.tm = label(s.f, "", UD2(0, 40, 0, 13), UD2(1, -6, 1, -4), SZ.tiny, MUTE, MONO_F, V2(1, 1), RIGHT)   -- 冷却秒数
    s.tm.Name = "Secs"
    s.tm.ZIndex = 4
    s.line = frame(s.f, UD2(1, 0, 0, 2), UD2(0, 0, 1, 0), WHITE, 0.85, V2(0, 1))   -- 底边：装填 / 维修的进度条（平时不画）
    s.line.Name = "Line"
    s.line.ZIndex = 4
    s.line.Visible = false
    s.fill = frame(s.line, UD2(0, 0, 1, 0), nil, AMBER, 0)
    s.fill.ZIndex = 4
    s.kind, s.pic = nil, nil
    s.selK, s.bri, s.emptyT, s.nFlashT, s.lastN = 0, 1, -9, -9, nil
    s.c = {}   -- put：每个属性上次写的值
    s.x = 0
    slots[i] = s
    return s
  end

  -- 这辆车的弹药栏：主炮每种弹一格，别的武器一格，再加烟幕弹、维修 / 灭火
  local slotDef, slotKey = {}, nil
  local loadX = 0   -- 名牌右边「装填」写到哪（武器那几组的右边）
  -- 带了哪几种弹：服务器 Wt.lua 的 AmL 把这门炮所有弹种都写上（没带的 0 发）——出车以后出现过大于 0 发的就算带了（补给多出来的也算）
  local carriedBy = setmetatable({}, { __mode = "k" })   -- [车模型] = { [弹种] = true }
  local amlSeen = setmetatable({}, { __mode = "k" })     -- [车模型] = 上次解析过的 AmL 字串（没变就不再 gmatch：每帧都要问）
  local function carriedOf(em)
    if not em then return nil end
    local L = em:GetAttribute("AmL")
    if type(L) ~= "string" or L == "" then return nil end
    local c = carriedBy[em]
    if not c then
      c = {}
      carriedBy[em] = c
    end
    if amlSeen[em] ~= L then
      amlSeen[em] = L
      for k, n in string.gmatch(L, "([%w_]+):(%d+)") do if tonumber(n) > 0 then c[k] = true end end
    end
    return c
  end
  G.wtCarried = carriedOf   -- Drive 的 ammoList（Q 换弹）也只在带了的里面转
  -- 11-27 用户：「训练场有时候显示按4是切换射流 但是实际上切换不了」「如果我没有携带 就不要显示了吧」——这门炮的弹种原来全列出来、按位置编号，
  --   可车上只能打研究过的前 ModAmmo 种、带了的那几种（Drive ammoList / 服务器 Armor.lua 只认这些），按了换不过去。
  --   现在：没研究的、没带的不显示；剩下的弹和武器从 1 往下连着编（打光了的那格还在，发数红）
  local lastBuild = {}   -- 上一帧的（车型、研究到第几种、AmL 字串）：都没变就直接用排好的格子（不每帧拼键、排序）
  local function buildSlots(d, st)
    local em = st and st.em
    local nAm = em and em:GetAttribute("ModAmmo")
    local aml = em and em:GetAttribute("AmL")
    if lastBuild.d == d and lastBuild.nAm == nAm and lastBuild.aml == aml and lastBuild.em == em and slotKey then return slotDef end
    lastBuild.d, lastBuild.nAm, lastBuild.aml, lastBuild.em = d, nAm, aml, em
    nAm = (type(nAm) == "number") and math.max(1, nAm) or nil
    local car = carriedOf(em)
    local carKeys = {}
    for k in pairs(car or {}) do table.insert(carKeys, k) end
    table.sort(carKeys)
    local key = d.id .. ":" .. table.concat(d.weapons or {}, ",") .. ":" .. tostring(nAm) .. ":" .. table.concat(carKeys, "+")
    if slotKey == key then return slotDef end
    slotKey = key
    slotDef = {}
    for wi, wid in ipairs(d.weapons or {}) do
      local w = VD.W[wid]
      local list = BAL.GUN[wid]
      if list then
        for ai, k in ipairs(list) do
          local a = BAL.AMMO[k]
          local cls = a and a.cls or "ap"
          local usable = (nAm == nil or ai <= nAm) and (car == nil or car[k] == true)
          if usable then
            local _, _, tag = ammoInfo(k)
            table.insert(slotDef, { k = "am", wi = wi, wid = wid, am = k, icon = (cls == "atgm") and "sam" or cls, tag = tag })
          end
        end
      elseif w then
        local ic = (w.kind == "gun") and "mg" or ((w.kind == "sam" or w.kind == "atgm") and "sam" or ((w.kind == "arty" or (w.dmg or 0) >= 300) and "he" or "ac"))
        local tg = T((w.kind == "atgm") and "ammo.s.atgm" or ("ammo.w." .. ic))   -- 机枪 / 机炮 / 防空导弹 / 榴弹：也按语言
        table.insert(slotDef, { k = "w", wi = wi, wid = wid, icon = ic, tag = tg })
      end
    end
    for i, sd in ipairs(slotDef) do sd.num = (i <= 6) and i or nil end
    table.insert(slotDef, { k = "smoke", icon = "smoke", keyTxt = "M" })   -- 11-25 起烟幕是 M（X 是按住透视自己的车）
    table.insert(slotDef, { k = "fix", icon = "fix", keyTxt = "Y" })
    table.insert(slotDef, { k = "bino", icon = "bino", keyTxt = "C" })   -- 车长望远镜（用户 11-27，Drive / GunSight）
    if d.cat == "apc" or d.cat == "aa" then table.insert(slotDef, { k = "scout", icon = "scout", keyTxt = "G" }) end   -- 轻型车才能侦察（战雷）
    if d.cat ~= "aa" then table.insert(slotDef, { k = "arty", icon = "arty", keyTxt = "K" }) end   -- 防空车不能叫火炮
    for i = #slots + 1, #slotDef do newSlot(i) end
    -- 排：主炮弹 | 机枪 / 其他武器 | 工具，组间各空 10 像素、中间一道细线
    local x, prevG, nDiv = 0, nil, 0
    loadX = 0
    for i, s in ipairs(slots) do
      local sd = slotDef[i]
      s.f.Visible = sd ~= nil
      if sd then
        local grp = (sd.k == "am") and 1 or ((sd.k == "w") and 2 or 3)
        local wide = grp ~= 3
        if prevG and grp ~= prevG then
          local edge = x - GAP
          nDiv += 1
          local dv = divider(nDiv)
          dv.Visible = true
          dv.Position = UD2(0, edge + GRP + 0.5, 1, -8)
          x = edge + GRP * 2 + 1
        end
        prevG = grp
        s.kind, s.pic = nil, nil   -- 换车：下一帧重新装图
        s.img.Visible, s.ic.Visible = false, false
        s.c = {}                   -- put 的缓存清掉：这一格下一帧全部重写
        s.lastN = nil
        -- 机枪那格写「空格」（11-27 起按住空格打机枪；数字键照样能把它选成左键的武器）
        s.key.Text = (sd.k == "w" and sd.icon == "mg") and T("wtt.space") or (sd.num and tostring(sd.num) or (sd.keyTxt or ""))
        local kw = 4.5   -- 键位框跟着字宽：等宽 12 号一个英文字母约 7.5 像素、中文约 12.5（一个数字 12 × 12）
        for _, cp in utf8.codes(s.key.Text) do kw += (cp < 128) and 7.5 or 12.5 end
        kw = math.max(KEY, math.ceil(kw))
        s.keyBox.Size = UD2(0, kw, 0, KEY)
        s.rdy.Position = UD2(0, 4 + kw + 4, 0, 4 + KEY / 2)
        s.tag.Text = sd.tag or ""
        local sw = wide and AW or TW
        s.f.Size = UD2(0, sw, 0, AH)
        s.f.Position = UD2(0, x, 1, 0)
        -- 图片区：弹种 / 机枪格 x 0～92、工具格 x 2～58，都是 y 10～50（弹轴压在 y 30）
        s.img.Size = wide and UD2(0, 92, 0, IMG_H) or UD2(0, 56, 0, IMG_H)
        s.img.Position = UD2(0, wide and 0 or 2, 0, IMG_Y)
        s.ic.Position = UD2(0, wide and 46 or 30, 0, IMG_Y + IMG_H / 2)
        s.x = x
        x += sw + GAP
        if grp < 3 then loadX = x - GAP end
      end
    end
    for k = nDiv + 1, #dividers do dividers[k].Visible = false end
    local w = math.max(0, x - GAP)
    BAR.Size = UD2(0, w, 0, AH + PLATE)
    loadTxt.Position = UD2(0, (loadX > 0) and loadX or w, 0, 0)
    return slotDef
  end

  -- 这一格还剩几发（nil = 不计数）
  local amlStr, amlN = nil, {}   -- AmL 解析好的 [弹种] = 几发（字串变了才重新解析：每帧每格都要问）
  local function countOf(sd, st)
    local vs = G.S and G.S.veh
    local em = st and st.em
    if sd.k == "am" or sd.k == "w" then
      local am = vs and vs.ammo and vs.ammo[sd.wid]
      local tot = am and (am[1] + am[2]) or nil
      if sd.k == "am" and em then   -- ④ 配弹：每种弹各剩几发（服务器 Wt.lua 写 AmL = "m829a3:20,m830:12,…"）
        local L = em:GetAttribute("AmL")
        if L ~= amlStr then
          amlStr, amlN = L, {}
          if type(L) == "string" then for k, n in string.gmatch(L, "([%w_]+):(%d+)") do amlN[k] = tonumber(n) end end
        end
        local n = amlN[sd.am]
        if n then tot = n end
      end
      return tot
    elseif sd.k == "smoke" then
      return vs and vs.smoke or 0
    end
    return nil
  end
  local capBy = setmetatable({}, { __mode = "k" })   -- [车模型] = { [弹种 / 武器] = 出车以后见过的最多发数 }（剩两成变琥珀）
  local noAmmoT = -9

  -- 数字键：照底部弹药栏一格一个数（主炮的弹种在前，战雷那样 1 穿甲 / 2 破甲……）；Drive.lua 先问这里
  local usedSt = nil   -- 这一趟开的车画过战雷界面（电脑布局）：开着瞄准镜时数字键也照这个排
  G.wtKeySlot = function(st, i)
    if not (st and st.d and st == usedSt) then return false end
    local sd, si = nil, nil
    for j, x in ipairs(buildSlots(st.d, st)) do if x.num == i then sd, si = x, j break end end
    if not sd then return false end
    if countOf(sd, st) == 0 and slots[si] then   -- 打空了的：描边红闪两下、名牌写「无弹」
      slots[si].emptyT = os.clock()
      noAmmoT = os.clock()
    end
    st.wi = sd.wi
    if sd.k == "am" and G.driveAmmo then G.driveAmmo(sd.am) end   -- 换弹种：Drive 的 cycleAmmo（换了要重新装一发）
    return true
  end

  local barShownT, lastBarT = -9, nil
  -- 写实图这一排的状态：整排一起出、一格不行整排退回剪影（11-27 美术审查第 16 条：原来一排里写实图、剪影会混着）
  --   key 这辆车的格子；k 正在显示的那一套（1 / 2 倍）；state "wait" 模块还没到 / "decoding" 排队解着 / "ok" 都解好了 / "fallback" 整排剪影；
  --   need / gray：这一排要的彩色图、去色图的名字；nextK：屏幕跨过 850、要换另一套时，后台在解的那一套（解好了才换，旧的一直显示着）；
  --   badK[k]：那一套解不出（不再试，留着旧的）
  local row = { key = nil, k = 2, state = "wait", need = nil, gray = nil, okT = -9, nextK = nil, badK = {} }
  local retried = {}  -- [格子 key] = true：用不了 EditableImage 时，换到这辆车只再试一次
  -- 这一格可能用到的图：弹种 / 武器一张，工具格一张（维修那格起火时换灭火器：两张都要）；没有图返回 nil
  local function picNames(sd)
    if sd.k == "am" then
      local n = G.ammoPicName("ammo", sd.am)
      return n and { n } or nil
    elseif sd.k == "w" then
      local n = G.ammoPicName("w", sd.wid)
      return n and { n } or nil
    elseif sd.k == "fix" then
      local a, b = G.ammoPicName("tool", "fix"), G.ammoPicName("tool", "ext")
      return (a and b) and { a, b } or nil
    end
    local n = G.ammoPicName("tool", sd.icon)
    return n and { n } or nil
  end
  local function counted(sd) return sd.k == "am" or sd.k == "w" or sd.k == "smoke" end   -- 会打空：去色的也要
  -- 一套图（k 倍）排进解码队列：彩色的先（整排要等它们），去色的跟着（打空那一下不用现解）
  local function wantSet(k)
    for _, n in ipairs(row.need) do G.ammoPicWant(n, false, k) end
    for _, n in ipairs(row.gray) do G.ammoPicWant(n, true, k) end
  end
  -- 这一套解好了没有（withGray：去色的也算上——后台换套时等它们也好，免得打空的那格先闪一下彩色）：true 好了 / false 有一张解不出 / nil 还在解
  local function setDone(k, withGray)
    local done = true
    for pass = 1, withGray and 2 or 1 do
      for _, n in ipairs((pass == 1) and row.need or row.gray) do
        local r = G.ammoPic(n, pass == 2, k)
        if r == false then return false end
        if r == nil then done = false end
      end
    end
    return done or nil
  end
  -- wantK：按现在的屏幕该用哪一套（逻辑屏高 ≥ 850 用 2 倍、更矮的用 1 倍，见上面的说明）
  local function stepRow(def, t, wantK)
    if not G.ammoPicState then
      row.state = "fallback"
      return
    end
    if row.key ~= slotKey then   -- 换车 / 格子变了：整排重来（先空着，都解好了一起淡入）
      row.key, row.k, row.state, row.need, row.gray, row.names = slotKey, wantK, "wait", nil, nil, nil
      row.nextK, row.badK = nil, {}
      for _, s in ipairs(slots) do s.pic = nil end
      if G.ammoPicState() == "broken" and not retried[slotKey] then   -- 换车：用不了 EditableImage 的再试一次
        retried[slotKey] = true
        if G.ammoPicRetry then G.ammoPicRetry() end
      end
    elseif row.state ~= "ok" and row.k ~= wantK and row.state ~= "fallback" then
      row.k = wantK   -- 还没出图：直接改解另一套
      if row.state == "decoding" then wantSet(wantK) end
    elseif row.state == "ok" and wantK ~= row.k and row.nextK ~= wantK and not row.badK[wantK] then
      row.nextK = wantK   -- 只是屏幕跨过了 850：旧的那套先留着显示，新的一套在后台解（不清空、不重新淡入）
      wantSet(wantK)
    elseif row.nextK and wantK == row.k then
      row.nextK = nil     -- 又跨回来了
    end
    local stt = G.ammoPicState()
    if row.state == "wait" then
      if stt == "ready" then
        local color, gray, names = {}, {}, {}
        for i, sd in ipairs(def) do
          local ns = picNames(sd)
          if not ns then   -- 有一格没有图：整排用剪影
            row.state = "fallback"
            return
          end
          names[i] = ns   -- 每格的图名记下来（每帧不用再查、再建表）
          for _, n in ipairs(ns) do
            table.insert(color, n)
            if counted(sd) then table.insert(gray, n) end
          end
        end
        row.need, row.gray, row.names = color, gray, names
        wantSet(row.k)
        row.state = "decoding"
      elseif stt == "failed" or stt == "broken" then
        row.state = "fallback"
      end
    end
    if row.state == "decoding" or row.state == "ok" then
      G.ammoPicPump()   -- 每帧最多解一张
      if G.ammoPicState() == "broken" then
        row.state = "fallback"
        return
      end
      if row.state == "decoding" then
        local d = setDone(row.k)
        if d == false then
          row.state = "fallback"
          return
        elseif d then
          row.state, row.okT = "ok", t
        end
      elseif row.nextK then   -- 后台那一套：都解好了就换过去（每格的图名带着 @k，下一段逐格换图，不淡入）；解不出就留着旧的
        local d = setDone(row.nextK, true)
        if d == false then
          row.badK[row.nextK], row.nextK = true, nil
        elseif d then
          row.k, row.nextK = row.nextK, nil
        end
      end
    end
  end
  local function stepBar(st, I)
    local d = st.d
    local def = buildSlots(d, st)
    local f = st.fcs
    local em = st.em
    local fire = em and em:GetAttribute("WtF") == true
    local fix = em and em:GetAttribute("WtFix")
    local gunOk = not (em and em:GetAttribute("WtGun") == false)
    local t = os.clock()
    local dt = lastBarT and math.clamp(t - lastBarT, 0, 0.1) or 0
    lastBarT = t
    local fa = math.clamp((t - barShownT) / 0.15, 0, 1)   -- 整排淡入
    local function A(tr) return 1 - (1 - tr) * fa end
    local caps = em and capBy[em]
    if em and not caps then
      caps = {}
      capBy[em] = caps
    end
    stepRow(def, t, (cam.ViewportSize.Y >= 850) and 2 or 1)
    local picK = row.k   -- 正在显示的那一套
    local pa = math.clamp((t - row.okT) / 0.12, 0, 1)   -- 整排写实图解好那一下淡入 120 毫秒
    local curName, curType, curLoad = "", "", nil
    local gunDmg = false   -- 主炮坏了（有主炮弹种格的车）：名牌右边写一次「主炮损坏」
    for i, sd in ipairs(def) do
      local s = slots[i]
      local c = s.c
      local sel, empty, cnt = false, false, ""
      local ic = sd.icon
      local fillK, timeTxt = nil, ""
      local reloading, cool, dmg = false, false, false
      local tot = countOf(sd, st)
      if sd.k == "am" or sd.k == "w" then
        cnt = tot and tostring(tot) or "∞"
        empty = tot == 0
        if sd.k == "am" then
          local c0 = (f and f.am) or (BAL.GUN[sd.wid] and BAL.GUN[sd.wid][1])
          sel = st.wi == sd.wi and c0 == sd.am
          dmg = not gunOk
          gunDmg = gunDmg or dmg
          if sel then
            local nm, ty = ammoInfo(sd.am)
            curName, curType = nm, ty
          end
        else
          sel = st.wi == sd.wi
          if sel then curName, curType = T("vw." .. sd.wid), "" end
        end
        if sel and I and I.ready == false then   -- 装填：秒数只写一处（格子里不写；车外准星写着的时候名牌也不写，见下面）
          reloading = true
          fillK = math.clamp(I.relK or 0, 0, 1)
          curLoad = I.left or 0
        end
      elseif sd.k == "smoke" then
        cnt, empty = tostring(tot or 0), (tot or 0) <= 0
      elseif sd.k == "arty" then   -- 火炮支援：冷却（服务器时间）；侦察助攻多给的次数写在右上
        local cd = me:GetAttribute("WtArtyCd")
        local left = cd and (cd - workspace:GetServerTimeNow()) or 0
        local bonus = me:GetAttribute("WtArtyBonus")
        if left > 0 and not bonus then
          cool = true
          fillK, timeTxt = 1 - left / 120, string.format("%ds", math.ceil(left))
        end
        cnt = bonus and ("+" .. bonus) or ""
      elseif sd.k == "scout" then
        cnt = ""
      elseif sd.k == "bino" then   -- 望远镜开着：这格选中
        cnt = ""
        sel = st.binoc == true
      else   -- 维修 / 灭火：起火时换成灭火器；修的时候底边进度
        if fire then ic = "ext" end
        if fix then fillK = fix end
        cnt = ""
      end
      -- 剩两成变琥珀：按出车以后见过的最多发数算；补给加了一发白闪一下
      local capKey = sd.am or sd.wid or sd.k
      if tot and caps then
        caps[capKey] = math.max(caps[capKey] or 0, tot)
        if s.lastN and tot > s.lastN then s.nFlashT = t end
        s.lastN = tot
      end
      local low = tot and caps and caps[capKey] and caps[capKey] > 0 and tot <= caps[capKey] * 0.2
      -- 图：写实渲染图（AmmoPics，整排解好了才出）；打空了换去色的（还没解好先用彩色的）；整排退回时单色剪影
      local showPic = row.state == "ok"
      if showPic then
        local ns = row.names and row.names[i]
        local pname = ns and ((sd.k == "fix" and fire) and ns[2] or ns[1]) or nil
        local gray = (empty and pname ~= nil and G.ammoPic(pname, true, picK)) and true or false
        local want = pname and (pname .. (gray and "#g" or "") .. "@" .. picK) or nil
        if s.pic ~= want then
          s.pic = want
          local ok = pname ~= nil and G.ammoPicOn(s.img, pname, gray, picK) == true
          if ok then
            s.imgFade.Enabled = G.ammoPicFade(pname)
            c.imgTr, c.imgCol = nil, nil   -- 换了图：亮度、透明度重写
          else
            row.state = "fallback"   -- 有一格装不上：整排退回剪影
            showPic = false
          end
        end
        if showPic and empty and pname and G.ammoPic(pname, true, picK) == false then   -- 去色的解不出：也整排退回
          row.state = "fallback"
          showPic = false
        end
      end
      local showIcon = row.state == "fallback"
      put(c, "imgV", s.img, "Visible", showPic)
      put(c, "icV", s.ic, "Visible", showIcon)
      if showIcon and s.kind ~= ic then
        s.kind = ic
        icon(s.ic, ic)
        c.icTr = nil
      end
      -- 状态 → 样子（描边颜色 100 毫秒线性过渡；装填时图压暗到八成，装好 120 毫秒内回来）
      s.selK = math.clamp(s.selK + (sel and 1 or -1) * dt / 0.1, 0, 1)
      local briT = reloading and 0.8 or (sel and 1 or 0.9)
      if s.bri < briT then s.bri = math.min(briT, s.bri + dt / 0.12) else s.bri = math.max(briT, s.bri - dt / 0.1) end
      local unavailable = cool or (dmg and sd.k == "am")
      local imgTr = empty and 0.65 or (unavailable and 0.75 or 0)
      local stCol = WHITE:Lerp(AMBER, s.selK)
      local stTr = 0.85 + (0 - 0.85) * s.selK
      local et = t - s.emptyT   -- 按了打空的那格：红闪两下（各 100 毫秒）
      if et < 0.4 and (et < 0.1 or (et >= 0.2 and et < 0.3)) then stCol, stTr = PEN_NO, 0 end
      if sd.k == "fix" and fire then stCol, stTr = PEN_NO, 0 end   -- 起火：灭火那格红描边（不闪）
      put(c, "fT", s.f, "BackgroundTransparency", A(0.35))
      put(c, "stC", s.st, "Color", stCol)
      put(c, "stT", s.st, "Transparency", A(stTr))
      if showPic then
        local b = math.floor(s.bri * 100 + 0.5) / 100
        put(c, "imgCol", s.img, "ImageColor3", Color3.new(b, b, b))
        put(c, "imgTr", s.img, "ImageTransparency", 1 - (1 - A(imgTr)) * pa)
      elseif showIcon then
        local icTr = empty and 0.78 or (unavailable and 0.8 or (sel and 0 or 0.35))
        icTr = 1 - (1 - icTr) * fa
        if c.icTr ~= icTr then   -- 剪影的零件：透明度变了才挨个改
          c.icTr = icTr
          for _, q in ipairs(s.ic:GetDescendants()) do
            if q:IsA("Frame") and q.BackgroundColor3 == ICON then
              q:SetAttribute("Base", q:GetAttribute("Base") or q.BackgroundTransparency)
              q.BackgroundTransparency = 1 - (1 - q:GetAttribute("Base")) * (1 - icTr)
            elseif q:IsA("UIStroke") then
              q.Transparency = icTr
            end
          end
        end
      end
      -- 冷却：暗遮罩从上往下退（盖住还没走完的那一截）
      put(c, "maskV", s.mask, "Visible", cool)
      if cool then
        put(c, "maskS", s.mask, "Size", UD2(1, 0, 1 - math.floor(math.clamp(fillK or 0, 0, 1) * 200 + 0.5) / 200, 0))
        put(c, "maskT", s.mask, "BackgroundTransparency", A(0.3))
      end
      -- 右上：发数（白；剩两成琥珀；0 红）；主炮坏了发数照写、变暗（FAINT、透明 0.4）——「主炮损坏」只在名牌右边写一次
      --   （11-27 美术审查第二轮：原来 5 个弹种格都换成红字「损坏」，加上左下损伤图、「按 Y 维修」，同一件事说了 5 遍）
      local nDim = dmg and sd.k == "am"
      put(c, "nTx", s.n, "Text", cnt)
      put(c, "nCol", s.n, "TextColor3", nDim and FAINT or (empty and PEN_NO or (low and AMBER or TH.C.TEXT)))
      put(c, "nT", s.n, "TextTransparency", A(nDim and 0.4 or 0))
      put(c, "nS", s.n, "TextStrokeTransparency", A(0.45))
      local nf = t - s.nFlashT < 0.08
      put(c, "nBg", s.nBg, "BackgroundTransparency", nf and A(0.55) or 1)
      -- 左上键位框（主炮坏了变暗）；装好了键位框右边一个白点（选中、装好、有弹、炮能打）
      local keyDim = dmg and sd.k == "am"
      local keyCol = keyDim and FAINT or (sel and TH.C.TEXT or MUTE)
      put(c, "kCol", s.key, "TextColor3", keyCol)
      put(c, "kSCol", s.keyS, "Color", keyCol)
      put(c, "kT", s.key, "TextTransparency", A(keyDim and 0.4 or 0))
      put(c, "kS", s.key, "TextStrokeTransparency", A(0.45))
      put(c, "kST", s.keyS, "Transparency", A(keyDim and 0.5 or 0))
      local ready = sel and (sd.k == "am" or sd.k == "w") and not reloading and not empty and gunOk
      put(c, "rdyV", s.rdy, "Visible", ready)
      if ready then put(c, "rdyT", s.rdy, "BackgroundTransparency", A(0)) end
      -- 左下类型：每一格都写（用户 11-28「目前局内我分辨不出来弹种」：原来只写选中那格，别的格子只有图，几种弹的图看着差不多）——
      --   选中那格白字，别的灰字；主炮坏了跟发数一样变暗。右下：冷却秒数
      local tagOn = s.tag.Text ~= "" and (sel or sd.k == "am" or sd.k == "w")
      put(c, "tagV", s.tag, "Visible", tagOn)
      if tagOn then
        put(c, "tagC", s.tag, "TextColor3", (dmg and sd.k == "am") and FAINT or (sel and TH.C.TEXT or MUTE))
        put(c, "tagT", s.tag, "TextTransparency", A((dmg and sd.k == "am") and 0.4 or 0))
        put(c, "tagS", s.tag, "TextStrokeTransparency", A(0.45))
      end
      put(c, "tmTx", s.tm, "Text", timeTxt)
      if timeTxt ~= "" then
        put(c, "tmT", s.tm, "TextTransparency", A(0))
        put(c, "tmS", s.tm, "TextStrokeTransparency", A(0.45))
      end
      -- 底边：只在装填 / 维修时当进度条（底下一道淡轨道）；平时不画，冷却只有遮罩
      local prog = (fillK ~= nil) and not cool and fillK < 1
      put(c, "lineV", s.line, "Visible", prog)
      if prog then
        put(c, "lineT", s.line, "BackgroundTransparency", A(0.85))
        put(c, "fillS", s.fill, "Size", UD2(math.floor(math.clamp(fillK, 0, 1) * 200 + 0.5) / 200, 0, 1, 0))
        put(c, "fillT", s.fill, "BackgroundTransparency", A(0))
      end
    end
    for k = 1, #dividers do put(plateC, "dv" .. k, dividers[k], "BackgroundTransparency", A(0.85)) end
    -- 名牌：型号（白 15）+「· 类型」（灰 13）；按了打空的那格：「无弹」（红）——内容变了才重新拼字串
    local noAm = t - noAmmoT < 1.2
    local pk = noAm and "\0" or (curName .. "\1" .. curType)
    if plateC.key ~= pk then
      plateC.key = pk
      local w = 0   -- 名牌后面那条暗底的宽：窄体 15 号一个英文字母约 7.5 像素、中文约 15；类型 13 号约 6.5
      if noAm then
        ammoName.Text = T("wtt.noAmmo")
        ammoName.TextColor3 = PEN_NO
        for _, cp in utf8.codes(ammoName.Text) do w += (cp < 128) and 7.5 or 15 end
      else
        ammoName.TextColor3 = TH.C.TEXT
        ammoName.Text = (curType ~= "") and string.format('%s<font size="%d" color="#%s">  ·  %s</font>', curName, SZ.small, MUTE_HEX, curType) or curName
        for _, cp in utf8.codes(curName) do w += (cp < 128) and 7.5 or 15 end
        if curType ~= "" then for _, cp in utf8.codes("  ·  " .. curType) do w += (cp < 128) and 6.5 or 13 end end
      end
      plateC.nameW = w
    end
    put(plateC, "nT", ammoName, "TextTransparency", A(0))
    put(plateC, "nS", ammoName, "TextStrokeTransparency", A(0.45))
    -- 名牌右边：主炮坏了写一次红字「主炮损坏」（窄体 13 号中文用粗体）；不然装填中写「装填 x.x s」（琥珀等宽 13）——
    --   车外准星在屏幕上时不写（它自己写着秒数 + 琥珀弧：同一件事不说两遍）；开镜、望远镜里没有那个准星，照写
    if I and I.p ~= nil and AIM.root.Visible then curLoad = nil end
    local lt = (not gunDmg) and curLoad and math.floor(curLoad * 10 + 0.5) or nil   -- 装填秒数：到 0.1 秒变了才重写
    local rk = gunDmg and -1 or lt
    if plateC.lt ~= rk then
      plateC.lt = rk
      if gunDmg then
        loadTxt.Text, loadTxt.TextColor3, loadTxt.Font = T("wtt.gunDmg"), PEN_NO, BOLD
      else
        loadTxt.Text, loadTxt.TextColor3, loadTxt.Font = lt and T("wtt.load", string.format("%.1f", lt / 10)) or "", AMBER, MONO_F
      end
    end
    put(plateC, "lT", loadTxt, "TextTransparency", A(0))
    put(plateC, "lS", loadTxt, "TextStrokeTransparency", A(0.45))
    local bw = ((plateC.nameW or 0) > 0) and (plateC.nameW + 26) or 0
    if rk then bw = math.max(bw, loadTxt.Position.X.Offset + 16) end
    put(plateC, "bgW", plateBg, "Size", UD2(0, math.ceil(bw), 0, 20))
    put(plateC, "bgV", plateBg, "Visible", bw > 0)
    put(plateC, "bgT", plateBg, "BackgroundTransparency", A(0.5))
  end

  ---------------------------------------------------------------- 左下：损伤示意图
  local DI = frame(gui, UD2(0, 250, 0, 160), UD2(0, 252, 1, -14), WHITE, 1, V2(0, 1))
  DI.Name = "WtDamageInd"
  local diScale = Instance.new("UIScale")
  diScale.Parent = DI
  do   -- 很淡的黑底，左浓右淡
    local bg = frame(DI, UD2(1, 0, 1, 0), nil, INK, 0.55)
    round(bg, UDim.new(0, 4))
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new({ nk(0, 0.1), nk(0.6, 0.35), nk(1, 1) })
    g.Parent = bg
  end
  local SCW, SCH = 112, 150
  local sch = frame(DI, UD2(0, SCW, 0, SCH), UD2(0, 4, 0, 5), WHITE, 1)
  sch.Name = "Schematic"
  local diName = label(DI, "", UD2(0, 130, 0, 14), UD2(0, SCW + 10, 0, 8), 12, RGB(214, 220, 222), MED, nil, LEFT)
  diName.TextTruncate = Enum.TextTruncate.AtEnd
  local diSpd = label(DI, "0", UD2(0, 64, 0, 32), UD2(0, SCW + 10, 0, 26), 30, WHITE, BOLD, nil, LEFT)
  label(DI, "km/h", UD2(0, 40, 0, 12), UD2(0, SCW + 11, 0, 58), 11, RGB(190, 196, 198), MED, nil, LEFT)
  local gearBox = round(frame(DI, UD2(0, 28, 0, 28), UD2(0, SCW + 84, 0, 30), INK, 0.45), UDim.new(0, 3))
  stroke(gearBox, WHITE, 1, 0.55)
  local diGear = label(gearBox, "N", UD2(1, 0, 1, 0), nil, 17, WHITE, BOLD)
  local diTip = label(DI, "", UD2(0, 130, 0, 34), UD2(0, SCW + 10, 0, 80), 12, WHITE, BOLD, nil, LEFT)
  diTip.TextWrapped = true
  diTip.TextYAlignment = Enum.TextYAlignment.Top
  local fixBg = frame(DI, UD2(0, 122, 0, 3), UD2(0, SCW + 10, 0, 122), WHITE, 0.82)
  local fixFill = frame(fixBg, UD2(0, 0, 1, 0), nil, AMBER, 0)
  local diCrew = label(DI, "", UD2(0, 130, 0, 14), UD2(0, SCW + 10, 0, 134), 11, RGB(190, 196, 198), MED, nil, LEFT)

  local SC = { d = nil }
  -- 一个小人（头 + 身子）：乘员
  local function person(parent)
    local o = { f = frame(parent, UD2(0, 12, 0, 13), nil, WHITE, 1, V2(0.5, 0.5)) }
    o.f.ZIndex = 5
    o.head = round(frame(o.f, UD2(0, 5, 0, 5), UD2(0.5, 0, 0, 0), C_OK, 0, V2(0.5, 0)))
    o.body = round(frame(o.f, UD2(0, 10, 0, 7), UD2(0.5, 0, 1, 0), C_OK, 0, V2(0.5, 1)), UDim.new(0, 3))
    o.hs, o.bs = stroke(o.head, INK, 1, 0.35), stroke(o.body, INK, 1, 0.35)
    o.head.ZIndex, o.body.ZIndex = 5, 5
    o.x = label(o.f, "×", UD2(1, 4, 1, 4), UD2(0.5, 0, 0.5, 0), 15, PEN_NO, BOLD, V2(0.5, 0.5))
    o.x.ZIndex = 6
    o.x.Visible = false
    return o
  end
  local function buildSch(d)
    sch:ClearAllChildren()
    SC = { d = d, mods = {}, crew = {}, lay = W.layout(d) }
    local lay = SC.lay
    local L, Wd = d.L, d.W
    local k = math.min((SCH - 18) / L, (SCW - 34) / Wd)
    local cx, cy = SCW / 2, SCH / 2 + 4
    SC.k, SC.cx, SC.cy = k, cx, cy
    local function hullPx(x, z) return cx + x * k, cy + z * k end
    -- 车体轮廓（车头朝上），车头一道短横线
    local hb = round(frame(sch, UD2(0, Wd * k, 0, L * k), UD2(0, cx, 0, cy), RGB(30, 34, 36), 0.6, V2(0.5, 0.5)), UDim.new(0, 3))
    stroke(hb, WHITE, 1.2, 0.35)
    frame(sch, UD2(0, Wd * k * 0.4, 0, 2), UD2(0, cx, 0, cy - L * k / 2 - 3), WHITE, 0.35, V2(0.5, 1))
    -- 炮塔：一个转的框（绕座圈中心转），里面炮塔轮廓、炮管、炮闩……
    local tp = lay.tp
    local R = math.max(L, Wd) * k * 1.2
    local tg = nil
    if d.turret then
      local px, py = hullPx(tp.X, tp.Z)
      tg = frame(sch, UD2(0, R * 2, 0, R * 2), UD2(0, px, 0, py), WHITE, 1, V2(0.5, 0.5))
      tg.Name = "Turret"
      tg.ZIndex = 3
      local ts = lay.ts
      local tb = round(frame(tg, UD2(0, ts.X * k, 0, ts.Z * k), UD2(0.5, 0, 0.5, 0), RGB(36, 40, 42), 0.35, V2(0.5, 0.5)), UDim.new(0, 5))
      tb.ZIndex = 3
      stroke(tb, WHITE, 1.2, 0.25)
    end
    SC.tg, SC.R = tg, R
    for _, it in ipairs(lay.list) do
      local c = (it.lo + it.hi) / 2
      local sz = it.hi - it.lo
      if it.kind == "crew" then
        local o = person(sch)
        o.it, o.tur, o.cx, o.cz = it, it.tur, c.X, c.Z
        table.insert(SC.crew, o)
      else
        local parent = (it.tur and tg) or sch
        local f
        if it.tur and tg then
          f = frame(tg, UD2(0, math.max(2, sz.X * k), 0, math.max(2, sz.Z * k)), UD2(0.5, c.X * k, 0.5, c.Z * k), M_OK, 0.8, V2(0.5, 0.5))
        else
          local px, py = hullPx(c.X, c.Z)
          f = frame(parent, UD2(0, math.max(2, sz.X * k), 0, math.max(2, sz.Z * k)), UD2(0, px, 0, py), M_OK, 0.8, V2(0.5, 0.5))
        end
        round(f, UDim.new(0, (it.k == "barrel") and 1 or 2))
        f.ZIndex = it.tur and 4 or 2
        f.Name = it.k
        local s = stroke(f, M_OK, 1, 0.55)
        table.insert(SC.mods, { it = it, f = f, s = s, last = 2, flash = 0 })
      end
    end
    -- 起火：一团火（发动机那里）
    SC.fire = round(frame(sch, UD2(0, 16, 0, 16), UD2(0, cx, 0, cy), RGB(255, 120, 30), 0.15, V2(0.5, 0.5)))
    SC.fire.ZIndex = 7
    SC.fire.Visible = false
    for _, m in ipairs(SC.mods) do
      if m.it.k == "engine" then
        local c = (m.it.lo + m.it.hi) / 2
        SC.fire.Position = UD2(0, cx + c.X * k, 0, cy + c.Z * k)
      end
    end
  end

  local function stepDI(st)
    local d = st.d
    local em = st.em
    if not d then DI.Visible = false return end
    DI.Visible = true
    if SC.d ~= d then buildSch(d) end
    local t = os.clock()
    local yaw = st.ty or (em and em:GetAttribute("Ty")) or 0
    if SC.tg then SC.tg.Rotation = yaw end
    -- 乘员：按座位（谁坐在这个位子上、活没活；换了位子的跟着人走）
    local wc = em and em:GetAttribute("WtC") or ""
    local seat, have, alive, tot = {}, {}, 0, 0
    for tok in string.gmatch(wc, "[^,]+") do
      local s, sn = tonumber(string.sub(tok, 1, 1)) or 2, string.sub(tok, 2)
      tot += 1
      if s > 0 then alive += 1 end
      if seat[sn] == nil or s > seat[sn] then seat[sn] = s end
      have[sn] = true
    end
    local a = math.rad(yaw)
    local ca, sa = math.cos(a), math.sin(a)
    local tp = SC.lay.tp
    for _, o in ipairs(SC.crew) do
      local x, z = o.cx, o.cz
      if o.tur then x, z = tp.X + o.cx * ca - o.cz * sa, tp.Z + o.cx * sa + o.cz * ca end   -- 炮塔里的人跟着炮塔转（小人本身不转，免得倒过来）
      o.f.Position = UD2(0, SC.cx + x * SC.k, 0, SC.cy + z * SC.k)
      local s = have[o.it.role] and seat[o.it.role] or 0
      local col = (s == 2) and C_OK or ((s == 1) and C_HURT or C_DEAD)
      if o.pc ~= col then
        o.pc = col
        o.head.BackgroundColor3, o.body.BackgroundColor3 = col, col
        o.x.Visible = s == 0
      end
    end
    -- 模块
    local wm = em and em:GetAttribute("WtM") or ""
    for i, m in ipairs(SC.mods) do
      local s = tonumber(string.sub(wm, i, i)) or 2
      if s < m.last then m.flash = t + 1.2 end
      m.last = s
      local col, tr = M_OK, 0.8
      if s == 1 then col, tr = M_HURT, 0.2 elseif s == 0 then col, tr = M_DEAD, 0.1 end
      if t < m.flash and (t * 8) % 1 < 0.5 then col, tr = WHITE, 0 end
      local st = (s == 2) and 0.55 or 0
      if m.pc ~= col or m.pt ~= tr or m.ps ~= st then   -- 没变就不写（11 个模块每帧 4 个属性；界面属性写一次就要重排）
        m.pc, m.pt, m.ps = col, tr, st
        m.f.BackgroundColor3, m.f.BackgroundTransparency = col, tr
        m.s.Color, m.s.Transparency = col, st
      end
    end
    local fire = em and em:GetAttribute("WtF") == true
    SC.fire.Visible = fire
    if fire then
      local pu = 0.5 + 0.5 * math.sin(t * 9)
      SC.fire.Size = UD2(0, 13 + 6 * pu, 0, 13 + 6 * pu)
      SC.fire.BackgroundColor3 = RGB(255, 90 + math.floor(90 * pu), 30)
    end
    -- 右边：车名、车速、档位、提示
    diName.Text = string.match(T("veh." .. d.id), "^(%S+)") or d.id
    diSpd.Text = tostring(math.floor(math.abs(st.speed or 0) / 2.8 * 3.6 + 0.5))
    local back = (st.speed or 0) < -0.4
    local gn = st.gearN or 0
    diGear.Text = st.locked and "-" or ((gn >= 1) and tostring(gn) or ((gn <= -1 or back) and ((st.gb and st.gb.nr > 1 and gn <= -1) and ("R" .. tostring(-gn)) or "R") or "N"))   -- 倒挡两档：R1 / R2
    diGear.TextColor3 = back and AMBER or WHITE
    local fix = em and em:GetAttribute("WtFix")
    local anyBad = false
    for _, m in ipairs(SC.mods) do if m.last < 2 then anyBad = true break end end
    if em and em:GetAttribute("WtMob") == false then anyBad = true end
    local afLeft = em and em:GetAttribute("WtAFLeft")   -- 弹药架起火：几秒内不灭就殉爆（服务器 Wt.lua；用户 11-28「弹药架起火如果不及时灭火修要爆炸」）
    if fire and type(afLeft) == "number" then diTip.Text, diTip.TextColor3 = T("wt.tipAmmoFire", afLeft), ((t * 5) % 1 < 0.6) and PEN_NO or WHITE
    elseif fire then diTip.Text, diTip.TextColor3 = T("wt.tipFire"), ((t * 3) % 1 < 0.6) and PEN_NO or AMBER
    elseif fix then diTip.Text, diTip.TextColor3 = T("wt.tipFixing", math.floor(fix * 100)), AMBER
    elseif anyBad then diTip.Text, diTip.TextColor3 = T("wt.tipFix"), WHITE
    else diTip.Text = "" end
    fixBg.Visible = fix ~= nil
    fixFill.Size = UD2(math.clamp(fix or 0, 0, 1), 0, 1, 0)
    diCrew.Text = (tot > 0) and T("wtt.crew", alive, tot) or ""
    -- ④ 待发弹架：还剩几发（空了写红字「车体取弹」——装得慢）
    local rdy, rcap = em and em:GetAttribute("Rdy"), em and em:GetAttribute("RdyCap")
    if rdy and rcap then
      diCrew.Text = diCrew.Text .. "   " .. ((rdy > 0) and T("wtt.rack", rdy, rcap) or T("wtt.rackOut"))
    end
  end

  ---------------------------------------------------------------- 每帧（VehHud.stepTank 调）
  local shownT, lastVp, lastBarW = -9, nil, nil
  local function layout()
    local vp = cam.ViewportSize
    local bw = BAR.Size.X.Offset
    if vp == lastVp and bw == lastBarW then return end
    lastVp, lastBarW = vp, bw
    local ds = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.8, 1.25)
    diScale.Scale = ds
    -- 弹药栏按 1080p 设计：屏幕高 / 1080，夹在 0.85～1.4；底边上方 16 像素、水平居中——
    --   左下的损伤示意图（小地图右边）挡着的时候整排往右让开；屏幕窄得放不下再缩小
    local s = math.clamp(vp.Y / 1080, 0.85, 1.4)
    local diRight = 252 + 250 * ds + 12
    if bw > 0 and bw * s > vp.X - diRight - 12 then s = math.max(0.5, (vp.X - diRight - 12) / bw) end
    local left = vp.X / 2 - bw * s / 2
    barScale.Scale = s
    BAR.Position = UD2(0.5, math.max(0, diRight - left), 1, -16 * s)
  end
  -- I：{ p 炮指的点、o 炮口、relK / ready / left 装填、wid / w 选中的武器、am 弹种 }；没有炮（车上只有机枪的）I.p 是 nil：只画弹药栏、损伤图
  function G.wtTankStep(st, I)
    shownT = os.clock()
    usedSt = st
    if not gui.Enabled then barShownT = os.clock() end   -- 整排淡入 150 毫秒
    gui.Enabled = true
    local t = os.clock()
    if I and I.p then
      -- 大圈：鼠标 / 镜头瞄的那点（第三人称鼠标锁在屏幕正中，镜头的瞄准射线就从这里出去）
      local vp = cam.ViewportSize
      AIM.root.Visible = true
      AIM.root.Position = UD2(0, vp.X / 2, 0, vp.Y / 2)
      -- 小圈：炮这一刻开火真打到的地方
      local sp, on = cam:WorldToViewportPoint(I.p)
      AIM.gun.Visible = on
      AIM.gun.Position = UD2(0, sp.X, 0, sp.Y)
      local col = WHITE
      AIM.block.Visible = on and I.blocked == true
      if I.blocked then
        col = PEN_NO   -- 炮口被挡：不算穿深，圈红
      elseif on and I.w then
        local ok, c = pcall(penColor, st, I)
        if ok and c then col = c end
      end
      AIM.gunS.Color = col
      -- 装填：弧走着（琥珀），装好那一下圈涨一下
      local ready = I.ready ~= false
      if ready and not wasReady then
        readyT = t
        if G.wtVoice and wasReady == false then G.wtVoice("loaded") end   -- 车组语音：装填完毕（⑬）
      end
      wasReady = ready
      local flash = ready and (t - readyT) < 0.45   -- 刚装好：整圈绿亮一下
      AIM.rel.root.Visible = (not ready) or flash
      AIM.track.Transparency = (ready and not flash) and 1 or 0.7
      if not ready then AIM.rel.set(I.relK or 0, relColor(I.relK)) elseif flash then AIM.rel.set(1, PEN_OK) end
      AIM.relT.TextColor3 = relColor(I.relK)
      AIM.relT.Text = ready and "" or string.format("%.1f", I.left or 0)
      local pop = math.clamp(1 - (t - readyT) / 0.25, 0, 1)
      AIM.scale.Scale = 1 + 0.18 * pop
      -- 测距（用户 11-25「全部都做」⑤）：按 R 才有（只有历史模式）——有激光测距的马上准，
      --   没有的（豹 1、M60A1、BMP-1）车长估两秒、报个整 50 米的数（≈）；10 秒后作废
      do   -- 只有历史（11-27）：按 R 才测距
        local f = st.fcs
        if f and f.estimating then AIM.rng.Text = T("wtt.est")
        elseif f and f.R and (f.man or (f.laseT and t - f.laseT < 10)) then AIM.rng.Text = (f.est and "≈" or "") .. T("vh.m", f.R)
        elseif f and f.noRet and f.laseT and t - f.laseT < 3 then AIM.rng.Text = "----"
        else AIM.rng.Text = T("wtt.rkey") end
      end
    else
      AIM.root.Visible, AIM.gun.Visible = false, false
    end
    local ok, err = pcall(stepBar, st, I)
    if not ok and G.showError then G.showError("战雷弹药栏：" .. tostring(err)) end
    layout()   -- 弹药栏排好（这辆车几格）以后再定大小、位置
    ok, err = pcall(stepDI, st)
    if not ok and G.showError then G.showError("战雷损伤图：" .. tostring(err)) end
  end
  G.wtTankShown = function() return gui.Enabled end   -- TankHud（车旁车速牌）、WtHud（旧的车组面板）看这个收起
  G.wtTankSlots = function() return slotDef end   -- 测试用

  G.frameConn("WtTank", function()
    if gui.Enabled and os.clock() - shownT > 0.15 then gui.Enabled = false end   -- 下车、开瞄准镜、换触屏布局：VehHud 不调了
  end)
end

return WtTank
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="296">
          <Properties>
            <string name="Name">WtVfx</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——战雷式车辆受伤的样子（用户 11-26「很多载具自带爆反……不同部位被击中也要有不同效果，如弹药舱燃烧、
--   炮管损毁、殉爆、观瞄受损之类的，并且对应效果」）。服务器 Wt.lua 把模块状态写在车上（WtM 模块、WtF 起火、WtAF 弹药架起火、
--   WtBlow 泄压板泄了几次），这里照着画——谁的车都画（离镜头 900 格以内、没成残骸）：
--   · 发动机受损：发动机盖上冒一缕淡灰烟；打坏了：浓黑烟（原来车着火、发动机坏了外面什么都看不出来，只有车身慢慢熏黑）
--   · 起火（WtF）：发动机舱一团跳动的火苗 + 滚滚黑烟 + 一闪一闪的火光
--   · 弹药架起火（WtAF）：车长、炮长舱口往上喷几米高的火柱，噼啪乱飞的火星，火光很亮（烧完没灭有四成殉爆）
--   · 泄压板（WtBlow 变了，M1 炮塔尾舱）：尾舱顶上一道冲天火柱，烧六七秒慢慢小下去，后面一股黑烟
--   · 炮管打坏：炮管耷拉下来（View.lua 按 G.wtModState）；履带打断：那边的履带板停住、上面一段掉了（Tracks.lua）
--   · 自己的车观瞄（optics）受损：开镜时镜里几道裂纹、发糊；打坏：裂成一片、更糊、只剩最低倍率、没有热成像（Drive.lua 问 G.opticsDead）
--   11-27（照战雷、M3 上要丝滑）：火（fire_main 本身暗褐）LightInfluence 0 + Brightness 3 才亮；黑烟换成深灰的烟贴图、受光照、跟着风；
--     火星是白点顺着速度拉成线（不用八角星）；状态、喷多少、火光每秒只看 10 次，变化超过一成才写（原来每帧每辆车都改 Rate、Color、亮度）；
--     位置还是每帧跟着车（只有正在冒烟冒火的车）
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")

local WtVfx = {}

function WtVfx.init(G)
  local W = require(RS:WaitForChild("WtDamage"))
  local V = Vector3.new
  local CF = CFrame.new
  local RGB = Color3.fromRGB
  local NS, NK = NumberSequence.new, NumberSequenceKeypoint.new
  local cam = workspace.CurrentCamera
  local me = Players.LocalPlayer
  local FIRE = "rbxasset://textures/particles/fire_main.dds"
  local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
  local SOOT = "rbxasset://textures/particles/explosion01_smoke_main.dds"   -- 深灰的烟（黑烟）
  local GLOW = "rbxasset://textures/particles/explosion01_implosion_main.dds"   -- 白色柔边圆点（火星：顺着速度拉成线）
  local NEAR = 900

  -- 模块状态（2 好、1 受损、0 毁了），给别的客户端模块用
  function G.wtModState(em, d, k) return W.modState(em, d, k) end

  local function mount(parent)
    local p = Instance.new("Part")
    p.Name = "WtVfx"
    p.Size = V(0.3, 0.3, 0.3)
    p.Transparency = 1
    p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
    p.Parent = parent
    return p
  end
  -- o.emit：自己发光（火、火星：LightInfluence 0、Brightness 推亮）；不写的受光照（烟）；o.vp 顺着速度拉成线；o.wind 跟着风
  local function emitter(parent, o)
    local pe = Instance.new("ParticleEmitter")
    pe.Texture = o.tex
    pe.Color = o.col
    pe.LightEmission, pe.LightInfluence = o.emit or 0, o.emit and 0 or 1
    pe.Brightness = o.bright or 1
    pe.Size = o.size
    pe.Transparency = o.tr or NS({ NK(0, 0.2), NK(1, 1) })
    pe.Lifetime = NumberRange.new(o.life[1], o.life[2])
    pe.Speed = NumberRange.new(o.speed[1], o.speed[2])
    pe.SpreadAngle = Vector2.new(o.spread or 12, o.spread or 12)
    pe.Acceleration = o.acc or V(0, 3, 0)
    pe.Drag = o.drag or 0.6
    if o.vp then
      pe.Orientation = Enum.ParticleOrientation.VelocityParallel
      pe.Rotation, pe.RotSpeed = NumberRange.new(0), NumberRange.new(0)
      pcall(function() pe.Squash = NS({ NK(0, 2), NK(1, 1) }) end)
    else
      pe.Rotation = NumberRange.new(0, 360)
      pe.RotSpeed = NumberRange.new(-80, 80)
    end
    if o.wind then pcall(function() pe.WindAffectsDrag = true end) end
    pe.EmissionDirection = Enum.NormalId.Top
    pe.Rate = 0
    pe.Enabled = true
    pe.Parent = parent
    return pe
  end
  -- 变化超过一成才写（Rate、亮度：每秒看 10 次，别每次都写）
  local function setRate(pe, r)
    local cur = pe.Rate
    if r <= 0 then
      if cur ~= 0 then pe.Rate = 0 end
    elseif cur == 0 or math.abs(r - cur) > cur * 0.1 then
      pe.Rate = r
    end
  end
  local function setB(l, b)
    local cur = l.Brightness
    if b <= 0 then
      if cur ~= 0 then l.Brightness = 0 end
    elseif cur == 0 or math.abs(b - cur) > cur * 0.1 then
      l.Brightness = b
    end
  end
  local function light(parent, col, range)
    local l = Instance.new("PointLight")
    l.Color, l.Range, l.Brightness, l.Shadows = col, range, 0, false
    l.Parent = parent
    return l
  end

  -- 一辆车的几处位置（车底坐标 / 炮塔坐标，同 WtDamage）：发动机盖、舱口、弹药架顶
  local function spotsOf(d)
    local lay = W.layout(d)
    local eng, ammo
    for _, it in ipairs(lay.list) do
      if it.k == "engine" then eng = it end
      if it.k == "ammo" then ammo = it end
    end
    local hH = lay.hH
    local s = {}
    if eng then s.eng = V((eng.lo.X + eng.hi.X) / 2, hH + 0.2, (eng.lo.Z + eng.hi.Z) / 2) else s.eng = V(0, hH + 0.2, d.L * 0.3) end
    local T = d.turret
    if T then
      local top = (T.size and T.size.Y or 2.2) + 0.1
      local cu = d.cupola or V(1.3, top, 0.4)
      s.hatch = { V(cu.X, top, cu.Z), V(-cu.X * 0.9, top, cu.Z - 0.4) }   -- 车长、炮长（另一边）舱口
    else
      s.hatch = { V(0, hH + 0.3, -d.L * 0.1) }
    end
    if ammo and ammo.tur then s.bustle = V((ammo.lo.X + ammo.hi.X) / 2, ammo.hi.Y + 0.15, (ammo.lo.Z + ammo.hi.Z) / 2) end
    return s
  end

  local fx = setmetatable({}, { __mode = "k" })   -- [视图] = 这辆车的特效
  local function build(v)
    local d = v.def
    local F = { spots = spotsOf(d) }
    local parent = v.model or workspace
    -- 发动机盖：烟（受损淡灰、毁了浓黑）、火（起火）
    F.engP = mount(parent)
    -- 发动机受损：淡灰烟；打坏了：深灰的黑烟（两个发射器换着开，不改颜色——改颜色连已经飘着的烟一起变）
    F.engSmoke = emitter(F.engP, { tex = SMOKE, col = ColorSequence.new(RGB(150, 148, 144)), size = NS({ NK(0, 2), NK(1, 9) }), life = { 2.5, 4 }, speed = { 3, 6 }, spread = 14, wind = true })
    F.engBlack = emitter(F.engP, { tex = SOOT, col = ColorSequence.new(RGB(255, 255, 255)), size = NS({ NK(0, 2.4), NK(1, 11) }), life = { 3, 4.5 }, speed = { 3, 7 }, spread = 14, wind = true,
      tr = NS({ NK(0, 0.1), NK(1, 1) }) })
    -- 火的中心偏白（用户 11-28「战雷的火中心偏白」）：刚喷出来近乎白热，往上飘才转金黄 → 橙 → 暗红
    F.fire = emitter(F.engP, { tex = FIRE, col = ColorSequence.new({ ColorSequenceKeypoint.new(0, RGB(255, 250, 236)), ColorSequenceKeypoint.new(0.25, RGB(255, 222, 150)),
      ColorSequenceKeypoint.new(0.55, RGB(255, 126, 42)), ColorSequenceKeypoint.new(1, RGB(160, 40, 20)) }),
      size = NS({ NK(0, 2.6), NK(0.6, 3.4), NK(1, 0.8) }), life = { 0.45, 0.8 }, speed = { 4, 8 }, spread = 18, emit = 0.9, bright = 3, acc = V(0, 6, 0),
      tr = NS({ NK(0, 0.15), NK(0.7, 0.45), NK(1, 1) }) })
    F.fireSmoke = emitter(F.engP, { tex = SOOT, col = ColorSequence.new(RGB(255, 255, 255)), size = NS({ NK(0, 3.5), NK(1, 18) }), life = { 3.5, 5.5 }, speed = { 6, 10 }, spread = 16, acc = V(0, 4, 0),
      wind = true, tr = NS({ NK(0, 0.08), NK(1, 1) }) })
    F.fireLight = light(F.engP, RGB(255, 140, 60), 22)
    -- 舱口：弹药架起火的火柱、火星
    F.hatch = {}
    for _ = 1, #F.spots.hatch do
      local p = mount(parent)
      table.insert(F.hatch, { p = p,
        jet = emitter(p, { tex = FIRE, col = ColorSequence.new({ ColorSequenceKeypoint.new(0, RGB(255, 246, 210)), ColorSequenceKeypoint.new(0.35, RGB(255, 170, 70)), ColorSequenceKeypoint.new(1, RGB(200, 60, 24)) }),
          size = NS({ NK(0, 1.6), NK(0.3, 3.2), NK(1, 1.0) }), life = { 0.35, 0.6 }, speed = { 22, 34 }, spread = 7, emit = 1, bright = 3.5, acc = V(0, 4, 0), drag = 1.2,
          tr = NS({ NK(0, 0.05), NK(0.6, 0.35), NK(1, 1) }) }),
        spark = emitter(p, { tex = GLOW, col = ColorSequence.new(RGB(255, 210, 140)), size = NS({ NK(0, 0.4), NK(1, 0.1) }), life = { 0.4, 0.9 }, speed = { 25, 45 }, spread = 32, emit = 1,
          bright = 3, vp = true, acc = V(0, -20, 0), drag = 0.4, tr = NS({ NK(0, 0), NK(1, 1) }) }) })
    end
    F.afLight = light(F.engP, RGB(255, 190, 110), 34)
    -- 泄压板：尾舱顶上的火柱
    if F.spots.bustle then
      F.bP = mount(parent)
      F.bJet = emitter(F.bP, { tex = FIRE, col = ColorSequence.new({ ColorSequenceKeypoint.new(0, RGB(255, 250, 225)), ColorSequenceKeypoint.new(0.3, RGB(255, 180, 80)), ColorSequenceKeypoint.new(1, RGB(210, 70, 28)) }),
        size = NS({ NK(0, 2.2), NK(0.4, 4.2), NK(1, 1.4) }), life = { 0.45, 0.75 }, speed = { 32, 46 }, spread = 5, emit = 1, bright = 3.5, acc = V(0, 6, 0), drag = 1.0,
        tr = NS({ NK(0, 0.05), NK(0.6, 0.3), NK(1, 1) }) })
      F.bSmoke = emitter(F.bP, { tex = SOOT, col = ColorSequence.new(RGB(255, 255, 255)), size = NS({ NK(0, 4), NK(1, 20) }), life = { 3, 5 }, speed = { 14, 20 }, spread = 8, acc = V(0, 5, 0),
        wind = true, tr = NS({ NK(0, 0.1), NK(1, 1) }) })
      F.bLight = light(F.bP, RGB(255, 200, 120), 40)
    end
    return F
  end
  local function off(F)
    if F.isOff then return end
    F.isOff = true
    setRate(F.engSmoke, 0) setRate(F.engBlack, 0) setRate(F.fire, 0) setRate(F.fireSmoke, 0)
    setB(F.fireLight, 0) setB(F.afLight, 0)
    for _, h in ipairs(F.hatch) do setRate(h.jet, 0) setRate(h.spark, 0) end
    if F.bJet then setRate(F.bJet, 0) setRate(F.bSmoke, 0) setB(F.bLight, 0) end
  end

  -- 泄压板泄了几次（WtBlow）：第一次看到这辆车时记下（后进来的人不重放以前的），以后一变就喷
  local blowSeen = setmetatable({}, { __mode = "k" })   -- [视图] = { n = 次数, t = 这次喷的时刻 }
  local acc = 0
  local function place(v, F)   -- 位置：发动机盖跟车身、舱口跟炮塔（WtDamage 的炮塔系：炮塔转轴、转角同 View）
    local d = v.def
    local tf = d.turret and (v.hullF * CF(d.turret.pivot) * CFrame.Angles(0, -math.rad(v.ty or 0), 0)) or v.hullF
    F.engP.CFrame = v.hullF * CF(F.spots.eng)
    for i, h in ipairs(F.hatch) do h.p.CFrame = (d.turret and tf or v.hullF) * CF(F.spots.hatch[i]) end
    if F.bP then F.bP.CFrame = tf * CF(F.spots.bustle) end
  end
  RunService.RenderStepped:Connect(function(dt)
    acc += dt
    local slow = acc >= 0.1   -- 状态、喷多少、火光：每秒 10 次
    if slow then acc = 0 end
    local t = os.clock()
    local cp = cam.CFrame.Position
    for em, v in pairs(G.views or {}) do
      if v.kind == "veh" and v.def and v.hullF and em.Parent then
        local F = fx[v]
        if slow then
          local d = v.def
          local near = not v.wrecked and (v.hullF.Position - cp).Magnitude < NEAR
          local engS = W.modState(em, d, "engine")
          local fire = em:GetAttribute("WtF") == true
          local af = em:GetAttribute("WtAF") == true
          local blowN = em:GetAttribute("WtBlow") or 0
          local bs = blowSeen[v]
          if not bs then
            bs = { n = blowN, t = nil }
            blowSeen[v] = bs
          elseif blowN ~= bs.n then
            bs.n, bs.t = blowN, t
          end
          local busy = engS < 2 or fire or af or (bs.t ~= nil and t - bs.t < 9)
          if near and busy and (not F or F.M ~= v.M) then
            local ok, r = pcall(build, v)
            if ok then
              F = r
              F.M = v.M
              fx[v] = F
            end
          end
          if F then
            F.live = near and busy
            if not F.live then off(F)
            else
              F.isOff = false
              -- 发动机烟：受损淡灰、打坏了黑烟
              setRate(F.engSmoke, (engS == 1) and 6 or 0)
              setRate(F.engBlack, (engS == 0) and 14 or 0)
              -- 起火：火苗一跳一跳、火光一闪一闪
              local k = 0.75 + 0.3 * math.sin(t * 13 + v.t) + 0.15 * math.sin(t * 31)
              setRate(F.fire, (fire and not af) and 34 * k or (af and 14 or 0))
              setRate(F.fireSmoke, fire and 10 or 0)
              setB(F.fireLight, fire and (2.2 * k) or 0)
              -- 弹药架起火：舱口火柱
              for _, h in ipairs(F.hatch) do
                setRate(h.jet, af and (95 * (0.8 + 0.4 * math.sin(t * 19 + h.p.Position.X))) or 0)
                setRate(h.spark, af and 45 or 0)
              end
              setB(F.afLight, af and (5 * k) or 0)
              -- 泄压板：WtBlow 一变就喷六七秒
              if F.bJet then
                local age = bs.t and (t - bs.t) or 99
                local q = (age < 6.5) and math.clamp(1 - (age - 3) / 3.5, 0.15, 1) or 0
                setRate(F.bJet, 140 * q)
                setRate(F.bSmoke, (age < 9) and 12 or 0)
                setB(F.bLight, 6 * q * k)
              end
            end
          end
        end
        if F and F.live then place(v, F) end
      end
    end
  end)

  ---------------------------------------------------------------- 自己的车：观瞄受损（开镜时）
  local gui = Instance.new("ScreenGui")
  gui.Name = "SightDamage"
  gui.ResetOnSpawn = false
  gui.IgnoreGuiInset = true
  gui.DisplayOrder = 6
  gui.Enabled = false
  gui.Parent = me:WaitForChild("PlayerGui")
  local root = Instance.new("Frame")
  root.Size, root.BackgroundTransparency = UDim2.fromScale(1, 1), 1
  root.Parent = gui
  local blur = nil
  local function crackSet(seed, n, heavy)
    local R = Random.new(seed)
    local f = Instance.new("Frame")
    f.Size, f.BackgroundTransparency = UDim2.fromScale(1, 1), 1
    f.Parent = root
    for _ = 1, n do   -- 每个裂点：十来道放射状裂纹 + 两圈碎的环
      local cx, cy = 0.3 + R:NextNumber() * 0.4, 0.28 + R:NextNumber() * 0.44
      for i = 1, heavy and 16 or 11 do
        local a = (i + R:NextNumber() * 0.6) / (heavy and 16 or 11) * 360
        local len = (heavy and 120 or 70) + R:NextNumber() * (heavy and 320 or 200)
        local l = Instance.new("Frame")
        l.AnchorPoint = Vector2.new(0, 0.5)
        l.Position = UDim2.new(cx, 0, cy, 0)
        l.Size = UDim2.fromOffset(len, (R:NextNumber() < 0.3) and 2 or 1)
        l.Rotation = a
        l.BorderSizePixel = 0
        l.BackgroundColor3 = (R:NextNumber() < 0.55) and RGB(235, 240, 245) or RGB(10, 10, 12)
        l.BackgroundTransparency = 0.35 + R:NextNumber() * 0.3
        l.Parent = f
      end
      for ring = 1, 2 do
        local rr = (heavy and 40 or 26) * ring + R:NextNumber() * 18
        for s = 1, 9 do
          local a = (s + R:NextNumber() * 0.4) / 9 * math.pi * 2
          local l = Instance.new("Frame")
          l.AnchorPoint = Vector2.new(0.5, 0.5)
          l.Position = UDim2.new(cx, math.cos(a) * rr, cy, math.sin(a) * rr)
          l.Size = UDim2.fromOffset(rr * 0.55, 1)
          l.Rotation = math.deg(a) + 90 + (R:NextNumber() - 0.5) * 30
          l.BorderSizePixel = 0
          l.BackgroundColor3 = RGB(225, 230, 235)
          l.BackgroundTransparency = 0.45
          l.Parent = f
        end
      end
      local dot = Instance.new("Frame")   -- 弹着点：一团白的碎渣
      dot.AnchorPoint = Vector2.new(0.5, 0.5)
      dot.Position = UDim2.new(cx, 0, cy, 0)
      dot.Size = UDim2.fromOffset(heavy and 34 or 20, heavy and 34 or 20)
      dot.BackgroundColor3 = RGB(230, 232, 236)
      dot.BackgroundTransparency = 0.35
      dot.BorderSizePixel = 0
      local c = Instance.new("UICorner")
      c.CornerRadius = UDim.new(0.5, 0)
      c.Parent = dot
      dot.Parent = f
    end
    for _ = 1, heavy and 6 or 3 do   -- 污渍：镜片上一块块发暗的地方
      local s = Instance.new("Frame")
      s.AnchorPoint = Vector2.new(0.5, 0.5)
      s.Position = UDim2.fromScale(0.2 + R:NextNumber() * 0.6, 0.2 + R:NextNumber() * 0.6)
      local r = (heavy and 160 or 100) + R:NextNumber() * 120
      s.Size = UDim2.fromOffset(r, r)
      s.BackgroundColor3 = RGB(8, 8, 8)
      s.BackgroundTransparency = heavy and 0.55 or 0.72
      s.BorderSizePixel = 0
      local c = Instance.new("UICorner")
      c.CornerRadius = UDim.new(0.5, 0)
      c.Parent = s
      s.Parent = f
    end
    f.Visible = false
    return f
  end
  local hurtSet, deadSet = crackSet(1101, 1, false), crackSet(2207, 3, true)
  local note = Instance.new("TextLabel")
  note.AnchorPoint = Vector2.new(0.5, 0)
  note.Position = UDim2.new(0.5, 0, 0, 66)
  note.Size = UDim2.fromOffset(420, 22)
  note.BackgroundTransparency = 1
  note.Font = Enum.Font.BuilderSansMedium
  note.TextSize = 16
  note.TextColor3 = RGB(255, 170, 90)
  note.TextStrokeTransparency = 0.4
  note.Text = ""
  note.Parent = root
  local optS = 2
  function G.opticsDead() return optS == 0 end
  RunService.RenderStepped:Connect(function()
    local st = G.drive
    local em = st and st.em
    local d = st and st.d
    local s = (em and d) and W.modState(em, d, "optics") or 2
    if s ~= optS then
      optS = s
      if G.sightReapply then pcall(G.sightReapply) end   -- 打坏了：热成像没了（Drive.lua 换回昼光）
    end
    local on = st ~= nil and st.sight == true and s < 2
    gui.Enabled = on
    hurtSet.Visible = on and s == 1
    deadSet.Visible = on and s == 0
    note.Text = on and ((s == 0) and (G.T and G.T("wt.optDead") or "") or (G.T and G.T("wt.optDmg") or "")) or ""
    if on and not blur then
      blur = Instance.new("BlurEffect")
      blur.Name = "SightDamageBlur"
      blur.Parent = Lighting
    end
    if blur then
      blur.Enabled = on
      blur.Size = (s == 0) and 9 or 3.5
    end
  end)
  G.sightDamageGui = function() return gui, hurtSet, deadSet end   -- 测试用
end

return WtVfx
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="297">
          <Properties>
            <string name="Name">WtVoice</string>
            <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场（客户端）——车组语音（用户 11-25「全部都做」⑬：战雷的「击穿！」「跳弹」「着火了」「炮长阵亡」「装填完毕」）
--   G.wtVoice(键)：一次说一句（排队最多两句，同一句 3 秒内不重复）。声音从哪来，按顺序试：
--   ① Config.WtVoice[键] 配了音频（rbxassetid://…，自己上传的录音）就放它；
--   ② 没配：用 Roblox 的文字转语音（AudioTextToSpeech，读英文——战雷默认的英文车组）；第一次用到某句时先加载好存起来
--   ③ 引擎没有文字转语音（老版本、测试台）：不出声（命中提示、损伤面板照旧写字）
--   谁调：WtHud（打出去的命中、自己挨打、换位、灭火、修好）、WtTank（装填完毕）
local RS = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local WtVoice = {}

function WtVoice.init(G)
  local Config = require(RS:WaitForChild("Config"))
  -- 每句：英文（文字转语音读）、语速（1 正常）
  local LINES = {
    pen = { "Penetration!", 1.1 }, ric = { "Ricochet!", 1.1 }, np = { "Not penetrated!", 1.1 }, kill = { "Target destroyed!", 1.05 },
    killAmmo = { "Ammo rack! Target destroyed!", 1.1 }, crit = { "Critical hit!", 1.1 }, hit = { "Hit!", 1.1 },
    hurtPen = { "We've been penetrated!", 1.15 }, hurtRic = { "Ricochet off our armor!", 1.15 }, fire = { "We're on fire!", 1.2 },
    fireOut = { "Fire's out.", 1 }, fixed = { "Repairs complete.", 1 },
    gnr = { "Gunner is down!", 1.15 }, drv = { "Driver is down!", 1.15 }, ldr = { "Loader is down!", 1.15 }, cmd = { "Commander is down!", 1.15 },
    loaded = { "Loaded!", 1.15 }, swap = { "Replacing crew member.", 1.05 }, resupply = { "Resupplying.", 1 },
    engine = { "Engine damaged!", 1.15 }, track = { "Track is broken!", 1.15 }, barrel = { "Barrel damaged!", 1.15 }, breech = { "Breech damaged!", 1.15 },
    spotted = { "We've been spotted!", 1.1 }, scout = { "Target spotted.", 1.05 },
  }
  local VCFG = (Config.WtVoice or {})
  local ttsOk = nil   -- nil 还没试、true 能用、false 没有
  local cache = {}    -- 键 → 已经加载好的 AudioTextToSpeech（或 Sound）
  local queue, busyTill, lastSaid = {}, 0, {}

  local folder = Instance.new("Folder")
  folder.Name = "WtVoice"
  folder.Parent = SoundService

  local function makeTts(key)
    local L = LINES[key]
    if not L then return nil end
    local ok, tts = pcall(function()
      local t = Instance.new("AudioTextToSpeech")
      t.Text = L[1]
      pcall(function() t.VoiceId = tostring(VCFG.voiceId or "1") end)
      pcall(function() t.Speed = L[2] or 1 end)
      pcall(function() t.Volume = VCFG.volume or 1.4 end)
      local out = Instance.new("AudioDeviceOutput")
      out.Parent = t
      local wire = Instance.new("Wire")
      wire.SourceInstance, wire.TargetInstance = t, out
      wire.Parent = t
      t.Parent = folder
      return t
    end)
    if not ok or not tts then ttsOk = false return nil end
    ttsOk = true
    task.spawn(function() pcall(function() tts:LoadAsync() end) end)
    return tts
  end
  local function makeSound(key)
    local id = VCFG[key]
    if type(id) ~= "string" or id == "" then return nil end
    local s = Instance.new("Sound")
    s.SoundId = id
    s.Volume = VCFG.volume or 1.4
    s.Parent = folder
    return s
  end
  local function get(key)
    if cache[key] ~= nil then return cache[key] or nil end
    local v = makeSound(key)
    if not v and ttsOk ~= false then v = makeTts(key) end
    cache[key] = v or false
    return v
  end
  local function say(key)
    local v = get(key)
    if not v then return end
    pcall(function()
      if v:IsA("Sound") then v:Play() else v:Play() end
    end)
  end

  function G.wtVoice(key)
    if VCFG.off or G.voiceOff or not LINES[key] then return end   -- 设置里关了车组语音
    local t = os.clock()
    if t - (lastSaid[key] or -9) < 3 then return end
    lastSaid[key] = t
    if #queue >= 2 then table.remove(queue, 1) end
    table.insert(queue, key)
  end
  G.wtVoiceTts = function() return ttsOk end   -- 测试用

  -- 一句一句说：一句约 1.3 秒（按字数估），说完再说下一句
  G.frameConn("WtVoice", function()
    local t = os.clock()
    if t < busyTill or #queue == 0 then return end
    local key = table.remove(queue, 1)
    G.try_(say, key)
    busyTill = t + 0.45 + #(LINES[key] and LINES[key][1] or "") * 0.055
  end)
end

return WtVoice
]]></ProtectedString>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="298">
          <Properties>
            <string name="Name">XrayOwn</string>
            <ProtectedString name="Source"><![CDATA[-- 全面大战场（客户端）——透视自己的车（按住 X 的 X 光）
--   用户 11-26：「x透视做的非常潦草 且没有显示」「x应该是摁住显示3d 松手就恢复原样 然后 不同区域要有不同颜色标识 发动机 弹药箱 成员 爆反等等」
--   用户 11-27：「x 透视不够细节」——里面照真车的布置画成一眼认得出来的样子（颜色、字体用 Theme，不照搬别的游戏的美术）：
--   · 乘员：零件拼的人（头、躯干、骨盆、上臂、前臂、大腿、小腿、脚），按角色摆姿势——驾驶员半躺着握操纵杆、炮长坐着脸贴瞄准镜目镜、
--     车长坐得高、头伸进指挥塔，装填手站着朝着炮尾；大小按 WtDamage 的乘员盒子缩放，上下夹在车体底板和车顶 / 炮塔顶之间（不穿出车体）
--   · 弹药：一发一发的弹（弹体 + 弹头两种颜色；脱壳穿甲弹的弹头细长、破甲 / 榴弹的粗），发数按这辆车现在的弹（客户端 vs.ammo、
--     车上的 Rdy / RdyCap / AmL），打一发少一发，拿不到按满架画。转盘自动装弹机（WtDamage.CAROUSEL）画炮塔底下一圈：
--     T-72 / 90 / 96 / 99A 弹丸、药筒上下两层平躺，T-64 / T-80（篮子式）弹丸平躺、药筒竖着围在外圈；分装弹的车体弹架一格弹丸一格药筒；
--     机关炮、机枪画弹箱，榴弹炮画一发发弹丸，导弹 / 火箭画发射筒
--   · 发动机：柴油机 = 曲轴箱 + V 形两排气缸 + 缸盖罩 + 排气歧管和每缸的支管 + 增压器 + 顶上两个风扇 + 两侧散热器（T-64 / 72 / 90 / 96 / 99A 横置）；
--     燃气轮机（VehDefs turbine：M1、T-80）= 圆柱形的进气机匣、压气机、涡轮、回热器 + 排气道、空滤
--   · 传动：变速箱 + 两头转向机 + 通到主动轮的两根半轴 + 侧减速器（轮式车：传动轴 + 每根车桥）；油箱：圆角油箱（又宽又扁的画成鞍形）
--   · 炮：炮闩（摇架、耳轴、两根后坐筒、炮尾、闩体、防危板）、炮管（粗细两段、隔热套的箍、抽烟装置 / 炮口制退器的鼓包，画到炮口）、
--     并列机枪——跟着炮塔方位和炮的俯仰（用 View 的车体 / 炮塔 / 炮框架，俯仰、后坐都跟原模型对得上；没有 View 按 st.ty / st.gp 算）
--   · 炮塔驱动（座圈齿圈 + 电机 + 减速箱 + 小齿轮）、观瞄（炮长镜的镜头、窗口、镜筒一直到炮长眼前；车长周视镜、M1 的车长热像仪）、
--     履带（负重轮、主动轮、诱导轮、上下履带）/ 车轮、载员舱（两条长凳 + 坐着的步兵）；爆反块照旧用模型上真的块（VehModels 的 M.era）
--   · 状态（服务器写在车上的 WtC / WtM / WtF / WtAF，同战后 X 光回放）：完好按类别色；受损琥珀、打坏红、乘员阵亡深色；
--     起火一闪一闪的火光色（WtF：发动机、油箱；WtAF：弹药架）
--   · 屏幕：下面一排图例（这辆车有的类别 + 状态）；鼠标指着哪个部件，旁边写它的名字、状态（弹药架写还剩几发、指着的是哪种弹）
--   · 性能：零件对象池（松手收回、下次按住直接拿来用）；只在按住 X 时建、松手全清（零件收回、Highlight / 图例删掉、车身透明度还原）；
--     每帧只算 CFrame、一次 BulkMoveTo；Highlight 按类别分组（二十来个，Roblox 上限 31）；一辆车最多 600 个零件（弹多的车一发弹一个零件）
--   11-27 审查后补的：按住 X 时 Drive 放开鼠标、画出指针（镜头、炮塔这段时间不跟鼠标转），指哪个部件写哪个（原来鼠标锁在屏幕中间、只指得到炮管）；
--     手机上按住「透视」键，另一只手指点一下部件；车长坐到指挥塔正下方，头够不着指挥塔就不抬（不从炮塔顶冒出去）；转盘车的乘员踩在转盘的弹上面、
--     篮子式的竖药筒围在人脚外圈；乘员状态按座位（换了座的跟着人走）；AmL 变了按现在的弹重排弹名、弹头；加特林画转膛机匣；BMP / 布雷德利的反坦克导弹发射架；
--     车辆热成像（Night.lua 的 1 + 24 个 Highlight）按住 X 时让开；每帧在 init.client.lua 的 steps 里 View 之后摆（G.stepOwnXray，不晚一帧）
--   共用（XrayOwn.crewSpecs）：WtHud 的战后 X 光回放也用这套人形画乘员
local RS = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local XrayOwn = {}

local V3, CF, ANG = Vector3.new, CFrame.new, CFrame.Angles
local PI, RAD = math.pi, math.rad
local MS = 2.8      -- 1 米 = 2.8 格
local LIMIT = 600   -- 一辆车的透视零件上限
local MAXG = 28     -- 透视最多建几组 Highlight（Roblox 一个画面最多 31 个，车身轮廓线占一个）
XrayOwn.LIMIT, XrayOwn.MAXG = LIMIT, MAXG
-- 篮子式自动装弹机（T-64 / T-80）：弹丸平躺、药筒竖着围在外圈；别的转盘车（T-72 / 90 / 96 / 99A）弹丸、药筒上下两层平躺
local MZ = { t64a = true, t64b = true, t80b = true, t80u = true, t80bvm = true }
-- 转盘里的弹（格）：弹径（125 毫米）、离转盘底板多高开始放、竖药筒多高（篮子式）；乘员的地板、竖药筒围多大一圈也按这几个数算
local CAR_DIA, CAR_Y0, CAR_CH = 0.35, 0.1, 1.3
local CUP_R = 0.625   -- 车长指挥塔那一圈观察镜的半径（同下面画的那一圈：直径 1.25）
local CORNERS = {}   -- 方盒的八个角（± 半边长）
for _, sx in ipairs({ -1, 1 }) do for _, sy in ipairs({ -1, 1 }) do for _, sz in ipairs({ -1, 1 }) do CORNERS[#CORNERS + 1] = Vector3.new(sx, sy, sz) end end end
-- 自己一组 Highlight 的子件（颜色跟大类不一样、要一眼分得出的）：弹头、发动机的深色件（排气、风扇、缸盖）、炮闩 / 炮管的鼓包和箍、观瞄的玻璃
local SUBOK = { engine_dk = true, breech_dk = true, barrel_dk = true, ammo_tip = true, optics_gl = true }
XrayOwn.SUBOK = SUBOK
-- 标识色（用户 11-28「给弹药 发动机都搞一下特殊颜色的标识吧 我自己x透视自己也要能看这个」「这个颜色你可以做的和战雷有些区别」）：
--   弹药洋红、发动机电光蓝——一眼就跳出来，也不是战雷那套橙 / 绿；跟状态色（受损黄、打坏红 / 黑、阵亡红、起火橙）一个都不撞。
--   按 X 的自己车透视、打别人的命中回放（WtHud.lua）用同一套
XrayOwn.MARK = { ammo = Color3.fromRGB(236, 62, 196), engine = Color3.fromRGB(46, 156, 255) }

local mods = {}
local function req(name)
  local m = mods[name]
  if m == nil then
    m = require(RS:WaitForChild(name))
    mods[name] = m
  end
  return m
end
local function clampS(v, a, b)   -- 上下界可能倒过来（小车）：倒了取中间
  if a > b then return (a + b) / 2 end
  return math.clamp(v, a, b)
end

---------------------------------------------------------------- 形状（纯数据：零件大小、相对所在框架的 CFrame、形状、子组）

-- 一件：s 大小、cf 在框架里的位置、sh 形状（B 方块、S 球、C 圆柱——Roblox 的圆柱沿 X 轴）、g 子组（dk 深色件、tip 弹头、gl 玻璃）
local function put(L, size, cf, sh, g)
  local s = { s = V3(math.max(size.X, 0.04), math.max(size.Y, 0.04), math.max(size.Z, 0.04)), cf = cf, sh = sh or "B", g = g }
  L[#L + 1] = s
  return s
end
local function blk(L, size, pos, g, rot) return put(L, size, rot and (CF(pos) * rot) or CF(pos), "B", g) end
local function ball(L, dia, pos, g) return put(L, V3(dia, dia, dia), CF(pos), "S", g) end
local function upFor(dv) return (math.abs(dv.Y) > 0.7 * dv.Magnitude) and V3(0, 0, 1) or V3(0, 1, 0) end
-- 圆柱：从 a 到 b，直径 dia
local function rod(L, a, b, dia, g)
  local dv = b - a
  local len = dv.Magnitude
  if len < 0.02 then return nil end
  return put(L, V3(len, dia, dia), CFrame.lookAt((a + b) / 2, b, upFor(dv)) * ANG(0, PI / 2, 0), "C", g)
end
-- 方条：从 a 到 b，截面 w（横）× h（竖）
local function bar(L, a, b, w, h, g)
  local dv = b - a
  local len = dv.Magnitude
  if len < 0.02 then return nil end
  return put(L, V3(w, h, len), CFrame.lookAt((a + b) / 2, b, upFor(dv)), "B", g)
end
-- 轴朝上的圆盘
local function disc(L, pos, dia, h, g) return put(L, V3(h, dia, dia), CF(pos) * ANG(0, 0, PI / 2), "C", g) end
local function mark(L, n0, slot) for j = n0 + 1, #L do L[j].slot = slot end end

---------------------------------------------------------------- 人

-- 尺寸（米）：躯干（胯到脖子根）、脖子、头、肩宽、胯宽、上臂、前臂（带手）、大腿、小腿、脚
local BONE = { torso = 0.5, neck = 0.07, head = 0.23, sh = 0.4, hip = 0.28, uarm = 0.3, farm = 0.33, thigh = 0.45, shin = 0.44, foot = 0.24 }
local function U(x, y, z) return V3(x, y, z).Unit end
-- 各角色的姿势：各段朝哪（人自己的坐标：x 右、y 上、−z 朝前；左边那只按 x 镜像，带 R 的是右边单给的）；seat 胯离乘员盒子底多高（格）
local POSE = {
  -- 驾驶员：靠背往后倒四十来度、半躺着，膝盖抬起、脚往前伸到踏板，两手往前握操纵杆
  drv = { spine = U(0, 0.78, 0.62), head = U(0, 0.94, 0.34), uarm = U(0.16, -0.5, -0.85), farm = U(-0.1, 0.22, -0.97),
    thigh = U(0, 0.2, -0.98), shin = U(0, -0.56, -0.83), foot = U(0, 0.35, -0.94), seat = 0.55 },
  -- 炮长：坐着、身子往前探、低着头把脸贴在瞄准镜目镜上，两手握着操纵台
  gnr = { spine = U(0, 0.94, -0.34), head = U(0, 0.8, -0.6), uarm = U(0.12, -0.45, -0.88), farm = U(-0.06, 0.4, -0.92),
    thigh = U(0, -0.05, -1), shin = U(0, -0.96, -0.27), foot = U(0, -0.12, -0.99), seat = 0.42 },
  -- 车长：坐得高（座椅升起来），身子直、头伸进指挥塔；右手往上扶着周视镜的手柄
  cmd = { spine = U(0, 1, 0.03), head = U(0, 1, -0.05), uarm = U(0.22, -0.4, -0.89), farm = U(-0.12, 0.42, -0.9),
    uarmR = U(0.18, 0.55, -0.82), farmR = U(-0.08, 0.5, -0.86), thigh = U(0, -0.32, -0.95), shin = U(0, -1, 0.1), foot = U(0, -0.1, -0.99), high = true },
  -- 装填手：站着、身子稍往前，两手在腰前（捧着一发弹装进炮尾的样子）
  ldr = { spine = U(0, 0.99, -0.15), head = U(0, 0.97, -0.25), uarm = U(0.08, -0.82, -0.57), farm = U(-0.2, 0.22, -0.95),
    thigh = U(0, -1, -0.05), shin = U(0, -1, 0.04), foot = U(0, -0.04, -1), stand = true },
  -- 载员舱里坐着的步兵（简化：头、躯干、并拢的大腿、小腿）
  troop = { spine = U(0, 1, 0.08), head = U(0, 1, -0.02), uarm = U(0.08, -0.92, -0.38), farm = U(0, -0.15, -0.99),
    thigh = U(0, -0.04, -1), shin = U(0, -1, 0.06), foot = U(0, -0.05, -1), seat = 0.5 },
}
XrayOwn.POSE = POSE
-- 一个人：返回零件表（相对胯中心）、最低点、最高点（头顶或举起来的手，都相对胯）、头的中心、最靠前的一点（z）
--   lean：上身往哪边歪（水平的一个小向量，加到躯干、头的方向上；腿不动）——车长胯往里挪、头还凑在指挥塔底下
local function person(pose, sc, simple, lean)
  local L = {}
  local k = MS * sc
  local sp, hd = pose.spine, pose.head
  if lean then sp, hd = (sp + lean).Unit, (hd + lean).Unit end
  local N = sp * (BONE.torso * k)   -- 脖子根
  local headC = N + hd * ((BONE.neck + BONE.head / 2) * k)
  local lowY, minZ, hiY = -0.05 * k, 0, headC.Y + BONE.head / 2 * k
  local function see(p)
    if p.Y < lowY then lowY = p.Y end
    if p.Z < minZ then minZ = p.Z end
    if p.Y + 0.05 * k > hiY then hiY = p.Y + 0.05 * k end
  end
  ball(L, BONE.head * k, headC)
  bar(L, sp * (0.1 * k), N, 0.36 * k, 0.21 * k)                                       -- 躯干
  if not simple then bar(L, sp * (-0.07 * k), sp * (0.13 * k), 0.32 * k, 0.22 * k) end   -- 骨盆
  for side = -1, 1, 2 do
    local function m(v) return V3(v.X * side, v.Y, v.Z) end
    local Sh = N - sp * (0.06 * k) + V3(side * BONE.sh / 2 * k, 0, 0)
    local El = Sh + m((side > 0 and pose.uarmR) or pose.uarm) * (BONE.uarm * k)
    local Hd = El + m((side > 0 and pose.farmR) or pose.farm) * (BONE.farm * k)
    local Hp = V3(side * BONE.hip / 2 * k, -0.03 * k, 0)
    local Kn = Hp + m(pose.thigh) * (BONE.thigh * k)
    local An = Kn + m(pose.shin) * (BONE.shin * k)
    local To = An + m(pose.foot) * (BONE.foot * k)
    see(Hd) see(Kn) see(An - V3(0, 0.07 * k, 0)) see(To - V3(0, 0.07 * k, 0))
    if not simple then
      bar(L, Sh, El, 0.1 * k, 0.1 * k)                                               -- 上臂
      bar(L, El, Hd, 0.085 * k, 0.085 * k)                                           -- 前臂（带手）
      bar(L, Hp, Kn, 0.15 * k, 0.15 * k)                                             -- 大腿
      bar(L, Kn, An, 0.11 * k, 0.11 * k)                                             -- 小腿
      bar(L, An - V3(0, 0.035 * k, 0), To - V3(0, 0.035 * k, 0), 0.1 * k, 0.08 * k)  -- 脚
    elseif side > 0 then
      bar(L, V3(0, Hp.Y, 0), V3(0, Kn.Y, Kn.Z), 0.32 * k, 0.15 * k)                 -- 两条大腿并成一块
      bar(L, V3(0, Kn.Y, Kn.Z), V3(0, An.Y, An.Z), 0.28 * k, 0.12 * k)               -- 小腿
    end
  end
  return L, lowY, hiY, headC, minZ
end

---------------------------------------------------------------- 车里的尺寸（底座系：底面中心、y 上、−z 朝前；炮塔系：相对炮塔转轴）

local function mkCtx(d, lay)
  local T = d.turret
  local ctx = { d = d, lay = lay, byK = {}, hH = lay.hH, ts = lay.ts, tp = (T and T.pivot) or V3(0, lay.hH, 0), fl = (d.clear or 1.2) + 0.25 }
  for _, it in ipairs(lay.list) do ctx.byK[it.k] = it end
  -- 炮塔顶（底座系）：转轴比车顶低的车（BMP-2、猎豹：转轴定在车体底板附近）按车顶往上算
  ctx.turTop = math.max(ctx.hH, ctx.tp.Y) + ctx.ts.Y
  -- 主动轮在变速箱那头（侧减速器、半轴也通到那儿）
  local rw = d.rw
  local tr = ctx.byK.trans
  ctx.xIn = d.W / 2 - d.W * 0.13
  ctx.ySp = rw and ((rw.y or rw.r) + rw.r * 0.55) or (d.wr or 1.2)
  local zSp = tr and ((tr.lo.Z + tr.hi.Z) / 2) or (d.L / 2 - 1)
  if rw then
    local z0, z1 = math.min(rw.z0, rw.z1), math.max(rw.z0, rw.z1)
    if zSp >= 0 then zSp = clampS(zSp, z1 + rw.r * 0.9, d.L / 2 - rw.r * 0.7)
    else zSp = clampS(zSp, -d.L / 2 + rw.r * 0.7, z0 - rw.r * 0.9) end
  end
  ctx.zSp = zSp
  -- 篮子式转盘的竖药筒最外能放到离转轴多远：两边履带里面（比 WtDamage 的弹药盒子宽一点，真车药筒贴着炮塔座圈）
  ctx.carRmax = ctx.xIn - math.abs(ctx.tp.X) - CAR_DIA / 2 - 0.05
  return ctx
end

---------------------------------------------------------------- 各件的样子

-- 乘员（返回炮长的头：炮长镜的目镜对着它）
local function crewItem(x, ctx)
  local it, d = x.it, ctx.d
  local role = it.role or it.k
  local pose = POSE[role] or POSE.gnr
  if not it.tur and role == "gnr" then pose = POSE.ldr end     -- 车体上的机枪手（悍马顶上的枪塔）：站着
  if not it.tur and role == "cmd" then pose = POSE.troop end   -- 车体里坐着的车长（轻型车副驾驶）：坐直
  local size = it.hi - it.lo
  local c = (it.lo + it.hi) / 2
  local sc0 = math.clamp(math.min(size.X / 1.7, size.Y / 2.7, size.Z / 1.7), 0.55, 1.3)
  -- 车长坐到指挥塔正下方（左右夹在「炮塔半宽 − 肩宽」以内，不探出炮塔侧壁）；头离指挥塔中心不超过它的半径才伸进指挥塔，
  --   不然顶到炮塔顶为止（原来只往指挥塔挪半格、头却抬到指挥塔的高度：T-64、T-80 的车长脑袋从指挥塔旁边的炮塔顶冒出去）
  --   指挥塔在另一边的（勒克莱尔、10 式：车长盒子在右、指挥塔在左）不挪，免得坐到炮长身上
  local cup = (role == "cmd" and it.tur and d.cupola) or nil
  local headXZ = nil
  if cup and (cup.X * c.X >= 0 or math.abs(cup.X - c.X) < 1.2) then
    local xm = math.max(0, ctx.ts.X / 2 - BONE.sh * MS * sc0)
    local zm = math.max(0, ctx.ts.Z / 2 - 0.6)
    headXZ = V3(math.clamp(cup.X, -xm, xm), 0, math.clamp(cup.Z, -zm, zm))
  end
  local function offCup(p) return cup and V3(p.X - cup.X, 0, p.Z - cup.Z).Magnitude or math.huge end
  local useCup = headXZ ~= nil and offCup(headXZ) <= CUP_R
  -- 转盘自动装弹机：炮塔里的人踩在转盘的弹上面（真车乘员踩着转盘的盖板）——T-72 / 90 / 96 / 99A 两层平躺的弹：弹药架的顶；
  --   T-64 / T-80 篮子式：平躺的弹丸那一层的顶，竖着的药筒那一层高度以下人离转轴不超过 limR（药筒围在人脚外圈，见 carouselRack）
  local am = ctx.byK.ammo
  local car = it.tur and req("WtDamage").CAROUSEL[d.id] and am and not am.tur
  local carFloor, limR, yLim = nil, nil, nil
  if car then
    carFloor = (MZ[d.id] and (am.lo.Y + CAR_Y0 + CAR_DIA + 0.06) or (am.hi.Y + 0.02)) - ctx.tp.Y + 0.03   -- 车体系的高度换到炮塔系
    if MZ[d.id] then
      limR = ctx.carRmax - CAR_DIA / 2 - 0.06
      yLim = am.lo.Y + CAR_Y0 + CAR_DIA * 1.55 + CAR_CH - ctx.tp.Y
    end
  end
  -- 摆一次：shift 胯往哪挪（炮塔系水平）、lean 上身歪多少、cupOn 头伸不伸进指挥塔
  local function fit(shift, lean, cupOn)
    local sc = sc0
    local floor, roof
    if it.tur then
      floor, roof = ctx.fl - ctx.tp.Y + 0.05, ctx.turTop - ctx.tp.Y - 0.08
      if carFloor then floor = math.max(floor, carFloor) end
      if cupOn then roof = math.max(roof + 0.08, cup.Y) + 0.45 end   -- 头伸进指挥塔
    else
      floor, roof = ctx.fl + 0.02, ctx.hH - 0.03
    end
    if it.hi.Y + 0.2 > roof then roof = it.hi.Y + 0.2 end   -- 站在车顶枪塔里的机枪手（悍马）
    roof = math.min(roof, d.H - (it.tur and ctx.tp.Y or 0) - 0.05)   -- 怎么都不高过整车
    if roof < floor + 1 then roof = floor + 1 end
    local L, low, top, headC, minZ = person(pose, sc, false, lean)
    if top - low > roof - floor then   -- 塞不下：整个人缩小
      sc = sc * (roof - floor) / (top - low)
      L, low, top, headC, minZ = person(pose, sc, false, lean)
    end
    local hipY
    if pose.stand then hipY = floor - low
    elseif pose.high then hipY = roof - 0.08 - top
    else hipY = it.lo.Y + (pose.seat or 0.5) * sc end
    hipY = clampS(hipY, floor - low, roof - top)
    local N = pose.spine * (BONE.torso * MS * sc)
    local hip = V3(c.X, hipY, c.Z - N.Z / 2) + shift   -- 躯干在盒子中间、腿往前伸
    if headXZ then   -- 车长：头在指挥塔正下方（胯往里挪了 shift、上身往回歪 lean：头还在那儿；歪不了那么多的头跟着往里）
      local h0 = N + pose.head * ((BONE.neck + BONE.head / 2) * MS * sc)
      hip = V3(headXZ.X - h0.X, hipY, headXZ.Z - h0.Z) + shift
    end
    if not it.tur then   -- 车体里的（驾驶员）：脚别伸出车头
      local front = -d.L / 2 + 0.45
      if hip.Z + minZ < front then hip = hip + V3(0, 0, front - (hip.Z + minZ)) end
    end
    local place = CF(hip)
    if role == "ldr" and d.gun and it.tur then   -- 装填手朝着炮尾
      local tgt = d.gun.pivot + V3(0, 0, 1.4)
      local dv = V3(tgt.X - hip.X, 0, tgt.Z - hip.Z)
      if dv.Magnitude > 0.3 then place = CFrame.lookAt(hip, hip + dv) end
    end
    for _, s in ipairs(L) do s.cf = place * s.cf end
    return { L = L, head = place * headC, sc = sc }
  end
  -- 竖药筒那一层高度以下离转轴最远的一点：超出 limR 多少、往哪边
  local function excess(L)
    local best, dir = -math.huge, V3(1, 0, 0)
    for _, s in ipairs(L) do
      local h = s.s / 2
      for _, k in ipairs(CORNERS) do
        local p = s.cf * (h * k)
        if p.Y < yLim then
          local r = math.sqrt(p.X * p.X + p.Z * p.Z)
          if r > best then best, dir = r, (r > 1e-3) and V3(p.X / r, 0, p.Z / r) or dir end
        end
      end
    end
    return best - limR, dir
  end
  local shift, lean = V3(), nil
  local r
  for _ = 1, 6 do
    r = fit(shift, lean, useCup)
    local again = false
    if limR then
      local exc, dir = excess(r.L)
      if exc > 0.005 then   -- 人脚伸进竖药筒那一圈：整个人往转轴挪；车长胯挪进来、上身往指挥塔那边歪（最多二十来度）
        shift = shift - dir * (exc + 0.03)
        if headXZ then
          local Lh = (BONE.torso + BONE.neck + BONE.head / 2) * MS * r.sc
          lean = -shift / Lh
          if lean.Magnitude > 0.36 then lean = lean.Unit * 0.36 end
        end
        again = true
      end
    end
    if not again and useCup and offCup(r.head) > CUP_R + 1e-3 then useCup, again = false, true end   -- 歪到头了头还够不着指挥塔：不抬
    if not again then break end
  end
  x.specs = r.L
  if role == "gnr" and it.tur then ctx.gnrHead = r.head end
end

-- 柴油机（本地坐标：盒子中心为原点，曲轴沿 z，+z 朝变速箱）
local function diesel(L, S)
  local w, h, l = S.X, S.Y, S.Z
  local y0 = -h / 2
  blk(L, V3(w * 0.5, h * 0.36, l * 0.8), V3(0, y0 + h * 0.27, 0))                    -- 曲轴箱
  blk(L, V3(w * 0.36, h * 0.1, l * 0.62), V3(0, y0 + h * 0.05, 0), "dk")             -- 油底壳
  for s = -1, 1, 2 do
    local tilt = ANG(0, 0, -s * RAD(30))
    local up = V3(s * 0.5, 0.866, 0)
    local bc = V3(s * w * 0.16, y0 + h * 0.57, 0)
    put(L, V3(w * 0.21, h * 0.34, l * 0.74), CF(bc) * tilt)                          -- 一排气缸（V 形，各往外倒 30°）
    put(L, V3(w * 0.18, h * 0.07, l * 0.7), CF(bc + up * (h * 0.205)) * tilt, "B", "dk")   -- 缸盖罩
    local xm, ym = s * w * 0.4, y0 + h * 0.5
    rod(L, V3(xm, ym, -l * 0.37), V3(xm, ym, l * 0.36), h * 0.11, "dk")              -- 排气歧管
    for i = 1, 6 do                                                                 -- 每缸一根排气支管
      local z = -l * 0.31 + (i - 1) / 5 * l * 0.62
      rod(L, bc + V3(s * w * 0.1, -h * 0.02, z), V3(xm, ym, z), h * 0.065, "dk")
    end
    rod(L, V3(s * w * 0.32, y0 + h * 0.8, -l * 0.36), V3(s * w * 0.44, y0 + h * 0.8, -l * 0.36), h * 0.2, "dk")   -- 涡轮增压器
    blk(L, V3(w * 0.06, h * 0.38, l * 0.46), V3(s * w * 0.47, y0 + h * 0.75, l * 0.18))   -- 散热器
    local fc = V3(s * w * 0.24, y0 + h * 0.94, l * 0.18)                             -- 风扇（顶上，冷却风从发动机盖进出）
    local fd = math.min(w * 0.4, l * 0.42)
    disc(L, fc, fd, h * 0.05)
    bar(L, fc + V3(-fd * 0.45, h * 0.035, 0), fc + V3(fd * 0.45, h * 0.035, 0), fd * 0.12, h * 0.02, "dk")   -- 扇叶
    bar(L, fc + V3(0, h * 0.035, -fd * 0.45), fc + V3(0, h * 0.035, fd * 0.45), fd * 0.12, h * 0.02, "dk")
  end
  blk(L, V3(w * 0.1, h * 0.12, l * 0.66), V3(0, y0 + h * 0.7, 0))                    -- 进气管（两排中间）
  rod(L, V3(0, y0 + h * 0.3, l * 0.4), V3(0, y0 + h * 0.3, l * 0.5), h * 0.52, "dk")   -- 飞轮壳（接变速箱）
end
-- 燃气轮机（本地坐标同上）：圆柱形的机身沿 z 躺着，前面进气、后面回热器最粗
local function turbine(L, S)
  local w, h, l = S.X, S.Y, S.Z
  local y0 = -h / 2
  local yc = y0 + h * 0.44
  local D = math.min(w * 0.55, h * 0.7)
  rod(L, V3(0, yc, -l * 0.44), V3(0, yc, -l * 0.27), D * 1.1)                        -- 进气机匣
  rod(L, V3(0, yc, -l * 0.27), V3(0, yc, l * 0.06), D * 0.9)                         -- 压气机、燃烧室
  rod(L, V3(0, yc, l * 0.06), V3(0, yc, l * 0.16), D, "dk")                          -- 涡轮
  rod(L, V3(0, yc, l * 0.16), V3(0, yc, l * 0.42), D * 1.22)                         -- 回热器
  for _, f in ipairs({ -0.2, -0.1, 0, 0.26, 0.34 }) do                               -- 机匣上一道道的环
    rod(L, V3(0, yc, l * f - 0.05), V3(0, yc, l * f + 0.05), D * ((f > 0.15) and 1.26 or 0.95), "dk")
  end
  blk(L, V3(w * 0.44, h * 0.3, l * 0.14), V3(0, y0 + h * 0.84, l * 0.36), "dk")      -- 排气道（往上通到发动机盖的百叶窗）
  blk(L, V3(w * 0.3, h * 0.24, l * 0.16), V3(0, y0 + h * 0.12, -l * 0.3))            -- 附件齿轮箱
  blk(L, V3(w * 0.34, h * 0.32, l * 0.1), V3(0, y0 + h * 0.2, l * 0.46))             -- 减速器（接变速箱）
  for s = -1, 1, 2 do
    blk(L, V3(w * 0.22, h * 0.36, l * 0.36), V3(s * w * 0.37, y0 + h * 0.72, -l * 0.22))   -- 空滤
    rod(L, V3(s * w * 0.25, yc, -l * 0.1), V3(s * w * 0.37, y0 + h * 0.6, -l * 0.18), h * 0.12)   -- 空滤出来的进气管
    local fc = V3(s * w * 0.3, y0 + h * 0.94, l * 0.2)
    local fd = math.min(w * 0.3, l * 0.3)
    disc(L, fc, fd, h * 0.05)                                                        -- 机油散热器的风扇
    bar(L, fc + V3(-fd * 0.45, h * 0.035, 0), fc + V3(fd * 0.45, h * 0.035, 0), fd * 0.12, h * 0.02, "dk")
  end
end
local function engineItem(x, ctx)
  local it, d = x.it, ctx.d
  local lo, hi = it.lo, it.hi
  local S, c = hi - lo, (lo + hi) / 2
  local tr = ctx.byK.trans
  local tz = tr and ((tr.lo.Z + tr.hi.Z) / 2) or (c.Z + 1)
  local W = req("WtDamage")
  local frame, sz
  if W.CAROUSEL[d.id] and not d.turbine then   -- 苏 / 俄 / 中国的 V 型柴油机横着放
    frame, sz = CF(c) * ANG(0, PI / 2, 0), V3(S.Z, S.Y, S.X)
  else
    frame, sz = CF(c) * ((tz >= c.Z) and CF() or ANG(0, PI, 0)), S
  end
  local L = {}
  if d.turbine then turbine(L, sz) else diesel(L, sz) end
  for _, s in ipairs(L) do s.cf = frame * s.cf end
  x.specs = L
  x.detail = d.turbine and "xr.d.turbine" or "xr.d.diesel"
end

local function transItem(x, ctx)
  local it, d = x.it, ctx.d
  local lo, hi = it.lo, it.hi
  local S, c = hi - lo, (lo + hi) / 2
  local L = {}
  blk(L, V3(S.X * 0.4, S.Y * 0.8, S.Z * 0.8), c)                                     -- 变速箱
  if d.arch == "wheeled" and d.axles and #d.axles > 0 then
    local wr = d.wr or 1.3
    local zs = {}
    for _, z in ipairs(d.axles) do zs[#zs + 1] = z end
    table.sort(zs)
    local far = (math.abs(zs[1] - c.Z) > math.abs(zs[#zs] - c.Z)) and zs[1] or zs[#zs]
    rod(L, V3(c.X, c.Y - S.Y * 0.2, c.Z), V3(0, wr + 0.1, far), math.max(0.16, S.Y * 0.16))   -- 传动轴
    local wx = (d.wx or d.W * 0.38) - (d.ww or 1) / 2
    for _, z in ipairs(zs) do
      ball(L, math.min(0.8, S.Y * 0.7), V3(0, wr, z), "dk")                          -- 差速器
      rod(L, V3(-wx, wr, z), V3(wx, wr, z), 0.24)                                    -- 车桥
    end
  else
    for s = -1, 1, 2 do
      rod(L, c + V3(s * S.X * 0.2, 0, 0), c + V3(s * S.X * 0.28, 0, 0), S.Y * 0.88, "dk")   -- 两头的转向机
      local fd = V3(s * (ctx.xIn - 0.2), ctx.ySp, ctx.zSp)
      rod(L, c + V3(s * S.X * 0.28, 0, 0), fd, math.max(0.16, S.Y * 0.2))            -- 半轴（通到主动轮）
      rod(L, fd - V3(s * 0.18, 0, 0), fd + V3(s * 0.22, 0, 0), S.Y * 0.78, "dk")      -- 侧减速器
    end
  end
  x.specs = L
end

-- 履带（负重轮、主动轮、诱导轮、上下履带）/ 车轮
local function trackItem(x, ctx)
  local it, d = x.it, ctx.d
  local lo, hi = it.lo, it.hi
  local side = (it.k == "trackL") and -1 or 1
  local L = {}
  local rw = d.rw
  if d.arch == "tracked" and rw and (rw.n or 0) > 0 then
    local xc = side * (rw.x or math.abs((lo.X + hi.X) / 2))   -- 负重轮那一列（VehDefs 照模型量的）
    local tw = (hi.X - lo.X) * 0.82
    local x0, x1 = xc - tw / 2, xc + tw / 2
    local n, r = rw.n, rw.r
    local y = rw.y or r
    for i = 1, n do
      local z = rw.z0 + ((n > 1) and ((i - 1) / (n - 1)) or 0.5) * (rw.z1 - rw.z0)
      rod(L, V3(x0, y, z), V3(x1, y, z), r * 1.8)                                    -- 负重轮
    end
    local z0, z1 = math.min(rw.z0, rw.z1), math.max(rw.z0, rw.z1)
    local zS = ctx.zSp
    local zI = (zS >= 0) and clampS(z0 - r * 1.6, lo.Z + r, z0 - r) or clampS(z1 + r * 1.6, z1 + r, hi.Z - r)
    local yS, yI, rS, rI = y + r * 0.55, y + r * 0.35, r * 0.85, r * 0.75
    rod(L, V3(x0, yS, zS), V3(x1, yS, zS), rS * 2)                                   -- 主动轮
    rod(L, V3(x0, yI, zI), V3(x1, yI, zI), rI * 2)                                   -- 诱导轮
    local zF, yF, rF, zR, yR, rR = zI, yI, rI, zS, yS, rS
    if zS < zI then zF, yF, rF, zR, yR, rR = zS, yS, rS, zI, yI, rI end
    local t = 0.13
    local zA, zB = z0 - r * 0.2, z1 + r * 0.2
    local topY = math.max(yF + rF, yR + rR, y + r + 0.08) + t / 2
    bar(L, V3(xc, t / 2, zA), V3(xc, t / 2, zB), tw, t)                              -- 下面一段（着地）
    bar(L, V3(xc, topY, zF), V3(xc, topY, zR), tw, t)                                -- 上面一段
    bar(L, V3(xc, yF, zF - rF), V3(xc, t / 2, zA), tw, t)                            -- 前头绕下来
    bar(L, V3(xc, yR, zR + rR), V3(xc, t / 2, zB), tw, t)                            -- 后头绕下来
  elseif d.axles and #d.axles > 0 then
    local wr, ww = d.wr or 1.3, d.ww or 1
    local wx = side * (d.wx or d.W * 0.38)
    for _, z in ipairs(d.axles) do
      rod(L, V3(wx - ww / 2, wr, z), V3(wx + ww / 2, wr, z), wr * 2)                 -- 轮胎
      rod(L, V3(wx - ww / 2 - 0.04, wr, z), V3(wx + ww / 2 + 0.04, wr, z), wr * 0.9)   -- 轮毂
    end
  else
    blk(L, hi - lo, (lo + hi) / 2)
  end
  x.specs = L
end

-- 油箱：圆角油箱（四条圆柱边沿长的那根轴）；又宽又扁的画成鞍形（两边两块、上面一道梁）
local function fuelItem(x)
  local it = x.it
  local S = it.hi - it.lo - V3(0.1, 0.1, 0.1)
  local c = (it.lo + it.hi) / 2
  local L = {}
  local rotZ = S.X > S.Z * 1.25   -- 长边沿 x：整个转 90°
  local frame = rotZ and (CF(c) * ANG(0, PI / 2, 0)) or CF(c)
  local w, h, l = S.X, S.Y, S.Z
  if rotZ then w, l = S.Z, S.X end
  if w > h * 1.5 and w > 2.2 then
    for s = -1, 1, 2 do
      blk(L, V3(w * 0.3, h, l), V3(s * w * 0.35, 0, 0))                              -- 鞍形两边
      rod(L, V3(s * w * 0.35, h * 0.34, -l / 2), V3(s * w * 0.35, h * 0.34, l / 2), math.min(w * 0.3, h * 0.32))
    end
    blk(L, V3(w * 0.42, h * 0.34, l), V3(0, h * 0.33, 0))                            -- 上面的梁
  else
    local r = math.min(w, h) * 0.22
    blk(L, V3(w - 2 * r, h, l), V3())
    blk(L, V3(w, h - 2 * r, l), V3())
    for sx = -1, 1, 2 do
      for sy = -1, 1, 2 do
        rod(L, V3(sx * (w / 2 - r), sy * (h / 2 - r), -l / 2), V3(sx * (w / 2 - r), sy * (h / 2 - r), l / 2), 2 * r)   -- 圆角
      end
    end
  end
  disc(L, V3(w * 0.22, h / 2 + 0.05, -l * 0.28), math.min(0.36, w * 0.25), 0.14, "dk")   -- 加油口
  for _, s in ipairs(L) do s.cf = frame * s.cf end
  x.specs = L
end

-- 炮闩（炮的坐标：耳轴为原点、−z 朝炮口）
local function breechItem(x, ctx)
  local d = ctx.d
  local g = d.gun
  local L = {}
  local cal = math.max(0.1, g.cal or 0.3)
  local hiZ = x.it.hi.Z - g.pivot.Z
  local twin = d.turret and d.turret.twin
  local xs = twin and { -twin / 2, twin / 2 } or { 0 }
  for _, x0 in ipairs(xs) do
    if g.gatling then   -- 加特林（M163、LD-2000、C-RAM 的 M61 / 730 型）：炮管后面一个圆柱形的转膛机匣 + 侧面的驱动电机 + 往下通到弹鼓的无链供弹槽
      rod(L, V3(x0, 0, -0.3), V3(x0, 0, 1.3), cal * 2.3)                                -- 转膛机匣（六根管的后头都在里面）
      rod(L, V3(x0, 0, -0.42), V3(x0, 0, -0.3), cal * 2.5, "dk")                        -- 前面的夹箍
      blk(L, V3(cal * 1.1, cal * 1.1, 0.7), V3(x0 + cal * 1.6, cal * 0.2, 0.6), "dk")   -- 驱动电机（液压 / 电动）
      blk(L, V3(cal * 2.2, cal * 0.5, 1.4), V3(x0, -cal * 1.35, 0.55))                  -- 炮架
      bar(L, V3(x0 - cal * 0.9, -cal * 0.9, 1.0), V3(x0 - 0.7, -1.3, 1.5), 0.32, 0.14, "dk")   -- 供弹槽（往下通到弹鼓）
      bar(L, V3(x0 - cal * 0.5, -cal * 1.0, 1.2), V3(x0 - 0.35, -1.3, 1.9), 0.32, 0.14, "dk")  -- 退弹槽（空弹壳回弹鼓）
    elseif cal < 0.3 or (g.len or 0) < 1 then   -- 机关炮 / 发射架：机匣 + 供弹槽
      local k = math.clamp(cal / 0.2, 0.6, 1.4)
      blk(L, V3(0.5 * k, 0.42 * k, 1.5), V3(x0, 0, 0.55))
      rod(L, V3(x0, 0, -0.35), V3(x0, 0, 0.1), 0.34 * k, "dk")                        -- 驻退套
      bar(L, V3(x0 - 0.18 * k, -0.15 * k, 0.6), V3(x0 - 0.5 * k, -1.1, 0.9), 0.3 * k, 0.12, "dk")   -- 供弹槽（往下通到弹箱）
    else
      local k = math.clamp(cal / 0.44, 0.4, 1.3)
      blk(L, V3(0.95 * k, 0.85 * k, 0.9), V3(x0, 0, -0.05))                           -- 摇架
      rod(L, V3(x0 - 0.62 * k, 0, 0), V3(x0 + 0.62 * k, 0, 0), 0.22 * k, "dk")        -- 耳轴
      for s = -1, 1, 2 do
        rod(L, V3(x0 + s * 0.3 * k, 0.36 * k, -0.4), V3(x0 + s * 0.3 * k, 0.36 * k, 0.95), 0.2 * k, "dk")   -- 两根后坐筒（驻退机、复进机）
      end
      local zr = 0.45 + 0.35 * k
      blk(L, V3(1.0 * k, 0.95 * k, 0.7 * k), V3(x0, -0.02, zr))                       -- 炮尾
      blk(L, V3(0.22 * k, 0.78 * k, 0.52 * k), V3(x0 + 0.42 * k, -0.02, zr), "dk")    -- 立楔式闩体（往右探出来一点）
      local z1 = zr + 0.35 * k
      local z2 = math.max(z1 + 0.3, math.min(hiZ - 0.05, z1 + 1.2))
      for s = -1, 1, 2 do blk(L, V3(0.06, 0.55 * k, z2 - z1), V3(x0 + s * 0.56 * k, 0, (z1 + z2) / 2)) end   -- 防危板（后坐时挡着人）
      blk(L, V3(1.12 * k, 0.06, z2 - z1), V3(x0, -0.32 * k, (z1 + z2) / 2))           -- 接壳托
    end
  end
  x.specs = L
end
-- 炮管（炮的坐标）：粗细两段、隔热套的箍、抽烟装置 / 炮口制退器，一直画到炮口
local function barrelItem(x, ctx)
  local g = ctx.d.gun
  local L = {}
  local len, cal = g.len or 0, g.cal or 0
  if len < 1 or cal <= 0 then   -- 发射架：一根导轨
    local l = math.max(1.5, len)
    blk(L, V3(0.3, 0.2, l), V3(0, 0, -l / 2))
    x.specs = L
    return
  end
  local twin = ctx.d.turret and ctx.d.turret.twin
  local xs = twin and { -twin / 2, twin / 2 } or { 0 }
  for _, x0 in ipairs(xs) do
    if g.gatling then   -- 加特林：六根管围一圈 + 两道夹箍
      for i = 0, 5 do
        local a = i / 6 * PI * 2
        local ox, oy = math.cos(a) * cal * 0.55, math.sin(a) * cal * 0.55
        rod(L, V3(x0 + ox, oy, -0.3), V3(x0 + ox, oy, -len), cal * 0.42)
      end
      rod(L, V3(x0, 0, -len * 0.7 + 0.06), V3(x0, 0, -len * 0.7 - 0.06), cal * 1.7, "dk")
      rod(L, V3(x0, 0, -len + 0.12), V3(x0, 0, -len - 0.02), cal * 1.75, "dk")
    else
      local zM = -0.35 - (len - 0.35) * 0.45
      rod(L, V3(x0, 0, -0.35), V3(x0, 0, zM), cal * 1.62)                             -- 后段（粗）
      rod(L, V3(x0, 0, zM), V3(x0, 0, -len), cal * 1.28)                              -- 前段（细）
      for _, f in ipairs({ 0.3, 0.8 }) do
        rod(L, V3(x0, 0, -len * f + 0.07), V3(x0, 0, -len * f - 0.07), cal * 1.8, "dk")   -- 隔热套的箍
      end
      if g.fume then rod(L, V3(x0, 0, -len * 0.52), V3(x0, 0, -len * 0.64), cal * 2.15, "dk") end   -- 抽烟装置
      if g.brake then
        rod(L, V3(x0, 0, -len * 0.925), V3(x0, 0, -len - 0.02), cal * 2, "dk")        -- 炮口制退器
        blk(L, V3(cal * 2.6, cal * 0.8, len * 0.035), V3(x0, 0, -len * 0.965), "dk")  -- 两侧的开窗
      end
    end
  end
  x.specs = L
end

-- 炮塔驱动（炮塔系）：座圈一圈齿圈 + 电机 + 减速箱 + 跟齿圈咬着的小齿轮
local function tdriveItem(x, ctx)
  local it, d = x.it, ctx.d
  local lo, hi = it.lo, it.hi
  local c = (lo + hi) / 2
  local L = {}
  local R = clampS(math.min(ctx.ts.X, ctx.ts.Z) * 0.36, 1.2, d.W * 0.36)
  local yr = clampS(ctx.hH - ctx.tp.Y - 0.12, lo.Y - 0.3, hi.Y + 0.3)
  local N = 14
  for i = 0, N - 1 do
    local a0, a1 = i / N * PI * 2, (i + 1) / N * PI * 2
    bar(L, V3(math.sin(a0) * R, yr, math.cos(a0) * R), V3(math.sin(a1) * R, yr, math.cos(a1) * R), 0.18, 0.14)   -- 座圈齿圈
  end
  disc(L, c + V3(0, 0.12, 0), 0.56, 0.62)                                            -- 电机
  blk(L, V3(0.5, 0.34, 0.5), c + V3(0, -0.36, 0))                                    -- 减速箱
  local u = V3(c.X, 0, c.Z)
  u = (u.Magnitude > 0.1) and u.Unit or V3(-0.7, 0, -0.7)
  disc(L, V3(u.X * (R - 0.18), yr, u.Z * (R - 0.18)), 0.34, 0.2)                     -- 小齿轮
  x.specs = L
end

-- 高低机（炮塔系，用户 11-28「方向机也要能被打坏」加的）：炮耳后下方跟炮一起转的一段齿弧 + 减速箱 + 手轮
local function edriveItem(x, ctx)
  local it, d = x.it, ctx.d
  local lo, hi = it.lo, it.hi
  local c = (lo + hi) / 2
  local gp = (d.gun and d.gun.pivot) or c
  local L = {}
  local R = 0.95
  local N = 6
  for i = 0, N - 1 do
    local t0, t1 = math.rad(20 + i * 10), math.rad(20 + (i + 1) * 10)
    bar(L, V3(c.X, gp.Y - math.sin(t0) * R, gp.Z + math.cos(t0) * R), V3(c.X, gp.Y - math.sin(t1) * R, gp.Z + math.cos(t1) * R), 0.16, 0.14)   -- 齿弧
  end
  blk(L, V3(0.52, 0.44, 0.6), c + V3(0, -0.12, 0.12))                     -- 减速箱
  local sx = (c.X >= gp.X) and 1 or -1
  disc(L, c + V3(sx * 0.34, 0.02, 0.32), 0.4, 0.07, "dk")                 -- 手轮
  x.specs = L
end

-- 炮长瞄准镜（炮塔系）：镜头（装甲罩 + 窗口）、镜筒穿过炮塔顶一直到炮长眼前、目镜
local function opticsItem(x, ctx)
  local d = ctx.d
  local sp = d.sight or (x.it.lo + x.it.hi) / 2
  local L = {}
  blk(L, V3(1.0, 0.62, 0.9), sp + V3(0, 0.14, 0))
  blk(L, V3(0.72, 0.3, 0.06), sp + V3(0, 0.18, -0.47), "gl")
  local eye = ctx.gnrHead and (ctx.gnrHead + V3(0, 0.02, -0.34)) or (sp + V3(0, -1.1, 0.5))
  bar(L, sp + V3(0, -0.12, 0.1), eye + V3(0, 0.06, -0.12), 0.34, 0.34)
  rod(L, eye, eye + V3(0, 0, 0.2), 0.24, "gl")
  x.specs = L
end

-- 载员舱：两条长凳 + 面朝里坐着的步兵
local function troopsItem(x, ctx)
  local it, d = x.it, ctx.d
  local lo, hi = it.lo, it.hi
  local S, c = hi - lo, (lo + hi) / 2
  local L = {}
  local _, low0, top0 = person(POSE.troop, 1, true)
  local sc = math.clamp((ctx.hH - 0.08 - lo.Y) / (top0 - low0), 0.5, 1)
  local P0, low = person(POSE.troop, sc, true)
  local hipY = lo.Y - low + 0.02
  local benchX = math.max(0.3, S.X / 2 - 0.4)
  for s = -1, 1, 2 do blk(L, V3(0.6, 0.12, S.Z * 0.86), V3(c.X + s * benchX, hipY - 0.12 * sc, c.Z)) end   -- 长凳
  local n = math.clamp((d.seats or 6) - 1, 2, 6)
  local per = math.ceil(n / 2)
  for i = 1, n do
    local s = (i % 2 == 1) and -1 or 1
    local j = math.ceil(i / 2)
    local z = c.Z - S.Z * 0.4 + (j - 0.5) / per * S.Z * 0.8
    local hip = V3(c.X + s * (benchX - 0.05), hipY, z)
    local place = CFrame.lookAt(hip, hip + V3(-s, 0, 0))   -- 面朝里
    for _, q in ipairs(P0) do L[#L + 1] = { s = q.s, cf = place * q.cf, sh = q.sh } end
  end
  x.specs = L
end

---------------------------------------------------------------- 弹

-- 弹头占多长、多粗（按弹种类 cls）：脱壳穿甲弹细长的弹芯；破甲、榴弹粗；榴弹炮弹丸的引信、火箭、导弹的头
local function shellShape(cls)
  if cls == "ap" then return 0.46, 0.5 end
  if cls == "heat" or cls == "mpat" or cls == "jet" then return 0.42, 0.86 end
  if cls == "atgm" then return 0.55, 0.9 end
  if cls == "shell" then return 0.24, 0.5 end
  if cls == "rocket" then return 0.18, 0.72 end
  if cls == "msl" then return 0.2, 0.85 end
  return 0.4, 0.8
end
-- 一发躺着的整装弹（沿 dir，弹头朝 dir）
local function round(L, c, dir, dia, len, cls, one)
  local a, b = c - dir * (len / 2), c + dir * (len / 2)
  if one then rod(L, a, b, dia) return end
  local tf, tk = shellShape(cls)
  local m = b - dir * (len * tf)
  rod(L, a, m, dia)                    -- 药筒 / 弹体
  rod(L, m, b, dia * tk, "tip")        -- 弹头
end
-- 盒子里一格一格排的弹（沿 z 躺着，横截面排成几行几列；放不下的弹径缩小）：n 格；sep 分装弹（单数格弹丸、双数格药筒）
local function gridRack(L, lo, hi, n, dia0, len0, tipDir, kinds, one, sep)
  if n <= 0 then return end
  local S = hi - lo
  local w, h = math.max(0.2, S.X - 0.12), math.max(0.2, S.Y - 0.1)
  local rows = math.clamp(math.floor(math.sqrt(n * h / w) + 0.5), 1, math.max(1, math.floor(h / (dia0 * 0.6))))
  local cols = math.ceil(n / rows)
  local dia = math.min(dia0, w / cols * 0.94, h / rows * 0.94)
  local len = math.max(0.3, math.min(len0, S.Z - 0.12))
  local zc = (lo.Z + hi.Z) / 2
  local dir = V3(0, 0, tipDir)
  for i = 1, n do
    local row, col = math.floor((i - 1) / cols), (i - 1) % cols
    local p = V3(lo.X + 0.06 + (col + 0.5) * (w / cols), lo.Y + 0.05 + (row + 0.5) * (h / rows), zc)
    local n0 = #L
    if sep then
      local proj = (i % 2 == 1)
      local l2 = len * (proj and 0.72 or 0.62)
      rod(L, p - dir * (l2 / 2), p + dir * (l2 / 2), dia * (proj and 0.9 or 1), proj and "tip" or nil)
    else
      round(L, p, dir, dia, len, kinds and kinds[i], one)
    end
    mark(L, n0, i)
  end
end
-- 转盘自动装弹机（车体底板上、炮塔下面一圈）：n 个位置，弹头朝里；crewR 炮塔里的人脚伸到离转轴多远（篮子式的竖药筒围在它外面）、
--   rMax 竖药筒最外放到多远
local function carouselRack(L, lo, hi, n, mz, one, crewR, rMax)
  local c = (lo + hi) / 2
  local S = hi - lo
  local rOut = math.max(1.2, math.min(S.X, S.Z) / 2 - 0.12)
  local dia = CAR_DIA   -- 125 毫米
  local rIn = math.min(math.max(n * dia * 1.12 / (PI * 2), rOut * 0.3), rOut - 0.9)
  local len = rOut - rIn
  disc(L, V3(c.X, lo.Y + 0.04, c.Z), rOut * 2 + 0.1, 0.08)                          -- 转盘底板
  local y1 = lo.Y + CAR_Y0 + dia / 2
  local y2 = y1 + dia + 0.06
  -- 竖药筒那一圈：原来在弹丸外头那一截上面；炮塔里的人脚伸得远就往外挪（最多挪到履带里面）
  local rC = math.max(rOut - dia * 0.6, (crewR or 0) + dia / 2 + 0.06)
  if rMax then rC = math.min(rC, rMax) end
  for i = 1, n do
    local a = (i - 0.5) / n * PI * 2
    local u = V3(math.sin(a), 0, math.cos(a))
    local n0 = #L
    local pc = V3(c.X, y1, c.Z)
    rod(L, pc + u * rOut, pc + u * (rIn + len * 0.12), dia * 0.92, "tip")            -- 弹丸（下层平躺）
    if not one then
      if mz then
        local p = V3(c.X, 0, c.Z) + u * rC
        rod(L, V3(p.X, y1 + dia * 0.55, p.Z), V3(p.X, y1 + dia * 0.55 + CAR_CH, p.Z), dia)   -- 药筒（竖着围在外圈）
      else
        local qc = V3(c.X, y2, c.Z)
        rod(L, qc + u * rOut, qc + u * (rIn + len * 0.3), dia)                       -- 药筒（上层平躺）
      end
    end
    mark(L, n0, i)
  end
end
-- 机关炮 / 机枪的弹箱：n 箱（箱子 + 箱口露出的一截弹链）
local function canRack(L, lo, hi, n, one)
  if n <= 0 then return end
  local S = hi - lo
  local rows = math.clamp(math.ceil(n / math.max(1, math.floor(S.X / 0.62))), 1, math.max(1, math.floor(S.Y / 0.42)))
  local cols = math.ceil(n / rows)
  local cw, ch = S.X / cols, S.Y / rows
  local dz = math.min(S.Z * 0.85, 1.1)
  for i = 1, n do
    local row, col = math.floor((i - 1) / cols), (i - 1) % cols
    local p = V3(lo.X + (col + 0.5) * cw, lo.Y + (row + 0.5) * ch, (lo.Z + hi.Z) / 2)
    local n0 = #L
    blk(L, V3(cw * 0.86, ch * 0.8, dz), p)
    if not one then blk(L, V3(cw * 0.7, 0.06, dz * 0.9), p + V3(0, ch * 0.4 + 0.03, 0), "tip") end
    mark(L, n0, i)
  end
end

-- 这辆车的主武器（画弹架用的那一件）
function XrayOwn.mainWeapon(d)
  local VD = req("VehDefs")
  for _, id in ipairs(d.weapons or {}) do
    local w = VD.W[id]
    if w and (w.kind == "shell" or w.kind == "arty" or w.kind == "atgm" or w.kind == "sam" or w.kind == "gun") then return id, w end
  end
  return nil, nil
end
-- 弹的样子、弹种顺序（live：{ total 主武器还有几发、rdy / rdyCap 待发弹架、aml 每种几发 }；没有就按满架）
function XrayOwn.ammoPlan(d, live)
  live = live or {}
  local A = { style = "none" }
  local wid, w = XrayOwn.mainWeapon(d)
  if not w then return A end
  A.wid, A.w = wid, w
  local cal = tonumber(string.match(wid, "^gun(%d+)")) or ((wid == "how155") and 155) or nil
  A.cal = cal
  if w.kind == "shell" and cal and cal >= 60 then
    A.style = "round"
    A.sep = (cal == 125)   -- 125 毫米：弹丸、药筒分装
    A.dia = (cal >= 115 and 0.44) or (cal >= 100 and 0.36) or (cal >= 90 and 0.34) or 0.26
    A.len = A.sep and 2.1 or ((cal >= 115 and 2.74) or (cal >= 100 and 2.7) or (cal >= 90 and 2.6) or 2.9)
    if cal >= 150 then A.dia, A.len = 0.46, 2.2 end
  elseif w.kind == "shell" or w.kind == "gun" then
    A.style, A.per = "cans", math.clamp(w.mag or 50, 20, 512)
  elseif w.kind == "arty" then
    A.style = "round"
    if wid == "mlrs" then A.dia, A.len, A.cls = 0.62, 3.6, "rocket" else A.dia, A.len, A.cls = 0.43, 2.24, "shell" end
  else
    A.style, A.dia, A.len, A.cls = "round", 0.5, 3.2, "msl"
  end
  A.full = (w.mag or 1) + (w.reserve or 0)
  -- 弹种顺序（AmL「m829a3:20,m830:12,…」）：画的时候一格一种
  local seq = {}
  if type(live.aml) == "string" then
    for k, c in string.gmatch(live.aml, "([%w_]+):(%d+)") do
      for _ = 1, math.min(tonumber(c) or 0, 400) do seq[#seq + 1] = k end
    end
  end
  local B = req("Ballistics")
  if #seq == 0 and B.GUN and B.GUN[wid] then seq[1] = B.GUN[wid][1] end
  A.seq = seq
  return A
end
-- 各弹架现在几发（rounds：cans 是几箱）、一共几格；每帧按车上的属性重算（打一发少一发）
function XrayOwn.racksOf(A, d, lay, live)
  live = live or {}
  local out = {}
  local w = A.w
  if not w then return out end
  local full = A.full
  local total = math.clamp(math.floor(tonumber(live.total) or full), 0, 9999)
  local lt = lay.prof.lay
  local hasH = false
  for _, it in ipairs(lay.list) do if it.k == "ammoH" then hasH = true end end
  if hasH and (lt == "e3" or lt == "w4") and A.style == "round" then
    local cap = math.floor(tonumber(live.rdyCap) or d.rdyN or ((lt == "e3") and 22 or 15))
    local mag = math.min(w.mag or 1, total)
    local res = total - mag
    local rdy = math.clamp(math.floor(tonumber(live.rdy) or math.min(cap, res)), 0, cap)
    local nH = math.max(0, res - rdy)
    out.ammo = { cap = cap, n = rdy }
    out.ammoH = { cap = math.max(full - (w.mag or 1) - cap, nH, 0), n = nH }
  elseif A.style == "cans" then
    out.ammo = { cap = math.clamp(math.ceil(full / A.per), 1, 12), n = math.clamp(math.ceil(total / A.per), 0, 12) }
  else
    out.ammo = { cap = full, n = total }
  end
  if hasH and not out.ammoH then out.ammoH = { cap = 0, n = 0 } end
  return out
end

local function ammoItem(x, ctx, one, scale)
  local it, d, A = x.it, ctx.d, ctx.A
  local rk = ctx.R[it.k] or { cap = 0, n = 0 }
  local lo, hi = it.lo, it.hi
  local S, c = hi - lo, (lo + hi) / 2
  local W = req("WtDamage")
  local B = req("Ballistics")
  local L = {}
  local carousel = (it.k == "ammo") and W.CAROUSEL[d.id] and not it.tur and A.style == "round"
  local cap = math.max(0, math.floor(rk.cap * scale))
  if not carousel then blk(L, V3(S.X, 0.06, S.Z), V3(c.X, lo.Y + 0.03, c.Z)) end   -- 弹架底板（空了也看得出弹架在哪）
  -- 这一架每格是哪种弹：按车上现在的 AmL 排（待发弹架现在有的那几发在前、车体弹架接着；打掉的弹种就不再画、不再写）
  local off = (it.k == "ammoH" and ctx.R.ammo) and math.min(ctx.R.ammo.n or 0, ctx.R.ammo.cap or 0) or 0
  local seq = A.seq or {}
  local kinds, names = {}, {}
  for i = 1, cap do
    local k = (#seq > 0) and seq[((off + i - 1) % #seq) + 1] or nil
    local a = k and B.AMMO and B.AMMO[k]
    kinds[i] = A.cls or (a and a.cls) or nil
    names[i] = a and a.name or nil
  end
  local per = 1
  if A.style == "none" then
    blk(L, S, c)
  elseif carousel then
    carouselRack(L, lo, hi, cap, MZ[d.id], one, ctx.crewR, ctx.carRmax)
    x.detail = "xr.d.carousel"
  elseif A.style == "cans" then
    canRack(L, lo, hi, cap, one)
    x.detail = "xr.d.cans"
  else
    local sep = A.sep and not one
    if sep then per = 2 end
    local tipDir
    if it.tur then tipDir = (c.Z >= 0) and 1 or -1 else tipDir = (c.Z < ctx.tp.Z) and -1 or 1 end   -- 弹底朝着装填的人
    gridRack(L, lo, hi, cap * per, A.dia, A.len, tipDir, (not sep) and kinds or nil, one, sep)
    x.detail = it.tur and "xr.d.bustle" or "xr.d.hullRack"
  end
  x.specs = L
  x.rack = { per = per, cap = cap, names = names, kinds = kinds }
  x.one, x.scale = one, scale   -- AmL 变了按同样的格数重排（客户端 reshape）
end

-- 反坦克导弹发射架（格）：发射筒长、筒径、弹径、几具、装在哪（炮塔顶 / 炮塔两侧 / 炮塔左侧 / 炮上面的导轨）
local ATGM = {
  konkurs = { len = 3.5, tube = 0.46, msl = 0.38, n = 1, at = "roof" },    -- 9M113「竞技」：炮塔顶上一具 9P135M 发射架（BMP-2，原模型量的位置）
  kornet = { len = 3.4, tube = 0.5, msl = 0.43, n = 4, at = "sides" },     -- 9M133「短号」：「海岸」战斗模块炮塔两侧各两具（BMP-2M）
  tow2 = { len = 3.4, tube = 0.56, msl = 0.43, n = 2, at = "left" },       -- BGM-71「陶-2」：炮塔左侧的双联装发射箱（M2A3）
  malyutka = { len = 2.4, tube = 0, msl = 0.35, n = 1, at = "rail" },      -- 9M14「婴儿」：炮上面的发射导轨（BMP-1）
}
XrayOwn.ATGM = ATGM
-- 发射架的零件（弹一发一格：slot；筒、导轨、支架不带 slot）；返回零件表、框架（tur / gun）、几具
local function launcherSpecs(d, ctx, wid)
  local A = ATGM[wid]
  if not A or not d.turret then return nil end
  local L = {}
  local ts = ctx.ts
  local topT = ctx.turTop - ctx.tp.Y   -- 炮塔顶（炮塔系）
  local base = topT - ts.Y
  local function tube(i, p, withTube)
    if withTube then rod(L, p + V3(0, 0, A.len / 2), p - V3(0, 0, A.len / 2), A.tube, "dk") end   -- 发射筒
    local n0 = #L
    rod(L, p + V3(0, 0, A.len / 2 - 0.2), p - V3(0, 0, A.len / 2 - 0.3), A.msl)                 -- 弹体
    rod(L, p - V3(0, 0, A.len / 2 - 0.3), p - V3(0, 0, A.len / 2 - 0.05), A.msl * 0.8, "tip")   -- 弹头
    mark(L, n0, i)
  end
  if A.at == "rail" then   -- 炮上面：一根导轨、导弹带四片尾翼（炮的框架，跟着俯仰）
    local g = d.gun
    local cal = (g and g.cal) or 0.25
    local p = V3(0, cal * 1.3 + 0.35, -0.7)
    bar(L, p + V3(0, -A.msl * 0.7, A.len * 0.45), p + V3(0, -A.msl * 0.7, -A.len * 0.45), 0.16, 0.1, "dk")   -- 导轨
    local n0 = #L
    rod(L, p + V3(0, 0, A.len / 2), p - V3(0, 0, A.len / 2 - 0.3), A.msl)
    rod(L, p - V3(0, 0, A.len / 2 - 0.3), p - V3(0, 0, A.len / 2), A.msl * 0.7, "tip")
    bar(L, p + V3(-0.55, 0, A.len * 0.32), p + V3(0.55, 0, A.len * 0.32), 0.3, 0.04)          -- 尾翼（展开）
    bar(L, p + V3(0, -0.55, A.len * 0.32), p + V3(0, 0.55, A.len * 0.32), 0.04, 0.3)
    mark(L, n0, 1)
    return L, "gun", 1
  end
  if A.at == "roof" then   -- 炮塔顶上一具（偏后：车长、炮长舱口中间）
    local p = V3(-ts.X * 0.04, topT + A.tube * 0.75, ts.Z * 0.1)
    blk(L, V3(0.3, A.tube * 0.6, 0.5), p - V3(0, A.tube * 0.6, -0.2), "dk")                    -- 支架
    tube(1, p, true)
  elseif A.at == "sides" then   -- 炮塔两侧各两具（上下叠着）
    local i = 0
    for s = -1, 1, 2 do
      local x = s * (ts.X / 2 + A.tube * 0.7)
      bar(L, V3(s * ts.X / 2, base + ts.Y * 0.5, 0.2), V3(x, base + ts.Y * 0.5, 0.2), 0.2, 0.2, "dk")   -- 支臂
      for j = 0, 1 do
        i += 1
        tube(i, V3(x, base + ts.Y * 0.4 + j * A.tube * 1.1, 0.2), true)
      end
    end
  else   -- 炮塔左侧的双联装发射箱（两个筒并排）
    local xc = -(ts.X / 2 + A.tube * 1.05)
    local y = base + ts.Y * 0.6
    bar(L, V3(-ts.X / 2, y, 0.3), V3(xc, y, 0.3), 0.25, 0.25, "dk")                            -- 支臂（发射箱升起来打）
    for i = 1, 2 do tube(i, V3(xc + (i - 1.5) * A.tube * 1.05, y, 0.3), true) end
  end
  return L, "tur", A.n
end

---------------------------------------------------------------- 整辆车的透视零件（纯数据，测试也能直接算）

local function catOf(it)
  if it.kind == "crew" then return "crew" end
  local k = it.k or ""
  if k == "engine" or k == "trans" or k == "breech" or k == "barrel" or k == "tdrive" or k == "optics" or k == "troops" then return k end
  if k == "edrive" then return "tdrive" end   -- 高低机：同方向机一类（颜色、图例）
  if string.sub(k, 1, 4) == "fuel" then return "fuel" end
  if string.sub(k, 1, 4) == "ammo" then return "ammo" end
  if string.sub(k, 1, 5) == "track" then return "track" end
  return "other"
end
local BUILD = { engine = engineItem, trans = transItem, trackL = trackItem, trackR = trackItem, breech = breechItem, barrel = barrelItem,
  tdrive = tdriveItem, edrive = edriveItem, optics = opticsItem, fuelL = fuelItem, fuelR = fuelItem, troops = troopsItem }

-- opts：{ M = VehModels 的模型信息（爆反块）、live = 弹的现况、limit = 零件上限（默认 LIMIT；命中回放的小窗用得少一点）}；返回 { items = { { k, cat, frame = hull / tur / gun, specs, ci / mi（WtC / WtM 第几位）… } }, total, A, R, lay }
function XrayOwn.plan(d, opts)
  opts = opts or {}
  local LIMIT = opts.limit or LIMIT
  local W = req("WtDamage")
  local lay = W.layout(d)
  local ctx = mkCtx(d, lay)
  ctx.A = XrayOwn.ammoPlan(d, opts.live)
  ctx.R = XrayOwn.racksOf(ctx.A, d, lay, opts.live)
  local items, ammoX = {}, {}
  local ci, mi = 0, 0
  for _, it in ipairs(lay.list) do
    local x = { it = it, k = it.k, kind = it.kind, cat = catOf(it) }
    if it.k == "barrel" or it.k == "breech" then x.frame = "gun" elseif it.tur then x.frame = "tur" else x.frame = "hull" end
    if it.kind == "crew" then ci += 1 x.ci = ci else mi += 1 x.mi = mi end
    items[#items + 1] = x
  end
  local used = 0
  for _, x in ipairs(items) do   -- 先画弹药以外的（乘员在观瞄前面：炮长镜的目镜要对着炮长的脸）
    if x.cat == "ammo" then
      ammoX[#ammoX + 1] = x
    else
      local f = (x.kind == "crew") and crewItem or BUILD[x.k]
      if f then f(x, ctx) else
        local L = {}
        blk(L, x.it.hi - x.it.lo, (x.it.lo + x.it.hi) / 2)
        x.specs = L
      end
      used += #x.specs
    end
  end
  -- 篮子式转盘（T-64 / T-80）：炮塔里的人在竖药筒那一层的高度上，四肢伸到离转轴多远（竖药筒围在这一圈外面）
  local am = ctx.byK.ammo
  if MZ[d.id] and W.CAROUSEL[d.id] and am and not am.tur then
    local yTop = am.lo.Y + CAR_Y0 + CAR_DIA * 1.55 + CAR_CH - ctx.tp.Y   -- 竖药筒的顶（炮塔系）
    local r = 0
    for _, x in ipairs(items) do
      if x.kind == "crew" and x.it.tur and x.specs then
        for _, s in ipairs(x.specs) do
          local h = s.s / 2
          for _, k in ipairs(CORNERS) do
            local p = s.cf * (h * k)
            if p.Y < yTop then r = math.max(r, math.sqrt(p.X * p.X + p.Z * p.Z)) end
          end
        end
      end
    end
    ctx.crewR = r
  end
  -- 不算伤害的件：并列机枪（跟炮俯仰）、车长周视镜、车长热像仪
  local function extra(k, cat, frame, nm, L)
    if #L == 0 then return end
    items[#items + 1] = { k = k, kind = "extra", cat = cat, frame = frame, nm = nm, specs = L }
    used += #L
  end
  if d.coax and d.gun and d.turret then
    local L = {}
    local q = d.coax - d.gun.pivot
    blk(L, V3(0.24, 0.28, 0.95), q + V3(0, 0, 0.62))                                   -- 机匣
    rod(L, q + V3(0, 0, 0.12), q + V3(0, 0, -1.15), 0.09, "dk")                        -- 枪管
    blk(L, V3(0.3, 0.32, 0.42), q + V3((q.X >= 0) and 0.27 or -0.27, -0.12, 0.7))      -- 弹箱
    extra("coax", "breech", "gun", "xr.n.coax", L)
  end
  if d.cupola and d.turret then
    local L = {}
    local cp = d.cupola
    disc(L, cp + V3(0, 0.12, 0), 1.25, 0.26, "gl")                                     -- 指挥塔一圈观察镜
    blk(L, V3(0.46, 0.42, 0.5), cp + V3(0, 0.42, -0.3))                                -- 周视镜镜头
    bar(L, cp + V3(0, 0.25, -0.3), cp + V3(0, -0.55, -0.15), 0.26, 0.26)               -- 镜筒到车长眼前
    extra("csight", "optics", "tur", "xr.n.csight", L)
  end
  if d.citv and d.turret then
    local L = {}
    local p = V3(d.citv.X, ctx.ts.Y + 0.55, d.citv.Z)
    blk(L, V3(0.8, 0.85, 0.8), p)
    blk(L, V3(0.5, 0.35, 0.06), p + V3(0, 0.05, -0.42), "gl")
    rod(L, p - V3(0, 0.42, 0), p - V3(0, 0.95, 0), 0.3)
    extra("citv", "optics", "tur", "xr.n.citv", L)
  end
  -- 反坦克导弹发射架（BMP-1 / 2 / 2M、M2A3：第二件武器，原来只画主武器的弹架）：发射筒 + 筒里装着的导弹（打出去的那一发不画）
  for _, wid in ipairs(d.weapons or {}) do
    if ATGM[wid] and wid ~= ctx.A.wid then
      local L, frame, n = launcherSpecs(d, ctx, wid)
      if L and #L > 0 then
        items[#items + 1] = { k = "atgm", kind = "extra", cat = "ammo", frame = frame, nm = "xr.n.atgm", specs = L, launch = { wid = wid, cap = n } }
        used += #L
      end
      break
    end
  end
  -- 爆反块：模型上真的那些块（每块一件，按它在车体 / 炮塔上的位置、大小）
  local M = opts.M
  if M and M.era then
    local byG = { hull = {}, tur = {} }
    for i, e in ipairs(M.era) do
      if e.off and e.w and not e.off2 then
        local g = (e.g == "turret") and "tur" or "hull"
        local L = byG[g]
        local s = put(L, V3(e.w, e.h, e.t), e.off, "B")
        s.slot = i
      end
    end
    for g, L in pairs(byG) do
      if #L > 0 and used + #L <= LIMIT then
        items[#items + 1] = { k = "era", kind = "extra", cat = "era", frame = g, nm = "xr.era", specs = L, eraE = M.era }
        used += #L
      end
    end
  end
  -- 弹药最后：一发两个零件（弹体 + 弹头 / 弹丸 + 药筒 / 弹箱 + 弹链）；总数要超了一发一个，还超就少画几发
  local capSum = 0
  for _, x in ipairs(ammoX) do capSum += (ctx.R[x.k] and ctx.R[x.k].cap) or 0 end
  local left = LIMIT - used - #ammoX   -- 每架一块底板
  local one = capSum * 2 > left
  local scale = 1
  if one and capSum > left then scale = math.max(0, left / math.max(1, capSum)) end
  for _, x in ipairs(ammoX) do
    ammoItem(x, ctx, one, scale)
    used += #x.specs
  end
  -- 要几组 Highlight（类别 + 单独一组的子件；状态组另算，最多 5 个）
  local keys, nk = {}, 0
  for _, x in ipairs(items) do
    for _, s in ipairs(x.specs) do
      local k2 = s.g and (x.cat .. "_" .. s.g)
      local key = (k2 and SUBOK[k2]) and k2 or x.cat
      if not keys[key] then keys[key] = true nk += 1 end
    end
  end
  return { items = items, total = used, A = ctx.A, R = ctx.R, lay = lay, ctx = ctx, keys = keys, nKeys = nk }
end

-- 弹的现况变了（AmL：哪种弹打掉了几发；Rdy：待发弹架还剩几发）：同样的格数按现在的弹重排这一架——每格是哪种弹（提示框写的弹名）、
--   弹头的样子（脱壳穿甲弹细长、破甲弹粗）；返回新的一份（零件数、次序跟原来一样；格数变了返回 nil：整个重建）
function XrayOwn.relayRack(P, x, live)
  local ctx = P.ctx
  if not ctx or not x.rack then return nil end
  ctx.A.seq = XrayOwn.ammoPlan(ctx.d, live).seq
  local R = XrayOwn.racksOf(ctx.A, ctx.d, ctx.lay, live)
  for k, r in pairs(R) do
    local old = ctx.R[k]
    if old and old.cap ~= r.cap then return nil end
  end
  ctx.R = R
  local y = { it = x.it, k = x.k }
  ammoItem(y, ctx, x.one, x.scale)
  if #y.specs ~= #x.specs then return nil end
  return y
end

-- 一个乘员的人形零件（WtHud 的 X 光回放也用）：返回零件表（相对车的底座系；炮塔上的相对炮塔转轴）
function XrayOwn.crewSpecs(d, lay, it)
  local ctx = mkCtx(d, lay)
  local x = { it = it }
  crewItem(x, ctx)
  return x.specs
end

---------------------------------------------------------------- 客户端

function XrayOwn.init(G)
  local TH = G.Theme or req("Theme")
  local RGB = Color3.fromRGB
  local WHITE, BLACK = RGB(255, 255, 255), RGB(0, 0, 0)
  local function T(k, fb, ...)
    local s = G.T and G.T(k, ...)
    if s and s ~= k then return s end
    return fb or k
  end
  -- 类别的颜色——11-28（用户「目前x光效果还是不如战雷」）改成按真东西的质感、沉着一点：
  --   油箱橄榄、传动蓝灰、炮闩炮管炮钢、观瞄青色玻璃、乘员浅橄榄绿；弹药、发动机是醒目的标识色（XrayOwn.MARK：洋红、电光蓝，
  --   用户 11-28「给弹药 发动机都搞一下特殊颜色的标识吧」）——别的都沉着，一眼先看到这两样
  --   （完好 / 受损 / 打坏的意思同 Theme：琥珀、红；阵亡近黑）
  local MARK = XrayOwn.MARK
  local PAL = {
    crew = RGB(160, 188, 136), engine = MARK.engine, trans = RGB(122, 134, 150), fuel = RGB(114, 130, 98), ammo = MARK.ammo,
    breech = RGB(124, 130, 138), barrel = RGB(114, 120, 128), tdrive = RGB(128, 136, 148), optics = RGB(96, 170, 180),
    era = RGB(186, 168, 126), track = RGB(94, 98, 104), troops = RGB(160, 188, 136), other = RGB(130, 138, 148),
  }
  local STATE = { hurt = TH.C.WARN, broken = TH.C.BAD, kia = RGB(44, 34, 32), fire = RGB(255, 132, 40), hover = TH.C.TEXT }
  local function shade(c, sub)
    if sub == "dk" then return c:Lerp(BLACK, 0.4) end
    if sub == "tip" then return RGB(78, 82, 90) end   -- 弹头：钢色（弹体黄铜）
    if sub == "gl" then return RGB(130, 206, 214) end   -- 镜头玻璃
    return c
  end
  local function colOf(key)
    if STATE[key] then return STATE[key] end
    local cat, sub = string.match(key, "^(%a+)_(%a+)$")
    if cat then return shade(PAL[cat] or PAL.other, sub) end
    return PAL[key] or PAL.other
  end
  -- 图例：类别一行、状态一行
  local ORDER = { "crew", "engine", "trans", "fuel", "ammo", "breech", "barrel", "tdrive", "optics", "era", "track", "troops" }
  local LEG = { crew = { "xr.crew", "乘员" }, engine = { "xr.engine", "发动机" }, trans = { "xr.trans", "传动" }, fuel = { "xr.fuel", "油箱" },
    ammo = { "xr.ammo", "弹药" }, breech = { "xr.breech", "炮闩" }, barrel = { "xr.barrel", "炮管" }, tdrive = { "xr.drives", "方向机 / 高低机" },
    optics = { "xr.optics", "观瞄" }, era = { "xr.era", "爆反" }, track = { "xr.track", "履带 / 车轮" }, troops = { "xr.troops", "载员舱" },
    hurt = { "xr.hurt", "受损" }, broken = { "xr.broken", "打坏" }, kia = { "xr.kia", "阵亡" }, fire = { "xr.fire", "起火" } }

  local cur = nil
  local pool = {}
  local POOL_MAX = 700
  local stats = { made = 0, reused = 0, regroup = 0, builds = 0 }
  local SHAPE = { B = Enum.PartType.Block, S = Enum.PartType.Ball, C = Enum.PartType.Cylinder }
  local function take(sh)
    local p = table.remove(pool)
    if p then
      stats.reused += 1
    else
      p = Instance.new("Part")
      p.Anchored, p.CanCollide, p.CanQuery, p.CanTouch, p.CastShadow = true, false, false, false, false
      p.Material = Enum.Material.SmoothPlastic
      p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
      stats.made += 1
    end
    p.Shape = SHAPE[sh] or Enum.PartType.Block
    p.Transparency = 0
    return p
  end
  local function give(p)
    p.Parent = nil
    if #pool < POOL_MAX then pool[#pool + 1] = p else p:Destroy() end
  end

  -- 一组一个 Highlight——11-28 改成按深浅遮挡（Occluded）：车身透明了不挡（透明件不写深度），部件之间前面的挡住后面的；
  --   原来 AlwaysOnTop + 一半的平涂：部件的明暗没了、前后的颜色叠在一起分不出远近（「不如战雷」主要就差在这）。
  --   类别组只淡淡上一层色（夜里、机库暗处也看得见）+ 描边；状态（伤、毁、阵亡、起火、指着的）上色重一点
  local function hlStyle(key)
    local c = colOf(key)
    if key == "kia" then return c, TH.C.BAD:Lerp(BLACK, 0.35), 0.25, 0.15 end
    if key == "broken" then return c, c:Lerp(WHITE, 0.3), 0.4, 0.1 end
    if key == "hurt" then return c, c:Lerp(WHITE, 0.3), 0.45, 0.1 end
    if key == "fire" then return c, RGB(255, 220, 140), 0.25, 0 end
    if key == "hover" then return c, WHITE, 0.4, 0 end
    local mk = MARK[string.match(key, "^(%a+)") or ""]
    if mk then return c, mk:Lerp(WHITE, 0.3), 0.45, 0 end   -- 弹药、发动机：上色重、描边实（标识色）；弹头那一组还是钢色，只描边是洋红
    return c, c:Lerp(WHITE, 0.45), 0.72, 0.3
  end
  local function group(c, key)
    local g = c.groups[key]
    if g then return g end
    if c.nG >= MAXG then   -- 组太多：子组并回大类
      local base = string.match(key, "^(%a+)_")
      if base then return group(c, base) end
    end
    g = Instance.new("Model")
    g.Name = "X_" .. key
    g.Parent = c.folder
    local h = Instance.new("Highlight")
    h.DepthMode = Enum.HighlightDepthMode.Occluded
    h.FillColor, h.OutlineColor, h.FillTransparency, h.OutlineTransparency = hlStyle(key)
    h.Adornee, h.Parent = g, g
    c.groups[key], c.hls[key] = g, h
    c.nG += 1
    return g
  end
  local function keyOf(cat, sub)
    local k2 = sub and (cat .. "_" .. sub)
    if k2 and SUBOK[k2] then return k2 end
    return cat
  end

  ---------------------------------------------------------------- 屏幕上：图例、指着的部件
  local function label(parent, text, font, size, col, order)
    local t = Instance.new("TextLabel")
    t.LayoutOrder, t.AutomaticSize, t.Size = order or 0, Enum.AutomaticSize.X, UDim2.fromOffset(0, size + 4)
    t.BackgroundTransparency, t.Text, t.TextColor3 = 1, text, col or TH.C.TEXT
    t.Font, t.TextSize = font or TH.F.bold, size
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextStrokeTransparency, t.TextStrokeColor3 = TH.A.stroke, TH.C.INK
    t.Parent = parent
    return t
  end
  local function row(parent, order)
    local f = Instance.new("Frame")
    f.LayoutOrder, f.AutomaticSize, f.Size = order, Enum.AutomaticSize.X, UDim2.fromOffset(0, 20)
    f.BackgroundTransparency = 1
    local lay = Instance.new("UIListLayout")
    lay.FillDirection, lay.VerticalAlignment, lay.Padding = Enum.FillDirection.Horizontal, Enum.VerticalAlignment.Center, UDim.new(0, 8)
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Parent = f
    f.Parent = parent
    return f
  end
  local function swatch(parent, key, order)
    local sw = Instance.new("Frame")
    sw.LayoutOrder, sw.Size, sw.BackgroundColor3, sw.BorderSizePixel = order, UDim2.fromOffset(12, 12), colOf(key), 0
    TH.corner(sw, 2)
    sw.Parent = parent
    local L = LEG[key]
    label(parent, T(L[1], L[2]), TH.F.bold, TH.S.small, TH.C.TEXT, order + 1)
  end
  local function buildGui(c)
    local pg = Players.LocalPlayer and Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not pg then return nil end
    local sg = Instance.new("ScreenGui")
    sg.Name, sg.ResetOnSpawn, sg.IgnoreGuiInset, sg.DisplayOrder = "OwnXrayLegend", false, true, 20
    local bar0 = Instance.new("Frame")
    bar0.Name = "Legend"
    bar0.AnchorPoint, bar0.Position, bar0.Size = Vector2.new(0.5, 1), UDim2.new(0.5, 0, 1, -96), UDim2.fromOffset(0, 0)
    bar0.AutomaticSize = Enum.AutomaticSize.XY
    bar0.BackgroundColor3, bar0.BackgroundTransparency, bar0.BorderSizePixel = TH.C.PANEL, TH.A.bar, 0
    TH.corner(bar0)
    local lay = Instance.new("UIListLayout")
    lay.FillDirection, lay.HorizontalAlignment, lay.Padding = Enum.FillDirection.Vertical, Enum.HorizontalAlignment.Center, UDim.new(0, 2)
    lay.SortOrder = Enum.SortOrder.LayoutOrder
    lay.Parent = bar0
    local pad = Instance.new("UIPadding")
    pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 10), UDim.new(0, 10), UDim.new(0, 4), UDim.new(0, 4)
    pad.Parent = bar0
    local r1, r2 = row(bar0, 1), row(bar0, 2)
    local n = 0
    for _, k in ipairs(ORDER) do
      if c.cats[k] then n += 2 swatch(r1, k, n) end
    end
    n = 0
    for _, k in ipairs({ "hurt", "broken", "kia", "fire" }) do
      if k ~= "kia" or c.cats.crew then n += 2 swatch(r2, k, n) end
    end
    -- 用户 11-28「然后目前车上按x透视的时候鼠标会出来」：只按 X 鼠标不放出来（镜头照常转）；要用指针指部件看名字、状态，再按住 Alt（Drive.lua）
    if UIS.MouseEnabled and not (UIS.TouchEnabled and not UIS.KeyboardEnabled) then
      local hint = label(bar0, T("xr.altHint"), TH.F.body or TH.F.bold, TH.S.tiny or TH.S.small, TH.C.MUTE, 3)
      hint.Name = "AltHint"
    end
    bar0.Parent = sg
    -- 鼠标指着的部件：名字、状态、细节（弹药架几发、哪种弹……）
    local tip = Instance.new("Frame")
    tip.Name = "Tip"
    tip.AutomaticSize, tip.Size = Enum.AutomaticSize.XY, UDim2.fromOffset(0, 0)
    tip.BackgroundColor3, tip.BackgroundTransparency, tip.BorderSizePixel = TH.C.PANEL, TH.A.panel, 0
    tip.Visible = false
    TH.corner(tip)
    TH.stroke(tip)
    local tl = Instance.new("UIListLayout")
    tl.FillDirection, tl.Padding, tl.SortOrder = Enum.FillDirection.Vertical, UDim.new(0, 1), Enum.SortOrder.LayoutOrder
    tl.Parent = tip
    local tp = Instance.new("UIPadding")
    tp.PaddingLeft, tp.PaddingRight, tp.PaddingTop, tp.PaddingBottom = UDim.new(0, 8), UDim.new(0, 8), UDim.new(0, 4), UDim.new(0, 5)
    tp.Parent = tip
    c.tipName = label(tip, "", TH.F.bold, TH.S.body, TH.C.TEXT, 1)
    c.tipName.Name = "Name"
    c.tipState = label(tip, "", TH.F.bold, TH.S.small, TH.C.GOOD, 2)
    c.tipState.Name = "State"
    c.tipInfo = label(tip, "", TH.F.bold, TH.S.small, TH.C.MUTE, 3)
    c.tipInfo.Name = "Info"
    tip.Parent = sg
    c.tip = tip
    sg.Parent = pg
    return sg
  end

  ---------------------------------------------------------------- 建 / 清

  local function liveOf(st)
    local em = st.em
    local live = { rdy = em:GetAttribute("Rdy"), rdyCap = em:GetAttribute("RdyCap"), aml = em:GetAttribute("AmL") }
    local wid = XrayOwn.mainWeapon(st.d)
    local vs = G.S and G.S.veh
    if wid and vs and (vs.id == nil or vs.id == st.id) and type(vs.ammo) == "table" then
      local am = vs.ammo[wid]
      if type(am) == "table" and type(am[1]) == "number" and type(am[2]) == "number" then live.total = am[1] + am[2] end
    end
    if live.total == nil and type(live.aml) == "string" then
      local s, any = 0, false
      for n in string.gmatch(live.aml, ":(%d+)") do s += tonumber(n) any = true end
      if any then live.total = s end
    end
    -- 反坦克导弹：发射筒里还装着几发（客户端的弹数 { 装着的, 备弹 }）
    for _, w2 in ipairs(st.d.weapons or {}) do
      if XrayOwn.ATGM[w2] and vs and (vs.id == nil or vs.id == st.id) and type(vs.ammo) == "table" then
        local am = vs.ammo[w2]
        if type(am) == "table" and type(am[1]) == "number" then live.msl = am[1] end
        break
      end
    end
    return live
  end
  -- 发射架上画几发：装着几发就几发（拿不到弹数按装满）
  local function launchN(x, live) return math.clamp(math.floor(tonumber(live.msl) or x.launch.cap), 0, x.launch.cap) end

  local function clear()
    local c = cur
    if not c then return end
    cur = nil
    for _, x in ipairs(c.items) do
      for _, q in ipairs(x.parts or {}) do give(q.p) end
      x.parts = nil
    end
    if c.folder then c.folder:Destroy() end
    if c.gui then c.gui:Destroy() end
    for _, f in ipairs(c.faded or {}) do
      if f[1].Parent then f[1].LocalTransparencyModifier = f[2] end
    end
  end

  local function build(st)
    local d = st.d
    local v = G.views and G.views[st.em]
    -- Highlight 全客户端同时最多画 31 个：第三人称车辆热成像（Night.lua，1 + 最多 24 个）先让开，透视（最多 MAXG 组 + 车身轮廓）一个人用
    if G.vehIrHide then pcall(G.vehIrHide) end
    local live = liveOf(st)
    local ok, P = pcall(XrayOwn.plan, d, { M = v and v.M, live = live })
    if not ok or not P then
      if G.showError then G.showError("local XrayOwn: " .. tostring(P)) end
      return nil
    end
    stats.builds += 1
    local c = { st = st, v = v, d = d, P = P, items = P.items, A = P.A, lay = P.lay, groups = {}, hls = {}, nG = 0, cs = {}, seatS = {}, ms = {}, cats = {}, dirty = true }
    c.liveSig = tostring(live.total) .. "/" .. tostring(live.rdy) .. "/" .. tostring(live.rdyCap) .. "/" .. tostring(live.aml) .. "/" .. tostring(live.msl)   -- 同 sigOf：建的时候就是按这一份画的
    c.folder = Instance.new("Folder")
    c.folder.Name = "OwnXray"
    for _, x in ipairs(c.items) do
      c.cats[x.cat] = true
      x.parts, x.ov = {}, nil
      for i, sp in ipairs(x.specs) do
        local p = take(sp.sh)
        p.Size = sp.s
        local col = shade(PAL[x.cat] or PAL.other, sp.g)
        p.Color = col
        p.Name = x.k
        x.parts[i] = { p = p, cf = sp.cf, key = keyOf(x.cat, sp.g), col = col, slot = sp.slot, vis = true }
      end
    end
    -- 弹架：只画现在有的那几发；炸掉的爆反块不画
    for _, x in ipairs(c.items) do
      if x.rack then
        local rk = P.R[x.k]
        local n = math.min((rk and rk.n) or 0, x.rack.cap)
        local vis = n * x.rack.per
        x.rack.vis, x.rack.n = vis, n
        for _, q in ipairs(x.parts) do q.vis = (q.slot == nil) or (q.slot <= vis) end
      elseif x.launch then
        local n = launchN(x, live)
        x.launch.n = n
        for _, q in ipairs(x.parts) do q.vis = (q.slot == nil) or (q.slot <= n) end
      elseif x.eraE then
        for _, q in ipairs(x.parts) do
          local e = x.eraE[q.slot]
          q.vis = e ~= nil and not e.blown
        end
      end
    end
    for _, x in ipairs(c.items) do
      for _, q in ipairs(x.parts) do if q.vis then q.p.Parent = group(c, q.key) end end
    end
    -- 车身：半透明的壳（原来的透明度记着，松手还原）+ 轮廓线
    c.faded = {}
    local m = v and v.model
    if m then
      for _, q in ipairs(m:GetDescendants()) do
        if q:IsA("BasePart") and q.Transparency < 0.95 then
          c.faded[#c.faded + 1] = { q, q.LocalTransparencyModifier }
          q.LocalTransparencyModifier = math.max(q.LocalTransparencyModifier, 0.86)   -- 11-28：0.82 → 0.86，里面的部件更清楚
        end
      end
      local hl = Instance.new("Highlight")
      hl.Name = "Hull"
      hl.DepthMode = Enum.HighlightDepthMode.Occluded
      hl.FillTransparency, hl.OutlineTransparency, hl.OutlineColor = 1, 0.25, RGB(214, 226, 238)   -- 车身外轮廓：淡淡的一圈亮线
      hl.Adornee, hl.Parent = m, c.folder
    end
    c.folder.Parent = workspace
    c.gui = buildGui(c)
    return c
  end

  ---------------------------------------------------------------- 每帧

  -- 乘员按座位（服务器 WtC 每个人是「状态 .. 现在的座位」，Wt.lua：装填手顶上阵亡的炮长以后「2gnr,0ldr」——炮长位上是活人、
  --   装填手位空了；同 WtTank 损伤图的读法：一个座位取状态最好的那个，WtC 里没这个座位的算没人）；老格式（只有状态没有座位）按顺序
  local function parseStates(c, em)
    local wc, wm = em:GetAttribute("WtC"), em:GetAttribute("WtM")
    if wc == c.wc and wm == c.wm then return end
    c.wc, c.wm = wc, wm
    local cs, seat, named, ms = {}, {}, false, {}
    local i = 0
    for tok in string.gmatch(type(wc) == "string" and wc or "", "[^,]+") do
      i += 1
      local s, sn = tonumber(string.sub(tok, 1, 1)) or 2, string.sub(tok, 2)
      cs[i] = s
      if sn ~= "" then
        named = true
        if seat[sn] == nil or s > seat[sn] then seat[sn] = s end
      end
    end
    if type(wm) == "string" then for j = 1, #wm do ms[j] = tonumber(string.sub(wm, j, j)) or 2 end end
    c.cs, c.seatS, c.named, c.ms = cs, seat, named, ms
  end
  local function crewS(c, x)
    if c.named then return c.seatS[(x.it and x.it.role) or x.k] or 0 end
    return c.cs[x.ci] or 2
  end
  -- 这一件现在该在哪个状态组（nil = 按类别）
  local function stateKey(c, x)
    if x.ci then
      local s = crewS(c, x)
      if s == 0 then return "kia" end
      if s == 1 then return "hurt" end
      return nil
    end
    if x.mi then
      local s = c.ms[x.mi] or 2
      if s == 0 then return "broken" end
      if c.afire and x.cat == "ammo" and (not x.rack or x.rack.vis > 0) then return "fire" end
      if c.fire and not c.afire and (x.k == "engine" or x.cat == "fuel") then return "fire" end
      if s == 1 then return "hurt" end
    end
    return nil
  end
  local function setOv(c, x, ov)
    if x.ov == ov then return end
    x.ov = ov
    local col = ov and ((ov == "hover") and c.hoverCol or STATE[ov]) or nil
    for _, q in ipairs(x.parts) do
      q.p.Color = col or q.col
      if q.vis then q.p.Parent = group(c, ov or q.key) end
    end
    stats.regroup += 1
  end
  local function setVis(c, x, q, want)
    if q.vis == want then return end
    q.vis = want
    q.p.Parent = want and group(c, x.ov or q.key) or nil
    c.dirty = true
  end
  local function rebuildMoves(c)
    local P, F, O, X, S, Sl = {}, {}, {}, {}, {}, {}
    for _, x in ipairs(c.items) do
      for _, q in ipairs(x.parts) do
        if q.vis then
          local n = #P + 1
          P[n], F[n], O[n], X[n], S[n], Sl[n] = q.p, x.frame, q.cf, x, q.p.Size, q.slot
        end
      end
    end
    c.mP, c.mF, c.mO, c.mX, c.mS, c.mSl, c.mC = P, F, O, X, S, Sl, {}
    c.dirty = false
  end

  -- 射线（世界）打零件：近似成方盒
  local function slab(p, dd, h, t0, t1)
    if math.abs(dd) < 1e-9 then
      if p < -h or p > h then return 1, 0 end
      return t0, t1
    end
    local a, b = (-h - p) / dd, (h - p) / dd
    if a > b then a, b = b, a end
    if a > t0 then t0 = a end
    if b < t1 then t1 = b end
    return t0, t1
  end
  local function rayBox(o, dv, cf, size)
    local lo = cf:PointToObjectSpace(o)
    local ld = cf:VectorToObjectSpace(dv)
    local t0, t1 = slab(lo.X, ld.X, size.X / 2, 0, 1)
    if t0 > t1 then return nil end
    t0, t1 = slab(lo.Y, ld.Y, size.Y / 2, t0, t1)
    if t0 > t1 then return nil end
    t0, t1 = slab(lo.Z, ld.Z, size.Z / 2, t0, t1)
    if t0 > t1 then return nil end
    return t0
  end
  local function pick(c, px, py)
    local cam = workspace.CurrentCamera
    if not cam or not c.mP then return nil end
    local ray = cam:ViewportPointToRay(px, py)
    local o, dv = ray.Origin, ray.Direction * 600
    local best, bx, bs = math.huge, nil, nil
    for i = 1, #c.mP do
      local cf = c.mC[i]
      if cf then
        local t = rayBox(o, dv, cf, c.mS[i])
        if t and t < best then best, bx, bs = t, c.mX[i], c.mSl[i] end
      end
    end
    return bx, bs
  end

  local function nameOf(x)
    if x.kind == "crew" then return T("wt.r." .. ((x.it and x.it.role) or x.k), x.k) end
    if x.nm then return T(x.nm, x.k) end
    return T("wt.m." .. x.k, x.k)
  end
  -- 状态的一行：文字、颜色
  local function stateText(c, x)
    local st, col = nil, TH.C.GOOD
    if x.ci then
      local s = crewS(c, x)
      if s == 0 then st, col = T("xr.s.kia", "阵亡"), TH.C.BAD
      elseif s == 1 then st, col = T("xr.s.wounded", "受伤"), TH.C.WARN
      else st = T("xr.s.ok", "完好") end
    elseif x.mi then
      local s = c.ms[x.mi] or 2
      if s == 0 then st, col = T("xr.s.broken", "损毁"), TH.C.BAD
      elseif s == 1 then st, col = T("xr.s.hurt", "受损"), TH.C.WARN
      else st = T("xr.s.ok", "完好") end
      if stateKey(c, x) == "fire" or (s == 0 and ((c.afire and x.cat == "ammo") or (c.fire and not c.afire and (x.k == "engine" or x.cat == "fuel")))) then
        st, col = st .. " · " .. T("xr.s.fire", "起火"), (s == 0) and TH.C.BAD or STATE.fire
      end
    elseif x.k == "era" then
      st = T("xr.s.ok", "完好")
    end
    return st, col
  end
  local function infoText(c, x, slot)
    local bits = {}
    if x.detail then bits[#bits + 1] = T(x.detail, "") end
    if x.rack then
      bits[#bits + 1] = T("xr.d.rounds", tostring(x.rack.n) .. " / " .. tostring(x.rack.cap), x.rack.n, x.rack.cap)
      local i = slot and math.ceil(slot / x.rack.per) or nil
      local nm = i and x.rack.names and x.rack.names[i]
      if nm then bits[#bits + 1] = nm end
    elseif x.launch then   -- 发射架：装着几发、哪种导弹
      bits[#bits + 1] = T("xr.d.rounds", tostring(x.launch.n or 0) .. " / " .. tostring(x.launch.cap), x.launch.n or 0, x.launch.cap)
      bits[#bits + 1] = T("vw." .. x.launch.wid, x.launch.wid)
    end
    if (x.k == "barrel" or x.k == "breech") and c.A and c.A.cal then bits[#bits + 1] = T("xr.d.mm", c.A.cal .. " mm", c.A.cal) end
    local out = {}
    for _, b in ipairs(bits) do if b ~= "" then out[#out + 1] = b end end
    return table.concat(out, " · ")
  end
  local function setHover(c, x, slot, mx, my)
    if c.hoverX ~= x then
      local old = c.hoverX
      c.hoverX = x
      if old then setOv(c, old, stateKey(c, old)) end
      if x then
        local sk = stateKey(c, x)
        c.hoverCol = (sk and STATE[sk] or PAL[x.cat] or PAL.other):Lerp(WHITE, 0.35)
        local g = group(c, "hover")
        local h = c.hls.hover
        if h and g then h.FillColor = c.hoverCol end
        setOv(c, x, "hover")
      end
    end
    local tip = c.tip
    if not tip then return end
    if not x then tip.Visible = false return end
    c.tipName.Text = nameOf(x)
    local st, col = stateText(c, x)
    c.tipState.Text, c.tipState.TextColor3, c.tipState.Visible = st or "", col, st ~= nil
    local info = infoText(c, x, slot)
    c.tipInfo.Text, c.tipInfo.Visible = info, info ~= ""
    local cam = workspace.CurrentCamera
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    tip.Position = UDim2.fromOffset(math.clamp(mx + 18, 0, math.max(0, vp.X - 220)), math.clamp(my - 10, 0, math.max(0, vp.Y - 80)))
    tip.Visible = true
  end

  local holding = false
  local hoverT = 0
  -- 指针在哪（视口像素）：电脑上鼠标没锁在屏幕中间的时候（按住 X 再按住 Alt 时 Drive 放开鼠标、显示指针；11-28 起只按 X 不放开）；手机上刚点过的那一下（4 秒内）；
  --   都没有返回 nil：不显示提示框（原来鼠标一直锁在中间，提示框钉在屏幕中间、只指得到炮管）
  local tapAt = nil
  local function pointer()
    if UIS.MouseEnabled and UIS.MouseBehavior ~= Enum.MouseBehavior.LockCenter then
      local m = UIS:GetMouseLocation()
      return m.X, m.Y
    end
    if tapAt and os.clock() - tapAt.t < 4 then return tapAt.x, tapAt.y end
    return nil
  end
  pcall(function()
    UIS.TouchTap:Connect(function(pos, processed)   -- 手机：按住透视键的时候另一只手指点一下部件
      if processed or not holding or not cur or type(pos) ~= "table" or not pos[1] then return end
      local inset = 0
      pcall(function() inset = game:GetService("GuiService"):GetGuiInset().Y end)   -- 触点不算顶栏；ViewportPointToRay 算
      tapAt = { x = pos[1].X, y = pos[1].Y + inset, t = os.clock() }
      hoverT = 0
    end)
  end)
  local function sigOf(live) return tostring(live.total) .. "/" .. tostring(live.rdy) .. "/" .. tostring(live.rdyCap) .. "/" .. tostring(live.aml) .. "/" .. tostring(live.msl) end
  -- 弹的现况变了：按现在的 AmL 重排每一架（每格哪种弹、弹头的样子），再只画现在有的那几发；格数变了返回 false（整个重建）
  local function liveChanged(c, live)
    for _, x in ipairs(c.items) do
      if x.rack then
        local y = XrayOwn.relayRack(c.P, x, live)
        if not y then return false end
        x.rack.names, x.rack.kinds, x.specs = y.rack.names, y.rack.kinds, y.specs
        for i, sp in ipairs(y.specs) do
          local q = x.parts[i]
          q.cf = sp.cf
          if q.p.Size ~= sp.s then q.p.Size = sp.s end
        end
        c.dirty = true
      end
    end
    local R = c.P.ctx.R
    for _, x in ipairs(c.items) do
      if x.rack then
        local n = math.min(R[x.k] and R[x.k].n or 0, x.rack.cap)
        local vis = n * x.rack.per
        x.rack.n = n
        if vis ~= x.rack.vis then
          x.rack.vis = vis
          for _, q in ipairs(x.parts) do setVis(c, x, q, (q.slot == nil) or (q.slot <= vis)) end
        end
      elseif x.launch then   -- 导弹打出去一发：那一筒空了
        local n = launchN(x, live)
        x.launch.n = n
        for _, q in ipairs(x.parts) do setVis(c, x, q, (q.slot == nil) or (q.slot <= n)) end
      end
    end
    return true
  end
  local function step()
    if not holding then return end
    local st = G.drive
    if not st or not st.em or not st.em.Parent or not st.root or not st.d then holding = false clear() return end
    -- 瞄准镜、车长望远镜、车内视角里不画（零件就在镜头边上，高亮糊满屏）：先收起，退出来（还按着）接着画
    if st.sight or st.binoc or (G.interiorOn and G.interiorOn()) then
      if cur then clear() end
      return
    end
    if not cur or cur.st ~= st then
      clear()
      cur = build(st)
      if not cur then holding = false return end
    end
    local c, d, em = cur, st.d, st.em
    local v = G.views and G.views[em]
    -- 框架：跟 View 摆原模型的同一套（车体晃动、炮塔方位、炮的俯仰和后坐都对得上）；没有 View 按 st 算
    local hullF = (v and v.hullF) or (st.root * CF(0, -d.H / 2, 0))
    local tF = (v and v.tF) or (d.turret and (hullF * CF(d.turret.pivot) * ANG(0, -RAD(st.ty or 0), 0))) or hullF
    local gF = (v and v.gF) or (d.gun and (tF * CF(d.gun.pivot) * ANG(RAD(st.gp or 0), 0, 0))) or tF
    c.fr = { hull = hullF, tur = tF, gun = gF }
    parseStates(c, em)
    c.fire, c.afire = em:GetAttribute("WtF") == true, em:GetAttribute("WtAF") == true
    -- 弹：打一发少一发、哪种弹打掉了（车上属性、客户端的弹数变了才重算）
    local live = liveOf(st)
    local sig = sigOf(live)
    if sig ~= c.liveSig then
      c.liveSig = sig
      if not liveChanged(c, live) then   -- 弹架格数变了（换了弹药配置）：下一帧整个重建
        clear()
        return
      end
    end
    -- 爆反块炸掉了：那一块不画
    for _, x in ipairs(c.items) do
      if x.eraE then
        for _, q in ipairs(x.parts) do
          local e = x.eraE[q.slot]
          setVis(c, x, q, e ~= nil and not e.blown)
        end
      end
    end
    for _, x in ipairs(c.items) do
      if x ~= c.hoverX then setOv(c, x, stateKey(c, x)) end
    end
    if c.dirty then rebuildMoves(c) end
    local fr, C, P, Fk, O = c.fr, c.mC, c.mP, c.mF, c.mO
    for i = 1, #P do C[i] = fr[Fk[i]] * O[i] end
    for i = #P + 1, #C do C[i] = nil end
    if #P > 0 then workspace:BulkMoveTo(P, C, Enum.BulkMoveMode.FireCFrameChanged) end
    -- 起火：火光色一闪一闪
    local fh = c.hls.fire
    if fh then
      local k = 0.5 + 0.5 * math.sin(os.clock() * 13)
      fh.FillColor = RGB(255, 92, 30):Lerp(RGB(255, 196, 70), k)
      fh.FillTransparency = 0.12 + 0.25 * (1 - k)
    end
    -- 指着的部件（一秒二十次）：没有指针不显示提示框
    local now = os.clock()
    if now - hoverT >= 0.05 then
      hoverT = now
      local px, py = pointer()
      if px then
        local x, slot = pick(c, px, py)
        setHover(c, x, slot, px, py)
      else
        setHover(c, nil)
      end
    end
  end

  function G.ownXrayOn() return holding and cur ~= nil end
  function G.ownXrayHold(down)
    holding = down and true or false
    if not holding then clear() end
  end
  G.ownXrayToggle = function() G.ownXrayHold(not holding) return holding end   -- 老的调用（测试）还能用
  G.ownXrayPlan = XrayOwn.plan
  -- 测试看的：零件数、各件几个零件、弹架几发、Highlight 几组、对象池
  function G.ownXrayInfo()
    local c = cur
    if not c then return { on = false, pooled = #pool, stats = stats } end
    local info = { on = true, pooled = #pool, stats = stats, parts = 0, shown = 0, items = {}, crew = {}, racks = {}, groups = c.nG, hover = c.hoverX and c.hoverX.k or nil }
    for _, x in ipairs(c.items) do
      local n, sh = #x.parts, 0
      for _, q in ipairs(x.parts) do if q.vis then sh += 1 end end
      info.parts += n
      info.shown += sh
      local key = (x.k == "era") and ("era_" .. x.frame) or x.k
      info.items[key] = { n = n, shown = sh, cat = x.cat, frame = x.frame, ov = x.ov, parts = x.parts }
      if x.kind == "crew" then info.crew[(x.it and x.it.role) or x.k] = sh end
      if x.rack then info.racks[x.k] = { n = x.rack.n, cap = x.rack.cap, per = x.rack.per, shown = sh, names = x.rack.names } end
      if x.launch then info.launch = { n = x.launch.n, cap = x.launch.cap, wid = x.launch.wid, shown = sh } end
    end
    local hl = 0
    for _, o in ipairs(c.folder:GetDescendants()) do if o:IsA("Highlight") then hl += 1 end end
    info.hl = hl
    return info
  end
  -- 测试：屏幕上这一点指着哪一件（返回键、名字）
  function G.ownXrayPick(px, py)
    local c = cur
    if not c then return nil end
    local x, slot = pick(c, px, py)
    if not x then return nil end
    return x.k, nameOf(x), slot
  end
  -- 每帧：init.client.lua 的 steps 里排在 view（还有 interior / ride / hatch）后面调——View 这一帧摆好车模、算好车体 / 炮塔 / 炮的框架以后
  --   再摆透视零件（原来单独连 RenderStepped，跟 View 谁先跑没保证：先跑就比车壳晚一帧，开起来里面的零件发飘）
  -- 按住 X 时外面压暗一点、远处虚掉（照战雷的 X 光，11-28）：景深对焦在车上（DayNight 的 FarBlur 照 G.xrayFocus 改对焦，不另建一个景深打架），
  --   另加一层调色压亮度、提对比；按下 0.2 秒渐入、松手渐出
  local Lighting = game:GetService("Lighting")
  local dimCC, dimK, dimT = nil, 0, os.clock()
  local focus = { k = 0, dist = 30, rad = 15 }
  local function dimStep()
    local now = os.clock()
    local dt = math.min(0.1, now - dimT)
    dimT = now
    local on = holding and cur ~= nil
    if not on and dimK <= 0 then
      if G.xrayFocus then G.xrayFocus = nil end
      return
    end
    dimK = math.clamp(dimK + (on and dt or -dt) * 5, 0, 1)
    if not dimCC then
      dimCC = Instance.new("ColorCorrectionEffect")
      dimCC.Name = "XrayDim"
      dimCC.Parent = Lighting
    end
    dimCC.Enabled = dimK > 0
    dimCC.Brightness, dimCC.Contrast = -0.05 * dimK, 0.06 * dimK
    local st = G.drive
    local cam = workspace.CurrentCamera
    focus.k = dimK
    if st and st.root and st.d and cam then
      focus.dist = (cam.CFrame.Position - st.root.Position).Magnitude
      focus.rad = math.max(st.d.L or 10, st.d.W or 6) * 0.75
    end
    G.xrayFocus = (dimK > 0) and focus or nil
  end
  G.stepOwnXray = function()
    pcall(dimStep)
    local ok, err = pcall(step)
    if not ok then
      holding = false
      pcall(clear)
      if G.showError then G.showError("local XrayOwn: " .. tostring(err)) end
    end
  end
  if not G.frameConn then RunService.RenderStepped:Connect(G.stepOwnXray) end   -- 单独跑（没有主循环）的时候自己连
end

return XrayOwn
]]></ProtectedString>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
