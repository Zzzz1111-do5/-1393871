  weeds = { kind = "flower", h = 3.23, r = 5.19, o = { 3.21, 0, 218.88 }, tris = 1070, parts = { { name = "Leaves", c = { 0.4, 0.46, 0.33 }, s = { 5.49, 0.92, 7.05 } }, { name = "Leaves2", c = { 1.89, 1.61, 0.45 }, s = { 2.88, 3.23, 4.54 } }, { name = "Leaves3", c = { 0.89, 1.09, -0.53 }, s = { 8.2, 2.18, 9.33 } } } },
