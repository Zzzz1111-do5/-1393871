        <string name="Name">SceneryMeta</string>
        <ProtectedString name="Source"><![CDATA[-- 花草树木模型包的元数据（tools/scenery/scenery.mjs 生成，别手改）：models/scenery/scenery.glb 里每一件
--   kind 种类（conifer 针叶树、young 小针叶树、broad 阔叶树、bush 灌木、dead 枯树、log 倒木、rock 石头、outcrop 岩石、grass 草丛、flower 花丛、lod 远景版本）、
--   h 高、r 冠幅半径（格）、o 在 GLB 里的原点（导入后各块按它找回相对位置）、parts 每块的中心 c 和大小 s（相对这件的原点：树干底部中心）、tris 三角形数
return {
  fir1 = { kind = "conifer", h = 49.52, r = 15.01, o = { 12.93, 0, 13.45 }, tris = 9492, parts = { { name = "Bark", c = { 0, 23.31, 0 }, s = { 11.98, 46.62, 14.47 } }, { name = "Leaves", c = { 1.04, 25, -0.05 }, s = { 27.93, 49.04, 26.79 } } } },
  fir1_m = { kind = "lod", h = 49.61, r = 15.07, o = { 60.71, 0, 14.49 }, tris = 5834, parts = { { name = "Bark", c = { 0, 23.31, 0 }, s = { 3.48, 46.62, 4.31 } }, { name = "Leaves", c = { 1.15, 25.1, -1.09 }, s = { 27.84, 49, 26.79 } } } },
  fir1_f = { kind = "lod", h = 49.11, r = 13.92, o = { 109.7, 0, 13.39 }, tris = 40, parts = { { name = "Leaves", c = { 0, 24.55, 0 }, s = { 27.84, 49.11, 26.79 } } } },
  fir2 = { kind = "conifer", h = 49.18, r = 14.07, o = { 156.55, 0, 14.07 }, tris = 7492, parts = { { name = "Bark", c = { 0, 23.29, 0 }, s = { 13.77, 46.58, 12.49 } }, { name = "Leaves", c = { 0.25, 27.72, -1.08 }, s = { 26.36, 42.91, 25.98 } } } },
  fir2_m = { kind = "lod", h = 49.25, r = 14.32, o = { 203.24, 0, 14.32 }, tris = 4452, parts = { { name = "Bark", c = { 0, 23.29, 0 }, s = { 2.7, 46.58, 3.98 } }, { name = "Leaves", c = { -0.09, 27.76, -1.33 }, s = { 26.36, 42.99, 25.98 } } } },
  fir2_f = { kind = "lod", h = 48.76, r = 13.05, o = { 249.38, 0, 12.99 }, tris = 40, parts = { { name = "Leaves", c = { 0, 24.38, 0 }, s = { 26.09, 48.76, 25.98 } } } },
  fir3 = { kind = "conifer", h = 43.07, r = 12.58, o = { 294.83, 0, 12.58 }, tris = 8272, parts = { { name = "Bark", c = { 0, 20.09, 0 }, s = { 12.94, 40.18, 11.14 } }, { name = "Leaves", c = { -0.32, 21.77, -0.23 }, s = { 24.16, 42.6, 24.69 } } } },
  fir3_m = { kind = "lod", h = 43.44, r = 13.91, o = { 338.22, 0, 13.91 }, tris = 5280, parts = { { name = "Bark", c = { 0, 17.46, 0 }, s = { 9.18, 34.91, 6.39 } }, { name = "Leaves", c = { 0.45, 22.22, -1.57 }, s = { 24.16, 42.44, 24.69 } } } },
  fir3_f = { kind = "lod", h = 43, r = 12.35, o = { 12.08, 0, 59.14 }, tris = 40, parts = { { name = "Leaves", c = { 0, 21.5, 0 }, s = { 24.16, 43, 24.69 } } } },
  fir4 = { kind = "conifer", h = 36.99, r = 13.22, o = { 56.85, 0, 60.01 }, tris = 7912, parts = { { name = "Bark", c = { 0, 17.23, 0 }, s = { 10.04, 34.46, 12.66 } }, { name = "Leaves", c = { -0.04, 18.58, -0.92 }, s = { 25.3, 36.83, 24.6 } } } },
  fir4_m = { kind = "lod", h = 37.07, r = 13.81, o = { 100.94, 0, 57.71 }, tris = 4612, parts = { { name = "Bark", c = { 0, 17.23, 0 }, s = { 6.39, 34.46, 4.77 } }, { name = "Leaves", c = { 1.16, 18.7, 1.38 }, s = { 25.3, 36.73, 24.6 } } } },
  fir4_f = { kind = "lod", h = 36.7, r = 12.65, o = { 147.4, 0, 58.97 }, tris = 40, parts = { { name = "Leaves", c = { 0, 18.35, 0 }, s = { 25.3, 36.7, 24.35 } } } },
  fir5 = { kind = "young", h = 19.86, r = 7.56, o = { 186.61, 0, 54.3 }, tris = 6412, parts = { { name = "Bark", c = { 0, 8.85, 0 }, s = { 4.86, 17.7, 5.93 } }, { name = "Leaves", c = { 0.5, 9.98, -0.58 }, s = { 14.12, 19.76, 13.86 } } } },
  fir5_f = { kind = "lod", h = 19.72, r = 7.06, o = { 221.23, 0, 53.72 }, tris = 40, parts = { { name = "Leaves", c = { 0, 9.86, 0 }, s = { 14.12, 19.72, 13.86 } } } },
  pine = { kind = "conifer", h = 49.43, r = 15.95, o = { 264.06, 0, 62.66 }, tris = 3990, parts = { { name = "Bark", c = { 0, 22.11, 0 }, s = { 22.26, 44.21, 23.39 } }, { name = "Leaves", c = { 0.09, 30.82, -0.35 }, s = { 31.72, 37.23, 31.04 } } } },
  nfir = { kind = "young", h = 27.12, r = 10.14, o = { 309.06, 0, 56.49 }, tris = 3888, parts = { { name = "Bark", c = { 0, 11.87, 0 }, s = { 11.51, 23.73, 11.13 } }, { name = "Leaves", c = { 0.54, 14.38, -0.52 }, s = { 19.19, 25.48, 18.37 } } } },
  cshrub = { kind = "bush", h = 15.35, r = 9.22, o = { 8.65, 0, 107.04 }, tris = 6199, parts = { { name = "Bark", c = { 0, 6.76, 0 }, s = { 11.91, 12.68, 12.59 } }, { name = "Leaves", c = { -0.24, 7.68, -0.4 }, s = { 16.82, 15.35, 17.62 } } } },
  sapling = { kind = "bush", h = 8.59, r = 2.68, o = { 39.41, 0, 100.26 }, tris = 729, parts = { { name = "Bark", c = { 0, 3.24, 0 }, s = { 2.35, 6.48, 2.1 } }, { name = "Leaves", c = { -0.18, 4.45, 0.12 }, s = { 4.83, 8.28, 5.12 } } } },
  deadfir = { kind = "dead", h = 45.07, r = 11.43, o = { 72.74, 0, 109.25 }, tris = 900, parts = { { name = "Bark", c = { 0, 22.54, 0 }, s = { 22.19, 45.07, 22.86 } } } },
  log = { kind = "log", h = 2.18, r = 8.23, o = { 112.07, 0, 105.21 }, tris = 320, parts = { { name = "Bark", c = { 0, 1.09, 0 }, s = { 16.46, 2.18, 14.77 } } } },
  rock1 = { kind = "rock", h = 8.08, r = 4.76, o = { 145.06, 0, 102.52 }, tris = 768, parts = { { name = "Body", c = { 0, 4.04, 0 }, s = { 9.51, 8.08, 9.4 } } } },
  rock2 = { kind = "rock", h = 8.08, r = 5.01, o = { 174.82, 0, 102.69 }, tris = 768, parts = { { name = "Body", c = { 0, 4.04, 0 }, s = { 10.02, 8.08, 9.72 } } } },
  rock3 = { kind = "outcrop", h = 10.46, r = 8.22, o = { 207.14, 0, 106.05 }, tris = 1400, parts = { { name = "Body", c = { 0, 5.23, 0 }, s = { 14.62, 10.46, 16.45 } } } },
  birch1 = { kind = "broad", h = 48.12, r = 14.2, o = { 246.83, 0, 110.81 }, tris = 2548, parts = { { name = "Bark", c = { 0, 21.05, 0 }, s = { 13.75, 42.09, 14.7 } }, { name = "Leaves", c = { 0.42, 28.27, 0.6 }, s = { 25.59, 39.7, 27.19 } } } },
  birch2 = { kind = "broad", h = 55.82, r = 13.15, o = { 12.37, 0, 158.16 }, tris = 2944, parts = { { name = "Bark", c = { 0, 25.18, 0 }, s = { 13.15, 50.36, 15.11 } }, { name = "Leaves", c = { -0.02, 34.67, -0.37 }, s = { 24.69, 42.31, 25.56 } } } },
  oak = { kind = "broad", h = 47.7, r = 25.8, o = { 70.5, 0, 169.27 }, tris = 3150, parts = { { name = "Bark", c = { 0, 18.51, 0 }, s = { 33, 37.03, 27.93 } }, { name = "Leaves", c = { -2.19, 27.06, 0.08 }, s = { 47.22, 41.29, 48.67 } } } },
  maple = { kind = "broad", h = 49.62, r = 23, o = { 133.42, 0, 166.88 }, tris = 3438, parts = { { name = "Bark", c = { 0, 19.83, 0 }, s = { 22.55, 39.67, 21.67 } }, { name = "Leaves", c = { 0.75, 27.95, -0.1 }, s = { 44.5, 43.34, 43.53 } } } },
  dshrub = { kind = "bush", h = 10.82, r = 7.35, o = { 182.56, 0, 152.2 }, tris = 3421, parts = { { name = "Bark", c = { 0, 4.03, 0 }, s = { 10.17, 7.46, 9.99 } }, { name = "Leaves", c = { 0.6, 5.41, -0.02 }, s = { 13.49, 10.82, 14.33 } } } },
  holly = { kind = "bush", h = 10.29, r = 7.78, o = { 217.22, 0, 152.32 }, tris = 3168, parts = { { name = "Bark", c = { 0, 3.26, 0 }, s = { 7.88, 6.46, 7.77 } }, { name = "Leaves", c = { 0.23, 5.14, 0.01 }, s = { 15.09, 10.29, 14.64 } } } },
  grass_s = { kind = "grass", h = 2.06, r = 5.77, o = { 249.37, 0, 150.04 }, tris = 1036, parts = { { name = "Leaves", c = { -1.53, 0.64, 0.2 }, s = { 5.67, 1.28, 8.25 } }, { name = "Leaves2", c = { 2.09, 1.03, -0.67 }, s = { 7.36, 2.06, 8.71 } } } },
  grass_t = { kind = "grass", h = 3.55, r = 4.71, o = { 278.82, 0, 148.91 }, tris = 1150, parts = { { name = "Leaves", c = { 0.28, 1.77, 0.48 }, s = { 6.99, 3.55, 8.45 } }, { name = "Leaves2", c = { -0.52, 0.7, 0.17 }, s = { 6.32, 1.41, 8.13 } } } },
