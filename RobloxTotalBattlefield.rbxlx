    FPS_M4_Trigger = { piece = "trig", c = { 0, -0.0457, -0.0154 }, n = 51, t = 40, mat = "M4",
      pos = "",
      nrm = "ALBjAKNWALBjAOZ8AOZ8AAx+AAx+ADZzADZzAEVqALBjAKNWAOZ8AOZ8AEVqAP2BAACBAACBAOmDAL+TAL+TAP2BALSaAOmDALSaAACBAACBgQAAgQAAgQAAgQAAgQAAgQAAgQAAgQAAgQAAgQAAgQAAgQAAfwAAfwAAfwAAfwAAfwAAfwAAfwAAfwAAfwAAfwAAfwAAfwAA",
      uv = "+0K/Z9NB+2TTQb9n+0LaadNB2mnTQR9s+0IfbNNBmG37Qpht+0IBb/tCv2f7Qvtk+0LaadNB2mnTQQFvZES3aGRE3WY9Q91mPUNvaz1DEG1kRBBtPUO3aGRE525kRG9rPUPnbmREAmU9QwJlr0TyZONG7WbSSPJkr0TMZq9Ep2gaRuBox0ReawJGJWtzRdpsOEe7bXNGjWyMRlVuCkDgaF1BXmt1QaZodUHMZlI98mRAP+1msT+MbJg/VG6wQNlsIkAla+w+u211QfJk",
