    <Item class="ModuleScript" referent="18">
      <Properties>
        <string name="Name">ImportedWpn</string>
        <ProtectedString name="Source"><![CDATA[-- 导弹合集（models/wpn/missiles.glb，tools/models/wpn2glb.py 生成）：署名（主菜单「致谢」）和导入了的型号
return {
  credit = "机载导弹、炸弹（AGM-114「地狱火」、AGM-65「小牛」、AIM-9X「响尾蛇」、AKD-10、GBU-12「宝石路」II、GBU-31 JDAM、GBU-32 JDAM、天燕-90）：Missile & Bomb Collection - Fighter Jets - Free，作者 bohmerang（https://sketchfab.com/3d-models/missile-bomb-collection-fighter-jets-free-d203b678424a43568703bf85ba680f47），CC BY-NC-SA 4.0 授权（https://creativecommons.org/licenses/by-nc-sa/4.0/）。署名见 models/wpn/credits.txt",
  keys = { "agm114", "agm65", "aim9x", "akd10", "gbu12", "gbu31", "gbu32", "ty90" },
}
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="19">
      <Properties>
        <string name="Name">Lang</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——中英文字。服务器给客户端发的是文字编号和参数，各人按自己的语言显示
--   客户端按 LocalizationService.RobloxLocaleId 判断：zh 开头用中文，其余英文；设置里能手动切
--   Lang.t(lang, key, ...)：{1} {2} … 换成参数；参数是表 { k = "编号", … } 时先翻译它（服务器发「据点 A」「步枪兵」这种）
local Lang = {}

local ZH, EN = {}, {}
Lang.zh, Lang.en = ZH, EN

local function add(key, zh, en)
  ZH[key] = zh
  EN[key] = en
end

---------------------------------------------------------------- 名字

add("game.title", "全面大战场", "Island Assault")   -- 评估后改的：名字里不带 Roblox（平台规则）、不带 Battlefield（EA 的商标）
add("team.atk", "进攻方", "Attackers")
add("team.def", "防守方", "Defenders")
add("team.atk.short", "攻", "ATK")
add("team.def.short", "守", "DEF")
-- 选阵营：两个虚构的阵营（评估后改的，降低被 Roblox 审核下架的风险；原来是解放军 = 进攻方、美军 = 防守方，装备型号照旧）
--   登陆联军 COALITION LANDING FORCE（CLF）= 进攻方、岛屿守备军 ISLAND GARRISON COMMAND（IGC）= 防守方
add("faction.title", "选择阵营", "CHOOSE YOUR SIDE")
add("faction.sub", "夜战 · 群岛登陆", "NIGHT OPS · ARCHIPELAGO ASSAULT")
add("faction.atk.en", "COALITION LANDING FORCE", "COALITION LANDING FORCE")
add("faction.def.en", "ISLAND GARRISON COMMAND", "ISLAND GARRISON COMMAND")
add("faction.atk.name", "登陆联军", "CLF")
add("faction.def.name", "岛屿守备军", "IGC")
add("faction.atk.role", "进攻  ·  两栖登陆", "ATTACK  ·  AMPHIBIOUS ASSAULT")
add("faction.def.role", "防守  ·  岛屿防御", "DEFEND  ·  ISLAND DEFENSE")
add("faction.atk.desc", "从海上一路打上去：先抢滩前哨岛 A，再登陆主岛拿下港口 C 和机场 D，最后攻下指挥部 E。上了主岛以后可以直接在目标前面的攻击出发阵地出生。每阵亡一人兵力少 1，兵力打光就输。",
  "Fight your way in from the sea: storm Outpost A, land on the main island to take Port C and Airfield D, then seize Command E. Once ashore, spawn at the assault position in front of each objective. Every death costs one reinforcement; run out and you lose.")
add("faction.def.desc", "一道防线一道防线地守：守住当前的据点，把攻方的兵力耗光、或者拖到时间结束就赢。据点被压着时在后方集结点出生。",
  "Hold the line, sector by sector: defend the current objectives until the attackers run out of reinforcements or time. Spawn at the rally point behind a contested objective.")
add("faction.players", "{1} 名玩家", "{1} PLAYERS")
add("faction.join", "加入", "JOIN")
add("faction.stay", "继续", "CONTINUE")
add("faction.full", "人数已满", "TEAM FULL")
add("faction.round", "第 {1} 局", "ROUND {1}")
add("ui.teamFull", "这一边人数已满", "That side is full")
add("ui.switchSide", "换阵营", "Switch side")

add("role.rifle", "步枪兵", "Rifleman")
add("role.mg", "机枪手", "Machine Gunner")
add("role.sniper", "狙击手", "Sniper")
add("role.at", "反坦克兵", "Anti-Tank")
