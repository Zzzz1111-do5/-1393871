    ["eco.pve"] = "ミッション報酬 +{1} コイン",
    ["eco.round"] = "このラウンド +{1} コイン",
    ["eo.hint"] = "[P] ポッド終了 · マウス 旋回 · ホイール ズーム\n[Z] 広角 / 狭角 · [V] 白熱 / 黒熱 / TV\n[R] 次の目標 · クリック 投下 / 射撃 · 自動操縦が水平飛行を維持",
    ["eo.range"] = "距離",
    ["eo.sayArea"] = "マウスで捜索、ホイールでズーム。",
    ["eo.sayHold"] = "投下済み。ポッドを目標に向け続けろ。",
    ["eo.sayPoint"] = "目標を追尾中。クリックで投下。",
    ["eo.title"] = "光学ポッド",
    ["faction.atk.desc"] = "海から攻め上がれ：まず前哨島 A を強襲し、本島に上陸して港 C と飛行場 D を奪い、最後に司令部 E を攻略する。上陸後は各目標の前にある攻撃発起位置から出撃できる。戦死するたびに兵力が 1 減り、尽きたら敗北。",
    ["faction.atk.desc@city"] = "南の本拠地から出撃（車両置き場・ヘリパッド・滑走路はすべて基地内）：まず製鉄所 A、次に公園 B、中央広場 C、鉄道駅 D、最後に北のテレビ塔 E を奪う。狭い街路と建物が視界を遮る：曲がり角と隙間に注意。木は体当たりで倒れ、砲弾で建物も崩れる。",
    ["faction.atk.desc@sands"] = "前進基地と前進飛行場から北上：国境の砂の壁を突破して哨所 A を奪い、次に油田 B、町 C、空軍基地 D、最後に尾根の司令部 E を攻略。各目標の前にある攻撃発起位置から出撃できる。戦死するたびに兵力が 1 減り、尽きたら敗北。",
    ["faction.atk.desc@snow"] = "南の本拠地から出撃（車両置き場・ヘリパッド・滑走路はすべて基地内）：まず製材所 A、次に西斜面のレーダー基地 B、川沿いの山村 C、氷湖畔の水力発電所 D、最後に北の峠 E を奪う。谷は尾根とガリーだらけ：稜線の陰でハルダウンして戦え — 氷上には遮蔽物がない。",
    ["faction.atk.name"] = "上陸連合軍",
    ["faction.atk.role"] = "攻撃  ·  上陸作戦",
    ["faction.atk.role@city"] = "攻撃  ·  南から市内へ突入",
    ["faction.atk.role@sands"] = "攻撃  ·  機甲突撃",
    ["faction.atk.role@snow"] = "攻撃  ·  谷を北上",
    ["faction.def.desc"] = "防衛線をひとつずつ守り抜け：現在の拠点を守り、攻撃側の兵力を使い果たさせるか時間切れまで粘れば勝利。拠点が攻められている間は後方の集結地点から出撃する。",
    ["faction.def.desc@snow"] = "谷を拠点ごとに守り抜け：製材所 A、レーダー基地 B、山村 C、水力発電所 D、峠 E。高所（レーダー台地、峠の両肩）から撃ち下ろせ。山村の廃墟には戦車を隠せる。",
    ["faction.def.name"] = "島嶼守備軍",
    ["faction.def.role"] = "防衛  ·  島嶼防衛",
    ["faction.def.role@city"] = "防衛  ·  市街を守る",
    ["faction.def.role@sands"] = "防衛  ·  縦深防御",
    ["faction.def.role@snow"] = "防衛  ·  峠を守る",
