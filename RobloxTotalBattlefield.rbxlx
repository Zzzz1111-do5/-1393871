    <Item class="ModuleScript" referent="25">
      <Properties>
        <string name="Name">ImportedMeta</string>
        <ProtectedString name="Source"><![CDATA[-- 自动生成（tools/models/mdl2glb.py），别手改：装备原模型（models/veh/<模型键>.glb）的元数据——网页版的模型原样转的，网页版没有的从 Sketchfab 下载（tools/models/sfveh.py）
--   alias：游戏里的型号 → 模型键；m[模型键] = { len 长 / w 宽 / h 高（格，真实尺寸：1 米 = 2.8 格；含炮管、天线）, hull 车身的宽高长（不含炮塔、炮）,
--     parts[块名] = { g 部件（Body / Turret / Gun / W01…）, c 中心, s 大小,
--       col 没有底色贴图的块的颜色（sRGB 0–255）, a 不透明度（半透明的才有）, met 金属 }（原点在车底中心，−Z 朝前）,
--     tur 炮塔转轴, gun 炮耳轴, muz 炮口在耳轴前多远, wheels[部件] = { c 中心, r 半径 }, credit 署名 }；导入后 MeshPart 叫 V_<模型键>__<块名>
--     old：游戏里的型号 → 旧模型键（alias 那个模型没导入时退回旧的，tools/models/blveh_meta.py）；int：原模型自带车内（块的 k = "int"）；src：原模型 glTF 坐标 → 这里的坐标（tools/models/blveh.py）；pts：原模型上量的点（格）
return {
  alias = { bmp1 = "bmp1", bmp2 = "bmp2", bmp2m = "bmp2", brdm2 = "brdm2", cram = "cram", gepard1a1 = "gepard", gepard1a2 = "gepard", hmmwv = "hmmwv", jltv = "jltv", kpz70 = "mbt70", leclerc = "leclerc", leo1 = "leo1", leo1a1a1 = "leo1", leo1a5 = "leo1", leo2a0 = "leo2a6", leo2a4 = "leo2a6", leo2a5 = "leo2a6", leo2a6 = "leo2a6", leo2a7v = "leo2a7v", m1 = "m1a1i", m109a7 = "m109", m163 = "m163", m1a1 = "m1a1i", m1a1base = "m1a1i", m1a1hc = "m1a1i", m1a2 = "m1a2dc", m1a2base = "m1a2dc", m1a2sep = "m1a2dc", m1a2sep3 = "m1a2dc", m1ip = "m1a1i", m270 = "m270", m2a0 = "m2a3", m2a2 = "m2a3", m2a3 = "m2a3", m551 = "m551", m60 = "m60a3", m60a1 = "m60a3", m60a1rise = "m60a3", m60a3 = "m60a3", marder1a3 = "marder", mshorad = "stryker", pantsir = "pantsir", patriot = "patriot", pgl625 = "t625", plz07 = "pzh2000", strela1 = "strela1", su100 = "su100", t3485 = "t3485", t64a = "t64", t64b = "t64", t72a = "t72b3", t72b = "t72b3", t72b3 = "t72b3", t72ural = "t72b3", t80b = "t80u", t80bvm = "t80u", t80u = "t80u", t90a = "t90m", t90m = "t90m", type10 = "type10", type59 = "type59", type69 = "type59", type74 = "type74", type74g = "type74", type86 = "bmp1", type87rcv = "type87rcv", ztz96 = "ztz96", ztz96a = "ztz96", ztz96base = "ztz96", ztz99a = "ztz99a2", ztz99base = "ztz99a2" },
  old = { m1 = "m1a1", m1a1 = "m1a1", m1a1base = "m1a1", m1a1hc = "m1a1", m1ip = "m1a1" },
