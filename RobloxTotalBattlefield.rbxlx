  -- 苏-25：两台 R-95Sh 涡喷（各 40.2 千牛，不加力；涡喷推力不怎么随速度掉），大展弦比直翼 + 前缘缝翼；机械操纵（助力）+ 阻尼器，稳；
  --   翼尖开裂式减速板
  su25 = { m0 = 9500, fi = 3000, S = 30.1, b = 14.36, c = 2.3, L = 15.33, Tm = 80400, lap = { 0.1, 0.12 },
    CLa = 4.6, aS = 18, CLm = 1.5, CD0 = 0.03, e = 0.8, Mcr = 0.7, CDw = 0.045, nz = { -3, 6.5 }, pmax = 125, fcs = "mech", bw = 0.55, sm = 0.1,
    Cmq = -12, Clp = -0.48, Cnr = -0.22, Cnb = 0.1, Clb = -0.09, Cmde = -1.3, Cndr = -0.08, de = 25, da = 20, dr = 25, rde = 40, rda = 50, rdr = 60,
    kx = 0.14, ky = 0.18, kz = 0.22, sb = 0.12, up = 5, dn = 3.5, vne = 280, Kq = 0.1, Kr = 0.4, flapCL = 0.45, qmax = 0.35 },
}
-- T-50（苏-57 的原型机）：同样的发动机，原型机更重（测试设备），飞控软件限制保守一些
FM.AC.t50 = setmetatable({ m0 = 19000, aL = 30, pmax = 260, bw = 0.95 }, { __index = FM.AC.su57 })
-- 苏-27 系（边条 + 放宽静稳定）：失速后低头力矩小——真机不靠推力矢量也能拉眼镜蛇（苏-27，1989 年巴黎航展），解除迎角限制后能仰到 90° 以上
for _, k in ipairs({ "j11", "j15t", "j16", "su27", "su35", "su57" }) do FM.AC[k].cmS = 0.1 end

-- 同型号不同版本（科技树的键：用户 11-26「同型号不同版本分开……自己的性能」）：照 base 那一型，改写不一样的量
FM.VAR = {
  us_f16a = { base = "f16", m0 = 7070, fi = 3160, Tm = 64900, Ta = 106000, bw = 1.05 },   -- F-16A Block 10/15：F100-PW-200（军推 64.9、加力 106 千牛），模拟电传
  jp_f2a = { base = "f16", m0 = 9527, fi = 3700, S = 34.84, b = 11.13, c = 3.6, L = 15.52, Tm = 76000, Ta = 131000, CD0 = 0.0185, pmax = 280, bw = 1.1, kx = 0.135, aL = 26 },   -- F-2A：机翼放大 25%，F110-IHI-129
  us_f15a = { base = "f15", m0 = 12250, fi = 5260, Tm = 130600, Ta = 212000 },   -- F-15A：F100-PW-100
  us_f15e = { base = "f15", m0 = 14300, fi = 10400, CD0 = 0.025, Tm = 158000, Ta = 259400, pmax = 200, kx = 0.105 },   -- F-15E：保形油箱（算进内油）、F100-PW-229
  jp_f15jm = { base = "f15" },   -- F-15J（M）：F100-IHI-220E，同 F-15C
  us_a10a = { base = "a10c", m0 = 11000 },
  cn_j10a = { base = "j10", Tm = 76000, Ta = 123000, bw = 1.1, pmax = 270 },   -- 歼-10A：AL-31FN
  cn_j11 = { base = "j11", m0 = 16380, Tm = 149000, Ta = 245200 },   -- 歼-11（早期）：AL-31F
  ru_su27sm = { base = "su27", m0 = 16600, Tm = 152000, Ta = 264000, bw = 0.9 },   -- 苏-27SM：AL-31F-M1
  -- 苏-30SM：鸭翼 + 推力矢量（AL-31FP，喷口在外倾 32° 的斜面里偏 ±15°），数字电传；用歼-16 的模型
  ru_su30sm = { base = "j16", m0 = 18800, fi = 9640, Tm = 150000, Ta = 245200, CLm = 2.0, aS = 35, aL = 30, pmax = 230, bw = 0.95, nz = { -3, 9 },
    tvc = { p = 15, y = 8, r = 60 } },
}

---------------------------------------------------------------- 推导

local cache = {}
-- 这一型（科技树的键优先）的物理量：缺的按 BASE，换算成弧度、算转动惯量的回转半径、诱导阻力因子、副翼操纵导数……
function FM.get(id, treeKey)
  local key = (treeKey and FM.VAR[treeKey]) and treeKey or id
  if cache[key] then return cache[key] end
  local src
  if FM.VAR[key] then
    local v = FM.VAR[key]
    src = setmetatable({}, { __index = function(_, k) if v[k] ~= nil then return v[k] end return FM.AC[v.base][k] end })
  else
    src = FM.AC[key]
  end
  if not src then return nil end
  local D = { key = key }
  for k, v in pairs(BASE) do D[k] = v end
  local fields = { "m0", "fi", "S", "b", "c", "L", "Tm", "Ta", "ne", "lap", "CLa", "aS", "CLm", "CD0", "e", "K", "Mcr", "CDw", "nz", "aL", "pmax", "fcs", "bw", "tn", "tp", "sm",
    "Cm0", "Cmq", "Clp", "Cnr", "Cnb", "Clb", "CYb", "Clr", "Cnp", "Cmde", "Clda", "Cndr", "CYdr", "Cnda", "Cldr", "de", "da", "dr", "rde", "rda", "rdr",
    "kx", "ky", "kz", "sb", "gearCD", "flapCL", "up", "dn", "ab", "vne", "Kq", "Kr", "qmax", "pu", "tvc", "prop", "swp", "cmS" }
  for _, f in ipairs(fields) do
    local v = src[f]
    if v ~= nil then D[f] = v end
  end
  -- 前置滤波按操纵方式给默认：电传脆、增稳次之、机械（教官飞的时候）最慢
  D.tn = D.tn or ((D.fcs == "fbw") and 0.16 or ((D.fcs == "cas") and 0.22 or 0.3))
  D.tp = D.tp or ((D.fcs == "fbw") and 0.12 or ((D.fcs == "cas") and 0.16 or 0.22))
  if D.prop and not D.Tm then D.Tm = D.prop.Tst end
  D.Ta = D.Ta or D.Tm
  D.vne = D.vne or 400
  D.CLa, D.CLm = D.CLa * AGILE.lift, D.CLm * AGILE.lift   -- 转弯机动性（见上面 AGILE）
  if D.K then D.K = D.K * AGILE.ind else D.e = D.e / AGILE.ind end
  FM.finish(D)
  cache[key] = D
  return D
end

-- 跟后掠角、换算有关的量（F-14 后掠变了要重算一遍：FM.sweep）
function FM.finish(D)
  D.AR = D.b * D.b / D.S
  D.Kc = D.K or 1 / (math.pi * D.AR * D.e)
  D.aSr = D.aS * RAD
  D.aLr = D.aL and D.aL * RAD or nil
  D.pmaxr = D.pmax * RAD
  D.der, D.dar, D.drr = D.de * RAD, D.da * RAD, D.dr * RAD
  D.rder, D.rdar, D.rdrr = D.rde * RAD, D.rda * RAD, D.rdr * RAD
  D.Cma = -D.CLa * D.sm
  -- 升力曲线：线性段到 a1，之后二次曲线圆滑到失速迎角处的最大升力（斜率连续）
  local aLin = D.CLm / D.CLa
  local a1 = 2 * aLin - D.aSr
  if a1 < 0.5 * aLin or a1 >= D.aSr then a1 = 0.75 * D.aSr end
  D.a1 = a1
  D.CL1 = D.CLa * a1
  -- 负迎角：失速得早、最大升力小
  D.aSN, D.CLmN = D.aSr * 0.65, D.CLm * 0.6
  D.a1N = math.min(D.aSN * 0.75, D.CLmN / D.CLa)
  D.CL1N = D.CLa * D.a1N
  -- 回转半径（米）：转动惯量 = 质量 × 半径²
  D.rx2 = (D.kx * D.b) ^ 2
  D.ry2 = (D.ky * D.L) ^ 2
  D.rz2 = (D.kz * (D.b + D.L) / 2) ^ 2
  D.tl = 0.42 * D.L   -- 喷口到重心
  -- 副翼操纵导数：没给的按最大滚转角速度反推——在 0.6 倍最大允许速度下，满副翼的稳态滚转角速度比 pmax 多一成五
  if not D.Clda then
    local Vr = 0.6 * D.vne
    D.Clda = abs(D.Clp) * (D.pmaxr * D.b / (2 * Vr)) / D.dar * 1.15
  end
  D.nzN, D.nzP = D.nz[1], D.nz[2]
  return D
end

-- F-14：按马赫数自动调后掠角（0 ~ 1：20° ~ 68°），返回这一刻的量（缓存两档之间插值的那张表，按 0.02 一档）
local swCache = {}
function FM.sweep(D, M)
  local W = D.swp
  if not W then return D, 0 end
  local s = smooth(W.M0, W.M1, M)
  local k = math.floor(s * 50 + 0.5)
  local ck = D.key .. "@" .. k
  local E = swCache[ck]
  if not E then
    local t = k / 50
    E = setmetatable({}, { __index = D })
    E.b = lerp(D.b, W.b, t)
    E.CLa = lerp(D.CLa, W.CLa * AGILE.lift, t)   -- 收后掠那一套也乘转弯机动性（D 的已经在 FM.get 里乘过）
    E.CLm = lerp(D.CLm, W.CLm * AGILE.lift, t)
    E.aS = lerp(D.aS, W.aS, t)
    E.Mcr = lerp(D.Mcr, W.Mcr, t)
    E.CDw = lerp(D.CDw, W.CDw, t)
    E.Clp = lerp(D.Clp, W.Clp, t)
    E.kx = lerp(D.kx, W.kx, t)
    E.Clda = nil
    E.K = nil
    for _, f in ipairs({ "AR", "Kc", "aSr", "a1", "CL1", "aSN", "CLmN", "a1N", "CL1N", "rx2", "Cma" }) do E[f] = nil end
    FM.finish(E)
    E.Clda = D.Clda * lerp(1, 0.75, t)   -- 收起后掠：扰流板 + 差动平尾的滚转力矩小一些
    E.sweepK = t
    swCache[ck] = E
  end
  return E, E.sweepK
end

---------------------------------------------------------------- 气动、推力

-- 升力系数（迎角 rad；flap 0 ~ 1）
local function CLof(D, a, flap)
  local sgn, aa = 1, a
  if a < 0 then sgn, aa = -1, -a end
  local CLm, aS, a1, CL1
  if sgn > 0 then CLm, aS, a1, CL1 = D.CLm, D.aSr, D.a1, D.CL1 else CLm, aS, a1, CL1 = D.CLmN, D.aSN, D.a1N, D.CL1N end
  local cl
  if aa <= a1 then
    cl = D.CLa * aa
  elseif aa <= aS then
    local t = (aS - aa) / (aS - a1)
    cl = CLm - (CLm - CL1) * t * t
  else
    local s = smooth(aS, aS + 0.35, aa)
    -- 失速以后按平板（1.05·sin 2α）；过了 90°（倒着来流：尾冲、库尔比特翻过去那一下）升力反过来，翼型倒着吹效率低（× 0.8）
    local plate = 1.05 * sin(2 * aa)
    if aa > math.pi / 2 then plate = plate * 0.8 end
    cl = lerp(CLm, plate, s)
  end
  local fl = (flap or 0) * D.flapCL * (1 - smooth(aS, aS + 0.3, aa))
  return cl * sgn + fl
end
FM.CL = CLof
-- 反过来：要这么大的升力系数要多大迎角（正的那一边；超过最大升力就是失速迎角）
local function CLinv(D, cl)
  if cl <= 0 then return math.max(cl / D.CLa, -D.aSN) end
  if cl <= D.CL1 then return cl / D.CLa end
  if cl >= D.CLm then return D.aSr end
  return D.aSr - (D.aSr - D.a1) * sqrt((D.CLm - cl) / (D.CLm - D.CL1))
end
FM.CLinv = CLinv

-- 跨声速 / 超音速波阻的形状：过了阻力发散马赫数往上冲，过了 1.2 马赫慢慢回落三成
local function waveK(D, M)
  return smooth(D.Mcr, D.Mcr + 0.2, M) * (1 - 0.3 * smooth(1.2, 1.8, M))
end
FM.waveK = waveK

-- 推力（N）：转速 N（军推的几成）、加力 ab（0 ~ 1）、马赫数、密度、真速
local function thrustOf(D, N, ab, M, rho, V)
  local dens = (rho / 1.225) ^ 0.75
  if D.prop then
    local P = D.prop
    local T = math.min(P.Tst, P.eta * P.P / math.max(V, 1)) * (0.05 + 0.95 * N)
    return T * dens
  end
  local lap = D.lap
  local fm = 1 - lap[1] * M + lap[2] * M * M
  local fa = 1 - 0.05 * M + 0.15 * M * M
  local T = D.Tm * (0.05 + 0.95 * N) * fm
  if ab > 0 and D.Ta > D.Tm then T = T + (D.Ta * fa - D.Tm * fm) * ab end
  return T * dens
end
FM.thrust = thrustOf

-- 外挂的质量（kg）、阻力面积（m²：迎风面积 × 0.35 + 挂架 0.01）——按弹的外形（AirDefs.W 的 shape：L 长、d 直径，格）估：
--   弹体按密度 1600 kg/m³ 的圆柱算（AIM-9X 约 90 kg、霹雳-15 约 210 kg、500 公斤级炸弹约 500 kg，跟真的差不多）；副油箱另算（油在 fuelX 里）
function FM.storeMass(w, M)
  M = M or 2.8
  local sh = w and w.shape
  if not sh then return (w and w.kind == "tank") and 140 or 120 end
  local L, d = (sh.L or 8) / M, (sh.d or 0.5) / M
  if w.kind == "tank" then return 60 + 120 * d * L / 5 end   -- 空油箱的壳
  return clamp(1600 * math.pi * (d / 2) ^ 2 * L, 30, 2500)
end
function FM.storeDrag(w, M)
  M = M or 2.8
  local sh = w and w.shape
  local d = sh and (sh.d or 0.5) / M or 0.3
  return 0.35 * math.pi * (d / 2) ^ 2 + 0.01
end

-- 一套挂载的重量和阻力（开飞机 Fly.lua、机库整备的性能对比、资料卡都用这一个，不另编数）：
--   d 是 AirDefs 的型号（d.st 挂点），load 每个挂点挂什么（同 AirDefs.presetLoad，false 是空），fuel 内油几成（0～1，默认满）
--   o（可选）：D 飞行物理量（默认 FM.get(d.id, o.key)，没登记的借 d.like）、stores 每个挂点还剩几枚（默认挂满：AD.count）、
--     fuelX 副油箱里的油（按内油的几成，默认副油箱加满：AD.tankFuel）、AD（AirDefs 模块：FM 本身不 require 它——它反过来要 FM；Lune 里跑要传）
--   每个挂点：弹 / 副油箱的壳按外形估的重量（FM.storeMass）× 枚数；火箭巢一个挂点一个巢（空巢壳四成 + 剩下的火箭按发数折）；
--     阻力面积（FM.storeDrag）只算外挂，弹舱里的不算；火箭巢打空了巢还挂着、照算阻力
--   返回 { m 总重 kg（空重 + 内油 + 副油箱里的油 + 外挂）, ext 外挂重 kg（弹、巢、副油箱的壳，不含油）, xf 副油箱里的油 kg,
--     dS 外挂阻力面积 m², dCD0 零升阻力系数增量（dS / 翼面积）, fuelX, D }；没有飞行物理量（直升机、没登记的）D、m、dCD0 是 nil
local ADlazy = nil
local function airDefs(o)
  if o and o.AD then return o.AD end
  if ADlazy == nil then
    local ok, m = pcall(function() return require(game:GetService("ReplicatedStorage"):WaitForChild("AirDefs", 5)) end)
    ADlazy = (ok and type(m) == "table") and m or false
  end
  return ADlazy or nil
end
function FM.loadout(d, load, fuel, o)
  o = o or {}
  local AD = airDefs(o)
  local D = o.D or (d and (FM.get(d.id, o.key) or (d.like and FM.get(d.like)))) or nil
  local W = AD and AD.W or {}
  local Mst = (AD and AD.M) or 2.8
  local fuelX = o.fuelX
  if fuelX == nil then fuelX = (AD and AD.tankFuel and d) and (AD.tankFuel(d, load)) or 0 end
  local fi = D and D.fi or 0
  -- 同 Fly.lua 原来的 fmMass：先空重 + 内油 + 副油箱的油，再一个挂点一个挂点加（加的顺序一样，结果一位不差）
  local m = D and (D.m0 + fi * clamp(fuel or 1, 0, 1) + fi * math.max(fuelX or 0, 0)) or 0
  local ext, dS = 0, 0
  for i, s in ipairs((d and d.st) or {}) do
    local wid = load and load[i]
    local w = wid and W[wid]
    local n
    if o.stores then n = o.stores[i] or 0 else n = (w and AD and AD.count(s, wid)) or 0 end
    if w and w.kind == "rkt" then
      local full = math.max(w.tubes or 1, 1)
      local mm = FM.storeMass(w, Mst) * (0.4 + 0.6 * clamp(n / full, 0, 1))
      m += mm
      ext += mm
      if not s.bay then dS += FM.storeDrag(w, Mst) end
    elseif w and n > 0 then
      local mm = FM.storeMass(w, Mst) * n
      m += mm
      ext += mm
      if not s.bay then dS += FM.storeDrag(w, Mst) * n end
    end
  end
  return { m = D and m or nil, ext = ext, xf = fi * math.max(fuelX or 0, 0), dS = dS, dCD0 = D and dS / D.S or nil, fuelX = fuelX, D = D }
end

---------------------------------------------------------------- 状态

-- 四元数（w, x, y, z）：机体（Roblox 局部：X 右、Y 上、Z 后）→ 世界；从旋转矩阵（CFrame:GetComponents 的 R00 … R22）求
function FM.quat(r00, r01, r02, r10, r11, r12, r20, r21, r22)
  local tr = r00 + r11 + r22
  local w, x, y, z
  if tr > 0 then
    local s = sqrt(tr + 1) * 2
    w, x, y, z = 0.25 * s, (r21 - r12) / s, (r02 - r20) / s, (r10 - r01) / s
  elseif r00 > r11 and r00 > r22 then
    local s = sqrt(1 + r00 - r11 - r22) * 2
    w, x, y, z = (r21 - r12) / s, 0.25 * s, (r01 + r10) / s, (r02 + r20) / s
  elseif r11 > r22 then
    local s = sqrt(1 + r11 - r00 - r22) * 2
    w, x, y, z = (r02 - r20) / s, (r01 + r10) / s, 0.25 * s, (r12 + r21) / s
  else
    local s = sqrt(1 + r22 - r00 - r11) * 2
    w, x, y, z = (r10 - r01) / s, (r02 + r20) / s, (r12 + r21) / s, 0.25 * s
  end
  local n = sqrt(w * w + x * x + y * y + z * z)
  return w / n, x / n, y / n, z / n
end

-- 新的飞行状态：姿态（旋转矩阵 9 个数，同 CFrame:GetComponents 的顺序）、世界速度 m/s、油门（0 ~ 130，推力按它起步）
function FM.new(D, rot, vx, vy, vz, thr)
  local F = { abT = 0, abf = 0, flap = 0 }
  FM.reset(F, rot, vx, vy, vz)
  local t = clamp(thr or 80, 0, 130)
  F.N = math.min(t, 100) / 100
  F.abf = (t > 100 and D.Ta > D.Tm) and (t - 100) / 30 or 0
  F.abLit = F.abf > 0
  return F
end
-- 重设姿态、速度（离地、弹射离舰、服务器拉回）：角速度、舵面、滤波器从零起，发动机转速、加力、襟翼留着
function FM.reset(F, rot, vx, vy, vz, q)
  F.p, F.q, F.r = 0, q or 0, 0
  F.vx, F.vy, F.vz = vx or 0, vy or 0, vz or 0
  F.de, F.da, F.dr, F.tvp, F.tvy, F.tvr = 0, 0, 0, 0, 0, 0
  F.trim, F.qf, F.nf, F.pf, F.drop, F.stallK = nil, nil, 1, 0, 0, 0
  F.al, F.be, F.nz, F.M, F.Va, F.T = 0, 0, 1, 0, 0, F.T or 0
  F.qw, F.qx, F.qy, F.qz = FM.quat(rot[1], rot[2], rot[3], rot[4], rot[5], rot[6], rot[7], rot[8], rot[9])
end

-- 机体三轴（世界坐标）：右、上、前
function FM.axes(F)
  local w, x, y, z = F.qw, F.qx, F.qy, F.qz
  local rX, rY, rZ = 1 - 2 * (y * y + z * z), 2 * (x * y + z * w), 2 * (x * z - y * w)
  local uX, uY, uZ = 2 * (x * y - z * w), 1 - 2 * (x * x + z * z), 2 * (y * z + x * w)
  local bX, bY, bZ = 2 * (x * z + y * w), 2 * (y * z - x * w), 1 - 2 * (x * x + y * y)
  return rX, rY, rZ, uX, uY, uZ, -bX, -bY, -bZ
end

-- 杆的非线性：小杆量细、推满才是全量（键盘、手机摇杆都过一遍）
local function shape(s) return 0.45 * s + 0.55 * s * s * s end
FM.shape = shape

---------------------------------------------------------------- 一步

-- inp：mode "stick"（sx 压杆右正、sy 拉杆正、sz 右舵正，−1 ~ 1）/ "cmd"（n 过载、p 滚转角速度 rad/s、r 偏航角速度附加 rad/s）、
--   level 没压杆时小坡度自己改平、thr 油门 0 ~ 130、brake 减速板、gear 0 ~ 1、flap 0 ~ 1
-- env：m 质量 kg、h 高度 m、agl 离地 m（地效）、dCD0 外挂阻力系数增量、thrK 推力倍数（受伤、改装）、ctlK 舵效（受伤）、pitchK 俯仰舵效（平尾没了）、
--   liftK 升力倍数（断翼）、Lext 额外滚转力矩系数（断翼）、nzK 过载上限倍数（重了）、out 熄火、ko 飞行员昏迷
-- 返回这一帧的位移（世界坐标，米）
-- 发动机：转速往油门追（慢车 → 军推 D.up 秒），加力要转速够了、点火一下才起来（地上滑跑也调这个）
function FM.engine(F, D, dt, thr, out)
  thr = out and 0 or clamp(thr or 0, 0, 130)
  local tgt = math.min(thr, 100) / 100
  F.N = moveTo(F.N or 0, tgt, ((tgt > (F.N or 0)) and (1 / D.up) or (1 / D.dn)) * dt)
  local abW = (thr > 100 and D.Ta > D.Tm) and (thr - 100) / 30 or 0
  if abW > 0 and F.N > 0.95 then
    F.abT = (F.abT or 0) + dt
    if F.abT >= D.ab then F.abLit = true end
  else
    F.abT, F.abLit = 0, false
  end
  F.abf = moveTo(F.abf or 0, F.abLit and abW or 0, 1.6 * dt)
end

function FM.step(F, D0, dt, inp, env)
  local m = env.m
  local rho, sos = FM.atmo(env.h or 0)
  local D, sw = FM.sweep(D0, F.M or 0)
  F.sweep = sw
  FM.engine(F, D, dt, inp.thr, env.out)
  F.flap = moveTo(F.flap or 0, inp.flap or 0, dt / 2)
  local px, py, pz = 0, 0, 0
  local n = math.max(1, math.ceil(dt / FM.DT - 1e-6))
  local h = dt / n
  for _ = 1, n do
    local dx, dy, dz = FM.sub(F, D, h, inp, env, m, rho, sos)
    px, py, pz = px + dx, py + dy, pz + dz
  end
  return px, py, pz
end

-- 一小步（h ≤ 1/120 秒）
function FM.sub(F, D, h, inp, env, m, rho, sos)
  local Ixx, Iyy, Izz = m * D.rx2, m * D.ry2, m * D.rz2
  local w, x, y, z = F.qw, F.qx, F.qy, F.qz
  local rX, rY, rZ = 1 - 2 * (y * y + z * z), 2 * (x * y + z * w), 2 * (x * z - y * w)
  local uX, uY, uZ = 2 * (x * y - z * w), 1 - 2 * (x * x + z * z), 2 * (y * z + x * w)
  local bX, bY, bZ = 2 * (x * z + y * w), 2 * (y * z - x * w), 1 - 2 * (x * x + y * y)
  local Vx, Vy, Vz = F.vx, F.vy, F.vz
  local u = -(bX * Vx + bY * Vy + bZ * Vz)   -- 机体前向
  local v = rX * Vx + rY * Vy + rZ * Vz      -- 右
  local wd = -(uX * Vx + uY * Vy + uZ * Vz)  -- 下
  local Va = math.max(sqrt(u * u + v * v + wd * wd), 1)
  local al = atan2(wd, u)
  local be = asin(clamp(v / Va, -1, 1))
  local sbe = v / Va   -- sin β：侧滑力矩、侧力按它（小侧滑同 β；大侧滑——失速偏离、尾冲侧着飞——不再线性往上长）
  local qb = 0.5 * rho * Va * Va
  local M = Va / sos
  local p, q, r = F.p, F.q, F.r
  local Vn = math.max(Va, 40)
  local ph, qh, rh = p * D.b / (2 * Vn), q * D.c / (2 * Vn), r * D.b / (2 * Vn)
  local phi = atan2(-rY, uY)
  local th = asin(clamp(-bY, -1, 1))
  local qS = math.max(qb * D.S, 50)
  local qSc, qSb = qS * D.c, qS * D.b
  local fl = F.flap
  local ctl = env.ctlK or 1
  local aa = abs(al)
  -- 失速：迎角过了失速迎角（一边机翼先掉，方向按侧滑、没侧滑就随便一边）
  local stallK = smooth(D.aSr, D.aSr + 0.18, aa)
  if stallK > 0.05 and F.drop == 0 then
    F.drop = (be > 0.01 and -1) or (be < -0.01 and 1) or ((math.random() < 0.5) and -1 or 1)
  elseif stallK < 0.01 then
    F.drop = 0
  end
  F.stallK = stallK
  -- 失速后滚转阻尼变正：自转（尾旋的起因）——只在滚得慢时；滚快了阻尼回来（自转的转速有个头，约每秒五六十度，原来无上限，过失速时越滚越快发散）
  local fwdK = 1 - smooth(1.6, 2.2, aa)   -- 掉翼、自转只在正着来流的失速里（倒着来流——尾冲——没有）
  local Clp = D.Clp * (1 - 1.7 * stallK * fwdK * exp(-(ph / 0.15) ^ 2))
  -- 掉翼的滚转力矩随侧滑变大：对称进入（眼镜蛇、库尔比特）时小，带着侧滑失速一边机翼猛地掉下去
  local dropK = stallK * fwdK * (0.025 + 0.075 * math.min(1, abs(be) / 0.09))
  local Cnb = D.Cnb * (1 - 1.5 * smooth(D.aSr * 0.8, D.aSr * 1.3, aa))   -- 大迎角航向静稳定往下掉、变负（偏离）
  local CmSt = -D.cmS * stallK * ((al >= 0) and 1 or -1)   -- 失速后机头往下沉（倒着来流时是把机头从 180° 推开：尾冲后甩过去）
  if D.pu > 0 then CmSt = CmSt + D.pu * smooth(D.aSr * 0.75, D.aSr, aa) * (1 - stallK) * ((al >= 0) and 1 or -1) end   -- 后掠翼失速前上仰
  -- 推力（推力矢量的偏转在下面舵机那里一起动）
  local T = thrustOf(D, F.N, F.abf, M, rho, Va) * (env.thrK or 1)
  if env.out then T = 0 end
  local Tl = T * D.tl
  -- 地效：离地不到一个翼展，升力大一点、诱导阻力小一点
  local ge = env.agl and clamp(1 - env.agl / D.b, 0, 1) or 0
  local liftK = (env.liftK or 1) * (1 + 0.12 * ge * ge)
  local kInd = 1 - 0.45 * ge * ge

  ---------------------------------------------------------------- 飞控：三个舵面（和推力矢量喷口）要的偏度
  local mode = inp.mode or "stick"
  local fcs = D.fcs
  local cmdLaw = mode == "cmd" or fcs ~= "mech"
  local de_c, da_c, dr_c, tvp_c, tvy_c, tvr_c = 0, 0, 0, 0, 0, 0
  local cph, sph, cth = cos(phi), sin(phi), cos(th)
  local nzP = D.nzP * (env.nzK or 1)
  local nzN = D.nzN
  -- 舵面效率按来流：90° 以内照常（大迎角平尾在分离气流里掉一半、副翼掉六成），过了 90°（倒着来流：尾冲、翻过去）效果反过来
  local rev = clamp(cos(aa) * 1.6, -1, 1)
  local Me = qSc * D.Cmde * ctl * (env.pitchK or 1) * (1 - 0.5 * smooth(D.aSr * 0.9, D.aSr * 1.5, aa)) * rev
  local daK = (1 - 0.6 * stallK) * rev
  local La = qSb * D.Clda * ctl * daK
  local Nr = qSb * D.Cndr * ctl * rev
  -- 飞控按舵效求舵偏：舵效太小（快没速度了）或者反过来时别除出无穷大、别打反
  local function safeDiv(need, k, sgn) if k * sgn < 1 then k = sgn end return need / k end
  local tvc = D.tvc
  local tvP = tvc and tvc.p * RAD or 0
  local tvY = tvc and tvc.y * RAD or 0
  if env.ko then inp = { mode = "cmd", n = 0.55, p = 0, r = 0, thr = inp.thr } mode = "cmd" cmdLaw = true end
  if cmdLaw then
    local bw = D.bw * ((mode == "cmd" and fcs == "mech") and 0.75 or 1)
    -- 俯仰：过载指令（松杆时按坡度补偿到保持航迹的过载）→ 迎角指令（不超迎角限制）→ 俯仰角速度指令 → 动态逆求升降舵（和推力矢量）
    local n0 = cth * (cph + smooth(1.05, 0.85, abs(phi)) * (1 / math.max(cph, 0.4) - cph))
    local nc
    if mode == "cmd" then
      nc = inp.n or n0
    else
      local s = shape(clamp(inp.sy or 0, -1, 1))
      nc = (s >= 0) and lerp(n0, nzP, s) or lerp(n0, nzN, -s)
    end
    nc = clamp(nc, nzN, nzP)
    F.nf = F.nf + (nc - F.nf) * (1 - exp(-h / D.tn))
    -- 迎角上限：电传按限制器；增稳的杆拉到最大升力系数为止（米格-29 的限制器能硬拉过去）；教官飞的不进失速
    local aMaxC
    if fcs == "fbw" or mode == "cmd" then aMaxC = D.aLr or D.aSr * 0.92
    else aMaxC = lerp(D.aSr * 0.97, D.aSr + 0.14, smooth(0.9, 1, abs(inp.sy or 0))) end   -- 增稳：杆拉到底能硬拉过最大升力、进失速
    local flCL = fl * D.flapCL
    local clReq = F.nf * m * G0 / (qS * liftK) - flCL
    local ac = clamp(CLinv(D, clReq), -D.aSN * 0.95, aMaxC)
    -- 增稳（F-15、F-14、米格-29）：杆拉到底、要的升力又超过最大升力时，硬拉过失速迎角（进失速，掉翼）
    if fcs == "cas" and mode == "stick" and clReq >= D.CLm * 0.98 then
      ac = lerp(ac, D.aSr + 0.14, smooth(0.9, 1, abs(inp.sy or 0)))
    end
    local nAch = (CLof(D, ac, fl) * liftK) * qS / (m * G0)
    local qk = smooth(4000, 16000, qb)
    local ka = lerp(1.4, 3.6, qk) * bw
    local qc = clamp(ka * (ac - al) + G0 / Vn * (nAch - uY), -1.5, 1.5)
    -- 过失速机动（T 解除迎角限制；用户待办「飞控放开机动：大迎角、失速后、推力矢量、尾冲」）：杆直接要俯仰角速度，
    --   飞控不再管迎角、过载——拉满杆机头仰过 90° 再推回来是眼镜蛇，有推力矢量的低速一直拉着能翻一整圈（库尔比特）；
    --   松杆：飞控把迎角拉回到配平（在限制以内），不会一直挂在大迎角上；能拉多快看真的力矩（平尾在分离气流里没劲，推力矢量顶上）
    local ovr = inp.ovr and mode == "stick"
    if ovr then
      local s = shape(clamp(inp.sy or 0, -1, 1))
      local qmx = tvc and 1.6 or 1.0
      if abs(s) > 0.05 then
        qc = s * qmx
      else
        qc = clamp(-2 * (al - ac), -qmx, qmx)
      end
    end
    -- 迎角限制的预见（电传、教官）：迎角变化率 = 俯仰角速度 − 航迹转动角速度。离限制还剩 dA，按平尾推满（加推力矢量）能打出的低头角加速度，
    --   只许以「刹得住」的速度往限制靠；太慢了托不住（航迹往下掉）时机头跟着航迹往下压——原来低速满杆照样一头冲过限制（歼-11 拉到 38°）
    if (fcs == "fbw" or mode == "cmd") and not ovr then
      local Mdn = abs(Me) * D.der * 0.8 + Tl * sin(tvP) - qSc * (D.Cm0 + D.Cma * sin(al))
      local qdd = math.max(Mdn / Iyy, 0.05)
      local gd = G0 / Vn * ((CLof(D, al, fl) * liftK) * qS / (m * G0) - uY)   -- 航迹现在往上转多快（负的：托不住，往下掉）
      local qcap = gd + sqrt(2 * qdd * math.max(aMaxC - al, 0) * 0.6)
      if qc > qcap then qc = math.max(qcap, -1.5) end
    end
    local kq = lerp(3.5, 7, qk) * bw
    local Mreq = Iyy * kq * (qc - q) - (Izz - Ixx) * p * r
    local M0 = qSc * (D.Cm0 + D.Cma * sin(al) + D.Cmq * qh + CmSt + (env.Mext or 0))
    local need = Mreq - M0
    if tvP > 0 and T > 1000 then
      -- 推力矢量：分一部分力矩给喷口（舵面快饱和了全给它）——低速、大迎角平尾没劲时还拉得动
      local deFull = safeDiv(need, Me, (rev >= 0) and -1 or 1)
      local share = 0.35 + 0.65 * smooth(0.5, 1, abs(deFull) / D.der)
      tvp_c = clamp(asin(clamp(need * share / Tl, -1, 1)), -tvP, tvP)
      need = need - Tl * sin(F.tvp)
    end
    de_c = safeDiv(need, Me, (rev >= 0) and -1 or 1)
    -- 滚转：角速度指令（松杆保持坡度，坡度 12° 以内慢慢改平）
    local pc
    if mode == "cmd" then
      pc = inp.p or 0
    else
      local s = shape(clamp(inp.sx or 0, -1, 1))
      -- 飞控按动压、迎角排滚转角速度上限：快到最大允许速度时收三成多（结构载荷），大迎角时收（防惯性耦合）
      local qv = 0.5 * 1.225 * D.vne * D.vne
      local sched = (1 - 0.45 * smooth(0.55 * qv, 1.1 * qv, qb)) * (1 - 0.6 * smooth(0.5 * D.aSr, D.aSr, aa))
      if abs(s) > 0.01 then pc = s * D.pmaxr * sched
      elseif inp.levelHard then pc = clamp(-3 * phi, -0.5 * D.pmaxr, 0.5 * D.pmaxr)   -- 贴着跑道：机翼摆平
      else pc = 0 end   -- 松杆保持坡度（电传的姿态保持；原来小坡度会自己摆平，点一下 D 压的几度又被摆回去）
    end
    -- 前置滤波：压杆按型号的时间常数起来；松杆（往零收、反打）快三倍——滚得起来要时间，停住要干脆（用户 11-25「松手一两帧就收住」）
    local tpe = (abs(pc) < abs(F.pf) or pc * F.pf < 0) and D.tp * 0.35 or D.tp
    F.pf = F.pf + (pc - F.pf) * (1 - exp(-h / tpe))
    local kp = lerp(7, 13, qk) * bw
    local Lreq = Ixx * kp * (F.pf - p) - (Iyy - Izz) * q * r
    -- 飞控不知道哪边翼尖先失速（掉翼是扰动，只靠角速度反馈去顶；失速时副翼也不灵了，顶不住）
    local L0 = qSb * (D.Clb * sbe + Clp * ph + D.Clr * rh + (env.Lext or 0))
    da_c = safeDiv(Lreq - L0, La, (rev >= 0) and 1 or -1)
    -- 双发推力矢量：两个喷口差动偏转也出滚转力矩（苏-35、苏-57 真机这么管滚转）——副翼在失速气流里没劲时顶上
    if tvP > 0 and (D.ne or 2) >= 2 and T > 1000 then
      local ys = 0.06 * D.b   -- 喷口离中线约 0.85 米（翼展 14 米）
      local short = (Lreq - L0) - La * clamp(da_c, -D.dar, D.dar)
      tvr_c = clamp(asin(clamp(short / (T * ys), -1, 1)), -tvP, tvP)
    end
    -- 偏航：协调转弯（偏航角速度跟着坡度）+ 脚蹬要侧滑（用户待办「方向舵侧滑」：踩右舵机头偏右、飞机侧着往前滑；
    --   满舵的侧滑角按动压收：低速约 12°、快了约 4°——垂尾、机身受不了大侧滑），没踩舵就是侧滑归零
    --   过失速 + 推力矢量：脚蹬直接要偏航角速度（低速原地甩头）
    local rc
    if mode == "cmd" then
      rc = G0 / Vn * sph * cth + 3 * be + (inp.r or 0)
    else
      local ped = shape(clamp(inp.sz or 0, -1, 1))
      if ovr and tvY > 0 then
        rc = G0 / Vn * sph * cth + ped * 0.9 + 3 * be * (1 - abs(ped))
      else
        local qvd = 0.5 * 1.225 * D.vne * D.vne
        local bc = -ped * RAD * lerp(12, 4, smooth(0.25 * qvd, 0.8 * qvd, qb))
        rc = G0 / Vn * sph * cth + 3 * (be - bc) + ped * 0.12
      end
    end
    local Nreq = Izz * 4.5 * bw * (rc - r) - (Ixx - Iyy) * p * q
    local N0 = qSb * (Cnb * sbe + D.Cnr * rh + D.Cnp * ph + D.Cnda * F.da)
    local needN = Nreq - N0
    if tvY > 0 and T > 1000 then
      tvy_c = clamp(asin(clamp(needN * 0.4 / Tl, -1, 1)), -tvY, tvY)
      needN = needN - Tl * sin(F.tvy)
    end
    dr_c = safeDiv(needN, Nr, (rev >= 0) and -1 or 1)
  else
    -- 机械操纵：杆直接对舵面。传动比按动压排（满杆的稳态过载约是过载上限的 1.05 倍：高速时不会一把拉爆，慢了满杆照样拉进失速）；
    --   自动配平到 1 g（慢慢跟着速度改）；有阻尼器的加上
    -- 稳态拉 n 个 g 要多大舵偏：迎角照真的升力曲线（拉不出来就是失速迎角再多 7°），加上拉起时的俯仰阻尼
    local pk = ctl * (env.pitchK or 1)
    local function deFor(nn)
      local cl = nn * m * G0 / (qS * liftK) - fl * D.flapCL
      local a = (cl >= D.CLm) and (D.aSr + 0.12) or CLinv(D, cl)
      local qs = G0 * (nn - uY) / Vn
      return clamp(-(D.Cm0 + D.Cma * sin(a) + D.Cmq * qs * D.c / (2 * Vn)) / (D.Cmde * math.max(pk, 0.05)), -D.der, D.der * 0.8)
    end
    local trimT = deFor(uY)
    F.trim = F.trim and (F.trim + (trimT - F.trim) * (1 - exp(-h / 1.2))) or trimT
    local s = shape(clamp(inp.sy or 0, -1, 1))
    local tgt = (s >= 0) and lerp(F.trim, deFor(nzP * 1.05), s) or lerp(F.trim, deFor(nzN), -s)
    -- 俯仰阻尼器（洗出滤波：只挡变化，不改稳态）
    F.qf = (F.qf or q) + (q - (F.qf or q)) * (1 - exp(-h / 1.0))
    de_c = tgt + D.Kq * (q - F.qf)
    -- 副翼：满杆的稳态滚转角速度不超过 pmax；高速时铰链力矩大、舵偏不满（老飞机高速副翼发硬）
    local pPerDa = (D.Clda / math.max(abs(Clp), 0.05)) * (2 * Vn / D.b)
    local daFull = math.min(D.dar * clamp(sqrt(30000 / math.max(qb, 1)), 0.35, 1), D.pmaxr / math.max(pPerDa, 1e-3))
    local sx = shape(clamp(inp.sx or 0, -1, 1))
    if abs(sx) < 0.01 and inp.levelHard then sx = clamp(-phi * 2.5, -0.7, 0.7) end
    da_c = sx * daFull
    dr_c = -shape(clamp(inp.sz or 0, -1, 1)) * D.drr * clamp(sqrt(20000 / math.max(qb, 1)), 0.3, 1) + D.Kr * r
  end
  -- 舵机：限偏度、限速率（平尾往下打的范围小一点）
  F.de = moveTo(F.de, clamp(de_c, -D.der, D.der * 0.8), D.rder * h)
  F.da = moveTo(F.da, clamp(da_c, -D.dar, D.dar), D.rdar * h)
  F.dr = moveTo(F.dr, clamp(dr_c, -D.drr, D.drr), D.rdrr * h)
  if tvc then
    local tr = tvc.r * RAD * h
    F.tvp = moveTo(F.tvp, tvp_c, tr)
    F.tvy = moveTo(F.tvy, tvy_c, tr)
    F.tvr = moveTo(F.tvr or 0, tvr_c, tr)
  end

  ---------------------------------------------------------------- 力
  local CL = CLof(D, al, fl) * liftK
  -- 大迎角（机腹迎风）按平板的阻力；倒着来流（机尾朝前）整架飞机的形阻另加
  local CD = D.CD0 + (env.dCD0 or 0) + D.CDw * waveK(D, M) + D.Kc * kInd * CL * CL + 1.2 * sin(al) ^ 2 * stallK + 0.25 * smooth(1.7, 2.6, aa)
    + 0.03 * (abs(F.de) + abs(F.dr)) + D.gearCD * (inp.gear or 0) + 0.03 * fl + (inp.brake and D.sb or 0)
  local CY = D.CYb * sbe + D.CYdr * F.dr
  local ca, sa = cos(al), sin(al)
  local cT = cos(F.tvp) * cos(F.tvy)
  local Fx = qS * (CL * sa - CD * ca) + T * cT
  local Fy = qS * CY - T * sin(F.tvy)
  local Fz = qS * (-CL * ca - CD * sa) + T * sin(F.tvp)
  ---------------------------------------------------------------- 力矩
  local Lm = qSb * (D.Clb * sbe + Clp * ph + D.Clr * rh + D.Clda * ctl * daK * F.da + D.Cldr * F.dr + (env.Lext or 0) + F.drop * dropK)
    + T * 0.06 * D.b * sin(F.tvr or 0)
  local Mm = qSc * (D.Cm0 + D.Cma * sin(al) + D.Cmq * qh + CmSt + (env.Mext or 0)) + Me * F.de + Tl * sin(F.tvp)
  local Nm = qSb * (Cnb * sbe + D.Cnr * rh + D.Cnp * ph + D.Cnda * F.da) + Nr * F.dr + Tl * sin(F.tvy)
  ---------------------------------------------------------------- 积分（半隐式欧拉）
  -- 机体力（前右下）→ 世界：右 × Fy + 上 × (−Fz) + 前 × Fx（前 = −后）
  local ax = (rX * Fy - uX * Fz - bX * Fx) / m
  local ay = (rY * Fy - uY * Fz - bY * Fx) / m - G0
  local az = (rZ * Fy - uZ * Fz - bZ * Fx) / m
  Vx, Vy, Vz = Vx + ax * h, Vy + ay * h, Vz + az * h
  F.vx, F.vy, F.vz = Vx, Vy, Vz
  -- 收住滚转（用户 11-28「惯性的意思是 飞机滚筒做着 然后突然不做滚筒 惯性要能收住」，照战雷）：
  --   要的滚转角速度（电传 / 教官：前置滤波后的指令；机械操纵：松杆就是 0）比现在的小、或者反过来——另加一个刹车力矩把多出来的那截收掉，
  --   不受副翼偏度、偏转速率限制（只靠副翼：打满反向要零点几秒，满速滚转松手还要多滚 40～76°；战雷里一松手十几二十度就停）。
  --   只在「要停 / 要慢下来」时起作用（加速滚转不管，满杆滚转角速度照旧）；接近失速（掉翼、自转）时不刹，掉翼照样掉
  do
    local pWant
    if cmdLaw then
      pWant = F.pf
    elseif abs(inp.sx or 0) < 0.02 and not inp.levelHard then
      pWant = 0
    end
    if pWant and (abs(pWant) < abs(p) or pWant * p < 0) then
      -- 接近失速迎角（八成起）就逐渐不刹：掉翼、自转照真的来（机械操纵低速拉满杆一边机翼先掉，滚过去机头才掉得下来、改得出）
      Lm = Lm - Ixx * (D.rollBrake or (cmdLaw and ROLL_BRAKE or ROLL_BRAKE_MECH)) * (1 - smooth(0.8 * D.aSr, D.aSr, aa)) * (p - pWant)
    end
  end
  p = p + (Lm + (Iyy - Izz) * q * r) / Ixx * h
  q = q + (Mm + (Izz - Ixx) * p * r) / Iyy * h
  r = r + (Nm + (Ixx - Iyy) * p * q) / Izz * h
  F.p, F.q, F.r = p, q, r
  -- 姿态：机体角速度换到 Roblox 局部轴（X 右 = 俯仰 q、Y 上 = −r、Z 后 = −p），q̇ = ½ q ⊗ (0, Ω)
  local ox, oy, oz = q, -r, -p
  local dw = 0.5 * (-x * ox - y * oy - z * oz)
  local dx = 0.5 * (w * ox + y * oz - z * oy)
  local dy = 0.5 * (w * oy + z * ox - x * oz)
  local dz = 0.5 * (w * oz + x * oy - y * ox)
  w, x, y, z = w + dw * h, x + dx * h, y + dy * h, z + dz * h
  local nq = sqrt(w * w + x * x + y * y + z * z)
  F.qw, F.qx, F.qy, F.qz = w / nq, x / nq, y / nq, z / nq
  F.al, F.be, F.M, F.Va, F.T, F.qb = al, be, M, Va, T, qb
  F.nz = -Fz / (m * G0)
  F.phi, F.th = phi, th
  F.ax, F.ay, F.az = ax, ay + G0, az   -- 不含重力的加速度（镜头用）
  return Vx * h, Vy * h, Vz * h
end

---------------------------------------------------------------- 性能（测试、机库信息卡）

-- 海平面平飞的配平：速度 V（m/s）、质量 m → 迎角、需用推力
function FM.trimLevel(D, m, V, rho)
  rho = rho or 1.225
  local qS = 0.5 * rho * V * V * D.S
  local cl = m * G0 / qS
  local a = CLinv(D, cl)
  local M = V / 340.3
  local CD = D.CD0 + D.CDw * waveK(D, M) + D.Kc * cl * cl
  return a, qS * CD, cl
end

-- 能量机动（某一速度、高度、质量）：瞬时过载（升力 / 迎角限制 / 过载限制拉得出的）、持续过载（推力 = 阻力）、
--   对应的转弯角速度 rad/s、平飞剩余推力的加速度 m/s²；thr 默认全推力
function FM.em(D, m, V, h, thr, dCD0)
  local rho, sos = FM.atmo(h or 0)
  local W = m * G0
  local E = FM.sweep(D, V / sos)
  local qS = 0.5 * rho * V * V * E.S
  local M = V / sos
  local ab = ((thr or 130) > 100 and E.Ta > E.Tm) and ((thr or 130) - 100) / 30 or 0
  local T = thrustOf(E, math.min(thr or 130, 100) / 100, ab, M, rho, V)
  local CD0 = E.CD0 + (dCD0 or 0) + E.CDw * waveK(E, M)
  local aMax = E.aLr or E.aSr
  local clMax = CLof(E, aMax, 0)
  local ni = math.min(E.nzP, qS * clMax / W)
  local D0 = qS * CD0
  local ns = math.min(ni, sqrt(math.max(0, (T - D0) * qS / (E.Kc * W * W))))
  local function w(n) return (n > 1) and G0 * sqrt(n * n - 1) / V or 0 end
  return { ni = ni, ns = ns, wi = w(ni), ws = w(ns), acc = (T - D0 - E.Kc * W * W / qS) / m, T = T, D0 = D0 }
end

-- 平飞最大速度（m/s，海平面附近 1000 米、这个质量、thr 油门）：剩余推力加速度过零的速度（二分）
--   dCD0：外挂的零升阻力增量（FM.loadout 的 dCD0；不给就是干净构型，同原来）
function FM.vTop(D, m, thr, h, dCD0)
  -- 从失速速度往上找最后一个还有剩余推力的速度（再二分细找）：太慢时诱导阻力大、加速度也是负的，不能从低速一头二分
  local rho = FM.atmo(h or 1000)
  local vs = sqrt(2 * m * G0 / (rho * D.S * D.CLm))
  local lo, hi = nil, nil
  for V = vs * 1.15, 720, 5 do
    if FM.em(D, m, V, h or 1000, thr, dCD0).acc > 0 then lo = V elseif lo then hi = V break end
  end
  if not lo then return vs * 1.15 end
  hi = hi or 720
  for _ = 1, 30 do
    local mid = (lo + hi) / 2
    if FM.em(D, m, mid, h or 1000, thr, dCD0).acc > 0 then lo = mid else hi = mid end
  end
  return lo
end

-- 一型的性能摘要（机库信息卡、测试）：海平面附近（1000 米）、一半内油 + 两枚中距弹；
--   给了 m、dCD0（FM.loadout 算的这一套挂载）就按那套算。roc 最大爬升率 m/s（全加力、剩余功率 = 剩余推力 × 速度 / 重量）、rocV 在哪个速度
function FM.card(D, m, dCD0)
  m = m or (D.m0 + 0.5 * D.fi + 320)
  local W = m * G0
  local rho = FM.atmo(1000)
  local best = { ws = 0, wi = 0, roc = 0 }
  for V = 60, 420, 5 do
    if V < D.vne * 1.02 then
      local e = FM.em(D, m, V, 1000, nil, dCD0)
      if e.ws > best.ws then best.ws, best.vs = e.ws, V end
      if e.wi > best.wi then best.wi, best.vi = e.wi, V end
      local roc = e.acc * V / G0
      if roc > best.roc then best.roc, best.vr = roc, V end
    end
  end
  return { m = m, tw = D.Ta / W, wl = m / D.S, vs = sqrt(2 * W / (rho * D.S * D.CLm)), str = best.ws, strV = best.vs, itr = best.wi, itrV = best.vi,
    roll = D.pmax, nz = D.nzP, roc = best.roc, rocV = best.vr }
end

-- 性能卡（整备「挂载」页右栏：空挂 vs 当前）：这一质量、这一阻力增量下的极速（军推 / 加力，1000 米）、推重比、持续 / 瞬时转弯、最大爬升率——
--   全是上面现成的 vTop / card（em）算的；m、dCD0 一般来自 FM.loadout
function FM.perf(D, m, dCD0)
  local c = FM.card(D, m, dCD0)
  c.vMil = FM.vTop(D, m, 100, 1000, dCD0)
  c.vAB = (D.Ta > D.Tm) and FM.vTop(D, m, 130, 1000, dCD0) or c.vMil
  c.dCD0 = dCD0 or 0
  return c
end

return FM
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="15">
      <Properties>
        <string name="Name">Flora</string>
        <ProtectedString name="Source"><![CDATA[-- 地图上长什么（ReplicatedStorage.Flora）：树林、灌木、石头、草丛、花丛的摆放，纯按 Map 算——同一个格子谁算都一样（每个客户端看到的树在同一个地方）
--   用户：地图要像 Arma 那样——土路、草地花丛、成片的针叶林、起伏的山丘
--   按 64 格一格，每格按格子坐标定随机种子：
--     树：18 格一个候选点（抖开）；树林是两层噪声叠出来的大片（林子里密、林缘稀、草地上偶尔一棵）；山上多针叶（冷杉、松树），低处多阔叶（白桦、橡树、枫树）；
--       林缘长小冷杉、灌木，林子里偶尔一棵枯树、一根倒木
--     灌木：林缘多、草地上零星；石头：坡陡、山高的地方多，岩坡上是成堆的岩石
--     草丛：9 格一个，草地上大半都有（高草、矮草、杂草）；花：另一层噪声圈出的一片片花地，里面开满黄花（蒲公英）
--   不长的地方：海滩沙地和水边、路面和路肩、压平的场地（据点、机场、营地、港口、机场岛）、工事旁边、太陡的崖壁（只有石头）
--   Flora.cell(cx, cz, layer) 返回这一格这一层的 { { k 模型键, x, y, z, yaw, s 缩放 }, … }；客户端（Scenery.lua）按距离摆出来
local RS = game:GetService("ReplicatedStorage")
local Map = require(RS:WaitForChild("Map"))

local Flora = {}
Flora.CELL = 64
local CELL = Flora.CELL
local noise, floor, sqrt, max, min = math.noise, math.floor, math.sqrt, math.max, math.min
local smooth = Map.smooth

-- 各层：候选点间距
Flora.LAYERS = { tree = 18, bush = 22, rock = 40, grass = 10, flower = 8 }

-- 工事（碉堡、岸防炮……）周围不长树、灌木：按 FortDefs 的摆法（开服时一样）
local fortPts = nil
local function forts()
  if fortPts then return fortPts end
  fortPts = {}
  local ok, FD = pcall(function() return require(RS:WaitForChild("FortDefs", 5)) end)
  if ok and FD and FD.layout then
    local ok2, list = pcall(FD.layout, Map)
    if ok2 and list then
      for _, f in ipairs(list) do
        local p = f.cf and f.cf.Position
        if p then table.insert(fortPts, { p.X, p.Z }) end
      end
    end
  end
  return fortPts
end
-- 换地图（Map.use）：工事的位置重新按新地图的 FortDefs 算
function Flora.reset() fortPts = nil end
local function nearFort(x, z, r)
  for _, f in ipairs(forts()) do
    local dx, dz = x - f[1], z - f[2]
    if dx * dx + dz * dz < r * r then return true end
  end
  return false
end
local function nearPoint(x, z, r)
  for _, p in ipairs(Map.POINTS) do
    local dx, dz = x - p.x, z - p.z
    if dx * dx + dz * dz < r * r then return true end
  end
  return false
end

-- 树林密度（−1～1 左右；> 0.05 算林子）、花地（> 0.2 是一片花）
function Flora.forest(x, z)
  return noise(x / 430, z / 430, 21.7) * 0.7 + noise(x / 140, z / 140, 5.3) * 0.35 + noise(x / 47, z / 47, 9.9) * 0.1
end
function Flora.flowerField(x, z)
  return noise(x / 190, z / 190, 33.1) + noise(x / 55, z / 55, 2.2) * 0.25
end

-- 可重复的随机数：按格子坐标、层定种子
local function rng(cx, cz, salt)
  local s = (cx * 73856093 + cz * 19349663 + salt * 83492791) % 2147483647
  if s <= 0 then s = s + 2147483646 end
  return function()
    s = (s * 48271) % 2147483647
    return s / 2147483647
  end
end
local SALT = { tree = 1, bush = 2, rock = 3, grass = 4, flower = 5 }

-- 这一点能不能长东西：返回高度、坡度；不能长返回 nil
local function site(x, z, roadPad, flatMax)
  local h = Map.height(x, z)
  if h < 4 then return nil end   -- 海里、海滩、水边
  local rd, _, rw = Map.roadNear(x, z)
  if rd and rd < rw * 0.5 + roadPad then return nil end
  if Map.flatW(x, z) > (flatMax or 0.02) then return nil end
  local zs, zn = Map.coastS(x), Map.coastN(x)
  if zs and zn and (zs - z < 70 or z - zn < 50) and h < 14 then return nil end   -- 海滩后面的沙丘
  return h, Map.slope(x, z)
end

local CONIFER = { "fir1", "fir2", "fir3", "fir4", "fir1", "fir2", "pine" }
local BROAD = { "birch1", "birch2", "oak", "maple", "birch1" }
local BUSH = { "cshrub", "dshrub", "holly", "sapling" }

local function pick(list, r) return list[floor(r * #list) + 1] end

-- 沙漠图（沙海）：不长树、草、花；平原上零星几丛枯灌木，岩坡、方山脚下多石头
local function desertCell(cx, cz, layer)
  local out = {}
  if layer ~= "bush" and layer ~= "rock" then return out end
  local step = Flora.LAYERS[layer]
  local R = rng(cx, cz, SALT[layer] + 40)
  local n = floor(CELL / step + 0.5)
  local x0, z0 = cx * CELL, cz * CELL
  for i = 0, n - 1 do
    for k = 0, n - 1 do
      local x = x0 + (i + 0.15 + R() * 0.7) * step
      local z = z0 + (k + 0.15 + R() * 0.7) * step
      local roll, roll2, yaw, sc = R(), R(), R() * math.pi * 2, 0.7 + R() * 0.4
      if layer == "bush" then
        if roll < 0.035 then
          local h, sl = site(x, z, 4)
          if h and sl < 0.4 and not nearFort(x, z, 24) and not nearPoint(x, z, Map.POINT_R) then
            table.insert(out, { k = "dshrub", x = x, y = h - 0.3, z = z, yaw = yaw, s = sc * 0.8 })
          end
        end
      else
        local sl = Map.slope(x, z)
        local p = 0.012 + 0.6 * smooth(0.35, 1.0, sl)
        if roll < p then
          local h = site(x, z, 3)
          if h and not nearFort(x, z, 20) then
            local k2 = (sl > 0.6 and roll2 < 0.6) and "rock3" or ((roll2 < 0.5) and "rock1" or "rock2")
            table.insert(out, { k = k2, x = x, y = h - 1.2, z = z, yaw = yaw, s = sc * ((k2 == "rock3") and 1.1 or 0.8) })
          end
        end
      end
    end
  end
  return out
end

function Flora.cell(cx, cz, layer)
  if Map.DESERT then return desertCell(cx, cz, layer) end
  -- 钢城（用户 11-26「要有可以撞倒的树」）：树按 Map.TREES 摆（服务器、客户端同一张表，谁撞倒了哪一棵按编号同步，Trees.lua）；
  --   平地（城、郊区、农田、基地）上不撒石头、灌木、草丛，城外丘陵照旧撒石头
  --   雪山（Map.SNOW）同样按 Map.TREES（雪松、冬季灌木）；谷里撒石头（坡陡的冲沟、岩石包上）
  if Map.CITY or Map.SNOW then
    if layer == "tree" then return Map.treesInCell(cx, cz) end
    if layer ~= "rock" then return {} end
    local x, z = cx * CELL, cz * CELL
    if math.abs(x) < (Map.FLATX or 0) + CELL and math.abs(z) < (Map.FLATZ or 0) + CELL then return {} end
  end
  local out = {}
  local step = Flora.LAYERS[layer]
  local R = rng(cx, cz, SALT[layer])
  local n = floor(CELL / step + 0.5)
  local x0, z0 = cx * CELL, cz * CELL
  for i = 0, n - 1 do
    for k = 0, n - 1 do
      local x = x0 + (i + 0.15 + R() * 0.7) * step
      local z = z0 + (k + 0.15 + R() * 0.7) * step
      local roll, roll2, yaw, sc = R(), R(), R() * math.pi * 2, 0.85 + R() * 0.3
      if layer == "tree" then
        local f = Flora.forest(x, z)
        local p = (f > 0.05) and (0.15 + 0.75 * smooth(0.05, 0.3, f)) or 0.025   -- 林子里密、林缘稀、草地上偶尔一棵
        if roll < p then
          local h, sl = site(x, z, 7)
          if h and sl < 0.85 and not nearFort(x, z, 34) and not nearPoint(x, z, Map.POINT_R + 15) then
            local conifer = roll2 < 0.55 + 0.4 * smooth(25, 140, h)   -- 山上全是针叶，低处一半阔叶
            local k2
            if f < 0.12 and roll2 > 0.7 then k2 = (roll2 > 0.85) and "nfir" or "fir5"   -- 林缘的小树
            elseif R() < 0.025 and f > 0.15 then k2 = "deadfir"
            elseif conifer then k2 = pick(CONIFER, R())
            else k2 = pick(BROAD, R()) end
            table.insert(out, { k = k2, x = x, y = h - 0.4, z = z, yaw = yaw, s = sc })
          end
        end
      elseif layer == "bush" then
        local f = Flora.forest(x, z)
        local p = (f > -0.06 and f < 0.14) and 0.35 or ((f >= 0.14) and 0.12 or 0.05)
        if roll < p then
          local h, sl = site(x, z, 4)
          if h and sl < 0.9 and not nearFort(x, z, 24) and not nearPoint(x, z, Map.POINT_R) then
            local k2 = (f > 0.14 and R() < 0.25) and "log" or pick(BUSH, R())
            table.insert(out, { k = k2, x = x, y = h - 0.3, z = z, yaw = yaw, s = sc })
          end
        end
      elseif layer == "rock" then
        local h0 = Map.height(x, z)
        if h0 > 4 then
          local sl = Map.slope(x, z)
          local p = 0.03 + 0.55 * smooth(0.45, 1.0, sl) + ((h0 > 160) and 0.15 or 0)
          if roll < p then
            local h = site(x, z, 3)
            if h and not nearFort(x, z, 20) then
              local k2 = (sl > 0.6 and roll2 < 0.6) and "rock3" or ((roll2 < 0.5) and "rock1" or "rock2")
              table.insert(out, { k = k2, x = x, y = h - 1.2, z = z, yaw = yaw, s = sc * ((k2 == "rock3") and 1.1 or 0.8) })
            end
          end
        end
      elseif layer == "grass" then
        local f = Flora.forest(x, z)
        local p = (f > 0.2) and 0.25 or 0.6
        if roll < p then
          local h, sl = site(x, z, 1.5, 0.3)
          if h and sl < 0.9 then
            local k2 = (roll2 < 0.55) and "grass_s" or ((roll2 < 0.85) and "grass_t" or "weeds")
            table.insert(out, { k = k2, x = x, y = h - 0.1, z = z, yaw = yaw, s = sc })
          end
        end
      elseif layer == "flower" then
        local ff = Flora.flowerField(x, z)
        if ff > 0.2 and roll < 0.35 + 0.5 * smooth(0.2, 0.5, ff) and Flora.forest(x, z) < 0.15 then
          local h, sl = site(x, z, 1.5, 0.3)
          if h and sl < 0.6 then table.insert(out, { k = "flowers", x = x, y = h - 0.05, z = z, yaw = yaw, s = sc }) end
        end
      end
    end
  end
  return out
end

return Flora
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="16">
      <Properties>
        <string name="Name">FortDefs</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——守方工事的型号与摆放（服务器、客户端共用）：地图自带，每局开局时系统摆好，玩家不用（也不能）自己部署
--   工事：机枪碉堡（12.7 毫米机枪，从射孔里打，左右各 60°）、岸防炮（127 毫米舰炮改的岸炮，打登陆艇、舰艇，也打滩上的车）、
--     高炮（双联 35 毫米，近炸引信，只打飞机）、M777 榴弹炮阵地（155 毫米，山脊后面，曲射）；
--     没人操作时 AI 打，自己队的玩家走过去按 E 就能接手操作（F 离开）；能被打掉（伤害类别 fort：步枪几乎打不动，要火箭筒、炸药包、坦克炮、炮击、炸弹）；
--     据点被攻方拿下后，挨着这个据点的工事归攻方
--   障碍：钢刺猬（滩头水线一带，挡车）、铁丝网（滩后，人走进去慢、车压过去就压坏、炸一下就炸断、工兵能剪开）、
--     雷区（滩后两侧，有警示牌；只炸攻方，炮弹落在附近会被引爆，工兵能探出来、排掉）
--   单位：格（1 米约 2.8 格）。工事的坐标系同车辆：原点在底面中心（着地），X 右、Y 上、−Z 朝前（射孔、炮口的默认朝向）
--   摆放按 Map 算，每局一样：服务器开局时照 FortDefs.layout(Map) 建；客户端只按实体属性画样子
local FortDefs = {}
local V = Vector3.new

-- 武器：kind gun 直射（射线判定）、shell 有弹道的炮弹、flak 高炮弹（近炸引信）
--   rate 两发间隔、burst 一个点射几发、pause 点射之间歇多久；range 射程；spread 散布（度）、spreadPer 每格距离多几度
FortDefs.W = {
  hmg = { kind = "gun", dmg = 34, rate = 0.12, burst = { 5, 9 }, pause = { 1.0, 1.8 }, range = 820, spread = 1.2, spreadPer = 0.0035,
    vs = { inf = 1, light = 0.5, armor = 0.04, air = 0.4, ship = 0.05, fort = 0.12 }, fx = "lmg", head = 1, snd = "mg127" },   -- snd：客户端声音（Fx.lua G.gunSnd）
  naval127 = { kind = "shell", dmg = 520, speed = 950, gscale = 0.5, splash = 15, rate = 10, range = 3300, minR = 160,   -- rate 原来 8：攻方还没有舰艇压制岸防炮
    vs = { inf = 1, light = 1.4, armor = 0.9, air = 0, ship = 1.4, fort = 1 }, fx = "tank" },
  flak35 = { kind = "flak", dmg = 70, speed = 1150, gscale = 0.15, splash = 11, rate = 0.25, range = 2300, fuse = 9, spread = 1.1,
    vs = { inf = 0.6, light = 0.4, armor = 0.05, air = 2.2, ship = 0.1, fort = 0.2 }, fx = "ac" },
  how155 = { kind = "arty", dmg = 340, splash = 26, rate = 8, minR = 300, maxR = 3800, flight = 6, scatter = 14,
    vs = { inf = 1, light = 1, armor = 0.6, air = 0, ship = 0.5, fort = 1.2 } },
}
for id, w in pairs(FortDefs.W) do w.id = id end
-- 玩家操作时：弹匣（打空了换弹）；AI 打不用换弹
FortDefs.MAG = { hmg = { mag = 100, reload = 5 }, flak35 = { mag = 40, reload = 6 } }

-- 型号：size 命中盒（也挡人）；turret.pivot 转轴（相对底面中心）、trav 每秒转几度、arc 能转到正前方左右各几度（180 = 一圈）、elev 俯仰范围；
--   gun.pivot 耳轴（相对转轴）、len 炮管长；sight 看多远；targets 打哪些目标（inf 步兵、veh 地面车辆、boat 艇和舰、air 飞机）
FortDefs.D = {
  bunker = { hp = 1400, size = V(16, 7.2, 14), weapon = "hmg", sight = 820,
    turret = { pivot = V(0, 4.6, -5.2), trav = 70, arc = 60, elev = { -14, 18 } }, gun = { pivot = V(0, 0, 0), len = 4.4 },
    targets = { inf = true, veh = true } },
  coastal = { hp = 2600, size = V(20, 9, 20), weapon = "naval127", sight = 3300,
    turret = { pivot = V(0, 4.6, 0.6), trav = 18, arc = 150, elev = { -6, 40 } }, gun = { pivot = V(0, 1.6, -4.4), len = 20 },
    targets = { boat = true, veh = true } },
  aaa = { hp = 900, size = V(14, 6, 14), weapon = "flak35", sight = 2300,
    turret = { pivot = V(0, 2.4, 0), trav = 85, arc = 180, elev = { -4, 85 } }, gun = { pivot = V(0, 1.4, -0.6), len = 7.6 },
    targets = { air = true } },
  howitzer = { hp = 1000, size = V(12, 5, 22), weapon = "how155", sight = 3800,
    turret = { pivot = V(0, 3.0, 1.0), trav = 20, arc = 25, elev = { 0, 70 } }, gun = { pivot = V(0, 0.3, 0), len = 14.5 },
    targets = { arty = true } },
}
-- 玩家走到哪儿能接手（相对底面中心）：碉堡后门、炮塔后面、炮架旁边、大架尾巴
FortDefs.MAN = { bunker = V(0, 3, 8.2), coastal = V(0, 2, 11), aaa = V(5.5, 1.5, 3), howitzer = V(3.5, 1.5, 9) }
for id, d in pairs(FortDefs.D) do d.id = id end

function FortDefs.get(id) return FortDefs.D[id] end

-- 炮塔、炮口的世界坐标：base 是底面中心的 CFrame（−Z 朝前）；ty 方位（度，正数往右）、gp 俯仰（度，正数往上）
function FortDefs.turretCF(d, base, ty)
  return base * CFrame.new(d.turret.pivot) * CFrame.Angles(0, -math.rad(ty or 0), 0)
end
function FortDefs.gunCF(d, base, ty, gp)
  return FortDefs.turretCF(d, base, ty) * CFrame.new(d.gun.pivot) * CFrame.Angles(math.rad(gp or 0), 0, 0)
end
function FortDefs.muzzle(d, base, ty, gp)
  return FortDefs.gunCF(d, base, ty, gp) * CFrame.new(0, 0, -d.gun.len)
end

-- 障碍
FortDefs.WIRE = { len = 16, slow = 0.35, r = 4.5 }          -- 一段铁丝网多长、人在里面走路速度乘多少、离铁丝网多近算在里面
FortDefs.MINE = {
  ap = { dmg = 150, splash = 9, vs = { inf = 1, light = 0.5, armor = 0.1, air = 0, ship = 0, fort = 0 }, trig = 3.2 },     -- 防步兵雷
  at = { dmg = 300, splash = 10, vs = { inf = 0.8, light = 3.5, armor = 3.2, air = 0, ship = 0, fort = 0 }, trig = 6.5 },   -- 防坦克雷（只有车压上去才炸）
  chain = 11,   -- 爆炸离雷多近会把它引爆（炮火准备能开出通路）
}

---------------------------------------------------------------- 摆放

-- (x, z) 附近找一块放工事的平地：陆地、四角高差小；返回 x, z（找不到就原地）
local function siteNear(Map, x, z, r, size)
  local best, bx, bz = 1e9, x, z
  local hx, hz = size.X * 0.5, size.Z * 0.5
  for i = 0, 30 do
    local a, rr = i * 2.39996, r * math.sqrt(i / 30)
    local px, pz = x + math.cos(a) * rr, z + math.sin(a) * rr
    local h0 = Map.height(px, pz)
    if h0 > 1.5 then
      local lo, hi = h0, h0
      for _, o in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
        local h = Map.height(px + o[1] * hx, pz + o[2] * hz)
        if h < lo then lo = h end
        if h > hi then hi = h end
      end
      local s = (hi - lo) + rr * 0.015 + ((lo < 1) and 50 or 0)
      if s < best then best, bx, bz = s, px, pz end
    end
  end
  return bx, bz
end
FortDefs.siteNear = siteNear

-- 朝向：从 (x, z) 看向 (tx, tz) 的 CFrame（原点在地面上）
local function faceCF(Map, x, z, tx, tz)
  local y = Map.ground(x, z)
  local p = V(x, y, z)
  local look = V(tx - x, 0, tz - z)
  if look.Magnitude < 0.1 then look = V(0, 0, 1) end
  return CFrame.lookAt(p, p + look.Unit)
end

-- 沙漠图（沙海，没有海）：攻方从南边来（+Z），工事都朝南。边境沙墙开口（据点 A 南边）两侧碉堡交叉火力，
--   各据点南面碉堡、高炮；没有岸防炮；三处 M777 阵地各在一个据点北边约 600 格（够得着自己据点南面的攻击出发阵地，又在最小射程外）
local function layoutDesert(Map)
  local out = {}
  local n = 0
  local function add(kind, x, z, tx, tz, pt, tag, r)
    local d = FortDefs.D[kind]
    local sx, sz = siteNear(Map, x, z, r or 26, d.size)
    n += 1
    table.insert(out, { id = "f" .. n, kind = kind, cf = faceCF(Map, sx, sz, tx, tz), pt = pt, tag = tag })
  end
  local P = {}
  for _, p in ipairs(Map.POINTS) do P[p.id] = p end
  -- 边境：沙墙开口（x = A.x）北侧左右各一座，躲在 11 格高的沙墙后面、斜着封住开口的出口（交叉火力；隔着沙墙往南打不着）；据点 A 南面再两座
  local bz = Map.bermZ(P.A.x)
  add("bunker", P.A.x - 130, bz - 90, P.A.x + 40, bz - 10, "A", "border")
  add("bunker", P.A.x + 130, bz - 90, P.A.x - 40, bz - 10, "A", "border")
  add("bunker", P.A.x - 70, P.A.z + 90, P.A.x - 40, P.A.z + 500, "A", "outpost")
  add("bunker", P.A.x + 70, P.A.z + 90, P.A.x + 40, P.A.z + 500, "A", "outpost")
  add("bunker", P.B.x - 90, P.B.z + 110, P.B.x - 120, P.B.z + 520, "B", "oil")
  add("bunker", P.B.x + 80, P.B.z + 115, P.B.x + 100, P.B.z + 520, "B", "oil")
  add("bunker", P.C.x - 110, P.C.z + 230, P.C.x - 140, P.C.z + 700, "C", "town")
  add("bunker", P.C.x + 120, P.C.z + 225, P.C.x + 150, P.C.z + 700, "C", "town")
  add("bunker", P.D.x, P.D.z + 150, P.D.x, P.D.z + 600, "D", "airfield")
  add("bunker", P.E.x - 70, P.E.z + 70, P.E.x - 120, P.E.z + 500, "E", "command")
  add("bunker", P.E.x + 70, P.E.z + 70, P.E.x + 120, P.E.z + 500, "E", "command")
  -- 高炮：机场两座，各据点一座，后方营地一座
  local A = Map.AIRFIELD
  local ax = math.min(1100, A.len * 0.3) + 60
  add("aaa", A.x - ax, A.z - A.wid / 2 - 70, A.x - ax, A.z + 400, "D", "airfield")
  add("aaa", A.x + ax, A.z - A.wid / 2 - 70, A.x + ax, A.z + 400, "D", "airfield")
  add("aaa", P.E.x + 55, P.E.z - 45, P.E.x, P.E.z + 400, "E", "command")
  add("aaa", P.C.x + 95, P.C.z - 55, P.C.x, P.C.z + 400, "C", "town")
  add("aaa", P.A.x + 55, P.A.z - 40, P.A.x, P.A.z + 400, "A", "outpost")
  add("aaa", P.B.x - 60, P.B.z - 55, P.B.x, P.B.z + 400, "B", "oil")
  if Map.BASES then
    -- 两边主基地（FOB.lua）：营区两侧、机场两头各一门高炮，炮口朝战场；home 写明是哪边的（Forts.lua 按它定归属，据点丢了也不换）
    for side, HB in pairs(Map.BASES) do
      for _, o in ipairs({ { -500, -100 }, { 500, 0 }, { -1500, 900 }, { 1500, 900 } }) do
        local x, z = Map.baseW(HB, o[1], o[2])
        local tx, tz = Map.baseW(HB, o[1], o[2] - 2000)
        add("aaa", x, z, tx, tz, nil, "base_" .. side)
        out[#out].home = side
      end
    end
  else
    add("aaa", Map.CAMP.x - 95, Map.CAMP.z + 15, Map.CAMP.x, Map.CAMP.z + 400, nil, "camp")
  end
  -- M777：A、C、E 北边各两门，炮口朝南
  for _, id in ipairs({ "A", "C", "E" }) do
    local p = P[id]
    local x, z = p.x + 160, p.z - 600
    add("howitzer", x, z, x, z + 1000, id, "battery", 40)
    add("howitzer", x + 36, z + 8, x + 36, z + 1008, id, "battery", 40)
  end
  return out
end

-- 沙漠图的障碍：边境沙墙开口里一排钢刺猬（留两条车道）、开口北边两道铁丝网、开口两侧沙墙后面各一片雷区；据点 B、C 南面也各一道铁丝网
local function obstaclesDesert(Map)
  local rng = Random.new(20261122)
  local hog, wire, mines, signs = {}, {}, {}, {}
  local A
  for _, p in ipairs(Map.POINTS) do if p.id == "A" then A = p end end
  local bx = A.x
  local bz = Map.bermZ(bx)
  -- 钢刺猬：开口（沙墙缺口约 ±60 格）里两排，中间和 ±33 留车道
  for x = bx - 54, bx + 54, 12 do
    for row = 0, 1 do
      local xx = x + row * 6
      local rel = math.abs(xx - bx)
      if rel >= 15 and not (rel > 22 and rel < 42) then table.insert(hog, { x = xx, z = bz + 6 - row * 13, rot = rng:NextNumber(0, math.pi) }) end
    end
  end
  -- 铁丝网：开口北边 45、72 格两道（隔段留缺口）；B、C 南面 160 格一道
  local function wireLine(x0, x1, z, skip, tag)
    local i, x = 0, x0
    while x + FortDefs.WIRE.len <= x1 do
      i += 1
      if i % 3 ~= skip then table.insert(wire, { a = V(x, 0, z), b = V(x + FortDefs.WIRE.len, 0, z), beach = tag }) end
      x += FortDefs.WIRE.len
    end
  end
  wireLine(bx - 120, bx + 120, bz - 45, 2, "border")
  wireLine(bx - 112, bx + 128, bz - 72, 0, "border")
  for _, p in ipairs(Map.POINTS) do
    if p.id == "B" or p.id == "C" then wireLine(p.x - 160, p.x + 160, p.z + 160, 1, p.id) end
  end
  -- 雷区：开口两侧、沙墙北边（离开口 90～150 格），四角警示牌朝南
  for fi, side in ipairs({ -1, 1 }) do
    local cx, cz = bx + side * 120, bz - 40
    local field = { w = 50, d = 36 }
    for _ = 1, 10 do
      local x = cx + rng:NextNumber(-field.w / 2, field.w / 2)
      local z = cz + rng:NextNumber(-field.d / 2, field.d / 2)
      table.insert(mines, { x = x, z = z, at = rng:NextNumber() < 0.4, field = fi })
    end
    for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
      table.insert(signs, { x = cx + c[1] * (field.w / 2 + 3), z = cz + c[2] * (field.d / 2 + 3), face = 1 })
    end
  end
  return { hog = hog, wire = wire, mines = mines, signs = signs }
end

-- 城市图（钢城，MapCity.lua）：两边对称，城里不摆碉堡、榴弹炮（城里的掩护是楼）；只有两边主基地各四门高炮（营区两侧、跑道两头）
local function layoutCity(Map)
  local out = {}
  local n = 0
  for side, HB in pairs(Map.BASES) do
    for _, o in ipairs({ { -500, -100 }, { 500, 0 }, { -1500, 900 }, { 1500, 900 } }) do
      local x, z = Map.baseW(HB, o[1], o[2])
      local tx, tz = Map.baseW(HB, o[1], o[2] - 2000)
      local d = FortDefs.D.aaa
      local sx, sz = siteNear(Map, x, z, 26, d.size)
      n += 1
      table.insert(out, { id = "f" .. n, kind = "aaa", cf = faceCF(Map, sx, sz, tx, tz), tag = "base_" .. side, home = side })
    end
  end
  return out
end

-- 全部工事：{ id, kind（bunker / coastal / aaa）, cf（底面中心，−Z 朝前）, pt（附近的据点：据点被攻方拿下后这处工事就废了）, tag（位置名） }
function FortDefs.layout(Map)
  if Map.CITY or Map.SNOW then return layoutCity(Map) end   -- 钢城、雪山：两边主基地的防空阵地
  if Map.LANDONLY then return layoutDesert(Map) end
  local out = {}
  local n = 0
  local function add(kind, x, z, tx, tz, pt, tag, r)
    local d = FortDefs.D[kind]
    local sx, sz = siteNear(Map, x, z, r or 26, d.size)
    n += 1
    table.insert(out, { id = "f" .. n, kind = kind, cf = faceCF(Map, sx, sz, tx, tz), pt = pt, tag = tag })
  end
  -- 南岸四处海滩：每处两座机枪碉堡，在滩后高处、离岸约 100 格，射孔斜对着滩中间（交叉火力）
  for _, b in ipairs(Map.BEACHES) do
    if not b.north then
      local w = b.x1 - b.x0
      for _, f in ipairs({ 0.12, 0.88 }) do
        local x = b.x0 + w * f
        local zc = Map.coastS(x) or b.z
        add("bunker", x, zc - 105, b.cx, b.z + 40, nil, b.id)
      end
    else   -- 东北侧翼滩：一座，朝北
      local x = b.cx + 30
      local zc = Map.coastN(x) or b.z
      add("bunker", x, zc + 95, b.cx, b.z - 40, nil, b.id)
    end
  end
  -- 港湾：湾口两侧各一座，对着湾里
  local BAY = Map.BAY
  for s = -1, 1, 2 do
    local x = BAY.x + s * (BAY.w + 55)
    local zc = Map.coastS(x) or Map.PORT.z
    add("bunker", x, zc - 45, BAY.x, (Map.coastS(BAY.x) or Map.PORT.z) + 160, "C", "port")
  end
  -- 据点
  local P = {}
  for _, p in ipairs(Map.POINTS) do P[p.id] = p end
  add("bunker", P.A.x - 75, P.A.z + 95, P.A.x - 40, P.A.z + 400, "A", "outpost")
  add("bunker", P.A.x + 75, P.A.z + 95, P.A.x + 40, P.A.z + 400, "A", "outpost")
  add("bunker", P.B.x - 90, P.B.z + 120, P.B.x - 120, P.B.z + 500, "B", "lighthouse")
  add("bunker", P.B.x + 60, P.B.z + 125, P.B.x + 80, P.B.z + 500, "B", "lighthouse")
  add("bunker", P.D.x, P.D.z + 150, P.D.x, P.D.z + 600, "D", "airfield")
  add("bunker", P.E.x - 70, P.E.z + 70, P.E.x - 120, P.E.z + 500, "E", "command")
  add("bunker", P.E.x + 70, P.E.z + 70, P.E.x + 120, P.E.z + 500, "E", "command")
  -- 岸防炮：东西两个岬角的崖顶、西礁岛炮台、灯塔岛西南角；炮口朝南（舰队、登陆艇来的方向）
  for _, cape in ipairs(Map.CAPES) do
    local cx = cape.x
    local zc = Map.coastS(cx) or -700
    add("coastal", cx, zc - 48, cx * 0.6, zc + 1200, nil, "cape", 20)
  end
  local WR = Map.WESTREEF
  add("coastal", WR.x + 40, WR.z + 60, WR.x + 900, WR.z + 1000, nil, "westreef", 18)
  local LH = Map.LIGHTHOUSE
  add("coastal", LH.x - 130, LH.z + 110, LH.x - 900, LH.z + 1100, "B", "lighthouse", 20)
  -- 高炮：机场两座、指挥所、港口、两座小岛据点、后方营地
  local A = Map.AIRFIELD
  local ax = math.min(1100, A.len * 0.3) + 60   -- 跑道两头停机坪外（飞机生成点在跑道中间偏西，别挡着）
  add("aaa", A.x - ax, A.z - A.wid / 2 - 70, A.x - ax, A.z + 400, "D", "airfield")
  add("aaa", A.x + ax, A.z - A.wid / 2 - 70, A.x + ax, A.z + 400, "D", "airfield")
  add("aaa", P.E.x + 55, P.E.z - 45, P.E.x, P.E.z + 400, "E", "command")
  add("aaa", P.C.x + 95, P.C.z - 55, P.C.x, P.C.z + 400, "C", "port")
  add("aaa", P.A.x + 55, P.A.z - 40, P.A.x, P.A.z + 400, "A", "outpost")
  add("aaa", P.B.x - 60, P.B.z - 55, P.B.x, P.B.z + 400, "B", "lighthouse")
  add("aaa", Map.CAMP.x - 95, Map.CAMP.z + 15, Map.CAMP.x, Map.CAMP.z + 400, nil, "camp")
  -- M777 榴弹炮阵地：指挥所东北、山脊背面（从海上看不见），两门炮口朝南，够得着南岸各处海滩
  local C = Map.COMMAND
  add("howitzer", C.x + 150, C.z - 70, C.x + 150, C.z + 1000, "E", "battery", 30)
  add("howitzer", C.x + 185, C.z - 62, C.x + 185, C.z + 1000, "E", "battery", 30)
  return out
end

-- 滩头的通道：中间一条清空的（登陆艇、气垫艇冲滩的地方），两侧各一个钢刺猬缺口；缺口后面不埋雷（雷区在滩的两翼）
--   （钢刺猬间隔 12 格、两排错开 6 格：缺口在离滩中间 22～42 格之间，两排都空出来的地方中心约在 ±33）
FortDefs.LANE = { half = 15, gap0 = 22, gap1 = 42, gapC = 33 }
function FortDefs.lanes(b)
  if not b.x0 then return { b.cx } end
  local g = FortDefs.LANE.gapC
  return { b.cx, b.cx - g, b.cx + g }
end

-- 滩头障碍：钢刺猬（水线一带两排，留出通道和缺口）、铁丝网（两道、隔段留缺口）、雷区（滩的两翼各一片）；用固定种子，每局一样
function FortDefs.obstacles(Map)
  if Map.CITY or Map.SNOW then return { hog = {}, wire = {}, mines = {}, signs = {} } end   -- 钢城：没有滩头障碍、雷区（城里的掩护是楼、车厢、水泥墩）
  if Map.LANDONLY then return obstaclesDesert(Map) end   -- 沙海：边境沙墙前的钢刺猬、铁丝网、雷区
  local rng = Random.new(20240611)
  local L = FortDefs.LANE
  local hog, wire, mines, signs = {}, {}, {}, {}
  for bi, b in ipairs(Map.BEACHES) do
    local coast = b.north and Map.coastN or Map.coastS
    local inland = b.north and 1 or -1   -- 往岛里是 +Z（北岸）还是 −Z（南岸）
    -- 钢刺猬：两排，前排在水线外 6 格（浅水里），后排在滩上 7 格、错开半格
    for x = b.x0 + 6, b.x1 - 6, 12 do
      for row = 0, 1 do
        local xx = x + row * 6
        local rel = math.abs(xx - b.cx)
        if rel >= L.half and not (rel > L.gap0 and rel < L.gap1) and xx <= b.x1 - 4 then
          local zc = coast(xx)
          if zc then
            local rot = rng:NextNumber(0, math.pi)
            -- 前排在水线外 6 格；坡缓的滩那里已经两格多深（原来夹在 −1.4 格高，整个浮在水面上——用户 11-18：这些建筑漂在水里），
            --   太深就往岸边挪，挪到水深两格以内：立在海底，尖头露出水面
            local off = (row == 0) and 6 or -7
            while off > 0 and Map.height(xx, zc - inland * off) < -2 do off -= 1 end
            table.insert(hog, { x = xx, z = zc - inland * off, rot = rot })
          end
        end
      end
    end
    -- 铁丝网：离岸 45 格、72 格两道，各隔段留缺口
    for line = 0, 1 do
      local d = (line == 0) and 45 or 72
      local i = 0
      local x = b.x0 + (line == 0 and 0 or 8)
      while x + FortDefs.WIRE.len <= b.x1 + 10 do
        i += 1
        if i % 3 ~= ((line == 0) and 2 or 0) then
          local xa, xb = x, x + FortDefs.WIRE.len
          local za, zb = coast(xa), coast(xb)
          if za and zb then
            table.insert(wire, { a = V(xa, 0, za + inland * d), b = V(xb, 0, zb + inland * d), beach = b.id })
          end
        end
        x += FortDefs.WIRE.len
      end
    end
    -- 雷区：滩的两翼（离岸 48～88 格），四角立警示牌
    for _, side in ipairs({ -1, 1 }) do
      local cx = (side < 0) and (b.x0 + 22) or (b.x1 - 22)
      local zc = coast(cx)
      if zc then
        local cz = zc + inland * 68
        local field = { w = 32, d = 40 }
        for _ = 1, 8 do
          local x = cx + rng:NextNumber(-field.w / 2, field.w / 2)
          local z = cz + rng:NextNumber(-field.d / 2, field.d / 2)
          if Map.isLand(x, z) then table.insert(mines, { x = x, z = z, at = rng:NextNumber() < 0.35, field = bi * 2 + (side > 0 and 1 or 0) }) end
        end
        for _, c in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
          table.insert(signs, { x = cx + c[1] * (field.w / 2 + 3), z = cz + c[2] * (field.d / 2 + 3), face = -inland })
        end
      end
    end
  end
  return { hog = hog, wire = wire, mines = mines, signs = signs }
end

return FortDefs
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="17">
      <Properties>
        <string name="Name">GearDefs</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——手持装备用哪件真模型（Sketchfab 原模型：tools/weapons/optics.json → OpticsMeta / OpticMesh / models/optics/<键>.glb）
--   BY[武器] = 键，或者按阵营 { atk = 解放军, def = 美军 }；MOUNT[键] = 这件枪上装的镜子（键、装在这件的哪个点上）
--   服务器（Weapons.lua）发的工具带属性 Gear = 键、GearMount = 镜子的键：导入了原模型（Imported.Optics.<键>）第三人称就是它，
--   第一人称（FPSView）按这两个属性用同一套模型（导入的，或者没导入时客户端现生成的）
--   「握把坐标」：握把 grip 在原点、+Z 朝前（枪口、筒口）、+Y 朝上，按 hold（度，X → Y → Z）转好；第一人称把它放在 M4 握把的位置（再挪 fpOff）
local GD = {}

GD.BY = {
  sniper = { atk = "qbu88", def = "m40a5" },
  -- 各兵种的枪（用户 11-24：「各种角色配备各种武器」）：同一种枪两边各用自己的制式（解放军 / 美军）
  qbz191 = "qbz191",                              -- 解放军 QBZ-191 步枪（自己选的主武器；两边都能用）
  lmg = { atk = "qjy88", def = "m249" },          -- 机枪手：QJY-88 通用机枪 / M249 轻机枪
  smg = { atk = "qcw05", def = "mp7" },           -- 冲锋枪：QCW-05 / MP7A1
  shotgun = { atk = "qbs09", def = "m1014" },     -- 霰弹枪：QBS-09 / M1014
  pistol = { atk = "qsz92", def = "m17" },        -- 手枪（副武器）：QSZ-92 / M17
  rpg = { atk = "rpg7", def = "at4" },
  manpads = { atk = "qw2", def = "stinger" },
  grenade = "m67", medkit = "ifak", repair = "wrench", c4 = "c4", mortar = "m224", binoc = "binoc",
}
GD.MOUNT = { m40a5 = { key = "atacr", at = "rail" } }
-- 第一人称再挪多少（握把坐标，格）：元数据里没写 fpOff 的用这里的
--   手枪：比步枪的握把位置靠前、靠中间一点（两手往前伸着端），冲锋枪略靠前
GD.FP = { binoc = { 0, 0.18, 0.06 }, qsz92 = { -0.08, 0.1, -0.22 }, m17 = { -0.08, 0.1, -0.22 }, qcw05 = { 0, 0.02, -0.06 }, mp7 = { 0, 0.02, -0.06 } }
-- 单手握把（手枪）：第一人称左手托着右手，不按步枪的姿势伸到护木那儿
GD.PISTOL = { qsz92 = true, m17 = true }

function GD.key(id, team)
  local b = GD.BY[id]
  if type(b) == "table" then return b[team] or b.def end
  return b
end

local function v3(t) return Vector3.new(t[1], t[2], t[3]) end

-- 器材坐标 → 握把坐标
function GD.grip(M)
  local P = (M and M.pts) or {}
  local g = P.grip or { 0, 0, 0 }
  local h = P.hold or { 0, 0, 0 }
  return CFrame.Angles(math.rad(h[1]), 0, 0) * CFrame.Angles(0, math.rad(h[2]), 0) * CFrame.Angles(0, 0, math.rad(h[3])) * CFrame.new(-g[1], -g[2], -g[3])
end

-- 第一人称的挪动
function GD.fpOff(key, M)
  local P = (M and M.pts) or {}
  local o = P.fpOff or GD.FP[key]
  return o and v3(o) or Vector3.zero
end

-- 镜子装在枪的哪儿（器材坐标）
function GD.mountAt(key, M)
  local mt = GD.MOUNT[key]
  local p = mt and M and M.pts and M.pts[mt.at]
  return p and CFrame.new(p[1], p[2], p[3]) or CFrame.new()
end

-- 机械瞄具（器材坐标）：照门 sightR、准星 sightF——第一人称开镜时这条线对到屏幕正中；没写的返回 nil
function GD.sights(M)
  local P = M and M.pts
  if not (P and P.sightR and P.sightF) then return nil end
  return v3(P.sightR), v3(P.sightF)
end

-- 枪口 / 筒口（器材坐标）；没写的返回 nil
function GD.muzzle(M)
  local p = M and M.pts and M.pts.muzzle
  return p and v3(p) or nil
end

return GD
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="18">
      <Properties>
        <string name="Name">GunMods</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——改枪（用户 11-20：「做一整套改枪系统，对标三角洲行动」；服务器、客户端共用）
--   每把枪几个改装位：枪口、瞄具、前握把、弹匣、战术（狙击枪只有枪口）；每个位几样配件，配件是 Sketchfab 上 CC-BY 的原模型
--   （tools/weapons/optics.json → OpticsMeta / OpticMesh / models/optics/<键>.glb），第一人称、第三人称、改枪界面装的都是它
--   性能照三角洲那几项「分」（0～100）：垂直 / 水平后坐力控制、操控速度、据枪稳定性、腰际射击精度、有效射程、机动性——
--     配件按分加减，GM.apply 把分换成真正起作用的数（后坐、开镜快慢、晃动、散布、射程、走路速度），另外弹匣改容量和换弹时间、
--     消音器开枪不上敌人雷达（服务器本来就按 w.quiet）、换声音、没有枪口焰，激光提高腰射精度（别人看得见那道光），手电照亮前面
--   服务器（Weapons.lua）开枪、换弹、射程、散布、伤害衰减按 GM.apply 算出的那份；客户端（Play、FPSView、Fx 的后坐、Scope）用同一份
--   枪械等级：用这把枪打死人加经验（Config.GunMods.killXp），升级解锁配件（每把枪的 slots 里写了几级解锁）；
--     Config.GunMods.unlockAll 全部解锁，studioAll 在 Studio 里测试时全部解锁
--   改枪码：枪名-版本 + 配件编码 + 两位校验（base32），例如 M4A1-100C2K；复制给别人，粘贴进改枪界面就装上
--   工具属性 Build（服务器发枪时写）："muzzle=sup_socom;optic=opt_holo;..."（GM.encode / GM.decode），大家的客户端照它装配件
local GM = {}

GM.SLOTS = { "muzzle", "optic", "grip", "mag", "tac" }
-- 性能分（三角洲那几项）；界面上按这个顺序排
GM.STATS = { "vrec", "hrec", "hand", "stab", "hip", "range", "mob" }

-- 配件：slot 哪个位，model 模型键（OpticsMeta；没有的是枪本身带的 / 不装），st 加减几分，
--   quiet 消音、zoom 开镜倍率、scope 光学镜（开镜后屏幕上是目镜里的像，Scope.lua 的种类）、dot 反射式瞄具的分划（dot 红点 / holo 全息圈）、
--   mag 弹匣容量、reload 换弹时间倍数、laser 激光指示器、light 战术手电
GM.ITEM = {
  -- 枪口
  fh_a2 = { slot = "muzzle" },                                                                         -- M4 原装 A2 消焰器（枪身模型自带）
  muz_none = { slot = "muzzle" },                                                                      -- 狙击枪原装枪口
  muz_comp = { slot = "muzzle", model = "muz_comp", st = { vrec = 10, hrec = 3, hand = -2 } },          -- 战术补偿器：往上喷气压枪口
  muz_brake = { slot = "muzzle", model = "muz_brake", st = { hrec = 12, vrec = 5, hand = -3, stab = -2 } },   -- 多孔制退器：左右飘得少
  sup_socom = { slot = "muzzle", model = "sup_socom", quiet = true, st = { vrec = 5, hrec = 5, hand = -7, stab = -2 } },
  sup_wrap = { slot = "muzzle", model = "sup_wrap", quiet = true, st = { vrec = 3, hrec = 8, hand = -5, range = -6 } },
  sup_sr8 = { slot = "muzzle", model = "sup_sr8", quiet = true, st = { range = 12, vrec = 8, hrec = 4, hand = -12, mob = -2 } },
  -- 瞄具
  iron = { slot = "optic", zoom = 1.3, st = { hand = 5 } },                                              -- 机械瞄具（枪身自带的照门、准星）
  --   glass 镜片 / 窗玻璃的块和它的透明度（开镜时不挡眼睛；全息原模型窗上画着的分划整块藏掉，屏幕上另画）；
  --   eye / obj 光轴（器材坐标、半径，原模型量的）；adsD 开镜时后窗离眼睛多远（格：小的凑近一点、大的离远一点，窗口在屏幕上差不多大）
  opt_romeo = { slot = "optic", model = "opt_romeo", zoom = 1.35, dot = "dot", riser = 0.08, adsD = 0.22, st = { hand = 3 },
    glass = { Body = 0.86, Body2 = 0.86, Body3 = 0.86, C022 = 0.86 } },
  opt_rds = { slot = "optic", model = "opt_rds", zoom = 1.45, dot = "dot", adsD = 0.3, st = { hand = -1, stab = 2 },
    glass = { Body2 = 0.86 }, eye = { 0.037, 0.153, -0.191, 0.069 }, obj = { 0.037, 0.153, 0.192, 0.071 } },
  opt_holo = { slot = "optic", model = "opt_holo", zoom = 1.5, dot = "holo", adsD = 0.45, st = { hand = -2, stab = 2, hip = 3 },
    glass = { Body2 = 0.86, Body4 = 1 } },
  --   lensK：开镜时目镜（正圆的洞）在屏幕上占高度的几成——使命召唤那样外面围着一圈目镜、镜身（两具 ACOG 的原模型目镜是八边形的，
  --     tools/weapons/optics.json 的 ring 补了正圆的目镜圈罩住；目镜 / 物镜的位置、洞的半径在 OpticsMeta 里）
  --   镜片（glass）半透明：腰射、举镜时从后面看得穿（开镜时整块藏掉，从目镜的洞里直接看放大的画面）
  --   pipK：镜内单独放大（画中画，ScopePip.lua）时目镜占屏高——镜外只是普通开镜，目镜离眼睛近一点（再近会被镜头的近裁剪面切掉）
  acog = { slot = "optic", model = "acog", zoom = 3.5, scope = "acog", lensK = 0.5, pipK = 0.3, st = { hand = -7, stab = 4 }, glass = { GlassIn = 0.62 } },
  opt_acog6 = { slot = "optic", model = "opt_acog6", zoom = 6, scope = "acog6", lensK = 0.55, pipK = 0.36, st = { hand = -12, stab = 6, mob = -1 },
    glass = { C9ab = 0.62, C9abIn = 0.62 } },
  -- 前握把
  grip_none = { slot = "grip" },
  grip_rvg = { slot = "grip", model = "grip_rvg", st = { vrec = 8, stab = 5, hand = -3 } },
  grip_afg = { slot = "grip", model = "grip_afg", st = { hand = 7, hrec = 5, vrec = 2 } },
  -- 弹匣
  mag_std = { slot = "mag", mag = 30 },                                                                -- 原装 30 发（枪身模型自带）
  mag_pmag20 = { slot = "mag", model = "mag_pmag20", mag = 20, reload = 0.85, st = { hand = 4, mob = 2 } },
  mag_hex30 = { slot = "mag", model = "mag_hex30", mag = 30, reload = 0.92, st = { hand = 1 } },
  mag_pmag40 = { slot = "mag", model = "mag_pmag40", mag = 40, reload = 1.12, st = { hand = -4, mob = -1 } },
  mag_drum = { slot = "mag", model = "mag_drum", mag = 60, reload = 1.4, st = { hand = -10, mob = -4, stab = 2 } },
  -- 战术
  tac_none = { slot = "tac" },
  tac_light = { slot = "tac", model = "tac_light", light = true, st = { hip = 5 } },
  tac_peq = { slot = "tac", model = "tac_peq", laser = true, st = { hip = 16, hand = -1 } },
}

-- 每把枪：tag 改枪码前缀，base 裸枪（机械瞄具、原装枪口和弹匣、不装握把战术）的分，slots 每个位能装的 { 配件, 几级解锁 }（第一个是裸枪的），
--   def 默认装的（M4 原来就带一具 ACOG：照旧），presets 推荐改装（三角洲那样一键套用）
GM.DEF = {
  m4 = {
    tag = "M4A1",
    base = { vrec = 52, hrec = 58, hand = 60, stab = 55, hip = 48, range = 46, mob = 72 },
    slots = {
      muzzle = { { "fh_a2", 1 }, { "muz_comp", 2 }, { "muz_brake", 5 }, { "sup_socom", 7 }, { "sup_wrap", 10 }, { "sup_sr8", 13 } },
      optic = { { "iron", 1 }, { "opt_romeo", 1 }, { "acog", 1 }, { "opt_rds", 3 }, { "opt_holo", 6 }, { "opt_acog6", 11 } },
      grip = { { "grip_none", 1 }, { "grip_rvg", 2 }, { "grip_afg", 8 } },
      mag = { { "mag_std", 1 }, { "mag_pmag20", 3 }, { "mag_hex30", 4 }, { "mag_pmag40", 9 }, { "mag_drum", 14 } },
      tac = { { "tac_none", 1 }, { "tac_light", 4 }, { "tac_peq", 12 } },
    },
    def = { muzzle = "fh_a2", optic = "acog", grip = "grip_none", mag = "mag_std", tac = "tac_none" },
    presets = {
      { id = "cqb", b = { muzzle = "muz_brake", optic = "opt_holo", grip = "grip_afg", mag = "mag_pmag40", tac = "tac_peq" } },
      { id = "all", b = { muzzle = "muz_comp", optic = "acog", grip = "grip_rvg", mag = "mag_hex30", tac = "tac_light" } },
      { id = "stealth", b = { muzzle = "sup_socom", optic = "opt_rds", grip = "grip_afg", mag = "mag_std", tac = "tac_none" } },
      { id = "lmg", b = { muzzle = "muz_comp", optic = "opt_holo", grip = "grip_rvg", mag = "mag_drum", tac = "tac_peq" } },
      { id = "dmr", b = { muzzle = "sup_sr8", optic = "opt_acog6", grip = "grip_rvg", mag = "mag_pmag20", tac = "tac_none" } },
    },
  },
  sniper = {
    tag = "SR",
    base = { vrec = 28, hrec = 46, hand = 38, stab = 64, hip = 12, range = 92, mob = 60 },
    slots = {
      muzzle = { { "muz_none", 1 }, { "muz_brake", 2 }, { "sup_sr8", 4 } },
    },
    def = { muzzle = "muz_none" },
    presets = {
      { id = "std", b = { muzzle = "muz_none" } },
      { id = "stable", b = { muzzle = "muz_brake" } },
      { id = "stealth", b = { muzzle = "sup_sr8" } },
    },
  },
}

-- 枪械等级：到第 i 级要累计多少经验（满级 = 表长）；每把枪最多到 maxLv
GM.XP = { 0, 200, 500, 900, 1400, 2000, 2700, 3500, 4400, 5400, 6500, 7700, 9000, 10400, 12000 }
GM.DEF.m4.maxLv = 15
GM.DEF.sniper.maxLv = 5

-- 性能分 → 真正的数：每分改多少（后坐、散布、晃动 1.2%，开镜快慢 1.2%，射程 1%，走路速度 0.4%）
local K_REC, K_HIP, K_STAB, K_HAND, K_RANGE, K_MOB = 0.012, 0.012, 0.012, 0.012, 0.01, 0.004
local RC0 = { up = 0.3, side = 0.12, punch = 1.0, roll = 0.5 }   -- 没写 rc 的枪按 M4 的

local function find(list, id)
  for i, x in ipairs(list) do if x[1] == id then return i, x end end
  return nil
end
GM.find = find

function GM.has(id) return GM.DEF[id] ~= nil end

-- 选的配件（表）整理成合法的：没选的、这把枪装不了的用默认；lv 给了的话，没解锁的也换成默认（all = true 全部解锁）；
--   owned(位, 配件) 返回 true 的是拿金币买过的（Economy.lua）：没到等级也算解锁
function GM.clean(id, b, lv, all, owned)
  local D = GM.DEF[id]
  if not D then return nil end
  local out = {}
  for _, slot in ipairs(GM.SLOTS) do
    local list = D.slots[slot]
    if list then
      local want = type(b) == "table" and b[slot] or nil
      local i, x = nil, nil
      if type(want) == "string" then i, x = find(list, want) end
      if x and lv and not all and x[2] > lv and not (owned and owned(slot, x[1])) then x = nil end
      out[slot] = x and x[1] or D.def[slot]
    end
  end
  return out
end

function GM.default(id)
  local D = GM.DEF[id]
  return D and table.clone(D.def) or nil
end

-- 这一位的这样配件几级解锁（装不了返回 nil）
function GM.unlockLv(id, slot, item)
  local D = GM.DEF[id]
  local list = D and D.slots[slot]
  if not list then return nil end
  local _, x = find(list, item)   -- 原来写成 list and find(...)：and 只留第一个返回值，x 一直是 nil（改枪界面从来不画等级锁）
  return x and x[2] or nil
end

-- 经验 → 等级、这一级起点、下一级要多少（满级时 nxt 是 nil）
function GM.level(id, xp)
  local D = GM.DEF[id]
  local maxLv = (D and D.maxLv) or #GM.XP
  xp = math.max(0, tonumber(xp) or 0)
  local lv = 1
  for i = 2, maxLv do
    if xp >= GM.XP[i] then lv = i end
  end
  return lv, GM.XP[lv], (lv < maxLv) and GM.XP[lv + 1] or nil
end

-- 从 a 级升到 b 级新解锁的配件
function GM.unlocksBetween(id, a, b)
  local D = GM.DEF[id]
  local out = {}
  if not D then return out end
  for _, slot in ipairs(GM.SLOTS) do
    for _, x in ipairs(D.slots[slot] or {}) do
      if x[2] > a and x[2] <= b then table.insert(out, x[1]) end
    end
  end
  return out
end

---------------------------------------------------------------- 存、传

-- 工具属性、存档用的写法："muzzle=sup_socom;optic=opt_holo;…"
function GM.encode(b)
  if type(b) ~= "table" then return "" end
  local parts = {}
  for _, slot in ipairs(GM.SLOTS) do
    if type(b[slot]) == "string" then table.insert(parts, slot .. "=" .. b[slot]) end
  end
  return table.concat(parts, ";")
end

function GM.decode(s)
  local b = {}
  if type(s) ~= "string" then return b end
  for k, v in string.gmatch(s, "([%w_]+)=([%w_]+)") do b[k] = v end
  return b
end

-- 改枪码（分享用）：每个位在列表里的序号按混合进制拼成一个数，写成 base32（去掉容易看错的 I L O U），最后两位校验——
--   校验 = Σ（第 i 位 × i）+ 枪名的数，对 1021（质数）取余：抄错任意一位、相邻两位写反都对不上
local B32 = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
local B32I = {}
for i = 1, #B32 do B32I[string.sub(B32, i, i)] = i - 1 end
local VERSION = "1"

local function checksum(tag, core)
  local c = 0
  for i = 1, #tag do c = (c * 7 + string.byte(tag, i)) % 1021 end
  for i = 1, #core do c = (c + i * (B32I[string.sub(core, i, i)] or 0)) % 1021 end
  return c
end

function GM.code(id, b)
  local D = GM.DEF[id]
  if not D then return nil end
  b = GM.clean(id, b)
  local v, mul = 0, 1
  for _, slot in ipairs(GM.SLOTS) do
    local list = D.slots[slot]
    if list then
      v += ((find(list, b[slot]) or 1) - 1) * mul
      mul *= #list
    end
  end
  local s = ""
  repeat
    s = string.sub(B32, v % 32 + 1, v % 32 + 1) .. s
    v = math.floor(v / 32)
  until v == 0
  while #s < 3 do s = "0" .. s end
  local core = VERSION .. s
  local c = checksum(D.tag, core)
  local hi, lo = math.floor(c / 32), c % 32
  return D.tag .. "-" .. core .. string.sub(B32, hi + 1, hi + 1) .. string.sub(B32, lo + 1, lo + 1)
end

-- 粘贴来的改枪码 → 枪、配件表；认不出来返回 nil 和原因（"bad" 格式不对、"sum" 校验不对、"gun" 不是这几把枪的）
function GM.parse(text)
  if type(text) ~= "string" then return nil, nil, "bad" end
  local s = string.upper(string.gsub(text, "%s", ""))
  local tag, body = string.match(s, "^([%w]+)%-([%w]+)$")
  if not tag then return nil, nil, "bad" end
  body = string.gsub(string.gsub(body, "O", "0"), "[IL]", "1")   -- 手抄的：O 当 0、I / L 当 1
  local id = nil
  for k, D in pairs(GM.DEF) do if D.tag == tag then id = k end end
  if not id then return nil, nil, "gun" end
  if #body < 6 or string.sub(body, 1, 1) ~= VERSION then return nil, nil, "bad" end
  local core = string.sub(body, 1, -3)
  local hi, lo = B32I[string.sub(body, -2, -2)], B32I[string.sub(body, -1)]
  if hi == nil or lo == nil then return nil, nil, "bad" end
  for i = 1, #core do if B32I[string.sub(core, i, i)] == nil then return nil, nil, "bad" end end
  if checksum(tag, core) ~= hi * 32 + lo then return nil, nil, "sum" end
  local v = 0
  for i = 2, #core do v = v * 32 + B32I[string.sub(core, i, i)] end
  local D = GM.DEF[id]
  local b = {}
  for _, slot in ipairs(GM.SLOTS) do
    local list = D.slots[slot]
    if list then
      local n = #list
      local i = v % n
      v = math.floor(v / n)
      b[slot] = list[i + 1][1]
    end
  end
  if v ~= 0 then return nil, nil, "bad" end
  return id, b
end

---------------------------------------------------------------- 性能

-- 装上这一套以后的分（裸枪的分 + 每样配件加减的）
function GM.score(id, b)
  local D = GM.DEF[id]
  local s = {}
  if not D then return s end
  for _, k in ipairs(GM.STATS) do s[k] = D.base[k] or 50 end
  b = GM.clean(id, b)
  for _, slot in ipairs(GM.SLOTS) do
    local it = b[slot] and GM.ITEM[b[slot]]
    if it and it.st then
      for k, v in pairs(it.st) do s[k] = (s[k] or 50) + v end
    end
  end
  for k, v in pairs(s) do s[k] = math.clamp(v, 0, 100) end
  return s
end

local function kOf(d, k, lo, hi) return math.clamp(1 - d * k, lo, hi) end

-- 武器表（Config.Weapons[id]）按这一套改一份：开枪、换弹、准星、后坐、开镜都用它
function GM.apply(id, base, b)
  local D = GM.DEF[id]
  if not D or type(base) ~= "table" then return base end
  b = GM.clean(id, b)
  local w = table.clone(base)
  local s = GM.score(id, b)
  local d = {}
  for _, k in ipairs(GM.STATS) do d[k] = s[k] - (D.base[k] or 50) end
  -- 后坐（Fx.lua G.kick）：垂直管上抬和往后踢，水平管左右飘和横滚
  local rc = base.rc or RC0
  w.rc = { up = rc.up * kOf(d.vrec, K_REC, 0.35, 1.8), punch = rc.punch * kOf(d.vrec * 0.7, K_REC, 0.4, 1.6),
    side = rc.side * kOf(d.hrec, K_REC, 0.35, 1.8), roll = rc.roll * kOf(d.hrec * 0.7, K_REC, 0.4, 1.6) }
  -- 连射越打越散：后坐压得住的散得慢
  if base.bloom then
    local avg = (d.vrec + d.hrec) / 2
    w.bloom = { base.bloom[1] * kOf(avg, 0.008, 0.5, 1.6), base.bloom[2] * kOf(avg, 0.006, 0.6, 1.5), base.bloom[3], base.bloom[4] }
  end
  w.spread = (base.spread or 0) * kOf(d.hip, K_HIP, 0.4, 1.8)        -- 腰射
  w.adsK = (base.adsK or 1) * kOf(d.stab, 0.005, 0.6, 1.4)           -- 开镜精度
  w.swayK = kOf(d.stab, K_STAB, 0.4, 1.8)                             -- 开镜时枪 / 镜子里的晃动
  w.adsSpd = math.clamp(1 + d.hand * K_HAND, 0.5, 1.6)               -- 开镜、拔枪快慢（倍数）
  w.range = (base.range or 500) * math.clamp(1 + d.range * K_RANGE, 0.7, 1.5)
  w.mobK = math.clamp(1 + d.mob * K_MOB, 0.85, 1.1)                   -- 走路速度
  -- 各位的特殊效果
  local quiet = base.quiet
  for _, slot in ipairs(GM.SLOTS) do
    local it = b[slot] and GM.ITEM[b[slot]]
    if it then
      if it.quiet then quiet = true end
      if it.mag then w.mag = it.mag end
      if it.reload then w.reload = (base.reload or 2) * it.reload end
      if it.laser then w.laser = true end
      if it.light then w.light = true end
      if slot == "optic" then
        w.adsZoom = it.zoom
        if it.scope then
          w.scope, w.optic = it.zoom, it.scope
        else   -- 机械瞄具、红点、全息：开镜看着枪（不进目镜的像）
          w.scope, w.optic = nil, nil
        end
        w.dot = it.dot
      end
    end
  end
  w.quiet = quiet or nil
  w.build = b
  return w
end

-- 伤害随距离衰减（fall = { 从射程的几成开始掉, 到射程尽头剩几成 }；没写的不衰减）
function GM.dmgAt(w, dist)
  local dmg = w.dmg or 0
  local f = w.fall
  if not f or not dist then return dmg end
  local R = w.range or 500
  local a = R * f[1]
  if dist <= a then return dmg end
  local t = math.clamp((dist - a) / math.max(1, R - a), 0, 1)
  return dmg * (1 - t * (1 - f[2]))
end

-- 「有效射程」（米，界面上写的）：伤害开始衰减的距离；不衰减的写射程
function GM.effRange(w)
  local R = w.range or 500
  return math.floor(R * (w.fall and w.fall[1] or 1) / 2.8 + 0.5)
end

---------------------------------------------------------------- 配件装在枪上的哪儿

-- 第一人称 / 改枪界面的 M4（FPSView 的枪身骨骼坐标：+Z 朝枪口、+Y 朝上，格；照动作包的真 M4 量的）
--   bore 枪管轴线，tip A2 消焰器前端，rail 上机匣导轨顶面，under 护木下面，magTop 弹匣顶面中心（弹匣骨骼坐标）；
--   side 护木左侧导轨（枪身骨骼的 +X 是枪的左边：左手托在这边；第一人称镜头看得见的那一面，改枪界面也是看左侧）
GM.M4 = { bore = { 0.0095, 0.0505 }, tip = 1.439, rail = 0.142, under = -0.033, side = 0.094, sideY = 0.0545, magTop = { 0, 0.253, -0.041 } }
-- 每样配件在 M4 上的位置：z 枪口件的后端 / 瞄具的原点 / 握把、战术件的中心
GM.M4AT = {
  muz_comp = 1.249, muz_brake = 1.269, sup_socom = 1.37, sup_wrap = 1.37, sup_sr8 = 1.37,
  acog = 0.24, opt_acog6 = 0.2, opt_rds = 0.3, opt_holo = 0.28, opt_romeo = 0.24,
  grip_rvg = 0.74, grip_afg = 0.62, tac_light = 0.74, tac_peq = 0.74,
}

-- 配件 → { cf 装在哪（M4 枪身骨骼坐标；弹匣是弹匣骨骼坐标）, track 跟哪条骨骼, mz 装了以后的枪口（枪口件才有） }；
--   meta 是 OpticsMeta[配件的模型键]（量尺寸用）；不用装模型的返回 nil
function GM.m4Mount(item, meta)
  local it = GM.ITEM[item]
  if not it or not it.model then return nil end
  local M4 = GM.M4
  local bx, by = M4.bore[1], M4.bore[2]
  local slot = it.slot
  if slot == "muzzle" then
    local z = GM.M4AT[item] or 1.37
    local L = (meta and meta.size and meta.size[3]) or 0.3
    return { cf = CFrame.new(bx, by, z), track = "gun", mz = Vector3.new(bx, by, z + L) }
  elseif slot == "optic" then
    if item == "acog" then return { cf = CFrame.new(0, M4.rail, GM.M4AT.acog), track = "gun" } end   -- 原来那具：位置照旧
    local ex = 0   -- 光轴对正枪管（有的瞄具侧面有旋钮，包围盒中心不在光轴上）
    if it.eye then ex = it.eye[1] elseif meta and meta.eye then ex = meta.eye.c[1] elseif meta and meta.obj then ex = meta.obj.c[1] end
    return { cf = CFrame.new(bx - ex, M4.rail + (it.riser or 0), GM.M4AT[item] or 0.25), track = "gun", riser = it.riser }
  elseif slot == "grip" then
    return { cf = CFrame.new(bx, M4.under, GM.M4AT[item] or 0.7), track = "gun" }
  elseif slot == "mag" then
    local t = M4.magTop
    return { cf = CFrame.new(t[1], t[2], t[3]), track = "mag" }   -- 弹匣：两条弹匣骨骼（mag1 枪上的、mag2 换弹时手里的）都装
  elseif slot == "tac" then
    -- 左侧导轨：模型的底面（+Y 朝上）转成朝外（+X）贴在导轨上
    return { cf = CFrame.new(M4.side, M4.sideY, GM.M4AT[item] or 0.7) * CFrame.Angles(0, 0, -math.pi / 2), track = "gun" }
  end
  return nil
end

-- 镜片 / 窗玻璃该多透明（不是玻璃的返回 nil）：key 是模型键（和配件同名）
function GM.glassT(key, part)
  local it = GM.ITEM[key]
  return it and it.glass and it.glass[part] or nil
end

-- 瞄具的光轴（器材坐标）：{ eye 目镜 / 后窗中心, obj 物镜 / 前窗中心, r 目镜半径 }；机械瞄具、没有的返回 nil
function GM.sightOf(item, meta)
  local it = GM.ITEM[item]
  if not it then return nil end
  if it.eye and it.obj then
    return { eye = Vector3.new(it.eye[1], it.eye[2], it.eye[3]), obj = Vector3.new(it.obj[1], it.obj[2], it.obj[3]), r = it.eye[4] or 0.03 }
  end
  if not meta then return nil end
  local e, o = meta.eye, meta.obj
  if e and o then
    return { eye = Vector3.new(e.c[1], e.c[2], e.c[3]), obj = Vector3.new(o.c[1], o.c[2], o.c[3]), r = e.r or 0.03 }
  end
  if o then   -- 只量到一块窗玻璃（Romeo3）：光轴水平穿过它
    local c = Vector3.new(o.c[1], o.c[2], o.c[3])
    return { eye = c - Vector3.new(0, 0, 0.05), obj = c, r = o.r or 0.03 }
  end
  return nil
end

-- 第三人称：工具上零件拼的 M4（Weapons.lua makeTool 的 SHAPE.m4：−Z 朝前、把手在握把，比真枪大一倍左右；工具的 −X 是枪的左边）；
--   配件模型按各位的倍数放大（ACOG 原来就是 1.2 倍），+Z 朝前的器材坐标转 180° 装上
GM.TP = {
  m4 = { muzzle = { 0, 0.38, -3.55, 2.6 }, optic = { 0, 0.65, -0.5, 1.2 }, grip = { 0, 0.05, -1.75, 2.0 }, mag = { 0, 0.22, -0.8, 1.8 }, tac = { -0.225, 0.35, -1.7, 1.8 } },
}

return GM
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="19">
      <Properties>
        <string name="Name">HatchDefs</string>
        <ProtectedString name="Source"><![CDATA[-- 全面大战场——载具的舱盖、车门、跳板（用户 11-24：「坦克舱门开合动画」「你记得按照现实中不同坦克的舱门开合模式去做哈」）
--   客户端 Hatch.lua 照这张表在原模型上加能动的舱盖（原模型的舱盖和车身是一整块网格，掀不起来：盖一块同样大小的板，开的时候板掀开、
--   下面垫一块黑的当舱口）；车长探出舱口的小人、上下车时开的门也在那里
--   位置：原模型坐标（格，models/veh/<键>.glb 的坐标：原点车底中心，X 右、Y 上、−Z 朝前），tools/models/hatchmeasure.py 在模型上量的高度；
--     炮塔上的（g = "turret"）客户端再减去炮塔转轴；r 圆舱盖半径、w × h 方的
--   动法（照真车，出处见每一行；没查到的写明是照同一系的车推的）：
--     abrams    后铰链往后掀到 105°；另有「打开保护位」：舱盖只掀开 9°，车长从缝里往外看（M1 系列车长舱盖能锁在全开和「open, protected」两个位置）
--     rear      后铰链往后掀到 105°
--     front     前铰链往前掀到 95°（掀开立在前面当挡板：T-72 / T-90 的车长、炮长舱盖都能锁在往前开的位置）
--     liftswing 先往上抬一点再横着转开（驾驶员舱盖：炮管在头顶，掀不起来，抬起来往一边转；side 1 往右、−1 往左）
--     ramp      车尾跳板：下沿铰链往外放倒，放到跳板尖着地（布雷德利是液压跳板、左边开一扇小门；斯特赖克同样是尾部跳板）
--     door      竖铰链的门往外开 105°（hinge = "L" 左边是铰链、"R" 右边；BMP-3 车尾两扇门往左右两边开）
--     flap      车顶舱盖外沿铰链往上往外翻 110°（BMP-3 载员舱顶两块大舱盖）
--   crew：这个舱口是谁的（commander 车长、loader 装填手：没打仗时探出来的小人站这里）；use：pass 乘客上下车时开、drv 驾驶员上下车时开
local V = Vector3.new

local H = {}

-- 位置都在模型上量过（tools/mock/hatch_view.cjs 的 grid：正上方看、叠 1 格的网格；高度 tools/models/hatchmeasure.py，取舱盖中心最上面那层——
--   开着时垫的黑底要盖住原模型自己那块关着的舱盖）。驾驶员舱盖 pv 是模型上看得见的转轴（舱盖抬起来绕它横着转开），w × h 是方的（长圆的按方的画）

-- M1A2 SEPv2（m1a2dc）：车长舱盖在八边形指挥塔顶上（四周一圈透明防弹板），装填手舱盖在左边；
--   驾驶员舱盖在车体正前方炮塔底下（前沿三具潜望镜），右后方一根转轴：抬起来往右转开
H.m1a2dc = {
  { id = "cmd", g = "turret", at = V(1.57, 7.56, 1.24), r = 0.95, m = "abrams", crew = "commander" },
  { id = "ldr", g = "turret", at = V(-1.2, 6.93, 0.93), r = 0.78, m = "rear", crew = "loader" },
  { id = "drv", g = "hull", at = V(-0.1, 4.21, -5.79), w = 2.0, h = 1.1, m = "liftswing", side = 1, pv = V(1.12, 0, -5.57), use = "drv" },
}
-- M1A1（m1a1i）：原模型的车长舱盖本来就是开着的（orig = "open"：不另画舱盖，只有车长探身 / 缩回去）
H.m1a1i = {
  { id = "cmd", g = "turret", at = V(1.51, 7.6, 1.08), r = 0.9, m = "abrams", crew = "commander", orig = "open" },
  { id = "ldr", g = "turret", at = V(-1.36, 7.22, 0.94), r = 0.85, m = "rear", crew = "loader" },
  { id = "drv", g = "hull", at = V(0, 4.64, -6.0), w = 2.0, h = 1.3, m = "liftswing", side = 1, pv = V(1.05, 0, -5.6), use = "drv" },
}
H.m1a1 = H.m1a1i
-- 99A（ztz99a2）：车长（右边，舱盖四周一圈潜望镜）、炮长（左边）都是单片舱盖往后开（tank-afv.com 的 Type 99：两个都是 single piece hatch opening to the rear）；
--   驾驶员舱盖在车体中线（长圆形，前面一排潜望镜），转轴在右后方——照模型上的转轴往右转开（资料说 99 式往左开，99A 挪了位置，没查到准的）
H.ztz99a2 = {
  { id = "cmd", g = "turret", at = V(1.5, 6.75, -0.05), r = 0.95, m = "rear", crew = "commander" },
  { id = "gnr", g = "turret", at = V(-1.4, 6.62, -0.15), r = 0.85, m = "rear" },
  { id = "drv", g = "hull", at = V(0, 4.10, -5.66), w = 1.75, h = 1.15, m = "liftswing", side = 1, pv = V(0.68, 0, -5.27), use = "drv" },
}
-- 96 式（ztz96）：从 88 式一路改过来的苏式布局——车长（右）、炮长（左）舱盖往前开、锁在前面当挡板；
--   驾驶员在车体左前方（不在中线），舱盖左后方有铰链座：抬起来往左（车外侧）转开（同 T-54 / 55 一系）
H.ztz96 = {
  { id = "cmd", g = "turret", at = V(1.53, 6.87, 0.05), r = 0.95, m = "front", crew = "commander" },
  { id = "gnr", g = "turret", at = V(-1.28, 6.35, -0.2), r = 0.85, m = "front" },
  { id = "drv", g = "hull", at = V(-1.89, 4.31, -5.27), r = 0.8, m = "liftswing", side = -1, pv = V(-2.43, 0, -4.88), use = "drv" },
}
-- T-90M（t90m）：车长指挥塔在右后（一圈观察窗，舱盖在塔顶），炮长舱盖在左边（炮长瞄准镜后面），都往前开（T-72 / T-90 一系）；
--   驾驶员舱盖在车体中线（前面潜望镜座），右后方转轴：抬起来往右转开
H.t90m = {
  { id = "cmd", g = "turret", at = V(1.95, 6.60, 0.76), r = 0.72, m = "front", crew = "commander" },
  { id = "gnr", g = "turret", at = V(-1.86, 6.35, -0.25), r = 0.75, m = "front" },
  { id = "drv", g = "hull", at = V(0.08, 4.18, -4.78), w = 1.75, h = 1.07, m = "liftswing", side = 1, pv = V(0.64, 0, -4.54), use = "drv" },
}
-- M2A3 布雷德利：车尾液压跳板（斜面：下沿 y 1.6 / z 7.9，上沿 y 5.5 / z 8.77）
H.m2a3 = {
  { id = "ramp", g = "hull", m = "ramp", at = V(0, 1.6, 7.9), top = V(0, 5.5, 8.77), w = 4.6, use = "pass" },
}
-- ZBD-05（zbd97 的模型）：车尾一扇大门，右边铰链（模型上门右边两个铰链座）
H.zbd97 = {
  { id = "door", g = "hull", m = "door", hinge = "R", at = V(0, 1.7, 9.17), top = V(0, 5.4, 9.17), w = 3.8, use = "pass" },
}
-- ZSL-92B（借 LAV-25 的模型）：LAV 车尾两扇门往两边开（斜面）
H.lav25 = {
  { id = "doorL", g = "hull", m = "door", hinge = "L", at = V(-0.85, 2.1, 7.95), top = V(-0.85, 4.9, 8.86), w = 1.6, use = "pass" },
  { id = "doorR", g = "hull", m = "door", hinge = "R", at = V(0.85, 2.1, 7.95), top = V(0.85, 4.9, 8.86), w = 1.6, use = "pass" },
}
-- M1117（借 M-ATV 的模型）：车尾一扇门，左边铰链
H.matv = {
  { id = "door", g = "hull", m = "door", hinge = "L", at = V(0, 2.4, 7.63), top = V(0, 6.4, 7.63), w = 2.2, use = "pass" },
}

-- 没有原模型（零件拼的车）或者表里没有的型号：按型号表的尺寸摆一套通用的——坦克车长舱盖在 cupola（往后开）、驾驶员舱盖往右转开；
--   有乘客座位的车车尾一扇门（右边铰链）
function H.generic(d)
  local list = {}
  if d.cat == "tank" and d.cupola then
    table.insert(list, { id = "cmd", g = "turretLocal", at = d.cupola, r = 0.9, m = "rear", crew = "commander" })
  end
  if d.cat == "tank" then
    table.insert(list, { id = "drv", g = "hull", at = V(0, d.hullH, -d.L * 0.36), r = 0.8, m = "liftswing", side = 1, use = "drv" })
  end
  if (d.seats or 1) > 1 then
    local zr = d.L / 2 - 0.05
    table.insert(list, { id = "door", g = "hull", m = "door", hinge = "R", at = V(0, (d.clear or 1.2) + 0.4, zr), top = V(0, d.hullH - 0.4, zr), w = math.min(2.6, d.W * 0.3), use = "pass" })
  end
  return list
end

-- ---------------------------------------------------------------- 几何（客户端 Hatch.lua 和测试共用：只用 Vector3 / CFrame）
local CF, ANG, rad = CFrame.new, CFrame.Angles, math.rad
local function clamp(x, a, b) return x < a and a or (x > b and b or x) end
H.TH = 0.18                                   -- 舱盖板厚（格）
H.UPRIGHT = ANG(0, 0, math.pi / 2)            -- 圆柱的轴（X）转到竖直
H.ABRAMS_OP = rad(9) / rad(105)               -- 艾布拉姆斯「打开保护位」占全开的多少

-- 表里的一行 → 算好的舱盖（挂在车体还是炮塔、在那个坐标系里的位置）：tpiv 炮塔转轴（原模型坐标）
function H.prep(d, tpiv)
  tpiv = tpiv or V()
  local h = { id = d.id, m = d.m, g = (d.g == "hull") and "hull" or "turret", r = d.r, w = d.w, side = d.side, hinge = d.hinge,
    crew = d.crew, use = d.use, orig = d.orig }
  local sh = (d.g == "turret") and tpiv or V()   -- turretLocal：已经是炮塔坐标
  h.loc = d.at - sh
  if d.pv then h.pv = d.pv - V(sh.X, 0, sh.Z) end
  if d.m == "ramp" or d.m == "door" then   -- 车尾斜面上的板：下沿 at、上沿 top
    local base, top = d.at - sh, d.top - sh
    local u = top - base
    h.L = u.Magnitude
    h.t0 = math.atan2(u.Z, u.Y)   -- 往后倾多少（绕 X 轴）
    h.base = base
    if d.m == "ramp" then h.open = clamp(math.acos(clamp(-base.Y / h.L, -1, 1)) - h.t0, rad(60), rad(150)) end   -- 放倒到尖着地
    h.shape, h.size = "block", V(h.w, h.L, H.TH)
    h.holeSize = V(h.w * 0.94, h.L * 0.94, 0.06)
    h.holeCF = CF(base) * ANG(h.t0, 0, 0) * CF(0, h.L / 2, 0.04)
  elseif d.w and d.h then   -- 方的（BMP-3 车顶舱盖、长圆的驾驶员舱盖）
    h.h = d.h
    h.shape, h.size = "block", V(h.w, H.TH, h.h)
    h.holeSize = V(h.w * 0.92, 0.06, h.h * 0.92)
    h.holeCF = CF(h.loc + V(0, 0.04, 0))
  else
    h.shape, h.size = "round", V(H.TH, h.r * 2, h.r * 2)
    h.holeSize = V(0.06, h.r * 1.84, h.r * 1.84)
    h.holeCF = CF(h.loc + V(0, 0.04, 0)) * H.UPRIGHT
  end
  return h
end

-- 舱盖在车体 / 炮塔坐标里的样子（p：开的程度 0～1）。板都摆在原模型表面外面一点（不和原模型的舱盖抢同一个面闪）
function H.lidCF(h, p)
  local m, C, TH = h.m, h.loc, H.TH
  local up = TH / 2 + 0.01
  local rot = (h.shape == "round") and H.UPRIGHT or CF()
  local hd = h.h and h.h / 2 or h.r       -- 前后半长（铰链离中心多远）
  if m == "rear" or m == "abrams" then   -- 后铰链：铰链在舱盖后沿（+Z 朝后），往后掀
    local a = rad(105) * p
    return CF(C + V(0, 0, hd)) * ANG(a, 0, 0) * CF(0, up, -hd) * rot
  elseif m == "front" then               -- 前铰链：往前掀、立在前面
    local a = rad(95) * p
    return CF(C + V(0, 0, -hd)) * ANG(-a, 0, 0) * CF(0, up, hd) * rot
  elseif m == "liftswing" then           -- 先抬 0.22 格，再绕竖轴（pv，没给就在侧边）转开 160°；side 1 从前面转到右边，−1 转到左边
    local lift = clamp(p / 0.25, 0, 1) * 0.22
    local ang = clamp((p - 0.25) / 0.75, 0, 1) * rad(160)
    local s = h.side or 1
    local pv = h.pv and V(h.pv.X, C.Y, h.pv.Z) or (C + V(s * (h.w and h.w / 2 or h.r), 0, 0))
    return CF(pv + V(0, lift, 0)) * ANG(0, -s * ang, 0) * CF((C - pv) + V(0, up, 0)) * rot
  elseif m == "ramp" then                -- 下沿铰链往后放倒
    return CF(h.base) * ANG(h.t0 + h.open * p, 0, 0) * CF(0, h.L / 2, up)
  elseif m == "door" then                -- 竖铰链（斜面上的门按斜面倾着转）
    local left = h.hinge == "L"
    local hx = left and -h.w / 2 or h.w / 2
    return CF(h.base) * ANG(h.t0, 0, 0) * CF(hx, 0, up) * ANG(0, (left and -1 or 1) * rad(105) * p, 0) * CF(-hx, h.L / 2, 0)
  elseif m == "flap" then                -- 外沿铰链往上往外翻
    local s = h.side or 1
    return CF(C + V(s * h.w / 2, 0, 0)) * ANG(0, 0, -s * rad(110) * p) * CF(-s * h.w / 2, up, 0)
  end
  return CF(C)
end

return H
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="20">
      <Properties>
        <string name="Name">HitSurf</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——子弹打在什么上面（弹着点的样子、声音按它出；用户：枪打在坦克上要有火花）：
--   服务器发枪响特效时带上（Weapons.lua 的 KIND.gun、G.botShot），自己开的枪客户端照同样的规则判（Fx.lua）
--   a 装甲车辆（坦克、步战车、自行火炮：钢甲火花、叮当声、跳弹）  l 轻型车辆（悍马、卡车）  m 飞机、金属物件  s 舰艇
--   c 工事（混凝土碎屑）  f 人  w 水  n 沙  d 泥土  v 草地  i 雪  j 冰  r 石头、水泥、砖  o 木头  g 玻璃
--   （11-27：雪、冰、草地从「泥土」「石头」里分出来——雪山整张图的弹着点原来都是褐色土花、打在冰面上迸火星；服务器只看 METAL，别的代号原样转给客户端）
local HitSurf = {}

local CAT = { armor = "a", light = "l", air = "m", ship = "s", fort = "c", inf = "f" }   -- 实体的伤害类别（Ents.lua 的 Cat 属性）

-- 材质 → 代号（按名字查：模拟器 / 旧版本缺的材质就跳过）
local function byName(t)
  local out = {}
  for name, code in pairs(t) do
    local ok, e = pcall(function() return Enum.Material[name] end)
    if ok and e then out[e] = code end
  end
  return out
end
local TERRAIN = byName({ Water = "w", Sand = "n", Sandstone = "n", Salt = "n",
  Grass = "v", LeafyGrass = "v", Ground = "d", Mud = "d", Snow = "i",
  Rock = "r", Basalt = "r", Slate = "r", Concrete = "r", Asphalt = "r", Pavement = "r", Limestone = "r", Cobblestone = "r",
  Brick = "r", Granite = "r", CrackedLava = "r", Glacier = "j", Ice = "j" })
local PART = byName({ Metal = "m", DiamondPlate = "m", CorrodedMetal = "m", Foil = "m",
  Wood = "o", WoodPlanks = "o", Glass = "g", Sand = "n", Grass = "v", Ground = "d", Mud = "d", Fabric = "d", LeafyGrass = "v", Snow = "i", Ice = "j", Glacier = "j" })

-- inst：射线打中的零件；material：射线结果的材质（地形按它分）
function HitSurf.of(inst, material)
  if not inst then return nil end
  if inst:IsA("Terrain") then return TERRAIN[material] or "d" end
  local m = inst
  while m and m ~= workspace do
    if m:IsA("Model") then
      local c = m:GetAttribute("Cat")
      if c then return CAT[c] or "m" end
      if m:FindFirstChildOfClass("Humanoid") then return "f" end
    end
    m = m.Parent
  end
  return PART[material or inst.Material] or "r"
end

-- 金属面（出火花）
HitSurf.METAL = { a = true, l = true, m = true, s = true }

return HitSurf
]]></ProtectedString>
      </Properties>
    </Item>
