    <Item class="ModuleScript" referent="22">
      <Properties>
        <string name="Name">HudMeta</string>
        <ProtectedString name="Source"><![CDATA[-- 自动生成（tools/weapons/hud.mjs），别手改：飞机座舱平显（光学瞄准屏）原模型的元数据
--   原模型：J-15T with YJ-83K（作者 Jeyhun1985，CC-BY-4.0）自带座舱里的平显——两根弧形立柱 + 顶梁、投影仪壳子（Frame），组合玻璃（Glass）
--   平显坐标（米）：原点在组合玻璃的包围盒中心，+X 飞行员看来的右边，+Y 上，+Z 朝飞行员；parts[块名] = { c 中心, s 大小, tri 三角形数 }
--   导入后 MeshPart 叫 O_hud15__<块名>，开服时 Imports.lua 收进 ReplicatedStorage.Imported.Optics.hud15；InteriorDefs 的平显有它就换上
return {
  hud15 = {
    parts = {
      Frame = { c = { 0, -0.0658, -0.0037 }, s = { 0.2824, 0.3192, 0.2479 }, tri = 1398 },
      Glass = { c = { 0, 0, 0 }, s = { 0.2317, 0.1829, 0.2231 }, tri = 76 },
    },
    glass = { w = 0.2317, h = 0.1829, d = 0.2231, tilt = -83.3 },   -- 组合玻璃（米）：包围盒、往飞行员那边仰几度
    credit = "平显（光学瞄准屏）：J-15T with YJ-83K 自带座舱里的平显，作者 Jeyhun1985（https://sketchfab.com/3d-models/b416034f0cde4e46b37cf3e5445bd1b7），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）",
  },
}
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="23">
      <Properties>
        <string name="Name">ImportTurn</string>
        <ProtectedString name="Source"><![CDATA[-- Roblox全面大战场——导入的原模型摆放时要补回的半圈（服务器、客户端共用）
--   Studio「导入 3D」导入 GLB 时，Roblox 把每一块网格在它自己的坐标里绕 Y 轴转了 180°：文件里的顶点 (x, y, z) 存成 (−x, y, −z)，块的中心不变。
--   用户截图（挂载界面的歼-35）：主翼跑到了平尾的位置、平尾跑到主翼的位置、座舱盖跑到两个垂尾中间、机头成了一根细尖——每一块各自掉了个头；
--   按「每块绕自己中心转半圈」把 models/air/j31.glb 画出来和截图一模一样。坦克的车体、炮塔也是前后反的（炮管前后对称，才不显眼）。
--   别人也碰到过同样的事：https://github.com/LiamTheMo/RBLX-Flintborn/pull/43（顶点 (x, y, z) 存成 (−x, y, −z)，没有镜像）
-- 所以摆每一块导入的零件时右乘 TURN（绕这块自己的中心再转半圈），显示出来就和 GLB 文件里一样。
--   开局用内嵌数据现生成的网格（EditableMesh：瞄准镜、第一人称 M4）没被转过，不乘。
--   以后 Roblox 改了导入、模型又反了：ReplicatedStorage 上加个布尔属性 ImportTurn = false 就不补
local RS = game:GetService("ReplicatedStorage")
local skip = RS:GetAttribute("ImportTurn") == false
return { TURN = skip and CFrame.new() or CFrame.Angles(0, math.pi, 0) }
]]></ProtectedString>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="24">
      <Properties>
        <string name="Name">ImportedAir</string>
        <ProtectedString name="Source"><![CDATA[-- 自动生成（tools/models/air2glb.py），别手改：网页版飞机、直升机模型原样转成的 Roblox 模型（models/air/<文件名>.glb）的元数据
--   alias：游戏里的型号 → 模型键（带 ~ 的去掉原机涂装，按我方涂色）；m[模型键] = { len 长 / w 翼展 / h 高（格，真实尺寸：1 米 = 2.8 格）,
--     parts[块名] = { g 部件（Body / Gear / Rotor / Rotor2 / TRotor / FoldR / FoldL / TipR / TipL，活动部件见 surf）, c 中心, s 大小, col 没贴图的块的颜色, a 不透明度, met 金属 },
--     gear 模型自带起落架, rotor / rotor2 / trotor = { p 支点, a 轴 }, fold[Fold / Tip] = { x 右侧铰链, y 高, A 折起的角度 }, noz 尾喷口 { x, y, z, 半径 },
--     tip 右翼尖 { x, y, 前缘 z, 后缘 z }, prof 机身中线的上 / 下表面（从 z0 起每格一个）, tails 垂尾顶 { twin 双垂尾, p }, pyl[型号][挂点] = { 机翼下表面的高, 挪到的 z, x },
--     surf[部件] = { k 动法（ail 副翼 / flap / flaperon / elevon / stab 全动平尾 / elev 升降舵 / can 鸭翼 / rud 方向舵 / fin 全动垂尾 / rv V 尾 / bay / bayS 弹舱门 /
--       canopy 座舱盖 / gear 起落架支柱 / gdoor 起落架舱门）, s 侧（1 右 −1 左）, a / b 铰链两端, sg 正角度的方向, A 开到多大（弧度）, fold / tip 跟着哪边折 },
--     wells 弹舱井 { c 中心, s 大小 }, pit 飞行员头的位置, credit 署名 }
--   old[型号] = { 老版本的键…（新的在前）}：有活动部件的模型换了键名（<键>_v3）；用户导入的是老版本时照这张表找（_v2 会动但有的面朝反了，不带后缀的一整块蒙皮不会动）
--   坐标：X 右、Y 上、−Z 朝前，高度 0 是停在地上时的地面（游戏里再往下挪 gearH 就是机体坐标）；导入后 MeshPart 叫 A_<模型键>__<块名>
