  xm578 = { cls = "ap", name = "XM578 APFSDS", sym = "穿甲", v0 = 1480, k = 5.0e-5, bs = 1200, tr = true,        -- 钨芯尾翼稳定脱壳穿甲弹（六十年代）
    vs = { inf = 0.55, light = 1.0, armor = 1.1, fort = 0.8 }, splash = 0.6 },
