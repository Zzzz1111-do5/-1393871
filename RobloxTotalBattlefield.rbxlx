  wk_uaz = { credit = "UAZ-469 吉普：Uaz-469，作者 Yo.Ri（https://sketchfab.com/models/70c8691c6fb64b859fbfc16babfa2c5f），CC-BY-4.0 授权（http://creativecommons.org/licenses/by/4.0/）；改动：按真车全长缩放、换成 Roblox 的格、减面到 12000 个三角形、按材质切块、贴图缩到 1024", d = 4.988, h = 5.882, name = "UAZ-469 吉普", o = { 288.216, 0, 0 }, parts = { Body_1 = { c = { 0, 2.941, -0 }, s = { 11.284, 5.882, 4.988 } }, Body_2 = { c = { -1.881, 4.686, 0 }, s = { 7.198, 1.334, 4.448 } } }, tris = 12000, w = 11.284 },
