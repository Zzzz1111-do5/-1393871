    ["faction.sub@snow"] = "SCHNEEGIPFEL · ALPINER PANZERKAMPF",
    ["faction.title"] = "WÄHLE DEINE SEITE",
    ["fort.aaa"] = "Flak",
    ["fort.bunker"] = "MG-Bunker",
    ["fort.coastal"] = "Küstengeschütz",
    ["fort.howitzer"] = "M777-Haubitze",
    ["fort.mine"] = "Mine",
    ["fort.strike"] = "Artillerie",
    ["fw.flak35"] = "35-mm-Zwillingsflak",
    ["fw.hmg"] = "12,7-mm-MG",
    ["fw.how155"] = "155-mm-Haubitze",
    ["fw.naval127"] = "127-mm-Geschütz",
    ["game.title"] = "Inselsturm",
    ["gar.back"] = "ZURÜCK",
    ["gar.cells"] = "ERA {1} Kacheln",
    ["gar.d.arat"] = "US-TUSK ARAT-1: M19-Reaktivkacheln zu je 65 lb (etwa 29,5 kg, US Army 2020), gegen RPGs; wenig Wirkung gegen Tandem-Lenkwaffen, keine gegen APFSDS.",
    ["gar.d.arat2"] = "TUSK II: eine zweite ARAT-2-Lage (M32, gewölbt wie Dachziegel) über den M19, gegen Tandem-Gefechtsköpfe — Lenkwaffen auf 50 %, Raketen auf 25 %. Wird auch über die werkseitigen M19 gesetzt. Das M32-Gewicht ist nicht öffentlich; ~22 kg pro Kachel angenommen (geschätzt).",
    ["gar.d.belly"] = "Eine durchgehende Bodenplatte: Panzerminen oder Ladungen unter der Wanne machen halben Schaden (geschätzt). Etwa 1,3 t (geschätzt).",
    ["gar.d.ep"] = "Klicke Zellen an der Wanne an, um ERA anzubringen oder zu entfernen: nichts aufs Dach, nichts über Visiere, Periskope, Scheinwerfer, Nebelwerfer oder Luken, nichts, wo der Turm oder eine abgesenkte Kanone durchschwenkt. Werkskacheln lassen sich nicht entfernen.",
    ["gar.d.era"] = "Trifft eine Rakete einen Block, zündet er und hält den Großteil des Schadens ab; schwere ERA schwächt auch Wuchtgeschosse. Verbrauchte Blöcke sind weg.",
    ["gar.d.eraZones"] = "Wähle, wo Reaktivpanzerung sitzt (Karten links oder Kreise am Panzer): Turmfront, Turmseiten, oberer Bug, Seitenschürzen. Raketen auf einer bestückten Fläche zünden den Block und verlieren den Großteil ihres Schadens; blanke Flächen bekommen den vollen Treffer. Jede freie Fläche macht den Panzer etwas leichter und schneller.",
    ["gar.d.fy2"] = "ERA der 2. Generation: sehr wirksam gegen einfache Hohlladungen (RPGs) — ein Treffer auf eine Kachel macht 30 % Schaden; Tandem-Lenkwaffen überwinden sie mit der Vorladung; nutzlos gegen APFSDS. Etwa 22 kg pro Kachel (geschätzt).",
    ["gar.d.fy4"] = "Schwere ERA (Kontakt-5-Klasse: dicke Platten lenken lange Penetratoren ab und brechen sie): Hohlladungen auf ~22 %, Tandem-Lenkwaffen ~60 %, APFSDS verlieren ~20 % (offizielle Kontakt-5-Angabe: ~20 % Durchschlag). Etwa 45 kg pro Kachel (geschätzt).",
    ["gar.d.gau8"] = "Eine 30-mm-Gatling mit zwei Trommeln (2048 Schuss) auf dem Turmdach; Taste 3. Stark gegen Infanterie, leichte Panzerung, Stellungen und tief fliegende Flugzeuge. Tempo −5 %.",
    ["gar.d.gl5"] = "NORINCO GL5: vier Werfereinheiten und vier Millimeterwellenradare an den Turmecken; 360° Azimut, aber nur 20° Elevation (kein Schutz gegen Top-Attack); verfolgt ab über 100 m und zerstört die Bedrohung etwa 10 m vor dem Fahrzeug. Ein Schuss pro Einheit; im Spiel alle 45 s einer zurück.",
    ["gar.d.hk"] = "Werfer an den Turmseiten zerstören anfliegende Raketen etwa 10 m vor dem Fahrzeug. 4 Schuss, alle 30 s kommt einer zurück; hält keine Panzergranaten und steile Top-Attacks auf. Tempo −3 %.",
    ["gar.d.jd3"] = "JD-3 des 99A: Laserwarnung + Lasergegenmaßnahme (Stören des Zielbeleuchters) + Auto-Nebel. Wenig ist öffentlich; im Spiel warnt es, nebelt und bricht mit etwa 45 % Chance die Aufschaltung der Rakete sofort (geschätzt). Etwa 120 kg (geschätzt).",
    ["gar.d.lws"] = "Laserwarnempfänger: warnen und zeigen die Richtung, sobald eine lasergelenkte Rakete oder Bombe auf dich gerichtet wird, und feuern automatisch eine Nebelsalve — der Nebel verdeckt den Laserpunkt und die Rakete verliert das Ziel. Etwa 60 kg (geschätzt).",
    ["gar.d.mcs"] = "Multispektrale Tarnung (Klasse Saab Barracuda MCS): deckt sichtbares Licht, Nah-IR, Wärmebild und Radar ab; feindliche Bots und Fahrzeuge entdecken dich auf 70 % der üblichen Entfernung (geschätzt). Nur an Seiten und Heck — nicht auf dem Dach, nicht über der Optik. Etwa 300 kg (geschätzt).",
    ["gar.d.none"] = "Kein Aktivschutz: leichter und etwas schneller.",
    ["gar.d.plow"] = "Pearson-Minenräumpflug in voller Breite: 3.600 kg, räumt eine 4,2 m breite und 175–300 mm tiefe Gasse bei 1–15 km/h, 11 s zum Anheben. Während der Fahrt J drücken zum Absenken oder Anheben: Minen in der Gasse vorn werden beiseitegeschoben, ohne zu zünden.",
    ["gar.d.shtora"] = "Schtora-1 des T-90A: je ein OTSchU-1-7-IR-Störstrahler neben der Kanone (das Paar roter Lampen) plus Laserwarnung. Laserbestrahlung löst Auto-Nebel aus; kommandogelenkte Lenkwaffen (TOW, HOT, Ataka…) werden ab etwa 850 m in rund der Hälfte der Fälle getäuscht.",
    ["gar.d.slat"] = "Flache Stahlstäbe etwa einen halben Meter vor Heck, hinteren Seiten (Motorraum) und Turmheck: Etwa der Hälfte der einfachen Raketen wird der Zünder zerdrückt und sie zünden nicht (Wikipedia: etwa 50 %); keine Wirkung gegen Lenkwaffen oder Granaten. Etwa 650 kg (geschätzt).",
    ["gar.d.stock"] = "Das eigene Dach-MG des Panzers.",
    ["gar.d.trophy"] = "Rafael Trophy (an M1A2 SEPv2 der US Army und M1A1 des USMC): zwei drehbare Werfer, vier EL/M-2133-Radarpaneele für 360°, mindestens 1,5 s zwischen zwei Schüssen eines Werfers. Bringt etwa 5.000 lb (2,3 t) mehr; US-Tests zeigten Turmunwucht und langsameres Schwenken (hier −10 %). Schuss pro Werfer nicht öffentlich; 4 angenommen.",
    ["gar.fixed"] = "STANDARD",
